# A Hash from String keys to values of one type (#607): a literal, a
# lookup that answers a maybe, and how many keys it holds.
scores = {"fern" => 3, "moss" => 5}
p(scores["fern"])
p(scores["oak"])
p(scores.length)

# A key written twice keeps its first place and its last value.
colors = {"fern" => "green", "rust" => "red", "fern" => "teal"}
p(colors["fern"])
p(colors.size)
puts(colors["rust"] or "none")
puts(colors["oak"] or "none")

# A Hash of arrays, held and let go of as its values are.
groups = {"odd" => [1, 3], "even" => [2, 4, 6]}
p(groups["even"])

# Whether a key is there, by each of its names.
p(scores.key?("fern"))
p(scores.has_key?("oak"))
p(scores.include?("moss"))
p(scores.member?("rust"))

# A merge is a new Hash: the other's keys after the receiver's, and the
# other's value where both have a key. Neither side changes.
more = scores.merge({"moss" => 8, "oak" => 1})
p(more["moss"])
p(more["oak"])
p(more.length)
p(scores["moss"])
p(scores.length)
