# `==` between arrays, and between structs (#579): equal by what they
# hold.
struct Pair
  left
  right
  note
end

def same?(first, second) = first == second

numbers = [1, 2]
puts numbers == [1, 2]
puts numbers == [1, 3]
puts numbers == [1]
puts numbers != [1, 2]
words = ["a", "b"]
puts same?(words, ["a", "b"])
puts same?(words, ["a", "c"])
nested = [[1], [2, 3]]
puts nested == [[1], [2, 3]]
puts nested == [[1], [2]]
first = Pair.new(left: 1, right: "a", note: nil)
puts first == Pair.new(left: 1, right: "a", note: nil)
puts first == Pair.new(left: 2, right: "a", note: nil)
puts first == Pair.new(left: 1, right: "a", note: "kept")
puts first != first
noted = first.with(note: "kept")
puts noted == Pair.new(left: 1, right: "a", note: "kept")
pairs = [first, noted]
puts pairs == [first, noted]
puts pairs == [noted, first]
