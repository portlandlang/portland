# The walks an array answers that the native build compiles from its own
# Portland source (#567), and a String's `count`.
words = ["if", "while", "def", "end"]
puts words.any? { it == "def" }
puts words.any? { it.length > 9 }
puts words.all? { it.length > 1 }
puts words.all? { it.start_with?("d") }
puts words.none? { it == "" }
puts words.none? { it == "end" }
puts words.count { it.length == 3 }
puts(words.find_index { it == "def" } or -1)
puts(words.find_index { it == "do" } or -1)
words.each_with_index do |word, place|
  puts "#{place}: #{word}"
end
numbers = [3, 8, 12]
puts numbers.any? { it > 10 }
puts numbers.count { it.even? }
puts "a\nb\nc\n".count("\n")
puts "héllo".count("l")

# `sort_by` orders by what the block answers, keeping the order of those
# that answer alike, and `sum` adds Integers up.
fruits = ["pear", "fig", "banana", "kiwi", "apple", "date"]
p(fruits.sort_by { it.length })
p(fruits.sort_by { it })
p([5, 3, 9, 1].sort_by { 0 - it })
empty_fruits = fruits.select { it.length > 20 }
p(empty_fruits.sort_by { it.length })
puts([4, 8, 15].sum)
puts fruits.map { it.length }.sum
