# A value that is one of several structs (#572): a field made with one
# struct in one place and another elsewhere holds either, and the struct
# itself says which. A field every such struct has is read without
# asking, and `in` asks.
struct Circle
  name
  radius
end

struct Square
  side
  name
end

struct Tile
  shape
end

def cornered?(tile)
  return false if tile.shape in Circle
  true
end

round = Tile.new(shape: Circle.new(name: "disc", radius: 2))
boxed = Tile.new(shape: Square.new(side: 3, name: "box"))
puts round.shape.name
puts boxed.shape.name
puts cornered?(round)
puts cornered?(boxed)
puts round.shape in Circle
puts boxed.shape in Circle
p(round)
p(boxed)
puts boxed.shape

# Asked of a value that may not be there, `in` is true only where it is
# there and is the struct named.
tiles = [round, boxed]
puts tiles[0].shape in Circle
first = tiles[1]
missing = tiles[5]
puts first in Tile
puts missing in Tile
