# Differential coverage for the value methods and block forms in
# docs/language.md's library table.
#
# Written because an audit found 21 of 42 documented methods had never run
# through the compiler — the harness was green over a surface it had never
# exercised, which is the failure mode that already bit once during the
# 0016–0020 batch. Everything here runs direct and hosted, byte-identical.

# — strings —
word = "Portland"
puts word.downcase
puts word.reverse
puts word.chars.length.to_s
puts word.start_with?("Port").to_s
puts word.end_with?("land").to_s
puts word.slice(0, 4)
puts "rose city pdx".split(" ").join("-")

# The trimmers, the case moves, and the searches.
puts "  rose  ".strip
puts "  rose".lstrip
puts "rose  ".rstrip
puts "rose\n".chomp
puts "pdx rules".capitalize
puts "PdX".swapcase
puts "banana".count("a").to_s
land_at = "portland".index("land")
rose_at = "portland".index("rose")
puts land_at.to_s
puts rose_at.nil?.to_s
"first\nsecond\n".lines.each do |line|
  puts line.chomp
end

# — integers —
puts 0.zero?.to_s
puts 7.positive?.to_s
negative = 0 - 3
puts negative.negative?.to_s

puts 3.odd?.to_s
puts "42".to_i.to_s
puts "3.5".to_f.to_s
puts 7.to_f.to_s

# — arrays —
numbers = [3, 1, 2]
puts numbers.last.to_s
puts numbers.max.to_s
puts numbers.sort.join(",")
puts numbers.slice(1, 2).join(",")

# The counting-and-finding family, and the answers-a-new-array family.
# (Each array takes a name first: a bare `puts [` is the array-or-index
# ambiguity the parser refuses.)
puts %w[banana apple cherry].sort.join(",")
counted = [1, 2, 2, 3]
puts counted.count.to_s
puts counted.count(2).to_s
descending = [9, 8, 7]
found_at = descending.index(8)
missing_at = descending.index(5)
puts found_at.to_s
puts missing_at.nil?.to_s
stairs = [1, 2, 3]
puts stairs.first(2).join(",")
puts stairs.last(2).join(",")
shuffled = [3, 1, 2]
puts shuffled.reverse.join(",")
repeated = [1, 1, 3, 2, 3]
puts repeated.uniq.join(",")
nested_deep = [[1, [2]], [[3]]]
puts nested_deep.flatten.join(",")
gappy = [1, nil, 2]
puts gappy.compact.join(",")

# — hashes —
config = {"name" => "pdx", "port" => "8080"}
puts config.key?("name").to_s
puts config.key?("missing").to_s
puts config.keys.join(",")
puts config.values.join(",")

# The functional update, the deeper lookups, and the pairs written out.
merged = config.merge({"port" => "3000", "tls" => "on"})
puts merged.values.join(",")
puts config.values.join(",")
nested = {outer: {inner: 7}}
dug = nested.dig(:outer, :inner)
missed = nested.dig(:outer, :nope)
puts dug.to_s
puts missed.nil?.to_s
pairs = {a: 1, b: 2}.to_a
pairs.each do |pair|
  puts pair.join(":")
end

# — block forms —
%w[a b c].each_with_index do |letter, index|
  puts letter + index.to_s
end

counting = [1, 2, 3, 4]
puts counting.reject { it.even? }.join(",")
puts counting.select { it.even? }.join(",")

# The verdict trio, the finders, and the shapers.
puts counting.any? { it > 3 }.to_s
puts counting.all? { it > 0 }.to_s
puts counting.none? { it > 9 }.to_s
first_even = counting.find { it.even? }
puts first_even.to_s
puts %w[bb a ccc].sort_by { it.length }.join(",")
puts %w[a b a].tally.length.to_s
puts counting.zip([9, 8, 7, 6]).flatten.join(",")
puts counting.each_slice(3).length.to_s
puts counting.flat_map { [it, it] }.join(",")

# `pow` is `**`'s named twin (ADR 0033).
puts 2.pow(8).to_s

# The neighbors — synonyms for `+ 1` and `- 1`, kept on purpose (#79).
# `next` is `succ`'s third spelling: a keyword everywhere else, a method
# name after a dot, where loop control can never stand.
below_zero = (-1).succ
puts 41.succ.to_s
puts below_zero.to_s
puts 41.next.to_s
puts 43.pred.to_s
puts 0.pred.to_s

# The float predicates and the rounding family. `infinite?` answers a plain
# Boolean here, not Ruby's nil/1/-1 (see the ledger).
not_a_number = 0.0 / 0.0
endless = 1.0 / 0.0
puts 0.0.zero?.to_s
puts not_a_number.nan?.to_s
puts endless.finite?.to_s
puts endless.infinite?.to_s
# Strides and extremes over a range; `to_a` on an array is the identity.
single_digits = 1..9
strides = single_digits.step(3)
puts strides.to_a.join(",")
puts single_digits.min.to_s
before_nine = 1...9
puts before_nine.max.to_s

# Euclid on magnitudes, and `to_s` in another base.
puts 12.gcd(8).to_s
puts 255.to_s(16)

rounded_down = (-2.5).round
ceiled_up = (-1.5).ceil
cut_short = (-1.9).truncate
puts 2.5.round.to_s
puts rounded_down.to_s
puts 1.5.floor.to_s
puts ceiled_up.to_s
puts cut_short.to_s
tower = 2 ** 3 ** 2
puts tower.to_s

total = counting.reduce(0) do |running, number|
  running + number
end
puts total.to_s

3.times do |index|
  puts index.to_s
end

1.upto(3) do |number|
  puts number.to_s
end

3.downto(1) do |number|
  puts number.to_s
end

# The accumulator pattern ADR 0001 licenses, which this fixture used to avoid
# on purpose: the compiler discarded a block's bindings, so a counter incremented
# from inside one was right under the seed and wrong under the compiler. It
# threads them now, and these are the differential coverage for that — a
# regression would show up here as a number that disagrees.
mutable tally = 0
[1, 2, 3].each do |number|
  tally += number
end
puts tally.to_s

# Appending rebinds the name (ADR 0015), so this needs the same threading.
mutable collected = []
%w[rose city].each_with_index do |entry, index|
  collected << "#{index}:#{entry}"
end
puts collected.length.to_s

# Failure is absence with a reason (ADR 0027).
sad = failure("out of roses")
p sad
puts sad.failure?
puts 5.failure?
puts(sad or "fallback")
