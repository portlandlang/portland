# A tiny wc: counts lines and words of each file named on the command line.

System.arguments.each do |path|
  content = System.read_file(path) or panic "wc: cannot read #{path}"
  lines = content.split("\n").reject do |line|
    line.empty?
  end
  words = lines.reduce(0) do |count, line|
    count + line.split(" ").length
  end
  puts("#{lines.length} lines, #{words} words: #{path}")
end
