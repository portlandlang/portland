# The Stage 0 tour — everything the seed speaks, in one file.

def greeting(name)
  return "hello, stranger" if name.empty?
  "hello, #{name}!"
end

puts greeting("portland")
puts greeting("")

# `alias` — a second name for the same method (ADR 0039).
alias salutation greeting
puts salutation("rose city")

mutable odds = 0
mutable number = 0
while number < 10
  number += 1
  next if number.even?
  odds += number
end
puts "odd sum: #{odds}"

cities = {"pdx" => "portland", "sea" => "seattle"}
cities.each do |code, city|
  puts("#{code.upcase} is #{city}") unless city == "seattle"
end

squares = [1, 2, 3].map do |number|
  number * number
end
puts(squares.join(" + ") + " = #{squares.sum}")

# `until` and the postfix loop modifiers (ADR 0037) — while's negated twin,
# and the one-line loops, all pre-checked.
mutable countdown = 3
until countdown.zero?
  countdown -= 1
end
puts "lift off: #{countdown}"
mutable doubled = 1
doubled *= 2 while doubled < 10
puts "doubled to #{doubled}"
mutable trimmed = 9
trimmed -= 2 until trimmed < 4
puts "trimmed to #{trimmed}"

# `||=` (ADR 0043) — the or-guard's question as a rebind.
mutable nickname = [].first
nickname ||= "stumptown"
puts "aka #{nickname}"

# `then` rows (ADR 0042) — the decision-table typography, if included.
size = 60
bracket = if size > 100 then "large"
elsif size > 50 then "medium"
else "small"
end
puts "bracket: #{bracket}"
parity = case size % 2 when 0 then "even" else "odd" end
puts "parity: #{parity}"

# `loop do` — `while true` in Ruby's favorite clothes, left by `break`.
mutable spins = 0
loop do
  spins += 1
  break if spins > 4
end
puts "spun #{spins} times"
