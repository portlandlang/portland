#!/usr/bin/env -S rv run ruby
# A pdx stub for every ruby/spec file the suite has not taken in yet: the
# upstream file's describe and context nesting, and one bodiless `pending` per
# upstream example, titled as upstream titles it.
#
#   script/ruby_spec_stubs ~/Developer/ruby/spec
#
# A stub lands at spec/ruby/<upstream path>, `_spec.rb` becoming
# `_spec.pdx`, so `spec/ruby/core/array/bsearch_spec.pdx` stands in for
# `core/array/bsearch_spec.rb`. Only files spec/ruby_spec.yml does not name
# get one — the missing list; an imported file has a real spec, and a skipped
# one is decided out, which the harness says is a comment, never a pending.
# Importing a file for real means deleting its stub.
#
# Upstream is read with Prism. `describe` and `context` nest; `it` becomes a
# pending; `it_behaves_like` becomes one pending naming the shared behavior;
# guard blocks (`platform_is`, `ruby_version_is`, and the rest) and loops are
# walked through transparently; a `describe` marked `shared: true` is a
# shared behavior's definition, not examples, and is dropped. A group that
# ends up holding no examples is dropped too.
#
# The whole tree is rewritten each run, so a stub is never hand-edited.
#
# Stubs are parsed, never run: a pending cannot fail, so running one proves
# only that its file parses, which `pdx --parse` proves in under a second for
# the lot. script/spec and the gate skip spec/ruby/ when running specs, parse
# it instead, and read the counts from spec/ruby/pendings.yml, which this
# writes beside the stubs.

require "fileutils"
require "open3"
require "prism"
require "yaml"

REPO = File.expand_path("..", __dir__)
STUBS = File.join(REPO, "spec/ruby")
AREAS = %w[core language library command_line optional security].freeze

# One upstream spec file, read into groups and pendings.
class UpstreamSpec
  GROUPS = %i[describe context].freeze

  def initialize(path:)
    @tree = Prism.parse_file(path).value
  end

  # A list of items: [:pending, title] or [:group, title, items].
  def items = items_in(@tree)

  private

  def items_in(node)
    node.compact_child_nodes.flat_map { item_for(it) }
  end

  def item_for(node)
    return items_in(node) unless node.is_a?(Prism::CallNode) && node.receiver.nil?

    case node.name
    when *GROUPS then group_for(node)
    when :it then [[:pending, title_of(node.arguments&.arguments&.first) || "(untitled)"]]
    when :it_behaves_like, :it_should_behave_like then [[:pending, "behaves like #{arguments_text(node)}"]]
    else node.block ? items_in(node.block) : []
    end
  end

  def group_for(node)
    return [] if shared?(node) || node.block.nil?

    inside = items_in(node.block)
    return [] if inside.empty?

    [[:group, arguments_text(node), inside]]
  end

  def shared?(node)
    Array(node.arguments&.arguments).any? do |argument|
      argument.is_a?(Prism::KeywordHashNode) &&
        argument.elements.any? { it.key.is_a?(Prism::SymbolNode) && it.key.unescaped == "shared" }
    end
  end

  # `describe "Array#pack", "with :a"` reads "Array#pack with :a"; keyword
  # arguments are options, not words.
  def arguments_text(node)
    words = Array(node.arguments&.arguments).reject { it.is_a?(Prism::KeywordHashNode) }
    words.map { title_of(it) }.compact.join(" ")
  end

  def title_of(node)
    case node
    when nil then nil
    when Prism::StringNode then node.unescaped
    when Prism::SymbolNode then ":#{node.unescaped}"
    when Prism::InterpolatedStringNode then node.slice.delete_prefix('"').delete_suffix('"')
    else node.slice
    end
  end
end

# The pdx source for one stub.
class Stub
  def initialize(upstream_path:, items:, commit:)
    @upstream_path = upstream_path
    @items = items
    @commit = commit
  end

  def path = File.join(STUBS, @upstream_path.sub(/_spec\.rb\z/, "_spec.pdx"))

  def source
    depth = @upstream_path.count("/") + 1
    helper = "#{'../' * depth}spec_helper"
    lines = [
      "# Generated by script/ruby_spec_stubs from ruby/spec #{@upstream_path}",
      "# at #{@commit}. Every upstream example is a pending until this file is",
      "# imported for real; importing it means deleting this stub. Do not edit.",
      "",
      "require_relative #{literal(helper)}",
      ""
    ]
    lines + @items.flat_map { lines_for(it, indent: 0) } + [""]
  end

  private

  def lines_for(item, indent:)
    pad = "  " * indent
    case item
    in [:pending, title] then ["#{pad}pending #{literal(title)}"]
    in [:group, title, inside]
      ["#{pad}context #{literal(title)} do"] + inside.flat_map { lines_for(it, indent: indent + 1) } + ["#{pad}end"]
    end
  end

  # A Portland string literal: backslash, quote, and `#` escaped, so no
  # upstream title can interpolate or end the string early.
  def literal(text)
    escaped = text.gsub("\\") { "\\\\" }.gsub('"') { '\\"' }.gsub("#") { "\\#" }
                  .gsub("\n") { "\\n" }.gsub("\t") { "\\t" }.gsub("\r", "")
    %("#{escaped}")
  end
end

checkout = ARGV.first or abort "usage: script/ruby_spec_stubs PATH_TO_RUBY_SPEC_CHECKOUT"
checkout = File.expand_path(checkout)
abort "#{checkout} is not a ruby/spec checkout — no core/ directory" unless Dir.exist?(File.join(checkout, "core"))

manifest = YAML.safe_load_file(File.join(REPO, "spec/ruby_spec.yml")).keys
named = ->(path) { manifest.include?(path) || manifest.any? { it.end_with?("/") && path.start_with?(it) } }
commit, = Open3.capture2("git", "-C", checkout, "rev-parse", "--short", "HEAD")

upstream = AREAS.flat_map do |area|
  Dir.chdir(checkout) { Dir.glob("#{area}/**/*_spec.rb") }
     .reject { it.include?("/shared/") || it.include?("/fixtures/") }
end.sort

FileUtils.rm_rf(STUBS)
counts = {}
upstream.reject { named.call(it) }.each do |path|
  items = UpstreamSpec.new(path: File.join(checkout, path)).items
  next if items.empty?

  stub = Stub.new(upstream_path: path, items:, commit: commit.strip)
  FileUtils.mkdir_p(File.dirname(stub.path))
  File.write(stub.path, stub.source.join("\n"))
  counts[path] = stub.source.count { it.lstrip.start_with?("pending ") }
end

# The counts, written once here so nothing downstream re-counts the stubs.
index = {
  "ruby_spec_commit" => commit.strip,
  "stubs" => counts.size,
  "pendings" => counts.values.sum,
  "files" => counts
}
header = "# Generated by script/ruby_spec_stubs beside the stubs it counts. Do not edit.\n"
File.write(File.join(STUBS, "pendings.yml"), header + index.to_yaml.delete_prefix("---\n"))
warn "wrote #{counts.size} stubs holding #{counts.values.sum} pendings under spec/ruby/"
