#!/usr/bin/env ruby
# Derive the builtin method table from the seed's behavior (#88): for each
# builtin receiver, which names answer, with how many positional arguments,
# and whether with a block. The seed marks every refusal it makes with a
# machine line on stderr before the sentence — `refusal: missing`,
# `refusal: alias`, `refusal: parse`, `refusal: arity`, `refusal:
# arguments` — and this reads only that line, never the prose: a shape
# fails when the seed says `missing`, `alias`, or `parse`, and passes when
# it runs or refuses for any other reason (a wrong count still proves the
# name exists). The counts of the passing shapes are a name's arity; a
# passing block shape marks it block-taking. The seed is the oracle
# (principle 7), so the table in `compiler/inference.pdx` — which the seed
# itself reads at build for its own wordings — is pinned to this script's
# output rather than to a reading of the Rust.
#
# Usage: script/probe_builtin_methods            (needs target/debug/pdx)
#
# Each line is `type: name/arity name/arity …`, sorted: `include?/1`,
# `slice/1-2`, `each/0&` (block-taking), `first/0-1`. Candidates are the
# names the seed's dispatch arms mention plus the Ruby names a migrating
# reader might reach for; add to the list to widen the probe.

require "open3"
require "tmpdir"

repo = File.expand_path("..", __dir__)
pdx = File.join(repo, "target", "debug", "pdx")
abort "build the seed first: cargo build" unless File.executable?(pdx)

receivers = {
  "string" => '"pdx"',
  "integer" => "5",
  "float" => "2.5",
  "boolean" => "true",
  "symbol" => ":sym",
  "array" => "[1, 2, 3]",
  "hash" => '{"a" => 1}',
  "range" => "(1..3)",
}

candidates = %w[
  abs magnitude downto even? gcd negative? next odd? positive? pow pred succ times to_f to_s upto zero?
  all? any? compact count each each_slice each_with_index empty? find detect first flat_map collect_concat
  flatten include? member? index join last length size map collect max min none? reduce inject reject
  reverse select filter find_all slice sort sort_by sum tally uniq zip
  dig each_pair key? has_key? keys merge to_a entries values
  ceil finite? floor infinite? nan? round to_i truncate
  capitalize chars chomp downcase end_with? lines lstrip rstrip split start_with? strip swapcase upcase
  nil? some? failure? to_s
  each_char sub gsub center ljust rjust tr delete squeeze ord chr bytes hex oct freeze frozen? dup clone
  take drop push pop shift unshift each_cons min_by max_by sample shuffle group_by partition each_with_object
  fetch values_at transform_values invert
  step clamp digits between? divmod modulo remainder fdiv
  inspect class hash is_a? respond_to? send tap then itself instance_of?
  append prepend concat replace to_ary to_int to_str to_sym
].uniq.sort

# [call text, positional count, block?]
shapes = lambda do |receiver, name|
  [
    ["#{receiver}.#{name}", 0, false],
    ["#{receiver}.#{name}(1)", 1, false],
    ["#{receiver}.#{name}(\"a\")", 1, false],
    ["#{receiver}.#{name}([1])", 1, false],
    ["#{receiver}.#{name}({\"a\" => 1})", 1, false],
    ["#{receiver}.#{name}(1, 2)", 2, false],
    ["#{receiver}.#{name} { it }", 0, true],
    ["#{receiver}.#{name} { |a, b| a }", 0, true],
    ["#{receiver}.#{name}(1) { it }", 1, true],
    ["#{receiver}.#{name}(1) { |a, b| a }", 1, true],
    ["#{receiver}.#{name}(\"a\") { it }", 1, true],
    ["#{receiver}.#{name}([1]) { it }", 1, true],
  ]
end

# The kinds of refusal that say a shape is not this receiver's to answer.
not_answered = %w[missing alias parse]

# A seed that does not mark its refusals would pass every shape and hand
# back a table of everything — refuse to probe one.
Dir.mktmpdir do |directory|
  path = File.join(directory, "marker.pdx")
  File.write(path, "x = \"pdx\".knd\n")
  _out, err, _status = Open3.capture3(pdx, path)
  abort "probe_builtin_methods: the seed did not mark its refusal (`refusal: missing`) — rebuild it" unless err.lines.any? { |line| line.strip == "refusal: missing" }
end

# Progress goes to stderr so a caller reading the table off stdout — the
# check script — still sees a type land every fifteen seconds or so.
Dir.mktmpdir do |directory|
  receivers.each do |type, receiver|
    warn "probing #{type} (#{candidates.length} names)…"
    entries = candidates.filter_map do |name|
      # Each shape's verdict: :ran (exit zero), :reached (a refusal with no
      # marker — the seed's own arm took the call and refused it on its
      # merits, so the count reached the method), a marked kind, or nil.
      verdicts = shapes.call(receiver, name).map do |call, count, block|
        path = File.join(directory, "probe.pdx")
        File.write(path, "x = #{call}\n")
        _out, err, status = Open3.capture3(pdx, path)
        marker = err.lines.find { |line| line.start_with?("refusal: ") }
        kind = if status.success?
          "ran"
        elsif marker.nil?
          "reached"
        else
          marker.delete_prefix("refusal: ").strip
        end
        [kind, count, block]
      end
      # A name exists when any shape was not refused as missing, alias, or
      # parse — a wrong count or wrong arguments still proves it exists.
      next if verdicts.all? { |kind, _count, _block| not_answered.include?(kind) }
      # Its arity is the counts of the shapes that reached the method.
      reaching = verdicts.select { |kind, _count, _block| kind == "ran" || kind == "reached" }
      counts = reaching.map { |_kind, count, _block| count }.uniq.sort
      arity = if counts.empty?
        "0"
      elsif counts.length == 1
        counts.first.to_s
      else
        "#{counts.min}-#{counts.max}"
      end
      block = reaching.any? { |_kind, _count, takes_block| takes_block } ? "&" : ""
      "#{name}/#{arity}#{block}"
    end
    puts "#{type}: #{entries.join(" ")}"
  end
end
