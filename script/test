#!/bin/sh
# Run the test suite and linters.
#
#   script/test          everything but the native tool builds — the same
#                        as --all
#   script/test --all    everything but the native tool builds
#   script/test --fast   that, less the whole suites: the language spec on
#                        both implementations and the checker over the
#                        compiler's own source
#   script/test --quick  the quick steps only: format, clippy, lint,
#                        docs, and unit, which catch the common mistakes
#                        before a push (#606). CI runs these and every
#                        other step
#   script/test --native only the native tools: the linter, the parser,
#                        and the report built natively and held to the seed
#                        (#600). Each build is minutes of the seed working
#                        out the front end's types, so they are a step of
#                        their own, which script/cibuild runs.
#   script/test STEP     the one step named, and nothing else (#603): each
#                        of CI's checks runs one, so a check and a person
#                        run a step by the same command
#
# The steps, in the order a full run takes them:
#
#   format         cargo fmt --check
#   clippy         clippy over the workspace, warnings as errors
#   build          every test binary, the pdx binary, and the runtime,
#                  built and not run
#   unit           the seed's unit tests, seed/src
#   runtime        the runtime's unit tests
#   source-form    source_form's unit tests
#   ruby-rules     ruby_rules' unit tests
#   integration    seed/tests/run_pdx_files.rs
#   regex-corpus   seed/tests/onigmo_corpus.rs
#   regex-fuzz     seed/tests/onigmo_fuzz.rs
#   lint           script/lint, Portland's own linter over compiler/ and core/
#   docs           script/docs/check
#   whole-suites   seed/tests/whole_suites.rs
#   native-tools   seed/tests/native_tools.rs
#
# Each step is labeled in the output, so it says what ran — in a full run
# the whole suites run in the background alongside the rest and print last.
# cargo's `--quiet` hides the file each group comes from, and without it
# cargo names every one of hundreds of tests. The test targets are named one
# by one — the seed's library, then each file in seed/tests/ — and the rest
# are left out because none holds any tests: doc tests, and `crate/`, which
# exists only to hold the `portland` name on crates.io. A new test file in
# seed/tests/ needs a step here, or it does not run.
set -e
cd "$(dirname "$0")/.."

. script/lib/rust.sh

label() {
  echo ""
  echo "== $1"
}

run_step() {
  case "$1" in
    format)
      label "format — cargo fmt --check"
      cargo fmt --check
      ;;
    clippy)
      label "clippy — warnings as errors"
      cargo clippy --workspace --all-targets -- -D warnings
      ;;
    build)
      # Built once up front, so the steps after it only run tests: two cargo
      # builds at once would wait on each other's lock. The runtime is built
      # both ways a native build links it, for the native fixtures.
      label "build — the test binaries, the pdx binary, and the runtime"
      cargo test --package portland-seed --quiet --lib --tests --no-run
      cargo test --package portland-runtime --package portland-source-form --package portland-ruby-rules --quiet --no-run
      cargo build --package portland-runtime --quiet
      cargo build --package portland-runtime --quiet --release
      ;;
    unit)
      label "unit tests — seed/src"
      cargo test --package portland-seed --quiet --lib
      ;;
    runtime)
      label "runtime unit tests — runtime/src/lib.rs: what every native program is linked with"
      cargo test --package portland-runtime --quiet
      ;;
    source-form)
      label "source form unit tests — source_form/src/lib.rs: how a String and a Symbol are written back out, for the seed and the runtime both"
      cargo test --package portland-source-form --quiet
      ;;
    ruby-rules)
      label "ruby rules unit tests — ruby_rules/src/lib.rs: Ruby's rules for text and numbers, for the seed and the runtime both"
      cargo test --package portland-ruby-rules --quiet
      ;;
    integration)
      label "integration tests — seed/tests/run_pdx_files.rs"
      cargo test --package portland-seed --quiet --test run_pdx_files
      ;;
    regex-corpus)
      label "regex conformance — seed/tests/onigmo_corpus.rs: Onigmo's own suite against Ruby 4.0.9's answers"
      cargo test --package portland-seed --quiet --test onigmo_corpus
      ;;
    regex-fuzz)
      label "regex regressions — seed/tests/onigmo_fuzz.rs: recorded fuzz batches against Ruby 4.0.9's answers and the seed's recorded matcher steps"
      cargo test --package portland-seed --quiet --test onigmo_fuzz
      ;;
    lint)
      label "lint — script/lint: Portland's own linter over compiler/ and core/"
      script/lint
      ;;
    docs)
      label "docs checks — script/docs/check"
      script/docs/check
      ;;
    whole-suites)
      label "whole suites — seed/tests/whole_suites.rs: the language spec on both implementations, the checker over the compiler's own source"
      # `exec`, so that in a full run, where this runs in the background,
      # the process a failing step in front stops is cargo itself.
      exec cargo test --package portland-seed --quiet --test whole_suites
      ;;
    native-tools)
      label "native tools — seed/tests/native_tools.rs: the linter, the parser, and the report built natively and held to the seed (minutes)"
      cargo test --package portland-seed --quiet --test native_tools
      ;;
    *)
      echo "script/test: no step named '$1'" >&2
      echo "usage: script/test [--all | --fast | --quick | --native | STEP]" >&2
      exit 64
      ;;
  esac
}

case "${1:---all}" in
  --all) scope=all ;;
  --fast) scope=fast ;;
  --quick)
    run_step format
    run_step clippy
    run_step lint
    run_step docs
    run_step unit
    exit 0
    ;;
  --native)
    run_step native-tools
    exit 0
    ;;
  -*)
    echo "usage: script/test [--all | --fast | --quick | --native | STEP]" >&2
    exit 64
    ;;
  *)
    run_step "$1"
    exit 0
    ;;
esac

run_step format
run_step clippy
run_step build

# The whole suites take most of the run, so they start now, in the
# background, while everything else runs in front of them. Their output is
# held in a file and printed under their own label at the end. Run one after
# the other instead, the steps would take longer end to end — they overlap,
# and the labels still say which is which.
if [ "$scope" = all ]; then
  whole_suites_output=$(mktemp)
  run_step whole-suites > "$whole_suites_output" 2>&1 &
  whole_suites_pid=$!
  # A step in front failing ends the script; the suites behind it stop too,
  # rather than running on unwatched.
  # `|| true` because the suites have usually finished by then, and under
  # `set -e` a kill that finds nothing would become the script's exit status.
  trap 'kill "$whole_suites_pid" 2> /dev/null || true; rm -f "$whole_suites_output"' EXIT
fi

run_step unit
run_step runtime
run_step source-form
run_step ruby-rules
run_step integration
run_step regex-corpus
run_step regex-fuzz
run_step lint
run_step docs

if [ "$scope" = all ]; then
  whole_suites_status=0
  wait "$whole_suites_pid" || whole_suites_status=$?
  cat "$whole_suites_output"
  exit "$whole_suites_status"
fi
