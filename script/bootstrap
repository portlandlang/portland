#!/bin/sh
# Install the toolchain this repo needs.
set -e
cd "$(dirname "$0")/.."

if ! command -v brew > /dev/null 2>&1; then
  echo "script/bootstrap: Homebrew is required (https://brew.sh)" >&2
  exit 1
fi

brew bundle check > /dev/null 2>&1 || brew bundle

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
rustup default stable > /dev/null
rustc --version
cargo --version

# Ruby gems for the doc tooling (mdl). The interpreter itself comes from
# chruby per .ruby-version — see script/docs/lib/ruby.sh.
bundle install --quiet
echo "gems: $(bundle exec mdl --version 2> /dev/null || echo 'mdl missing')"

# Git hooks live in script/hooks/ so they are version-controlled; .git/hooks
# is not. Pointing core.hooksPath there installs them for this clone.
git config core.hooksPath script/hooks
echo "git hooks: pre-commit (fast gate), pre-push (full suite)"
