#!/bin/sh
# Install the toolchain this repo needs.
set -e
cd "$(dirname "$0")/.."

if ! command -v brew > /dev/null 2>&1; then
  echo "script/bootstrap: Homebrew is required (https://brew.sh)" >&2
  exit 1
fi

brew bundle check > /dev/null 2>&1 || brew bundle

. script/lib/rust.sh
# The Rust rust-toolchain.toml pins, with its components; with no name given,
# rustup installs the toolchain that file selects.
rustup toolchain install
rustc --version
cargo --version

# The Ruby .ruby-version pins, installed by rv if it is not already (rv says
# so and succeeds when it is), then selected the way every script selects it —
# see script/docs/lib/ruby.sh — so the gems below land under that Ruby.
rv ruby install
. script/docs/lib/ruby.sh
ruby --version

# Ruby gems for the doc tooling (mdl).
bundle install --quiet
echo "gems: $(bundle exec mdl --version 2> /dev/null || echo 'mdl missing')"

# Git hooks live in script/hooks/ so they are version-controlled; .git/hooks
# is not. Pointing core.hooksPath there installs them for this clone.
git config core.hooksPath script/hooks
echo "git hooks: pre-commit (fast gate), pre-push (full suite)"
