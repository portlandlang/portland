#!/bin/sh
# The fast gate — everything except the whole suites, about twenty seconds.
#
# The whole suites (seed/tests/whole_suites.rs: the language spec on both
# implementations and the checker over the compiler's own source) take most
# of a full run. They guard the self-hosting property, which pre-push is the
# right place for. Everything else runs here, at the moment you make the
# mistake. `script/test --fast` owns what "everything else" is, so this hook
# cannot drift from it.
#
# Escape hatch: `git commit --no-verify`.
set -e
cd "$(dirname "$0")/../.."

script/test --fast
