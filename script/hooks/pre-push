#!/bin/sh
# The quick steps — format, clippy, lint, docs, and the seed's unit tests —
# once before anything becomes public (#606): the ones that catch the
# common mistakes. CI runs every step, these among them, each as a check
# of its own (.github/workflows/ci.yml), and a pull request does not merge
# with one failing. `script/test --quick` owns what the quick steps are,
# so this hook cannot drift from it.
#
# Escape hatch: `git push --no-verify`.
#
# It runs in the tree being pushed: `core.hooksPath` points into the main
# checkout, so from a linked worktree this file's own directory is another
# tree, and git has exported the worktree's index (#376).
set -e
cd "$(git rev-parse --show-toplevel)"
script/test --quick
