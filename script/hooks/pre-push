#!/bin/sh
# The fast gate — everything except the whole suites, about twenty seconds —
# once before anything becomes public. The whole suites and the builtin
# method table are CI's (.github/workflows/ci.yml): the suites run on every
# push to main and every pull request, the table whenever the seed, the
# table, or the probe changed. `script/test --fast` owns what the fast gate
# is, so this hook cannot drift from it.
#
# Escape hatch: `git push --no-verify`.
set -e
cd "$(dirname "$0")/../.."
script/test --fast
