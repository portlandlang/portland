#!/bin/sh
# The full gate — what CI runs, run before anything becomes public.
#
# The extra ~31s over pre-commit is the self-parse test: Portland parsing
# the whole compiler including itself. That is the property the project
# exists to hold, so it is worth a wait once per push rather than a red
# CI badge minutes later.
#
# Escape hatch: `git push --no-verify`.
set -e
cd "$(dirname "$0")/../.."

script/test

# The builtin method table (#88) is derived from the seed's behavior, so a
# push that touched the seed's source re-derives it and diffs — two
# minutes, only when it can matter. Against the upstream where one exists,
# else against the whole history of a first push.
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [ -n "$upstream" ]; then
  seed_changes=$(git diff --name-only "$upstream"...HEAD -- seed/src)
else
  seed_changes=$(git ls-files seed/src)
fi
if [ -n "$seed_changes" ]; then
  echo "seed/src changed — checking the builtin method table against the seed"
  script/check_builtin_table
fi
