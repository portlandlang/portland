#!/bin/sh
# Build a Portland program into a native executable (#447, ADR 0094).
#
#   script/build fib.pdx        writes target/portland/fib.ll and
#                               target/portland/fib, and prints the binary's path
#
#   script/build --unoptimized fib.pdx
#                               the same, with clang's optimizer off
#
#   script/build --verbose fib.pdx
#                               the same, saying on standard error what it
#                               is doing as it goes: each stage with the
#                               time since it began, and each round of
#                               working out the program's types
#
# A build is optimized unless asked otherwise, since a build should produce
# the fast thing. Unoptimized, the binary does what the compiler wrote and
# no more: every local read from its slot, every loop turn taken, every
# overflow check made. That is the one to read when the question is what
# Portland emitted, not what LLVM made of it.
#
# With PDX set to a built seed, that seed runs the compiler and none is built.
#
# The compiler, running on the seed, checks the program and writes LLVM IR
# as text; Apple's clang, found through xcrun so it is the active Xcode's,
# compiles that. The compiler cannot run a process itself (#179), which is
# why this script sits between the two.
#
# Only a slice of the language compiles (#443); anything outside it refuses
# by name and nothing is written.
set -e
optimization=-O2
runtime_profile=release
verbose=
while [ $# -gt 1 ]; do
  case "$1" in
    --unoptimized)
      optimization=-O0
      runtime_profile=debug
      ;;
    --verbose) verbose=verbose ;;
    *) break ;;
  esac
  shift
done
if [ $# -ne 1 ]; then
  echo "usage: script/build [--unoptimized] [--verbose] FILE.pdx" >&2
  exit 64
fi
invoked_from=$(pwd)
case "$1" in
  /*) program=$1 ;;
  *) program=$invoked_from/$1 ;;
esac
cd "$(dirname "$0")/.."
root=$(pwd)

. script/lib/rust.sh
. script/lib/macos.sh

# PDX names a seed already built, as the tests do from inside cargo;
# without it the seed is built here.
if [ -z "$PDX" ]; then
  cargo build --quiet --package portland-seed --bin pdx
  PDX=target/debug/pdx
fi
# The runtime every native program is linked with (ADR 0095): the release
# build beside an optimized program, and the debug build, with its checks
# on, beside an unoptimized one.
if [ "$runtime_profile" = release ]; then
  cargo build --quiet --package portland-runtime --release
else
  cargo build --quiet --package portland-runtime
fi
runtime=$root/target/$runtime_profile/libportland_runtime.a
name=$(basename "$program" .pdx)
output=$root/target/portland
mkdir -p "$output"
# A stale .ll from an earlier build must not be compiled when this one refuses.
rm -f "$output/$name.ll" "$output/$name" "$output/$name.sources" "$output/$name.fingerprint"
"$PDX" compiler/build.pdx "$program" "$output/$name.ll" $verbose
[ -z "$verbose" ] || echo "clang: compiling $output/$name.ll" >&2
# The IR names no target, so clang supplies the host's and would warn that it did.
xcrun clang "$optimization" -Wno-override-module -Wl,-dead_strip -mmacosx-version-min="$(macos_deployment_target)" -o "$output/$name" "$output/$name.ll" "$runtime"
# What the binary was built from, and a fingerprint of what those files
# held (#588): `pdx lint` runs a native linter only while its source reads
# as it did here. The compiler listed the program's own files; the core
# it is compiled with and the runtime it is linked with are source too.
for source in "$root"/core/*.pdx "$root"/compiler/native_core.pdx "$root"/runtime/src/*.rs "$root"/ruby_rules/src/*.rs "$root"/source_form/src/*.rs; do
  echo "$source" >> "$output/$name.sources"
done
"$PDX" --fingerprint "$output/$name.sources" > "$output/$name.fingerprint"
echo "$output/$name"
