#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates seed/src/regex/unicode_tables.rs from the Unicode tables CRuby
# compiles into its own Onigmo: enc/unicode/<version>/name2ctype.h (every
# property name Ruby's \p{...} accepts, each with its code point ranges) and
# casefold.h (the case folding and unfolding tables). Reading Ruby's own
# generated files, rather than the Unicode Character Database, is what makes
# the seed's regex answer byte for byte what Ruby 4.0.9 answers.
#
#   script/regex_unicode_tables <name2ctype.h> <casefold.h>
#
# The two inputs come from ruby/ruby at the revision Ruby 4.0.9 was built
# from (3e93b23afc), enc/unicode/17.0.0/. They are parsed with regular
# expressions over C array literals; the files are machine-generated with a
# fixed shape, so the parse is stable.

require "set"

name2ctype_path = ARGV.fetch(0)
casefold_path = ARGV.fetch(1)
output_path = File.expand_path("../seed/src/regex/unicode_tables.rs", __dir__)

name2ctype = File.read(name2ctype_path)
casefold = File.read(casefold_path)

# --- code ranges -----------------------------------------------------------

# `static const OnigCodePoint CR_Alpha[] = { 761, 0x0041, 0x005a, ... };`
ranges_by_name = {}
name2ctype.scan(/static const OnigCodePoint CR_(\w+)\[\] = \{\s*(\d+),([^}]*)\}/m) do |name, count, body|
  numbers = body.scan(/0x[0-9a-fA-F]+/).map { |hex| hex.to_i(16) }
  raise "CR_#{name}: expected #{count} ranges, found #{numbers.length / 2}" unless numbers.length == count.to_i * 2
  ranges_by_name[name] = numbers.each_slice(2).to_a
end

# `#define CR_Cc CR_Cntrl` aliases one range table to another name.
name2ctype.scan(/^#define CR_(\w+) CR_(\w+)$/) do |alias_name, target|
  ranges_by_name[alias_name] = ranges_by_name.fetch(target)
end

# `CodeRanges[]` lists the tables in ctype order; preprocessor lines inside
# are skipped (Ruby builds with every property family on).
code_ranges_body = name2ctype[/CodeRanges\[\] = \{(.*?)\n\};/m, 1]
ctype_names = code_ranges_body.lines.map(&:strip).grep(/\ACR_\w+,?\z/).map { |line| line.delete_suffix(",").delete_prefix("CR_") }

# --- property names ----------------------------------------------------------

# The gperf string pool pairs `strN` with the normalized name, and the word
# list pairs `strN` with the ctype index.
pool = {}
name2ctype.scan(/uniname2ctype_pool_str(\d+)\[sizeof\("([^"]+)"\)\]/) { |index, name| pool[index] = name }
names_to_ctype = {}
name2ctype.scan(/\{uniname2ctype_offset\(str(\d+)\), (\d+)\}/) do |index, ctype|
  names_to_ctype[pool.fetch(index)] = ctype.to_i
end
raise "no property names parsed" if names_to_ctype.empty?

# --- case folding ------------------------------------------------------------

def parse_code_list(text) = text.scan(/0x[0-9a-fA-F]+/).map { |hex| hex.to_i(16) }

# `{0x00df, {2|F|ST|SU|I(1), {0x0073, 0x0073}}},` — the first number before
# the flags is the count of codes in the fold.
# Each table ends with a few `_Locale` entries (the dotted and dotless I)
# that Onigmo applies whenever Turkish folding is off, which is always in
# Ruby; they are kept, and the table is sorted so the seed can binary
# search it.
def parse_fold_table(source, table_name)
  body = source[/#{table_name}\[\] = \{(.*?)\n\};/m, 1]
  entries = body.scan(/\{(0x[0-9a-fA-F]+), \{(\d+)[^,]*, \{([^}]*)\}\}\}/).map do |from, code_count, codes|
    to = parse_code_list(codes)
    raise "#{table_name}: #{from} lists #{to.length} codes, expected #{code_count}" unless to.length == code_count.to_i
    [from.to_i(16), to]
  end
  entries.sort_by(&:first)
end

def parse_unfold_sequence_table(source, table_name, width)
  body = source[/#{table_name}\[\] = \{(.*?)\n\};/m, 1]
  entries = body.scan(/\{\{([^}]*)\}, \{(\d+), \{([^}]*)\}\}\}/).map do |key, code_count, codes|
    key_codes = parse_code_list(key)
    to = parse_code_list(codes)
    raise "#{table_name}: key #{key} has #{key_codes.length} codes, expected #{width}" unless key_codes.length == width
    raise "#{table_name}: #{key} lists #{to.length} codes, expected #{code_count}" unless to.length == code_count.to_i
    [key_codes, to]
  end
  entries.sort_by(&:first)
end

fold = parse_fold_table(casefold, "CaseFold_11_Table")
unfold_one = parse_fold_table(casefold, "CaseUnfold_11_Table")
unfold_two = parse_unfold_sequence_table(casefold, "CaseUnfold_12_Table", 2)
unfold_three = parse_unfold_sequence_table(casefold, "CaseUnfold_13_Table", 3)

# --- emit --------------------------------------------------------------------

def hex(code) = format("0x%x", code)

lines = []
lines << "// Generated by script/regex_unicode_tables from CRuby's enc/unicode/17.0.0/"
lines << "// name2ctype.h and casefold.h (ruby/ruby 3e93b23afc, the Ruby 4.0.9 revision)."
lines << "// Do not edit by hand."
lines << ""
lines << "/// Each property's code point ranges, inclusive, indexed by ctype."
lines << "pub static PROPERTY_RANGES: &[&[(u32, u32)]] = &["
ctype_names.each do |name|
  ranges = ranges_by_name.fetch(name)
  rendered = ranges.map { |low, high| "(#{hex(low)}, #{hex(high)})" }.join(", ")
  lines << "    // #{name}"
  lines << "    &[#{rendered}],"
end
lines << "];"
lines << ""
lines << "/// Property names as Ruby normalizes them (lowercase, with spaces,"
lines << "/// hyphens, and underscores removed), each with its ctype; sorted by name."
lines << "pub static PROPERTY_NAMES: &[(&str, u16)] = &["
names_to_ctype.sort_by { |name, _| name }.each do |name, ctype|
  lines << "    (#{name.inspect}, #{ctype}),"
end
lines << "];"
lines << ""
lines << "/// Full case folding: a code point and the one to three code points it"
lines << "/// folds to; sorted by code point."
lines << "pub static CASE_FOLD: &[(u32, &[u32])] = &["
fold.each { |from, to| lines << "    (#{hex(from)}, &[#{to.map { |code| hex(code) }.join(", ")}])," }
lines << "];"
lines << ""
lines << "/// The code points that fold to a given single code point; sorted by key."
lines << "pub static CASE_UNFOLD_ONE: &[(u32, &[u32])] = &["
unfold_one.each { |from, to| lines << "    (#{hex(from)}, &[#{to.map { |code| hex(code) }.join(", ")}])," }
lines << "];"
lines << ""
lines << "/// The code points whose full fold is a given two-code-point sequence."
lines << "pub static CASE_UNFOLD_TWO: &[([u32; 2], &[u32])] = &["
unfold_two.each { |key, to| lines << "    ([#{key.map { |code| hex(code) }.join(", ")}], &[#{to.map { |code| hex(code) }.join(", ")}])," }
lines << "];"
lines << ""
lines << "/// The code points whose full fold is a given three-code-point sequence."
lines << "pub static CASE_UNFOLD_THREE: &[([u32; 3], &[u32])] = &["
unfold_three.each { |key, to| lines << "    ([#{key.map { |code| hex(code) }.join(", ")}], &[#{to.map { |code| hex(code) }.join(", ")}])," }
lines << "];"
lines << ""

File.write(output_path, lines.join("\n"))
# The gate runs `cargo fmt --check`, so the generated file is formatted here
# rather than left for the next hand to tidy.
system("rustfmt", "--edition", "2024", output_path, exception: true)
warn "#{ctype_names.length} properties, #{names_to_ctype.length} names, #{fold.length} folds, #{unfold_one.length}/#{unfold_two.length}/#{unfold_three.length} unfolds -> #{output_path}"
