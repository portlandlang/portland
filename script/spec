#!/bin/sh
# Run Portland's language spec — the ADRs' promises, executable.
#
# Twice: once on the seed, once hosted on the trio. The differential harness
# already proves those two agree with each other; this proves they agree with
# what was decided. A spec that only ran one way would miss half the point.
#
# The tally lives here rather than in the spec file, and not by preference. A
# Portland method cannot reach a counter — a method body gets a fresh scope,
# and there are no instance variables, class variables, or globals — so only a
# block can accumulate, and `specify`/`expect` are methods. So the spec file
# prints one `- ` line per example and one `  FAIL ` line per failure, counts
# nothing, and never panics; the counting and the exit status happen here.
#
# That split is how mspec separates examples from formatters too, and it buys
# back the property panicking cost: every failure gets reported, not just the
# first one.
set -e
cd "$(dirname "$0")/.."

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
cargo build --quiet --package portland-seed --bin pdx

transcript=$(mktemp)
trap 'rm -f "$transcript"' EXIT
failed=0

# `grep -c` exits 1 when it counts none, which `set -e` would treat as fatal.
tally() {
  examples=$(grep -c '^- ' "$transcript" || true)
  failures=$(grep -c '^  FAIL ' "$transcript" || true)
  echo "$(counted "$examples" example), $(counted "$failures" failure)"
  total_examples=$((total_examples + examples))
  total_failures=$((total_failures + failures))
  [ "$failures" -eq 0 ] || failed=1
}

# "1 example", "2 examples" — a tally that misconjugates reads like a tool,
# and this one is read by people (#37 named the gap).
counted() {
  if [ "$1" -eq 1 ]; then
    echo "$1 $2"
  else
    echo "$1 ${2}s"
  fi
}

total_examples=0
total_failures=0

# `find` rather than a glob, so a spec nested in a subdirectory is picked up
# too — `spec/numbers/integers_spec.pdx` is not matched by `spec/*_spec.pdx`,
# and a spec silently not running is the worst way to be green. Sorted because
# directory order is not stable across filesystems, and a run whose output
# reorders itself is a run whose diffs lie.
#
# The unquoted expansion below splits on whitespace, which is fine here and
# would not be if a spec path ever contained a space. Kept in the parent shell
# rather than piped into `while read`, because a pipeline gets a subshell and
# `failed` would be set in it and lost.
specs=$(find spec -name "*_spec.pdx" | sort)
[ -n "$specs" ] || { echo "no *_spec.pdx files under spec/"; exit 1; }

for spec in $specs; do
  echo "$spec — direct"
  ./target/debug/pdx "$spec" > "$transcript"
  cat "$transcript"
  tally

  echo "$spec — hosted"
  ./target/debug/pdx compiler/run.pdx "$spec" > "$transcript"
  cat "$transcript"
  tally
done

# The grand total counts runs, not examples: every spec runs twice, once per
# oracle, and both halves count — agreeing with the seed is half the job.
echo ""
echo "total: $(counted "$total_examples" "example run"), $(counted "$total_failures" failure)"

[ "$failed" -eq 0 ] || { echo "language spec failed"; exit 1; }
