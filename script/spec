#!/bin/sh
# Run Portland's language spec — the ADRs' promises, executable.
#
# Twice: once on the seed, once hosted on the compiler. The differential harness
# already proves those two agree with each other; this proves they agree with
# what was decided. A spec that only ran one way would miss half the point.
#
# The tally lives here rather than in the spec file, and not by preference. A
# Portland method cannot reach a counter — a method body gets a fresh scope,
# and there are no instance variables, class variables, or globals — so only a
# block can accumulate, and `specify`/`expect` are methods. So the spec file
# prints one `- ` line per example and one `  FAIL ` line per failure, counts
# nothing, and never panics; the counting and the exit status happen here.
#
# That split is how mspec separates examples from formatters too, and it buys
# back the property panicking cost: every failure gets reported, not just the
# first one.
set -e
cd "$(dirname "$0")/.."

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
cargo build --quiet --package portland-seed --bin pdx

transcript=$(mktemp)
hosted_all=$(mktemp)
hosted_parts=$(mktemp -d)
trap 'rm -f "$transcript" "$hosted_all"; rm -rf "$hosted_parts"' EXIT
failed=0

# `grep -c` exits 1 when it counts none, which `set -e` would treat as fatal.
tally() {
  examples=$(grep -c '^- ' "$transcript" || true)
  failures=$(grep -c '^  FAIL ' "$transcript" || true)
  pendings=$(grep -c '^\* PENDING ' "$transcript" || true)
  line="$(counted "$examples" example), $(counted "$failures" failure)"
  # Pending examples are holes we owe (#23) — counted and shown, never
  # failed on, and silent when there are none.
  [ "$pendings" -eq 0 ] || line="$line, $pendings pending"
  echo "$line"
  total_examples=$((total_examples + examples))
  total_failures=$((total_failures + failures))
  total_pendings=$((total_pendings + pendings))
  [ "$failures" -eq 0 ] || failed=1
}

# "1 example", "2 examples" — a tally that misconjugates reads like a tool,
# and this one is read by people (#37 named the gap).
counted() {
  if [ "$1" -eq 1 ]; then
    echo "$1 $2"
  else
    echo "$1 ${2}s"
  fi
}

total_examples=0
total_failures=0
total_pendings=0

# `find` rather than a glob, so a spec nested in a subdirectory is picked up
# too — `spec/numbers/integers_spec.pdx` is not matched by `spec/*_spec.pdx`,
# and a spec silently not running is the worst way to be green. Sorted because
# directory order is not stable across filesystems, and a run whose output
# reorders itself is a run whose diffs lie.
#
# The unquoted expansion below splits on whitespace, which is fine here and
# would not be if a spec path ever contained a space. Kept in the parent shell
# rather than piped into `while read`, because a pipeline gets a subshell and
# `failed` would be set in it and lost.
specs=$(find spec -name "*_spec.pdx" | sort)
[ -n "$specs" ] || { echo "no *_spec.pdx files under spec/"; exit 1; }

# The hosted half runs once for the whole suite, not once per spec. What a
# hosted spec costs is not the compiler — loading that is 0.02s — but
# `spec_helper.pdx`, re-parsed into every spec's fresh scope at 0.40s a time;
# `run_specs.pdx` parses the harness once and shares it (#69). The output is
# split back apart below so the per-file tallies survive.
#
# Not under `set -e`: a spec that panics should still print everything that
# ran before it, the way one-process-per-spec used to.
hosted_status=0
./target/debug/pdx spec/run_specs.pdx spec/spec_helper.pdx $specs > "$hosted_all" || hosted_status=$?

# One file per spec, in the order the driver ran them, split on its `=== `
# markers. `read` drops a trailing partial line, which a panic can leave; that
# only ever loses part of the diagnostic, never a countable line.
index=0
part="$hosted_parts/0"
: > "$part"
while IFS= read -r line; do
  case "$line" in
    "=== "*)
      index=$((index + 1))
      part="$hosted_parts/$index"
      : > "$part"
      ;;
    *)
      printf '%s\n' "$line" >> "$part"
      ;;
  esac
done < "$hosted_all"

index=0
for spec in $specs; do
  echo "$spec — direct"
  ./target/debug/pdx "$spec" > "$transcript"
  cat "$transcript"
  tally

  index=$((index + 1))
  echo "$spec — hosted"
  # A spec the batch never reached has no part file. Say so and fail, rather
  # than tallying an empty transcript as zero examples and zero failures —
  # which would read as green.
  if [ -f "$hosted_parts/$index" ]; then
    cp "$hosted_parts/$index" "$transcript"
  else
    echo "  FAIL the hosted run stopped before reaching this spec" > "$transcript"
  fi
  cat "$transcript"
  tally
done

if [ "$hosted_status" -ne 0 ]; then
  echo ""
  echo "the hosted run exited $hosted_status — the tail of its output:"
  tail -3 "$hosted_all"
  failed=1
fi

# The grand total counts runs, not examples: every spec runs twice, once per
# oracle, and both halves count — agreeing with the seed is half the job.
echo ""
grand="total: $(counted "$total_examples" "example run"), $(counted "$total_failures" failure)"
[ "$total_pendings" -eq 0 ] || grand="$grand, $total_pendings pending"
echo "$grand"

[ "$failed" -eq 0 ] || { echo "language spec failed"; exit 1; }
