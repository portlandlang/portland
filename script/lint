#!/bin/sh
# Lint the implementation's Portland source (#510): compiler/ and core/, by
# the rules in compiler/linting.pdx. The linter is written in Portland. It
# is run as `pdx lint` runs it (#588): by the linter built natively,
# `target/portland/lint`, where that is built and its source reads as it
# did then, and on the seed otherwise. `script/build compiler/lint.pdx`
# builds it.
#
#   script/lint                 the implementation's files
#   script/lint FILE.pdx ...    the files named
#
# A finding is a line naming the file and the line; a run with nothing to
# fix says ok. With PDX set to a built seed, that seed runs the linter and
# none is built.
set -e
invoked_from=$(pwd)
cd "$(dirname "$0")/.."

. script/lib/rust.sh

if [ -z "$PDX" ]; then
  cargo build --quiet --package portland-seed --bin pdx
  PDX=target/debug/pdx
fi

# The linter beside this script, whichever seed runs it.
PORTLAND_COMPILER=$(pwd)/compiler
export PORTLAND_COMPILER

if [ $# -eq 0 ]; then
  exec "$PDX" lint compiler/*.pdx core/*.pdx
fi

# The files named are relative to where the script was called from.
for path in "$@"; do
  case "$path" in
    /*) set -- "$@" "$path" ;;
    *) set -- "$@" "$invoked_from/$path" ;;
  esac
  shift
done
exec "$PDX" lint "$@"
