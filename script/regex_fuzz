#!/usr/bin/env ruby
# frozen_string_literal: true

# Fuzzes the seed's regex engine against Ruby 4.0.9 (ADR 0086, #212) and
# keeps what it finds as regression batches: seed/tests/fixtures/onigmo/
# fuzz/*.tsv, replayed by seed/tests/onigmo_fuzz.rs on every script/test
# without Ruby. Each case carries Ruby's answer and the matcher steps the
# seed took when it was recorded, so a wrong answer or a slower engine
# fails the test deterministically.
#
#   rv run --ruby 4.0.9 script/regex_fuzz generate SHAPE COUNT SEED
#       COUNT random patterns of SHAPE (general, cache, grapheme, start,
#       fold), two texts each, answered by Ruby; writes fuzz/SHAPE-SEED.tsv
#       and records the seed's steps. Ruby's own runaways are left out.
#   rv run --ruby 4.0.9 script/regex_fuzz bench-fixture
#       rewrites fuzz/bench.tsv and its text, fuzz/bench_text.txt: the
#       benchmark patterns over a generated 128 KB text, with Ruby's answers.
#   rv run --ruby 4.0.9 script/regex_fuzz bench
#       wall-clock microseconds for each benchmark, the seed's (a release
#       build) beside Ruby's; for reading, not for the test.
#   script/regex_fuzz record
#       re-records every batch's steps from the seed as it is now (no Ruby).
#
# Every answer is Ruby 4.0.9's, so generate, bench-fixture, and bench refuse
# any other Ruby.

require "fileutils"
require "open3"

RUBY_VERSION_PINNED = "4.0.9"
ROOT = File.expand_path("..", __dir__)
FUZZ_DIRECTORY = File.join(ROOT, "seed/tests/fixtures/onigmo/fuzz")
BENCH_TEXT_NAME = "bench_text.txt"

# One case's fields in the fixtures' plain-text spelling.
class Fixture
  HEADER = <<~TEXT
    # Generated by script/regex_fuzz; replayed by seed/tests/onigmo_fuzz.rs.
    # id	start	steps	pattern	text	answer (Ruby #{RUBY_VERSION_PINNED})
  TEXT

  def initialize(path:)
    @path = path
  end

  def write(cases:)
    lines = cases.map do |entry|
      text = entry[:text_file] ? "@file:#{entry[:text_file]}" : escape(entry[:text])
      [entry[:id], entry[:start], "-", escape(entry[:pattern]), text, entry[:answer]].join("\t")
    end
    File.write(@path, HEADER + lines.join("\n") + "\n")
  end

  def read
    File.readlines(@path, chomp: true).reject { it.start_with?("#") || it.empty? }.map do |line|
      id, start, steps, pattern, text, answer = line.split("\t", 6)
      {answer:, id:, pattern: unescape(pattern), start: start.to_i, steps:, text:}
    end
  end

  # `\` doubled; tab, newline, and return as `\t`, `\n`, `\r`; other
  # control, format, separator, private-use, and unassigned characters as
  # `\u{hex}`; a leading `@`, which would read as a file reference, too.
  def escape(field)
    escaped = field.each_char.map do |character|
      case character
      when "\\" then "\\\\"
      when "\t" then "\\t"
      when "\n" then "\\n"
      when "\r" then "\\r"
      when /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cn}]/ then format("\\u{%x}", character.ord)
      else character
      end
    end.join
    escaped.start_with?("@") ? "\\u{40}#{escaped[1..]}" : escaped
  end

  def unescape(field)
    field.gsub(/\\(\\|t|n|r|u\{([0-9a-f]+)\})/) do
      case Regexp.last_match(1)
      when "\\" then "\\"
      when "t" then "\t"
      when "n" then "\n"
      when "r" then "\r"
      else Regexp.last_match(2).to_i(16).chr(Encoding::UTF_8)
      end
    end
  end
end

# Ruby's answer for a case, in the fixtures' spelling, or nil when Ruby
# itself runs past its timeout.
class RubyOracle
  def initialize(timeout:)
    Regexp.timeout = timeout
  end

  def answer(pattern:, text:, start:)
    regex = Regexp.new(pattern)
    found = regex.match(text, start)
    return "nomatch" if found.nil?

    spans = (0...found.size).map do |index|
      offsets = found.byteoffset(index)
      offsets[0].nil? ? "-" : "#{offsets[0]}-#{offsets[1]}"
    end
    "match #{spans.join(" ")}"
  rescue Regexp::TimeoutError
    nil
  rescue RegexpError, ArgumentError, SyntaxError => error
    "error #{error.message.lines.first.strip.split(": /").first}"
  end
end

# Patterns across the whole of Onigmo's Ruby syntax.
class GeneralShape
  LITERALS = %w[a b c A B ß ſ ẞ K k あ い x 0 1 _ - . ! ( ) | *].freeze
  NAMES = %w[n m x].freeze
  POSIX = %w[alpha digit space word upper lower alnum punct cntrl print graph xdigit ascii blank].freeze
  PROPERTIES = %w[Alpha Digit Space Word Greek Hiragana L Lu Ll Nd P Any Assigned ASCII Alnum Upper Lower Punct Cntrl Print Graph XDigit In_Basic_Latin Han Latin Emoji].freeze
  TEXT_ALPHABET = ["a", "b", "c", "A", "B", "ß", "ss", "SS", "ſ", "K", "k", "あ", "い", "x", "0", "1", "_", "-", " ", "\n", "\r\n", "́", "é", "é", "!"].freeze

  def initialize(random:)
    @random = random
  end

  def pattern
    groups = {count: 0, names: []}
    body = alternation(0, groups)
    body = "(?#{pick(%w[i m x a u])})#{body}" if @random.rand(5) == 0
    body
  end

  def text = @random.rand(9).times.map { pick(TEXT_ALPHABET) }.join

  def start(text:) = 0

  private

  def pick(list) = list[@random.rand(list.length)]

  def escape_literal(character)
    character.match?(/[a-zA-Z0-9_\u0080-￿]/) ? character : "\\#{character}"
  end

  def atom(depth, groups)
    case @random.rand(100)
    when 0..34 then escape_literal(pick(LITERALS))
    when 35..39 then pick(%w[\\d \\D \\w \\W \\s \\S \\h \\H .])
    when 40..43 then pick(%w[^ $ \\A \\z \\Z \\b \\B \\G \\K \\R \\X])
    when 44..49 then char_class(depth)
    when 50..52 then "\\p{#{pick(PROPERTIES)}}"
    when 53..54 then "\\P{#{pick(PROPERTIES)}}"
    when 55..57 then groups[:count] > 0 ? "\\#{@random.rand(groups[:count]) + 1}" : "a"
    when 58..59 then groups[:names].empty? ? "b" : "\\k<#{pick(groups[:names])}>"
    when 60..61 then groups[:names].empty? ? "c" : "\\g<#{pick(groups[:names])}>"
    when 62..63 then pick(%w[\\n \\t \\x41 \\u3042 \\e \\0 \\101])
    else depth > 2 ? escape_literal(pick(LITERALS)) : group(depth, groups)
    end
  end

  def char_class(depth)
    parts = (1 + @random.rand(3)).times.map do
      case @random.rand(10)
      when 0..4 then escape_literal(pick(LITERALS)).sub(/\A\\([()|*!.])\z/, '\1')
      when 5 then "#{pick(%w[a A 0 あ])}-#{pick(%w[c z 9 ん])}"
      when 6 then pick(%w[\\d \\w \\s \\h \\D \\W])
      when 7 then "[:#{@random.rand(4) == 0 ? "^" : ""}#{pick(POSIX)}:]"
      when 8 then "\\p{#{pick(PROPERTIES)}}"
      else depth < 2 ? char_class(depth + 1) : "b"
      end
    end
    body = parts.join
    body = "#{body}&&#{pick(%w[a-z \\w [^a] \\p{L} b])}" if @random.rand(6) == 0
    "[#{@random.rand(4) == 0 ? "^" : ""}#{body.gsub(/\A-/, "\\-")}]"
  end

  def group(depth, groups)
    opener =
      case @random.rand(100)
      when 0..24
        groups[:count] += 1
        "("
      when 25..39
        name = pick(NAMES)
        groups[:count] += 1
        groups[:names] << name unless groups[:names].include?(name)
        "(?<#{name}>"
      when 40..54 then "(?:"
      when 55..62 then "(?>"
      when 63..68 then "(?="
      when 69..73 then "(?!"
      when 74..77 then "(?<="
      when 78..80 then "(?<!"
      when 81..88 then "(?#{pick(%w[i m x a u d i- -i im -m])}:"
      when 89..92 then "(?~"
      when 93..95 then groups[:count] > 0 ? "(?(#{@random.rand(groups[:count]) + 1})" : "(?:"
      else groups[:names].empty? ? "(?:" : "(?(<#{pick(groups[:names])}>)"
      end
    "#{opener}#{alternation(depth + 1, groups)})"
  end

  def quantifier
    base = pick(["*", "+", "?", "{2}", "{1,3}", "{,2}", "{2,}", "{0}"])
    suffix =
      if @random.rand(5) == 0 then "?"
      elsif @random.rand(6) == 0 then "+"
      else ""
      end
    "#{base}#{suffix}"
  end

  def sequence(depth, groups)
    (1 + @random.rand(4)).times.map do
      piece = atom(depth, groups)
      piece += quantifier if @random.rand(3) == 0
      piece += quantifier if @random.rand(15) == 0
      piece
    end.join
  end

  def alternation(depth, groups)
    branches = 1 + (@random.rand(4) == 0 ? @random.rand(3) : 0)
    branches.times.map { sequence(depth, groups) }.join("|")
  end
end

# Ambiguous alternations, counted and open repeats, lookarounds, and
# atomic groups over texts long enough to turn the match cache on.
class CacheShape
  LITERALS = %w[a b].freeze

  def initialize(random:)
    @random = random
  end

  def pattern
    body = alternation(0)
    body = "#{body}#{pick(%w[$ \\z c])}" if @random.rand(3) == 0
    body
  end

  def text
    (10 + @random.rand(40)).times.map { @random.rand(8) == 0 ? "c" : pick(LITERALS) }.join
  end

  def start(text:) = 0

  private

  def pick(list) = list[@random.rand(list.length)]

  def quantifier
    case @random.rand(12)
    when 0 then "*"
    when 1 then "+"
    when 2 then "?"
    when 3 then "*?"
    when 4 then "+?"
    when 5 then "??"
    when 6 then "{#{@random.rand(3)},#{@random.rand(3) + 2}}"
    when 7 then "{#{@random.rand(3)},#{@random.rand(3) + 2}}?"
    when 8 then "{#{@random.rand(3) + 1},}"
    when 9 then "{#{@random.rand(3)},}?"
    when 10 then "{#{@random.rand(3) + 1}}"
    else "{,#{@random.rand(3) + 1}}"
    end
  end

  def atom(depth)
    case @random.rand(100)
    when 0..39 then pick(LITERALS)
    when 40..47 then pick(%w[[ab] [^a] [^b] . \\w])
    when 48..51 then pick(%w[^ $ \\z \\Z \\b \\B \\A])
    else depth > 2 ? pick(LITERALS) : group(depth)
    end
  end

  def group(depth)
    inner = alternation(depth + 1)
    case @random.rand(16)
    when 0..5, 15 then "(?:#{inner})"
    when 6..7 then "(#{inner})"
    when 8..9 then "(?=#{inner})"
    when 10 then "(?!#{inner})"
    when 11 then "(?>#{inner})"
    when 12 then "(?<=#{pick(%w[a b ab ba aa bb])})"
    when 13 then "(?<!#{pick(%w[a b ab ba aa bb])})"
    else "(?=#{inner})#{pick(LITERALS)}"
    end
  end

  def piece(depth)
    body = atom(depth)
    body = "#{body}#{quantifier}" if @random.rand(10) < 6 && !body.match?(/\A(\^|\$|\\[zZbBA])\z/)
    body
  end

  def sequence(depth) = (1 + @random.rand(4)).times.map { piece(depth) }.join

  def alternation(depth)
    branches = 1 + (@random.rand(3) == 0 ? @random.rand(3) : 0)
    branches.times.map { sequence(depth) }.join("|")
  end
end

# `\X` and `\R` over emoji sequences, flags, Hangul, Indic conjuncts,
# combining marks, and line breaks.
class GraphemeShape
  PIECES = [
    "a", "b", " ", "\n", "\r\n", "\r", "\n\r",
    "é", "́", "̈", "‍", "‌",
    "\u{1F468}", "\u{1F469}", "\u{1F467}", "\u{1F3FB}", "\u{1F3FF}", "\u{2764}", "️", "\u{1F48B}",
    "\u{1F1FA}", "\u{1F1F8}", "\u{1F1EF}", "\u{1F1F5}",
    "ᄀ", "ᅡ", "ᆨ", "가", "각", "ᅠ",
    "क", "्", "ष", "ि", "अ", "न",
    "ก", "ำ", "ั",
    "\u{E0067}", "\u{E0062}", "\u{E007F}", "\u{1F3F4}",
    "؀", "ا", "َ",
    "\u{1F9D1}", "\u{1F91D}", "♀", "­", "\u0000"
  ].freeze
  PATTERNS = [
    "\\X", "\\X\\X", "\\X{2}", "\\X{3,}", "\\X+", "\\X*\\z", "\\A\\X", "\\X\\z", "(\\X)\\1", "(?:\\X){2,4}?",
    "a\\X", "\\Xa", "\\X(?=\\X)", "(?<=\\X)\\X", "[ab]\\X+", "\\R", "\\R+", "\\X\\R", ".\\X", "\\X.",
    "(?m).\\X", "\\b\\X", "\\X$", "^\\X", "(\\X)(\\X)", "\\X{1,2}\\z", "(?:\\X|a)+", "\\X??a"
  ].freeze

  def initialize(random:)
    @random = random
  end

  def pattern = pick(PATTERNS)

  def text = (@random.rand(7) + 1).times.map { pick(PIECES) }.join

  def start(text:) = 0

  private

  def pick(list) = list[@random.rand(list.length)]
end

# Searches from a position, leaning on what reads before it: `\G`, `\A`,
# `^`, `\b`, lookbehind, and `\K`.
class StartShape
  PIECES = ["a", "b", "c", " ", "\n", "é", "あ", "ß", "K", "0", "-"].freeze
  PATTERNS = [
    "\\G", "\\Ga", "\\G\\w", "\\Gb*", "\\G.", "\\G\\b", "\\G(?<=a)", "\\G(?!a)", "\\G$", "\\G\\z",
    "\\A", "\\Aa", "^", "^a", "^\\w+", "$", "a$", "\\b", "\\ba", "a\\b", "\\B", "\\Bb",
    "(?<=a)b", "(?<!a)b", "(?<=ab)", "(?<=\\w\\w)\\w", "(?<=^)a", "(?<=\\A)", "(?<=\\n)a",
    "\\Ka", "a\\Kb", "\\G\\Ka", "(?<=a)\\Kb", "a*\\K", "\\Ga|b", "(?:\\G|^)a", "(?:a|\\G)b",
    "\\w+", "é", "(?i)k", "(?i)ß", "\\X", "\\R", ".", "(?m).", "", "a??", "(a)\\1", "\\z", "\\Z"
  ].freeze

  def initialize(random:)
    @random = random
  end

  def pattern = pick(PATTERNS)

  def text = @random.rand(8).times.map { pick(PIECES) }.join

  def start(text:) = @random.rand(text.size + 1)

  private

  def pick(list) = list[@random.rand(list.length)]
end

# Case-insensitive patterns over the characters whose folds change
# length, cross the ASCII line, or have several spellings.
class FoldShape
  CHARACTERS = ["s", "S", "ß", "ẞ", "ſ", "k", "K", "K", "f", "i", "I", "İ", "ı", "ﬀ", "ﬁ", "ﬃ", "ŉ", "ʼ", "n", "ǰ", "j", "̌", "ΐ", "ί", "ι", "σ", "ς", "Σ", "Ꭰ", "ꭰ", "a", "A", "b", "t", "θ", "ϑ", "Θ", "µ", "μ", "Μ", "ǆ", "ǅ", "Ǆ", "ŀ", "l", "·"].freeze

  def initialize(random:)
    @random = random
  end

  def pattern
    body = (1 + @random.rand(3)).times.map { piece }.join
    body = "#{body}|#{literal}" if @random.rand(4) == 0
    "(?i)#{body}"
  end

  def text = @random.rand(8).times.map { pick(CHARACTERS) }.join

  def start(text:) = 0

  private

  def pick(list) = list[@random.rand(list.length)]

  def literal
    (1 + @random.rand(4)).times.map { pick(CHARACTERS) }.join.gsub(/[.*+?()\[\]{}|\\^$]/) { "\\#{it}" }
  end

  def piece
    case @random.rand(14)
    when 0..5 then literal
    when 6 then "#{literal}#{pick(%w[+ * ? {2} {1,3} {2,} +? ??])}"
    when 7 then "(?:#{literal})#{pick(%w[+ {2} {1,2} * ?])}"
    when 8 then "[#{pick(CHARACTERS)}#{pick(CHARACTERS)}]"
    when 9 then "[^#{pick(CHARACTERS)}]"
    when 10 then "(?<=#{literal})"
    when 11 then "(?<!#{pick(CHARACTERS)})"
    when 12 then "(#{literal})\\1"
    else "(?-i:#{literal})"
    end
  end
end

# The benchmark text, English-like and the same every time it is made,
# and the patterns timed and step-counted over it.
class Bench
  WORDS = %w[
    the of and to a in that was he his it with as had for at not but on by which be she from her
    you this have all were they one said there so upon been my me no an we what their could
    would if when out then into some time made very man more up about now only little any
    Holmes Watson Lestrade Gregson Baker street London evening morning door room window letter
    found looking having nothing something remarked answered observed cried singular
    singing walking running reading writing finding thinking standing
  ].freeze
  PATTERNS = [
    ["literal-absent", "zqxjkv"],
    ["literal-present-late", "Gregson observed the singular"],
    ["ignorecase-word", "(?i)the"],
    ["word-class-scan", "\\w+ing\\b"],
    ["email-shape", "[\\w.]+@[\\w.]+\\.\\w+"],
    ["date-absent", "\\d{4}-\\d{2}-\\d{2}"],
    ["doubled-word-backref", "\\b(\\w+)\\s+\\1\\b"],
    ["lookbehind", "(?<=\\d{4}-\\d{2}-)\\d{2}"],
    ["lazy-line", "^(.*?)\\s*$"],
    ["catastrophic-nested-star", "(a?){25}a{25}"],
    ["catastrophic-plus-plus", "([a-z]+)+$"],
    ["line-start-literal", "^Holmes"],
    ["anychar-star-literal", ".*Watson"],
    ["end-anchored-short", "END\\.?\\s*\\z"],
    ["ignorecase-literal", "(?i)lestrade"],
    ["capital-word-ing", "[A-Z]\\w+ing"],
    ["line-end-literal", "door\\.$"],
    ["mid-literal-window", "\\w+ Holmes"],
    ["digits-anywhere", "\\d+"],
    ["lazy-any-then-literal", "The.*?Watson"],
    ["end-buf-absent", "e\\.\\s*\\z"],
    ["end-buf-present", "\\w+\\.?\\s*\\z"],
    ["semi-end-absent", "[a-z]{3}\\Z"],
    ["ignorecase-needle", "(?i)watson"],
    ["ignorecase-rare", "(?i)zqx"],
    ["bounded-mid-literal", "\\d{2,3} miles"],
    ["line-start-space-hash", "^\\s*#"],
    ["word-then-literal-absent", "\\w+ zebra"],
    ["class-prefix-literal", "[A-Z][a-z]+ Holmes said"],
    ["anychar-star-absent", ".*zebra"]
  ].freeze

  def text
    random = Random.new(212)
    paragraphs = []
    length = 0
    while length < 128 * 1024
      sentences = (2 + random.rand(5)).times.map do
        words = (4 + random.rand(14)).times.map { WORDS[random.rand(WORDS.length)] }
        words[0] = words[0].capitalize
        words << "#{1 + random.rand(500)} miles" if random.rand(9) == 0
        "#{words.join(" ")}#{%w[. . . ! ?][random.rand(5)]}"
      end
      paragraph = sentences.join(" ")
      paragraphs << paragraph
      length += paragraph.bytesize + 2
    end
    "#{paragraphs.join("\n\n")}\n"
  end
end

# The commands.
class RegexFuzz
  SHAPES = {
    "cache" => CacheShape,
    "fold" => FoldShape,
    "general" => GeneralShape,
    "grapheme" => GraphemeShape,
    "start" => StartShape
  }.freeze

  def initialize(arguments:)
    @arguments = arguments
  end

  def run
    case @arguments[0]
    when "bench" then bench
    when "bench-fixture" then bench_fixture
    when "generate" then generate(shape_name: @arguments[1], count: Integer(@arguments[2]), seed: Integer(@arguments[3]))
    when "record" then record
    else abort(File.read(__FILE__).lines.drop(3).take_while { it.start_with?("#") }.join)
    end
  end

  private

  def require_pinned_ruby
    return if RUBY_VERSION == RUBY_VERSION_PINNED

    abort("regex_fuzz: every answer is Ruby #{RUBY_VERSION_PINNED}'s; this is #{RUBY_VERSION} (rv run --ruby #{RUBY_VERSION_PINNED} script/regex_fuzz ...)")
  end

  def generate(shape_name:, count:, seed:)
    require_pinned_ruby
    shape_class = SHAPES.fetch(shape_name) { abort("regex_fuzz: no shape #{shape_name}; one of #{SHAPES.keys.join(", ")}") }
    shape = shape_class.new(random: Random.new(seed))
    oracle = RubyOracle.new(timeout: 2.0)
    cases = []
    left_out = 0
    $VERBOSE = nil
    count.times do |index|
      pattern = shape.pattern
      2.times do |extra|
        text = shape.text
        start = shape.start(text:)
        answer = oracle.answer(pattern:, text:, start:)
        if answer.nil?
          left_out += 1
          next
        end
        cases << {answer:, id: "#{shape_name}-#{seed}:#{index}.#{extra}", pattern:, start:, text:}
      end
    end
    FileUtils.mkdir_p(FUZZ_DIRECTORY)
    path = File.join(FUZZ_DIRECTORY, "#{shape_name}-#{seed}.tsv")
    Fixture.new(path:).write(cases:)
    warn "#{File.basename(path)}: #{cases.length} cases, #{left_out} left out as Ruby's own runaways"
    record
  end

  def bench_fixture
    require_pinned_ruby
    text = Bench.new.text
    File.write(File.join(FUZZ_DIRECTORY, BENCH_TEXT_NAME), text)
    oracle = RubyOracle.new(timeout: 10.0)
    cases = Bench::PATTERNS.map do |name, pattern|
      answer = oracle.answer(pattern:, text:, start: 0) || abort("regex_fuzz: Ruby ran out of time on #{name}")
      {answer:, id: name, pattern:, start: 0, text_file: BENCH_TEXT_NAME}
    end
    Fixture.new(path: File.join(FUZZ_DIRECTORY, "bench.tsv")).write(cases:)
    record
  end

  def bench
    require_pinned_ruby
    seed_times = seed_bench_times
    text = File.read(File.join(FUZZ_DIRECTORY, BENCH_TEXT_NAME))
    puts format("%-28s %10s %10s", "microseconds for 20 runs", "seed", "ruby")
    Fixture.new(path: File.join(FUZZ_DIRECTORY, "bench.tsv")).read.each do |entry|
      regex = Regexp.new(entry[:pattern])
      started = Process.clock_gettime(Process::CLOCK_MONOTONIC, :microsecond)
      20.times { regex.match(text) }
      ruby_time = Process.clock_gettime(Process::CLOCK_MONOTONIC, :microsecond) - started
      puts format("%-28s %10s %10d", entry[:id], seed_times.fetch(entry[:id], "-"), ruby_time)
    end
  end

  def seed_bench_times
    command = %w[cargo test --package portland-seed --release --quiet --test onigmo_fuzz -- --ignored --exact bench_timings --nocapture]
    output, status = Open3.capture2(*command, chdir: ROOT)
    abort("regex_fuzz: the seed's timings failed") unless status.success?
    output.lines.filter_map { it.chomp.split("\t") if it.count("\t") == 1 }.to_h
  end

  def record
    command = %w[cargo test --package portland-seed --quiet --test onigmo_fuzz -- --nocapture]
    system({"REGEX_FUZZ_RECORD" => "1"}, *command, chdir: ROOT, exception: true)
  end
end

RegexFuzz.new(arguments: ARGV).run if __FILE__ == $PROGRAM_NAME
