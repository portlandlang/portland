#!/bin/sh
# Rewrite the generated sections of the docs, in place.
#
# What is generated is deliberately small: index lists, whose content is
# entirely derivable from the files they index. Everything editorial stays
# hand-written, because a generator flattens judgment into whatever field it
# reads from.
#
# `script/check_docs generated` fails when these are out of date, so this is
# a thing you run after adding a doc, not a build step.
set -e
cd "$(dirname "$0")/.."

# Same Ruby selection as script/check_docs, and for the same reason: this
# has to work from a hook or a bare shell, where macOS's system Ruby is 2.6.
CHRUBY=/opt/homebrew/opt/chruby/share/chruby/chruby.sh
if [ -f "$CHRUBY" ]; then
  . "$CHRUBY"
  chruby "$(cat "$HOME/.ruby-version" 2> /dev/null)" 2> /dev/null || chruby ruby 2> /dev/null || true
fi

if ! ruby -e 'exit RUBY_VERSION.split(".").first.to_i >= 3' 2> /dev/null; then
  echo "script/generate_docs: needs Ruby 3+, found $(ruby -v 2>&1 | cut -d' ' -f2)" >&2
  echo "  install one with chruby, or put a modern ruby on PATH" >&2
  exit 1
fi

exec ruby script/doc_checks/lib/generate.rb
