# Stage 1, act four: inference — increments 3a and 3b of #9 (ADR 0040).
#
# A library: require_relative "inference", then infer_program(nodes) answers
# [name, type] pairs for the program's top-level bindings, and
# infer_methods(nodes) the same for its top-level defs' return types (3b).
# Synthesis only — types are read off literals, locals, operators, builtin
# results, def bodies, and block bodies with parameters bound from their
# receivers — and SILENT by doctrine: nothing here refuses anything, the
# checker does not consume these yet, and the only way to see a type is the
# debug driver (types.pdx). Inference widens where checks apply; it never
# gates their existence (ADR 0034 §4).
#
# A type is a tagged array, the same crude-on-purpose shape the evaluator
# uses for values:
#
#   ["integer"] ["float"] ["string"] ["boolean"] ["symbol"] ["nil"]
#   ["range"]
#   ["array", element]         — element is a type, or ["unknown"]
#   ["hash", key, value]
#   ["maybe", inner]           — the wrapper, never a union (ADR 0040 §3)
#   ["struct", "Name"]         — an instance
#   ["type", "Name"]           — the struct's name itself, what `new` is called on
#   ["enum", "Name"]
#   ["unknown"]                — the honest answer, and the default
#
# ["unknown"] is principle 4 wearing a type: anything this increment cannot
# tell stays unknown, and later increments narrow it. Unknown is never an
# error — it is the absence of an opinion.

require_relative "parser"

# The entry points: [name, type] pairs in first-appearance order — the
# program's top-level bindings, and (3b) its top-level defs' return types.
# One scan feeds both. A method's name can share the list with the locals
# because the no-shadow rule already promises a name is never both.
def infer_program(nodes)
  ordered_pairs(nodes, scan_program(nodes), "assignment")
end

def infer_methods(nodes)
  ordered_pairs(nodes, scan_program(nodes), "def")
end

def scan_program(nodes)
  mutable types = []
  nodes.each do |node|
    if node in DefNode
      types = [[node.name, synthesize_def_return(node, types)]] + types
    elsif node in StructDefNode
      types = register_struct(node, types)
    elsif node in EnumDefNode
      # Recorded so a later increment can hang membership and
      # exhaustiveness off the name; nothing reads it yet.
      types = [[node.name, ["enum", node.name]]] + types
    else
      types = bind_after(node, types, [])
    end
  end
  types
end

# A struct declaration binds its name to its type — what `new` is called
# on — and each type function (`def self.unit`, ADR 0031) under the dotted
# name `Order.unit`, which no identifier can spell, so the one list holds
# both. The checker's program-wide scan registers structs the same way.
def register_struct(node, mutable types)
  types = [[node.name, ["type", node.name]]] + types
  node.type_functions.each do |function|
    next unless function in DefNode
    types = [[node.name + "." + function.name, synthesize_def_return(function, types)]] + types
  end
  types
end

def ordered_pairs(nodes, types, kind)
  mutable seen = []
  mutable ordered = []
  nodes.each do |node|
    next unless node.kind == kind
    next if seen.include?(node.name)
    seen << node.name
    found = types.find { it[0] == node.name }
    ordered << [node.name, type_at(found, 1)]
  end
  ordered
end

# Read a type off an expression. Synthesis mode only (ADR 0040's ladder —
# checking mode is 3b): every arm answers what it can prove from the node
# alone plus the bindings already typed.
def synthesize(node, types)
  case node
  in IntegerNode then ["integer"]
  in FloatNode then ["float"]
  # Interpolation needs no arm: it desugared to a `+` chain of strings at
  # parse, and the binary rule answers string for string + string.
  in StringNode then ["string"]
  in BooleanNode then ["boolean"]
  in SymbolNode then ["symbol"]
  in NilNode then ["nil"]
  in RangeNode then ["range"]
  in WordArrayNode then ["array", ["string"]]
  in ArrayNode then synthesize_array(node, types)
  in HashNode then synthesize_hash(node, types)
  in IdentifierNode then synthesize_identifier(node, types)
  in BinaryNode then synthesize_binary(node, types)
  in LogicalNode then synthesize_logical(node, types)
  in UnaryNode then synthesize_unary(node, types)
  in MethodCallNode then synthesize_call(node, types)
  in SafeMethodCallNode then synthesize_safe_call(node, types)
  # A bare call reaches a def the scan already typed (3b); its name shares
  # the list with the locals under the no-shadow rule.
  in CallNode then synthesize_name(node.name, types)
  in IfNode then synthesize_if(node, types)
  in CaseInNode then synthesize_case_in(node, types)
  in AppendNode then synthesize_append(node, types)
  else
    ["unknown"]
  end
end

def synthesize_array(node, types)
  return ["array", ["unknown"]] if node.elements.empty?
  first = synthesize(node.elements.first, types)
  mutable uniform = true
  node.elements.each do |element|
    uniform = false unless synthesize(element, types) == first
  end
  return ["array", first] if uniform
  ["array", ["unknown"]]
end

def synthesize_hash(node, types)
  return ["hash", ["unknown"], ["unknown"]] if node.pairs.empty?
  first = node.pairs.first
  key = synthesize(first.key, types)
  entry = synthesize(first.value, types)
  mutable uniform = true
  node.pairs.each do |pair|
    uniform = false unless synthesize(pair.key, types) == key
    uniform = false unless synthesize(pair.value, types) == entry
  end
  return ["hash", key, entry] if uniform
  ["hash", ["unknown"], ["unknown"]]
end

# A def's return type (3b): parameters enter as unknown — the hybrid
# caller-flow half of ADR 0040 is a later increment — except that a
# default lends its type. The body reads in order; early returns and the
# last statement must agree, a lone nil among them makes a maybe, and any
# other disagreement is an opinion withheld.
def synthesize_def_return(node, mutable types)
  node.parameters.each do |parameter|
    types = [[parameter.name, parameter_type(parameter, types)]] + types
  end
  synthesize_body(node.body, types)
end

def parameter_type(parameter, types)
  if (parameter in AssignmentNode) && parameter.value.some?
    return synthesize(parameter.value, types)
  end
  if (parameter in KeywordParameterNode) && parameter.default.some?
    return synthesize(parameter.default, types)
  end
  ["unknown"]
end

# A statement body's answer: each statement is read with the bindings the
# ones above it left (bind_after), early returns join the last statement
# as candidates, and merge_candidates rules.
def synthesize_body(body, mutable types)
  mutable early = []
  mutable last = ["nil"]
  body.each do |statement|
    early += return_types_in(statement, types)
    last = statement_answer(statement, types)
    types = bind_after(statement, types, [])
  end
  merge_candidates(early + [last])
end

def statement_answer(statement, types)
  return synthesize(statement.value, types) if statement in AssignmentNode
  return return_answer(statement, types) if statement in ReturnNode
  synthesize(statement, types)
end

def return_answer(statement, types)
  return ["nil"] if statement.value.nil?
  synthesize(statement.value, types)
end

# Every `return`'s type inside a statement, walking the branching forms.
def return_types_in(node, types)
  case node
  in ReturnNode then [return_answer(node, types)]
  in IfNode
    proof = narrowings(node.condition, types)
    mutable found = []
    found += returns_in_body(node.then_body, when_true(proof) + types)
    found += returns_in_body(node.else_body, when_false(proof) + types)
    found
  # A loop body may have run before any statement in it is read again, so
  # it is walked with its own rebindings already forgotten.
  in WhileNode then returns_in_body(node.body, forget_types(types, assigned_names_in_body(node.body)))
  in CaseNode
    mutable found = []
    node.branches.each do |branch|
      found += returns_in_body(branch.body, types)
    end
    found += returns_in_body(node.else_body, types)
    found
  in CaseInNode
    mutable found = []
    mutable nil_seen = false
    node.branches.each do |branch|
      found += returns_in_body(branch.body, arm_bindings(node, branch, nil_seen, types) + types)
      nil_seen = true if nil_arm?(branch)
    end
    found += returns_in_body(node.else_body, types)
    found
  else
    []
  end
end

def returns_in_body(body, mutable types)
  return [] if body.nil?
  mutable found = []
  body.each do |statement|
    found += return_types_in(statement, types)
    types = bind_after(statement, types, [])
  end
  found
end

# Agreement answers the type; a lone nil among agreeing others makes a
# maybe (the branch that answers nothing, ADR 0012); anything else is
# unknown.
def merge_candidates(candidates)
  mutable unique = []
  candidates.each do |candidate|
    unique << candidate unless unique.include?(candidate)
  end
  if unique.length <= 1
    only = unique.first or ["unknown"]
    return only
  end
  if unique.length == 2 && unique.include?(["nil"])
    other = unique.find { it != ["nil"] } or ["unknown"]
    return maybe_of(other)
  end
  ["unknown"]
end

def maybe_of(type)
  return type if (type in ["maybe", *]) || type == ["nil"] || type == ["unknown"]
  ["maybe", type]
end

# An if in value position (the ternary desugars here too, ADR 0046):
# agreeing branches answer their type, an absent or nil branch makes a
# maybe of the other. Each branch is read under what the condition proved
# on its side (narrowings).
def synthesize_if(node, types)
  proof = narrowings(node.condition, types)
  yes = branch_answer(node.then_body, when_true(proof) + types)
  no = branch_answer(node.else_body, when_false(proof) + types)
  merge_candidates([yes, no])
end

# A `case/in` in value position: the arms' answers must agree, each arm
# read with its captures bound (arm_bindings). An absent else answers nil
# (ADR 0012) — unless an unguarded bare capture makes the arms total.
def synthesize_case_in(node, types)
  mutable answers = []
  mutable nil_seen = false
  node.branches.each do |branch|
    answers << synthesize_body(branch.body, arm_bindings(node, branch, nil_seen, types) + types)
    nil_seen = true if nil_arm?(branch)
  end
  total = node.branches.any? { (it.pattern in IdentifierNode) && it.guard.nil? }
  answers << branch_answer(node.else_body, types) unless node.else_body.nil? && total
  merge_candidates(answers)
end

def branch_answer(body, types)
  return ["nil"] if body.nil? || body.empty?
  synthesize_body(body, types)
end

# `name << value` (3b): the append that first fills an empty literal names
# its element type — `mutable box = []` then `box << 3` reads as
# [Integer]. Strings stay strings; a disagreeing element widens back to
# unknown elements.
def synthesize_append(node, types)
  current = synthesize_name(node.name, types)
  return ["string"] if current == ["string"]
  value = synthesize(node.value, types)
  return ["array", value] if current == ["array", ["unknown"]]
  return current if (current in ["array", *]) && type_at(current, 1) == value
  return ["array", ["unknown"]] if current in ["array", *]
  ["unknown"]
end

def synthesize_identifier(node, types)
  synthesize_name(node.name, types)
end

def synthesize_name(name, types)
  found = types.find { it[0] == name }
  return ["unknown"] if found.nil?
  type_at(found, 1)
end

# The arithmetic and comparison operators, ADR 0018's shapes: whole numbers
# stay whole, one float anywhere makes a float, comparisons answer booleans.
def synthesize_binary(node, types)
  left = synthesize(node.left, types)
  right = synthesize(node.right, types)
  case node.operator
  when "==", "!=", "<", "<=", ">", ">=" then ["boolean"]
  when "+", "-", "*", "%"
    return ["integer"] if left == ["integer"] && right == ["integer"]
    return ["float"] if numeric?(left) && numeric?(right)
    return ["string"] if left == ["string"] && right == ["string"]
    return left if (left in ["array", *]) && (right in ["array", *])
    ["unknown"]
  when "/"
    return ["integer"] if left == ["integer"] && right == ["integer"]
    return ["float"] if numeric?(left) && numeric?(right)
    ["unknown"]
  when "**"
    # ADR 0033: integer bases stay integers (edges refuse at runtime);
    # any float anywhere answers a float.
    return ["integer"] if left == ["integer"] && right == ["integer"]
    return ["float"] if numeric?(left) && numeric?(right)
    ["unknown"]
  else
    ["unknown"]
  end
end

def synthesize_logical(node, types)
  left = synthesize(node.left, types)
  # The right side is read under what the left proved — `x.some? && x + 1`
  # sees a plain x; `x.nil? || x + 1` likewise.
  proof = narrowings(node.left, types)
  right_types = if node.operator == "&&" then when_true(proof) + types else when_false(proof) + types end
  right = synthesize(node.right, right_types)
  return left if left == right
  return ["unknown"] unless left in ["maybe", *]
  # `maybe or default` answers the plain type when the default is one of
  # it, and `maybe or return` the plain type outright — below the guard
  # the name is plain (the third form of ADR 0040 §3). Anything else is
  # an opinion withheld.
  inner = type_at(left, 1)
  return inner if exit?(node.right)
  return inner if right == inner
  ["unknown"]
end

def synthesize_unary(node, types)
  operand = synthesize(node.operand, types)
  return ["boolean"] if node.operator == "!"
  return operand if numeric?(operand)
  ["unknown"]
end

def numeric?(type)
  type == ["integer"] || type == ["float"]
end

# Builtin results, by receiver type and name — the signatures the evaluator
# already lives by, read back as types. Partial lookups answer maybes
# (ADR 0040 §3). Unlisted names answer unknown, never an error.
def synthesize_call(node, types)
  call_answer(synthesize(node.receiver, types), node, types)
end

# `x&.y` — a maybe of what `y` answers on the plain receiver (the seventh
# form of ADR 0040 §3); on a plain receiver the same, since some(x) is x.
def synthesize_safe_call(node, types)
  receiver = synthesize(node.receiver, types)
  plain = if receiver in ["maybe", *] then type_at(receiver, 1) else receiver end
  maybe_of(call_answer(plain, node, types))
end

def call_answer(receiver, node, types)
  return synthesize_block_call(node, receiver, types) if node.block.some?
  name = node.name
  # On a struct's name: `new` answers an instance, and any other name is a
  # type function the scan registered under `Name.function` (register_struct).
  return ["struct", type_at(receiver, 1)] if name == "new" && (receiver in ["type", *])
  return synthesize_name(type_at(receiver, 1) + "." + name, types) if receiver in ["type", *]
  # An updated copy is the same struct.
  return receiver if name == "with" && (receiver in ["struct", *])
  # The signatures below are the builtins'. On anything else — an unknown,
  # a struct, a maybe — only the names every value answers have a type;
  # a struct may define `length` or `lines` to answer whatever it likes,
  # and the method table (#88) caught `node.lines` reading as strings.
  return universal_answer(name) if builtin_methods(receiver).nil?
  case name
  when "length", "size", "count", "index", "gcd", "pow", "succ", "pred", "next", "abs", "magnitude", "sum", "to_i", "floor", "ceil", "round", "truncate"
    synthesize_numeric_answer(receiver, name)
  when "to_f" then ["float"]
  when "to_s", "upcase", "downcase", "capitalize", "swapcase", "reverse", "strip", "lstrip", "rstrip", "chomp", "join", "inspect"
    synthesize_text_answer(receiver, name)
  when "empty?", "include?", "member?", "key?", "has_key?", "start_with?", "end_with?", "zero?", "positive?", "negative?", "even?", "odd?", "nil?", "some?", "nan?", "finite?", "infinite?"
    ["boolean"]
  when "chars", "split", "lines" then ["array", ["string"]]
  when "keys"
    return ["array", type_at(receiver, 1)] if receiver in ["hash", *]
    ["array", ["unknown"]]
  when "values"
    return ["array", type_at(receiver, 2)] if receiver in ["hash", *]
    ["array", ["unknown"]]
  when "first", "last", "min", "max"
    # With a count, `first(2)` answers a slice, not a maybe; the survey for
    # ADR 0047 shape 3 found this arm calling one an Integer?.
    return ["unknown"] unless node.arguments.empty?
    return ["maybe", type_at(receiver, 1)] if receiver in ["array", *]
    return ["maybe", ["integer"]] if receiver == ["range"]
    ["unknown"]
  when "sort", "uniq", "compact", "flatten", "slice", "merge", "step", "to_a", "entries"
    synthesize_shape_answer(receiver, name)
  else
    ["unknown"]
  end
end

# The four names every value answers, and nothing else, on a receiver
# whose methods are its own to define.
def universal_answer(name)
  return ["boolean"] if name == "nil?" || name == "some?" || name == "failure?"
  return ["string"] if name == "to_s"
  ["unknown"]
end

def synthesize_numeric_answer(receiver, name)
  case name
  when "abs", "magnitude", "succ", "pred", "next", "gcd"
    return receiver if numeric?(receiver)
    return ["integer"] if name == "gcd"
    ["unknown"]
  when "index"
    return ["maybe", ["integer"]] if receiver == ["string"] || (receiver in ["array", *])
    ["unknown"]
  when "sum"
    # Whole numbers stay whole; anything else about the elements is 3b.
    return ["integer"] if receiver == ["array", ["integer"]]
    ["unknown"]
  when "pow" then receiver
  when "to_i", "floor", "ceil", "round", "truncate" then ["integer"]
  else
    ["integer"]
  end
end

def synthesize_text_answer(receiver, name)
  return ["string"] if name == "to_s" || name == "join" || name == "inspect"
  return ["string"] if receiver == ["string"]
  return receiver if receiver in ["array", *]
  ["unknown"]
end

def synthesize_shape_answer(receiver, name)
  case name
  when "sort", "uniq", "compact", "flatten", "slice"
    return receiver if receiver in ["array", *]
    return ["string"] if receiver == ["string"] && name == "slice"
    ["unknown"]
  when "merge"
    return receiver if receiver in ["hash", *]
    ["unknown"]
  when "step" then ["array", ["integer"]]
  when "to_a", "entries"
    return receiver if receiver in ["array", *]
    return ["array", ["integer"]] if receiver == ["range"]
    ["unknown"]
  else
    ["unknown"]
  end
end

# Block calls (3b): the parameters' types are read off the receiver — an
# array lends its element, a hash its key then value, a range integers —
# the body is synthesized with them bound, and the shape methods answer
# accordingly. Unlisted names answer unknown, never an error.
def synthesize_block_call(node, receiver, types)
  # A block method's answer is a builtin's; on any other receiver it is
  # whatever that receiver's own method says, which is unknown here.
  return ["unknown"] if builtin_methods(receiver).nil?
  mutable inner = types
  argument_types = node.arguments.map { synthesize(it, types) }
  node.block.parameters.each_with_index do |parameter, index|
    inner = [[parameter, block_parameter_type(receiver, index, node.name, argument_types)]] + inner
  end
  # A block body may run many times or never — like a loop's, it is read
  # with the names it rebinds already forgotten.
  body = synthesize_body(node.block.body, forget_types(inner, assigned_names_in_body(node.block.body)))
  case node.name
  when "map", "collect" then ["array", body]
  when "find", "detect", "min_by", "max_by"
    return ["maybe", element_type(receiver)] if receiver in ["array", *]
    ["unknown"]
  when "count", "sum", "index" then synthesize_numeric_answer(receiver, node.name)
  when "all?", "any?", "none?", "one?" then ["boolean"]
  when "select", "filter", "reject", "sort_by", "each", "each_with_index"
    return receiver if (receiver in ["array", *]) || (receiver in ["hash", *])
    ["unknown"]
  else
    ["unknown"]
  end
end

# A block parameter's type, by the receiver and the method: the element
# for most, a hash's key then value. `reduce` and `inject` bind the
# accumulator first — its type is the initial argument's, or unknown
# without one — and `each_with_index` the element then an integer. Found
# by a fixture whose `reduce(0) { |count, line| count + … }` read `count`
# as the element and refused a working `+`.
def block_parameter_type(receiver, index, name, argument_types)
  if name == "reduce" || name == "inject"
    return accumulator_type(argument_types) if index == 0
    return element_type(receiver) if index == 1
    return ["unknown"]
  end
  if name == "each_with_index"
    return element_type(receiver) if index == 0
    return ["integer"] if index == 1
    return ["unknown"]
  end
  if receiver in ["hash", *]
    return type_at(receiver, 1) if index == 0
    return type_at(receiver, 2) if index == 1
    return ["unknown"]
  end
  return ["unknown"] unless index == 0
  element_type(receiver)
end

def accumulator_type(argument_types)
  initial = type_at(argument_types, 0)
  return ["unknown"] if initial.nil?
  initial
end

def element_type(receiver)
  return type_at(receiver, 1) if receiver in ["array", *]
  return ["integer"] if receiver == ["range"]
  ["unknown"]
end

# How a type is written back out, for the debug driver. This rendering is
# NOT ratified surface — the error-voice decision owns the real spelling —
# it is the plainest thing that could work in a dump.
def render_type(type)
  case type
  in ["array", element] then "[" + render_type(element) + "]"
  in ["hash", key, entry] then "{" + render_type(key) + " => " + render_type(entry) + "}"
  in ["maybe", inner] then render_type(inner) + "?"
  in ["struct", name] then name
  in ["type", name] then name
  in ["enum", name] then name
  else
    label = type_at(type, 0)
    label.slice(0, 1).upcase + label.slice(1, label.length - 1)
  end
end

# Raw positional read: host indexing lifts nil, and a type cell can hold
# ["nil"] legitimately.
def type_at(list, target_index)
  mutable result = nil
  list.each_with_index do |element, index|
    result = element if index == target_index
  end
  result
end

# — the builtin method table (#88) —
#
# What each builtin receiver answers, with what: `include?/1`, `slice/2`,
# `first/0-1`, `each/0&` (block-taking). Derived from the seed's *behavior*
# by script/probe_builtin_methods rather than from a reading of its Rust —
# run the script and paste, so the seed stays the oracle (principle 7) and
# the spec suite, which exercises every builtin, stands guard over a name
# gone missing. The seed reads these same eight lines at build for its own
# wordings, so this is the table's one home. The four names every value
# answers are in each list; nil is left out on purpose, the runtime's own
# sentence handling it.
def builtin_table(type)
  case type
  in ["string"] then %w[capitalize/0 chars/0 chomp/0 count/1 downcase/0 empty?/0 end_with?/1 failure?/0 include?/1 index/1 length/0 lines/0 lstrip/0 nil?/0 reverse/0 rstrip/0 size/0 slice/2 some?/0 split/1 start_with?/1 strip/0 swapcase/0 to_f/0 to_i/0 to_s/0 upcase/0]
  in ["integer"] then %w[abs/0 downto/1& even?/0 failure?/0 gcd/1 magnitude/0 negative?/0 next/0 nil?/0 odd?/0 positive?/0 pow/1 pred/0 some?/0 succ/0 times/0& to_f/0 to_s/0-1 upto/1& zero?/0]
  in ["float"] then %w[abs/0 ceil/0 failure?/0 finite?/0 floor/0 infinite?/0 magnitude/0 nan?/0 nil?/0 pow/1 round/0 some?/0 to_f/0 to_i/0 to_s/0 truncate/0 zero?/0]
  in ["boolean"] then %w[failure?/0 nil?/0 some?/0 to_s/0]
  in ["symbol"] then %w[failure?/0 nil?/0 some?/0 to_s/0]
  in ["array", *] then %w[all?/0& any?/0& collect/0& collect_concat/0& compact/0 count/0-1 detect/0& each/0& each_slice/1 each_with_index/0& empty?/0 entries/0 failure?/0 filter/0& find/0& find_all/0& first/0-1 flat_map/0& flatten/0 include?/1 index/1 inject/1& join/1 last/0-1 length/0 map/0& max/0 member?/1 min/0 nil?/0 none?/0& reduce/1& reject/0& reverse/0 select/0& size/0 slice/2 some?/0 sort/0 sort_by/0& sum/0 tally/0 to_a/0 to_s/0 uniq/0 zip/1]
  in ["hash", *] then %w[dig/1-2 each/0& each_pair/0& empty?/0 entries/0 failure?/0 has_key?/1 include?/1 key?/1 keys/0 length/0 member?/1 merge/1 nil?/0 size/0 some?/0 to_a/0 to_s/0 values/0]
  in ["range"] then %w[all?/0& any?/0& collect/0& collect_concat/0& count/0-1 detect/0& each/0& each_with_index/0& failure?/0 filter/0& find/0& find_all/0& first/0-1 flat_map/0& include?/1& inject/1& last/0-1 length/0 map/0& max/0 min/0 nil?/0 none?/0& reduce/1& reject/0& select/0& size/0 some?/0 sort_by/0& step/1 sum/0 to_a/0& to_s/0]
  else
    nil
  end
end

# The names alone, for membership.
def builtin_methods(type)
  table = builtin_table(type)
  return nil if table.nil?
  table.map { entry_name(it) }
end

# An entry's arity as [low, high], or nil where the type has no such name.
def builtin_arity(type, name)
  table = builtin_table(type)
  return nil if table.nil?
  entry = table.find { entry_name(it) == name }
  return nil if entry.nil?
  arity = entry.split("/").last.split("&").first
  bounds = arity.split("-").map { it.to_i }
  [bounds.first, bounds.last]
end

def entry_name(entry) = entry.split("/").first

# The false aliases (ADR 0036): Ruby's implicit-conversion protocol wears
# conversion spellings, and each refuses by naming its survivor — the
# seed's table, so the checker says the seed's sentence where the table
# above would otherwise call the name missing.
def alias_survivor(name)
  case name
  when "to_ary" then "to_a"
  when "to_int" then "to_i"
  when "to_str" then "to_s"
  else
    nil
  end
end

# — contracts (ADR 0048, step one) —
#
# What a body demands of a parameter, read off the body alone: each
# dotted call on the name with its dot, each operator applied to it bare,
# an index as '[]' — first-appearance order, no repeats. A default lends
# its type instead, as it does for returns. Dump-only: nothing here is
# read by a check yet, and caller flow waits for a whole-program view
# (#94).

# Each top-level def's parameters, as [name, entry] pairs — an entry is a
# type where a default gives one, or ["needs", demands].
def infer_contracts(nodes)
  types = scan_program(nodes)
  mutable contracts = []
  nodes.each do |node|
    next unless node in DefNode
    entries = node.parameters.map { [it.name, parameter_entry(it, node.body, types)] }
    contracts << [node.name, entries]
  end
  contracts
end

def parameter_entry(parameter, body, types)
  typed = parameter_type(parameter, types)
  return typed unless typed == ["unknown"]
  ["needs", demands_in(body, parameter.name)]
end

def demands_in(nodes, name)
  mutable found = []
  nodes.each do |node|
    found = add_demands(node, name, found)
  end
  found
end

def add_demands(node, name, mutable found)
  return found if node.nil?
  demand = demand_of(node, name)
  found << demand unless demand.nil? || found.include?(demand)
  children_of(node).each do |child|
    found = add_demands(child, name, found)
  end
  found
end

def demand_of(node, name)
  if (node in MethodCallNode) || (node in SafeMethodCallNode)
    return "." + node.name if names?(node.receiver, name)
    return nil
  end
  if node in BinaryNode
    return node.operator if names?(node.left, name) || names?(node.right, name)
    return nil
  end
  return node.operator if (node in UnaryNode) && names?(node.operand, name)
  return "[]" if (node in IndexNode) && names?(node.receiver, name)
  nil
end

def names?(node, name) = (node in IdentifierNode) && node.name == name

# A node's direct children — every expression and statement it holds,
# blocks and branches included, patterns excluded — for a walk that looks
# for something anywhere inside a body. Defs, structs, traits, and modules
# are not descended into: their bodies bind their own names.
def children_of(node)
  case node
  in AssignmentNode(value:) then [value]
  in AppendNode(value:) then [value]
  in WhileNode(condition:, body:) then [condition] + body
  in IfNode(condition:, then_body:, else_body:) then [condition] + (then_body or []) + (else_body or [])
  in CaseNode(subject:, branches:, else_body:)
    mutable found = [subject]
    branches.each do |branch|
      found += branch.values + branch.body
    end
    found + (else_body or [])
  in CaseInNode(subject:, branches:, else_body:)
    mutable found = [subject]
    branches.each do |branch|
      found << branch.guard unless branch.guard.nil?
      found += branch.body
    end
    found + (else_body or [])
  in TogetherNode(lines:) then lines.map { if it in TaskLineNode then it.value else it end }
  in ReturnNode(value:) then [value]
  in CallNode(arguments:, block:) then arguments + block_body(block)
  in MethodCallNode(receiver:, arguments:, block:) then [receiver] + arguments + block_body(block)
  in SafeMethodCallNode(receiver:, arguments:, block:) then [receiver] + arguments + block_body(block)
  in ArrayNode(elements:) then elements
  in HashNode(pairs:) then pairs.map { it.key } + pairs.map { it.value }
  in BinaryNode(left:, right:) then [left, right]
  in LogicalNode(left:, right:) then [left, right]
  in UnaryNode(operand:) then [operand]
  in IndexNode(receiver:, index:) then [receiver, index]
  in IndexUpdateNode(index: update_index, value: update_value) then [update_index, update_value]
  in SlotCompoundNode(index: compound_index, right: compound_right) then [compound_index, compound_right]
  in MatchAssertNode(subject:) then [subject]
  in MatchTestNode(subject: test_subject) then [test_subject]
  in KeywordArgumentNode(value:) then [value]
  in EnumCaseNode(payload:) then payload.map { it.value }
  else
    []
  end
end

def block_body(block)
  return [] if block.nil?
  block.body
end

# — return annotations (ADR 0041) —
#
# The written annotation for a def, if its signature carries one: the
# arrow trails the line where the parameter list ends, which a trailing
# comma or a bare opener continues past (ADR 0045's shapes). Read off the
# source by line, since the lexer drops comments — the debug-tool version;
# when annotations want positions too, they become lexer trivia.
def annotation_for(source, name)
  lines = source.lines
  mutable found = nil
  lines.each_with_index do |line, index|
    next unless def_line_for?(line, name)
    found = signature_end_line(lines, index)
  end
  return nil if found.nil?
  marker = found.index("# -> ")
  return nil if marker.nil?
  tail = found.slice(marker + 5, found.length - marker - 5)
  tail.strip
end

def def_line_for?(line, name)
  stripped = line.strip
  prefix = "def #{name}"
  return false unless stripped.start_with?(prefix)
  return true if stripped == prefix
  boundary = stripped.slice(prefix.length, 1)
  boundary == "(" || boundary == " " || boundary == "="
end

def signature_end_line(lines, mutable index)
  while index + 1 < lines.length && signature_continues?(lines[index])
    index += 1
  end
  line = lines[index] or ""
  line
end

def signature_continues?(line)
  stripped = line.strip
  stripped.end_with?(",") || stripped.end_with?("(")
end

# — narrowing (ADR 0040 §3, the seven forms) —
#
# A condition proves something about a maybe-typed name on each side of a
# branch: `x.some?` holding makes x its plain type and failing makes it
# nil; `x.nil?` and `x == nil` the other way round; `!` swaps the sides;
# `&&` proves both halves when it holds and `||` both when it fails. A
# proof is [when_true, when_false], each a list of [name, type] pairs
# bound over the branch that sees it. Only an identifier narrows, since
# only a name can be rebound — `users.first.nil?` proves nothing about a
# later `users.first`. The exit guard and the or-guard bind below the
# statement (bind_after, synthesize_logical); `&.` is synthesize_safe_call;
# `case/in` over nil is arm_bindings.

def narrowings(condition, types)
  case condition
  in MethodCallNode then predicate_proof(condition, types)
  in BinaryNode then comparison_proof(condition, types)
  in UnaryNode(operator:, operand:)
    return no_proof unless operator == "!"
    proof = narrowings(operand, types)
    [when_false(proof), when_true(proof)]
  in LogicalNode(operator:, left:, right:)
    left_proof = narrowings(left, types)
    right_proof = narrowings(right, types)
    return [when_true(left_proof) + when_true(right_proof), []] if operator == "&&"
    return [[], when_false(left_proof) + when_false(right_proof)] if operator == "||"
    no_proof
  else
    no_proof
  end
end

def no_proof = [[], []]

def when_true(proof) = type_at(proof, 0)

def when_false(proof) = type_at(proof, 1)

# `x.some?` and `x.nil?` on a maybe-typed name.
def predicate_proof(node, types)
  return no_proof unless node.arguments.empty? && node.block.nil?
  return no_proof unless node.receiver in IdentifierNode
  name = node.receiver.name
  inner = maybe_inner(name, types)
  return no_proof if inner.nil?
  return [[[name, inner]], [[name, ["nil"]]]] if node.name == "some?"
  return [[[name, ["nil"]]], [[name, inner]]] if node.name == "nil?"
  no_proof
end

# `x == nil` and `x != nil`, either way round.
def comparison_proof(node, types)
  return no_proof unless node.operator == "==" || node.operator == "!="
  name = nil_comparison_name(node.left, node.right)
  return no_proof if name.nil?
  inner = maybe_inner(name, types)
  return no_proof if inner.nil?
  return [[[name, ["nil"]]], [[name, inner]]] if node.operator == "=="
  [[[name, inner]], [[name, ["nil"]]]]
end

def nil_comparison_name(left, right)
  return left.name if (left in IdentifierNode) && (right in NilNode)
  return right.name if (right in IdentifierNode) && (left in NilNode)
  nil
end

# The plain type under a maybe-typed name, or nil for anything else.
def maybe_inner(name, types)
  found = synthesize_name(name, types)
  return nil unless found in ["maybe", *]
  type_at(found, 1)
end

# What holds below an `if` whose one branch always leaves: the proof for
# the branch that stays. Nothing where both leave, or neither.
def guard_proof(node, types)
  proof = narrowings(node.condition, types)
  then_exits = body_exits?(node.then_body)
  else_exits = body_exits?(node.else_body)
  return when_false(proof) if then_exits && !else_exits
  return when_true(proof) if else_exits && !then_exits
  []
end

# A body that always leaves: its last statement returns, panics, or steps
# out of a loop.
def body_exits?(body)
  return false if body.nil? || body.empty?
  exit?(body.last)
end

def exit?(node)
  case node
  in ReturnNode | BreakNode | NextNode then true
  in CallNode(name:) then name == "panic"
  else
    false
  end
end

# What an arm of a `case/in` binds, as pairs to put before the types: a
# bare capture takes the subject's type — the plain type once an unguarded
# `in nil` arm above has taken the absent case (the fifth form; `in
# some(v)` is not a pattern either oracle parses), and an identifier
# subject narrows alongside it; `in nil` narrows an identifier subject to
# nil; every other capture is unknown.
def arm_bindings(node, branch, nil_seen, types)
  subject = synthesize(node.subject, types)
  pattern = branch.pattern
  plain = if (subject in ["maybe", *]) && nil_seen then type_at(subject, 1) else subject end
  if pattern in IdentifierNode
    mutable pairs = [[pattern.name, plain]]
    pairs = [[node.subject.name, plain]] + pairs if node.subject in IdentifierNode
    return pairs
  end
  if (pattern in NilNode) && (node.subject in IdentifierNode) && (subject in ["maybe", *])
    return [[node.subject.name, ["nil"]]]
  end
  pattern_names(pattern).map { [it, ["unknown"]] }
end

def nil_arm?(branch) = (branch.pattern in NilNode) && branch.guard.nil?

# — what a statement leaves behind —
#
# Every body walk here, and the checker's, threads bindings through
# bind_after. The rule that keeps the walks honest: a name a *nested* body
# rebinds — a branch, a loop, a block — is unknown after that statement,
# because whether the body ran is not the tree's to say, and a wrong type
# is worse than none (principle 4). Found the hard way: `mutable result =
# nil` rebound inside an `each` read as Nil, and the first refusal built
# on that read fired on the evaluator's own source.

# The bindings a statement leaves for the statements after it. `locals`
# is the list written to; `globals` is read alongside it and never
# written — the checker keeps the two apart, this file's own walks pass
# one list and an empty other.
def bind_after(statement, locals, globals)
  case statement
  in AssignmentNode(name:, value:)
    return locals if value.nil?
    widened = forget_types(locals, assigned_names_in(value))
    [[name, synthesize(value, widened + globals)]] + widened
  in AppendNode(name:) then [[name, synthesize(statement, locals + globals)]] + locals
  in MatchAssertNode(pattern:) then bind_unknowns(locals, pattern_names(pattern))
  in MatchTestNode(pattern:) then bind_unknowns(locals, pattern_names(pattern))
  in TogetherNode(lines:) then bind_unknowns(locals, task_line_names(lines))
  # An `if` whose one branch always leaves is a guard: what its condition
  # proved for the branch that stays holds below it (the first form —
  # `return if x.nil?`, plain x after). A rebinding inside still wins.
  in IfNode
    guarded = guard_proof(statement, locals + globals) + locals
    forget_types(guarded, assigned_names_in(statement))
  else
    forget_types(locals, assigned_names_in(statement))
  end
end

def task_line_names(lines)
  mutable names = []
  lines.each do |line|
    names << line.name if line in TaskLineNode
  end
  names
end

def bind_unknowns(locals, names)
  mutable bound = locals
  names.each do |name|
    bound = [[name, ["unknown"]]] + bound
  end
  bound
end

# A name already bound, rebound somewhere inside a nested body, is unknown
# from here on. A name new to that body dies with it (ADR 0001) and needs
# nothing.
def forget_types(locals, names)
  mutable widened = locals
  names.each do |name|
    next if locals.none? { it[0] == name }
    widened = [[name, ["unknown"]]] + widened
  end
  widened
end

# Every name an assignment or append inside this node binds, at any depth
# short of a def, struct, trait, or module — those bind their own.
def assigned_names_in(node)
  case node
  in AssignmentNode(name:, value:)
    return [name] if value.nil?
    [name] + assigned_names_in(value)
  # `box << 3` is rebind sugar — the assignment around it is the binding,
  # and the append itself names nothing new.
  in AppendNode(value:) then assigned_names_in(value)
  in WhileNode(condition:, body:) then assigned_names_in(condition) + assigned_names_in_body(body)
  in IfNode(condition:, then_body:, else_body:)
    assigned_names_in(condition) + assigned_names_in_body(then_body) + assigned_names_in_body(else_body)
  in CaseNode(subject:, branches:, else_body:)
    mutable found = assigned_names_in(subject) + assigned_names_in_body(else_body)
    branches.each do |branch|
      found += assigned_names_in_body(branch.values) + assigned_names_in_body(branch.body)
    end
    found
  in CaseInNode(subject:, branches:, else_body:)
    mutable found = assigned_names_in(subject) + assigned_names_in_body(else_body)
    branches.each do |branch|
      found += assigned_names_in_body(branch.body)
      found += assigned_names_in(branch.guard) unless branch.guard.nil?
    end
    found
  in TogetherNode(lines:)
    mutable found = []
    lines.each do |line|
      found += [line.name] + assigned_names_in(line.value) if line in TaskLineNode
      found += assigned_names_in(line) unless line in TaskLineNode
    end
    found
  in ReturnNode(value:) then assigned_names_in_body([value])
  in CallNode(arguments:, block:) then assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in MethodCallNode(receiver:, arguments:, block:)
    assigned_names_in(receiver) + assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in SafeMethodCallNode(receiver:, arguments:, block:)
    assigned_names_in(receiver) + assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in ArrayNode(elements:) then assigned_names_in_body(elements)
  in HashNode(pairs:)
    mutable found = []
    pairs.each do |pair|
      found += assigned_names_in(pair.key) + assigned_names_in(pair.value)
    end
    found
  in BinaryNode(left:, right:) then assigned_names_in(left) + assigned_names_in(right)
  in LogicalNode(left:, right:) then assigned_names_in(left) + assigned_names_in(right)
  in UnaryNode(operand:) then assigned_names_in(operand)
  in IndexNode(receiver:, index:) then assigned_names_in(receiver) + assigned_names_in(index)
  in IndexUpdateNode(index: update_index, value: update_value)
    assigned_names_in(update_index) + assigned_names_in(update_value)
  in SlotCompoundNode(index: compound_index, right: compound_right)
    assigned_names_in(compound_index) + assigned_names_in(compound_right)
  in MatchAssertNode(subject:, pattern:) then assigned_names_in(subject) + pattern_names(pattern)
  in MatchTestNode(subject: test_subject, pattern: test_pattern)
    assigned_names_in(test_subject) + pattern_names(test_pattern)
  in KeywordArgumentNode(value:) then assigned_names_in(value)
  in EnumCaseNode(payload:)
    mutable found = []
    payload.each do |argument|
      found += assigned_names_in(argument.value)
    end
    found
  else
    []
  end
end

def assigned_names_in_body(body)
  return [] if body.nil?
  mutable found = []
  body.each do |statement|
    found += assigned_names_in(statement) unless statement.nil?
  end
  found
end

def assigned_names_in_block(block)
  return [] if block.nil?
  assigned_names_in_body(block.body)
end

# The names a pattern captures. Every capture is a plain identifier, a
# pin reads rather than binds, and the shapes hold sub-patterns.
def pattern_names(pattern)
  case pattern
  in IdentifierNode(name:) then [name]
  in AlternativePatternNode(options:)
    mutable found = []
    options.each do |option|
      found += pattern_names(option)
    end
    found
  in ArrayPatternNode(elements:, rest_name:)
    mutable found = []
    elements.each do |element|
      found += pattern_names(element)
    end
    found << rest_name unless rest_name.nil?
    found
  in StructPatternNode(fields:)
    mutable found = []
    fields.each do |field|
      found += pattern_names(field[1])
    end
    found
  in EnumCasePatternNode(payload:)
    mutable found = []
    payload.each do |entry|
      found += pattern_names(entry[1])
    end
    found
  else
    []
  end
end
