# Stage 1, act four: inference — increments 3a and 3b of #9 (ADR 0040).
#
# A library: require_relative "inference", then infer_program(nodes) answers
# [name, type] pairs for the program's top-level bindings, and
# infer_methods(nodes) the same for its top-level defs' return types (3b).
# Synthesis only — types are read off literals, locals, operators, builtin
# results, def bodies, and block bodies with parameters bound from their
# receivers — and SILENT by doctrine: nothing here refuses anything, the
# checker does not consume these yet, and the only way to see a type is the
# debug driver (types.pdx). Inference widens where checks apply; it never
# gates their existence (ADR 0034 §4).
#
# A type is a tagged array, the same crude-on-purpose shape the evaluator
# uses for values:
#
#   IntegerType FloatType StringType BooleanType SymbolType NilType
#   RangeType(element)         — element is the ends' type (ADR 0081), or UnknownType
#   ArrayType(element)         — element is a type, or UnknownType
#   HashType(key, value)
#   MaybeType(inner)           — the wrapper, never a union (ADR 0040 §3)
#   StructType(name)           — an instance
#   StructType("*")            — an instance of one of the program's structs,
#                                whichever (#572): only the native build's
#                                pinning makes it
#   ClassType(name)            — the struct's name itself, what `new` is called on
#   EnumType(name)
#   UnknownType                — the honest answer, and the default
#
# UnknownType is principle 4 wearing a type: anything this increment cannot
# tell stays unknown, and later increments narrow it. Unknown is never an
# error — it is the absence of an opinion.
#
# — contracts (ADR 0048, step one) —
#
# What a body demands of a parameter, read off the body alone: each
# dotted call on the name with its dot, each operator applied to it bare,
# an index as '[]' — first-appearance order, no repeats. A default lends
# its type instead, as it does for returns. Dump-only: nothing here is
# read by a check yet, and caller flow waits for a whole-program view
# (#94).
#
# — narrowing (ADR 0040 §3, the seven forms) —
#
# A condition proves something about a maybe-typed name on each side of a
# branch: `x.some?` holding makes x its plain type and failing makes it
# nil; `x.nil?` and `x == nil` the other way round; `!` swaps the sides;
# `&&` proves both halves when it holds and `||` both when it fails. A
# proof is [when_true, when_false], each a list of [name, type] pairs
# bound over the branch that sees it. Only an identifier narrows, since
# only a name can be rebound — `users.first.nil?` proves nothing about a
# later `users.first`. The exit guard and the or-guard bind below the
# statement (bind_after, synthesize_logical); `&.` is synthesize_safe_call;
# `case/in` over nil is arm_bindings.
#
# — what a statement leaves behind —
#
# Every body walk here, and the checker's, threads bindings through
# bind_after. The rule that keeps the walks honest: a name a *nested* body
# rebinds — a branch, a loop, a block — is unknown after that statement,
# because whether the body ran is not the tree's to say, and a wrong type
# is worse than none (principle 4). Found the hard way: `mutable result =
# nil` rebound inside an `each` read as Nil, and the first refusal built
# on that read fired on the evaluator's own source.

require_relative "library_row"
require_relative "parser"
require_relative "type_kinds"

# A value that is one of the program's structs, whichever (#572): what
# a field made with one struct in one place and another elsewhere holds.
# No struct can be named `*`. It is a struct wherever one is asked for,
# and the struct it holds says which it is.
ANY_STRUCT = StructType.new(name: "*")

# The methods of a String and of an array the native build holds by name
# (#560), each as what it is asked of, its name, what it takes, what it
# answers, and the runtime function that does it. `element` stands for
# what the array asked holds, and `self` for the array asked.
NATIVE_LIBRARY = [
  LibraryRow.new(receiver: ArrayType.new(element: ElementType.new), name: "+", taking: [SelfType.new], answer: SelfType.new, symbol: "portland_array_concat"),
  LibraryRow.new(receiver: ArrayType.new(element: ElementType.new), name: "drop", taking: [IntegerType.new], answer: SelfType.new, symbol: "portland_array_drop"),
  LibraryRow.new(receiver: ArrayType.new(element: ElementType.new), name: "include?", taking: [ElementType.new], answer: BooleanType.new, symbol: "portland_array_include"),
  LibraryRow.new(receiver: ArrayType.new(element: IntegerType.new), name: "join", taking: [], answer: StringType.new, symbol: "portland_array_join"),
  LibraryRow.new(receiver: ArrayType.new(element: IntegerType.new), name: "join", taking: [StringType.new], answer: StringType.new, symbol: "portland_array_join_with"),
  LibraryRow.new(receiver: ArrayType.new(element: StringType.new), name: "join", taking: [], answer: StringType.new, symbol: "portland_array_join"),
  LibraryRow.new(receiver: ArrayType.new(element: StringType.new), name: "join", taking: [StringType.new], answer: StringType.new, symbol: "portland_array_join_with"),
  LibraryRow.new(receiver: ArrayType.new(element: ElementType.new), name: "slice", taking: [IntegerType.new, IntegerType.new], answer: SelfType.new, symbol: "portland_array_slice"),
  # A Hash keyed by Strings (#607). Its element is its value.
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "has_key?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_hash_key"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "include?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_hash_key"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "key?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_hash_key"),
  # The pair at a place, which the native core's walks over a Hash read
  # by; no program names them.
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "key_at", taking: [IntegerType.new], answer: StringType.new, symbol: "portland_hash_key_at"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "length", taking: [], answer: IntegerType.new, symbol: "portland_hash_length"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "member?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_hash_key"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "merge", taking: [SelfType.new], answer: SelfType.new, symbol: "portland_hash_merge"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "size", taking: [], answer: IntegerType.new, symbol: "portland_hash_length"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "value_at", taking: [IntegerType.new], answer: ElementType.new, symbol: "portland_hash_value_at"),
  LibraryRow.new(receiver: IntegerType.new, name: "chr", taking: [], answer: StringType.new, symbol: "portland_integer_chr"),
  LibraryRow.new(receiver: IntegerType.new, name: "chr", taking: [StringType.new], answer: StringType.new, symbol: "portland_integer_chr_encoded"),
  LibraryRow.new(receiver: IntegerType.new, name: "gcd", taking: [IntegerType.new], answer: IntegerType.new, symbol: "portland_integer_gcd"),
  LibraryRow.new(receiver: IntegerType.new, name: "**", taking: [IntegerType.new], answer: IntegerType.new, symbol: "portland_integer_power"),
  LibraryRow.new(receiver: IntegerType.new, name: "to_s", taking: [IntegerType.new], answer: StringType.new, symbol: "portland_integer_to_s_base"),
  LibraryRow.new(receiver: StringType.new, name: "bytesize", taking: [], answer: IntegerType.new, symbol: "portland_string_bytesize"),
  LibraryRow.new(receiver: StringType.new, name: "chars", taking: [], answer: ArrayType.new(element: StringType.new), symbol: "portland_string_chars"),
  LibraryRow.new(receiver: StringType.new, name: "chop", taking: [], answer: StringType.new, symbol: "portland_string_chop"),
  LibraryRow.new(receiver: StringType.new, name: "chr", taking: [], answer: StringType.new, symbol: "portland_string_chr"),
  LibraryRow.new(receiver: StringType.new, name: "codepoints", taking: [], answer: ArrayType.new(element: IntegerType.new), symbol: "portland_string_codepoints"),
  LibraryRow.new(receiver: StringType.new, name: "count", taking: [StringType.new], answer: IntegerType.new, symbol: "portland_string_count"),
  LibraryRow.new(receiver: StringType.new, name: "downcase", taking: [], answer: StringType.new, symbol: "portland_string_downcase"),
  LibraryRow.new(receiver: StringType.new, name: "end_with?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_string_end_with"),
  LibraryRow.new(receiver: StringType.new, name: "include?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_string_include"),
  LibraryRow.new(receiver: StringType.new, name: "index", taking: [StringType.new], answer: MaybeType.new(inner: IntegerType.new), symbol: "portland_string_index"),
  LibraryRow.new(receiver: StringType.new, name: "rjust", taking: [IntegerType.new, StringType.new], answer: StringType.new, symbol: "portland_string_rjust"),
  LibraryRow.new(receiver: StringType.new, name: "slice", taking: [IntegerType.new, IntegerType.new], answer: StringType.new, symbol: "portland_string_slice"),
  LibraryRow.new(receiver: StringType.new, name: "split", taking: [StringType.new], answer: ArrayType.new(element: StringType.new), symbol: "portland_string_split"),
  LibraryRow.new(receiver: StringType.new, name: "split", taking: [StringType.new, IntegerType.new], answer: ArrayType.new(element: StringType.new), symbol: "portland_string_split_limit"),
  LibraryRow.new(receiver: StringType.new, name: "start_with?", taking: [StringType.new], answer: BooleanType.new, symbol: "portland_string_start_with"),
  LibraryRow.new(receiver: StringType.new, name: "strip", taking: [], answer: StringType.new, symbol: "portland_string_strip"),
  LibraryRow.new(receiver: StringType.new, name: "to_i", taking: [], answer: IntegerType.new, symbol: "portland_string_to_i"),
  LibraryRow.new(receiver: StringType.new, name: "upcase", taking: [], answer: StringType.new, symbol: "portland_string_upcase"),
  # `text[index]`, and `text[from..to]` and an array's, which are written
  # with brackets and reach the library under these names.
  LibraryRow.new(receiver: StringType.new, name: "[]", taking: [IntegerType.new], answer: MaybeType.new(inner: StringType.new), symbol: "portland_string_character"),
  LibraryRow.new(receiver: StringType.new, name: "[..]", taking: [IntegerType.new, IntegerType.new, IntegerType.new], answer: StringType.new, symbol: "portland_string_range"),
  LibraryRow.new(receiver: ArrayType.new(element: ElementType.new), name: "[..]", taking: [IntegerType.new, IntegerType.new, IntegerType.new], answer: SelfType.new, symbol: "portland_array_range"),
  LibraryRow.new(receiver: HashType.new(key: StringType.new, value: ElementType.new), name: "[]", taking: [StringType.new], answer: MaybeType.new(inner: ElementType.new), symbol: "portland_hash_get")
]

# The name the native build's pinning reads under (#503): bound by it and
# by nothing else, and spelled as no local can be. Under it, inference
# answers the way a code generator needs and a checker does not: an
# element read by index is a maybe of the element, and a maybe used where
# a value is needed is read as the value, since the native build opens
# it when the line runs, as the interpreters do. The checker binds no
# such name, and withholds both opinions.
NATIVE_READING = "native&"

# What a def that produces no value answers. `puts` produces none (#185),
# so a def that ends in one has nothing to hand back, and neither has a
# def that ends in a loop or in a call to such a def. It is a type only
# under the native reading: the checker has no word for it, and a program
# cannot hold one.
NOTHING = NothingType.new

# The name a `yield` is read under: a keyword, so no local has it.
YIELD = "yield"

# The name bound where the block a def was handed can leave it (#523):
# a block written in that def which yields can then leave too.
YIELD_LEAVES = "yield leaves"

# Bindings in layers (#607): a Hash from name to type, the newest, over
# the layers beneath it, or nil where there are none. A name is read from
# the newest layer that binds it. Laying bindings over others, as a body's
# locals over a program's answers, copies neither.
struct Bindings
  near
  far
end

# A value that is one of several structs, taken as the one named (#572):
# no source spells it. It stands where the receiver did, as the first
# argument of that struct's method, in the arm of a call that runs only
# where the value is that struct.
struct NarrowedNode
  kind
  value
  name
  line
end

# A maybe opened for a method the native build compiles as a def (#525):
# no source spells it. It stands where the receiver did, as the def's
# first argument, and says which method nil is to be refused for.
struct OpenedNode
  kind
  value
  name
  line
end

def accumulator_type(argument_types)
  initial = type_at(argument_types, 0)
  return UnknownType.new if initial.nil?
  initial
end

def add_demands(node, name, mutable found)
  return found if node.nil?
  # A `case/in` on the name itself narrows it: what an arm asks, it asks
  # of the value that arm matched, never of every value the def is handed
  # (#457).
  return found if (node in CaseInNode) && names?(node.subject, name)
  # So does an `in` test of the name (#593): what an `if` asks of it where
  # the test holds is asked of a value the test matched.
  if (node in IfNode) && proves_shape?(node.condition, name)
    found = add_demands(node.condition, name, found)
    (node.else_body or []).each do |statement|
      found = add_demands(statement, name, found)
    end
    return found
  end
  demand = demand_of(node, name)
  found << demand unless demand.nil? || found.include?(demand)
  children_of(node).each do |child|
    found = add_demands(child, name, found)
  end
  found
end

# The false aliases (ADR 0036): Ruby's implicit-conversion protocol wears
# conversion spellings, and each refuses by naming its survivor — the
# seed's table, so the checker says the seed's sentence where the builtin
# method table would otherwise call the name missing.
def alias_survivor(name)
  case name
  when "to_ary" then "to_a"
  when "to_int" then "to_i"
  when "to_str" then "to_s"
  else
    nil
  end
end

# — return annotations (ADR 0041) —
#
# The written annotation for a def, if its signature carries one: the
# arrow trails the line where the parameter list ends, which a trailing
# comma or a bare opener continues past (ADR 0045's shapes). Read off the
# source by line, since the lexer drops comments — the debug-tool version;
# when annotations want positions too, they become lexer trivia.
def annotation_for(source, name)
  lines = source.lines
  mutable found = nil
  lines.each_with_index do |line, index|
    next unless def_line_for?(line, name)
    found = signature_end_line(lines, index)
  end
  return nil if found.nil?
  marker = found.index("# -> ")
  return nil if marker.nil?
  tail = found.slice(marker + 5, found.length - marker - 5)
  tail.strip
end

# The name the structs that write a method of one name are bound under
# (#572), which no def, field, or local is spelled as.
def any_method_key(name) = "//#{name}"

# What an arm of a `case/in` binds, as pairs to put before the types: a
# bare capture takes the subject's type — the plain type once an unguarded
# `in nil` arm above has taken the absent case (the fifth form; `in
# some(v)` is not a pattern either oracle parses), and an identifier
# subject narrows alongside it; `in nil` narrows an identifier subject to
# nil; every other capture is unknown.
def arm_bindings(node, branch, nil_seen, types)
  subject = synthesize(node.subject, types)
  pattern = branch.pattern
  plain = if (subject in MaybeType) && nil_seen then subject.inner else subject end
  if pattern in IdentifierNode
    mutable pairs = bound_one(pattern.name, plain)
    pairs = with_bound(pairs, node.subject.name, plain) if node.subject in IdentifierNode
    return pairs
  end
  if (pattern in NilNode) && (node.subject in IdentifierNode) && (subject in MaybeType)
    return bound_one(node.subject.name, NilType.new)
  end
  bind_unknowns(no_bindings, pattern_names(pattern))
end

# Every name an assignment or append inside this node binds, at any depth
# short of a def, struct, trait, or module — those bind their own.
def assigned_names_in(node)
  case node
  in AssignmentNode(name:, value:)
    return [name] if value.nil?
    [name] + assigned_names_in(value)
  # `box << 3` is rebind sugar — the assignment around it is the binding,
  # and the append itself names nothing new.
  in AppendNode(value:) then assigned_names_in(value)
  in WhileNode(condition:, body:) then assigned_names_in(condition) + assigned_names_in_body(body)
  in IfNode(condition:, then_body:, else_body:)
    assigned_names_in(condition) + assigned_names_in_body(then_body) + assigned_names_in_body(else_body)
  in CaseNode(subject:, branches:, else_body:)
    mutable found = assigned_names_in(subject) + assigned_names_in_body(else_body)
    branches.each do |branch|
      found += assigned_names_in_body(branch.values) + assigned_names_in_body(branch.body)
    end
    found
  in CaseInNode(subject:, branches:, else_body:)
    mutable found = assigned_names_in(subject) + assigned_names_in_body(else_body)
    branches.each do |branch|
      found += assigned_names_in_body(branch.body)
      found += assigned_names_in(branch.guard) unless branch.guard.nil?
    end
    found
  in TogetherNode(lines:)
    mutable found = []
    lines.each do |line|
      found += [line.name] + assigned_names_in(line.value) if line in TaskLineNode
      found += assigned_names_in(line) unless line in TaskLineNode
    end
    found
  in ReturnNode(value:) then assigned_names_in_body([value])
  in CallNode(arguments:, block:) then assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in MethodCallNode(receiver:, arguments:, block:)
    assigned_names_in(receiver) + assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in SafeMethodCallNode(receiver:, arguments:, block:)
    assigned_names_in(receiver) + assigned_names_in_body(arguments) + assigned_names_in_block(block)
  in ArrayNode(elements:) then assigned_names_in_body(elements)
  in HashNode(pairs:)
    mutable found = []
    pairs.each do |pair|
      found += assigned_names_in(pair.key) + assigned_names_in(pair.value)
    end
    found
  in BinaryNode(left:, right:) then assigned_names_in(left) + assigned_names_in(right)
  in LogicalNode(left:, right:) then assigned_names_in(left) + assigned_names_in(right)
  in UnaryNode(operand:) then assigned_names_in(operand)
  in IndexNode(receiver:, index:) then assigned_names_in(receiver) + assigned_names_in(index)
  in IndexUpdateNode(index: update_index, value: update_value)
    assigned_names_in(update_index) + assigned_names_in(update_value)
  in SlotCompoundNode(index: compound_index, right: compound_right)
    assigned_names_in(compound_index) + assigned_names_in(compound_right)
  in MatchAssertNode(subject:, pattern:) then assigned_names_in(subject) + pattern_names(pattern)
  in MatchTestNode(subject: test_subject, pattern: test_pattern)
    assigned_names_in(test_subject) + pattern_names(test_pattern)
  in KeywordArgumentNode(value:) then assigned_names_in(value)
  in EnumCaseNode(payload:)
    mutable found = []
    payload.each do |argument|
      found += assigned_names_in(argument.value)
    end
    found
  else
    []
  end
end

def assigned_names_in_block(block)
  return [] if block.nil?
  assigned_names_in_body(block.body)
end

def assigned_names_in_body(body)
  return [] if body.nil?
  mutable found = []
  body.each do |statement|
    found += assigned_names_in(statement) unless statement.nil?
  end
  found
end

# The bindings a statement leaves for the statements after it. `locals`
# is the list written to; `globals` is read alongside it and never
# written — the checker keeps the two apart, this file's own walks pass
# one list and an empty other.
def bind_after(statement, locals, globals)
  # A match test anywhere in a statement — `hit = scores in [low, high]`,
  # `if x in [head, tail]` — binds its captures below it (one_line_spec and
  # capture_spec pin it), as unknowns: whether it hit is not the tree's to say.
  bind_unknowns(bind_after_core(statement, locals, globals), condition_captures(statement))
end

def bind_after_core(statement, locals, globals)
  case statement
  in AssignmentNode(name:, value:)
    return locals if value.nil?
    widened = forget_types(locals, assigned_names_in(value))
    with_bound(widened, name, synthesize(value, with_bindings(globals, widened)))
  in AppendNode(name:) then with_bound(locals, name, synthesize(statement, with_bindings(globals, locals)))
  in MatchAssertNode(pattern:) then bind_unknowns(locals, pattern_names(pattern))
  in MatchTestNode(pattern:) then bind_unknowns(locals, pattern_names(pattern))
  in TogetherNode(lines:) then bind_unknowns(locals, task_line_names(lines))
  # An `if` whose one branch always leaves is a guard: what its condition
  # proved for the branch that stays holds below it (the first form —
  # `return if x.nil?`, plain x after). A rebinding inside still wins.
  in IfNode
    guarded = with_bindings(locals, guard_proof(statement, with_bindings(globals, locals)))
    forget_types(guarded, assigned_names_in(statement))
  # A `case/in` arm's captures outlive the case (capture_spec pins it), as
  # unknowns — which arm ran is not the tree's to say.
  in CaseInNode(branches:)
    mutable captured = []
    branches.each do |branch|
      captured += pattern_names(branch.pattern)
    end
    bind_unknowns(forget_types(locals, assigned_names_in(statement)), captured)
  else
    forget_types(locals, assigned_names_in(statement))
  end
end

def bind_unknowns(locals, names)
  mutable bound = locals
  names.each do |name|
    bound = with_bound(bound, name, UnknownType.new)
  end
  bound
end

# What a name is bound to in these bindings, or nil where it is not bound
# (#607). The newest binding of a name is the one read. Every read of the
# bindings by a name goes through here, and every binding through
# `with_bound` and `with_bindings`, so what holds them is said once.
def binding_type(types, name)
  found = types.near[name]
  return found if found.some?
  beneath = types.far
  return nil if beneath.nil?
  binding_type(beneath, name)
end

# Bindings as one Hash from name to type (#607), every layer flattened,
# the newest binding of a name kept. A walk over every binding reads them
# through here; a read of one name never does.
def bindings_hash(types)
  beneath = types.far
  return types.near if beneath.nil?
  bindings_hash(beneath).merge(types.near)
end

def block_body(block)
  return [] if block.nil?
  block.body
end

# Whether a block has a `break` of its own (#523): one written in it and
# outside any loop or block inside it, which would be that loop's or
# that block's.
def block_breaks?(body)
  body.any? { node_breaks?(it) }
end

# A block parameter's type, by the receiver and the method: the element
# for most, a hash's key then value. `reduce` and `inject` bind the
# accumulator first — its type is the initial argument's, or unknown
# without one — and `each_with_index` the element then an integer. Found
# by a fixture whose `reduce(0) { |count, line| count + … }` read `count`
# as the element and refused a working `+`.
def block_parameter_type(receiver, index, name, argument_types, parameter_count: 1)
  # `times` hands the turn it is on (#565).
  return IntegerType.new if name == "times" && receiver == IntegerType.new && index == 0
  if name == "reduce" || name == "inject"
    return accumulator_type(argument_types) if index == 0
    return element_type(receiver) if index == 1
    return UnknownType.new
  end
  if name == "each_with_index"
    return element_type(receiver) if index == 0
    return IntegerType.new if index == 1
    return UnknownType.new
  end
  if receiver in HashType
    # `each_value` and `transform_values` hand the value alone (#105).
    return receiver.value if index == 0 && (name == "each_value" || name == "transform_values")
    return receiver.key if index == 0
    return receiver.value if index == 1
    return UnknownType.new
  end
  # An arrangement handed over by the combinatorics (#104) is an array of
  # the receiver's elements.
  if index == 0 && (receiver in ArrayType) && %w[combination repeated_combination permutation repeated_permutation product].include?(name)
    return receiver
  end
  # A neighbouring pair (#110): chunk_while and slice_when hand two
  # elements, not one spread.
  if (receiver in ArrayType) && (name == "chunk_while" || name == "slice_when")
    return element_type(receiver) if index <= 1
    return UnknownType.new
  end
  # A spreading block (ADR 0057): two or more parameters over a method
  # that yields one value take the element's own elements.
  if parameter_count >= 2
    element = element_type(receiver)
    return element.element if element in ArrayType
    return UnknownType.new
  end
  return UnknownType.new unless index == 0
  element_type(receiver)
end

# Whether a `return` is written anywhere inside a block (#523), the
# blocks inside it included: each leaves the def they are all written in.
def block_returns?(body)
  body.any? { (it in ReturnNode) || block_returns?(children_of(it)) }
end

# A body that always leaves: its last statement returns, panics, or steps
# out of a loop.
def body_exits?(body)
  return false if body.nil? || body.empty?
  exit?(body.last)
end

# Bindings of one name (#607), as a proof binds what it proved.
def bound_one(name, type) = Bindings.new(near: {name => type}, far: nil)

def branch_answer(body, types)
  return NilType.new if body.nil? || body.empty?
  synthesize_body(body, types)
end

# An entry's arity as [low, high], or nil where the type has no such name.
def builtin_arity(type, name)
  table = builtin_table(type)
  return nil if table.nil?
  entry = table.find { entry_name(it) == name }
  return nil if entry.nil?
  arity = entry.split("/").last.split("&").first
  # A trailing `+` takes any number from there (`values_at/0+`).
  return [arity.slice(0, arity.length - 1).to_i, 9223372036854775807] if arity.end_with?("+")
  bounds = arity.split("-").map { it.to_i }
  [bounds.first, bounds.last]
end

# The names alone, for membership.
def builtin_methods(type)
  table = builtin_table(type)
  return nil if table.nil?
  table.map { entry_name(it) }
end

# — the builtin method table (#88) —
#
# What each builtin receiver answers, with what: `include?/1`, `slice/2`,
# `first/0-1`, `each/0&` (block-taking). Derived from the seed's *behavior*
# by script/probe_builtin_methods rather than from a reading of its Rust —
# run the script and paste, so the seed stays the oracle (principle 7) and
# the spec suite, which exercises every builtin, stands guard over a name
# gone missing. The seed reads these same lines at build for its own
# wordings, so this is the table's one home. The names every value
# answers are in each list; nil is left out on purpose, the runtime's own
# sentence handling it.
def builtin_table(type)
  case type
  in StringType then %w[!~/1 =~/1 ascii_only?/0 between?/2 bytes/0 bytesize/0 capitalize/0 casecmp/1 casecmp?/1 center/1-2 chars/0 chomp/0-1 chop/0 chr/0 clamp/1-2 class/0 codepoints/0 count/1 delete/1+ delete_prefix/1 delete_suffix/1 downcase/0 each_byte/0& each_char/0& each_codepoint/0& each_grapheme_cluster/0& each_line/0-1& empty?/0 encoding/0 end_with?/0+ eql?/1 failure?/0 grapheme_clusters/0 gsub/1-2& hex/0 include?/1 index/1-2 intern/0 length/0 lines/0-1 ljust/1-2 lstrip/0 match/1-2& match?/1-2 next/0 nil?/0 oct/0 ord/0 partition/1 reverse/0 rindex/1-2 rjust/1-2 rpartition/1 rstrip/0 scan/1& size/0 slice/1-2 some?/0 split/0-2& squeeze/0+ start_with?/0+ strip/0 sub/1-2& succ/0 swapcase/0 to_c/0 to_f/0 to_i/0-1 to_r/0 to_s/0 to_sym/0 tr/2 tr_s/2 unicode_normalize/0-1 unicode_normalized?/0-1 upcase/0 upto/1-2& valid_encoding?/0]
  in IntegerType then %w[abs/0 abs2/0 allbits?/1 angle/0 anybits?/1 arg/0 between?/2 bit_and/1 bit_count/0 bit_length/0 bit_not/0 bit_or/1 bit_xor/1 ceil/0-1 ceildiv/1 chr/0-1 clamp/1-2 class/0 conj/0 conjugate/0 denominator/0 digits/0-1 div/1 divmod/1 downto/1& eql?/1 even?/0 failure?/0 fdiv/1 floor/0-1 gcd/1 gcdlcm/1 i/0 imag/0 imaginary/0 lcm/1 magnitude/0 modulo/1 negative?/0 next/0 nil?/0 nobits?/1 numerator/0 odd?/0 ord/0 phase/0 polar/0 positive?/0 pow/1 pred/0 quo/1 rationalize/0-1 real/0 real?/0 rect/0 rectangular/0 remainder/1 round/0-1 shift_left/1 shift_right/1 size/0 some?/0 step/1-2& succ/0 times/0& to_c/0 to_f/0 to_i/0 to_r/0 to_s/0-1 truncate/0-1 upto/1& zero?/0]
  in FloatType then %w[abs/0 abs2/0 angle/0 arg/0 between?/2 ceil/0 clamp/1-2 class/0 conj/0 conjugate/0 denominator/0 div/1 divmod/1 eql?/1 failure?/0 fdiv/1 finite?/0 floor/0 i/0 imag/0 imaginary/0 infinite?/0 magnitude/0 modulo/1 nan?/0 negative?/0 next_float/0 nil?/0 numerator/0 phase/0 polar/0 positive?/0 pow/1 prev_float/0 quo/1 rationalize/0-1 real/0 real?/0 rect/0 rectangular/0 remainder/1 round/0 some?/0 to_c/0 to_f/0 to_i/0 to_r/0 to_s/0 truncate/0 zero?/0]
  in BooleanType then %w[class/0 eql?/1 failure?/0 nil?/0 some?/0 to_s/0]
  in SymbolType then %w[!~/1 =~/1 capitalize/0 class/0 downcase/0 empty?/0 encoding/0 end_with?/0+ eql?/1 failure?/0 id2name/0 intern/0 length/0 match/1-2& match?/1-2 name/0 next/0 nil?/0 size/0 slice/1-2 some?/0 start_with?/0+ succ/0 swapcase/0 to_s/0 to_sym/0 upcase/0]
  in ArrayType then %w[all?/0-1& any?/0-1& assoc/1 at/1 bsearch/0& bsearch_index/0& chunk/0& chunk_while/0& class/0 collect/0& collect_concat/0& combination/1& compact/0 count/0-1& cycle/1& detect/0& difference/0+ dig/1+ drop/1 drop_while/0& each/0& each_cons/1 each_index/0& each_slice/1 each_with_index/0& empty?/0 entries/0 eql?/1 failure?/0 filter/0& filter_map/0& find/0& find_all/0& find_index/0-1& first/0-1 flat_map/0& flatten/0-1 grep/1& grep_v/1& group_by/0& include?/1 index/0-1& inject/1& intersect?/1 intersection/0+ join/0-1 last/0-1 length/0 map/0& max/0& max_by/0& member?/1 min/0& min_by/0& minmax/0& minmax_by/0& nil?/0 none?/0-1& one?/0-1& partition/0& permutation/0-1& product/0+& rassoc/1 reduce/1& reject/0& repeated_combination/1& repeated_permutation/1& reverse/0 reverse_each/0& rfind/0& rindex/0-1& rotate/0-1 sample/0-1 select/0& shuffle/0 size/0 slice/2 slice_after/0-1& slice_before/0-1& slice_when/0& some?/0 sort/0& sort_by/0& sum/0-1& take/1 take_while/0& tally/0 to_a/0 to_h/0& to_s/0 to_set/0& transpose/0 union/0+ uniq/0 values_at/0+ zip/1]
  in HashType then %w[all?/0-1& any?/0-1& assoc/1 chunk/0& chunk_while/0& class/0 collect/0& collect_concat/0& compact/0 count/0-1& cycle/1& detect/0& dig/1+ drop/1 drop_while/0& each/0& each_key/0& each_pair/0& each_value/0& each_with_index/0& empty?/0 entries/0 eql?/1 except/0+ failure?/0 filter/0& filter_map/0& find/0& find_all/0& find_index/0& first/0-1 flat_map/0& flatten/0-1 grep/1& grep_v/1& group_by/0& has_key?/1 has_value?/1 include?/1 inject/1& invert/0 key/1 key?/1 keys/0 length/0 map/0& max/0& max_by/0& member?/1 merge/1 min/0& min_by/0& minmax/0& minmax_by/0& nil?/0 none?/0-1& one?/0-1& partition/0& rassoc/1 reduce/1& reject/0& reverse_each/0& select/0& size/0 slice/0+ slice_after/0-1& slice_before/0-1& slice_when/0& some?/0 sort/0& sort_by/0& sum/0-1& take/1 take_while/0& tally/0 to_a/0 to_h/0& to_s/0 to_set/0& transform_keys/0& transform_values/0& uniq/0 value?/1 values/0 values_at/0+ zip/1]
  in RandomType then %w[class/0 eql?/1 failure?/0 nil?/0 rand/0-1 seed/0 some?/0 to_s/0]
  in RangeType then %w[all?/0-1& any?/0-1& begin/0 bsearch/0& chunk/0& chunk_while/0& clamp/1-2 class/0 collect/0& collect_concat/0& count/0-1& cover?/1& cycle/1& detect/0& drop_while/0& each/0& each_with_index/0& end/0 entries/0& eql?/1 exclude_end?/0 failure?/0 filter/0& filter_map/0& find/0& find_all/0& find_index/0& first/0-1 flat_map/0& grep/1& grep_v/1& group_by/0& include?/1& inject/1& last/0-1 length/0 map/0& max/0& max_by/0& member?/1& min/0& min_by/0& minmax/0& minmax_by/0& nil?/0 none?/0-1& one?/0-1& overlap?/1 partition/0& reduce/1& reject/0& reverse_each/0& select/0& size/0 slice_after/0-1& slice_before/0-1& slice_when/0& some?/0 sort/0& sort_by/0& step/0-1& sum/0-1& take_while/0& to_a/0& to_h/0& to_s/0 to_set/0&]
  in SetType then %w[add/1 all?/0-1& any?/0-1& chunk/0& chunk_while/0& class/0 classify/0& collect/0& collect_concat/0& compact/0 count/0-1& cycle/1& delete/1 detect/0& difference/1 disjoint?/1 drop/1 drop_while/0& each/0& each_cons/1 each_slice/1 each_with_index/0& empty?/0 entries/0 eql?/1 failure?/0 filter/0& filter_map/0& find/0& find_all/0& find_index/0-1& first/0-1 flat_map/0& flatten/0 grep/1& grep_v/1& group_by/0& include?/1 inject/1& intersect?/1 intersection/1 join/0-1 length/0 map/0& max/0& max_by/0& member?/1 min/0& min_by/0& minmax/0& minmax_by/0& nil?/0 none?/0-1& one?/0-1& partition/0& proper_subset?/1 proper_superset?/1 reduce/1& reject/0& reverse_each/0& select/0& size/0 slice_after/0-1& slice_before/0-1& slice_when/0& some?/0 sort/0& sort_by/0& subset?/1 sum/0-1& superset?/1 take/1 take_while/0& tally/0 to_a/0 to_h/0& to_s/0 to_set/0& union/1 uniq/0 zip/1]
  in RationalType then %w[abs/0 abs2/0 angle/0 arg/0 between?/2 ceil/0 clamp/1-2 class/0 conj/0 conjugate/0 denominator/0 div/1 divmod/1 eql?/1 failure?/0 fdiv/1 finite?/0 floor/0 i/0 imag/0 imaginary/0 infinite?/0 integer?/0 magnitude/0 modulo/1 negative?/0 nil?/0 numerator/0 phase/0 polar/0 positive?/0 pow/1 quo/1 rationalize/0-1 real/0 real?/0 rect/0 rectangular/0 remainder/1 round/0 some?/0 to_c/0 to_f/0 to_i/0 to_r/0 to_s/0 truncate/0 zero?/0]
  in ComplexType then %w[abs/0 abs2/0 angle/0 arg/0 class/0 conj/0 conjugate/0 denominator/0 eql?/1 failure?/0 fdiv/1 finite?/0 imag/0 imaginary/0 infinite?/0 integer?/0 magnitude/0 nil?/0 numerator/0 phase/0 polar/0 pow/1 quo/1 rationalize/0-1 real/0 real?/0 rect/0 rectangular/0 some?/0 to_c/0 to_f/0 to_i/0 to_r/0 to_s/0 zero?/0]
  in RegexpType then %w[!~/1 =~/1 casefold?/0 class/0 eql?/1 failure?/0 match/1-2& match?/1-2 named_captures/0 names/0 nil?/0 options/0 some?/0 source/0 to_s/0]
  in MatchDataType then %w[begin/1 captures/0 class/0 end/1 eql?/1 failure?/0 length/0 match/1 match_length/1 named_captures/0 names/0 nil?/0 offset/1 post_match/0 pre_match/0 regexp/0 size/0 some?/0 string/0 to_a/0 to_s/0 values_at/0+]
  else
    nil
  end
end

# Ruby's type functions on the builtin types (ADR 0058): `Array.new`
# answers an array, `Integer.sqrt` an integer; the floor module's members
# (ADR 0068) take the same shape, `System.arguments` an array of strings.
# A struct or local wearing the name wins, as everywhere, so only an
# unbound name is the type's.
def builtin_type_function?(node, types)
  # The receiver as a local, so the `in` test proves it below (#607).
  receiver = node.receiver
  return false unless receiver in IdentifierNode
  return false unless %w[Array Complex Hash Integer JSON Math Random Range Regexp Set System].include?(receiver.name)
  # Unbound, or bound to nothing but itself as a type value (ADR 0074).
  answered = synthesize_name(receiver.name, types)
  answered == UnknownType.new || answered == ClassType.new(name: receiver.name)
end

def call_answer(receiver, node, types)
  return synthesize_block_call(node, receiver, types) if node.block.some?
  name = node.name
  # `value.class` answers the type (ADR 0074); a type's `name` is text.
  return class_answer(receiver) if name == "class" && node.arguments.empty?
  return StringType.new if name == "name" && (receiver in ClassType)
  # On a struct's name: `new` answers an instance, and any other name is a
  # type function the scan registered under `Name.function` (register_struct).
  # On a builtin's name, reached through `value.class`, the type functions'
  # own answers.
  if receiver in ClassType
    type_name = receiver.name
    return type_function_answer_for(type_name, name) if %w[Array Complex Hash Integer JSON Math Random Range Set System].include?(type_name)
    return StructType.new(name: type_name) if name == "new"
    return synthesize_name(type_name + "." + name, types)
  end
  # An updated copy is the same struct.
  return receiver if name == "with" && (receiver in StructType)
  # The signatures below are the builtins'. On anything else — an unknown,
  # a struct, a maybe — only the names every value answers have a type;
  # a struct may define `length` or `lines` to answer whatever it likes,
  # and the method table (#88) caught `node.lines` reading as strings.
  return universal_answer(name) if builtin_methods(receiver).nil?
  case name
  when "length", "size", "count", "index", "find_index", "rindex", "gcd", "lcm", "succ", "pred", "next", "abs", "magnitude", "sum", "to_i", "floor", "ceil", "round", "truncate", "div", "ceildiv"
    synthesize_numeric_answer(receiver, name, arguments_empty: node.arguments.empty?)
  # What `pow` and `fdiv` answer varies with the argument's type (#294).
  when "pow"
    return power_answer(receiver, synthesize(node.arguments.first, types)) if node.arguments.length == 1
    # The modular form, `pow(exponent, modulus)`, is whole numbers only.
    return IntegerType.new if receiver == IntegerType.new && node.arguments.length == 2
    UnknownType.new
  when "fdiv"
    return UnknownType.new unless node.arguments.length == 1
    fdiv_answer(receiver, synthesize(node.arguments.first, types))
  when "to_f", "quo", "next_float", "prev_float" then FloatType.new
  # A symbol made from text is a Symbol of no declared vocabulary (ADR 0071).
  when "to_sym", "intern" then SymbolType.new
  when "to_s", "upcase", "downcase", "capitalize", "swapcase", "reverse", "strip", "lstrip", "rstrip", "chomp", "join", "inspect", "center", "ljust", "rjust", "chop", "chr", "delete_prefix", "delete_suffix", "sub", "gsub", "encoding"
    synthesize_text_answer(receiver, name)
  # A string's number views (#106).
  when "ord", "bytesize", "hex", "oct", "casecmp" then IntegerType.new
  # A match is a maybe (ADR 0086): `=~` and `match` answer the MatchData or
  # nil on a string, a symbol, or a pattern; the predicates answer booleans;
  # a match's and a pattern's readers answer text or arrays of it.
  when "=~", "match"
    return MaybeType.new(inner: MatchDataType.new) if receiver == StringType.new || receiver == SymbolType.new || receiver == RegexpType.new
    UnknownType.new
  when "match?", "!~", "casefold?" then BooleanType.new
  when "source", "pre_match", "post_match" then StringType.new
  when "names" then ArrayType.new(element: StringType.new)
  when "scan", "captures" then ArrayType.new(element: UnknownType.new)
  when "named_captures" then HashType.new(key: StringType.new, value: UnknownType.new)
  when "options" then IntegerType.new
  when "regexp" then RegexpType.new
  when "rindex"
    return MaybeType.new(inner: IntegerType.new) if receiver == StringType.new
    UnknownType.new
  when "partition", "rpartition" then ArrayType.new(element: StringType.new)
  when "codepoints", "bytes" then ArrayType.new(element: IntegerType.new)
  when "casecmp?" then BooleanType.new
  when "empty?", "include?", "member?", "key?", "has_key?", "start_with?", "end_with?", "zero?", "positive?", "negative?", "even?", "odd?", "nil?", "some?", "nan?", "finite?", "infinite?", "between?", "allbits?", "anybits?", "nobits?", "all?", "none?", "one?", "intersect?", "any?", "exclude_end?", "cover?", "overlap?", "valid_encoding?", "subset?", "superset?", "proper_subset?", "proper_superset?", "disjoint?"
    BooleanType.new
  # The tower's conversions (ADR 0085).
  when "to_r", "rationalize" then RationalType.new
  when "to_c", "i" then ComplexType.new
  when "numerator", "denominator" then IntegerType.new
  when "real?", "integer?" then BooleanType.new
  # A set's own answers (ADR 0082): `to_set` on any collection, and the
  # names that answer a new set on one.
  when "to_set" then SetType.new
  when "add", "delete", "union"
    return SetType.new if receiver == SetType.new
    UnknownType.new
  when "chars", "grapheme_clusters", "split", "lines" then ArrayType.new(element: StringType.new)
  when "keys"
    return ArrayType.new(element: receiver.key) if receiver in HashType
    ArrayType.new(element: UnknownType.new)
  when "values"
    return ArrayType.new(element: receiver.value) if receiver in HashType
    ArrayType.new(element: UnknownType.new)
  # A range's ends (#111), each a maybe where the range is open.
  when "begin", "end"
    return MaybeType.new(inner: receiver.element) if receiver in RangeType
    UnknownType.new
  # A hash's own answers (#105).
  when "invert"
    return HashType.new(key: receiver.value, value: receiver.key) if receiver in HashType
    UnknownType.new
  when "has_value?", "value?" then BooleanType.new
  when "key"
    return MaybeType.new(inner: receiver.key) if receiver in HashType
    UnknownType.new
  when "values_at", "except", "to_h"
    return receiver if (receiver in HashType) && name != "values_at"
    UnknownType.new
  when "first", "last", "min", "max"
    # With a count, `first(2)` answers a slice, not a maybe; the survey for
    # ADR 0047 shape 3 found this arm calling one an Integer?.
    return UnknownType.new unless node.arguments.empty?
    return MaybeType.new(inner: receiver.element) if receiver in ArrayType
    return MaybeType.new(inner: receiver.element) if receiver in RangeType
    return MaybeType.new(inner: UnknownType.new) if receiver == SetType.new
    UnknownType.new
  # The arrangements of an array are arrays of its elements (#104).
  when "combination", "repeated_combination", "permutation", "repeated_permutation"
    return ArrayType.new(element: receiver) if receiver in ArrayType
    UnknownType.new
  when "product" then ArrayType.new(element: ArrayType.new(element: UnknownType.new))
  # `flatten` without a depth reaches the innermost elements (#108); with a
  # depth, how deep the array stays nested is the argument's to say.
  when "flatten"
    return flattened_type(receiver) if (receiver in ArrayType) && node.arguments.empty?
    return ArrayType.new(element: UnknownType.new) if receiver in ArrayType
    synthesize_shape_answer(receiver, name)
  when "sort", "uniq", "compact", "slice", "merge", "step", "to_a", "entries", "clamp", "take", "drop", "take_while", "drop_while", "rotate", "difference", "intersection", "cycle"
    synthesize_shape_answer(receiver, name)
  else
    UnknownType.new
  end
end

# A `case` over literals as the `if`s it means (#558): its subject
# compared with each `when`'s values by `==`, the first branch that
# matches taken, the `else` otherwise. Nil for anything else: a node that
# is no `case`, a subject that may not read the same each time, or a
# `when` that names a type, a range, or a regex, which match by `===`.
def case_as_if(node)
  return case_in_as_if(node) if node in CaseInNode
  return nil unless node in CaseNode
  return nil unless steady_subject?(node.subject)
  return nil unless node.branches.all? { |branch| branch.values.all? { compared_literal?(it) } }
  mutable rest = node.else_body
  node.branches.reverse.each do |branch|
    mutable condition = nil
    branch.values.each do |value|
      test = binary_node("==", node.subject, value, line: branch.line)
      condition = condition.nil? ? test : logical_node("||", condition, test, line: branch.line)
    end
    rest = [if_node(condition, branch.body, rest, line: branch.line)]
  end
  (rest or []).first
end

# A `case/in` over structs as the `if`s it means (#572): each arm asks
# whether the subject is its struct, binds the fields it names from the
# subject, and runs its body; the `else` otherwise, and with none, the
# refusal the seed makes. Nil for anything else: a subject that may not
# read the same each time, an arm with a guard, or a pattern that is more
# than a struct's name with fields bound to names.
def case_in_as_if(node)
  return nil unless steady_subject?(node.subject)
  return nil unless node.branches.all? { struct_arm?(it) }
  shown = call_node("inspect", [node.subject], line: node.line)
  message = binary_node("+", binary_node("+", string_node("no pattern matched ", line: node.line), shown, line: node.line), string_node(" — add an in branch or an else", line: node.line), line: node.line)
  mutable rest = (node.else_body or [call_node("panic", [message], line: node.line)])
  node.branches.reverse.each do |branch|
    # Every arm's pattern is a struct's, as `struct_arm?` held; said here,
    # it is read as one (#607).
    pattern = branch.pattern
    if pattern in StructPatternNode
      named = struct_pattern_node(pattern.name, [], line: branch.line)
      test = match_test_node(node.subject, named, line: branch.line)
      mutable bound = []
      pattern.fields.each do |field|
        # Each field is bound to a name, as `struct_arm?` held.
        taken = field.pattern
        if taken in IdentifierNode
          read = method_call_node(node.subject, field.label, [], nil, line: branch.line)
          bound << assignment_node(taken.name, read, line: branch.line)
        end
      end
      rest = [if_node(test, bound + branch.body, rest, line: branch.line)]
    end
  end
  rest.first
end

# A node's direct children — every expression and statement it holds,
# blocks and branches included, patterns excluded — for a walk that looks
# for something anywhere inside a body. Defs, structs, traits, and modules
# are not descended into: their bodies bind their own names.
def children_of(node)
  case node
  in AssignmentNode(value:) then one_if_there(value)
  in AppendNode(value:) then [value]
  in WhileNode(condition:, body:) then [condition] + body
  in IfNode(condition:, then_body:, else_body:) then [condition] + (then_body or []) + (else_body or [])
  in CaseNode(subject:, branches:, else_body:)
    mutable found = [subject]
    branches.each do |branch|
      found += branch.values + branch.body
    end
    found + (else_body or [])
  in CaseInNode(subject:, branches:, else_body:)
    mutable found = [subject]
    branches.each do |branch|
      found << branch.guard unless branch.guard.nil?
      found += branch.body
    end
    found + (else_body or [])
  in TogetherNode(lines:) then lines.map { if it in TaskLineNode then it.value else it end }
  in ReturnNode(value:) then one_if_there(value)
  in CallNode(arguments:, block:) then arguments + block_body(block)
  in MethodCallNode(receiver:, arguments:, block:) then [receiver] + arguments + block_body(block)
  in SafeMethodCallNode(receiver:, arguments:, block:) then [receiver] + arguments + block_body(block)
  in ArrayNode(elements:) then elements
  in HashNode(pairs:) then pairs.map { it.key } + pairs.map { it.value }
  in BinaryNode(left:, right:) then [left, right]
  in LogicalNode(left:, right:) then [left, right]
  in UnaryNode(operand:) then [operand]
  in IndexNode(receiver:, index:) then [receiver, index]
  in IndexUpdateNode(index: update_index, value: update_value) then [update_index, update_value]
  in SlotCompoundNode(index: compound_index, right: compound_right) then [compound_index, compound_right]
  in MatchAssertNode(subject:) then [subject]
  in MatchTestNode(subject: test_subject) then [test_subject]
  in KeywordArgumentNode(value:) then [value]
  in YieldNode(values:) then values
  in OpenedNode(value:) then [value]
  in NarrowedNode(value:) then [value]
  in CaseEqualNode(pattern:, subject:) then [pattern, subject]
  in EnumCaseNode(payload:) then payload.map { it.value }
  else
    []
  end
end

# The four names every value answers, and nothing else, on a receiver
# whose methods are its own to define.
# What `value.class` answers (ADR 0074): the receiver's type as a type
# value, where the receiver's type is known.
def class_answer(receiver)
  return ClassType.new(name: receiver.name) if receiver in StructType
  case receiver
  in StringType    then ClassType.new(name: "String")
  in IntegerType   then ClassType.new(name: "Integer")
  in FloatType     then ClassType.new(name: "Float")
  in BooleanType   then ClassType.new(name: "Boolean")
  in SymbolType    then ClassType.new(name: "Symbol")
  in ArrayType  then ClassType.new(name: "Array")
  in HashType   then ClassType.new(name: "Hash")
  in RangeType  then ClassType.new(name: "Range")
  in RandomType    then ClassType.new(name: "Random")
  in SetType       then ClassType.new(name: "Set")
  in RationalType  then ClassType.new(name: "Rational")
  in ComplexType   then ClassType.new(name: "Complex")
  in RegexpType    then ClassType.new(name: "Regexp")
  in MatchDataType then ClassType.new(name: "MatchData")
  else UnknownType.new
  end
end

# The name one combination of a def goes by under the native reading
# (ADR 0097): the def, the types it is called with, and where it is
# handed a block, what the block answers and whether it can leave. A def
# is compiled once for each, so each has an answer of its own.
def combination_key(name, arguments, handed, leaves)
  types = arguments.map { render_native_type(it) }.join(", ")
  return "#{name}(#{types})" if handed.nil?
  "#{name}(#{types}) { #{render_native_type(handed)}#{leaves ? ", leaving" : ""} }"
end

# A literal a `when` names that `==` compares as `===` does.
def compared_literal?(node) = (node in StringNode) || (node in IntegerNode) || (node in BooleanNode) || (node in NilNode)

# `x == nil` and `x != nil`, either way round.
def comparison_proof(node, types)
  return no_proof unless node.operator == "==" || node.operator == "!="
  name = nil_comparison_name(node.left, node.right)
  return no_proof if name.nil?
  inner = maybe_inner(name, types)
  return no_proof if inner.nil?
  return [bound_one(name, NilType.new), bound_one(name, inner)] if node.operator == "=="
  [bound_one(name, inner), bound_one(name, NilType.new)]
end

# The names every match test anywhere in an expression captures.
def condition_captures(node)
  return [] if node.nil?
  mutable names = []
  names += pattern_names(node.pattern) if node in MatchTestNode
  children_of(node).each do |child|
    names += condition_captures(child)
  end
  names
end

def def_line_for?(line, name)
  stripped = line.strip
  prefix = "def #{name}"
  return false unless stripped.start_with?(prefix)
  return true if stripped == prefix
  boundary = stripped.slice(prefix.length, 1)
  boundary == "(" || boundary == " " || boundary == "="
end

def demand_of(node, name)
  if (node in MethodCallNode) || (node in SafeMethodCallNode)
    return "." + node.name if names?(node.receiver, name)
    return nil
  end
  if node in BinaryNode
    return node.operator if names?(node.left, name) || names?(node.right, name)
    return nil
  end
  return node.operator if (node in UnaryNode) && names?(node.operand, name)
  return "[]" if (node in IndexNode) && names?(node.receiver, name)
  nil
end

def demands_in(nodes, name)
  mutable found = []
  mutable narrowed = false
  nodes.each do |node|
    found = add_demands(node, name, found) unless narrowed
    # Below a guard that leaves unless an `in` test of the name holds, the
    # body asks of a value the test matched (#593).
    narrowed = true if shape_guard?(node, name)
  end
  found
end

# A method asked of a value that is one of several structs, as a call of
# each struct's own method (#572), the value taken as that struct: one
# call for each struct that writes a method of that name which answers
# this shape of call. None where the value is not one of several
# structs, or no struct writes such a method.
def dispatched_calls(node, receiver, types)
  return [] unless opened_natively(receiver, types) == ANY_STRUCT
  listed = method_owners_bound(types, node.name)
  return [] if listed.nil?
  handed = (receiver in MaybeType) ? OpenedNode.new(kind: "opened", value: node.receiver, name: node.name, line: node.line) : node.receiver
  answering = listed.select do |owner|
    shape = method_shape_bound(types, owner, node.name)
    shape.some? && shape_answers?(shape, node)
  end
  answering.map do |owner|
    narrowed = NarrowedNode.new(kind: "narrowed", value: handed, name: owner, line: node.line)
    CallNode.new(kind: "call", name: method_def_name(owner, node.name), arguments: [narrowed] + node.arguments, block: node.block, line: node.line)
  end
end

def element_type(receiver)
  # Read through `or`, what answers is a type (#607).
  return (receiver.element or UnknownType.new) if receiver in ArrayType
  return (receiver.element or UnknownType.new) if receiver in RangeType
  UnknownType.new
end

# Whether a statement is a loop left only from inside: `while true`.
# Whether a type is an empty literal's, which says nothing of what it
# holds (#607): the empty array, or the empty Hash.
def empty_literal?(type) = type == ArrayType.new(element: UnknownType.new) || type == HashType.new(key: UnknownType.new, value: UnknownType.new)

def endless_loop?(node) = (node in WhileNode) && (node.condition in BooleanNode) && node.condition.value == "true"

def entry_name(entry) = entry.split("/").first

# Every node in a file, each before what it holds.
def every_node(nodes)
  nodes.flat_map { [it] + every_node(held_by(it)) }
end

def exit?(node)
  case node
  in ReturnNode | BreakNode | NextNode then true
  in CallNode(name:) then name == "panic"
  else
    false
  end
end

# What `fdiv` answers: a float between reals, and a complex where a
# complex is on either side of a float (#294). An integer or a rational
# divided by a complex refuses when it runs, so it has no type.
def fdiv_answer(receiver, argument)
  return UnknownType.new unless numeric?(receiver) && numeric?(argument)
  return ComplexType.new if receiver == ComplexType.new
  return receiver == FloatType.new ? ComplexType.new : UnknownType.new if argument == ComplexType.new
  FloatType.new
end

# The name a struct's field is bound under, with the one type the
# native build settled for it (#532).
def field_key(owner, field) = "#{owner}.#{field}"

# The type bound to each struct's field of a name, read off the layers
# where they lie (#607), the newest of each kept, and none of the layers
# copied: a field read off one of several structs asks this, and the
# layers beneath hold all of a program's answers.
def field_types(types, ending)
  mutable seen = []
  mutable found = []
  mutable layer = types
  while layer.some?
    layer.near.each do |key, type|
      next unless key.end_with?(ending) && !key.include?("#") && !key.include?("(")
      next if seen.include?(key)
      seen << key
      found << type
    end
    layer = layer.far
  end
  found
end

# What a call hands a def, with each empty array or Hash among it as the
# one the def's other calls hand it in that place (#572, #607): an empty
# literal says nothing of what it holds, and the def it is handed to
# does. One no other call names stays as it is.
def filled_arguments(name, arguments, types)
  return arguments unless arguments.any? { empty_literal?(it) || ((it in KeywordType) && empty_literal?(it.type)) }
  mutable place = 0
  mutable filled = []
  arguments.each do |argument|
    if argument in KeywordType
      known = empty_literal?(argument.type) ? binding_type(types, handed_array_key(name, argument.label)) : nil
      filled << (known.nil? ? argument : KeywordType.new(label: argument.label, type: known))
    else
      known = empty_literal?(argument) ? binding_type(types, handed_array_key(name, place.to_s)) : nil
      filled << (known or argument)
      place += 1
    end
  end
  filled
end

# An array of arrays flattened all the way: an array of the innermost
# element type.
def flattened_type(receiver)
  element = receiver.element
  return flattened_type(element) if element in ArrayType
  ArrayType.new(element: element)
end

# A name already bound, rebound somewhere inside a nested body, is unknown
# from here on. A name new to that body dies with it (ADR 0001) and needs
# nothing.
def forget_types(locals, names)
  # Read as the native build runs it, nothing is forgotten (#556): a
  # local has one type wherever it is bound, so a rebinding in a branch
  # or a loop leaves it the type it had.
  return locals if native_reading?(locals)
  mutable widened = locals
  names.each do |name|
    next if binding_type(locals, name).nil?
    widened = with_bound(widened, name, UnknownType.new)
  end
  widened
end

# What holds below an `if` whose one branch always leaves: the proof for
# the branch that stays. Nothing where both leave, or neither.
def guard_proof(node, types)
  proof = narrowings(node.condition, types)
  then_exits = body_exits?(node.then_body)
  else_exits = body_exits?(node.else_body)
  return when_false(proof) if then_exits && !else_exits
  return when_true(proof) if else_exits && !then_exits
  no_bindings
end

# The name the array a def is handed in one place is bound under (#572):
# the place by its number, or by its name where it is handed by name. No
# def and no local is spelled with a bracket.
def handed_array_key(name, place) = "#{name}[#{place}]"

# Everything a node holds, for a tool that walks a whole file (#30,
# #551): a def's body and a type's methods, which the checker reads one
# at a time, and then whatever an expression holds.
def held_by(node)
  case node
  in DefNode(body:) then body
  in ModuleDefNode(body:) then body
  in StructDefNode(methods:, type_functions:) then methods + type_functions
  in TraitDefNode(methods:) then methods
  else children_of(node).reject { it.nil? }
  end
end

# Whether a type is not known, or holds one that is not, anywhere in it
# (#607): read off what the type is, so a struct of the program's own
# whose name holds the word, `UnknownBox` or the compiler's `UnknownType`,
# is a type like any other.
def holds_unknown?(type)
  case type
  in UnknownType then true
  in ArrayType(element:) then holds_unknown?(element)
  in MaybeType(inner:) then holds_unknown?(inner)
  in HashType(key:, value:) then holds_unknown?(key) || holds_unknown?(value)
  in RangeType(element:) then holds_unknown?(element)
  in KeywordType(type: held) then holds_unknown?(held)
  else false
  end
end

# Each top-level def's parameters, as [name, entry] pairs — an entry is a
# type where a default gives one, or ["needs", demands].
def infer_contracts(nodes)
  types = scan_program(nodes)
  mutable contracts = []
  nodes.each do |node|
    next unless node in DefNode
    entries = node.parameters.map { [it.name, parameter_entry(it, node.body, types)] }
    contracts << [node.name, entries]
  end
  contracts
end

def infer_methods(nodes)
  ordered_pairs(nodes, scan_program(nodes), "def")
end

# The entry points: [name, type] pairs in first-appearance order — the
# program's top-level bindings, and (3b) its top-level defs' return types.
# One scan feeds both. A method's name can share the list with the locals
# because the no-shadow rule already promises a name is never both.
def infer_program(nodes)
  ordered_pairs(nodes, scan_program(nodes), "assignment")
end

# The one type two types make together where a field, a local, or an
# answer is one in one place and the other elsewhere, or nil where they
# make none. The same type is itself; a value and nil, or a maybe of it,
# are a maybe of it (#505, #553); and two structs are one of several
# structs (#572), a maybe of that where either was one.
def joined_pair(first, second)
  return first if first == second
  return maybe_of(second) if first == NilType.new
  return maybe_of(first) if second == NilType.new
  plain_first = (first in MaybeType) ? first.inner : first
  plain_second = (second in MaybeType) ? second.inner : second
  maybe = plain_first != first || plain_second != second
  plain = joined_plain(plain_first, plain_second) or return nil
  maybe ? maybe_of(plain) : plain
end

# The one type two types make together where neither is nil or a maybe,
# or nil where they make none: the same type is itself, two structs are
# one of several structs, and two arrays are an array of what their
# elements make together (#572). An array given no element is the other
# array.
def joined_plain(first, second)
  return first if first == second
  return ANY_STRUCT if (first in StructType) && (second in StructType)
  # A Hash given no pair is the other Hash (#607), and two keyed alike are
  # a Hash of what their values make together, as two arrays are.
  if (first in HashType) && (second in HashType)
    return second if first == HashType.new(key: UnknownType.new, value: UnknownType.new)
    return first if second == HashType.new(key: UnknownType.new, value: UnknownType.new)
    return nil unless first.key == second.key
    value = joined_plain(first.value, second.value) or return nil
    return HashType.new(key: first.key, value: value)
  end
  return nil unless (first in ArrayType) && (second in ArrayType)
  return second if first == ArrayType.new(element: UnknownType.new)
  return first if second == ArrayType.new(element: UnknownType.new)
  element = joined_plain(first.element, second.element) or return nil
  ArrayType.new(element: element)
end

# The one type these make together, each joined to the ones before it
# as `joined_pair` joins two, or nil where they make none.
def joined_types(types)
  mutable joined = types.first
  types.each do |type|
    joined = joined.nil? ? nil : joined_pair(joined, type)
  end
  joined
end

# A value's type and a maybe of it, either way round, as the maybe; a
# maybe and nil as the maybe; anything else unknown.
def joined_with_maybe(first, second)
  return first if first == MaybeType.new(inner: second) || ((first in MaybeType) && second == NilType.new)
  return second if second == MaybeType.new(inner: first) || ((second in MaybeType) && first == NilType.new)
  UnknownType.new
end

# The word a type's kind goes by (#593), as a builtin type's sentences
# name it: `string` for a String, `array` for any array. Its capitalized
# form is the type's name for a value the seed names by its class.
def kind_word(type)
  case type
  in ArrayType then "array"
  in BooleanType then "boolean"
  in ClassType then "type"
  in ComplexType then "complex"
  in ElementType then "element"
  in EnumType then "enum"
  in FloatType then "float"
  in HashType then "hash"
  in IntegerType then "integer"
  in KeywordType then "keyword"
  in MatchDataType then "matchdata"
  in MaybeType then "maybe"
  in ModuleType then "module"
  in NilType then "nil"
  in NothingType then "nothing"
  in RandomType then "random"
  in RangeType then "range"
  in RationalType then "rational"
  in RegexpType then "regexp"
  in SelfType then "self"
  in SetType then "set"
  in StringType then "string"
  in StructType then "struct"
  in SymbolType then "symbol"
  in UnknownType then "unknown"
  else panic("kind_word: #{inspect(type)} is not one of the compiler's types")
  end
end

# One Hash from name to type as bindings of one layer (#607).
def layer_of(names) = Bindings.new(near: names, far: nil)

# A type the library's table writes, as it is for the value asked (#560):
# `element` is what the array asked holds, and `self` the array itself.
def library_type(written, receiver)
  # A Hash's element is its value (#607).
  return receiver.value if written == ElementType.new && (receiver in HashType)
  return receiver.element if written == ElementType.new
  return receiver if written == SelfType.new
  return MaybeType.new(inner: library_type(written.inner, receiver)) if written in MaybeType
  return ArrayType.new(element: library_type(written.element, receiver)) if (written in ArrayType) && written.element == ElementType.new
  written
end

# The name a struct the program makes is bound under (#572), which no
# field, def, or local is spelled as.
def made_key(name) = "#{name}.new&"

# `Math` (ADR 0083): the total functions answer a Float; one that may answer
# a domain failure is unknown, as every fallible builtin is; `frexp` and
# `lgamma` answer a pair.
def math_answer(name)
  return ArrayType.new(element: UnknownType.new) if name == "frexp" || name == "lgamma"
  return UnknownType.new if %w[acos acosh asin atanh gamma log log10 log1p log2 sqrt].include?(name)
  return FloatType.new if %w[atan atan2 cbrt cos cosh erf erfc exp expm1 hypot ldexp sin sinh tan tanh asinh].include?(name)
  UnknownType.new
end

# The plain type under a maybe-typed name, or nil for anything else.
def maybe_inner(name, types)
  found = synthesize_name(name, types)
  return nil unless found in MaybeType
  found.inner
end

def maybe_of(type)
  # No type at all is one not known (#607).
  plain = type or return UnknownType.new
  return plain if (plain in MaybeType) || plain == NilType.new || plain == UnknownType.new
  MaybeType.new(inner: plain)
end

# Agreement answers the type; a lone nil among agreeing others makes a
# maybe (the branch that answers nothing, ADR 0012); anything else is
# unknown.
def merge_candidates(candidates)
  mutable unique = []
  candidates.each do |candidate|
    unique << candidate unless unique.include?(candidate)
  end
  if unique.length <= 1
    only = unique.first or UnknownType.new
    return only
  end
  if unique.length == 2 && unique.include?(NilType.new)
    other = unique.find { it != NilType.new } or UnknownType.new
    return maybe_of(other)
  end
  UnknownType.new
end

# The name a method written for a type goes by as a def (#525): the
# type, and the method.
def method_def_name(owner, name) = "#{owner}##{name}"

# The structs that write a method of this name, as pinning bound them
# (#572), or nil where none does. Read through here, as the bindings'
# types are read through `binding_type` (#607).
def method_owners_bound(types, name) = binding_type(types, any_method_key(name))

# A method's shape as pinning bound it, or nil where the owner writes no
# method of the name (#607).
def method_shape_bound(types, owner, name) = binding_type(types, method_shape_key(owner, name))

# The name a method's shape is bound under: the calls it answers. A
# method answers only the calls it was written for, and anything else is
# the floor's (ADR 0093).
def method_shape_key(owner, name) = "#{owner}##{name}/"

def names?(node, name) = (node in IdentifierNode) && node.name == name

# Bindings with each name a proof narrowed bound to what it proved, where
# it stood (#572).
def narrowed_bindings(bindings, proved)
  # What was proved of a name that may not be there is bound beside the
  # name, under a key of its own, and is new here unless a proof around
  # this one bound it.
  with_bindings(bindings, proved)
end

def narrowings(condition, types)
  proof = proof_of(condition, types)
  # A match test in a condition — `if x in [head, tail]` — binds its
  # captures on both sides, since the runtime binds them regardless.
  captured = bind_unknowns(no_bindings, condition_captures(condition))
  [with_bindings(when_true(proof), captured), with_bindings(when_false(proof), captured)]
end

# The types a call hands a def under the native reading (#536): what it
# hands by place, in order, and then what it hands by name, in the
# names' own order, each as ["keyword", name, type]. Which parameters a
# call hands over is part of the combination it names.
def native_argument_types(arguments, types)
  placed = arguments.reject { it in KeywordArgumentNode }.map { synthesize(it, types) }
  named = arguments.select { it in KeywordArgumentNode }.sort_by { it.label }
  placed + named.map { KeywordType.new(label: it.label, type: synthesize(it.value, types)) }
end

# What a block handed to one of the program's defs answers, under the
# native reading: its parameters bound to what that combination of the
# def yields, and its body read as any body is. A block that ends in
# what produces no value answers nothing; so does one whose answer is
# nil or not known, since nothing can read it then and the block is run
# for what it does. One that answers a value or nil answers that maybe
# (#572): `names.map { it[0] }` is read for what it answers.
def native_block_answer(node, arguments, types)
  yielded = yielded_types(types, yields_key(node.name, arguments))
  mutable inner = types
  mutable index = 0
  node.block.parameters.each do |parameter|
    type = yielded.nil? ? nil : type_at(yielded, index)
    inner = with_bound(inner, parameter, (type or UnknownType.new))
    index += 1
  end
  return NOTHING if native_nothing?(node.block.body, inner)
  found = synthesize_body(node.block.body, inner)
  return NOTHING if found == NilType.new || holds_unknown?(found)
  found
end

# Whether a block can leave the call it is handed to before the call is
# done (#523): by a `break` of its own, by a `return` anywhere inside it,
# or by yielding to a block that can.
def native_block_leaves?(block, types)
  return true if block_breaks?(block.body) || block_returns?(block.body)
  yields?(block.body) && binding_type(types, YIELD_LEAVES).some?
end

# What a call to one of the program's defs answers under the native
# reading: the answer of the combination the call names, or unknown
# where there is none.
def native_call_answer(node, types)
  arguments = filled_arguments(node.name, native_argument_types(node.arguments, types), types)
  handed = node.block.nil? ? nil : native_block_answer(node, arguments, types)
  leaves = node.block.some? && native_block_leaves?(node.block, types)
  binding_type(types, combination_key(node.name, arguments, handed, leaves)) or UnknownType.new
end

# The library's row for a method asked of a value with these arguments
# (#560), or nil where it holds none.
def native_library_entry(receiver, name, arguments)
  NATIVE_LIBRARY.find do |entry|
    asked = entry.receiver
    taken = entry.taking
    fits = asked == receiver || (asked == ArrayType.new(element: ElementType.new) && (receiver in ArrayType)) || ((asked in HashType) && (receiver in HashType) && asked.key == receiver.key && asked.value == ElementType.new)
    fits && entry.name == name && taken.length == arguments.length && taken.map { library_type(it, receiver) } == arguments
  end
end

# A call with a dot as the call of a def it is under the native reading
# (#525), where the core writes a method for the receiver's type that
# answers this call: the def named for the type and the method, handed
# the receiver first. Nil where no such method does.
def native_method_call(node, receiver, types)
  owner = native_owner(opened_natively(receiver, types))
  return nil if owner.nil?
  shape = method_shape_bound(types, owner, node.name)
  return nil if shape.nil? || !shape_answers?(shape, node)
  # A receiver that is a maybe is opened for the method, which is handed
  # the value, and nil refuses by the method's name (#503).
  handed = (receiver in MaybeType) ? OpenedNode.new(kind: "opened", value: node.receiver, name: node.name, line: node.line) : node.receiver
  CallNode.new(kind: "call", name: method_def_name(owner, node.name), arguments: [handed] + node.arguments, block: node.block, line: node.line)
end

# Whether a body ends in what produces no value: `puts`, a loop, an
# `if` whose arms each do and a missing `else` among them, a `yield`
# whose block answers nothing, or a call to a def that does.
def native_nothing?(body, types)
  last = body.last
  return false if last.nil?
  plain = case_as_if(last)
  return native_nothing?(body.slice(0, body.length - 1) + [plain], types) if plain.some?
  return true if last in WhileNode
  if last in IfNode
    other = last.else_body or []
    return native_nothing?((last.then_body or []), types) && (other.empty? || native_nothing?(other, types))
  end
  if last in YieldNode
    return binding_type(types, YIELD) == NOTHING
  end
  return false unless last in CallNode
  return true if last.name == "puts"
  synthesize(last, types) == NOTHING
end

# The name a value's methods are written under: `Array` for an array,
# whose `class` is the core's, and a struct's own name. Nil where the
# native build compiles no methods for the type.
def native_owner(type)
  return "Array" if type in ArrayType
  return "Hash" if type in HashType
  return type.name if type in StructType
  nil
end

# Whether these bindings are the native build's: pinning binds its name
# with the answers, beneath every layer a walk lays over them.
def native_reading?(types) = binding_type(types, NATIVE_READING).some?

def nil_arm?(branch) = (branch.pattern in NilNode) && branch.guard.nil?

def nil_comparison_name(left, right)
  return left.name if (left in IdentifierNode) && (right in NilNode)
  return right.name if (right in IdentifierNode) && (left in NilNode)
  nil
end

# Bindings of no name (#607): where a walk starts, and what a condition
# that proves nothing binds.
def no_bindings = Bindings.new(near: {}, far: nil)

def no_proof = [no_bindings, no_bindings]

# Whether a node holds a `break` that is the block's own around it: not
# one inside a loop, which is the loop's, nor one inside a block handed
# to a call, which is that block's.
def node_breaks?(node)
  return true if node in BreakNode
  return false if node in WhileNode
  handing = (node in CallNode) || (node in MethodCallNode) || (node in SafeMethodCallNode)
  block_breaks?(handing ? children_of(node.with(block: nil)) : children_of(node))
end

# The four floors of the tower (ADR 0085).
def numeric?(type)
  type == IntegerType.new || type == FloatType.new || type == RationalType.new || type == ComplexType.new
end

# A node that may not be there, as the nodes it is: one, or none. A
# parameter declared `mutable` binds no value, and a bare `return`
# answers none.
def one_if_there(node)
  mutable found = []
  found << node unless node.nil?
  found
end

# A maybe as the native build reads it where its value is needed.
def opened_natively(type, types)
  # No type at all is one not known (#607).
  plain = type or return UnknownType.new
  return plain unless (plain in MaybeType) && native_reading?(types)
  plain.inner
end

def ordered_pairs(nodes, types, kind)
  mutable seen = []
  mutable ordered = []
  nodes.each do |node|
    next unless node.kind == kind
    next if seen.include?(node.name)
    seen << node.name
    ordered << [node.name, binding_type(types, node.name)]
  end
  ordered
end

# Whether a body ends in `panic`, and so answers nothing.
def panics?(body)
  return false if body.nil?
  last = body.last
  (last in CallNode) && last.name == "panic"
end

def parameter_entry(parameter, body, types)
  typed = parameter_type(parameter, types)
  return typed unless typed == UnknownType.new
  ["needs", demands_in(body, parameter.name)]
end

def parameter_type(parameter, types)
  if (parameter in AssignmentNode) && parameter.value.some?
    return synthesize(parameter.value, types)
  end
  if (parameter in KeywordParameterNode) && parameter.default.some?
    return synthesize(parameter.default, types)
  end
  UnknownType.new
end

# The names a pattern captures. Every capture is a plain identifier, a
# pin reads rather than binds, and the shapes hold sub-patterns.
def pattern_names(pattern)
  case pattern
  # A `_`-prefixed name binds nothing (ADR 0080).
  in IdentifierNode(name:) then if name.start_with?("_") then [] else [name] end
  in BindingPatternNode(pattern: inner, name:) then pattern_names(inner) + [name]
  in HashPatternNode(pairs:, rest_kind:, rest_name:)
    mutable found = []
    pairs.each do |pair|
      found += pattern_names(pair.pattern)
    end
    found << rest_name if rest_kind == "bind"
    found
  in AlternativePatternNode(options:)
    mutable found = []
    options.each do |option|
      found += pattern_names(option)
    end
    found
  in ArrayPatternNode(elements:, rest_name:)
    mutable found = []
    elements.each do |element|
      found += pattern_names(element)
    end
    found << rest_name unless rest_name.nil?
    found
  in StructPatternNode(fields:)
    mutable found = []
    fields.each do |field|
      found += pattern_names(field.pattern)
    end
    found
  in EnumCasePatternNode(payload:)
    mutable found = []
    payload.each do |entry|
      found += pattern_names(entry.pattern)
    end
    found
  else
    []
  end
end

# Ruby's contagion for two numbers: anything with a complex is a complex, a
# float wins over a rational, a rational over an integer.
# What a base raised to an exponent answers, for `**` and `pow` alike
# (#294). Integer bases with integer exponents stay integers (ADR 0033,
# edges refuse at runtime), a complex on either side answers a complex,
# and a float or a rational raised to a whole number keeps its kind. Every
# other pair depends on the values — a negative base to a fractional
# power is a complex, a root may be a float — so it answers unknown.
def power_answer(base, exponent)
  return UnknownType.new unless numeric?(base) && numeric?(exponent)
  return ComplexType.new if base == ComplexType.new || exponent == ComplexType.new
  return base if exponent == IntegerType.new
  UnknownType.new
end

# `x.some?` and `x.nil?` on a maybe-typed name.
def predicate_proof(node, types)
  return no_proof unless node.arguments.empty? && node.block.nil?
  return no_proof unless node.receiver in IdentifierNode
  name = node.receiver.name
  inner = maybe_inner(name, types)
  return no_proof if inner.nil?
  return [bound_one(name, inner), bound_one(name, NilType.new)] if node.name == "some?"
  return [bound_one(name, NilType.new), bound_one(name, inner)] if node.name == "nil?"
  no_proof
end

def proof_of(condition, types)
  case condition
  in MethodCallNode then predicate_proof(condition, types)
  in MatchTestNode then shape_proof(condition, types)
  in BinaryNode then comparison_proof(condition, types)
  in UnaryNode(operator:, operand:)
    return no_proof unless operator == "!"
    proof = proof_of(operand, types)
    [when_false(proof), when_true(proof)]
  in LogicalNode(operator:, left:, right:)
    left_proof = proof_of(left, types)
    right_proof = proof_of(right, types)
    return [with_bindings(when_true(right_proof), when_true(left_proof)), no_bindings] if operator == "&&"
    return [no_bindings, with_bindings(when_false(right_proof), when_false(left_proof))] if operator == "||"
    no_proof
  else
    no_proof
  end
end

# The key what was proved of a name that may not be there is bound under
# (#572), beside the name. No local is spelled with a space.
def proved_key(name) = "#{name} is"

# Whether a binding's key is a proof bound beside a name.
def proved_key?(key) = key.end_with?(" is")

# Whether a condition proves a name is of a struct where it holds (#593):
# `name in Box`, or an `&&` with such a test on either side.
def proves_shape?(condition, name)
  return true if (condition in MatchTestNode) && names?(condition.subject, name) && (condition.pattern in StructPatternNode)
  return proves_shape?(condition.left, name) || proves_shape?(condition.right, name) if (condition in LogicalNode) && condition.operator == "&&"
  false
end

# The three that order: a complex has no `<`.
def real_numeric?(type) = numeric?(type) && type != ComplexType.new

# A struct declaration binds its name to its type — what `new` is called
# on — and each type function (`def self.unit`, ADR 0031) under the dotted
# name `Order.unit`, which no identifier can spell, so the one list holds
# both. The checker's program-wide scan registers structs the same way.
def register_struct(node, mutable types)
  types = with_bound(types, node.name, ClassType.new(name: node.name))
  node.type_functions.each do |function|
    next unless function in DefNode
    types = with_bound(types, node.name + "." + function.name, synthesize_def_return(function, types))
  end
  types
end

# These layers laid over other bindings (#607): each layer kept as it is,
# and the last of them, which lay over nothing, now over those.
def relayered(layers, beneath)
  further = layers.far
  return layers.with(far: beneath) if further.nil?
  layers.with(far: relayered(further, beneath))
end

# A type as a combination's name writes it.
def render_native_type(type)
  return "nothing" if type == NOTHING
  # What a call hands a def by name (#536): the name, and the type.
  return "#{type.label}: #{render_native_type(type.type)}" if type in KeywordType
  render_type(type)
end

# How a type is written back out, for the debug driver. This rendering is
# NOT ratified surface — the error-voice decision owns the real spelling —
# it is the plainest thing that could work in a dump.
def render_type(type)
  case type
  in ArrayType(element:) then "[" + render_type(element) + "]"
  in HashType(key:, value: entry) then "{" + render_type(key) + " => " + render_type(entry) + "}"
  in MaybeType(inner:) then render_type(inner) + "?"
  # One of several structs is `*` (#572). Said in the arm, not in its
  # pattern, every arm here is a struct's with its fields bound to names,
  # so the native build passes over an arm for a struct a program never
  # makes, whose fields it has no type for (#607).
  in StructType(name:) then name == "*" ? "Struct" : name
  in ClassType(name:) then name
  in EnumType(name:) then name
  in ModuleType(name:) then name
  # Ruby's own capitals (ADR 0086).
  in MatchDataType then "MatchData"
  in BooleanType then "Boolean"
  in ComplexType then "Complex"
  in ElementType then "Element"
  in FloatType then "Float"
  in IntegerType then "Integer"
  in NilType then "Nil"
  in NothingType then "Nothing"
  in RandomType then "Random"
  in RationalType then "Rational"
  in RegexpType then "Regexp"
  in SelfType then "Self"
  in SetType then "Set"
  in StringType then "String"
  in SymbolType then "Symbol"
  in UnknownType then "Unknown"
  else
    label = kind_word(type)
    label.slice(0, 1).upcase + label.slice(1, label.length - 1)
  end
end

def return_answer(statement, types)
  return NilType.new if statement.value.nil?
  synthesize(statement.value, types)
end

# Every `return`'s type inside a statement, walking the branching forms.
def return_types_in(node, types)
  case node
  in ReturnNode then [return_answer(node, types)]
  in IfNode
    settled = native_reading?(types) ? settled_arm(node, types) : nil
    return returns_in_body(settled, types) if settled.some?
    proof = narrowings(node.condition, types)
    mutable found = []
    found += returns_in_body(node.then_body, with_bindings(types, when_true(proof)))
    found += returns_in_body(node.else_body, with_bindings(types, when_false(proof)))
    found
  # A loop body may have run before any statement in it is read again, so
  # it is walked with its own rebindings already forgotten.
  in WhileNode then returns_in_body(node.body, forget_types(types, assigned_names_in_body(node.body)))
  in CaseNode
    mutable found = []
    node.branches.each do |branch|
      found += returns_in_body(branch.body, types)
    end
    found += returns_in_body(node.else_body, types)
    found
  in CaseInNode
    mutable found = []
    mutable nil_seen = false
    node.branches.each do |branch|
      found += returns_in_body(branch.body, with_bindings(types, arm_bindings(node, branch, nil_seen, types)))
      nil_seen = true if nil_arm?(branch)
    end
    found += returns_in_body(node.else_body, types)
    found
  else
    []
  end
end

def returns_in_body(body, mutable types)
  return [] if body.nil?
  mutable found = []
  body.each do |statement|
    found += return_types_in(statement, types)
    types = bind_after(statement, types, no_bindings)
  end
  found
end

# Whether a `return` with a value is written anywhere in these
# statements, a block's body among them.
def returns_value?(nodes)
  nodes.reject { it.nil? }.any? { |node| ((node in ReturnNode) && node.value.some?) || returns_value?(children_of(node)) }
end

# `value&.name` as the `if` it means (#572): nil where the value is not
# there, and the method asked of it where it is. Nil for anything else: a
# node that is no safe call, one handed a block, or a receiver that may
# not read the same each time.
def safe_as_if(node)
  return nil unless (node in SafeMethodCallNode) && node.block.nil? && steady_subject?(node.receiver)
  absent = method_call_node(node.receiver, "nil?", [], nil, line: node.line)
  asked = method_call_node(node.receiver, node.name, node.arguments, nil, line: node.line)
  if_node(absent, [nil_node(line: node.line)], [asked], line: node.line)
end

def scan_program(nodes)
  mutable types = no_bindings
  nodes.each do |node|
    if node in DefNode
      types = with_bound(types, node.name, synthesize_def_return(node, types))
    elsif node in StructDefNode
      types = register_struct(node, types)
    elsif node in EnumDefNode
      # Recorded so a later increment can hang membership and
      # exhaustiveness off the name; nothing reads it yet.
      types = with_bound(types, node.name, EnumType.new(name: node.name))
    else
      types = bind_after(node, types, no_bindings)
    end
  end
  types
end

# The arm of an `if` that runs whichever way the program goes, as the
# native build reads it (#572), or nil where either may: an `in` test of
# a name that holds one struct and no other is settled as written. A def
# compiled for one struct keeps the `case/in` arms written for the
# others, which read fields that struct has none of, and they are passed
# over.
def settled_arm(node, types)
  test = node.condition
  return nil unless test in MatchTestNode
  # The subject and the pattern as locals, so what an `in` test proves of
  # each holds below it (#607).
  subject = test.subject
  pattern = test.pattern
  return nil unless (subject in IdentifierNode) && (pattern in StructPatternNode) && pattern.fields.empty?
  held = synthesize_name(subject.name, types)
  # Only of a struct the program declares: a builtin type's name is bound
  # nowhere, and its tests are the build's to settle elsewhere.
  return nil unless binding_type(types, pattern.name) == ClassType.new(name: pattern.name)
  # A struct the program never makes is one no value is.
  return (node.else_body or []) if binding_type(types, made_key(pattern.name)).nil?
  return nil unless (held in StructType) && held != ANY_STRUCT
  held.name == pattern.name ? (node.then_body or []) : (node.else_body or [])
end

# Whether a body ends in `panic` as the native build runs it (#607): by
# its own last statement, or by an `if` there that settles to an arm that
# does. A `case` whose last arms test for structs a program never makes
# reads as such an `if`, settled to its `else`.
def settled_panics?(body, types)
  return true if panics?(body)
  return false if body.nil? || body.empty?
  last = body.last
  return false unless last in IfNode
  settled = settled_arm(last, types)
  settled.some? && settled_panics?(settled, types)
end

# Whether a method answers a call (ADR 0093, #536), by its shape: [the
# fewest it takes by place, the most, whether it yields, the names it
# takes]. The count by place fits, a block is handed exactly when the
# method yields, and every name handed is one it takes.
def shape_answers?(shape, node)
  placed = node.arguments.reject { it in KeywordArgumentNode }.length
  named = node.arguments.select { it in KeywordArgumentNode }.map { it.label }
  return false unless placed >= type_at(shape, 0) && placed <= type_at(shape, 1)
  return false unless node.block.some? == type_at(shape, 2)
  named.all? { type_at(shape, 3).include?(it) }
end

# What stays proved below an `if` whose one branch always leaves (#572).
def shape_guard(node, types)
  proof = shape_narrowings(node.condition, types)
  then_exits = body_exits?(node.then_body)
  else_exits = body_exits?(node.else_body)
  return when_false(proof) if then_exits && !else_exits
  return when_true(proof) if else_exits && !then_exits
  no_bindings
end

# Whether a statement is a guard that leaves unless an `in` test of the
# name holds (#593): `return 0 unless name in Box`, which the parser
# writes as an `if` with nothing where the test holds and a way out where
# it does not.
def shape_guard?(node, name)
  return false unless (node in IfNode) && proves_shape?(node.condition, name)
  (node.then_body or []).empty? && body_exits?(node.else_body)
end

# What a condition proves of the names that hold one of several structs
# (#572), as what holds where it is true and where it is false. The
# native build's walks bind a name to what was proved for as long as the
# proof stands; a maybe they leave as it is, since it is opened when the
# line runs.
def shape_narrowings(condition, types)
  proof = proof_of(condition, types)
  [when_true(proof), when_false(proof)].map do |proved|
    layer_of(bindings_hash(proved).select { |name, type| proved_key?(name) || synthesize_name(name, types) == ANY_STRUCT })
  end
end

# `name in Struct`, asked of a name that holds one of several structs
# (#572): where it holds, the name is that struct. Where it does not, the
# name is still any of the others.
#
# A name that may not be there, and is a struct where it is, is proved
# the same way under the native reading: where the test holds the value
# is there and is that struct. It is held as a maybe all the same, so the
# proof is bound beside the name and not in its place, and a read of the
# name opens it.
def shape_proof(node, types)
  # The subject and the pattern as locals, so what an `in` test proves of
  # each holds below it (#607).
  subject = node.subject
  pattern = node.pattern
  return no_proof unless (subject in IdentifierNode) && (pattern in StructPatternNode) && pattern.fields.empty?
  held = synthesize_name(subject.name, types)
  return no_proof unless synthesize_name(pattern.name, types) == ClassType.new(name: pattern.name)
  return [bound_one(subject.name, StructType.new(name: pattern.name)), no_bindings] if held == ANY_STRUCT
  return no_proof unless native_reading?(types) && (held in MaybeType) && (held.inner in StructType)
  [bound_one(proved_key(subject.name), StructType.new(name: pattern.name)), no_bindings]
end

# The type a field of this name has, read off a value that is one of
# several structs (#572): the one type every struct that is made with
# such a field holds there, or nil where there is no such field or they
# hold types that do not join.
def shared_field(name, types)
  ending = ".#{name}"
  held = field_types(types, ending)
  return nil if held.empty?
  mutable joined = held.first
  held.each do |type|
    joined = joined.nil? ? nil : joined_pair(joined, type)
  end
  joined
end

def signature_continues?(line)
  stripped = line.strip
  stripped.end_with?(",") || stripped.end_with?("(")
end

def signature_end_line(lines, mutable index)
  while index + 1 < lines.length && signature_continues?(lines[index])
    index += 1
  end
  line = lines[index] or ""
  line
end

def statement_answer(statement, types)
  return synthesize(statement.value, types) if statement in AssignmentNode
  return return_answer(statement, types) if statement in ReturnNode
  synthesize(statement, types)
end

# Whether an expression reads the same each time it is read, and costs
# little to read again (#558): a name, `self`, a method with no
# arguments asked of one, as a field is, an element of one read by a
# number or a name, or two of these added or subtracted.
def steady_subject?(node)
  return true if (node in IdentifierNode) || (node in SelfNode) || (node in IntegerNode)
  return steady_subject?(node.left) && steady_subject?(node.right) if (node in BinaryNode) && %w[+ -].include?(node.operator)
  return steady_subject?(node.receiver) && steady_subject?(node.index) if node in IndexNode
  (node in MethodCallNode) && node.arguments.empty? && node.block.nil? && steady_subject?(node.receiver)
end

# Whether a `case/in` arm is one the native build reads as an `if`
# (#572): no guard, and a struct's name with each field bound to a name.
def struct_arm?(branch)
  # The pattern as a local, so the `in` test proves it below (#607).
  pattern = branch.pattern
  return false unless branch.guard.nil? && (pattern in StructPatternNode)
  pattern.fields.all? { it.pattern in IdentifierNode }
end

# Read a type off an expression. Synthesis mode only (ADR 0040's ladder —
# checking mode is 3b): every arm answers what it can prove from the node
# alone plus the bindings already typed. What answers is always a type,
# read through `or` (#607): the types made from it, and everything read
# off them, are types too, where a type that may not be there spread
# through every one of them.
def synthesize(node, types) = (synthesize_node(node, types) or UnknownType.new)

# `name << value` (3b): the append that first fills an empty literal names
# its element type — `mutable box = []` then `box << 3` reads as
# [Integer]. Strings stay strings; a disagreeing element widens back to
# unknown elements.
def synthesize_append(node, types)
  current = synthesize_name(node.name, types)
  return StringType.new if current == StringType.new
  # Read as the native build runs it, a maybe of a String is opened to be
  # appended to (#557).
  return StringType.new if current == MaybeType.new(inner: StringType.new) && native_reading?(types)
  # Read as the native build runs it, a maybe appended is opened first
  # (#566).
  value = opened_natively(synthesize(node.value, types), types)
  return ArrayType.new(element: value) if current == ArrayType.new(element: UnknownType.new)
  return current if (current in ArrayType) && current.element == value
  # Read as the native build runs it, one struct appended to an array of
  # another makes it an array of one of several structs (#572).
  if (current in ArrayType) && native_reading?(types)
    element = joined_plain(current.element, value)
    return ArrayType.new(element: element) if element.some?
  end
  return ArrayType.new(element: UnknownType.new) if current in ArrayType
  UnknownType.new
end

def synthesize_array(node, types)
  return ArrayType.new(element: UnknownType.new) if node.elements.empty?
  # Read as the native build runs it, a maybe written into an array is
  # opened first, as one appended is (#566).
  first = opened_natively(synthesize(node.elements.first, types), types)
  mutable uniform = true
  node.elements.each do |element|
    uniform = false unless opened_natively(synthesize(element, types), types) == first
  end
  return ArrayType.new(element: first) if uniform
  # Read as the native build runs it, a literal of more than one struct
  # is an array of one of several structs (#572).
  if native_reading?(types)
    mutable joined = first
    node.elements.each do |element|
      joined = joined.nil? ? nil : joined_plain(joined, opened_natively(synthesize(element, types), types))
    end
    return ArrayType.new(element: joined) if joined.some?
  end
  ArrayType.new(element: UnknownType.new)
end

def synthesize_bare_call(node, types)
  return StringType.new if (node.name == "format" || node.name == "sprintf") && synthesize_name(node.name, types) == UnknownType.new
  # `inspect(value)` answers a value's source form, a String (#501).
  return StringType.new if node.name == "inspect" && node.arguments.length == 1 && synthesize_name(node.name, types) == UnknownType.new
  # The tower's constructors (ADR 0085) answer their values, not the type
  # a bare `Rational` names.
  return RationalType.new if node.name == "Rational" && synthesize_name(node.name, types) == ClassType.new(name: "Rational")
  return ComplexType.new if node.name == "Complex" && synthesize_name(node.name, types) == ClassType.new(name: "Complex")
  found = synthesize_name(node.name, types)
  # A call that answers nothing known may be to one of the program's defs
  # under the native reading, where a def is kept by the types it is
  # called with and not by its name.
  return found unless found == UnknownType.new && native_reading?(types)
  native_call_answer(node, types)
end

# The arithmetic and comparison operators, ADR 0018's shapes: whole numbers
# stay whole, one float anywhere makes a float, comparisons answer booleans.
def synthesize_binary(node, types)
  left = opened_natively(synthesize(node.left, types), types)
  right = opened_natively(synthesize(node.right, types), types)
  case node.operator
  when "==", "!=", "<", "<=", ">", ">=" then BooleanType.new
  # `<=>` (ADR 0054) answers -1, 0, or 1 on what it orders; a struct's own
  # `<=>` is a call, and unknown here.
  when "<=>"
    return IntegerType.new if numeric?(left) && numeric?(right)
    return IntegerType.new if left == StringType.new && right == StringType.new
    return IntegerType.new if left == SymbolType.new && right == SymbolType.new
    return IntegerType.new if (left in ArrayType) && (right in ArrayType)
    UnknownType.new
  when "+", "-", "*", "%"
    return tower_answer(left, right) if numeric?(left) && numeric?(right)
    return StringType.new if left == StringType.new && right == StringType.new
    # Read as the native build runs it, two arrays joined are an array of
    # what theirs make together, and an empty one is the other (#572).
    if native_reading?(types) && node.operator == "+" && (left in ArrayType) && (right in ArrayType)
      return (joined_plain(left, right) or left)
    end
    # And an array joined with what is not known is read as that array,
    # so a def that joins an array with what it answers itself has a way
    # out to be read from. The other side is held to it once it is known.
    if native_reading?(types) && node.operator == "+"
      return left if (left in ArrayType) && left != ArrayType.new(element: UnknownType.new) && right == UnknownType.new
      return right if (right in ArrayType) && right != ArrayType.new(element: UnknownType.new) && left == UnknownType.new
    end
    return left if (left in ArrayType) && (right in ArrayType)
    # A set's union and difference answer a set (ADR 0082).
    return SetType.new if left == SetType.new && (node.operator == "+" || node.operator == "-")
    UnknownType.new
  when "/"
    return IntegerType.new if left == IntegerType.new && right == IntegerType.new
    return tower_answer(left, right) if numeric?(left) && numeric?(right)
    UnknownType.new
  when "**"
    power_answer(left, right)
  else
    UnknownType.new
  end
end

# Block calls (3b): the parameters' types are read off the receiver — an
# array lends its element, a hash its key then value, a range integers —
# the body is synthesized with them bound, and the shape methods answer
# accordingly. Unlisted names answer unknown, never an error.
def synthesize_block_call(node, receiver, types)
  # A block method's answer is a builtin's; on any other receiver it is
  # whatever that receiver's own method says, which is unknown here.
  return UnknownType.new if builtin_methods(receiver).nil?
  mutable inner = types
  argument_types = node.arguments.map { synthesize(it, types) }
  node.block.parameters.each_with_index do |parameter, index|
    inner = with_bound(inner, parameter, block_parameter_type(receiver, index, node.name, argument_types))
  end
  # A block body may run many times or never — like a loop's, it is read
  # with the names it rebinds already forgotten.
  body = synthesize_body(node.block.body, forget_types(inner, assigned_names_in_body(node.block.body)))
  case node.name
  when "map", "collect" then ArrayType.new(element: body)
  when "find", "detect", "rfind", "min_by", "max_by"
    return MaybeType.new(inner: element_type(receiver)) if receiver in ArrayType
    UnknownType.new
  # A summed block answers whatever its block does (#104).
  when "sum" then UnknownType.new
  when "count", "index", "find_index", "rindex" then synthesize_numeric_answer(receiver, node.name)
  # Binary search answers a maybe of the element, or of its position (#104).
  when "bsearch"
    return MaybeType.new(inner: element_type(receiver)) if (receiver in ArrayType) || (receiver in RangeType)
    UnknownType.new
  when "bsearch_index" then MaybeType.new(inner: IntegerType.new)
  # The arrangements handed to a block answer the array; cycle answers nil.
  when "combination", "repeated_combination", "permutation", "repeated_permutation", "product"
    return receiver if receiver in ArrayType
    UnknownType.new
  when "cycle" then NilType.new
  when "all?", "any?", "none?", "one?" then BooleanType.new
  when "select", "filter", "reject", "each", "each_with_index", "reverse_each"
    return receiver if (receiver in ArrayType) || (receiver in HashType) || receiver == SetType.new
    UnknownType.new
  # A set's groups (ADR 0082): the block's answers to sets of its members.
  when "classify"
    return HashType.new(key: body, value: SetType.new) if receiver == SetType.new
    UnknownType.new
  when "to_set" then SetType.new
  # A hash's own walks (#105): the key side or the value side rewritten
  # by the block, or walked and the hash answered.
  when "transform_values"
    return HashType.new(key: receiver.key, value: body) if receiver in HashType
    UnknownType.new
  when "transform_keys"
    return HashType.new(key: body, value: receiver.value) if receiver in HashType
    UnknownType.new
  when "each_key", "each_value"
    return receiver if receiver in HashType
    UnknownType.new
  # A string's walks answer the string, and `sub` and `gsub` with a block
  # a new one (#106).
  when "each_char", "each_grapheme_cluster", "each_byte", "each_codepoint", "each_line", "sub", "gsub"
    return receiver if receiver == StringType.new
    UnknownType.new
  # A hash's sort_by, take_while, and drop_while answer its pairs as an
  # array, as Ruby's do (#105), so only an array keeps its own type here.
  when "sort_by", "take_while", "drop_while", "each_index"
    return receiver if receiver in ArrayType
    UnknownType.new
  # Ruby's runs and groups (#110): the runs are arrays of the receiver,
  # the groups a hash from the block's answers to them, and filter_map
  # keeps the block's answers less nil and false.
  when "chunk_while", "slice_when", "slice_before", "slice_after"
    return ArrayType.new(element: receiver) if receiver in ArrayType
    UnknownType.new
  when "group_by"
    return HashType.new(key: body, value: receiver) if receiver in ArrayType
    UnknownType.new
  when "filter_map" then ArrayType.new(element: UnknownType.new)
  else
    UnknownType.new
  end
end

# A statement body's answer: each statement is read with the bindings the
# ones above it left (bind_after), early returns join the last statement
# as candidates, and merge_candidates rules.
def synthesize_body(body, mutable types)
  mutable early = []
  mutable last = NilType.new
  body.each do |statement|
    early += return_types_in(statement, types)
    last = statement_answer(statement, types)
    types = bind_after(statement, types, no_bindings)
  end
  merge_candidates(early + [last])
end

# Builtin results, by receiver type and name — the signatures the evaluator
# already lives by, read back as types. Partial lookups answer maybes
# (ADR 0040 §3). Unlisted names answer unknown, never an error.
def synthesize_call(node, types)
  # `System.read_file` answers the text or a failure. The checker leaves
  # a fallible builtin unknown; the native build compiles it where an
  # `or` takes the failure's place, and reads it there as text or
  # nothing (#534).
  if node.name == "read_file" && (node.receiver in IdentifierNode) && node.receiver.name == "System" && native_reading?(types)
    return MaybeType.new(inner: StringType.new)
  end
  # `System.core_source` answers a core file's text, which the binary
  # carries, so it is always there (#591).
  if node.name == "core_source" && (node.receiver in IdentifierNode) && node.receiver.name == "System" && native_reading?(types)
    return StringType.new
  end
  return type_function_answer(node) if builtin_type_function?(node, types)
  receiver = synthesize(node.receiver, types)
  # A method the core writes for the receiver's type is a def of its own
  # under the native reading (#525), and answers as a call of it does.
  if native_reading?(types)
    called = native_method_call(node, receiver, types)
    return native_call_answer(called, types) if called.some?
    # Asked of one of several structs, a method is each struct's own
    # (#572), and answers what those make together. One whose answer is
    # not known is read past, as a def that calls itself is.
    several = dispatched_calls(node, receiver, types)
    unless several.empty?
      known = several.map { native_call_answer(it, types) }.select { it != UnknownType.new }
      return (joined_types(known) or UnknownType.new)
    end
    # A struct's field is read by its name, at the one type pinning
    # settled for it (#532).
    holder = opened_natively(receiver, types)
    if (holder in StructType) && node.arguments.empty? && node.block.nil?
      # Asked of one of several structs, a field is read where every
      # struct that has it holds one type there (#572).
      shared = holder == ANY_STRUCT ? shared_field(node.name, types) : nil
      read = (shared or binding_type(types, field_key(holder.name, node.name)))
      # Read through `or`, what answers is a type (#607).
      return (read or UnknownType.new) if read.some?
    end
    # A method the library holds answers what its row says (#560).
    if node.block.nil?
      handed = node.arguments.map { opened_natively(synthesize(it, types), types) }
      # A merge of two Hashes is what they make together (#607): the other
      # where either is empty, and a Hash of one of several structs where
      # each holds a struct of its own.
      if node.name == "merge" && (holder in HashType) && handed.length == 1 && (handed[0] in HashType)
        return (joined_plain(holder, handed[0]) or UnknownType.new)
      end
      library = native_library_entry(holder, node.name, handed)
      return library_type(library.answer, holder) if library.some?
    end
  end
  # `nil?` and `some?` are asked of the maybe itself; every other method
  # is asked of its value.
  asked = %w[nil? some?].include?(node.name) ? receiver : opened_natively(receiver, types)
  call_answer(asked, node, types)
end

# A `case` read as the native build runs it (#558), where it is one over
# literals. The checker reads no type off a `case`.
def synthesize_case(node, types)
  plain = native_reading?(types) ? case_as_if(node) : nil
  plain.nil? ? UnknownType.new : synthesize(plain, types)
end

# A `case/in` in value position: the arms' answers must agree, each arm
# read with its captures bound (arm_bindings). An absent else answers nil
# (ADR 0012) — unless an unguarded bare capture makes the arms total.
def synthesize_case_in(node, types)
  # Read as the native build runs it, one over structs is the `if`s it
  # means (#572).
  plain = native_reading?(types) ? case_as_if(node) : nil
  return synthesize(plain, types) if plain.some?
  mutable answers = []
  mutable nil_seen = false
  node.branches.each do |branch|
    answers << synthesize_body(branch.body, with_bindings(types, arm_bindings(node, branch, nil_seen, types)))
    nil_seen = true if nil_arm?(branch)
  end
  total = node.branches.any? { (it.pattern in IdentifierNode) && it.guard.nil? }
  answers << branch_answer(node.else_body, types) unless node.else_body.nil? && total
  merge_candidates(answers)
end

# A def's return type (3b): parameters enter as unknown — the hybrid
# caller-flow half of ADR 0040 is a later increment — except that a
# default lends its type. The body reads in order; early returns and the
# last statement must agree, a lone nil among them makes a maybe, and any
# other disagreement is an opinion withheld.
def synthesize_def_return(node, mutable types)
  node.parameters.each do |parameter|
    types = with_bound(types, parameter.name, parameter_type(parameter, types))
  end
  synthesize_body(node.body, types)
end

def synthesize_hash(node, types)
  return HashType.new(key: UnknownType.new, value: UnknownType.new) if node.pairs.empty?
  first = node.pairs.first
  # Read as the native build runs it, a maybe written into a Hash is
  # opened first, as one written into an array is (#607).
  key = opened_natively(synthesize(first.key, types), types)
  entry = opened_natively(synthesize(first.value, types), types)
  mutable uniform = true
  node.pairs.each do |pair|
    uniform = false unless opened_natively(synthesize(pair.key, types), types) == key
    uniform = false unless opened_natively(synthesize(pair.value, types), types) == entry
  end
  return HashType.new(key: key, value: entry) if uniform
  HashType.new(key: UnknownType.new, value: UnknownType.new)
end

def synthesize_identifier(node, types)
  # A bound name's type, read through `or` so that what answers is a type
  # and never one that may not be there (#607).
  found = binding_type(types, node.name) or return synthesize_unbound(node, types)
  # A name that may not be there, proved to be a struct, is that struct
  # (#572): the proof is bound beside it.
  return (binding_type(types, proved_key(node.name)) or found) if found in MaybeType(inner: StructType)
  found
end

# An if in value position (the ternary desugars here too, ADR 0046):
# agreeing branches answer their type, an absent or nil branch makes a
# maybe of the other. Each branch is read under what the condition proved
# on its side (narrowings).
def synthesize_if(node, types)
  settled = native_reading?(types) ? settled_arm(node, types) : nil
  return branch_answer(settled, types) if settled.some?
  proof = narrowings(node.condition, types)
  yes = branch_answer(node.then_body, with_bindings(types, when_true(proof)))
  no = branch_answer(node.else_body, with_bindings(types, when_false(proof)))
  # Read as the native build runs it, an arm that ends in `panic`
  # answers nothing, so the `if` answers what the other arm does (#572).
  if native_reading?(types)
    return no if settled_panics?(node.then_body, types)
    return yes if settled_panics?(node.else_body, types)
  end
  merged = merge_candidates([yes, no])
  # Read as the native build runs it, a value on one side and a maybe of
  # it on the other are a maybe of it (#558), as an `elsif` chain that
  # ends in nil is, and one struct and another are one of several (#572).
  return merged unless merged == UnknownType.new && native_reading?(types)
  (joined_pair(yes, no) or UnknownType.new)
end

# `array[index]` under the native reading: the element, or nil past
# either end.
def synthesize_index(node, types)
  return UnknownType.new unless native_reading?(types)
  receiver = synthesize(node.receiver, types)
  # A run read by a range is the collection's own type, never a maybe
  # (ADR 0019), and a String read by a number is a character or nothing
  # (#563). A maybe is opened for either.
  opened = opened_natively(receiver, types)
  if node.index in RangeNode
    return opened if opened == StringType.new || (opened in ArrayType)
    return UnknownType.new
  end
  return MaybeType.new(inner: StringType.new) if opened == StringType.new && synthesize(node.index, types) == IntegerType.new
  # A Hash looked up by its key's type answers its value, or nothing
  # where the key is not there (#607).
  return maybe_of(receiver.value) if (receiver in HashType) && opened_natively(synthesize(node.index, types), types) == receiver.key
  return UnknownType.new unless (receiver in ArrayType) && synthesize(node.index, types) == IntegerType.new
  maybe_of(receiver.element)
end

def synthesize_logical(node, types)
  left = synthesize(node.left, types)
  # The right side is read under what the left proved — `x.some? && x + 1`
  # sees a plain x; `x.nil? || x + 1` likewise.
  proof = narrowings(node.left, types)
  right_types = if node.operator == "&&" then with_bindings(types, when_true(proof)) else with_bindings(types, when_false(proof)) end
  right = synthesize(node.right, right_types)
  return left if left == right
  # Read as the native build runs it, nil gives way to the right of an
  # `or`, and a value that is always there is itself (#572).
  if native_reading?(types) && node.operator == "||"
    return right if left == NilType.new
    return left if left != BooleanType.new && left != UnknownType.new && !(left in MaybeType)
  end
  return UnknownType.new unless left in MaybeType
  # `maybe or default` answers the plain type when the default is one of
  # it, and `maybe or return` the plain type outright — below the guard
  # the name is plain (the third form of ADR 0040 §3). Anything else is
  # an opinion withheld.
  inner = left.inner
  return inner if exit?(node.right)
  return inner if right == inner
  # Read as the native build runs it, one struct standing in for one of
  # several is one of them (#572).
  if native_reading?(types) && node.operator == "||"
    # Read through `or`, what answers is a type (#607).
    return (joined_plain(inner, right) or UnknownType.new)
  end
  UnknownType.new
end

def synthesize_name(name, types)
  # A name that is not there names nothing (#607).
  named = name or return UnknownType.new
  found = binding_type(types, named)
  # A builtin type's bare name is the type as a value (ADR 0074).
  return ClassType.new(name: named) if found.nil? && %w[Array Boolean Complex Float Hash Integer Random Range Rational Set String Symbol].include?(named)
  found or UnknownType.new
end

# The type of an expression, by what kind of node it is.
def synthesize_node(node, types)
  case node
  in IntegerNode then IntegerType.new
  in FloatNode then FloatType.new
  in RationalNode then RationalType.new
  in ImaginaryNode then ComplexType.new
  # Interpolation needs no arm: it desugared to a `+` chain of strings at
  # parse, and the binary rule answers string for string + string.
  in StringNode then StringType.new
  in BooleanNode then BooleanType.new
  in SymbolNode then SymbolType.new
  in NilNode then NilType.new
  in RangeNode then synthesize_range(node, types)
  in WordArrayNode then ArrayType.new(element: StringType.new)
  in SymbolArrayNode then ArrayType.new(element: SymbolType.new)
  in ArrayNode then synthesize_array(node, types)
  in HashNode then synthesize_hash(node, types)
  in IdentifierNode then synthesize_identifier(node, types)
  in BinaryNode then synthesize_binary(node, types)
  in LogicalNode then synthesize_logical(node, types)
  in UnaryNode then synthesize_unary(node, types)
  in MethodCallNode then synthesize_call(node, types)
  in SafeMethodCallNode then synthesize_safe_call(node, types)
  # A bare call reaches a def the scan already typed (3b); its name shares
  # the list with the locals under the no-shadow rule. `format` and
  # `sprintf` (ADR 0067) answer a string.
  in CallNode then synthesize_bare_call(node, types)
  in IfNode then synthesize_if(node, types)
  # The one encoding a String has (ADR 0069) is its name, a String. Said
  # in the arm, not in its pattern, every arm here is a struct's, so the
  # native build passes over the arms a node of one struct cannot take
  # (#607).
  in PathNode(parts:) then parts == ["Encoding", "UTF_8"] ? StringType.new : UnknownType.new
  in CaseNode then synthesize_case(node, types)
  in CaseInNode then synthesize_case_in(node, types)
  in AppendNode then synthesize_append(node, types)
  # A `yield` is what the block answers, which only the native build's
  # pinning says (#493), under a name no local can have. The checker
  # binds none, and reads unknown.
  in YieldNode then synthesize_name("yield", types)
  in IndexNode then synthesize_index(node, types)
  # `self` is the receiver, which only the native build's pinning binds,
  # as the first parameter of a method (#525).
  in SelfNode then synthesize_name("self", types)
  in OpenedNode(value:) then opened_natively(synthesize(value, types), types)
  in NarrowedNode(name:) then StructType.new(name: name)
  # Whether a value matches is a Boolean, which the native build reads
  # (#572). The checker reads no type off a test.
  in MatchTestNode then native_reading?(types) ? BooleanType.new : UnknownType.new
  else
    UnknownType.new
  end
end

def synthesize_numeric_answer(receiver, name, arguments_empty: true)
  case name
  when "abs", "magnitude", "succ", "pred", "next", "gcd"
    # A complex's magnitude is a real: a float off the axes, the part's
    # own kind on them, so no one type to answer.
    return UnknownType.new if receiver == ComplexType.new && (name == "abs" || name == "magnitude")
    return receiver if numeric?(receiver)
    return IntegerType.new if name == "gcd"
    # A string's or a symbol's successor is another of the same (ADR 0071).
    return receiver if (receiver == StringType.new || receiver == SymbolType.new) && (name == "succ" || name == "next")
    UnknownType.new
  when "index", "find_index", "rindex"
    return MaybeType.new(inner: IntegerType.new) if receiver == StringType.new || (receiver in ArrayType)
    UnknownType.new
  when "sum"
    # Whole numbers stay whole; anything else about the elements is 3b,
    # and an init (`sum(0.5)`, `sum("")`) is the caller's to say.
    return IntegerType.new if receiver == ArrayType.new(element: IntegerType.new) && arguments_empty
    UnknownType.new
  when "to_i", "floor", "ceil", "round", "truncate", "div", "ceildiv" then IntegerType.new
  else
    IntegerType.new
  end
end

# A range carries its ends' type (ADR 0081) — the start's, or the end's for
# a beginless range — which is what its extremes and its walk answer.
def synthesize_range(node, types)
  side = node.start.nil? ? node.finish : node.start
  return RangeType.new(element: UnknownType.new) if side.nil?
  RangeType.new(element: synthesize(side, types))
end

# `x&.y` — a maybe of what `y` answers on the plain receiver (the seventh
# form of ADR 0040 §3); on a plain receiver the same, since some(x) is x.
def synthesize_safe_call(node, types)
  return type_function_answer(node) if builtin_type_function?(node, types)
  # Read as the native build runs it, it is the `if` it means (#572).
  guarded = native_reading?(types) ? safe_as_if(node) : nil
  return synthesize(guarded, types) if guarded.some?
  receiver = synthesize(node.receiver, types)
  plain = if receiver in MaybeType then receiver.inner else receiver end
  maybe_of(call_answer(plain, node, types))
end

def synthesize_shape_answer(receiver, name)
  case name
  when "sort", "uniq", "compact", "flatten", "slice", "take", "drop", "take_while", "drop_while", "rotate", "difference", "intersection"
    return receiver if receiver in ArrayType
    # A set's algebra answers a set; its Enumerable walks answer arrays
    # (ADR 0082), as Ruby's do.
    return receiver if receiver == SetType.new && %w[difference flatten intersection].include?(name)
    return ArrayType.new(element: UnknownType.new) if receiver == SetType.new && %w[compact drop sort take take_while drop_while uniq].include?(name)
    # A hash's compact and slice answer a hash (#105).
    return receiver if (receiver in HashType) && (name == "compact" || name == "slice")
    return StringType.new if receiver == StringType.new && name == "slice"
    UnknownType.new
  when "merge"
    return receiver if receiver in HashType
    UnknownType.new
  when "step" then ArrayType.new(element: IntegerType.new)
  when "to_a", "entries"
    return receiver if receiver in ArrayType
    # A range walks its integers (ADR 0081), so only one over them lists.
    return ArrayType.new(element: IntegerType.new) if receiver == RangeType.new(element: IntegerType.new)
    return ArrayType.new(element: UnknownType.new) if receiver == SetType.new
    UnknownType.new
  else
    UnknownType.new
  end
end

def synthesize_text_answer(receiver, name)
  return StringType.new if name == "to_s" || name == "join" || name == "inspect" || name == "chr"
  return StringType.new if receiver == StringType.new
  # A symbol's case changers answer a symbol (ADR 0071).
  return SymbolType.new if receiver == SymbolType.new
  return receiver if receiver in ArrayType
  UnknownType.new
end

def synthesize_unary(node, types)
  operand = synthesize(node.operand, types)
  return BooleanType.new if node.operator == "!"
  return operand if numeric?(operand)
  UnknownType.new
end

# A name no binding holds: a builtin type's name, or a def with no
# parameters called by its bare name.
def synthesize_unbound(node, types)
  plain = synthesize_name(node.name, types)
  # A def with no parameters is called by its bare name; under the
  # native reading it is kept by its combination, which has none.
  return plain unless plain == UnknownType.new && native_reading?(types)
  binding_type(types, combination_key(node.name, [], nil, false)) or plain
end

def task_line_names(lines)
  mutable names = []
  lines.each do |line|
    names << line.name if line in TaskLineNode
  end
  names
end

def tower_answer(left, right)
  return ComplexType.new if left == ComplexType.new || right == ComplexType.new
  return FloatType.new if left == FloatType.new || right == FloatType.new
  return RationalType.new if left == RationalType.new || right == RationalType.new
  IntegerType.new
end

# Raw positional read: host indexing lifts nil, and a type cell can hold
# ["nil"] legitimately.
def type_at(list, target_index)
  # Read through a run of one, so the walk is one step however long the
  # list is (#537). An index answers a maybe, and a nil that is there
  # comes back wrapped; a block's parameter is the element itself.
  mutable result = nil
  list.slice(target_index, 1).each { |element| result = element }
  result
end

# What a type function answers, the same on a plain call and behind `&.`
# (#181). A name no type function has answers unknown, never an
# error; the evaluator refuses it.
def type_function_answer(node) = type_function_answer_for(node.receiver.name, node.name)

# The same answers reached through a type value, `value.class.new` (ADR
# 0074), where there is no receiver node to read the type's name from.
def type_function_answer_for(type_name, name)
  return math_answer(name) if type_name == "Math"
  case name
  when "sqrt"                              then IntegerType.new
  when "arguments"                         then ArrayType.new(element: StringType.new)
  when "wall_clock_time", "monotonic_time" then IntegerType.new
  when "entropy"                           then ArrayType.new(element: IntegerType.new)
  # The two captures answer the text the block wrote (#251).
  when "capture_standard_output", "capture_standard_error" then if type_name == "System" then StringType.new else UnknownType.new end
  # `JSON.parse` answers the document's shape, which is unknown; the two
  # writers answer text (ADR 0072).
  when "generate", "pretty_generate"       then StringType.new
  # The bracketed type functions: `Set[a, b]` (ADR 0082), and `Array[a, b]`
  # and `Hash[...]` (ADR 0058, amended, #218).
  when "[]"
    case type_name
    when "Set"   then SetType.new
    when "Array" then ArrayType.new(element: UnknownType.new)
    when "Hash"  then HashType.new(key: UnknownType.new, value: UnknownType.new)
    else UnknownType.new
    end
  # `Complex.polar` and `Complex.rectangular` (ADR 0085).
  when "polar", "rect", "rectangular"     then if type_name == "Complex" then ComplexType.new else UnknownType.new end
  # `Regexp.escape` answers text, `Regexp.union` a pattern (ADR 0086).
  when "escape", "quote"                  then if type_name == "Regexp" then StringType.new else UnknownType.new end
  when "union"                            then if type_name == "Regexp" then RegexpType.new else UnknownType.new end
  when "linear_time?"                     then if type_name == "Regexp" then BooleanType.new else UnknownType.new end
  when "new"
    case type_name
    when "Hash"   then HashType.new(key: UnknownType.new, value: UnknownType.new)
    when "Random" then RandomType.new
    when "Regexp" then RegexpType.new
    when "Range"  then RangeType.new(element: UnknownType.new)
    when "Set"    then SetType.new
    else ArrayType.new(element: UnknownType.new)
    end
  else UnknownType.new
  end
end

def universal_answer(name)
  return BooleanType.new if name == "nil?" || name == "some?" || name == "failure?" || name == "eql?"
  return StringType.new if name == "to_s"
  UnknownType.new
end

# Bindings as a body leaves them, with each name that went in holding
# one of several structs holding that again (#572): what a body proved
# of a name is proved no further than the body.
def unnarrowed(before, after)
  # A proof bound beside a name inside the body goes with the body.
  mutable kept = bindings_hash(after).reject { |name, type| proved_key?(name) && binding_type(before, name).nil? }
  bindings_hash(before).each do |name, type|
    kept = kept.merge({name => ANY_STRUCT}) if type == ANY_STRUCT && kept.key?(name)
  end
  layer_of(kept)
end

def when_false(proof) = type_at(proof, 1)

def when_true(proof) = type_at(proof, 0)

# These bindings with newer ones laid over them (#607): where both bind a
# name, the newer is read.
# The newer ones are a layer of their own, so the bindings beneath are
# never copied, however many they are.
def with_bindings(types, newer)
  # Each of the newer layers is relinked over the bindings beneath, and
  # none is copied; layers that bind nothing add none.
  return types if newer.far.nil? && newer.near.empty?
  relayered(newer, types)
end

# These bindings with one more, which is read over any older binding of
# the name (#607). Only the newest layer is copied.
def with_bound(types, name, type) = types.with(near: types.near.merge({name => type}))

# These bindings with every binding of a name gone (#607).
def without_bound(types, name)
  return types if binding_type(types, name).nil?
  layer_of(bindings_hash(types).reject { |key, type| key == name })
end

# What a combination yields, one type for each value, as pinning bound it
# under its yields key, or nil where it bound none (#607).
def yielded_types(types, key) = binding_type(types, key)

# Whether a body yields anywhere, the blocks written in it included: a
# `yield` inside one reaches the def's own block.
def yields?(body)
  body.any? { (it in YieldNode) || yields?(children_of(it)) }
end

# The name what a combination yields goes by: the def and the types it
# is called with, whatever its block answers.
def yields_key(name, arguments) = combination_key(name, arguments, nil, false) + "&"
