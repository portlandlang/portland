# The native build's intermediate representation (#446): a program inside
# the native slice, lowered from the checked AST with every value's type
# written on it.
#
# The AST says what was written and inference says what it can prove; a
# code generator needs neither. It needs functions with typed parameters,
# typed locals, and a body in which every operation says what it produces.
# This is that form, and it is Portland's own: the LLVM printer (#447)
# reads it, and so would an MLIR printer after it.
#
# The slice is small on purpose (#443, #461, #491): Integer, Boolean, and
# String values, `+`, `-`, `*`, the comparisons, bindings, `if`, `while`,
# `def`, calls, a block handed to a def that yields, and `puts` of an
# Integer or a String. Anything else refuses here, by name, before a line
# of output exists.
#
# A value's struct carries the type it produces. A statement's carries
# none: it is run for what it does.

require_relative "pinning"

# What a `case` the native build does not hold is called (#558).
UNBUILT_CASE = "a case whose subject is more than a name or a field, or whose when names more than literals,"

# `name << value` on a local that holds an array: the local then holds
# the array with the value after its last element. Values never mutate,
# so an array another name holds is copied first, which the runtime
# sees to.
struct IntermediateAppend
  name
  type
  value
end

# `+`, `-`, or `*` between two Integers, refusing on overflow (ADR 0070).
struct IntermediateArithmetic
  type
  operator
  left
  right
end

# An array literal (#497): its elements in order, all of one type. The
# empty one has no element type of its own, and takes its local's.
struct IntermediateArray
  type
  elements
end

# A block (#493): a function of its own, written where it was handed
# over. Its parameters are one per value the def yields, the ones the
# block did not name under names no local can have. Its captures are the
# locals of its writer in scope where it was written, which it reads and
# rebinds where they live; its locals are the names it bound first.
struct IntermediateBlock
  parameters
  answer
  locals
  body
  captures
  # Whether the block yields (#495): a `yield` written inside it reaches
  # the block its writer was handed, which it then carries.
  onward
  # Whether the block can leave the call it is handed to (#523), and by
  # which doors: a `return` anywhere inside it, which needs the place its
  # def keeps an answer, and a `break` of its own, which needs to name the
  # call it leaves.
  leaves
  returns
  breaks
end

# An `if` run for what its arms do.
struct IntermediateBranch
  condition
  then_body
  else_body
end

# `break` and `next` in a loop: out of it, and on to its next turn.
struct IntermediateBreak
  line
end

# A call to one of the program's functions, with the block it is handed,
# or nil.
struct IntermediateCall
  type
  name
  # The combination of the def this call names, which is the function
  # it calls.
  target
  arguments
  block
end

# An `if` read for its value: one value per arm, and only the arm taken is
# computed.
struct IntermediateChoice
  type
  condition
  then_value
  else_value
end

# A comparison between two values of one type, answering a Boolean.
struct IntermediateComparison
  type
  operator
  left
  right
end

# `+` between two Strings: a new String holding both texts.
struct IntermediateConcat
  type
  left
  right
end

# A literal: an Integer's digits, `true` or `false`, or a String's text.
struct IntermediateConstant
  type
  value
end

# `maybe || fallback`: the value where there is one, and otherwise the
# fallback, which is computed only then.
struct IntermediateDefault
  type
  value
  fallback
end

# `/` or `%` between two Integers: rounding toward negative infinity, the
# remainder taking the divisor's sign, and refusing a zero divisor.
struct IntermediateDivision
  type
  operator
  left
  right
end

# A value computed and dropped: a call made for what it does.
struct IntermediateEvaluate
  value
end

# A struct's field read, by where it stands among the fields.
struct IntermediateField
  type
  record
  index
end

# A function: parameters and locals as [name, type] pairs, the type it
# answers, and its statements.
struct IntermediateFunction
  name
  # The name the compiled function takes: its combination's (ADR 0097),
  # since a def is one function for each combination of types it is
  # called with. The entry function has none.
  key
  parameters
  answer
  locals
  body
  # What a def that yields hands its block and reads back, as pinning's
  # PinnedBlock, or nil for a def that does not yield.
  block
  # Whether a block written in this def returns from it (#523), so the def
  # keeps a place for such a block to leave its answer.
  returned
end

# `array[index]`, `first`, and `last` (#503): the element as a maybe, nil
# past either end. A negative index counts from the end.
struct IntermediateIndex
  type
  array
  index
end

# A String in its source form, between quotes with its escapes: what
# `inspect` and `p` write.
struct IntermediateInspect
  type
  value
end

# `return` or `break` written inside a block (#523): the block stops, and
# so does every call between it and where it is leaving to. A `return`
# carries what the def it leaves is to answer.
struct IntermediateLeave
  kind
  value
end

# A method the runtime's library does (#560): the function, the value
# asked, what it is handed, and for each of those whether it goes over as
# the one word an array holds it as.
struct IntermediateLibrary
  type
  symbol
  receiver
  arguments
  words
end

# A parameter or a local, read.
struct IntermediateLocal
  type
  name
end

# `&&` or `||` between two Booleans. The right side is computed only when
# it decides the answer.
struct IntermediateLogical
  type
  operator
  left
  right
end

struct IntermediateLoop
  condition
  body
end

# A method a value answers, with no arguments: an Integer's `abs` or
# `even?`, a String's `length`. The receiver's type and the name say which.
struct IntermediateMethod
  type
  receiver
  name
end

# `-value`, refusing on the one Integer that has no negation.
struct IntermediateNegation
  type
  value
end

struct IntermediateNext
  line
end

# `!value`.
struct IntermediateNot
  type
  value
end

# A maybe used where its value is needed, opened when the line runs: the
# value where there is one, and otherwise the seed's refusal for nil
# asked that method, `puts` among them by its own name.
struct IntermediateOpen
  type
  value
  name
end

# `panic(message)`: the program stops, saying the message.
struct IntermediatePanic
  value
end

# `puts` of one Integer or one String.
struct IntermediatePrint
  value
end

# A program: its functions in written order, the top-level statements last
# as the entry function, `main`.
struct IntermediateProgram
  functions
  # The program's structs (#532), each as [its name, its fields as
  # [name, type] pairs in the order written]: what the output writes
  # into the binary for the runtime to free a struct and print one by.
  structs
end

# A struct made (#532): its fields' values in the order the struct
# declares them.
struct IntermediateRecord
  type
  fields
end

# A way out of a function, with the value it answers, or with none where
# the function answers nothing.
struct IntermediateReturn
  value
end

# A plain value bound where a maybe is held: a maybe that is there.
struct IntermediateSome
  type
  value
end

# `panic(message)` where a value was to be, on the right of an `or`
# (#534): the program stops, so it answers nothing, and is given the
# type of what it stands beside.
struct IntermediateStop
  type
  message
end

# A local bound or rebound.
struct IntermediateStore
  name
  value
end

# A member of `System` (#534): `arguments`, or `read_file` with the path
# it is handed.
struct IntermediateSystem
  type
  name
  arguments
end

# An Integer, a Boolean, or an array written out as a String, as `puts`,
# `to_s`, and interpolation write one. An array's is its source form.
struct IntermediateText
  type
  value
end

# `array.each { … }`: the block run once for each element, in order. It
# answers the array it walked.
struct IntermediateWalk
  type
  array
  block
end

# A `yield`: a call of the block the function was handed, and whether
# that block can leave (#523), which is what the call must be ready for.
struct IntermediateYield
  type
  arguments
  leaves
end

# Statements lowered, and the bindings in scope after them.
struct Lowered
  nodes
  bindings
end

# What lowering needs beside the statement in hand: the functions' answers
# as bindings, their parameter counts by name, and whether the function
# being lowered answers nothing, where a bare `return` is its way out.
struct LoweringContext
  answers
  arities
  procedure
  # Whether the statement in hand is inside a loop, where `break` and
  # `next` have somewhere to go.
  looping
  # Every combination pinning settled, each a PinnedDef: a call finds the
  # one it names here.
  combinations
  # The program's structs, each a StructDefNode (#532).
  structs
  # The block the function being lowered is handed, where it yields.
  yielding
  # Whether the statement in hand is inside a block, where `return` and
  # a `break` outside a loop reach past the block's own function.
  inside_block
  # What the function or block being lowered answers, which a `return`
  # and its last expression are fitted to.
  answer
  # What the def being lowered answers, a block written in it included,
  # since a `return` there is the def's (#523). Nil at the top level.
  home
  # Where the value being lowered stands: "statement" where it is run for
  # what it does, "value" where it is all of what is bound or answered,
  # and nil inside a larger expression, where a call or a yield that can
  # leave may not be written (#523).
  root
  # The types pinning gave the locals of the function being lowered, as
  # [name, type]. An empty array literal is typed from here, since what
  # names its elements may be an append written later, or inside a block.
  pinned
end

# Whether one arm of an `if` is more than an expression (#559).
def arm_is_body?(arm)
  only = arm.first
  return true if arm.length > 1
  return false if only.nil?
  (only in AssignmentNode) || (only in ReturnNode) || (only in WhileNode) || arms_are_bodies?((case_as_if(only) or only))
end

# Whether an `if` at the end of a body must be built arm by arm (#559):
# an arm is more than one expression, or is one statement that is not an
# expression, or is itself such an `if`.
def arms_are_bodies?(node)
  return false unless node in IfNode
  [(node.then_body or []), (node.else_body or [])].any? { arm_is_body?(it) }
end

# Where a field starts among its struct's words (#553): a field takes
# one word, and a maybe two, whether it is there and then its value.
def field_offset(fields, place)
  mutable offset = 0
  fields.slice(0, place).each do |field|
    offset += (type_at(field, 1) in ["maybe", *]) ? 2 : 1
  end
  offset
end

# A value as the type that is to hold it (#505): itself where it is that
# type, a maybe that is there where the type is a maybe of what it is,
# and a maybe that is not there where it is nil. Nil where it does not
# fit.
def fitted(value, type)
  return value if value.type == type
  return nil unless type in ["maybe", *]
  return IntermediateConstant.new(type: type, value: nil) if value.type == ["nil"]
  return IntermediateSome.new(type: type, value: value) if type_at(type, 1) == value.type
  nil
end

# What a name first bound here holds: what it is bound to, unless
# pinning settled it as a maybe of that, because another binding of the
# name is nil or a maybe.
def held_type(name, type, context)
  pinned = context.pinned.find { it[0] == name }
  return type if pinned.nil?
  settled = type_at(pinned, 1)
  return settled if (settled in ["maybe", *]) && native_type?(settled) && (type == ["nil"] || type == type_at(settled, 1))
  type
end

# A value in its source form, as `inspect` and `p` write it: a String
# between quotes, a maybe as its value or `nil`, and everything else as
# it is written out.
def inspected(value, node)
  return IntermediateInspect.new(type: ["string"], value: value) if value.type == ["string"] || (value.type in ["maybe", *])
  written_out(value, node)
end

# The one type two arms answer together: the type they share, or a maybe
# where one is nil or already a maybe of the other. Nil where there is
# none.
def joined_type(first, second)
  return first if first == second
  return ["maybe", second] if first == ["nil"] && native_value?(second)
  return ["maybe", first] if second == ["nil"] && native_value?(first)
  return first if first == ["maybe", second]
  return second if second == ["maybe", first]
  nil
end

# A call of the library's row for this name, asked of a value already
# opened and handed values already lowered (#563).
def library_call(name, holder, handed, node)
  entry = native_library_entry(holder.type, name, handed.map { it.type }) or refuse_native("#{name} asked of #{with_article(holder.type)}", node)
  IntermediateLibrary.new(type: library_type(type_at(entry, 3), holder.type), symbol: type_at(entry, 4), receiver: holder, arguments: handed, words: type_at(entry, 2).map { it == ["element"] })
end

# `name << value` (#497). The parser writes it as a binding of the name
# to the append, and that is the one shape built: the local takes the
# grown array, or the String with the value after it.
def lower_append(statement, append, bindings, context)
  refuse_native("a << bound to another name", statement) unless append.name == statement.name
  found = bindings.find { it[0] == append.name } or refuse_native("a << onto #{append.name}, which is not a local", statement)
  held = type_at(found, 1)
  # A String takes what is appended as `+` does (#557): the name is bound
  # to the two joined, and a maybe on either side is opened as `+` opens
  # its operands.
  if plain_of(held) == ["string"]
    joined = binary_node("+", identifier_node(append.name, line: append.line), append.value, line: append.line)
    return lower_statement(statement.with(value: joined), bindings, context)
  end
  refuse_native("a << onto #{with_article(held)}", statement) unless held in ["array", *]
  written = lower_value(append.value, bindings, context.with(root: "value"))
  # An empty array appended to an array of arrays is one of its elements.
  value = written.type == EMPTY_ARRAY && (type_at(held, 1) in ["array", *]) ? written.with(type: type_at(held, 1)) : written
  type = ["array", value.type]
  refuse_native("an array of #{render_type(value.type)}", statement) unless native_type?(type)
  refuse_native("a << of #{with_article(value.type)} onto #{with_article(held)}", statement) unless held == type || held == EMPTY_ARRAY
  # An empty array no append had named yet is named by this one.
  after = bindings.map { it[0] == append.name ? [append.name, type] : it }
  Lowered.new(nodes: [IntermediateAppend.new(name: append.name, type: type, value: value)], bindings: after)
end

# A block handed to a def (#493). Its parameters are bound to what the
# def yields, in order; one it leaves unnamed is still handed over, and
# takes a name no local can have. Every local of the writer's in scope
# is captured, less the ones a parameter of the block's hides. A name
# the block binds first is the block's own, and is not seen after it.
def lower_block(block, handed, bindings, context)
  refuse_native("a block that names more than it is yielded", block) if block.parameters.length > handed.parameters.length
  refuse_native("a block answering #{with_article(handed.answer)}", block) unless handed.answer == NOTHING || native_type?(handed.answer)
  mutable parameters = []
  mutable index = 0
  handed.parameters.each do |type|
    refuse_native("a block handed #{with_article(type)}", block) unless native_type?(type)
    name = type_at(block.parameters, index) or "unnamed #{index}"
    refuse_native("a block parameter that is not a name", block) unless name in String
    parameters << [name, type]
    index += 1
  end
  captures = bindings.reject { |binding| parameters.any? { it[0] == binding[0] } }
  start = parameters.reverse + captures
  # A `yield` inside the block is its writer's, so what the writer was
  # handed stays what a `yield` reaches.
  inside = context.with(procedure: handed.answer == NOTHING, looping: false, inside_block: true, answer: handed.answer)
  lowered = lower_body(block.body, block, "a block", start, handed.answer, inside)
  locals = lowered.bindings.slice(0, lowered.bindings.length - start.length)
  IntermediateBlock.new(parameters: parameters, answer: handed.answer, locals: locals.reverse, body: lowered.nodes, captures: captures, onward: yields?(block.body), leaves: handed.leaves, returns: block_returns?(block.body), breaks: block_breaks?(block.body))
end

# A def's body or a block's. One that answers nothing has every statement
# run for what it does, and hands nothing back. One that answers a value
# has its last statement read for it: an expression, a `return`, or a
# binding, which answers what it bound.
# `return` written inside a block (#523): it leaves the def the block is
# written in, so what it answers is fitted to that def, and not to the
# block.
def lower_block_return(statement, value, bindings, context)
  home = context.home or refuse_native("a return in a block outside a def", statement)
  if home == NOTHING
    refuse_native("a return with a value in a def that answers nothing", statement) unless value.nil?
    return Lowered.new(nodes: [IntermediateLeave.new(kind: "return", value: nil)], bindings: bindings)
  end
  refuse_native("a return with no value", statement) if value.nil?
  written = lower_value(value, bindings, context.with(root: "value"))
  returned = fitted(written, home) or refuse_native("a return of #{with_article(written.type)} where the answer is #{with_article(home)}", statement)
  Lowered.new(nodes: [IntermediateLeave.new(kind: "return", value: returned)], bindings: bindings)
end

def lower_body(body, owner, what, bindings, answer, context)
  if answer == NOTHING
    lowered = lower_statements(body, bindings, context)
    return Lowered.new(nodes: lowered.nodes + [IntermediateReturn.new(value: nil)], bindings: lowered.bindings)
  end
  leading = body.slice(0, body.length - 1)
  last = body.last
  refuse_native("#{what} with an empty body", owner) if last.nil?
  lowered = lower_statements(leading, bindings, context)
  # A `return` or a `panic` is the way out itself.
  if (last in ReturnNode) || ((last in CallNode) && last.name == "panic")
    closing = lower_statement(last, lowered.bindings, context)
    return Lowered.new(nodes: lowered.nodes + closing.nodes, bindings: closing.bindings)
  end
  if last in AssignmentNode
    stored = lower_statement(last, lowered.bindings, context)
    bound = stored.bindings.find { it[0] == last.name }
    held = IntermediateLocal.new(type: type_at(bound, 1), name: last.name)
    value = fitted(held, answer) or refuse_native("#{what} whose last expression is #{with_article(held.type)} where it answers #{with_article(answer)}", last)
    return Lowered.new(nodes: lowered.nodes + stored.nodes + [IntermediateReturn.new(value: value)], bindings: stored.bindings)
  end
  # An `if` whose arms are more than one expression each answers from
  # inside the arm taken (#559): each arm is a body of its own, and one
  # that is missing or empty answers nil.
  ending = (case_as_if(last) or last)
  if arms_are_bodies?(ending)
    test = lower_condition(ending.condition, lowered.bindings, context)
    nothing = [nil_node(line: ending.line)]
    taken = lower_body(((ending.then_body or []).empty? ? nothing : ending.then_body), owner, what, lowered.bindings, answer, context)
    other = lower_body(((ending.else_body or []).empty? ? nothing : ending.else_body), owner, what, taken.bindings, answer, context)
    return Lowered.new(nodes: lowered.nodes + [IntermediateBranch.new(condition: test, then_body: taken.nodes, else_body: other.nodes)], bindings: other.bindings)
  end
  written = lower_value(last, lowered.bindings, context.with(root: "value"))
  value = fitted(written, answer) or refuse_native("#{what} whose last expression is #{with_article(written.type)} where it answers #{with_article(answer)}", last)
  Lowered.new(nodes: lowered.nodes + [IntermediateReturn.new(value: value)], bindings: lowered.bindings)
end

def lower_call(node, name, arguments, bindings, context, root)
  arity = context.arities.find { it[0] == name }
  refuse_native("a call to #{name}", node) if arity.nil?
  below = context.with(root: nil)
  # What the call hands over by place, and then by name in the names'
  # own order (#536), which is how the combination is named.
  placed = arguments.reject { it in KeywordArgumentNode }.map { lower_value(it, bindings, below) }
  named = arguments.select { it in KeywordArgumentNode }.sort_by { it.label }.map { [it.label, lower_value(it.value, bindings, below)] }
  types = placed.map { it.type } + named.map { ["keyword", it[0], type_at(it, 1).type] }
  # A def called by its bare name is a name and not a call, and is
  # handed no block.
  written = (node in CallNode) ? node.block : nil
  # The call names a combination of the def's types (ADR 0097): what it
  # is handed, what its block answers, and whether its block can leave,
  # each read as pinning read it.
  scope = bindings + yielding_answers(context.answers, context.yielding)
  handed = written.nil? ? nil : native_block_answer(node, types, scope)
  leaves = written.some? && native_block_leaves?(written, scope)
  key = combination_key(name, types, handed, leaves)
  found = context.combinations.find { it.key == key } or refuse_native("a call to #{key}, a combination of types the build did not settle,", node)
  refuse_native("a block handed to #{name}, which does not yield", node) if written.some? && found.block.nil?
  refuse_leaving_inside(written, leaves, root, node) if written.some?
  block = written.nil? ? nil : lower_block(written, found.block, bindings, below)
  # The function takes what is handed by place and then what is handed
  # by name, in the order the def writes those parameters.
  by_name = found.parameters.slice(placed.length, found.parameters.length - placed.length).map do |parameter|
    handed_by_name = named.find { it[0] == parameter[0] } or refuse_native("a call to #{name} without #{parameter[0]}", node)
    type_at(handed_by_name, 1)
  end
  IntermediateCall.new(type: found.answer, name: name, target: key, arguments: placed + by_name, block: block)
end

def lower_condition(node, bindings, context)
  value = lower_value(node, bindings, context)
  refuse_native("a condition that is #{with_article(value.type)}", node) unless value.type == ["boolean"]
  value
end

# A def: its statements, the last one read for its value, since a def
# answers its last expression.
def lower_function(definition, found, context)
  found.parameters.each do |parameter|
    refuse_native("a parameter that is #{with_article(type_at(parameter, 1))}", definition) unless native_type?(type_at(parameter, 1))
  end
  refuse_native("a def answering #{with_article(found.answer)}", definition) unless found.answer == NOTHING || native_type?(found.answer)
  names = context.arities.map { it[0] }
  settled = pin_statements(definition.body, PinWalk.new(bindings: found.parameters, calls: []), yielding_answers(context.answers, found.block), names)
  inside = context.with(procedure: found.answer == NOTHING, yielding: found.block, answer: found.answer, home: found.answer, pinned: settled.bindings)
  lowered = lower_body(definition.body, definition, "a def", found.parameters, found.answer, inside)
  locals = lowered.bindings.reject { |binding| found.parameters.any? { it[0] == binding[0] } }
  IntermediateFunction.new(name: definition.name, key: found.key, parameters: found.parameters, answer: found.answer, locals: locals.reverse, body: lowered.nodes, block: found.block, returned: returned_into?(definition.body))
end

# A call of a method the library holds (#560), or nil where it holds none
# for what is asked and handed. A maybe is opened, the value asked and
# what it is handed alike, and nil refuses by the method's name.
def lower_library(node, bindings, context)
  asked = lower_value(node.receiver, bindings, context)
  handed = node.arguments.map { lower_value(it, bindings, context) }
  entry = native_library_entry(plain_of(asked.type), node.name, handed.map { plain_of(it.type) })
  return nil if entry.nil?
  holder = opened_for(asked, node.name)
  if node.name == "include?" && (holder.type in ["array", *])
    held = type_at(holder.type, 1)
    refuse_native("include? asked of an array of #{render_type(held)}", node) unless held == ["integer"] || held == ["boolean"] || held == ["string"]
  end
  words = type_at(entry, 2).map { it == ["element"] }
  IntermediateLibrary.new(type: library_type(type_at(entry, 3), holder.type), symbol: type_at(entry, 4), receiver: holder, arguments: handed.map { opened_for(it, node.name) }, words: words)
end

def lower_program(written, core: nil, progress: nil)
  # A constant is a def from here on, as pinning reads it (#562).
  nodes = constants_as_defs(written)
  build_note(progress, "pinning: every value's type, from how the program calls its defs") if progress.some?
  pinned = pin_program(nodes, core: core, progress: progress)
  definitions = pinned.definitions
  statements = nodes.reject { it in DefNode }
  # A field has one type (#532), as an array's elements have.
  conflict = pinned.conflicts.first
  panic("the native build gives each field of a struct one type — #{conflict} (#532)") if conflict.some?
  mutable called = []
  pinned.defs.each do |found|
    if found.pinned?
      called << found
    elsif found.key.some?
      panic("the native build needs one type for every value — def #{found.name} on line #{found.definition.line} has none: #{found.reason}")
    end
  end
  context = LoweringContext.new(answers: pinned.shapes + pinned_answers(called), arities: unique_types(called.map { [it.name, it.parameters.length] }), procedure: false, looping: false, combinations: called, structs: pinned.structs, yielding: nil, inside_block: false, answer: nil, home: nil, root: nil, pinned: pinned.bindings)
  build_note(progress, "lowering: #{called.length} combinations of #{unique_types(called.map { it.name }).length} defs") if progress.some?
  mutable functions = []
  called.each do |found|
    functions << lower_function(found.definition, found, context)
  end
  entry = lower_statements(statements, [], context)
  functions << IntermediateFunction.new(name: "main", key: nil, parameters: [], answer: ["nil"], locals: entry.bindings.reverse, body: entry.nodes, block: nil, returned: false)
  IntermediateProgram.new(functions: functions, structs: pinned.structs.map { |made| [made.name, struct_fields(made, context)] })
end

# `held[from..to]` (#563): the run a range reads, or nil where the index
# is no range. The library is handed where the range starts and ends,
# and whether it leaves its last place out (1), has no end (2), or both.
def lower_ranged(node, held, bindings, context)
  range = node.index
  return nil unless range in RangeNode
  zero = IntermediateConstant.new(type: ["integer"], value: 0)
  start = range.start.nil? ? zero : lower_value(range.start, bindings, context)
  finish = range.finish.nil? ? zero : lower_value(range.finish, bindings, context)
  refuse_native("an index by a range whose ends are not Integers", node) unless start.type == ["integer"] && finish.type == ["integer"]
  mode = IntermediateConstant.new(type: ["integer"], value: (range.exclusive ? 1 : 0) + (range.finish.nil? ? 2 : 0))
  library_call("[..]", opened_for(held, "[]"), [start, finish, mode], node)
end

# `Name.new(field: value)` (#532): each field of the struct handed its
# value by name, in any order, and lowered in the order the struct
# declares them. A field has the one type pinning settled for it.
def lower_record(node, made, bindings, context)
  refuse_native("#{made.name}.new with a block", node) unless node.block.nil?
  labelled = node.arguments.select { it in KeywordArgumentNode }
  refuse_native("#{made.name}.new handed a value without its field's name", node) unless labelled.length == node.arguments.length
  fields = struct_fields(made, context)
  labelled.each do |argument|
    refuse_native("#{made.name}.new handed #{argument.label}, which is not one of its fields", node) unless fields.any? { it[0] == argument.label }
  end
  values = fields.map do |field|
    argument = labelled.find { it.label == field[0] } or refuse_native("#{made.name}.new without #{field[0]}", node)
    written = lower_value(argument.value, bindings, context)
    type = type_at(field, 1)
    refuse_native("a field, #{made.name}.#{field[0]}, that is #{with_article(written.type)}", node) unless native_type?(written.type) || written.type == ["nil"]
    # A value handed to a field that is a maybe of it is one that is
    # there, and nil is one that is not (#553).
    fitted(written, type) or refuse_native("#{made.name}.#{field[0]} handed #{with_article(written.type)} where it is #{with_article(type)}", node)
  end
  IntermediateRecord.new(type: ["struct", made.name], fields: values)
end

def lower_statement(statement, bindings, context)
  # A `case` over literals is built as the `if`s it means (#558).
  plain = case_as_if(statement)
  return lower_statement(plain, bindings, context) if plain.some?
  refuse_native(UNBUILT_CASE, statement) if statement in CaseNode
  case statement
  in AssignmentNode(name:, value:)
    refuse_native("a parameter declared mutable", statement) if value.nil?
    return lower_append(statement, value, bindings, context) if value in AppendNode
    lowered = settled_empty(lower_value(value, bindings, context.with(root: "value")), name, bindings, context)
    found = bindings.find { it[0] == name }
    # A local that holds a maybe takes a plain value as a maybe that is
    # there, and nil as one that is not.
    holding = found.some? ? type_at(found, 1) : held_type(name, lowered.type, context)
    stored = fitted(lowered, holding) or refuse_native("#{name} rebound from #{with_article(holding)} to #{with_article(lowered.type)}", statement)
    refuse_native("a binding of #{with_article(stored.type)}", statement) unless native_type?(stored.type) || stored.type == EMPTY_ARRAY
    after = found.nil? ? [[name, stored.type]] + bindings : bindings
    Lowered.new(nodes: [IntermediateStore.new(name: name, value: stored)], bindings: after)
  # A struct or a trait written out declares, and runs nothing.
  in StructDefNode then Lowered.new(nodes: [], bindings: bindings)
  in TraitDefNode then Lowered.new(nodes: [], bindings: bindings)
  in WhileNode(condition:, body:)
    test = lower_condition(condition, bindings, context)
    inner = lower_statements(body, bindings, context.with(looping: true))
    Lowered.new(nodes: [IntermediateLoop.new(condition: test, body: inner.nodes)], bindings: inner.bindings)
  in BreakNode
    # In a block and outside any loop of its own, `break` leaves the call
    # the block was handed to (#523).
    return Lowered.new(nodes: [IntermediateLeave.new(kind: "break", value: nil)], bindings: bindings) if context.inside_block && !context.looping
    refuse_native("a break outside a while", statement) unless context.looping
    Lowered.new(nodes: [IntermediateBreak.new(line: statement.line)], bindings: bindings)
  in NextNode
    # In a block and outside any loop of its own, `next` ends the block's
    # turn: a way out of its function (#495).
    if context.inside_block && !context.looping
      refuse_native("a next in a block that answers a value", statement) unless context.procedure
      return Lowered.new(nodes: [IntermediateReturn.new(value: nil)], bindings: bindings)
    end
    refuse_native("a next outside a while", statement) unless context.looping
    Lowered.new(nodes: [IntermediateNext.new(line: statement.line)], bindings: bindings)
  in IfNode(condition:, then_body:, else_body:)
    test = lower_condition(condition, bindings, context)
    taken = lower_statements((then_body or []), bindings, context)
    other = lower_statements((else_body or []), taken.bindings, context)
    Lowered.new(nodes: [IntermediateBranch.new(condition: test, then_body: taken.nodes, else_body: other.nodes)], bindings: other.bindings)
  in ReturnNode(value:)
    return lower_block_return(statement, value, bindings, context) if context.inside_block
    if context.procedure
      refuse_native("a return with a value in a def that answers nothing", statement) unless value.nil?
      return Lowered.new(nodes: [IntermediateReturn.new(value: nil)], bindings: bindings)
    end
    refuse_native("a return with no value", statement) if value.nil?
    written = lower_value(value, bindings, context.with(root: "value"))
    returned = fitted(written, context.answer) or refuse_native("a return of #{with_article(written.type)} where the answer is #{with_article(context.answer or ["nil"])}", statement)
    Lowered.new(nodes: [IntermediateReturn.new(value: returned)], bindings: bindings)
  # `panic(message)` (#505).
  in CallNode(name: "panic", arguments:, block:)
    refuse_native("panic with a block", statement) unless block.nil?
    refuse_native("panic of anything but one message", statement) unless arguments.length == 1
    message = lower_value(arguments[0], bindings, context)
    refuse_native("panic of #{with_article(message.type)}", statement) unless message.type == ["string"]
    Lowered.new(nodes: [IntermediatePanic.new(value: message)], bindings: bindings)
  in CallNode(name: "puts", arguments:, block:)
    refuse_native("puts with a block", statement) unless block.nil?
    refuse_native("puts of anything but one value", statement) unless arguments.length == 1
    handed = lower_value(arguments[0], bindings, context)
    # A maybe is opened, and nil refuses as the seed's `puts` does.
    value = (handed.type in ["maybe", *]) ? IntermediateOpen.new(type: type_at(handed.type, 1), value: handed, name: "puts") : handed
    # An Integer is printed as it is; everything else as its text.
    shown = value.type == ["integer"] ? value : written_out(value, statement)
    Lowered.new(nodes: [IntermediatePrint.new(value: shown)], bindings: bindings)
  # `p` of one value (#501): its source form on a line.
  in CallNode(name: "p", arguments:, block:)
    refuse_native("p with a block", statement) unless block.nil?
    refuse_native("p of anything but one value", statement) unless arguments.length == 1
    value = lower_value(arguments[0], bindings, context)
    shown = value.type == ["integer"] ? value : inspected(value, statement)
    Lowered.new(nodes: [IntermediatePrint.new(value: shown)], bindings: bindings)
  in CallNode(name:, arguments:)
    # A call made for what it does: one to a def that answers nothing may
    # stand here, and nowhere a value is read.
    Lowered.new(nodes: [IntermediateEvaluate.new(value: lower_call(statement, name, arguments, bindings, context, "statement"))], bindings: bindings)
  # A `yield` made for what the block does, which may answer nothing.
  in YieldNode
    Lowered.new(nodes: [IntermediateEvaluate.new(value: lower_yield(statement, bindings, context, "statement"))], bindings: bindings)
  else
    Lowered.new(nodes: [IntermediateEvaluate.new(value: lower_value(statement, bindings, context.with(root: "statement")))], bindings: bindings)
  end
end

def lower_statements(statements, bindings, context)
  mutable nodes = []
  mutable current = bindings
  statements.each do |statement|
    lowered = lower_statement(statement, current, context)
    nodes += lowered.nodes
    current = lowered.bindings
  end
  Lowered.new(nodes: nodes, bindings: current)
end

# A member of `System` (#534). `arguments` is what the process was
# started with. `read_file` answers the file's text or a failure, and a
# failure is unbuilt, so it builds only on the left of an `or`, where
# the right side takes the failure's place and nothing can tell a
# failure from nil.
def lower_system(node, bindings, context, root)
  refuse_native("System.#{node.name} with a block", node) unless node.block.nil?
  if node.name == "arguments" && node.arguments.empty?
    return IntermediateSystem.new(type: ["array", ["string"]], name: "arguments", arguments: [])
  end
  if node.name == "read_file" && node.arguments.length == 1
    refuse_native("System.read_file read without an or beside it — it answers a failure where the file cannot be read, and a failure", node) unless root == "or"
    named = lower_value(node.arguments[0], bindings, context)
    refuse_native("System.read_file of #{with_article(named.type)}", node) unless named.type == ["string"]
    return IntermediateSystem.new(type: ["maybe", ["string"]], name: "read_file", arguments: [named])
  end
  refuse_native("System.#{node.name}", node)
end

# An expression, as a value with its type.
def lower_value(node, bindings, context)
  # A `case` over literals is built as the `if`s it means (#558).
  plain = case_as_if(node)
  return lower_value(plain, bindings, context) if plain.some?
  refuse_native(UNBUILT_CASE, node) if node in CaseNode
  # `%w[a b]` is the array of its words (#562).
  if node in WordArrayNode
    words = word_array_elements(node.text).map { string_node(it, line: node.line) }
    return lower_value(array_node(words, line: node.line), bindings, context)
  end
  # What is lowered below this value sits inside a larger expression,
  # where a call or a yield that can leave may not be written (#523).
  inner = context.with(root: nil)
  # A method the core writes for the receiver's type is a def (#525), and
  # a call with a dot that it answers is a call of that def.
  if node in MethodCallNode
    scope = bindings + yielding_answers(context.answers, context.yielding)
    called = native_method_call(node, synthesize(node.receiver, scope), scope)
    return lower_value(called, bindings, context) if called.some?
    # `System` is the floor's (ADR 0068), where no local has the name.
    if (node.receiver in IdentifierNode) && node.receiver.name == "System" && bindings.none? { it[0] == "System" }
      return lower_system(node, bindings, inner, context.root)
    end
    # `Name.new(field: value)` makes one of the program's structs (#532).
    if node.name == "new" && (node.receiver in IdentifierNode) && bindings.none? { it[0] == node.receiver.name }
      made = context.structs.find { it.name == node.receiver.name }
      return lower_record(node, made, bindings, inner) if made.some?
    end
  end
  case node
  in IntegerNode(value:) then IntermediateConstant.new(type: ["integer"], value: value)
  in BooleanNode(value:) then IntermediateConstant.new(type: ["boolean"], value: value)
  in StringNode(value:) then IntermediateConstant.new(type: ["string"], value: value)
  # A maybe handed to a method as its receiver is opened for it.
  in OpenedNode(value:, name:)
    held = lower_value(value, bindings, inner)
    IntermediateOpen.new(type: plain_of(held.type), value: held, name: name)
  # `self` is a method's first parameter (#525).
  in SelfNode
    receiver = bindings.find { it[0] == "self" } or refuse_native("self outside a method", node)
    IntermediateLocal.new(type: type_at(receiver, 1), name: "self")
  # `value in Boolean` (#525): whether a local is of a type, which its own
  # type settles before the program runs.
  in MatchTestNode(subject:, pattern:)
    refuse_native("an in test of anything but a type's name", node) unless (pattern in StructPatternNode) && pattern.fields.empty?
    refuse_native("an in test of anything but a local", node) unless subject in IdentifierNode
    tested = lower_value(subject, bindings, inner)
    wanted = native_type_named(pattern.name) or refuse_native("an in test for #{pattern.name}", node)
    refuse_native("an in test of #{with_article(tested.type)}", node) if tested.type in ["maybe", *]
    matches = wanted == ["array"] ? (tested.type in ["array", *]) : tested.type == wanted
    IntermediateConstant.new(type: ["boolean"], value: matches)
  # `nil` has no type of its own to be held as; what it is bound to, or
  # answered as, makes it a maybe that is not there (#505).
  in NilNode then IntermediateConstant.new(type: ["nil"], value: nil)
  in IdentifierNode(name:)
    found = bindings.find { it[0] == name }
    refuse_native("an array that is never given an element, #{name}", node) if found.some? && type_at(found, 1) == EMPTY_ARRAY
    return IntermediateLocal.new(type: type_at(found, 1), name: name) if found.some?
    lower_call(node, name, [], bindings, inner, nil)
  in ArrayNode(elements:)
    values = elements.map { lower_value(it, bindings, inner) }
    return IntermediateArray.new(type: EMPTY_ARRAY, elements: []) if values.empty?
    # An empty array among arrays is one of them, whatever they hold.
    named = values.find { it.type != EMPTY_ARRAY }
    first = named.nil? ? EMPTY_ARRAY : named.type
    values.each do |value|
      fits = value.type == first || (value.type == EMPTY_ARRAY && (first in ["array", *]))
      refuse_native("an array holding #{with_article(first)} and #{with_article(value.type)}", node) unless fits
    end
    refuse_native("an array of #{render_type(first)}", node) unless native_type?(["array", first])
    IntermediateArray.new(type: ["array", first], elements: values)
  in BinaryNode(operator:, left:, right:)
    # `== nil` asks whether a value is there (#503).
    if %w[== !=].include?(operator) && ((left in NilNode) || (right in NilNode))
      asked = lower_value((left in NilNode) ? right : left, bindings, inner)
      absent = IntermediateMethod.new(type: ["boolean"], receiver: asked, name: "nil?")
      return operator == "==" ? absent : IntermediateNot.new(type: ["boolean"], value: absent)
    end
    first = lower_value(left, bindings, inner)
    second = lower_value(right, bindings, inner)
    # A maybe on either side is opened when the line runs, so the operator
    # is read on the values. `==` and `!=` alone compare a maybe as it is.
    before = plain_of(first.type)
    after = plain_of(second.type)
    return IntermediateConcat.new(type: ["string"], left: first, right: second) if operator == "+" && before == ["string"] && after == ["string"]
    if %w[/ %].include?(operator)
      refuse_native("'#{operator}' between #{with_article(first.type)} and #{with_article(second.type)}", node) unless before == ["integer"] && after == ["integer"]
      return IntermediateDivision.new(type: ["integer"], operator: operator, left: first, right: second)
    end
    if %w[+ - *].include?(operator)
      refuse_native("'#{operator}' between #{with_article(first.type)} and #{with_article(second.type)}", node) unless before == ["integer"] && after == ["integer"]
      return IntermediateArithmetic.new(type: ["integer"], operator: operator, left: first, right: second)
    end
    refuse_native("the operator '#{operator}'", node) unless %w[< <= > >= == !=].include?(operator)
    refuse_native("'#{operator}' between #{with_article(first.type)} and #{with_article(second.type)}", node) unless before == after
    refuse_native("'#{operator}' between Booleans", node) if before == ["boolean"] && !%w[== !=].include?(operator)
    refuse_native("'#{operator}' between arrays", node) if before in ["array", *]
    # A struct equals another by what its fields hold, which is unbuilt;
    # comparing the two as they are held would compare where they live.
    refuse_native("'#{operator}' between structs", node) if before in ["struct", *]
    # Strings are equal or not (ADR 0038); ordering them is unbuilt.
    refuse_native("'#{operator}' between Strings", node) if before == ["string"] && !%w[== !=].include?(operator)
    IntermediateComparison.new(type: ["boolean"], operator: operator, left: first, right: second)
  # `array[index]` (#503): the element, or nil past either end.
  in IndexNode(receiver:, index:)
    held = lower_value(receiver, bindings, inner)
    # A range reads a run, of a String or of an array, and a number reads
    # a String's character (#563).
    ranged = lower_ranged(node, held, bindings, inner)
    return ranged if ranged.some?
    if plain_of(held.type) == ["string"]
      place = lower_value(index, bindings, inner)
      refuse_native("an index into a String by #{with_article(place.type)}", node) unless place.type == ["integer"]
      return library_call("[]", opened_for(held, "[]"), [place], node)
    end
    refuse_native("an index into #{with_article(held.type)}", node) unless held.type in ["array", *]
    position = lower_value(index, bindings, inner)
    refuse_native("an index that is #{with_article(position.type)}", node) unless position.type == ["integer"]
    IntermediateIndex.new(type: ["maybe", type_at(held.type, 1)], array: held, index: position)
  in CallNode(name:, arguments:)
    # `inspect(value)` (#501), where the program has no def of that name.
    if name == "inspect" && arguments.length == 1 && node.block.nil? && context.arities.none? { it[0] == name }
      return inspected(lower_value(arguments[0], bindings, inner), node)
    end
    called = lower_call(node, name, arguments, bindings, inner, context.root)
    panic("#{name} answers nothing, so there is no value to read from it on line #{node.line}") if called.type == NOTHING
    called
  in YieldNode
    yielded = lower_yield(node, bindings, inner, context.root)
    panic("the block answers nothing, so there is no value to read from yield on line #{node.line}") if yielded.type == NOTHING
    yielded
  in LogicalNode(operator:, left:, right:)
    refuse_native("the operator '#{operator}'", node) unless %w[&& ||].include?(operator)
    # Read on the left of an `or`, a failure's place is taken by the right
    # side, so `System.read_file` may stand there (#534).
    first = lower_value(left, bindings, inner.with(root: operator == "||" ? "or" : nil))
    # `maybe || fallback` (#503): the value, or the fallback where there
    # is none. The fallback is a value of the same type, or another maybe.
    if operator == "||" && (first.type in ["maybe", *])
      # `maybe or panic "…"`: the right side stops the program, so the
      # whole is the value (#534).
      if (right in CallNode) && right.name == "panic" && right.arguments.length == 1 && right.block.nil?
        message = lower_value(right.arguments[0], bindings, inner)
        refuse_native("panic of #{with_article(message.type)}", right) unless message.type == ["string"]
        plain = type_at(first.type, 1)
        return IntermediateDefault.new(type: plain, value: first, fallback: IntermediateStop.new(type: plain, message: message))
      end
      fallback = lower_value(right, bindings, inner)
      fits = fallback.type == first.type || fallback.type == type_at(first.type, 1)
      refuse_native("'||' between #{with_article(first.type)} and #{with_article(fallback.type)}", node) unless fits
      return IntermediateDefault.new(type: fallback.type, value: first, fallback: fallback)
    end
    refuse_native("a condition that is #{with_article(first.type)}", left) unless first.type == ["boolean"]
    second = lower_condition(right, bindings, inner)
    IntermediateLogical.new(type: ["boolean"], operator: operator, left: first, right: second)
  in UnaryNode(operator: "-", operand:)
    negated = lower_value(operand, bindings, inner)
    refuse_native("'-' before #{with_article(negated.type)}", node) unless negated.type == ["integer"]
    IntermediateNegation.new(type: ["integer"], value: negated)
  in UnaryNode(operator: "!", operand:)
    IntermediateNot.new(type: ["boolean"], value: lower_condition(operand, bindings, inner))
  # `to_s`, which is what interpolation asks of each piece.
  in MethodCallNode(receiver:, name: "to_s", arguments: [], block: nil)
    written_out(lower_value(receiver, bindings, inner), node)
  # `each` on an array (#497): the block is handed each element, and
  # answers nothing anyone reads.
  in MethodCallNode(receiver:, name: "each", arguments: [], block:)
    refuse_native("each without a block", node) if block.nil?
    walked = lower_value(receiver, bindings, inner)
    refuse_native("a call with a dot, .each, on #{with_article(walked.type)}", node) unless walked.type in ["array", *]
    leaves = native_block_leaves?(block, bindings + yielding_answers(context.answers, context.yielding))
    refuse_leaving_inside(block, leaves, context.root, node)
    handed = PinnedBlock.new(parameters: [type_at(walked.type, 1)], answer: NOTHING, reason: nil, leaves: leaves)
    IntermediateWalk.new(type: walked.type, array: walked, block: lower_block(block, handed, bindings, inner))
  in MethodCallNode(receiver:, name:, arguments: [], block: nil)
    asked = lower_value(receiver, bindings, inner)
    refuse_native("a call with a dot, .#{name}, on nil", node) if asked.type == ["nil"]
    # Whether a value is there, asked of anything (#503).
    return IntermediateMethod.new(type: ["boolean"], receiver: asked, name: name) if %w[nil? some?].include?(name)
    if (asked.type in ["array", *]) && %w[first last].include?(name)
      position = IntermediateConstant.new(type: ["integer"], value: name == "first" ? 0 : -1)
      return IntermediateIndex.new(type: ["maybe", type_at(asked.type, 1)], array: asked, index: position)
    end
    # A struct's field is read by its name (#532), a maybe opened for it.
    if plain_of(asked.type) in ["struct", *]
      made = context.structs.find { it.name == type_at(plain_of(asked.type), 1) }
      fields = made.nil? ? [] : struct_fields(made, context)
      place = fields.find_index { it[0] == name }
      holder = (asked.type in ["maybe", *]) ? IntermediateOpen.new(type: plain_of(asked.type), value: asked, name: name) : asked
      return IntermediateField.new(type: type_at(type_at(fields, place), 1), record: holder, index: field_offset(fields, place)) if place.some?
    end
    # Every other method is asked of the value, a maybe opened for it:
    # one the build writes out itself, or one the library holds (#560).
    answer = native_method_answer(plain_of(asked.type), name)
    return IntermediateMethod.new(type: answer, receiver: asked, name: name) if answer.some?
    lower_library(node, bindings, inner) or refuse_native("a call with a dot, .#{name}, on #{with_article(asked.type)}", node)
  # A method with arguments that the library holds (#560).
  in MethodCallNode(block: nil)
    lower_library(node, bindings, inner) or refuse_native(native_name_of(node), node)
  in IfNode(condition:, then_body:, else_body:)
    taken = then_body or []
    other = else_body or []
    refuse_native("an if read for its value whose arms are not one expression each", node) unless taken.length == 1 && other.length <= 1
    first = lower_value(taken[0], bindings, inner)
    # A missing `else` answers nil (ADR 0012).
    second = other.empty? ? IntermediateConstant.new(type: ["nil"], value: nil) : lower_value(other[0], bindings, inner)
    type = joined_type(first.type, second.type) or refuse_native("an if whose arms are #{with_article(first.type)} and #{with_article(second.type)}", node)
    IntermediateChoice.new(type: type, condition: lower_condition(condition, bindings, inner), then_value: (fitted(first, type) or first), else_value: (fitted(second, type) or second))
  else
    refuse_native(native_name_of(node), node)
  end
end

# A `yield`: what it hands over, and the type the block answers.
def lower_yield(node, bindings, context, root)
  handed = context.yielding or refuse_native("a yield outside a def", node)
  # A block that can leave may leave from here, past whatever this
  # expression was holding (#523).
  refuse_native("a yield to a block that leaves, inside a larger expression,", node) if handed.leaves && root.nil?
  below = context.with(root: nil)
  arguments = node.values.map { lower_value(it, bindings, below) }
  IntermediateYield.new(type: handed.answer, arguments: arguments, leaves: handed.leaves)
end

def native_method_answer(type, name)
  case type
  in ["integer"]
    return ["integer"] if %w[abs succ next pred].include?(name)
    return ["boolean"] if %w[even? odd? zero? positive? negative?].include?(name)
  in ["string"]
    return ["integer"] if %w[length size].include?(name)
    return ["boolean"] if name == "empty?"
  in ["array", *]
    return ["integer"] if %w[length size].include?(name)
    return ["boolean"] if name == "empty?"
  else
    return nil
  end
  nil
end

# What to call a node the slice does not hold, in the refusal.
def native_name_of(node)
  case node
  in FloatNode then "a float"
  in ArrayNode then "an array"
  in HashNode then "a hash"
  in NilNode then "nil"
  in MethodCallNode(name:) then "a call with a dot, .#{name}"
  in LogicalNode(operator:) then "the operator '#{operator}'"
  in UnaryNode(operator:) then "the operator '#{operator}'"
  in WhileNode then "a while read for its value"
  in YieldNode then "a yield"
  in IndexNode then "an index with [ ]"
  in AssignmentNode then "a binding read for its value"
  in ReturnNode then "a return read for its value"
  else "this (#{node.kind})"
  end
end

# The types the native build holds: an Integer, a Boolean, a String, an
# array of any of those or of such arrays (#497, #499), and a maybe of
# any of them (#503). An array holds no maybe.
def native_type?(type)
  return native_value?(type_at(type, 1)) if type in ["maybe", *]
  native_value?(type)
end

# The type a builtin type's name is, as an `in` test names it: for an
# array, any array. Nil for a name the native build holds no type for.
def native_type_named(name)
  case name
  when "Array" then ["array"]
  when "Boolean" then ["boolean"]
  when "Integer" then ["integer"]
  when "String" then ["string"]
  else nil
  end
end

def native_value?(type)
  return true if type == ["integer"] || type == ["boolean"] || type == ["string"]
  return true if type in ["struct", *]
  (type in ["array", *]) && native_value?(type_at(type, 1))
end

# A value with a maybe opened for a method of this name.
def opened_for(value, name)
  return value unless value.type in ["maybe", *]
  IntermediateOpen.new(type: plain_of(value.type), value: value, name: name)
end

# A type with a maybe opened: what an operation that needs the value
# works on.
def plain_of(type) = (type in ["maybe", *]) ? type_at(type, 1) : type

# A call handed a block that can leave is written where nothing else is
# being held (#523): as a statement, or as all of what is bound or
# answered. Inside a larger expression, a String or an array held for
# the rest of it would not be released on the way out. A `break` makes
# the call answer nil, so its call is one run for what it does.
def refuse_leaving_inside(block, leaves, root, node)
  refuse_native("a call handed a block that leaves, inside a larger expression,", node) if leaves && root.nil?
  refuse_native("a break in a block whose call is read for its value", node) if block_breaks?(block.body) && root != "statement"
end

# The one refusal for everything outside the slice: what the native build
# does compile, then what it met and where.
def refuse_native(what, node)
  line = node.nil? ? "" : " on line #{node.line}"
  panic("the native build compiles integers, strings, comparisons, if, while, def, yield, and puts — #{what}#{line} is unbuilt (#443)")
end

# A block in the dump: its parameters between bars, then its statements,
# on one line.
def render_handed_block(block)
  parameters = block.parameters.map { "#{it[0]}: #{render_type(type_at(it, 1))}" }.join(", ")
  "(block |#{parameters}| #{render_statements(block.body, "").map { it.strip }.join("; ")})"
end

# The dump: one line per function and statement, values as S-expressions.
def render_intermediate(program)
  mutable lines = []
  program.functions.each do |function|
    parameters = function.parameters.map { "#{it[0]}: #{render_type(type_at(it, 1))}" }.join(", ")
    taking = function.block.nil? ? "" : " #{render_pinned_block(function.block)}"
    lines << "function #{function.name}(#{parameters})#{taking} -> #{render_pinned_type(function.answer)}"
    function.locals.each do |local|
      lines << "  local #{local[0]}: #{render_type(type_at(local, 1))}"
    end
    lines += render_statements(function.body, "  ")
  end
  lines
end

def render_statements(statements, indent)
  mutable lines = []
  statements.each do |statement|
    case statement
    in IntermediateStore(name:, value:) then lines << "#{indent}store #{name} #{render_value(value)}"
    in IntermediateReturn(value:) then lines << (value.nil? ? "#{indent}return" : "#{indent}return #{render_value(value)}")
    in IntermediatePrint(value:) then lines << "#{indent}print #{render_value(value)}"
    in IntermediateEvaluate(value:) then lines << "#{indent}evaluate #{render_value(value)}"
    in IntermediateAppend(name:, value:) then lines << "#{indent}append #{name} #{render_value(value)}"
    in IntermediatePanic(value:) then lines << "#{indent}panic #{render_value(value)}"
    in IntermediateLeave(kind:, value:) then lines << (value.nil? ? "#{indent}leave #{kind}" : "#{indent}leave #{kind} #{render_value(value)}")
    in IntermediateBreak then lines << "#{indent}break"
    in IntermediateNext then lines << "#{indent}next"
    in IntermediateLoop(condition:, body:)
      lines << "#{indent}while #{render_value(condition)}"
      lines += render_statements(body, indent + "  ")
    in IntermediateBranch(condition:, then_body:, else_body:)
      lines << "#{indent}if #{render_value(condition)}"
      lines += render_statements(then_body, indent + "  ")
      unless else_body.empty?
        lines << "#{indent}else"
        lines += render_statements(else_body, indent + "  ")
      end
    end
  end
  lines
end

def render_value(value)
  case value
  in IntermediateConstant(type: ["string"], value: text) then inspect(text)
  in IntermediateConstant(value: nil) then "nil"
  in IntermediateConstant(value: literal) then literal.to_s
  in IntermediateLocal(name:) then name
  in IntermediateArithmetic(operator:, left:, right:) then "(#{operator} #{render_value(left)} #{render_value(right)})"
  in IntermediateComparison(operator:, left:, right:) then "(#{operator} #{render_value(left)} #{render_value(right)})"
  in IntermediateDivision(operator:, left:, right:) then "(#{operator} #{render_value(left)} #{render_value(right)})"
  in IntermediateLogical(operator:, left:, right:) then "(#{operator} #{render_value(left)} #{render_value(right)})"
  in IntermediateNegation(value: negated) then "(- #{render_value(negated)})"
  in IntermediateNot(value: inverted) then "(! #{render_value(inverted)})"
  in IntermediateCall(name:, arguments:, block:)
    handed = block.nil? ? [] : [render_handed_block(block)]
    "(call #{([name] + arguments.map { render_value(it) } + handed).join(" ")})"
  in IntermediateYield(arguments:) then "(yield#{arguments.map { " #{render_value(it)}" }.join("")})"
  in IntermediateArray(elements:) then "(array#{elements.map { " #{render_value(it)}" }.join("")})"
  in IntermediateSystem(name:, arguments:) then "(System #{([name] + arguments.map { render_value(it) }).join(" ")})"
  in IntermediateStop(message:) then "(panic #{render_value(message)})"
  in IntermediateRecord(type:, fields:) then "(new #{type_at(type, 1)}#{fields.map { " #{render_value(it)}" }.join("")})"
  in IntermediateField(record:, index:) then "(field #{render_value(record)} #{index})"
  in IntermediateIndex(array:, index:) then "([] #{render_value(array)} #{render_value(index)})"
  in IntermediateOpen(value: held, name:) then "(open #{render_value(held)} #{name})"
  in IntermediateDefault(value: held, fallback:) then "(|| #{render_value(held)} #{render_value(fallback)})"
  in IntermediateSome(value: held) then "(some #{render_value(held)})"
  in IntermediateWalk(array:, block:) then "(each #{render_value(array)} #{render_handed_block(block)})"
  in IntermediateConcat(left:, right:) then "(concat #{render_value(left)} #{render_value(right)})"
  in IntermediateMethod(receiver:, name:) then "(. #{render_value(receiver)} #{name})"
  in IntermediateLibrary(symbol:, receiver:, arguments:) then "(#{symbol} #{([receiver] + arguments).map { render_value(it) }.join(" ")})"
  in IntermediateText(value: number) then "(text #{render_value(number)})"
  in IntermediateInspect(value: shown) then "(inspect #{render_value(shown)})"
  in IntermediateChoice(type:, condition:, then_value:, else_value:)
    "(if #{render_type(type)} #{render_value(condition)} #{render_value(then_value)} #{render_value(else_value)})"
  end
end

# Whether a `return` is written inside a block somewhere in a def's
# body (#523), so the def keeps a place for it to leave its answer.
def returned_into?(body)
  body.any? do |node|
    handed = (node in CallNode) || (node in MethodCallNode) || (node in SafeMethodCallNode) ? node.block : nil
    (handed.some? && block_returns?(handed.body)) || returned_into?(children_of(node))
  end
end

# An empty array literal bound to a name takes the type the name has: a
# local already bound, or what pinning settled for it from the appends
# that follow.
def settled_empty(lowered, name, bindings, context)
  return lowered unless lowered.type == EMPTY_ARRAY
  found = bindings.find { it[0] == name }
  return lowered.with(type: type_at(found, 1)) if found.some? && (type_at(found, 1) in ["array", *])
  pinned = context.pinned.find { it[0] == name }
  return lowered if pinned.nil? || !native_type?(type_at(pinned, 1))
  lowered.with(type: type_at(pinned, 1))
end

# A struct's fields as [name, type] pairs, in the order written, each at
# the type pinning settled for it. A field nothing ever made has none.
def struct_fields(made, context)
  made.fields.map do |field|
    settled = context.answers.find { it[0] == field_key(made.name, field) }
    [field, settled.nil? ? ["unknown"] : type_at(settled, 1)]
  end
end

# A value as `puts`, `to_s`, and interpolation write it: a String is
# itself, and an Integer, a Boolean, or an array is written out.
def written_out(value, node)
  # A maybe is opened first, and nil refuses as the seed's `to_s` does.
  return written_out(IntermediateOpen.new(type: type_at(value.type, 1), value: value, name: "to_s"), node) if value.type in ["maybe", *]
  return value if value.type == ["string"]
  writable = value.type == ["integer"] || value.type == ["boolean"] || (value.type in ["array", *]) || (value.type in ["struct", *])
  refuse_native("writing out #{with_article(value.type)}", node) unless writable
  IntermediateText.new(type: ["string"], value: value)
end
