# Stage 1, act three: the checker — the first walker the seed will never
# have (#9, ADR 0034).
#
# A library: require_relative "checker", then check_program(nodes, source)
# before evaluating — the source text rides along for the one check that
# reads a comment (ADR 0041's return annotations). It walks the whole tree, so a refusal fires whether or not
# the offending line would ever run — which is the entire point: the seed
# can only refuse the code it reaches, and a compiler must refuse the code
# it can read.
#
# Two check families. First, the narrowest that exists (ADR 0022's closed
# vocabularies, checked statically):
#
# - A payload-carrying construction `:paid(on: x)` must name a declared
#   case, agree with every declaration, and bring exactly the declared
#   labels. The seed refuses these at *runtime*; the wordings here are the
#   seed's own, byte for byte — only the timing moves (ADR 0034 §2).
# - A pattern `in :paid(on:)` naming an undeclared case is refused too —
#   and there the seed says nothing at all: an undeclared case in a pattern
#   silently never matches, which is the classic typo bug. This wording is
#   the compiler's first original diagnostic, pinned by ADR 0034 §3 and its
#   tests rather than by any oracle.
#
# Second, coverage and reachability over a `case/in` (ADR 0035), which is
# ADR 0013 §1 and §3 and ADR 0019's totality proof, as much of each as can
# be had without types: a set the *arms themselves* establish — an enum
# named by a payload-carrying arm, or the integers claimed by all-range
# arms — can be proven uncovered, and an arm below a capture or below its
# own case can be proven dead.
#
# Where the checker cannot tell, it declines to check (principle 4): any
# node kind it does not recognize passes through silently, a bare symbol is
# never checked — a payload-free case is simply a symbol (ADR 0022), and
# symbols are legal everywhere — and coverage refuses only what it can
# disprove, never merely what it cannot prove.
#
# Third, the inference-backed checks (ADR 0047), which read types off
# inference.pdx and refuse through refusals.pdx — never with a sentence of
# their own. Each fires only where every type it names is fully known;
# `unknown` anywhere is silence (ADR 0034 §4). The walk threads a scope of
# bindings the way inference's own scan does, and forgets — to unknown —
# any mutable name a nested body rebinds, since the body may or may not
# have run by the time the name is read again (principle 4: a type the
# checker cannot prove is not a type it may refuse on).
#
# Every refusal is reported at once (the ruling of 2026-09-24): the walk
# threads a list of what it found — `found`, in and out of every check —
# and the closure refuses once at the end with the whole report, in
# source order, each file in dependency order. Nothing panics mid-walk.

require_relative "paths"
require_relative "refusals"

# What the walk carries into every node: the program's enum declarations,
# and — for the inference-backed checks (ADR 0047) — the types it knows.
# `globals` holds the program-wide names (struct and enum types, top-level
# def returns); `locals` the bindings of the body being walked. A def body
# starts its locals fresh, since a def cannot see the locals around it,
# while a block keeps them. Both lists are [name, type] pairs in the shape
# inference.pdx reads.
struct Scope
  arities
  contracts
  enums
  file
  globals
  judging
  locals
  shapes
  sharpened
  source
  traits
end

# One file of a resolved closure (#94): what to check it with.
struct Resolved
  imports
  named
  nodes
  path
  source
end

# What one file declares for the files that require it (#94): the same
# six lists a Scope carries program-wide, without the locals — a required
# file's locals stay unknown to its requirer on purpose (#95).
struct Declarations
  arities
  constants
  contracts
  enums
  globals
  shapes
  traits
end

# Every enum declaration in the program, as [name, labels] pairs — all of
# them, not just the textually-earlier ones: a build reads the whole file
# before judging any line of it.
def declared_cases(nodes)
  mutable declarations = []
  nodes.each do |node|
    declarations += declarations_in(node)
  end
  declarations
end

def declarations_in(node)
  case node
  in EnumDefNode
    mutable found = []
    node.cases.each do |declared|
      # The third element is the owning enum: membership needs only the
      # case, coverage (ADR 0035) needs the set it belongs to.
      found << [declared.name, declared.labels, node.name]
    end
    found
  in ModuleDefNode(body:) then declared_cases(body)
  in StructDefNode(nested:) then declared_cases(nested)
  else
    []
  end
end

# The one-file entry point: refuse with everything found, or stay silent.
def check_program(nodes, source)
  report(check_program_with(nodes, source, nil, empty_declarations, []))
end

# One file, with what its requires declare in view (#94): its own
# declarations first, so a name declared on both sides resolves to its own.
# Answers what it found, in source order.
def check_program_with(nodes, source, file, imports, sharpened)
  own = declarations_of(nodes)
  whole = merge_declarations(own, imports)
  # A bare name is judged (#98) only where every name the file can see is
  # in view: a require the walk could not resolve may declare anything.
  judging = nodes.none? { computed_require?(it) }
  scope = Scope.new(arities: whole.arities, contracts: whole.contracts, enums: whole.enums, file: file, globals: whole.globals, judging: judging, locals: [], shapes: whole.shapes, sharpened: sharpened, source: source.lines, traits: whole.traits)
  found = check_annotations(nodes, source, scope, [])
  walked = check_redefinitions(nodes, "", scope, imported_names(imports), found)
  in_source_order(check_body(nodes, scope, walked.last))
end

# Refusals in the order the source has them: by line, with the walk's own
# order breaking ties and standing in where a node carries no line. One
# integer key per entry, since the sort need not be stable.
def in_source_order(found)
  mutable keyed = []
  found.each_with_index do |entry, index|
    location = type_at(entry, 1)
    line = if location.nil? then 0 else location.first end
    keyed << [line * 100000 + index, entry]
  end
  keyed.sort_by { it.first }.map { type_at(it, 1) }
end

# — the whole-program door (#94, ADR 0049) —
#
# A program is an entry file and everything `require_relative` pulls in,
# transitively, resolved as the runtime resolves it (paths.pdx). Each file
# is checked once, in dependency order, with the declarations of its
# transitive requires in view; a required file's locals never cross; a
# computed require path is an edge the walk declines; a cycle finds the
# file it came from still in progress and takes nothing from it, which is
# what the runtime's load-once does too.

# Check the closure of `path`. `checked` is the memo of files already
# checked in this process — the spec harness checks a hundred specs that
# share one helper — as [key, declarations] pairs, `nil` while a file is
# in progress; the updated memo comes back.
def check_closure(path, checked)
  check_closure_with(path, checked, false)
end

# Run mode (ADR 0049 §4): the closure is a closed world, so the entry
# file's own defs have every caller in view, and a parameter every caller
# agrees on is read at that type inside its body (ADR 0048 ruling 4).
# Only the entry's defs: a required file is a library by nature, and its
# defs may have callers outside this closure.
def check_program_closure(path, checked)
  check_closure_with(path, checked, true)
end

def check_closure_with(path, mutable checked, sharpen)
  resolution = resolve_closure(path, checked, [], false)
  checked = value_at_checked(resolution, 0)
  files = value_at_checked(resolution, 1)
  entry = files.last
  sharpened = if sharpen && entry.some? then sharpen_parameters(entry, files) else [] end
  mutable found = []
  files.each do |file|
    own = if entry.some? && file.path == entry.path then sharpened else [] end
    found += check_program_with(file.nodes, file.source, file.named, file.imports, own)
  end
  report(found)
  checked
end

# Resolve a closure into the files to check, children before parents, and
# what each is checked with. `checked` is the memo of files already
# checked in this process — the spec harness checks a hundred specs that
# share one helper — as [key, exports] pairs, `nil` while a file is in
# progress. Answers [checked, files]. `required` says whether some file
# requires this one — then the program spans more than one file and a
# refusal here names its file (ADR 0049 §5); an entry names its file only
# when it requires something itself.
def resolve_closure(path, mutable checked, mutable files, required)
  key = canonical_path(path)
  return [checked, files] if checked.any? { it[0] == key }
  source = read_file(path) or panic "check: cannot read #{path}"
  nodes = parse_program(lex(source))
  checked = [[key, nil]] + checked
  requires = required_files(nodes, path)
  mutable imports = empty_declarations
  requires.each do |name|
    resolution = resolve_closure(name, checked, files, true)
    checked = value_at_checked(resolution, 0)
    files = value_at_checked(resolution, 1)
    found = checked.find { it[0] == canonical_path(name) }
    declared = if found.nil? then nil else value_at_checked(found, 1) end
    imports = merge_declarations(imports, declared) unless declared.nil?
  end
  named = if required || !requires.empty? then path else nil end
  files << Resolved.new(imports: imports, named: named, nodes: nodes, path: path, source: source)
  exported = merge_declarations(declarations_of(nodes), imports)
  [[[key, exported]] + checked.reject { it[0] == key }, files]
end

# The files a program's top-level `require_relative "name"` lines name,
# in order. Only a literal string resolves; anything else is declined.
def required_files(nodes, path)
  mutable found = []
  nodes.each do |node|
    next unless node in CallNode
    next unless node.name == "require_relative"
    next unless node.arguments.length == 1
    argument = node.arguments.first
    next unless argument in StringNode
    found << required_path_from(path, argument.value)
  end
  found
end

# A `require_relative` whose path is not a literal string.
def computed_require?(node)
  return false unless node in CallNode
  return false unless node.name == "require_relative"
  return true unless node.arguments.length == 1
  !(node.arguments.first in StringNode)
end

def declarations_of(nodes)
  Declarations.new(arities: declared_arities(nodes), constants: declared_constants(nodes, ""), contracts: declared_contracts(nodes), enums: declared_cases(nodes), globals: declared_globals(nodes), shapes: declared_shapes(nodes), traits: trait_declarations_in(nodes))
end

def empty_declarations = Declarations.new(arities: [], constants: [], contracts: [], enums: [], globals: [], shapes: [], traits: [])

def merge_declarations(first, second)
  Declarations.new(arities: first.arities + second.arities, constants: first.constants + second.constants, contracts: first.contracts + second.contracts, enums: first.enums + second.enums, globals: first.globals + second.globals, shapes: first.shapes + second.shapes, traits: first.traits + second.traits)
end

# Where a refusal points (#89): the node's line and that line of the
# source, for the renderer to print beneath the sentence — or nil, and no
# location, for a node built by a desugar with no token in hand.
def locate(node, scope)
  line = line_of(node)
  return nil if line.nil?
  text = value_at_checked(scope.source, line - 1) or ""
  [line, text.chomp, scope.file]
end

# The node kinds a refusal can point at carry their line (the ruling of
# 2026-09-24: the first token that begins the node); the rest do not yet.
def line_of(node)
  case node
  in IfNode | WhileNode | LogicalNode | BinaryNode | UnaryNode | CallNode | MethodCallNode | SafeMethodCallNode | DefNode | CaseInNode | EnumCaseNode | EnumCasePatternNode | IndexNode | IdentifierNode | StructDefNode | EnumDefNode | TraitDefNode | AliasNode | AssignmentNode
    node.line
  else
    nil
  end
end

# Every top-level def's parameters with their contracts (ADR 0048), as
# [name, parameters] where each parameter is [name, keyword?, entry] and
# an entry is a default's type or ["needs", demands]. A name defined twice
# is left out, as for arities.
def declared_contracts(nodes)
  defs = nodes.select { it in DefNode }
  types = scan_program(nodes)
  mutable contracts = []
  defs.each do |node|
    next if defs.select { it.name == node.name }.length > 1
    parameters = node.parameters.map { [it.name, (it in KeywordParameterNode), parameter_entry(it, node.body, types)] }
    contracts << [node.name, parameters]
  end
  contracts
end

# Every top-level def's positional arity, as [name, required, total] —
# the seed's own count: parameters up to the first default are required,
# keyword parameters stand outside the count. A name defined twice is
# left out (a second def silently wins at runtime, #70's open question).
def declared_arities(nodes)
  defs = nodes.select { it in DefNode }
  mutable arities = []
  defs.each do |node|
    next if defs.select { it.name == node.name }.length > 1
    positional = node.parameters.reject { it in KeywordParameterNode }
    required = positional.select { required_parameter?(it) }.length
    arities << [node.name, required, positional.length]
  end
  arities
end

# A bare name, or a `mutable` one with no default, must be passed.
def required_parameter?(parameter)
  return true if parameter in IdentifierNode
  (parameter in AssignmentNode) && parameter.value.nil?
end

# Shape 5 — an annotation that lies (ADR 0041 §5; the words are ADR
# 0047's). A top-level def's `# -> Type` is read off the source the way
# the dump reads it and compared, as text, with the rendering of the
# return inference computed — the annotation grammar *is* the dump's
# rendering (ADR 0041 §4), so byte equality is the rule. Agreement and an
# unknown answer are both silence; only a known disagreement refuses.
def check_annotations(nodes, source, scope, mutable found)
  nodes.each do |node|
    next unless node in DefNode
    written = annotation_for(source, node.name)
    next if written.nil?
    computed = synthesize_name(node.name, scope.globals)
    next unless known?(computed)
    next if render_type(computed) == written
    found = noted(found, ["annotation", node.name, computed, written], locate(node, scope))
  end
  found
end

# Every struct's instance method set, as [name, methods] pairs: its
# fields, its defs (alias clones included, since they arrive as defs), the
# defs of each trait it includes, and the five every struct answers. A
# struct is left out where the tree cannot state its set whole — its name
# declared twice anywhere (a nested struct sharing a top-level one's), or
# an included trait not declared exactly once in this file, which may
# well live in a required one.
def declared_shapes(nodes)
  structs = struct_declarations_in(nodes)
  traits = trait_declarations_in(nodes)
  mutable shapes = []
  structs.each do |declaration|
    name = declaration.name
    next if structs.select { it.name == name }.length > 1
    methods = shape_methods(declaration, traits)
    shapes << [name, methods] unless methods.nil?
  end
  shapes
end

def shape_methods(declaration, traits)
  mutable methods = %w[failure? nil? some? to_s with] + declaration.fields
  methods += def_names(declaration.methods)
  declaration.includes.each do |trait_name|
    # The builtin trait (ADR 0054) adds the two derived methods; the four
    # orderings are operators, not names.
    if trait_name == "Comparable"
      methods += %w[between? clamp]
      next
    end
    matching = traits.select { it.name == trait_name }
    return nil unless matching.length == 1
    methods += def_names(matching.first.methods)
  end
  methods
end

def def_names(methods)
  mutable names = []
  methods.each do |method|
    names << method.name if method in DefNode
  end
  names
end

def struct_declarations_in(nodes)
  mutable found = []
  nodes.each do |node|
    if node in StructDefNode
      found << node
      found += struct_declarations_in(node.nested)
    elsif node in ModuleDefNode
      found += struct_declarations_in(node.body)
    end
  end
  found
end

def trait_declarations_in(nodes)
  mutable found = []
  nodes.each do |node|
    if node in TraitDefNode
      found << node
    elsif node in ModuleDefNode
      found += trait_declarations_in(node.body)
    elsif node in StructDefNode
      found += trait_declarations_in(node.nested)
    end
  end
  found
end

# The program-wide names, in the shape inference reads: struct and enum
# types first (their order never matters), then the top-level defs' return
# types in source order — a def that calls a later def reads that call as
# unknown, which is a decline, not a wrong answer.
def declared_globals(nodes)
  mutable globals = []
  nodes.each do |node|
    globals = register_struct(node, globals) if node in StructDefNode
    globals = [[node.name, ["enum", node.name]]] + globals if node in EnumDefNode
    # A module's name is a name a bare reference may use as a receiver
    # (`Stats.mean`); its type is nobody's, so its methods answer unknown.
    globals = [[module_name(node), ["module", module_name(node)]]] + globals if node in ModuleDefNode
  end
  nodes.each do |node|
    globals = [[node.name, synthesize_def_return(node, globals)]] + globals if node in DefNode
    # A top-level SCREAMING_CASE binding is a constant (ADR 0053): a def's
    # reach, so every def in the program reads it at its value's type.
    globals = [[node.name, synthesize(node.value, globals)]] + globals if constant_declaration?(node)
    # A top-level `alias new old` (ADR 0039) is a second name for the def,
    # answering what the def answers — found by the corpus, where a tour
    # fixture's alias read as a name nothing defined (#98).
    globals = [[node.new_name, synthesize_name(node.old_name, globals)]] + globals if node in AliasNode
  end
  globals
end

def constant_declaration?(node)
  return false unless node in AssignmentNode
  return false if node.value.nil?
  constant_name?(node.name)
end

# — one definition per name (#70, ADR 0052), and constants (#97, ADR 0053) —
#
# A top-level def, struct, enum, trait, alias, or constant is declared once
# across the program, and a builtin's name is never taken. A module body is
# walked with its names qualified, so `A::x` twice refuses and `module A`
# reopened does not. Answers [seen, found]: the names declared so far, and
# the refusals.
def check_redefinitions(nodes, home, scope, mutable seen, mutable found)
  nodes.each do |node|
    if node in ModuleDefNode
      walked = check_redefinitions(node.body, qualified_under(home, node.path.join("::")), scope, seen, found)
      seen = walked.first
      found = walked.last
      next
    end
    if (node in AssignmentNode) && home.empty? && lone_capital?(node.name)
      found = noted(found, ["lone_capital", node.name], locate(node, scope))
      next
    end
    name = declared_name(node)
    next if name.nil?
    qualified = qualified_under(home, name)
    # `seen` holds [name, kind] pairs, since a constant bound again says
    # "bound once" and a constant named after a def says "already defined"
    # — the seed's two sentences, in the seed's order.
    if node in AssignmentNode
      if node.rebindable
        found = noted(found, ["constant_mutable", name], locate(node, scope))
      elsif seen.any? { it[0] == qualified && it[1] == "constant" }
        found = noted(found, ["constant_rebound", name], locate(node, scope))
      elsif seen.any? { it[0] == qualified }
        found = noted(found, ["redefined", name], locate(node, scope))
      end
      seen = seen + [[qualified, "constant"]]
    else
      # `fields` is the one builtin with a designed refusal of its own
      # (ADR 0031), which the runtime keeps — the seed's list, not this
      # file's, says which names are never taken.
      if builtin_function?(name) && name != "fields"
        found = noted(found, ["builtin", name], locate(node, scope))
      elsif seen.any? { it[0] == qualified }
        found = noted(found, ["redefined", name], locate(node, scope))
      end
      seen = seen + [[qualified, "declaration"]]
    end
  end
  [seen, found]
end

# What a program's requires declare, as [name, kind] pairs for the walk
# above: every global, with the constants among them marked.
def imported_names(imports)
  imports.globals.map { [it.first, imports.constants.include?(it.first) ? "constant" : "declaration"] }
end

# The names a file's top-level and module-body constants take, qualified.
def declared_constants(nodes, home)
  mutable names = []
  nodes.each do |node|
    names += declared_constants(node.body, qualified_under(home, node.path.join("::"))) if node in ModuleDefNode
    names << qualified_under(home, node.name) if constant_declaration?(node)
  end
  names
end

# What a statement declares, or nil: a def, an alias's new name, a struct,
# an enum, a trait, or a SCREAMING_CASE binding.
def declared_name(node)
  case node
  in DefNode(name:) then name
  in AliasNode(new_name:) then new_name
  in StructDefNode(name:) then name
  in EnumDefNode(name:) then name
  in TraitDefNode(name:) then name
  in AssignmentNode(name:) then constant_name?(name) ? name : nil
  else nil
  end
end

def qualified_under(home, name) = home.empty? ? name : "#{home}::#{name}"

# A module's first path segment: `module A::B` is reached as `A`.
def module_name(node)
  first = node.path.first or ""
  first
end

# A body is walked in order, each statement seen with the bindings the
# statements above it left behind. Every walk function takes what has
# been found so far and answers it with its own findings appended.
def check_body(nodes, mutable scope, mutable found)
  nodes.each do |node|
    found = check_node(node, scope, found)
    scope = bind_statement(node, scope)
  end
  found
end

# The bindings a statement leaves for the statements after it — inference's
# bind_after, writing the locals and reading the globals beside them.
def bind_statement(node, scope)
  scope.with(locals: bind_after(node, scope.locals, scope.globals))
end

def bind_local(scope, name, type)
  scope.with(locals: [[name, type]] + scope.locals)
end

# A branch's scope: the pairs a condition proved, before the locals.
def with_proof(scope, pairs)
  scope.with(locals: pairs + scope.locals)
end

# The names a nested body rebinds are unknown wherever that body may have
# run — inference's forget_types, over the scope's locals.
def forget(scope, names)
  scope.with(locals: forget_types(scope.locals, names))
end

# What inference may read at this point: the body's own bindings, then
# the program's. The no-shadow rule keeps the two from ever overlapping.
def known_types(scope) = scope.locals + scope.globals

# A def cannot see the locals around it — its body starts from its
# parameters alone (a default lends its type, as in inference).
def def_scope(node, scope)
  agreed = scope.sharpened.find { it[0] == node.name }
  agreed_pairs = if agreed.nil? then [] else value_at_checked(agreed, 1) end
  mutable locals = []
  node.parameters.each do |parameter|
    sharpened = agreed_pairs.find { it[0] == parameter.name }
    type = if sharpened.nil? then parameter_type(parameter, scope.globals) else value_at_checked(sharpened, 1) end
    locals = [[parameter.name, type]] + locals
  end
  scope.with(locals: locals)
end

# A struct's or trait's method body: parameters only, and no top-level
# def returns either — a bare call inside a struct may reach the struct's
# own methods before the program's, which this increment does not model.
def method_scope(node, scope)
  type_names = scope.globals.select { (it[1] in ["type", *]) || (it[1] in ["enum", *]) }
  def_scope(node, scope.with(arities: [], contracts: [], globals: type_names, judging: false))
end

# A block keeps the locals around it and binds its parameters from the
# receiver's type, as inference does — an array lends its element, a hash
# its key then value, a range integers, anything else unknown.
def block_scope(node, receiver, scope)
  mutable bound = scope
  argument_types = node.arguments.map { synthesize(it, known_types(scope)) }
  node.block.parameters.each_with_index do |parameter, index|
    bound = bind_local(bound, parameter, block_parameter_type(receiver, index, node.name, argument_types))
  end
  bound
end

# The walk. Dispatch mirrors the evaluator's, but visits everything —
# bodies that would never run included — and checks only what it knows.
def check_node(node, scope, mutable found)
  case node
  in EnumCaseNode then check_construction(node, scope, found)
  in EnumCasePatternNode then check_case_pattern(node, scope, found)
  in IdentifierNode(name:) then check_defined(name, node, scope, found)
  in AssignmentNode(value:) then check_node(value, scope, found)
  in DefNode(parameters:, body:)
    # Defaults are read with the parameters bound — `def f(a, b = a)`.
    found = check_parameters(parameters, def_scope(node, scope), found)
    check_body(body, def_scope(node, scope), found)
  in StructDefNode(methods:, nested:, type_functions:)
    found = check_reserved(methods, %w[failure? new nil? some? with], "is reserved on structs", scope, found)
    found = check_reserved(type_functions, %w[failure? nil? some? with], "is reserved on structs", scope, found)
    found = check_methods(methods, scope, found)
    found = check_methods(type_functions, scope, found)
    check_body(nested, scope, found)
  in TraitDefNode(methods:)
    found = check_reserved(methods, %w[failure? new nil? some? with], "is reserved on structs, so a trait cannot carry it", scope, found)
    check_methods(methods, scope, found)
  # A module's bare names may reach its own defs by lexical scope (ADR
  # 0021), which the globals do not hold — so names are not judged inside.
  in ModuleDefNode(body:) then check_body(body, scope.with(judging: false), found)
  in WhileNode(condition:, body:)
    found = check_node(condition, scope, found)
    found = check_condition("while", node, scope, found)
    # The body may have run before the condition is read again, so the
    # names it rebinds are unknown throughout it too — and what the
    # condition proves is read over those, never over the first pass.
    forgotten = forget(scope, assigned_names_in_body(body))
    proof = narrowings(condition, known_types(forgotten))
    check_body(body, with_proof(forgotten, when_true(proof)), found)
  in TogetherNode(lines:) then check_together(lines, scope, found)
  in ReturnNode(value:)
    return found if value.nil?
    check_node(value, scope, found)
  in IfNode
    found = check_node(node.condition, scope, found)
    found = check_condition("if", node, scope, found)
    # Each branch sees what the condition proved on its side (ADR 0040 §3's
    # narrowing forms, in inference). `unless` parses as an if with no
    # then-side, so either body may be nil.
    proof = narrowings(node.condition, known_types(scope))
    found = check_body(node.then_body, with_proof(scope, when_true(proof)), found) unless node.then_body.nil?
    found = check_body(node.else_body, with_proof(scope, when_false(proof)), found) unless node.else_body.nil?
    found
  in CaseNode then check_case(node, scope, found)
  in CaseInNode then check_case_in(node, scope, found)
  in CallNode then check_call(node, scope, found)
  in MethodCallNode | SafeMethodCallNode then check_method_call(node, scope, found)
  in ArrayNode(elements:) then check_body(elements, scope, found)
  in HashNode(pairs:) then check_pairs(node.pairs, scope, found)
  in BinaryNode(left:, right:)
    found = check_node(left, scope, found)
    found = check_node(right, scope, found)
    check_operator(node, scope, found)
  in LogicalNode(left:, right:)
    found = check_node(left, scope, found)
    # The right side runs only where the left decided it: under the left's
    # proof for `&&`, its disproof for `||`.
    proof = narrowings(left, known_types(scope))
    right_side = if node.operator == "&&" then when_true(proof) else when_false(proof) end
    found = check_node(right, with_proof(scope, right_side), found)
    check_operands(node, scope, found)
  in UnaryNode(operand:)
    found = check_node(operand, scope, found)
    check_unary(node, scope, found)
  in IndexNode(receiver:, index:)
    found = check_node(receiver, scope, found)
    check_node(index, scope, found)
  in IndexUpdateNode(index: update_index, value: update_value)
    found = check_node(update_index, scope, found)
    check_node(update_value, scope, found)
  in SlotCompoundNode(index: compound_index, right: compound_right)
    found = check_node(compound_index, scope, found)
    check_node(compound_right, scope, found)
  in AppendNode(value:) then check_node(value, scope, found)
  in MatchAssertNode(subject:, pattern:)
    found = check_node(subject, scope, found)
    check_pattern(pattern, scope, found)
  in MatchTestNode(subject: test_subject, pattern: test_pattern)
    found = check_node(test_subject, scope, found)
    check_pattern(test_pattern, scope, found)
  in KeywordArgumentNode(value:) then check_node(value, scope, found)
  else
    found
  end
end

def check_parameters(parameters, scope, mutable found)
  parameters.each do |parameter|
    if parameter in KeywordParameterNode
      found = check_node(parameter.default, scope, found) unless parameter.default.nil?
    elsif (parameter in AssignmentNode) && parameter.value.some?
      found = check_node(parameter.value, scope, found)
    end
  end
  found
end

# A `together` block's lines run in order (ADR 0029), so a plain line's
# binding is in view for the lines below it, as in any body.
def check_together(lines, mutable scope, mutable found)
  lines.each do |line|
    found = if line in TaskLineNode
      check_node(line.value, scope, found)
    else
      check_node(line, scope, found)
    end
    scope = bind_statement(line, scope)
  end
  found
end

def check_case(node, scope, mutable found)
  found = check_node(node.subject, scope, found)
  node.branches.each do |branch|
    found = check_body(branch.values, scope, found)
    found = check_body(branch.body, scope, found)
  end
  found = check_body(node.else_body, scope, found) unless node.else_body.nil?
  found
end

def check_case_in(node, scope, mutable found)
  found = check_node(node.subject, scope, found)
  mutable nil_seen = false
  node.branches.each do |branch|
    found = check_pattern(branch.pattern, scope, found)
    arm = with_proof(scope, arm_bindings(node, branch, nil_seen, known_types(scope)))
    found = check_node(branch.guard, arm, found) unless branch.guard.nil?
    found = check_body(branch.body, arm, found)
    nil_seen = true if nil_arm?(branch)
  end
  found = check_body(node.else_body, scope, found) unless node.else_body.nil?
  found = check_unreachable_arms(node, scope, found)
  return found unless node.else_body.nil?
  found = check_maybe_coverage(node, scope, found)
  check_coverage(node, scope, found)
end

# ADR 0035's tripwire, fired by ADR 0047 once narrowing existed: over a
# subject inference knows to be a maybe, the unguarded arms must take nil
# — an `in nil` arm, or a bare capture — and the present case — a bare
# capture, or a pattern every present value matches: the plain type's
# name, or a struct pattern of it whose fields are all captures. The
# absent case is named first, being the one people forget.
def check_maybe_coverage(node, scope, mutable found)
  subject = synthesize(node.subject, known_types(scope))
  return found unless subject in ["maybe", *]
  return found unless known?(subject)
  patterns = unguarded_arms(node).map { it.pattern }
  found = noted(found, ["coverage", "nil"], locate(node, scope)) unless patterns.any? { covers_nil?(it) }
  inner = type_at(subject, 1)
  found = noted(found, ["coverage", "the present case"], locate(node, scope)) unless patterns.any? { covers_present?(it, inner) }
  found
end

def covers_nil?(pattern)
  case pattern
  in NilNode | IdentifierNode then true
  in AlternativePatternNode(options:) then options.any? { covers_nil?(it) }
  else
    false
  end
end

def covers_present?(pattern, inner)
  case pattern
  in IdentifierNode then true
  in AlternativePatternNode(options:) then options.any? { covers_present?(it, inner) }
  # `in Integer` and `in User(name:)` are one node: a name with fields. Bare,
  # it matches every value of the named type, builtin or struct; with
  # fields, every value whose named struct it is when each field is a
  # plain capture.
  in StructPatternNode(name:, fields:)
    return false unless render_type(inner) == name
    fields.all? { it[1] in IdentifierNode }
  else
    false
  end
end

def check_methods(methods, scope, mutable found)
  methods.each do |method|
    if method in DefNode
      found = check_parameters(method.parameters, method_scope(method, scope), found)
      found = check_body(method.body, method_scope(method, scope), found)
    else
      found = check_node(method, scope, found)
    end
  end
  found
end

def check_call(node, scope, mutable found)
  found = check_defined(node.name, node, scope, found)
  found = check_body(node.arguments, scope, found)
  found = check_arity(node, scope, found)
  found = check_contracts(node, scope, found)
  check_block(node, ["unknown"], scope, found)
end

# The sixth wording, the seed's own moved to build time (ADR 0034 §2,
# ADR 0047): a bare call to a top-level def with the wrong number of
# positional arguments. Keyword arguments stand outside the count, as in
# the seed; inside a struct's methods no bare call is judged (method_scope).
def check_arity(node, scope, found)
  arity = scope.arities.find { it[0] == node.name }
  return found if arity.nil?
  required = value_at_checked(arity, 1)
  total = value_at_checked(arity, 2)
  given = node.arguments.reject { it in KeywordArgumentNode }.length
  return found if given >= required && given <= total
  expected = if required == total then required.to_s else "#{required} to #{total}" end
  noted(found, ["arity", node.name, expected, given], locate(node, scope))
end

def check_method_call(node, scope, mutable found)
  found = check_node(node.receiver, scope, found)
  found = check_body(node.arguments, scope, found)
  receiver = synthesize(node.receiver, known_types(scope))
  found = check_maybe_method(node, receiver, scope, found) if node in MethodCallNode
  found = check_struct_method(node, receiver, scope, found) if node in MethodCallNode
  found = check_builtin_method(node, receiver, scope, found) if node in MethodCallNode
  check_block(node, receiver, scope, found)
end

# A block body may run many times or never, so — like a loop's — it is
# walked with the names it rebinds already forgotten.
def check_block(node, receiver, scope, found)
  block = node.block
  return found if block.nil?
  entered = block_scope(node, receiver, scope)
  check_body(block.body, forget(entered, assigned_names_in_body(block.body)), found)
end

def check_pairs(pairs, scope, mutable found)
  pairs.each do |pair|
    found = check_node(pair.key, scope, found)
    found = check_node(pair.value, scope, found)
  end
  found
end

# Patterns hold sub-patterns and, in two places, expressions.
def check_pattern(pattern, scope, mutable found)
  case pattern
  in EnumCasePatternNode then check_case_pattern(pattern, scope, found)
  in AlternativePatternNode(options:)
    options.each do |option|
      found = check_pattern(option, scope, found)
    end
    found
  in ArrayPatternNode(elements:)
    elements.each do |element|
      found = check_pattern(element, scope, found)
    end
    found
  in StructPatternNode(fields:)
    fields.each do |field|
      found = check_pattern(field[1], scope, found)
    end
    found
  else
    found
  end
end

# — the checks themselves —

# Family three (#86): the reserved names, one list in one place. The seed
# refuses these at parse — its refusals stay, as the runtime preview — but
# the compiler's parser used to carry five separate copies of this list,
# which is how `failure?` missed every one of them for three weeks and how
# instance defs missed the check entirely. `new` is reserved on instances
# and definable as a type function (ADR 0031), which is why the two calls
# pass different lists. Aliases need no case of their own: a struct or
# trait alias desugars at parse into a clone of the def it points at, so
# the clone walks through here like any def.
def check_reserved(methods, names, wording, scope, mutable found)
  methods.each do |method|
    next unless method in DefNode
    found = noted(found, ["sentence", "#{method.name} #{wording}"], locate(method, scope)) if names.include?(method.name)
  end
  found
end

def cases_named(enums, name)
  enums.select { it[0] == name }
end

# `:paid(on: x)` — the seed's three runtime refusals, made at build time
# with the same words (ADR 0034 §2). The seed reaches them only when the
# line runs; this reaches them because the line was written.
def check_construction(node, scope, mutable found)
  declarations = cases_named(scope.enums, node.name)
  return noted(found, ["sentence", "no enum declares a case :#{node.name}"], locate(node, scope)) if declarations.empty?
  labels = value_at_checked(declarations.first, 1)
  declarations.each do |declaration|
    return noted(found, ["sentence", "two enums declare :#{node.name} with different payloads — the seed cannot tell them apart"], locate(node, scope)) unless value_at_checked(declaration, 1) == labels
  end
  given = node.payload.map { it.label }
  unless given == labels
    wanted = labels.map { it + ":" }.join(", ")
    return noted(found, ["sentence", "`:#{node.name}` takes (#{wanted})"], locate(node, scope))
  end
  node.payload.each do |argument|
    found = check_node(argument.value, scope, found)
  end
  found
end

# `in :paid(on:)` naming an undeclared case — the seed says nothing and the
# pattern silently never matches, which is how a typo becomes a branch that
# cannot fire. The first refusal with no oracle behind it (ADR 0034 §3).
def check_case_pattern(pattern, scope, mutable found)
  if cases_named(scope.enums, pattern.name).empty?
    found = noted(found, ["sentence", "in :#{pattern.name} can never match — no enum declares a case :#{pattern.name}"], locate(pattern, scope))
  end
  pattern.payload.each do |entry|
    found = check_pattern(entry[1], scope, found)
  end
  found
end

# — sharpening (ADR 0048 ruling 4, ADR 0049 §4) —
#
# In run mode every caller of the entry file's defs is in view. A
# parameter every caller passes the same fully known type is read at that
# type inside its body, and the ordinary shapes reach a place they could
# not see. Callers that disagree, a parameter no one passes, an unknown
# anywhere, a def defined twice, a call with the wrong count — each leaves
# the parameter at its default's type or unknown, exactly as today.

# [def_name, [[parameter, type]]] for the entry's top-level defs.
def sharpen_parameters(entry, files)
  mutable calls = []
  files.each do |file|
    globals = merge_declarations(declarations_of(file.nodes), file.imports).globals
    calls = calls_in(file.nodes, [], globals, calls)
  end
  defs = entry.nodes.select { it in DefNode }
  entry_declarations = merge_declarations(declarations_of(entry.nodes), entry.imports)
  mutable sharpened = []
  defs.each do |node|
    next if defs.select { it.name == node.name }.length > 1
    pairs = agreed_parameters(node, calls.select { it[0] == node.name }, entry_declarations)
    sharpened << [node.name, pairs] unless pairs.empty?
  end
  sharpened
end

# The parameters of one def every caller agrees on. A caller that omits an
# optional parameter passes its default; a caller with the wrong count, or
# one whose argument fails the parameter's contract, is a refusal at its
# own call site — the better sentence, where the mistake was made — and
# disqualifies the parameter here, so the body never refuses first with
# a lesser one.
def agreed_parameters(node, calls, declarations)
  return [] if calls.empty?
  globals = declarations.globals
  positional = node.parameters.reject { it in KeywordParameterNode }
  mutable pairs = []
  node.parameters.each do |parameter|
    contract = parameter_entry(parameter, node.body, globals)
    mutable seen = []
    mutable disqualified = false
    calls.each do |call|
      passed = argument_passed(parameter, positional.index(parameter), call, globals)
      disqualified = true if passed.nil? || !satisfies?(passed, contract, declarations)
      seen << passed unless passed.nil? || seen.include?(passed)
    end
    next if disqualified || seen.length != 1
    agreed = seen.first or ["unknown"]
    next unless known?(agreed)
    pairs << [parameter.name, agreed]
  end
  pairs
end

# Whether an argument's type answers a parameter's contract — the same
# question the call-site check asks (check_argument), asked ahead of it.
# A type whose method set is not stated whole cannot fail here.
def satisfies?(type, contract, declarations)
  return true unless contract in ["needs", *]
  methods = argument_methods(type, declarations)
  return true if methods.nil?
  type_at(contract, 1).all? { answers_demand?(type, methods, it) }
end

# What one call passes for one parameter: by position, by label for a
# keyword parameter, the default's type when omitted — or nil where the
# call cannot be paired with it.
def argument_passed(parameter, position, call, globals)
  positional_types = value_at_checked(call, 1)
  keyword_types = value_at_checked(call, 2)
  if parameter in KeywordParameterNode
    given = keyword_types.find { it[0] == parameter.name }
    return value_at_checked(given, 1) unless given.nil?
    return parameter_type(parameter, globals) if parameter.default.some?
    return nil
  end
  return nil if position.nil?
  return value_at_checked(positional_types, position) if position < positional_types.length
  return parameter_type(parameter, globals) if (parameter in AssignmentNode) && parameter.value.some?
  nil
end

# Every bare call in a body with its argument types — [name, positional
# types, [[label, type]]] — read with the scoping the checks use: a def
# body from its parameters, a loop or block body with its rebindings
# forgotten, a nested body's captures unknown. Struct, trait, and module
# bodies are skipped, since a bare call inside them may reach their own
# defs first. Narrowing is not applied — a maybe stays a maybe here,
# which can only make callers disagree.
def calls_in(nodes, mutable locals, globals, mutable found)
  nodes.each do |node|
    found = calls_in_node(node, locals, globals, found)
    locals = bind_after(node, locals, globals)
  end
  found
end

def calls_in_node(node, locals, globals, mutable found)
  return found if node.nil?
  case node
  in DefNode
    mutable inner = []
    node.parameters.each do |parameter|
      inner = [[parameter.name, parameter_type(parameter, globals)]] + inner
    end
    calls_in(node.body, inner, globals, found)
  in StructDefNode | TraitDefNode | ModuleDefNode then found
  in WhileNode(condition:, body:)
    found = calls_in_node(condition, locals, globals, found)
    calls_in(body, forget_types(locals, assigned_names_in_body(body)), globals, found)
  in IfNode(condition:, then_body:, else_body:)
    found = calls_in_node(condition, locals, globals, found)
    found = calls_in(then_body or [], locals, globals, found)
    calls_in(else_body or [], locals, globals, found)
  in CaseNode(subject:, branches:, else_body:)
    found = calls_in_node(subject, locals, globals, found)
    branches.each do |branch|
      found = calls_in(branch.values, locals, globals, found)
      found = calls_in(branch.body, locals, globals, found)
    end
    calls_in(else_body or [], locals, globals, found)
  in CaseInNode(subject:, branches:, else_body:)
    found = calls_in_node(subject, locals, globals, found)
    branches.each do |branch|
      captured = bind_unknowns(locals, pattern_names(branch.pattern))
      found = calls_in_node(branch.guard, captured, globals, found) unless branch.guard.nil?
      found = calls_in(branch.body, captured, globals, found)
    end
    calls_in(else_body or [], locals, globals, found)
  in CallNode(name:, arguments:, block:)
    mutable positional = []
    mutable keywords = []
    arguments.each do |argument|
      found = calls_in_node(argument, locals, globals, found)
      if argument in KeywordArgumentNode
        keywords << [argument.label, synthesize(argument.value, locals + globals)]
      else
        positional << synthesize(argument, locals + globals)
      end
    end
    found << [name, positional, keywords]
    calls_in_block(node, ["unknown"], locals, globals, found)
  in MethodCallNode | SafeMethodCallNode
    found = calls_in_node(node.receiver, locals, globals, found)
    node.arguments.each do |argument|
      found = calls_in_node(argument, locals, globals, found)
    end
    calls_in_block(node, synthesize(node.receiver, locals + globals), locals, globals, found)
  else
    children_of(node).each do |child|
      found = calls_in_node(child, locals, globals, found)
    end
    found
  end
end

def calls_in_block(node, receiver, locals, globals, found)
  block = node.block
  return found if block.nil?
  argument_types = node.arguments.map { synthesize(it, locals + globals) }
  mutable inner = locals
  block.parameters.each_with_index do |parameter, index|
    inner = [[parameter, block_parameter_type(receiver, index, node.name, argument_types)]] + inner
  end
  calls_in(block.body, forget_types(inner, assigned_names_in_body(block.body)), globals, found)
end

# — the inference-backed checks (ADR 0047) —
#
# The seventh wording (#98, ratified 2026-09-24): a bare name that no
# local, def, builtin, type, enum, or module answers. Provable only where
# every name the file can see is in view — never inside a struct's or
# module's body, whose own defs a bare name reaches first, and never in a
# file with a require the walk could not resolve.
def check_defined(name, node, scope, found)
  return found unless scope.judging
  return found if scope.locals.any? { it[0] == name }
  return found if scope.globals.any? { it[0] == name }
  return found if builtin_function?(name)
  noted(found, ["undefined", name], locate(node, scope))
end

# The seed's own list (`builtin_name`): the bare functions every program
# can call without defining — and `fields`, which outside `def self.new`
# has a designed refusal of its own (ADR 0031) that the runtime keeps.
def builtin_function?(name) = %w[argv failure fields inspect p panic puts read_file require_relative some write_file].include?(name)

# Each reads a type off inference and refuses through the renderer, and
# each fires only where the type is fully known: an unknown anywhere in it
# is a decline. The seed says the same sentences at runtime, with the
# value where these say the type.

# Shape 1 — a condition that is not a boolean, Ruby's truthiness reflex.
# A boolean passes; an unknown declines; anything else refuses, and a
# maybe alone carries the one honest rewrite.
def check_condition(construct, node, scope, found)
  condition = node.condition
  type = synthesize(condition, known_types(scope))
  return found if type == ["boolean"]
  return found unless known?(type)
  noted(found, ["condition", construct, type, spell_node(condition)], locate(node, scope))
end

# The logical operators' operands. `&&` takes booleans on both sides. `||`
# takes any left — it is the or-guard on a maybe, and a plain value on the
# left is the dead guard ADR 0040 §3 deliberately left unrefused — but once
# the left is a boolean the right must be one too.
def check_operands(node, scope, mutable found)
  types = known_types(scope)
  left = synthesize(node.left, types)
  right = synthesize(node.right, types)
  if node.operator == "&&"
    found = noted(found, ["operand", "&&", left], locate(node, scope)) if known?(left) && left != ["boolean"]
    found = noted(found, ["operand", "&&", right], locate(node, scope)) if known?(right) && right != ["boolean"]
  end
  return found unless node.operator == "||"
  return found unless left == ["boolean"]
  found = noted(found, ["operand", "||", right], locate(node, scope)) if known?(right) && right != ["boolean"]
  found
end

# ADR 0048's call-site refusal — a call handing a def something its body
# cannot use. The argument's type, the struct's declared method set, and
# the body's demand all come from the file in hand, so this is provable
# per file where caller flow (#94) is not. Struct arguments only, until
# the method table (#88) says what a builtin answers. Each parameter is
# paired with its argument by position, or by label for a keyword one.
def check_contracts(node, scope, mutable found)
  contract = scope.contracts.find { it[0] == node.name }
  return found if contract.nil?
  positional = node.arguments.reject { it in KeywordArgumentNode }
  mutable position = 0
  value_at_checked(contract, 1).each do |parameter|
    keyword = value_at_checked(parameter, 1)
    argument = if keyword then keyword_argument(node, parameter[0]) else positional[position] end
    position += 1 unless keyword
    next if argument.nil?
    found = check_argument(node, argument, value_at_checked(parameter, 2), scope, found)
  end
  found
end

def keyword_argument(node, label)
  found = node.arguments.find { (it in KeywordArgumentNode) && it.label == label }
  return nil if found.nil?
  found.value
end

def check_argument(call, argument, entry, scope, found)
  def_name = call.name
  return found unless entry in ["needs", *]
  demands = type_at(entry, 1)
  type = synthesize(argument, known_types(scope))
  methods = argument_methods(type, scope)
  return found if methods.nil?
  missing = demands.reject { answers_demand?(type, methods, it) }
  return found if missing.empty?
  spelling = spell_node(argument)
  return found if spelling.nil?
  noted(found, ["contract", spelling, type, def_name, wanted_by(demands, missing, scope)], locate(call, scope))
end

# The method set an argument's type states whole: a declared struct's
# (declared_shapes), or a builtin's (the table, #88). Nil for anything
# else — a maybe, an unknown, a struct declared elsewhere.
def argument_methods(type, scope)
  return nil unless known?(type)
  if type in ["struct", *]
    shape = scope.shapes.find { it[0] == type_at(type, 1) }
    return nil if shape.nil?
    return value_at_checked(shape, 1)
  end
  builtin_methods(type)
end

# A dotted demand is answered by the method set; `==` and `!=` by every
# value; an index by a string, array, or hash; any other operator is a
# builtin's to decide with its right operand, so a builtin is taken to
# answer it, and a struct — which has no operators — is not.
def answers_demand?(type, methods, demand)
  return methods.include?(demand.slice(1, demand.length - 1)) if demand.start_with?(".")
  return true if demand == "==" || demand == "!="
  return (type == ["string"]) || (type in ["array", *]) || (type in ["hash", *]) if demand == "[]"
  !(type in ["struct", *])
end

# What the sentence names (ADR 0048 §2): the trait whose method set is
# exactly the whole contract, else only the demands the argument lacks —
# the whole contract is in the dump for anyone who wants it.
def wanted_by(demands, missing, scope)
  scope.traits.each do |declared|
    names = def_names(declared.methods).map { "." + it }
    return ["trait", declared.name] if same_set?(names, demands)
  end
  ["demands", missing]
end

def same_set?(left, right)
  return false unless left.length == right.length
  left.all? { right.include?(it) }
end

# Shape 3 — a maybe used as plain: ADR 0005's static half. At runtime a
# present value answers any method and only the absent path fails; here
# the type says the absent path exists, so anything but the predicates
# and `to_s` refuses until one of the narrowing forms has handled nil.
# `&.` is the other answer and is never this node. The receiver must be
# spellable, since the hint is written from it.
def check_maybe_method(node, receiver, scope, found)
  return found unless receiver in ["maybe", *]
  return found unless known?(receiver)
  return found if %w[failure? nil? some? to_s].include?(node.name)
  spelling = spell_node(node.receiver)
  return found if spelling.nil?
  noted(found, ["unhandled_maybe", spelling, receiver, node.name], locate(node, scope))
end

# Shape 2 for builtin receivers (#88): the seed's own answers, tabled in
# inference.pdx from its behavior. A fully known builtin type whose table
# lacks the name refuses; anything without a table declines.
def check_builtin_method(node, receiver, scope, found)
  return found unless known?(receiver)
  methods = builtin_methods(receiver)
  return found if methods.nil?
  return found if methods.include?(node.name)
  # A false alias keeps the seed's own refusal, moved earlier (ADR 0034 §2).
  survivor = alias_survivor(node.name)
  return noted(found, ["alias", node.name, survivor], locate(node, scope)) unless survivor.nil?
  spelling = spell_node(node.receiver)
  return found if spelling.nil?
  noted(found, ["no_method", spelling, receiver, node.name], locate(node, scope))
end

# Shape 2 — a method the receiver's type does not have, for struct
# receivers: the one receiver kind whose method set a declaration states
# completely (declared_shapes). The receiver must be spellable — no
# spelling, no sentence, so a computed receiver declines.
def check_struct_method(node, receiver, scope, found)
  return found unless receiver in ["struct", *]
  shape = scope.shapes.find { it[0] == type_at(receiver, 1) }
  return found if shape.nil?
  return found if value_at_checked(shape, 1).include?(node.name)
  spelling = spell_node(node.receiver)
  return found if spelling.nil?
  noted(found, ["no_method", spelling, receiver, node.name], locate(node, scope))
end

# Shape 4 — an operator on operands it cannot take. The legal pairs are
# the seed's own match arms, read as types: numbers with numbers for the
# arithmetic and ordering operators, string with string and array with
# array for `+`, string or array times an integer, and anything at all for
# `==` and `!=`. Both operands must be plain builtin values for the
# refusal to fire — a maybe is transparent at runtime (some(x) is x) and a
# struct or enum is not this shape's to judge — so everything else
# declines.
def check_operator(node, scope, found)
  types = known_types(scope)
  left = synthesize(node.left, types)
  right = synthesize(node.right, types)
  return found unless plain_value?(left) && plain_value?(right)
  return found if operator_takes?(node.operator, left, right)
  noted(found, ["operator", node.operator, left, right], locate(node, scope))
end

def operator_takes?(operator, left, right)
  case operator
  when "==", "!=" then true
  # Numbers and strings order (ADR 0054); a struct declines here, since its
  # `<=>` is a call the shape table answers for.
  when "<", "<=", ">", ">=", "<=>"
    return true if numeric?(left) && numeric?(right)
    return true if left == ["string"] && right == ["string"]
    # Arrays order element by element, under `<=>` alone.
    operator == "<=>" && (left in ["array", *]) && (right in ["array", *])
  when "+"
    return true if numeric?(left) && numeric?(right)
    return true if left == ["string"] && right == ["string"]
    (left in ["array", *]) && (right in ["array", *])
  when "*"
    return true if numeric?(left) && numeric?(right)
    return true if left == ["string"] && right == ["integer"]
    (left in ["array", *]) && right == ["integer"]
  when "-", "/", "%", "**" then numeric?(left) && numeric?(right)
  else
    # An operator this table does not know is not one it may refuse.
    true
  end
end

# `!` takes a boolean and `-` a number; the seed refuses the rest.
def check_unary(node, scope, found)
  operand = synthesize(node.operand, known_types(scope))
  return found unless plain_value?(operand)
  return found if node.operator == "!" && operand == ["boolean"]
  return found if node.operator == "-" && numeric?(operand)
  return found unless node.operator == "!" || node.operator == "-"
  noted(found, ["unary", node.operator, operand], locate(node, scope))
end

# A fully known builtin value type — never a maybe, struct, or enum.
def plain_value?(type)
  return false unless known?(type)
  case type
  in ["maybe", *] then false
  in ["struct", *] then false
  in ["enum", *] then false
  else
    true
  end
end

# Fully known: no unknown at any depth. A refusal never names a type it
# would have to render as Unknown.
def known?(type)
  case type
  in ["unknown"] then false
  in ["array", element] then known?(element)
  in ["hash", key, entry] then known?(key) && known?(entry)
  in ["maybe", inner] then known?(inner)
  else
    true
  end
end

# — coverage and reachability (ADR 0035) —
#
# The checker has no types yet, so it refuses only where it can *prove*
# non-coverage over a set the arms themselves establish, and stays silent
# where it merely cannot prove coverage (ADR 0035 §1). Inference widens
# where these apply; it does not gate whether they exist.

# Guarded arms are outside the arithmetic in both directions (ADR 0035 §4):
# they cover nothing, because the compiler cannot prove an `if`, and they
# are never called unreachable, because the guard may be the reason they
# are not.
def unguarded_arms(node)
  node.branches.select { it.guard.nil? }
end

# ADR 0013 §3. Two shapes need no types: everything below a bare capture,
# and a case already matched whole by an arm above.
def check_unreachable_arms(node, scope, mutable found)
  mutable seen_capture = false
  mutable seen_cases = []
  unguarded_arms(node).each do |branch|
    pattern = branch.pattern
    found = noted(found, ["sentence", "this arm can never match — the capture above binds every subject"], locate(node, scope)) if seen_capture
    name = whole_case_name(pattern)
    unless name.nil?
      found = noted(found, ["sentence", "in :#{name} can never match — an arm above already matches :#{name}"], locate(node, scope)) if seen_cases.include?(name)
      seen_cases << name
    end
    seen_capture = true if pattern in IdentifierNode
  end
  found
end

# The case an arm matches *every* instance of — so a later arm naming it is
# dead. A payload pattern qualifies only when every entry is a plain
# capture; `in :paid(on: 1)` leaves the other payloads to later arms.
def whole_case_name(pattern)
  return pattern.value if pattern in SymbolNode
  return nil unless pattern in EnumCasePatternNode
  return nil unless pattern.payload.all? { it[1] in IdentifierNode }
  pattern.name
end

def check_coverage(node, scope, mutable found)
  arms = unguarded_arms(node)
  return found if arms.empty?
  found = check_enum_coverage(node, arms, scope, found)
  check_range_coverage(node, arms, scope, found)
end

# An enum is established by a payload-carrying arm and by nothing else
# (ADR 0035 §2): a payload-free case is simply a symbol, and symbols are
# legal everywhere, so plain-symbol arms are never second-guessed.
def check_enum_coverage(node, arms, scope, found)
  enums = scope.enums
  anchor = arms.find { it.pattern in EnumCasePatternNode }
  return found if anchor.nil?
  owner = enum_owning(enums, anchor.pattern.name)
  return found if owner.nil?
  mutable covered = []
  arms.each do |branch|
    name = arm_case_name(branch.pattern)
    return found if name.nil?
    covered << name
  end
  missing = cases_of(enums, owner).reject { covered.include?(it) }
  return found if missing.empty?
  named = missing.map { ":" + it }.join(", ")
  noted(found, ["sentence", "case/in does not cover #{named} — add the arm, or an else"], locate(node, scope))
end

def arm_case_name(pattern)
  return pattern.value if pattern in SymbolNode
  return pattern.name if pattern in EnumCasePatternNode
  nil
end

def enum_owning(enums, case_name)
  found = enums.find { it[0] == case_name }
  return nil if found.nil?
  value_at_checked(found, 2)
end

def cases_of(enums, enum_name)
  enums.select { value_at_checked(it, 2) == enum_name }.map { it[0] }
end

# ADR 0019's algorithm: range arms claim the integers, so a beginless first
# and an endless last with no gaps between is the proof. Overlap is legal,
# so coverage runs forward as a high-water mark rather than arm to arm.
def check_range_coverage(node, arms, scope, found)
  mutable bounds = []
  arms.each do |branch|
    pair = range_bounds(branch.pattern)
    return found if pair.nil?
    bounds << pair
  end
  return found if bounds.empty?
  beginless = bounds.select { low_of(it).nil? }
  if beginless.empty?
    lowest = bounds.map { low_of(it) }.min
    return noted(found, ["sentence", "case/in leaves ..#{lowest - 1} uncovered — add the arm, or an else"], locate(node, scope))
  end
  # An arm open at both ends is the whole line, and needs no walk.
  return found unless beginless.none? { high_of(it).nil? }
  mutable covered_to = beginless.map { high_of(it) }.max
  bounded = bounds.reject { low_of(it).nil? }
  bounded.sort_by { low_of(it) }.each do |pair|
    low = low_of(pair)
    if low > covered_to + 1
      return noted(found, ["sentence", "case/in leaves #{covered_to + 1}..#{low - 1} uncovered — add the arm, or an else"], locate(node, scope))
    end
    high = high_of(pair)
    return found if high.nil?
    covered_to = high if high > covered_to
  end
  noted(found, ["sentence", "case/in leaves #{covered_to + 1}.. uncovered — add the arm, or an else"], locate(node, scope))
end

# A bound is absent for a beginless or endless arm, and host indexing lifts
# a stored nil into a present-but-absent maybe — so both ends are read the
# raw way, like every other positional read in this file.
def low_of(pair)
  value_at_checked(pair, 0)
end

def high_of(pair)
  value_at_checked(pair, 1)
end

# A range arm's closed bounds, or nil where a bound is anything but an
# integer literal — a computed end is a decline, not a refusal.
def range_bounds(pattern)
  return nil unless pattern in RangeNode
  low = literal_integer(pattern.start)
  high = literal_integer(pattern.finish)
  return nil if pattern.start.some? && low.nil?
  return nil if pattern.finish.some? && high.nil?
  return [low, high - 1] if pattern.exclusive && high.some?
  [low, high]
end

def literal_integer(node)
  return nil if node.nil?
  return nil unless node in IntegerNode
  node.value.to_i
end

# Raw positional read, mirroring the evaluator's value_at: a labels list in
# a pair may be empty, and host indexing lifts nil.
def value_at_checked(list, target_index)
  mutable result = nil
  list.each_with_index do |element, index|
    result = element if index == target_index
  end
  result
end
