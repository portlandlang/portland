# The native build's printer (#447): the intermediate representation
# written out as LLVM IR text, for `clang` to compile.
#
# This is the part of the spike meant to be replaced: MLIR is the plan for
# the backend (#5), and what carries over to it is the representation this
# reads, not the text this writes (ADR 0094).
#
# The shapes are plain on purpose. An Integer is an `i64` and a Boolean an
# `i1`. Every parameter and local has a stack slot, written by a store and
# read by a load; LLVM turns the slots into registers itself. `+`, `-`, and
# `*` go through LLVM's overflow-checking intrinsics, and an overflow says
# the seed's sentence on standard error and exits as the seed does (ADR
# 0070). `puts` of an Integer and that refusal call libc directly.
#
# A String is a pointer to a block the runtime crate lays out (ADR 0095):
# a reference count, a byte length, and the text's UTF-8 bytes. A literal
# is that block written into the binary as a constant, with the count the
# runtime reads as "never freed". What a String needs done to it is a call
# into the runtime, each function there named `portland_…`.
#
# Strings are reference counted, plainly (ADR 0095). Every String a
# value produces is held once by whoever asked for it:
#
#   - Reading a local retains what the slot holds; a call, a `+`, and an
#     Integer written out each answer a String already held.
#   - A store hands the String to the slot and releases what the slot
#     held. A call hands each argument to the callee, whose parameter
#     slot then holds it. A return hands it to the caller.
#   - `puts`, `+`, and a value computed and dropped release what they
#     were handed once they are done with it.
#   - Every way out of a function releases each slot it holds.
#
# A slot starts empty, and a release of nothing does nothing, so no path
# has to know which locals were bound. The entry function ends by asking
# the runtime whether anything is still held, which the debug build
# answers.
#
# A block is a function of its own (ADR 0096), written out after the
# function it was written in. It takes a pointer to a frame, then what it
# is yielded. The frame is an array on its writer's stack holding the
# address of each slot the block captures, so inside the block a captured
# local's slot is that address, and is read and stored through exactly as
# the block's own slots are. A def that yields takes two more parameters,
# the block's function and its frame, and a `yield` calls the one with
# the other. A block cannot be held in a value, so the frame never
# outlives the call it was built for and nothing is put on the heap. A
# block that yields carries what its writer was handed, the function and
# the frame, in two more places at the end of its own frame (#495).
# Counting is a call's: what is yielded is handed to the block, whose
# parameter slot then holds it, and what the block answers is handed
# back.
#
# An array is a pointer to a block the runtime lays out (ADR 0096): a
# count, a length, a capacity, what kind of slot it holds, and then its
# elements, one word each. It is counted exactly as a String is, by the
# same rules above. `[]` is one empty array written into the binary,
# never freed and never written to. `<<` hands the runtime the local's
# own hold and stores what comes back, so an array only that local holds
# is grown where it is, and one another name holds is copied first.
# `each` is a loop written where the call is, calling the block's
# function once for each element.
#
# No target is named, so `clang` supplies the host's.

require_relative "intermediate_representation"

# The text so far: its lines, the next number for a temporary or a label,
# and the label of the block being written, which a value chosen between
# two arms has to name.
struct LlvmEmitter
  lines
  counter
  block
  # The constants this function's String literals became, written at the
  # top of the module, and the prefix that keeps their names its own.
  globals
  prefix
  # The parameters and locals that hold a counted value, a String or an
  # array, as [name, type]: each released on every way out of the function.
  held
  # The loops being written, innermost first, by the number in their
  # labels: where `break` and `next` go.
  loops
  # The frames this function builds for the blocks it hands over, as
  # the lines that make room for them. They are written at the top of
  # the function, so a call inside a loop takes no more stack each turn.
  frames
  # The blocks written in this function, each a finished function's
  # lines, written out after it.
  routines
end

# A block written and its frame built: the text so far, the block's
# function, and the frame to call it with.
struct LlvmHanded
  emitter
  function
  frame
end

# A value written: the text so far, and how to refer to the value.
struct LlvmValue
  emitter
  operand
end

LLVM_PRELUDE = [
  "@.integer_line = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"",
  "@.overflow = private unnamed_addr constant [44 x i8] c\"%lld %s %lld overflows the 64-bit integers\\0A\\00\"",
  "@.plus = private unnamed_addr constant [2 x i8] c\"+\\00\"",
  "@.minus = private unnamed_addr constant [2 x i8] c\"-\\00\"",
  "@.times = private unnamed_addr constant [2 x i8] c\"*\\00\"",
"@.empty_array = private constant { i64, i64, i64, i64 } { i64 -1, i64 0, i64 0, i64 0 }",
  "",
  "declare i32 @printf(ptr, ...)",
  "declare i32 @dprintf(i32, ptr, ...)",
  "declare void @exit(i32)",
"declare void @portland_puts_string(ptr)",
"declare ptr @portland_string_concat(ptr, ptr)",
"declare ptr @portland_string_from_integer(i64)",
"declare zeroext i1 @portland_string_equal(ptr, ptr)",
"declare i64 @portland_integer_divide(i64, i64)",
"declare i64 @portland_integer_modulo(i64, i64)",
"declare i64 @portland_integer_negate(i64)",
"declare i64 @portland_integer_abs(i64)",
"declare i64 @portland_integer_succ(i64)",
"declare i64 @portland_integer_pred(i64)",
"declare i64 @portland_string_length(ptr)",
"declare ptr @portland_array_new(i64, i64)",
"declare ptr @portland_array_append_word(ptr, i64)",
"declare void @portland_array_release(ptr)",
"declare void @portland_retain(ptr)",
"declare void @portland_release(ptr)",
"declare void @portland_exit_check()",
  "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)",
  "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)",
  "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)",
  "",
  "define internal void @portland.overflow(i64 %left, ptr %operator, i64 %right) {",
  "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.overflow, i64 %left, ptr %operator, i64 %right)",
  "  call void @exit(i32 1)",
  "  unreachable",
  "}"
]

# A whole program as LLVM IR text.
def llvm_text(program)
  mutable globals = []
  mutable bodies = []
  mutable index = 0
  program.functions.each do |function|
    written = llvm_function(function, "f#{index}")
    globals += written.globals
    bodies += [""] + written.lines + ["}"] + written.routines
    index += 1
  end
  (globals + LLVM_PRELUDE + bodies).join("\n") + "\n"
end

# One function, as the emitter that wrote it: its lines, the constants
# its String literals became, and the blocks written in it.
def llvm_function(function, prefix)
  entry = function.name == "main"
  named = function.parameters.map { "#{llvm_type(type_at(it, 1))} #{llvm_local(it[0])}" }
  # A def that yields is handed its block: the function, and the frame
  # to call it with.
  parameters = function.block.nil? ? named : named + ["ptr #{LLVM_BLOCK}", "ptr #{LLVM_BLOCK_FRAME}"]
  header = entry ? "define i32 @main() {" : "define #{llvm_type(function.answer)} #{llvm_function_name(function.name)}(#{parameters.join(", ")}) {"
  llvm_routine(header, [], false, function.parameters, function.locals, function.body, prefix, entry)
end

# The names the block a function was handed and that block's frame go
# by, and the frame a block's own function is handed. No local can be
# named with a dot first.
LLVM_BLOCK = "%\".block\""
LLVM_BLOCK_FRAME = "%\".block.frame\""
LLVM_FRAME = "%\".frame\""

# A function's lines under a header written by the caller: a def's, the
# entry function's, or a block's. A block's captures are read out of its
# frame first, each as the address of a slot that lives in its writer,
# and after them, where the block yields, what its writer was handed.
def llvm_routine(header, captures, onward, parameters, locals, body, prefix, entry)
  held = (parameters + locals).select { llvm_counted?(type_at(it, 1)) }
  mutable emitter = LlvmEmitter.new(lines: [header, "entry:"], counter: 0, block: "entry", globals: [], prefix: prefix, held: held, loops: [], frames: [], routines: [])
  shape = llvm_frame_shape(captures, onward)
  mutable position = 0
  captures.each do |capture|
    place = llvm_named(emitter, "getelementptr #{shape}, ptr #{LLVM_FRAME}, i64 0, i64 #{position}")
    emitter = llvm_line(place.emitter, "#{llvm_slot(capture[0])} = load ptr, ptr #{place.operand}")
    position += 1
  end
  if onward
    function = llvm_named(emitter, "getelementptr #{shape}, ptr #{LLVM_FRAME}, i64 0, i64 #{position}")
    loaded = llvm_line(function.emitter, "#{LLVM_BLOCK} = load ptr, ptr #{function.operand}")
    frame = llvm_named(loaded, "getelementptr #{shape}, ptr #{LLVM_FRAME}, i64 0, i64 #{position + 1}")
    emitter = llvm_line(frame.emitter, "#{LLVM_BLOCK_FRAME} = load ptr, ptr #{frame.operand}")
  end
  (parameters + locals).each do |slot|
    emitter = llvm_line(emitter, "#{llvm_slot(slot[0])} = alloca #{llvm_type(type_at(slot, 1))}")
  end
  # A local that holds a counted value starts empty, so releasing it before
  # it is bound does nothing.
  locals.each do |local|
    emitter = llvm_line(emitter, "store ptr null, ptr #{llvm_slot(local[0])}") if llvm_counted?(type_at(local, 1))
  end
  parameters.each do |parameter|
    type = llvm_type(type_at(parameter, 1))
    emitter = llvm_line(emitter, "store #{type} #{llvm_local(parameter[0])}, ptr #{llvm_slot(parameter[0])}")
  end
  emitter = llvm_statements(emitter, body)
  # Every path through a def or a block has returned by here; the entry
  # function falls off its end and answers success.
  finished = if entry
    llvm_line(llvm_line(llvm_release_held(emitter), "call void @portland_exit_check()"), "ret i32 0")
  else
    llvm_line(emitter, "unreachable")
  end
  # The frames go first, ahead of everything the body wrote.
  finished.with(lines: finished.lines.slice(0, 2) + finished.frames + finished.lines.slice(2, finished.lines.length - 2))
end

# A block handed over: its function written, and its frame built.
def llvm_block(emitter, block)
  number = emitter.counter
  name = "@\"portland.block.#{emitter.prefix}.#{number}\""
  named = block.parameters.map { "#{llvm_type(type_at(it, 1))} #{llvm_local(it[0])}" }
  header = "define internal #{llvm_type(block.answer)} #{name}(#{(["ptr #{LLVM_FRAME}"] + named).join(", ")}) {"
  written = llvm_routine(header, block.captures, block.onward, block.parameters, block.locals, block.body, "#{emitter.prefix}.b#{number}", false)
  mutable current = emitter.with(counter: number + 1, globals: emitter.globals + written.globals, routines: emitter.routines + [""] + written.lines + ["}"] + written.routines)
  return LlvmHanded.new(emitter: current, function: name, frame: "null") if block.captures.empty? && !block.onward
  frame = "%\"frame.#{number}\""
  shape = llvm_frame_shape(block.captures, block.onward)
  current = current.with(frames: current.frames + ["  #{frame} = alloca #{shape}"])
  mutable position = 0
  block.captures.each do |capture|
    place = llvm_named(current, "getelementptr #{shape}, ptr #{frame}, i64 0, i64 #{position}")
    current = llvm_line(place.emitter, "store ptr #{llvm_slot(capture[0])}, ptr #{place.operand}")
    position += 1
  end
  if block.onward
    function = llvm_named(current, "getelementptr #{shape}, ptr #{frame}, i64 0, i64 #{position}")
    stored = llvm_line(function.emitter, "store ptr #{LLVM_BLOCK}, ptr #{function.operand}")
    carried = llvm_named(stored, "getelementptr #{shape}, ptr #{frame}, i64 0, i64 #{position + 1}")
    current = llvm_line(carried.emitter, "store ptr #{LLVM_BLOCK_FRAME}, ptr #{carried.operand}")
  end
  LlvmHanded.new(emitter: current, function: name, frame: frame)
end

# A frame's shape: a place for each captured slot's address, and two more
# where the block yields.
def llvm_frame_shape(captures, onward)
  "[#{captures.length + (onward ? 2 : 0)} x ptr]"
end

# Every counted value this function's slots hold, released: written
# before each way out.
def llvm_release_held(emitter)
  mutable current = emitter
  emitter.held.each do |slot|
    loaded = llvm_named(current, "load ptr, ptr #{llvm_slot(slot[0])}")
    current = llvm_drop(loaded.emitter, type_at(slot, 1), loaded.operand)
  end
  current
end

# Whether a value of this type is a pointer to a counted block.
def llvm_counted?(type) = type == ["string"] || (type in ["array", *])

# A value that was handed over and is done with: released if it is
# counted, by the runtime function for what it is.
def llvm_drop(emitter, type, operand)
  return llvm_line(emitter, "call void @portland_release(ptr #{operand})") if type == ["string"]
  return llvm_line(emitter, "call void @portland_array_release(ptr #{operand})") if type in ["array", *]
  emitter
end

def llvm_statements(emitter, statements)
  mutable current = emitter
  statements.each do |statement|
    current = llvm_statement(current, statement)
  end
  current
end

def llvm_statement(emitter, statement)
  case statement
  in IntermediateStore(name:, value:)
    written = llvm_value(emitter, value)
    if llvm_counted?(value.type)
      # The slot takes the new value and lets go of the one it held.
      previous = llvm_named(written.emitter, "load ptr, ptr #{llvm_slot(name)}")
      stored = llvm_line(previous.emitter, "store ptr #{written.operand}, ptr #{llvm_slot(name)}")
      return llvm_drop(stored, value.type, previous.operand)
    end
    llvm_line(written.emitter, "store #{llvm_type(value.type)} #{written.operand}, ptr #{llvm_slot(name)}")
  # The value is computed first, since it may read the array. Then the
  # slot's own hold goes to the runtime, with nothing retained, and what
  # comes back is the slot's.
  in IntermediateAppend(name:, value:)
    written = llvm_value(emitter, value)
    held = llvm_named(written.emitter, "load ptr, ptr #{llvm_slot(name)}")
    grown = llvm_named(held.emitter, "call ptr @portland_array_append_word(ptr #{held.operand}, i64 #{written.operand})")
    llvm_line(grown.emitter, "store ptr #{grown.operand}, ptr #{llvm_slot(name)}")
  in IntermediateReturn(value:)
    returned = if value.nil?
      llvm_line(llvm_release_held(emitter), "ret void")
    else
      # The value is computed first: it may read a local the release
      # after it lets go of.
      written = llvm_value(emitter, value)
      llvm_line(llvm_release_held(written.emitter), "ret #{llvm_type(value.type)} #{written.operand}")
    end
    # Whatever is written after a return needs a block of its own to sit
    # in, though nothing reaches it.
    llvm_label(returned, "after#{returned.counter}")
  in IntermediatePrint(value:)
    written = llvm_value(emitter, value)
    if value.type == ["string"]
      printed = llvm_line(written.emitter, "call void @portland_puts_string(ptr #{written.operand})")
      return llvm_drop(printed, ["string"], written.operand)
    end
    llvm_line(written.emitter, "call i32 (ptr, ...) @printf(ptr @.integer_line, i64 #{written.operand})")
  in IntermediateEvaluate(value:)
    written = llvm_value(emitter, value)
    llvm_drop(written.emitter, value.type, written.operand)
  in IntermediateLoop(condition:, body:)
    number = emitter.counter
    started = llvm_label(llvm_line(emitter, "br label %loop#{number}.test"), "loop#{number}.test")
    test = llvm_value(started, condition)
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %loop#{number}.body, label %loop#{number}.done")
    inside = llvm_label(branched, "loop#{number}.body")
    walked = llvm_statements(inside.with(loops: [number] + inside.loops), body)
    llvm_label(llvm_line(walked.with(loops: emitter.loops), "br label %loop#{number}.test"), "loop#{number}.done")
  # Out of the innermost loop, or on to its next turn. Whatever is written
  # after either needs a block of its own, though nothing reaches it.
  in IntermediateBreak
    left = llvm_line(emitter, "br label %loop#{emitter.loops.first}.done")
    llvm_label(left, "after#{left.counter}")
  in IntermediateNext
    left = llvm_line(emitter, "br label %loop#{emitter.loops.first}.test")
    llvm_label(left, "after#{left.counter}")
  in IntermediateBranch(condition:, then_body:, else_body:)
    test = llvm_value(emitter, condition)
    number = test.emitter.counter
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %if#{number}.then, label %if#{number}.else")
    taken = llvm_statements(llvm_label(branched, "if#{number}.then"), then_body)
    other = llvm_statements(llvm_label(llvm_line(taken, "br label %if#{number}.done"), "if#{number}.else"), else_body)
    llvm_label(llvm_line(other, "br label %if#{number}.done"), "if#{number}.done")
  end
end

def llvm_value(emitter, value)
  case value
  in IntermediateConstant(type: ["string"], value: text) then llvm_literal(emitter, text)
  in IntermediateConstant(value: literal) then LlvmValue.new(emitter: emitter, operand: literal.to_s)
  in IntermediateLocal(type:, name:)
    loaded = llvm_named(emitter, "load #{llvm_type(type)}, ptr #{llvm_slot(name)}")
    return loaded unless llvm_counted?(type)
    # The slot keeps its hold; whoever reads gets one of their own.
    LlvmValue.new(emitter: llvm_line(loaded.emitter, "call void @portland_retain(ptr #{loaded.operand})"), operand: loaded.operand)
  in IntermediateConcat(left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    joined = llvm_named(second.emitter, "call ptr @portland_string_concat(ptr #{first.operand}, ptr #{second.operand})")
    released = llvm_drop(llvm_drop(joined.emitter, ["string"], first.operand), ["string"], second.operand)
    LlvmValue.new(emitter: released, operand: joined.operand)
  in IntermediateText(value: number)
    written = llvm_value(emitter, number)
    llvm_named(written.emitter, "call ptr @portland_string_from_integer(i64 #{written.operand})")
  in IntermediateArithmetic(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    llvm_checked(second.emitter, operator, first.operand, second.operand)
  in IntermediateComparison(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    if left.type == ["string"]
      # A String's `==` is canonical equivalence (ADR 0038), the runtime's
      # to say, and never a comparison of two addresses.
      equal = llvm_named(second.emitter, "call zeroext i1 @portland_string_equal(ptr #{first.operand}, ptr #{second.operand})")
      released = llvm_drop(llvm_drop(equal.emitter, ["string"], first.operand), ["string"], second.operand)
      return LlvmValue.new(emitter: released, operand: equal.operand) if operator == "=="
      return llvm_named(released, "xor i1 #{equal.operand}, true")
    end
    llvm_named(second.emitter, "icmp #{llvm_comparison(operator)} #{llvm_type(left.type)} #{first.operand}, #{second.operand}")
  in IntermediateDivision(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    function = operator == "/" ? "portland_integer_divide" : "portland_integer_modulo"
    llvm_named(second.emitter, "call i64 @#{function}(i64 #{first.operand}, i64 #{second.operand})")
  in IntermediateNegation(value: negated)
    written = llvm_value(emitter, negated)
    llvm_named(written.emitter, "call i64 @portland_integer_negate(i64 #{written.operand})")
  in IntermediateNot(value: inverted)
    written = llvm_value(emitter, inverted)
    llvm_named(written.emitter, "xor i1 #{written.operand}, true")
  in IntermediateLogical(operator:, left:, right:)
    first = llvm_value(emitter, left)
    number = first.emitter.counter
    # `&&` goes on to its right side when the left is true, `||` when it is
    # false; otherwise the left side is already the answer.
    decided = operator == "&&" ? "false" : "true"
    targets = operator == "&&" ? "label %logic#{number}.right, label %logic#{number}.done" : "label %logic#{number}.done, label %logic#{number}.right"
    first_block = first.emitter.block
    branched = llvm_line(first.emitter, "br i1 #{first.operand}, #{targets}")
    second = llvm_value(llvm_label(branched, "logic#{number}.right"), right)
    second_block = second.emitter.block
    joined = llvm_label(llvm_line(second.emitter, "br label %logic#{number}.done"), "logic#{number}.done")
    llvm_named(joined, "phi i1 [ #{decided}, %#{first_block} ], [ #{second.operand}, %#{second_block} ]")
  in IntermediateMethod(receiver:, name:)
    asked = llvm_value(emitter, receiver)
    llvm_method(asked.emitter, receiver.type, name, asked.operand)
  in IntermediateCall(type:, name:, arguments:, block:)
    mutable current = emitter
    mutable operands = []
    arguments.each do |argument|
      written = llvm_value(current, argument)
      current = written.emitter
      operands << "#{llvm_type(argument.type)} #{written.operand}"
    end
    if block.some?
      handed = llvm_block(current, block)
      current = handed.emitter
      operands << "ptr #{handed.function}, ptr #{handed.frame}"
    end
    call = "call #{llvm_type(type)} #{llvm_function_name(name)}(#{operands.join(", ")})"
    # A call that answers nothing has no result to name.
    return LlvmValue.new(emitter: llvm_line(current, call), operand: "") if type == NOTHING
    llvm_named(current, call)
  # A literal: an array with room for its elements, each appended in
  # order. The empty one is the constant every `[]` starts as.
  in IntermediateArray(elements:)
    return LlvmValue.new(emitter: emitter, operand: "@.empty_array") if elements.empty?
    mutable made = llvm_named(emitter, "call ptr @portland_array_new(i64 0, i64 #{elements.length})")
    elements.each do |element|
      written = llvm_value(made.emitter, element)
      made = llvm_named(written.emitter, "call ptr @portland_array_append_word(ptr #{made.operand}, i64 #{written.operand})")
    end
    made
  # `each`: the length is read once, since the array cannot change under
  # the walk, and the block's function is called for each element in
  # turn. The place the walk keeps its index is made at the top of the
  # function, as a frame is. The array is answered still held.
  in IntermediateWalk(type:, array:, block:)
    walked = llvm_value(emitter, array)
    handed = llvm_block(walked.emitter, block)
    number = handed.emitter.counter
    turn = "%\"walk.#{number}\""
    element = llvm_type(type_at(type, 1))
    reserved = handed.emitter.with(frames: handed.emitter.frames + ["  #{turn} = alloca i64"])
    place = llvm_named(reserved, "getelementptr i64, ptr #{walked.operand}, i64 1")
    length = llvm_named(place.emitter, "load i64, ptr #{place.operand}")
    started = llvm_label(llvm_line(llvm_line(length.emitter, "store i64 0, ptr #{turn}"), "br label %walk#{number}.test"), "walk#{number}.test")
    index = llvm_named(started, "load i64, ptr #{turn}")
    more = llvm_named(index.emitter, "icmp slt i64 #{index.operand}, #{length.operand}")
    inside = llvm_label(llvm_line(more.emitter, "br i1 #{more.operand}, label %walk#{number}.body, label %walk#{number}.done"), "walk#{number}.body")
    offset = llvm_named(inside, "add i64 #{index.operand}, 4")
    slot = llvm_named(offset.emitter, "getelementptr i64, ptr #{walked.operand}, i64 #{offset.operand}")
    read = llvm_named(slot.emitter, "load #{element}, ptr #{slot.operand}")
    called = llvm_line(read.emitter, "call void #{handed.function}(ptr #{handed.frame}, #{element} #{read.operand})")
    following = llvm_named(called, "add i64 #{index.operand}, 1")
    stepped = llvm_line(following.emitter, "store i64 #{following.operand}, ptr #{turn}")
    finished = llvm_label(llvm_line(stepped, "br label %walk#{number}.test"), "walk#{number}.done")
    LlvmValue.new(emitter: finished, operand: walked.operand)
  # A `yield` calls the block this function was handed, with its frame
  # and then what is yielded.
  in IntermediateYield(type:, arguments:)
    mutable current = emitter
    mutable operands = ["ptr #{LLVM_BLOCK_FRAME}"]
    arguments.each do |argument|
      written = llvm_value(current, argument)
      current = written.emitter
      operands << "#{llvm_type(argument.type)} #{written.operand}"
    end
    call = "call #{llvm_type(type)} #{LLVM_BLOCK}(#{operands.join(", ")})"
    return LlvmValue.new(emitter: llvm_line(current, call), operand: "") if type == NOTHING
    llvm_named(current, call)
  in IntermediateChoice(type:, condition:, then_value:, else_value:)
    test = llvm_value(emitter, condition)
    number = test.emitter.counter
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %choice#{number}.then, label %choice#{number}.else")
    taken = llvm_value(llvm_label(branched, "choice#{number}.then"), then_value)
    # An arm can open blocks of its own, so the block it ends in is asked
    # for, not assumed.
    taken_block = taken.emitter.block
    other = llvm_value(llvm_label(llvm_line(taken.emitter, "br label %choice#{number}.done"), "choice#{number}.else"), else_value)
    other_block = other.emitter.block
    joined = llvm_label(llvm_line(other.emitter, "br label %choice#{number}.done"), "choice#{number}.done")
    llvm_named(joined, "phi #{llvm_type(type)} [ #{taken.operand}, %#{taken_block} ], [ #{other.operand}, %#{other_block} ]")
  end
end

# A String literal: its block written into the binary as a constant. The
# count is the runtime's `LITERAL`, so no release ever frees it.
def llvm_literal(emitter, text)
  name = "@.text.#{emitter.prefix}.#{emitter.counter}"
  length = text.bytesize
  shape = "{ i64, i64, [#{length} x i8] }"
  constant = "#{name} = private unnamed_addr constant #{shape} { i64 -1, i64 #{length}, [#{length} x i8] c\"#{llvm_bytes(text)}\" }"
  LlvmValue.new(emitter: emitter.with(globals: emitter.globals + [constant], counter: emitter.counter + 1), operand: name)
end

# A text's bytes as LLVM writes them between quotes: a printable ASCII
# character as itself, and every other byte, the quote and the backslash
# among them, as a backslash and two hex digits.
def llvm_bytes(text)
  digits = "0123456789ABCDEF"
  written = text.bytes.map do |byte|
    plain = byte >= 32 && byte <= 126 && byte != 34 && byte != 92
    plain ? byte.chr : "\\" + digits.slice(byte / 16, 1) + digits.slice(byte % 16, 1)
  end
  written.join("")
end

# A method with no arguments. What can refuse, or needs a table, is the
# runtime's; a question about an Integer's sign or parity is one
# instruction or two. A String asked is released once it has answered.
def llvm_method(emitter, type, name, operand)
  # An array's length is the second word of its block.
  if type in ["array", *]
    place = llvm_named(emitter, "getelementptr i64, ptr #{operand}, i64 1")
    length = llvm_named(place.emitter, "load i64, ptr #{place.operand}")
    released = llvm_drop(length.emitter, type, operand)
    return LlvmValue.new(emitter: released, operand: length.operand) unless name == "empty?"
    return llvm_named(released, "icmp eq i64 #{length.operand}, 0")
  end
  if type == ["string"]
    counted = llvm_named(emitter, "call i64 @portland_string_length(ptr #{operand})")
    released = llvm_drop(counted.emitter, ["string"], operand)
    return LlvmValue.new(emitter: released, operand: counted.operand) unless name == "empty?"
    return llvm_named(released, "icmp eq i64 #{counted.operand}, 0")
  end
  case name
  when "abs" then llvm_named(emitter, "call i64 @portland_integer_abs(i64 #{operand})")
  when "succ", "next" then llvm_named(emitter, "call i64 @portland_integer_succ(i64 #{operand})")
  when "pred" then llvm_named(emitter, "call i64 @portland_integer_pred(i64 #{operand})")
  when "zero?" then llvm_named(emitter, "icmp eq i64 #{operand}, 0")
  when "positive?" then llvm_named(emitter, "icmp sgt i64 #{operand}, 0")
  when "negative?" then llvm_named(emitter, "icmp slt i64 #{operand}, 0")
  else
    # Parity is the lowest bit, in two's complement for a negative too.
    bit = llvm_named(emitter, "and i64 #{operand}, 1")
    llvm_named(bit.emitter, "icmp #{name == "even?" ? "eq" : "ne"} i64 #{bit.operand}, 0")
  end
end

# One checked operation: the intrinsic answers the result and whether it
# overflowed, and an overflow leaves through the refusal.
def llvm_checked(emitter, operator, left, right)
  intrinsic = case operator
              when "+" then "sadd"
              when "-" then "ssub"
              else "smul"
              end
  symbol = case operator
           when "+" then "@.plus"
           when "-" then "@.minus"
           else "@.times"
           end
  pair = llvm_named(emitter, "call {i64, i1} @llvm.#{intrinsic}.with.overflow.i64(i64 #{left}, i64 #{right})")
  flag = llvm_named(pair.emitter, "extractvalue {i64, i1} #{pair.operand}, 1")
  number = flag.emitter.counter
  branched = llvm_line(flag.emitter, "br i1 #{flag.operand}, label %overflow#{number}, label %checked#{number}")
  refused = llvm_line(llvm_label(branched, "overflow#{number}"), "call void @portland.overflow(i64 #{left}, ptr #{symbol}, i64 #{right})")
  resumed = llvm_label(llvm_line(refused, "unreachable"), "checked#{number}")
  llvm_named(resumed, "extractvalue {i64, i1} #{pair.operand}, 0")
end

# An instruction whose result gets the next temporary's name.
def llvm_named(emitter, instruction)
  name = "%t#{emitter.counter}"
  LlvmValue.new(emitter: emitter.with(lines: emitter.lines + ["  #{name} = #{instruction}"], counter: emitter.counter + 1), operand: name)
end

def llvm_line(emitter, instruction)
  emitter.with(lines: emitter.lines + ["  #{instruction}"])
end

# A block opened. The counter moves on so no two labels share a number.
def llvm_label(emitter, label)
  emitter.with(lines: emitter.lines + ["#{label}:"], counter: emitter.counter + 1, block: label)
end

def llvm_type(type)
  case type
  in ["integer"] then "i64"
  in ["boolean"] then "i1"
  in ["string"] then "ptr"
  in ["array", *] then "ptr"
  in ["nothing"] then "void"
  else panic("llvm.pdx: no machine type for #{render_type(type)}")
  end
end

def llvm_comparison(operator)
  case operator
  when "<" then "slt"
  when "<=" then "sle"
  when ">" then "sgt"
  when ">=" then "sge"
  when "==" then "eq"
  else "ne"
  end
end

# A def's name as LLVM's. Quoted, since a Portland name may end in `?`, and
# prefixed, so a def named for a libc function is its own.
def llvm_function_name(name) = "@\"portland.#{name}\""

def llvm_local(name) = "%\"#{name}\""

def llvm_slot(name) = "%\"#{name}.slot\""
