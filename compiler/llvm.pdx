# The native build's printer (#447): the intermediate representation
# written out as LLVM IR text, for `clang` to compile.
#
# This is the part of the spike meant to be replaced: MLIR is the plan for
# the backend (#5), and what carries over to it is the representation this
# reads, not the text this writes (ADR 0094).
#
# The shapes are plain on purpose. An Integer is an `i64` and a Boolean an
# `i1`. Every parameter and local has a stack slot, written by a store and
# read by a load; LLVM turns the slots into registers itself. `+`, `-`, and
# `*` go through LLVM's overflow-checking intrinsics, and an overflow says
# the seed's sentence on standard error and exits as the seed does (ADR
# 0070). `puts` of an Integer and that refusal call libc directly.
#
# A String is a pointer to a block the runtime crate lays out (ADR 0095):
# a reference count, a byte length, and the text's UTF-8 bytes. A literal
# is that block written into the binary as a constant, with the count the
# runtime reads as "never freed". What a String needs done to it is a call
# into the runtime, each function there named `portland_…`.
#
# Strings are reference counted, plainly (ADR 0095). Every String a
# value produces is held once by whoever asked for it:
#
#   - Reading a local retains what the slot holds; a call, a `+`, and an
#     Integer written out each answer a String already held.
#   - A store hands the String to the slot and releases what the slot
#     held. A call hands each argument to the callee, whose parameter
#     slot then holds it. A return hands it to the caller.
#   - `puts`, `+`, and a value computed and dropped release what they
#     were handed once they are done with it.
#   - Every way out of a function releases each slot it holds.
#
# A slot starts empty, and a release of nothing does nothing, so no path
# has to know which locals were bound. The entry function ends by asking
# the runtime whether anything is still held, which the debug build
# answers.
#
# A block is a function of its own (ADR 0096), written out after the
# function it was written in. It takes a pointer to a frame, then what it
# is yielded. The frame is an array on its writer's stack holding the
# address of each slot the block captures, so inside the block a captured
# local's slot is that address, and is read and stored through exactly as
# the block's own slots are. A def that yields takes two more parameters,
# the block's function and its frame, and a `yield` calls the one with
# the other. A block cannot be held in a value, so the frame never
# outlives the call it was built for and nothing is put on the heap. A
# block that yields carries what its writer was handed, the function and
# the frame, in two more places at the end of its own frame (#495).
# Counting is a call's: what is yielded is handed to the block, whose
# parameter slot then holds it, and what the block answers is handed
# back.
#
# An array is a pointer to a block the runtime lays out (ADR 0096): a
# count, a length, a capacity, what kind of slot it holds, and then its
# elements, one word each. An Integer or a Boolean element is the word; a
# String or an array element is a counted pointer, which the array holds
# once and the runtime releases when the array is freed, going by the
# kind written on it. It is counted exactly as a String is, by the same
# rules above. `[]` is one empty array written into the binary,
# never freed and never written to. `<<` hands the runtime the local's
# own hold and stores what comes back, so an array only that local holds
# is grown where it is, and one another name holds is copied first.
# `each` is a loop written where the call is, calling the block's
# function once for each element.
#
# A struct is a pointer to a block the runtime lays out (#532): a count,
# the address of its shape, and its fields, one word each, as an array's
# elements are. A shape is written into the binary once for each struct
# the program declares: its name, how many fields it has, and for each
# the kind of slot and the field's name. The runtime frees a struct and
# writes one out by it.
#
# A block that can leave, by `return` or `break`, does so by a flag passed
# up (ADR 0097). Its function answers a pair: where it is leaving to, and
# its answer, the first being nothing when it only finished. A def handed
# such a block answers a pair too, since the leaving passes through it.
# Where a block leaves to is an address that names the frame: for a
# `return`, the place its def keeps the answer, which the block stores
# into first; for a `break`, a token the call it was handed to made for
# the purpose. Whoever called a block that can leave, or a def handed
# one, looks at the first of the pair. Nothing: it goes on. Its own
# address: it has arrived, and a def then answers what was stored, while
# a call that was broken out of is simply over. Any other address: it
# releases what it holds and answers the same pair to its own caller.
# Only a combination handed a block that can leave is compiled this way;
# the rest have no pair and no test.
#
# A maybe is a flag beside the value (ADR 0096): a pair of a bit saying
# whether there is one, and the value, which is all zeroes where there
# is none. It is one form for every type. A maybe of a String or of an
# array is counted through its value, and a value that is not there is
# an address of nothing, which retaining and releasing pass over. Used
# where its value is needed, a maybe is opened when the line runs: the
# flag is tested, and nil leaves through the runtime with the sentence
# the seed says there.
#
# No target is named, so `clang` supplies the host's.

require_relative "intermediate_representation"

# The names the block a function was handed and that block's frame go
# by, and the frame a block's own function is handed. No local can be
# named with a dot first.
LLVM_BLOCK = "%\".block\""

LLVM_BLOCK_FRAME = "%\".block.frame\""

# The token a block's own `break` leaves to, read out of its frame.
LLVM_BREAK = "%\".break\""

LLVM_FRAME = "%\".frame\""

LLVM_PRELUDE = [
  "@.integer_line = private unnamed_addr constant [6 x i8] c\"%lld\\0A\\00\"",
  "@.overflow = private unnamed_addr constant [44 x i8] c\"%lld %s %lld overflows the 64-bit integers\\0A\\00\"",
  "@.plus = private unnamed_addr constant [2 x i8] c\"+\\00\"",
  "@.minus = private unnamed_addr constant [2 x i8] c\"-\\00\"",
  "@.times = private unnamed_addr constant [2 x i8] c\"*\\00\"",
  "@.empty_array = private constant { i64, i64, i64, i64 } { i64 -1, i64 0, i64 0, i64 0 }",
  "",
  "declare i32 @printf(ptr, ...)",
  "declare i32 @dprintf(i32, ptr, ...)",
  "declare void @exit(i32)",
  "declare void @portland_puts_string(ptr)",
  "declare ptr @portland_string_concat(ptr, ptr)",
  "declare ptr @portland_string_from_integer(i64)",
  "declare ptr @portland_string_from_boolean(i1 zeroext)",
  "declare ptr @portland_string_inspect(ptr)",
  "declare ptr @portland_array_to_string(ptr)",
  "declare zeroext i1 @portland_string_equal(ptr, ptr)",
  "declare i64 @portland_string_order(ptr, ptr)",
  "declare zeroext i1 @portland_array_equal(ptr, ptr)",
  "declare zeroext i1 @portland_struct_equal(ptr, ptr)",
  "declare i64 @portland_integer_divide(i64, i64)",
  "declare i64 @portland_integer_modulo(i64, i64)",
  "declare i64 @portland_integer_negate(i64)",
  "declare i64 @portland_integer_abs(i64)",
  "declare i64 @portland_integer_succ(i64)",
  "declare i64 @portland_integer_pred(i64)",
  "declare i64 @portland_string_length(ptr)",
  "declare ptr @portland_array_new(i64, i64)",
  "declare ptr @portland_array_append(ptr, i64, i64)",
  "declare void @portland_array_release(ptr)",
  "declare ptr @portland_hash_empty(i64)",
  "declare ptr @portland_hash_new(ptr, ptr)",
  "declare void @portland_hash_release(ptr)",
  "declare void @portland_panic(ptr)",
  "declare void @portland_refuse_nil_method(ptr)",
  "declare void @portland_refuse_nil_puts()",
  "declare void @portland_refuse_nil_operand(ptr, ptr, ptr)",
  "declare void @portland_start(i32, ptr)",
  "declare ptr @portland_system_arguments()",
  "declare ptr @portland_system_core_source(ptr)",
  "declare ptr @portland_system_read_file(ptr)",
  "declare ptr @portland_struct_new(ptr)",
  "declare void @portland_struct_release(ptr)",
  "declare ptr @portland_struct_to_string(ptr)",
  "declare ptr @portland_struct_slot(ptr, ptr)",
  "declare zeroext i1 @portland_struct_is(ptr, ptr)",
  "declare void @portland_struct_refuse_method(ptr, ptr)",
  "declare void @portland_retain(ptr)",
  "declare void @portland_release(ptr)",
  "declare void @portland_exit_check()",
  "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)",
  "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)",
  "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)",
  "",
  "define internal void @portland.overflow(i64 %left, ptr %operator, i64 %right) {",
  "  call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.overflow, i64 %left, ptr %operator, i64 %right)",
  "  call void @exit(i32 1)",
  "  unreachable",
  "}"
]

# Where a `return` in a block leaves its answer and leaves to: in a def,
# the place itself; in a block, the address of it, read out of the frame.
LLVM_RETURN = "%\".return\""

# The text so far: its lines, the next number for a temporary or a label,
# and the label of the block being written, which a value chosen between
# two arms has to name.
struct LLVMEmitter
  lines
  counter
  block
  # The constants this function's String literals became, written at the
  # top of the module, and the prefix that keeps their names its own.
  globals
  prefix
  # The parameters and locals that hold a counted value, a String or an
  # array, as [name, type]: each released on every way out of the function.
  held
  # The loops being written, innermost first, by the number in their
  # labels: where `break` and `next` go.
  loops
  # The frames this function builds for the blocks it hands over, as
  # the lines that make room for them. They are written at the top of
  # the function, so a call inside a loop takes no more stack each turn.
  frames
  # The blocks written in this function, each a finished function's
  # lines, written out after it.
  routines
  # What this function answers, whether it answers it as a pair with
  # where it is leaving to (ADR 0097), and whether it is a def a block
  # returns into, which then has a place for that answer.
  answer
  paired
  returned
end

# A block written and its frame built: the text so far, the block's
# function, and the frame to call it with.
struct LLVMHanded
  emitter
  function
  frame
  # The token a `break` in the block names the call by, or nil where the
  # block has none.
  token
end

# Two operands written, each as a plain value: the text so far, and how
# to refer to each.
struct LLVMPair
  emitter
  left
  right
end

# What a function is written from: a def's, the entry function's, or a
# block's.
struct LLVMRoutine
  header
  prefix
  entry
  parameters
  locals
  body
  answer
  # A block's: what it captures, and what else its frame carries.
  captures
  onward
  returns
  breaks
  # Whether it answers a pair, and whether it is a def a block returns
  # into.
  paired
  returned
end

# A value written: the text so far, and how to refer to the value.
struct LLVMValue
  emitter
  operand
end

# What a function answers as LLVM's: its answer, or where it can leave,
# a pair of where it is leaving to and its answer (ADR 0097). One that
# answers nothing answers only where it is leaving to.
def llvm_answer_type(answer, paired)
  return llvm_type(answer) unless paired
  answer == NOTHING ? "ptr" : "{ ptr, #{llvm_type(answer)} }"
end

# The way out of the function being written: its answer, with where it
# is leaving to where it answers a pair. `value` is nil where there is
# no answer to give, which is so when it is leaving.
def llvm_answered(emitter, target, value)
  unless emitter.paired
    return llvm_line(emitter, value.nil? ? "ret void" : "ret #{llvm_type(emitter.answer)} #{value}")
  end
  return llvm_line(emitter, "ret ptr #{target}") if emitter.answer == NOTHING
  shape = llvm_answer_type(emitter.answer, true)
  aimed = llvm_named(emitter, "insertvalue #{shape} zeroinitializer, ptr #{target}, 0")
  return llvm_line(aimed.emitter, "ret #{shape} #{aimed.operand}") if value.nil?
  filled = llvm_named(aimed.emitter, "insertvalue #{shape} #{aimed.operand}, #{llvm_type(emitter.answer)} #{value}, 1")
  llvm_line(filled.emitter, "ret #{shape} #{filled.operand}")
end

# One element appended. A slot is a word: an Integer as it is, a Boolean
# widened to one, and a String or an array as its address, whose hold
# the array takes over.
def llvm_append(emitter, array, type, operand)
  word = llvm_word(emitter, type, operand)
  llvm_named(word.emitter, "call ptr @portland_array_append(ptr #{array}, i64 #{word.operand}, i64 #{llvm_array_kind(type)})")
end

# The kind the runtime writes on an array, by what an element is.
def llvm_array_kind(type)
  case type
  in IntegerType then 0
  in BooleanType then 1
  in StringType then 2
  in StructType then 4
  in HashType then 5
  else 3
  end
end

# A call that may come back leaving (ADR 0097): of a block that can
# leave, or of a def handed one. It answers where the leaving is to,
# which is nothing when the call only finished. Otherwise: the token of
# this call's own block means a `break`, and the call is over, at
# `broken` where a walk has somewhere of its own to go; the place this
# def keeps a returned answer means a `return` into it, and the def
# answers what is there; and anything else is on its way further out, so
# this function lets go of what it holds, `extra` among it, and answers
# the same.
def llvm_arrived(emitter, answer, call, token, broken, extra)
  shape = llvm_answer_type(answer, true)
  result = llvm_named(emitter, call)
  target = answer == NOTHING ? result : llvm_named(result.emitter, "extractvalue #{shape} #{result.operand}, 0")
  leaving = llvm_named(target.emitter, "icmp ne ptr #{target.operand}, null")
  number = leaving.emitter.counter
  stay = "leave#{number}.stay"
  mutable current = llvm_label(llvm_line(leaving.emitter, "br i1 #{leaving.operand}, label %leave#{number}.out, label %#{stay}"), "leave#{number}.out")
  if token.some?
    own = llvm_named(current, "icmp eq ptr #{target.operand}, #{token}")
    current = llvm_label(llvm_line(own.emitter, "br i1 #{own.operand}, label %#{broken or stay}, label %leave#{number}.past"), "leave#{number}.past")
  end
  if current.returned
    home = llvm_named(current, "icmp eq ptr #{target.operand}, #{LLVM_RETURN}")
    arrived = llvm_label(llvm_line(home.emitter, "br i1 #{home.operand}, label %leave#{number}.home, label %leave#{number}.on"), "leave#{number}.home")
    released = llvm_release_held(extra.nil? ? arrived : llvm_drop(arrived, type_at(extra, 0), type_at(extra, 1)))
    answered = if current.answer == NOTHING
      llvm_answered(released, "null", nil)
    else
      kept = llvm_named(released, "load #{llvm_type(current.answer)}, ptr #{LLVM_RETURN}")
      llvm_answered(kept.emitter, "null", kept.operand)
    end
    current = llvm_label(answered, "leave#{number}.on")
  end
  # Past here the leaving is to somewhere further out, which only a
  # function that answers a pair can pass on. One that does not has no
  # caller the leaving could be to, so nothing reaches this.
  passed = if current.paired
    llvm_answered(llvm_release_held(extra.nil? ? current : llvm_drop(current, type_at(extra, 0), type_at(extra, 1))), target.operand, nil)
  else
    llvm_line(current, "unreachable")
  end
  stayed = llvm_label(passed, stay)
  return LLVMValue.new(emitter: stayed, operand: "") if answer == NOTHING
  llvm_named(stayed, "extractvalue #{shape} #{result.operand}, 1")
end

# A block handed over: its function written, and its frame built.
def llvm_block(emitter, block)
  number = emitter.counter
  name = "@\"portland.block.#{emitter.prefix}.#{number}\""
  named = block.parameters.map { "#{llvm_type(type_at(it, 1))} #{llvm_local(it[0])}" }
  header = "define internal #{llvm_answer_type(block.answer, block.leaves)} #{name}(#{(["ptr #{LLVM_FRAME}"] + named).join(", ")}) {"
  written = llvm_routine(LLVMRoutine.new(header: header, prefix: "#{emitter.prefix}.b#{number}", entry: false, parameters: block.parameters, locals: block.locals, body: block.body, answer: block.answer, captures: block.captures, onward: block.onward, returns: block.returns, breaks: block.breaks, paired: block.leaves, returned: false))
  mutable current = emitter.with(counter: number + 1, globals: emitter.globals + written.globals, routines: emitter.routines + [""] + written.lines + ["}"] + written.routines)
  carried = llvm_frame_carried(block.captures, block.onward, block.returns, block.breaks)
  return LLVMHanded.new(emitter: current, function: name, frame: "null", token: nil) if carried.empty?
  frame = "%\"frame.#{number}\""
  token = block.breaks ? "%\"break.#{number}\"" : nil
  reserved = ["  #{frame} = alloca [#{carried.length} x ptr]"] + (token.nil? ? [] : ["  #{token} = alloca i8"])
  current = current.with(frames: current.frames + reserved)
  mutable position = 0
  carried.each do |kind|
    address = case kind
              when "block handed" then LLVM_BLOCK
              when "block frame" then LLVM_BLOCK_FRAME
              when "return" then LLVM_RETURN
              when "break" then (token or "null")
              else llvm_slot(kind)
              end
    place = llvm_named(current, "getelementptr [#{carried.length} x ptr], ptr #{frame}, i64 0, i64 #{position}")
    current = llvm_line(place.emitter, "store ptr #{address}, ptr #{place.operand}")
    position += 1
  end
  LLVMHanded.new(emitter: current, function: name, frame: frame, token: token)
end

# A text's bytes as LLVM writes them between quotes: a printable ASCII
# character as itself, and every other byte, the quote and the backslash
# among them, as a backslash and two hex digits.
def llvm_bytes(text)
  digits = "0123456789ABCDEF"
  written = text.bytes.map do |byte|
    plain = byte >= 32 && byte <= 126 && byte != 34 && byte != 92
    plain ? byte.chr : "\\" + digits.slice(byte / 16, 1) + digits.slice(byte % 16, 1)
  end
  written.join("")
end

# One checked operation: the intrinsic answers the result and whether it
# overflowed, and an overflow leaves through the refusal.
def llvm_checked(emitter, operator, left, right)
  intrinsic = case operator
              when "+" then "sadd"
              when "-" then "ssub"
              else "smul"
              end
  symbol = case operator
           when "+" then "@.plus"
           when "-" then "@.minus"
           else "@.times"
           end
  pair = llvm_named(emitter, "call {i64, i1} @llvm.#{intrinsic}.with.overflow.i64(i64 #{left}, i64 #{right})")
  flag = llvm_named(pair.emitter, "extractvalue {i64, i1} #{pair.operand}, 1")
  number = flag.emitter.counter
  branched = llvm_line(flag.emitter, "br i1 #{flag.operand}, label %overflow#{number}, label %checked#{number}")
  refused = llvm_line(llvm_label(branched, "overflow#{number}"), "call void @portland.overflow(i64 #{left}, ptr #{symbol}, i64 #{right})")
  resumed = llvm_label(llvm_line(refused, "unreachable"), "checked#{number}")
  llvm_named(resumed, "extractvalue {i64, i1} #{pair.operand}, 0")
end

def llvm_comparison(operator)
  case operator
  when "<" then "slt"
  when "<=" then "sle"
  when ">" then "sgt"
  when ">=" then "sge"
  when "==" then "eq"
  else "ne"
  end
end

# Whether a value of this type holds a counted block: a String, an
# array, a Hash, a struct, or a maybe of one.
def llvm_counted?(type)
  return llvm_counted?(type.inner) if type in MaybeType
  type == StringType.new || (type in ArrayType) || (type in HashType) || (type in StructType)
end

# A value that was handed over and is done with: released if it is
# counted, by the runtime function for what it is.
def llvm_drop(emitter, type, operand)
  return emitter unless llvm_counted?(type)
  if type in MaybeType
    held = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 1")
    return llvm_drop(held.emitter, type.inner, held.operand)
  end
  return llvm_line(emitter, "call void @portland_release(ptr #{operand})") if type == StringType.new
  return llvm_line(emitter, "call void @portland_struct_release(ptr #{operand})") if type in StructType
  return llvm_line(emitter, "call void @portland_hash_release(ptr #{operand})") if type in HashType
  llvm_line(emitter, "call void @portland_array_release(ptr #{operand})")
end

# One element read out of its slot, for whoever asked to hold: a Boolean
# narrowed back from its word, and a String or an array retained, since
# the array keeps its own hold.
def llvm_element(emitter, type, slot)
  return llvm_named(emitter, "load i64, ptr #{slot}") if type == IntegerType.new
  if type == BooleanType.new
    word = llvm_named(emitter, "load i64, ptr #{slot}")
    return llvm_named(word.emitter, "trunc i64 #{word.operand} to i1")
  end
  read = llvm_named(emitter, "load ptr, ptr #{slot}")
  LLVMValue.new(emitter: llvm_line(read.emitter, "call void @portland_retain(ptr #{read.operand})"), operand: read.operand)
end

# `==` where a side is a maybe, which compares without opening it: two
# values that are there are equal as their values are, and otherwise the
# sides are equal only when neither is there.
def llvm_equal_maybes(emitter, left_type, left, right_type, right)
  first = llvm_sides(emitter, left_type, left)
  second = llvm_sides(first.emitter, right_type, right)
  both = llvm_named(second.emitter, "and i1 #{first.left}, #{second.left}")
  number = both.emitter.counter
  branched = llvm_line(both.emitter, "br i1 #{both.operand}, label %same#{number}.values, label %same#{number}.flags")
  values = llvm_same(llvm_label(branched, "same#{number}.values"), llvm_plain(left_type), first.right, second.right)
  values_block = values.emitter.block
  flags = llvm_named(llvm_label(llvm_line(values.emitter, "br label %same#{number}.done"), "same#{number}.flags"), "icmp eq i1 #{first.left}, #{second.left}")
  joined = llvm_label(llvm_line(flags.emitter, "br label %same#{number}.done"), "same#{number}.done")
  equal = llvm_named(joined, "phi i1 [ #{values.operand}, %#{values_block} ], [ #{flags.operand}, %same#{number}.flags ]")
  LLVMValue.new(emitter: llvm_drop(llvm_drop(equal.emitter, left_type, left), right_type, right), operand: equal.operand)
end

# The kind the runtime reads for a struct's field (#553): an element's
# kind, and sixteen more where the field is a maybe of it, which the
# runtime's `MAYBE` is.
def llvm_field_kind(type)
  # A field that is only ever nil is a maybe that is not there (#572):
  # two words the runtime reads as nothing, whatever it would have held.
  return 16 if type == NilType.new
  return 16 + llvm_array_kind(type.inner) if type in MaybeType
  llvm_array_kind(type)
end

# What a block's frame carries, in order: each captured local by its
# name, then, as each applies, the block its writer was handed and that
# block's frame, the place its def keeps a returned answer, and the token
# its own `break` leaves to. A local's name is never one of those words
# with a space in it, nor bare `return` or `break`, which are keywords.
# `block` is no keyword, and a local may be named it.
def llvm_frame_carried(captures, onward, returns, breaks)
  captures.map { it[0] } + (onward ? ["block handed", "block frame"] : []) + (returns ? ["return"] : []) + (breaks ? ["break"] : [])
end

# where the block yields.
def llvm_frame_shape(captures, onward)
  "[#{captures.length + (onward ? 2 : 0)} x ptr]"
end

# One function, as the emitter that wrote it: its lines, the constants
# its String literals became, and the blocks written in it.
def llvm_function(function, prefix)
  # The entry function is the one with no combination: a program's own def
  # may be named `main` too.
  entry = function.key.nil?
  named = function.parameters.map { "#{llvm_type(type_at(it, 1))} #{llvm_local(it[0])}" }
  # A def that yields is handed its block: the function, and the frame
  # to call it with. Handed one that can leave, it answers a pair.
  parameters = function.block.nil? ? named : named + ["ptr #{LLVM_BLOCK}", "ptr #{LLVM_BLOCK_FRAME}"]
  paired = function.block.some? && function.block.leaves
  header = entry ? "define i32 @main(i32 %\".count\", ptr %\".values\") {" : "define #{llvm_answer_type(function.answer, paired)} #{llvm_function_name(function.key)}(#{parameters.join(", ")}) {"
  llvm_routine(LLVMRoutine.new(header: header, prefix: prefix, entry: entry, parameters: function.parameters, locals: function.locals, body: function.body, answer: function.answer, captures: [], onward: false, returns: false, breaks: false, paired: paired, returned: function.returned))
end

# A def's name as LLVM's. Quoted, since a Portland name may end in `?`, and
# prefixed, so a def named for a libc function is its own.
def llvm_function_name(name) = "@\"portland.#{name}\""

# A block opened. The counter moves on so no two labels share a number.
def llvm_label(emitter, label)
  emitter.with(lines: emitter.lines + ["#{label}:"], counter: emitter.counter + 1, block: label)
end

# What a library function answers, as LLVM writes it (#560): a Boolean
# widened as C hands one back, an Integer that may not be there as an
# Integer, and anything else as its own type.
def llvm_library_answer(type)
  return "zeroext i1" if type == BooleanType.new
  return "i64" if type == MaybeType.new(inner: IntegerType.new)
  return "ptr" if type in MaybeType
  llvm_type(type)
end

# The library's functions, declared (#560): one line for each function,
# from the table the calls are read by.
def llvm_library_declarations
  # One declaration for each function, which more than one row may name:
  # `join` is the same function for an array of Strings and of Integers.
  declared = NATIVE_LIBRARY.map do |entry|
    taken = type_at(entry, 2).map { (it == IntegerType.new || it == ElementType.new) ? "i64" : "ptr" }
    answer = type_at(entry, 3)
    answered = answer == BooleanType.new ? "zeroext i1" : ((answer == IntegerType.new || answer == MaybeType.new(inner: IntegerType.new)) ? "i64" : "ptr")
    asked = type_at(entry, 0) == IntegerType.new ? "i64" : "ptr"
    "declare #{answered} @#{type_at(entry, 4)}(#{([asked] + taken).join(", ")})"
  end
  declared.uniq
end

def llvm_line(emitter, instruction)
  emitter.with(lines: emitter.lines + ["  #{instruction}"])
end

# A String literal: its block written into the binary as a constant. The
# count is the runtime's `LITERAL`, so no release ever frees it.
def llvm_literal(emitter, text)
  name = "@.text.#{emitter.prefix}.#{emitter.counter}"
  length = text.bytesize
  shape = "{ i64, i64, [#{length} x i8] }"
  constant = "#{name} = private unnamed_addr constant #{shape} { i64 -1, i64 #{length}, [#{length} x i8] c\"#{llvm_bytes(text)}\" }"
  LLVMValue.new(emitter: emitter.with(globals: emitter.globals + [constant], counter: emitter.counter + 1), operand: name)
end

# The value a parameter arrives as. LLVM keeps values and labels in one
# set of names, so it goes by a name no label has (#554): a parameter
# named `entry` would otherwise be the first block's own name.
def llvm_local(name) = "%\"#{name}.handed\""

# A method with no arguments. What can refuse, or needs a table, is the
# runtime's; a question about an Integer's sign or parity is one
# instruction or two. A String asked is released once it has answered.
def llvm_method(emitter, type, name, operand)
  # An array's length is the second word of its block.
  if type in ArrayType
    place = llvm_named(emitter, "getelementptr i64, ptr #{operand}, i64 1")
    length = llvm_named(place.emitter, "load i64, ptr #{place.operand}")
    released = llvm_drop(length.emitter, type, operand)
    return LLVMValue.new(emitter: released, operand: length.operand) unless name == "empty?"
    return llvm_named(released, "icmp eq i64 #{length.operand}, 0")
  end
  if type == StringType.new
    counted = llvm_named(emitter, "call i64 @portland_string_length(ptr #{operand})")
    released = llvm_drop(counted.emitter, StringType.new, operand)
    return LLVMValue.new(emitter: released, operand: counted.operand) unless name == "empty?"
    return llvm_named(released, "icmp eq i64 #{counted.operand}, 0")
  end
  case name
  when "abs" then llvm_named(emitter, "call i64 @portland_integer_abs(i64 #{operand})")
  when "succ", "next" then llvm_named(emitter, "call i64 @portland_integer_succ(i64 #{operand})")
  when "pred" then llvm_named(emitter, "call i64 @portland_integer_pred(i64 #{operand})")
  when "zero?" then llvm_named(emitter, "icmp eq i64 #{operand}, 0")
  when "positive?" then llvm_named(emitter, "icmp sgt i64 #{operand}, 0")
  when "negative?" then llvm_named(emitter, "icmp slt i64 #{operand}, 0")
  else
    # Parity is the lowest bit, in two's complement for a negative too.
    bit = llvm_named(emitter, "and i64 #{operand}, 1")
    llvm_named(bit.emitter, "icmp #{name == "even?" ? "eq" : "ne"} i64 #{bit.operand}, 0")
  end
end

# An instruction whose result gets the next temporary's name.
def llvm_named(emitter, instruction)
  name = "%t#{emitter.counter}"
  LLVMValue.new(emitter: emitter.with(lines: emitter.lines + ["  #{name} = #{instruction}"], counter: emitter.counter + 1), operand: name)
end

# A maybe opened (#503): its value where there is one. Where there is
# none, the block writes the refusal, which does not come back.
def llvm_opened(emitter, type, operand)
  return LLVMValue.new(emitter: emitter, operand: operand) unless type in MaybeType
  flag = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 0")
  number = flag.emitter.counter
  branched = llvm_line(flag.emitter, "br i1 #{flag.operand}, label %open#{number}.some, label %open#{number}.none")
  refused = yield(llvm_label(branched, "open#{number}.none"))
  resumed = llvm_label(llvm_line(refused, "unreachable"), "open#{number}.some")
  llvm_named(resumed, "extractvalue #{llvm_type(type)} #{operand}, 1")
end

# Both operands of an operator, each opened where it is a maybe. Both
# are computed before either is opened, as the seed computes them, and
# the refusal names the operator and each side: its source form, or nil.
def llvm_operands(emitter, operator, left_type, left, right_type, right)
  first = llvm_opened(emitter, left_type, left) do |refusing|
    named = llvm_literal(refusing, operator)
    other = llvm_source(named.emitter, right_type, right)
    llvm_line(other.emitter, "call void @portland_refuse_nil_operand(ptr #{named.operand}, ptr null, ptr #{other.operand})")
  end
  second = llvm_opened(first.emitter, right_type, right) do |refusing|
    named = llvm_literal(refusing, operator)
    other = llvm_source(named.emitter, llvm_plain(left_type), first.operand)
    llvm_line(other.emitter, "call void @portland_refuse_nil_operand(ptr #{named.operand}, ptr #{other.operand}, ptr null)")
  end
  LLVMPair.new(emitter: second.emitter, left: first.operand, right: second.operand)
end

# A maybe's type with the maybe taken off; any other type is itself.
def llvm_plain(type) = (type in MaybeType) ? type.inner : type

# Whether there is a value: a maybe's flag, and always so for anything
# else. What was asked is released once it has answered.
def llvm_presence(emitter, type, name, operand)
  unless type in MaybeType
    return LLVMValue.new(emitter: llvm_drop(emitter, type, operand), operand: name == "some?" ? "true" : "false")
  end
  flag = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 0")
  released = llvm_drop(flag.emitter, type, operand)
  return LLVMValue.new(emitter: released, operand: flag.operand) if name == "some?"
  llvm_named(released, "xor i1 #{flag.operand}, true")
end

# The refusal for a method asked of nil, by the method's name.
def llvm_refuse_method(emitter, name)
  named = llvm_literal(emitter, name)
  llvm_line(named.emitter, "call void @portland_refuse_nil_method(ptr #{named.operand})")
end

# Every counted value this function's slots hold, released: written
# before each way out.
def llvm_release_held(emitter)
  mutable current = emitter
  emitter.held.each do |slot|
    loaded = llvm_named(current, "load #{llvm_type(type_at(slot, 1))}, ptr #{llvm_slot(slot[0])}")
    current = llvm_drop(loaded.emitter, type_at(slot, 1), loaded.operand)
  end
  current
end

# One more holder for a counted value. A maybe is retained through its
# value, which is nothing where there is none.
def llvm_retain(emitter, type, operand)
  return emitter unless llvm_counted?(type)
  if type in MaybeType
    held = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 1")
    return llvm_retain(held.emitter, type.inner, held.operand)
  end
  llvm_line(emitter, "call void @portland_retain(ptr #{operand})")
end

# A function's lines under a header written by the caller: a def's, the
# entry function's, or a block's. A block's captures are read out of its
# frame first, each as the address of a slot that lives in its writer,
# and after them, where the block yields, what its writer was handed.
def llvm_routine(routine)
  held = (routine.parameters + routine.locals).select { llvm_counted?(type_at(it, 1)) }
  mutable emitter = LLVMEmitter.new(lines: [routine.header, "entry:"], counter: 0, block: "entry", globals: [], prefix: routine.prefix, held: held, loops: [], frames: [], routines: [], answer: routine.answer, paired: routine.paired, returned: routine.returned)
  carried = llvm_frame_carried(routine.captures, routine.onward, routine.returns, routine.breaks)
  mutable position = 0
  carried.each do |kind|
    name = case kind
           when "block handed" then LLVM_BLOCK
           when "block frame" then LLVM_BLOCK_FRAME
           when "return" then LLVM_RETURN
           when "break" then LLVM_BREAK
           else llvm_slot(kind)
           end
    place = llvm_named(emitter, "getelementptr [#{carried.length} x ptr], ptr #{LLVM_FRAME}, i64 0, i64 #{position}")
    emitter = llvm_line(place.emitter, "#{name} = load ptr, ptr #{place.operand}")
    position += 1
  end
  # A def a block returns into keeps a place for the answer, whose
  # address is also what such a block leaves to.
  if routine.returned
    emitter = llvm_line(emitter, "#{LLVM_RETURN} = alloca #{routine.answer == NOTHING ? "i8" : llvm_type(routine.answer)}")
  end
  (routine.parameters + routine.locals).each do |slot|
    emitter = llvm_line(emitter, "#{llvm_slot(slot[0])} = alloca #{llvm_type(type_at(slot, 1))}")
  end
  # A local that holds a counted value starts empty, so releasing it before
  # it is bound does nothing.
  routine.locals.each do |local|
    starting = type_at(local, 1)
    emitter = llvm_line(emitter, "store #{llvm_type(starting)} #{llvm_zero(starting)}, ptr #{llvm_slot(local[0])}") if llvm_counted?(starting)
  end
  routine.parameters.each do |parameter|
    type = llvm_type(type_at(parameter, 1))
    emitter = llvm_line(emitter, "store #{type} #{llvm_local(parameter[0])}, ptr #{llvm_slot(parameter[0])}")
  end
  # The entry function's first act is to hand the runtime the command
  # line, for `System.arguments` to answer (#534).
  emitter = llvm_line(emitter, "call void @portland_start(i32 %\".count\", ptr %\".values\")") if routine.entry
  emitter = llvm_statements(emitter, routine.body)
  # Every path through a def or a block has returned by here; the entry
  # function falls off its end and answers success.
  finished = if routine.entry
    llvm_line(llvm_line(llvm_release_held(emitter), "call void @portland_exit_check()"), "ret i32 0")
  else
    llvm_line(emitter, "unreachable")
  end
  # The frames go first, ahead of everything the body wrote.
  finished.with(lines: finished.lines.slice(0, 2) + finished.frames + finished.lines.slice(2, finished.lines.length - 2))
end

# Whether two values of one plain type are equal. A String's `==` is
# canonical equivalence (ADR 0038), the runtime's to say, and never a
# comparison of two addresses.
def llvm_same(emitter, type, left, right)
  return llvm_named(emitter, "call zeroext i1 @portland_string_equal(ptr #{left}, ptr #{right})") if type == StringType.new
  # An array and a struct are equal by what they hold (#579), which the
  # runtime reads off the kind an array carries and the shape a struct
  # does.
  return llvm_named(emitter, "call zeroext i1 @portland_array_equal(ptr #{left}, ptr #{right})") if type in ArrayType
  return llvm_named(emitter, "call zeroext i1 @portland_struct_equal(ptr #{left}, ptr #{right})") if type in StructType
  llvm_named(emitter, "icmp eq #{llvm_type(type)} #{left}, #{right}")
end

# A struct's shape, as the lines that write it into the binary (#532):
# its name and each field's name as Strings that are never freed, and
# the shape itself, which is the name, the count of fields, and for each
# field the kind of slot it is and its name. A field that is a maybe says
# so in its kind (#553).
def llvm_shape(name, fields)
  mutable lines = [llvm_text_constant("#{llvm_shape_text(name)}", name)]
  mutable words = []
  mutable place = 0
  fields.each do |field|
    label = "@\".shape.#{name}.#{place}\""
    lines << llvm_text_constant(label, field[0])
    words << "i64 #{llvm_field_kind(type_at(field, 1))}"
    words << "i64 ptrtoint (ptr #{label} to i64)"
    place += 1
  end
  listed = "[#{words.length} x i64] [#{words.join(", ")}]"
  lines << "#{llvm_shape_name(name)} = private constant { ptr, i64, [#{words.length} x i64] } { ptr #{llvm_shape_text(name)}, i64 #{fields.length}, #{listed} }"
  lines
end

# The name a struct's shape goes by in the output, and its name's text.
def llvm_shape_name(name) = "@\".shape.#{name}\""

def llvm_shape_text(name) = "@\".shape.#{name}.name\""

# A maybe in its source form: its value's, or `nil`. Only the arm taken
# makes a String, so nothing is made that is not handed on.
def llvm_shown_maybe(emitter, type, operand)
  flag = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 0")
  number = flag.emitter.counter
  branched = llvm_line(flag.emitter, "br i1 #{flag.operand}, label %shown#{number}.some, label %shown#{number}.none")
  held = llvm_named(llvm_label(branched, "shown#{number}.some"), "extractvalue #{llvm_type(type)} #{operand}, 1")
  written = llvm_source(held.emitter, type.inner, held.operand)
  written_block = written.emitter.block
  absent = llvm_literal(llvm_label(llvm_line(written.emitter, "br label %shown#{number}.done"), "shown#{number}.none"), "nil")
  joined = llvm_label(llvm_line(absent.emitter, "br label %shown#{number}.done"), "shown#{number}.done")
  llvm_named(joined, "phi ptr [ #{written.operand}, %#{written_block} ], [ #{absent.operand}, %shown#{number}.none ]")
end

# A side of `==` as a flag and a value: a maybe's own, and for anything
# else, there and itself.
def llvm_sides(emitter, type, operand)
  return LLVMPair.new(emitter: emitter, left: "true", right: operand) unless type in MaybeType
  flag = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 0")
  held = llvm_named(flag.emitter, "extractvalue #{llvm_type(type)} #{operand}, 1")
  LLVMPair.new(emitter: held.emitter, left: flag.operand, right: held.operand)
end

def llvm_slot(name) = "%\"#{name}.slot\""

# A value's source form as a String, for a refusal to quote, and nothing
# where a maybe has no value. It is written only on a way out of the
# program, so what it makes is never released.
def llvm_source(emitter, type, operand)
  case type
  in IntegerType then llvm_named(emitter, "call ptr @portland_string_from_integer(i64 #{operand})")
  in BooleanType then llvm_named(emitter, "call ptr @portland_string_from_boolean(i1 zeroext #{operand})")
  in StringType then llvm_named(emitter, "call ptr @portland_string_inspect(ptr #{operand})")
  in MaybeType
    flag = llvm_named(emitter, "extractvalue #{llvm_type(type)} #{operand}, 0")
    held = llvm_named(flag.emitter, "extractvalue #{llvm_type(type)} #{operand}, 1")
    written = llvm_source(held.emitter, type.inner, held.operand)
    llvm_named(written.emitter, "select i1 #{flag.operand}, ptr #{written.operand}, ptr null")
  in StructType then llvm_named(emitter, "call ptr @portland_struct_to_string(ptr #{operand})")
  else llvm_named(emitter, "call ptr @portland_array_to_string(ptr #{operand})")
  end
end

def llvm_statement(emitter, statement)
  case statement
  in IntermediateStore(name:, value:)
    written = llvm_value(emitter, value)
    if llvm_counted?(value.type)
      # The slot takes the new value and lets go of the one it held.
      previous = llvm_named(written.emitter, "load #{llvm_type(value.type)}, ptr #{llvm_slot(name)}")
      stored = llvm_line(previous.emitter, "store #{llvm_type(value.type)} #{written.operand}, ptr #{llvm_slot(name)}")
      return llvm_drop(stored, value.type, previous.operand)
    end
    llvm_line(written.emitter, "store #{llvm_type(value.type)} #{written.operand}, ptr #{llvm_slot(name)}")
  # The value is computed first, since it may read the array. Then the
  # slot's own hold goes to the runtime, with nothing retained, and what
  # comes back is the slot's.
  in IntermediateAppend(name:, value:)
    written = llvm_value(emitter, value)
    held = llvm_named(written.emitter, "load ptr, ptr #{llvm_slot(name)}")
    grown = llvm_append(held.emitter, held.operand, value.type, written.operand)
    llvm_line(grown.emitter, "store ptr #{grown.operand}, ptr #{llvm_slot(name)}")
  # The runtime says the message and does not come back. Whatever is
  # written after needs a block of its own, though nothing reaches it.
  in IntermediatePanic(value:)
    written = llvm_value(emitter, value)
    stopped = llvm_line(llvm_line(written.emitter, "call void @portland_panic(ptr #{written.operand})"), "unreachable")
    llvm_label(stopped, "after#{stopped.counter}")
  in IntermediateReturn(value:)
    returned = if value.nil?
      llvm_line(llvm_release_held(emitter), emitter.paired ? "ret ptr null" : "ret void")
    else
      # The value is computed first: it may read a local the release
      # after it lets go of.
      written = llvm_value(emitter, value)
      llvm_answered(llvm_release_held(written.emitter), "null", written.operand)
    end
    # Whatever is written after a return needs a block of its own to sit
    # in, though nothing reaches it.
    llvm_label(returned, "after#{returned.counter}")
  # `return` or `break` in a block: a `return` stores what its def is to
  # answer in the place the def keeps for it, and either answers where it
  # is leaving to, with nothing for the block's own answer.
  in IntermediateLeave(kind:, value:)
    stored = if value.nil?
      emitter
    else
      written = llvm_value(emitter, value)
      llvm_line(written.emitter, "store #{llvm_type(value.type)} #{written.operand}, ptr #{LLVM_RETURN}")
    end
    left = llvm_answered(llvm_release_held(stored), kind == "return" ? LLVM_RETURN : LLVM_BREAK, nil)
    llvm_label(left, "after#{left.counter}")
  in IntermediatePrint(value:)
    written = llvm_value(emitter, value)
    if value.type == StringType.new
      printed = llvm_line(written.emitter, "call void @portland_puts_string(ptr #{written.operand})")
      return llvm_drop(printed, StringType.new, written.operand)
    end
    llvm_line(written.emitter, "call i32 (ptr, ...) @printf(ptr @.integer_line, i64 #{written.operand})")
  in IntermediateEvaluate(value:)
    written = llvm_value(emitter, value)
    llvm_drop(written.emitter, value.type, written.operand)
  in IntermediateLoop(condition:, body:)
    number = emitter.counter
    started = llvm_label(llvm_line(emitter, "br label %loop#{number}.test"), "loop#{number}.test")
    test = llvm_value(started, condition)
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %loop#{number}.body, label %loop#{number}.done")
    inside = llvm_label(branched, "loop#{number}.body")
    walked = llvm_statements(inside.with(loops: [number] + inside.loops), body)
    llvm_label(llvm_line(walked.with(loops: emitter.loops), "br label %loop#{number}.test"), "loop#{number}.done")
  # Out of the innermost loop, or on to its next turn. Whatever is written
  # after either needs a block of its own, though nothing reaches it.
  in IntermediateBreak
    left = llvm_line(emitter, "br label %loop#{emitter.loops.first}.done")
    llvm_label(left, "after#{left.counter}")
  in IntermediateNext
    left = llvm_line(emitter, "br label %loop#{emitter.loops.first}.test")
    llvm_label(left, "after#{left.counter}")
  in IntermediateBranch(condition:, then_body:, else_body:)
    test = llvm_value(emitter, condition)
    number = test.emitter.counter
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %if#{number}.then, label %if#{number}.else")
    taken = llvm_statements(llvm_label(branched, "if#{number}.then"), then_body)
    other = llvm_statements(llvm_label(llvm_line(taken, "br label %if#{number}.done"), "if#{number}.else"), else_body)
    llvm_label(llvm_line(other, "br label %if#{number}.done"), "if#{number}.done")
  end
end

def llvm_statements(emitter, statements)
  mutable current = emitter
  statements.each do |statement|
    current = llvm_statement(current, statement)
  end
  current
end

# A whole program as LLVM IR text.
def llvm_text(program)
  mutable globals = []
  mutable bodies = []
  mutable index = 0
  program.structs.each do |made|
    globals += llvm_shape(made[0], type_at(made, 1))
  end
  program.functions.each do |function|
    written = llvm_function(function, "f#{index}")
    globals += written.globals
    bodies += [""] + written.lines + ["}"] + written.routines
    index += 1
  end
  (globals + LLVM_PRELUDE + llvm_library_declarations + bodies).join("\n") + "\n"
end

# A String written into the binary under a name: the block a literal is,
# with the count that says it is never freed.
def llvm_text_constant(name, text)
  length = text.bytesize
  "#{name} = private unnamed_addr constant { i64, i64, [#{length} x i8] } { i64 -1, i64 #{length}, [#{length} x i8] c\"#{llvm_bytes(text)}\" }"
end

def llvm_type(type)
  case type
  in IntegerType then "i64"
  in BooleanType then "i1"
  in StringType then "ptr"
  in ArrayType then "ptr"
  in HashType then "ptr"
  in StructType then "ptr"
  in MaybeType then "{ i1, #{llvm_type(type.inner)} }"
  in NothingType then "void"
  else panic("llvm.pdx: no machine type for #{render_type(type)}")
  end
end

def llvm_value(emitter, value)
  case value
  in IntermediateConstant(type: StringType, value: text) then llvm_literal(emitter, text)
  # nil, held as a maybe, is the maybe that is not there; a bare `nil`
  # no one holds is nothing at all.
  in IntermediateConstant(type: MaybeType) then LLVMValue.new(emitter: emitter, operand: "zeroinitializer")
  in IntermediateConstant(type: NilType) then LLVMValue.new(emitter: emitter, operand: "null")
  in IntermediateConstant(value: literal) then LLVMValue.new(emitter: emitter, operand: literal.to_s)
  in IntermediateLocal(type:, name:)
    loaded = llvm_named(emitter, "load #{llvm_type(type)}, ptr #{llvm_slot(name)}")
    # The slot keeps its hold; whoever reads gets one of their own.
    LLVMValue.new(emitter: llvm_retain(loaded.emitter, type, loaded.operand), operand: loaded.operand)
  in IntermediateConcat(left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    sides = llvm_operands(second.emitter, "+", left.type, first.operand, right.type, second.operand)
    joined = llvm_named(sides.emitter, "call ptr @portland_string_concat(ptr #{sides.left}, ptr #{sides.right})")
    released = llvm_drop(llvm_drop(joined.emitter, StringType.new, sides.left), StringType.new, sides.right)
    LLVMValue.new(emitter: released, operand: joined.operand)
  # A value written out: a new String the runtime makes. An array asked
  # is released once it has answered, as a String inspected is.
  in IntermediateText(value: shown)
    written = llvm_value(emitter, shown)
    return llvm_named(written.emitter, "call ptr @portland_string_from_integer(i64 #{written.operand})") if shown.type == IntegerType.new
    return llvm_named(written.emitter, "call ptr @portland_string_from_boolean(i1 zeroext #{written.operand})") if shown.type == BooleanType.new
    writer = (shown.type in StructType) ? "portland_struct_to_string" : "portland_array_to_string"
    made = llvm_named(written.emitter, "call ptr @#{writer}(ptr #{written.operand})")
    LLVMValue.new(emitter: llvm_drop(made.emitter, shown.type, written.operand), operand: made.operand)
  in IntermediateInspect(value: shown)
    written = llvm_value(emitter, shown)
    made = if shown.type in MaybeType
      llvm_shown_maybe(written.emitter, shown.type, written.operand)
    else
      llvm_named(written.emitter, "call ptr @portland_string_inspect(ptr #{written.operand})")
    end
    LLVMValue.new(emitter: llvm_drop(made.emitter, shown.type, written.operand), operand: made.operand)
  in IntermediateArithmetic(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    sides = llvm_operands(second.emitter, operator, left.type, first.operand, right.type, second.operand)
    llvm_checked(sides.emitter, operator, sides.left, sides.right)
  in IntermediateComparison(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    # `==` and `!=` compare a maybe as it is; every other comparison, and
    # these between plain values, work on the values.
    if %w[== !=].include?(operator) && ((left.type in MaybeType) || (right.type in MaybeType))
      equal = llvm_equal_maybes(second.emitter, left.type, first.operand, right.type, second.operand)
      return equal if operator == "=="
      return llvm_named(equal.emitter, "xor i1 #{equal.operand}, true")
    end
    sides = llvm_operands(second.emitter, operator, left.type, first.operand, right.type, second.operand)
    plain = llvm_plain(left.type)
    # Strings order by their canonical text (ADR 0054), which the runtime
    # reads: before, the same, or after, held against nothing.
    if plain == StringType.new && !%w[== !=].include?(operator)
      order = llvm_named(sides.emitter, "call i64 @portland_string_order(ptr #{sides.left}, ptr #{sides.right})")
      released = llvm_drop(llvm_drop(order.emitter, plain, sides.left), plain, sides.right)
      return llvm_named(released, "icmp #{llvm_comparison(operator)} i64 #{order.operand}, 0")
    end
    if llvm_counted?(plain)
      equal = llvm_same(sides.emitter, plain, sides.left, sides.right)
      released = llvm_drop(llvm_drop(equal.emitter, plain, sides.left), plain, sides.right)
      return LLVMValue.new(emitter: released, operand: equal.operand) if operator == "=="
      return llvm_named(released, "xor i1 #{equal.operand}, true")
    end
    llvm_named(sides.emitter, "icmp #{llvm_comparison(operator)} #{llvm_type(plain)} #{sides.left}, #{sides.right}")
  in IntermediateDivision(operator:, left:, right:)
    first = llvm_value(emitter, left)
    second = llvm_value(first.emitter, right)
    sides = llvm_operands(second.emitter, operator, left.type, first.operand, right.type, second.operand)
    function = operator == "/" ? "portland_integer_divide" : "portland_integer_modulo"
    llvm_named(sides.emitter, "call i64 @#{function}(i64 #{sides.left}, i64 #{sides.right})")
  in IntermediateNegation(value: negated)
    written = llvm_value(emitter, negated)
    llvm_named(written.emitter, "call i64 @portland_integer_negate(i64 #{written.operand})")
  in IntermediateNot(value: inverted)
    written = llvm_value(emitter, inverted)
    llvm_named(written.emitter, "xor i1 #{written.operand}, true")
  in IntermediateLogical(operator:, left:, right:)
    first = llvm_value(emitter, left)
    number = first.emitter.counter
    # `&&` goes on to its right side when the left is true, `||` when it is
    # false; otherwise the left side is already the answer.
    decided = operator == "&&" ? "false" : "true"
    targets = operator == "&&" ? "label %logic#{number}.right, label %logic#{number}.done" : "label %logic#{number}.done, label %logic#{number}.right"
    first_block = first.emitter.block
    branched = llvm_line(first.emitter, "br i1 #{first.operand}, #{targets}")
    second = llvm_value(llvm_label(branched, "logic#{number}.right"), right)
    second_block = second.emitter.block
    joined = llvm_label(llvm_line(second.emitter, "br label %logic#{number}.done"), "logic#{number}.done")
    llvm_named(joined, "phi i1 [ #{decided}, %#{first_block} ], [ #{second.operand}, %#{second_block} ]")
  in IntermediateMethod(receiver:, name:)
    asked = llvm_value(emitter, receiver)
    return llvm_presence(asked.emitter, receiver.type, name, asked.operand) if name == "nil?" || name == "some?"
    # Every other method is asked of the value: a maybe is opened, and nil
    # refuses by the method's name.
    held = llvm_opened(asked.emitter, receiver.type, asked.operand) { |refusing| llvm_refuse_method(refusing, name) }
    llvm_method(held.emitter, llvm_plain(receiver.type), name, held.operand)
  # A method the runtime's library does (#560): the value asked and what
  # it is handed go over, each let go of once the call has answered, and
  # what comes back is held once. An Integer that may not be there comes
  # back as the least Integer where it is not.
  in IntermediateLibrary(type:, symbol:, receiver:, arguments:, words:)
    asked = llvm_value(emitter, receiver)
    mutable calling = asked.emitter
    mutable operands = ["#{llvm_type(receiver.type)} #{asked.operand}"]
    mutable passed = []
    mutable place = 0
    arguments.each do |argument|
      written = llvm_value(calling, argument)
      calling = written.emitter
      if type_at(words, place) == true
        word = llvm_word(calling, argument.type, written.operand)
        calling = word.emitter
        operands << "i64 #{word.operand}"
      else
        operands << "#{llvm_type(argument.type)} #{written.operand}"
      end
      passed << [argument.type, written.operand]
      place += 1
    end
    answered = llvm_named(calling, "call #{llvm_library_answer(type)} @#{symbol}(#{operands.join(", ")})")
    mutable done = llvm_drop(answered.emitter, receiver.type, asked.operand)
    passed.each do |given|
      done = llvm_drop(done, type_at(given, 0), type_at(given, 1))
    end
    return LLVMValue.new(emitter: done, operand: answered.operand) unless type in MaybeType
    # A String or an array that may not be there comes back as nothing.
    unless type == MaybeType.new(inner: IntegerType.new)
      shape = llvm_type(type)
      there = llvm_named(done, "icmp ne ptr #{answered.operand}, null")
      half = llvm_named(there.emitter, "insertvalue #{shape} undef, i1 #{there.operand}, 0")
      return llvm_named(half.emitter, "insertvalue #{shape} #{half.operand}, ptr #{answered.operand}, 1")
    end
    found = llvm_named(done, "icmp ne i64 #{answered.operand}, -9223372036854775808")
    flagged = llvm_named(found.emitter, "insertvalue { i1, i64 } undef, i1 #{found.operand}, 0")
    llvm_named(flagged.emitter, "insertvalue { i1, i64 } #{flagged.operand}, i64 #{answered.operand}, 1")
  # A maybe opened for `puts` or for a method: nil refuses in the seed's
  # sentence for that.
  in IntermediateOpen(value: held, name:)
    written = llvm_value(emitter, held)
    llvm_opened(written.emitter, held.type, written.operand) do |refusing|
      name == "puts" ? llvm_line(refusing, "call void @portland_refuse_nil_puts()") : llvm_refuse_method(refusing, name)
    end
  # A plain value as a maybe that is there.
  in IntermediateSome(type:, value: held)
    written = llvm_value(emitter, held)
    shape = llvm_type(type)
    llvm_named(written.emitter, "insertvalue #{shape} { i1 true, #{llvm_type(held.type)} undef }, #{llvm_type(held.type)} #{written.operand}, 1")
  # `maybe || fallback`: the value where there is one, whose hold passes
  # to the answer, and otherwise the fallback, computed only then. Where
  # the fallback is itself a maybe, so is the answer.
  in IntermediateDefault(type:, value: held, fallback:)
    written = llvm_value(emitter, held)
    flag = llvm_named(written.emitter, "extractvalue #{llvm_type(held.type)} #{written.operand}, 0")
    number = flag.emitter.counter
    branched = llvm_line(flag.emitter, "br i1 #{flag.operand}, label %default#{number}.some, label %default#{number}.none")
    there = llvm_label(branched, "default#{number}.some")
    kept = (type in MaybeType) ? LLVMValue.new(emitter: there, operand: written.operand) : llvm_named(there, "extractvalue #{llvm_type(held.type)} #{written.operand}, 1")
    other = llvm_value(llvm_label(llvm_line(kept.emitter, "br label %default#{number}.done"), "default#{number}.none"), fallback)
    other_block = other.emitter.block
    joined = llvm_label(llvm_line(other.emitter, "br label %default#{number}.done"), "default#{number}.done")
    llvm_named(joined, "phi #{llvm_type(type)} [ #{kept.operand}, %default#{number}.some ], [ #{other.operand}, %#{other_block} ]")
  # `array[index]`: a negative index counts from the end, and one past
  # either end reads nothing. An element read is held by whoever asked,
  # and the array asked is released once it has answered.
  in IntermediateIndex(type:, array:, index:)
    held = llvm_value(emitter, array)
    position = llvm_value(held.emitter, index)
    element = type.inner
    place = llvm_named(position.emitter, "getelementptr i64, ptr #{held.operand}, i64 1")
    length = llvm_named(place.emitter, "load i64, ptr #{place.operand}")
    negative = llvm_named(length.emitter, "icmp slt i64 #{position.operand}, 0")
    shifted = llvm_named(negative.emitter, "add i64 #{position.operand}, #{length.operand}")
    counted = llvm_named(shifted.emitter, "select i1 #{negative.operand}, i64 #{shifted.operand}, i64 #{position.operand}")
    inside = llvm_named(counted.emitter, "icmp ult i64 #{counted.operand}, #{length.operand}")
    number = inside.emitter.counter
    before = inside.emitter.block
    found = llvm_label(llvm_line(inside.emitter, "br i1 #{inside.operand}, label %index#{number}.found, label %index#{number}.done"), "index#{number}.found")
    offset = llvm_named(found, "add i64 #{counted.operand}, 4")
    slot = llvm_named(offset.emitter, "getelementptr i64, ptr #{held.operand}, i64 #{offset.operand}")
    read = llvm_element(slot.emitter, element, slot.operand)
    read_block = read.emitter.block
    joined = llvm_label(llvm_line(read.emitter, "br label %index#{number}.done"), "index#{number}.done")
    chosen = llvm_named(joined, "phi #{llvm_type(element)} [ #{read.operand}, %#{read_block} ], [ #{llvm_zero(element)}, %#{before} ]")
    flagged = llvm_named(chosen.emitter, "insertvalue #{llvm_type(type)} zeroinitializer, i1 #{inside.operand}, 0")
    made = llvm_named(flagged.emitter, "insertvalue #{llvm_type(type)} #{flagged.operand}, #{llvm_type(element)} #{chosen.operand}, 1")
    LLVMValue.new(emitter: llvm_drop(made.emitter, array.type, held.operand), operand: made.operand)
  in IntermediateCall(type:, target:, arguments:, block:)
    mutable current = emitter
    mutable operands = []
    arguments.each do |argument|
      written = llvm_value(current, argument)
      current = written.emitter
      operands << "#{llvm_type(argument.type)} #{written.operand}"
    end
    mutable handed = nil
    if block.some?
      handed = llvm_block(current, block)
      current = handed.emitter
      operands << "ptr #{handed.function}, ptr #{handed.frame}"
    end
    leaves = block.some? && block.leaves
    call = "call #{llvm_answer_type(type, leaves)} #{llvm_function_name(target)}(#{operands.join(", ")})"
    # A def handed a block that can leave answers where the leaving is to.
    return llvm_arrived(current, type, call, handed.token, nil, nil) if leaves
    # A call that answers nothing has no result to name.
    return LLVMValue.new(emitter: llvm_line(current, call), operand: "") if type == NOTHING
    llvm_named(current, call)
  # A literal: an array with room for its elements, each appended in
  # order. The empty one is the constant every `[]` starts as.
  in IntermediateArray(type:, elements:)
    return LLVMValue.new(emitter: emitter, operand: "@.empty_array") if elements.empty?
    held = type.element
    mutable made = llvm_named(emitter, "call ptr @portland_array_new(i64 #{llvm_array_kind(held)}, i64 #{elements.length})")
    elements.each do |element|
      written = llvm_value(made.emitter, element)
      made = llvm_append(written.emitter, made.operand, held, written.operand)
    end
    made
  # A Hash literal (#607): its keys and its values made as arrays are,
  # which the runtime takes both holds on and makes one Hash of.
  # The empty one is made with the kind its values will be, which the
  # Hash it was held as says.
  in IntermediateHash(type:, keys:, values:)
    if keys.elements.empty?
      return llvm_named(emitter, "call ptr @portland_hash_empty(i64 #{llvm_array_kind(type.value)})")
    end
    written_keys = llvm_value(emitter, keys)
    written_values = llvm_value(written_keys.emitter, values)
    llvm_named(written_values.emitter, "call ptr @portland_hash_new(ptr #{written_keys.operand}, ptr #{written_values.operand})")
  # `each`: the length is read once, since the array cannot change under
  # the walk, and the block's function is called for each element in
  # turn. The place the walk keeps its index is made at the top of the
  # function, as a frame is. The array is answered still held.
  in IntermediateWalk(type:, array:, block:)
    walked = llvm_value(emitter, array)
    handed = llvm_block(walked.emitter, block)
    number = handed.emitter.counter
    turn = "%\"walk.#{number}\""
    element = llvm_type(type.element)
    reserved = handed.emitter.with(frames: handed.emitter.frames + ["  #{turn} = alloca i64"])
    place = llvm_named(reserved, "getelementptr i64, ptr #{walked.operand}, i64 1")
    length = llvm_named(place.emitter, "load i64, ptr #{place.operand}")
    started = llvm_label(llvm_line(llvm_line(length.emitter, "store i64 0, ptr #{turn}"), "br label %walk#{number}.test"), "walk#{number}.test")
    index = llvm_named(started, "load i64, ptr #{turn}")
    more = llvm_named(index.emitter, "icmp slt i64 #{index.operand}, #{length.operand}")
    inside = llvm_label(llvm_line(more.emitter, "br i1 #{more.operand}, label %walk#{number}.body, label %walk#{number}.done"), "walk#{number}.body")
    offset = llvm_named(inside, "add i64 #{index.operand}, 4")
    slot = llvm_named(offset.emitter, "getelementptr i64, ptr #{walked.operand}, i64 #{offset.operand}")
    read = llvm_element(slot.emitter, type.element, slot.operand)
    call = "call #{llvm_answer_type(NOTHING, block.leaves)} #{handed.function}(ptr #{handed.frame}, #{element} #{read.operand})"
    # A block that can leave ends the walk: a `break` of its own goes
    # straight to the walk's end, and anything else leaves this function,
    # letting go of the array the walk was holding.
    called = block.leaves ? llvm_arrived(read.emitter, NOTHING, call, handed.token, "walk#{number}.done", [type, walked.operand]).emitter : llvm_line(read.emitter, call)
    following = llvm_named(called, "add i64 #{index.operand}, 1")
    stepped = llvm_line(following.emitter, "store i64 #{following.operand}, ptr #{turn}")
    finished = llvm_label(llvm_line(stepped, "br label %walk#{number}.test"), "walk#{number}.done")
    LLVMValue.new(emitter: finished, operand: walked.operand)
  # `count.times { … }` (#565): a loop that calls the block's function
  # with the turn it is on, where the block takes one. A `break` goes
  # straight to the loop's end, and anything else that leaves, leaves
  # this function.
  in IntermediateCount(count:, block:)
    counted = llvm_value(emitter, count)
    handed = llvm_block(counted.emitter, block)
    number = handed.emitter.counter
    turn = "%\"count.#{number}\""
    reserved = handed.emitter.with(frames: handed.emitter.frames + ["  #{turn} = alloca i64"])
    started = llvm_label(llvm_line(llvm_line(reserved, "store i64 0, ptr #{turn}"), "br label %count#{number}.test"), "count#{number}.test")
    index = llvm_named(started, "load i64, ptr #{turn}")
    more = llvm_named(index.emitter, "icmp slt i64 #{index.operand}, #{counted.operand}")
    inside = llvm_label(llvm_line(more.emitter, "br i1 #{more.operand}, label %count#{number}.body, label %count#{number}.done"), "count#{number}.body")
    given = block.parameters.empty? ? "" : ", i64 #{index.operand}"
    call = "call #{llvm_answer_type(NOTHING, block.leaves)} #{handed.function}(ptr #{handed.frame}#{given})"
    called = block.leaves ? llvm_arrived(inside, NOTHING, call, handed.token, "count#{number}.done", [IntegerType.new, counted.operand]).emitter : llvm_line(inside, call)
    following = llvm_named(called, "add i64 #{index.operand}, 1")
    stepped = llvm_line(following.emitter, "store i64 #{following.operand}, ptr #{turn}")
    finished = llvm_label(llvm_line(stepped, "br label %count#{number}.test"), "count#{number}.done")
    LLVMValue.new(emitter: finished, operand: counted.operand)
  # `System.arguments` is the runtime's to make. `System.read_file` hands
  # back the text or nothing, which is a maybe: there where it is not
  # nothing. The path asked with is let go of once it has answered.
  # `System.core_source` hands back a core file's text, which the runtime
  # carries; the name asked with is let go of the same way.
  in IntermediateSystem(type:, name:, arguments:)
    return llvm_named(emitter, "call ptr @portland_system_arguments()") if name == "arguments"
    named = llvm_value(emitter, arguments[0])
    if name == "core_source"
      carried = llvm_named(named.emitter, "call ptr @portland_system_core_source(ptr #{named.operand})")
      return LLVMValue.new(emitter: llvm_drop(carried.emitter, StringType.new, named.operand), operand: carried.operand)
    end
    read = llvm_named(named.emitter, "call ptr @portland_system_read_file(ptr #{named.operand})")
    released = llvm_drop(read.emitter, StringType.new, named.operand)
    there = llvm_named(released, "icmp ne ptr #{read.operand}, null")
    flagged = llvm_named(there.emitter, "insertvalue #{llvm_type(type)} zeroinitializer, i1 #{there.operand}, 0")
    llvm_named(flagged.emitter, "insertvalue #{llvm_type(type)} #{flagged.operand}, ptr #{read.operand}, 1")
  # `panic` where a value was to be: the runtime says the message and does
  # not come back, and what follows names a value no one reaches.
  # A struct with no method of the name asked (#572): the runtime says so
  # in the seed's words and the program stops.
  in IntermediateMissing(type:, record:, name:)
    asked = llvm_value(emitter, record)
    label = llvm_literal(asked.emitter, name)
    stopped = llvm_line(llvm_line(label.emitter, "call void @portland_struct_refuse_method(ptr #{asked.operand}, ptr #{label.operand})"), "unreachable")
    LLVMValue.new(emitter: llvm_label(stopped, "after#{stopped.counter}"), operand: llvm_zero(type))
  in IntermediateStop(type:, message:)
    written = llvm_value(emitter, message)
    stopped = llvm_line(llvm_line(written.emitter, "call void @portland_panic(ptr #{written.operand})"), "unreachable")
    LLVMValue.new(emitter: llvm_label(stopped, "after#{stopped.counter}"), operand: llvm_zero(type))
  # A struct made: a block of its shape from the runtime, and each field
  # stored as a word, in order. A counted field's hold passes to the
  # struct. A field that is a maybe is two words, whether it is there and
  # then its value (#553).
  in IntermediateRecord(type:, fields:)
    mutable made = llvm_named(emitter, "call ptr @portland_struct_new(ptr #{llvm_shape_name(type.name)})")
    record = made.operand
    mutable place = 0
    fields.each do |field|
      # A field that is only ever nil is left as the runtime made it:
      # two words of nothing (#572).
      if field.type == NilType.new
        place += 2
        next
      end
      written = llvm_value(made.emitter, field)
      mutable storing = written.emitter
      mutable stored = written.operand
      mutable stored_type = field.type
      if field.type in MaybeType
        stored_type = field.type.inner
        field_flag = llvm_named(storing, "extractvalue #{llvm_type(field.type)} #{written.operand}, 0")
        field_there = llvm_word(field_flag.emitter, BooleanType.new, field_flag.operand)
        flag_slot = llvm_named(field_there.emitter, "getelementptr i64, ptr #{record}, i64 #{place + 2}")
        field_value = llvm_named(llvm_line(flag_slot.emitter, "store i64 #{field_there.operand}, ptr #{flag_slot.operand}"), "extractvalue #{llvm_type(field.type)} #{written.operand}, 1")
        storing = field_value.emitter
        stored = field_value.operand
        place += 1
      end
      word = llvm_word(storing, stored_type, stored)
      slot = llvm_named(word.emitter, "getelementptr i64, ptr #{record}, i64 #{place + 2}")
      made = LLVMValue.new(emitter: llvm_line(slot.emitter, "store i64 #{word.operand}, ptr #{slot.operand}"), operand: record)
      place += 1
    end
    made
  # A field read: its word, held by whoever asked where it is counted, and
  # the struct asked let go of once it has answered. A maybe is read as
  # its two words (#553).
  in IntermediateField(type:, record:, index:)
    asked = llvm_value(emitter, record)
    # A field that is only ever nil holds nothing to read (#572).
    return LLVMValue.new(emitter: llvm_drop(asked.emitter, record.type, asked.operand), operand: "null") if type == NilType.new
    slot = llvm_named(asked.emitter, "getelementptr i64, ptr #{asked.operand}, i64 #{index + 2}")
    mutable read = nil
    if type in MaybeType
      maybe_shape = llvm_type(type)
      inner_shape = llvm_type(type.inner)
      field_flag = llvm_element(slot.emitter, BooleanType.new, slot.operand)
      value_slot = llvm_named(field_flag.emitter, "getelementptr i64, ptr #{asked.operand}, i64 #{index + 3}")
      field_value = llvm_element(value_slot.emitter, type.inner, value_slot.operand)
      half_made = llvm_named(field_value.emitter, "insertvalue #{maybe_shape} undef, i1 #{field_flag.operand}, 0")
      read = llvm_named(half_made.emitter, "insertvalue #{maybe_shape} #{half_made.operand}, #{inner_shape} #{field_value.operand}, 1")
    else
      read = llvm_element(slot.emitter, type, slot.operand)
    end
    LLVMValue.new(emitter: llvm_drop(read.emitter, record.type, asked.operand), operand: read.operand)
  # A field of one of several structs (#572): the runtime finds its slot
  # by name in whichever struct this is, and it is then read as any
  # field is.
  in IntermediateSought(type:, record:, name:)
    asked = llvm_value(emitter, record)
    label = llvm_literal(asked.emitter, name)
    slot = llvm_named(label.emitter, "call ptr @portland_struct_slot(ptr #{asked.operand}, ptr #{label.operand})")
    mutable read = nil
    if type in MaybeType
      maybe_shape = llvm_type(type)
      inner_shape = llvm_type(type.inner)
      field_flag = llvm_element(slot.emitter, BooleanType.new, slot.operand)
      value_slot = llvm_named(field_flag.emitter, "getelementptr i64, ptr #{slot.operand}, i64 1")
      field_value = llvm_element(value_slot.emitter, type.inner, value_slot.operand)
      half_made = llvm_named(field_value.emitter, "insertvalue #{maybe_shape} undef, i1 #{field_flag.operand}, 0")
      read = llvm_named(half_made.emitter, "insertvalue #{maybe_shape} #{half_made.operand}, #{inner_shape} #{field_value.operand}, 1")
    else
      read = llvm_element(slot.emitter, type, slot.operand)
    end
    LLVMValue.new(emitter: llvm_drop(read.emitter, record.type, asked.operand), operand: read.operand)
  # Whether one of several structs is the one named (#572): its shape is
  # the second word of its block, and a struct's shape is written once.
  in IntermediateShaped(value: tested, name:)
    asked = llvm_value(emitter, tested)
    # A maybe is the struct named only where it is there, which the
    # runtime asks of an address that may be nothing.
    if tested.type in MaybeType
      held = llvm_named(asked.emitter, "extractvalue #{llvm_type(tested.type)} #{asked.operand}, 1")
      named = llvm_named(held.emitter, "call zeroext i1 @portland_struct_is(ptr #{held.operand}, ptr #{llvm_shape_name(name)})")
      return LLVMValue.new(emitter: llvm_drop(named.emitter, tested.type, asked.operand), operand: named.operand)
    end
    place = llvm_named(asked.emitter, "getelementptr i64, ptr #{asked.operand}, i64 1")
    shape = llvm_named(place.emitter, "load ptr, ptr #{place.operand}")
    same = llvm_named(shape.emitter, "icmp eq ptr #{shape.operand}, #{llvm_shape_name(name)}")
    LLVMValue.new(emitter: llvm_drop(same.emitter, tested.type, asked.operand), operand: same.operand)
  # A `yield` calls the block this function was handed, with its frame
  # and then what is yielded.
  in IntermediateYield(type:, arguments:, leaves:)
    mutable current = emitter
    mutable operands = ["ptr #{LLVM_BLOCK_FRAME}"]
    arguments.each do |argument|
      written = llvm_value(current, argument)
      current = written.emitter
      operands << "#{llvm_type(argument.type)} #{written.operand}"
    end
    call = "call #{llvm_answer_type(type, leaves)} #{LLVM_BLOCK}(#{operands.join(", ")})"
    # A block that can leave answers where to, which is never here: it is
    # the caller's block, leaving to somewhere past this function.
    return llvm_arrived(current, type, call, nil, nil, nil) if leaves
    return LLVMValue.new(emitter: llvm_line(current, call), operand: "") if type == NOTHING
    llvm_named(current, call)
  in IntermediateChoice(type:, condition:, then_value:, else_value:)
    test = llvm_value(emitter, condition)
    number = test.emitter.counter
    branched = llvm_line(test.emitter, "br i1 #{test.operand}, label %choice#{number}.then, label %choice#{number}.else")
    taken = llvm_value(llvm_label(branched, "choice#{number}.then"), then_value)
    # An arm can open blocks of its own, so the block it ends in is asked
    # for, not assumed.
    taken_block = taken.emitter.block
    other = llvm_value(llvm_label(llvm_line(taken.emitter, "br label %choice#{number}.done"), "choice#{number}.else"), else_value)
    other_block = other.emitter.block
    joined = llvm_label(llvm_line(other.emitter, "br label %choice#{number}.done"), "choice#{number}.done")
    llvm_named(joined, "phi #{llvm_type(type)} [ #{taken.operand}, %#{taken_block} ], [ #{other.operand}, %#{other_block} ]")
  end
end

# A value as the one word a slot holds: an Integer as it is, a Boolean
# widened to one, and a String, an array, or a struct as its address.
def llvm_word(emitter, type, operand)
  case type
  in IntegerType then LLVMValue.new(emitter: emitter, operand: operand)
  in BooleanType then llvm_named(emitter, "zext i1 #{operand} to i64")
  else llvm_named(emitter, "ptrtoint ptr #{operand} to i64")
  end
end

# What a slot of this type holds before anything is stored in it, and
# what a maybe that is not there carries as its value.
def llvm_zero(type)
  case type
  in IntegerType then "0"
  in BooleanType then "false"
  in MaybeType then "zeroinitializer"
  else "null"
  end
end
