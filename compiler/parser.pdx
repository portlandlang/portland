# The Stage 1 main course: Portland's parser, written in Portland.
#
# A library: require_relative "parser", then parse_program(lex(source)).
# Structs are immutable, so parsing threads position through returns:
# every parse function takes (tokens, position) and answers a Step.
# AST nodes are structs; each prints itself via its sexp method (#27).
# The Rust seed parser is the reference; the ladder here mirrors it.
#
# To dump parse trees from the command line, see parse.pdx.

require_relative "lexer"

struct Step
  node
  position
end

# AST node structs, alphabetical. Each renders its own S-expression via a
# sexp method — polymorphic dispatch, no case ladder. The kind field stays
# for the evaluator's few remaining shape checks.

# `in 1 | 2` — first matching option wins.
# The rendering helpers every AST node shares — the compiler's first real trait
# (ADR 0028, #60's taste payoff): what was top-level helper soup, carried by
# the structs that use it instead.
# Parameter names dodge every carrier's field names on purpose: a trait
# method's parameters sit in the same no-shadow ladder as the including
# struct's fields, and the seed refuses a collision — which it did, for
# `arguments`, the moment CallNode carried this.
trait Sexp
  def sexp_list(items)
    items.map { it.sexp }.join(" ")
  end

  def headed_sexp(head, items)
    return "(#{head})" if items.empty?
    "(#{head} #{sexp_list(items)})"
  end

  def branch_sexp(head, items)
    return "(#{head})" if items.nil?
    headed_sexp(head, items)
  end

  def method_call_sexp(node, dot)
    plain = headed_sexp("#{dot} #{node.receiver.sexp} #{node.name}", node.arguments)
    return plain if node.block.nil?
    mutable spelled = "do"
    spelled << " |#{node.block.parameters.join(" ")}|" unless node.block.parameters.empty?
    inner = plain.slice(1, plain.length - 2)
    "(#{inner} #{headed_sexp(spelled, node.block.body)})"
  end
end

struct AlternativePatternNode
  kind
  options

  include Sexp

  def sexp
    headed_sexp("|", options)
  end
end

struct ArrayNode
  kind
  elements

  include Sexp

  def sexp
    headed_sexp("array", elements)
  end
end

# `in [a, b]` exact, `in [first, *rest]` with a trailing splat; rest_name
# is nil for an anonymous `*`.
struct ArrayPatternNode
  kind
  elements
  splat
  rest_name

  def sexp
    mutable parts = elements.map do |element|
      element.sexp
    end
    if splat
      mutable rest = "*"
      rest << rest_name if rest_name.some?
      parts << rest
    end
    return "(array-pattern)" if parts.empty?
    "(array-pattern #{parts.join(" ")})"
  end
end

struct AssignmentNode
  kind
  name
  value
  rebindable

  # A value-less node is a `mutable` parameter with no default; only the
  # mutable spelling can be value-less, so the plain arm never sees nil.
  def sexp
    return "(mutable= #{name})" if value.nil?
    return "(mutable= #{name} #{value.sexp})" if rebindable
    "(= #{name} #{value.sexp})"
  end
end

struct BinaryNode
  kind
  operator
  left
  right

  def sexp
    "(#{operator} #{left.sexp} #{right.sexp})"
  end
end

struct BlockNode
  kind
  parameters
  body
end

struct BooleanNode
  kind
  value

  def sexp
    value
  end
end

struct BreakNode
  kind

  def sexp
    "(break)"
  end
end

struct CallNode
  kind
  name
  arguments
  block

  include Sexp

  def sexp
    headed_sexp("call #{name}", arguments)
  end
end

# `yield` — run the block the enclosing method was handed.
struct YieldNode
  kind

  def sexp
    "(yield)"
  end
end

# `case/in` (ADR 0013): else_body is nil when absent.
struct CaseInNode
  kind
  subject
  branches
  else_body

  include Sexp

  def sexp
    mutable result = "(case #{subject.sexp}"
    branches.each do |branch|
      result << " #{branch.sexp}"
    end
    result << " #{headed_sexp("else", else_body)}" if else_body.some?
    result + ")"
  end
end

struct CaseNode
  kind
  subject
  branches
  else_body

  include Sexp

  def sexp
    mutable result = "(case #{subject.sexp}"
    branches.each do |branch|
      result << " #{headed_sexp("when #{sexp_list(branch.values)}", branch.body)}"
    end
    result << " #{headed_sexp("else", else_body)}" if else_body.some?
    result + ")"
  end
end

struct AliasNode
  kind
  new_name
  old_name

  def sexp
    "(alias " + new_name + " " + old_name + ")"
  end
end

struct DefNode
  kind
  name
  parameters
  body
  type_function

  include Sexp

  def sexp
    written = if type_function
      "self.#{name}"
    else
      name
    end
    mutable result = "(def #{written} #{headed_sexp("params", parameters)}"
    result << " #{sexp_list(body)}" unless body.empty?
    result + ")"
  end
end

struct ErrorNode
  kind
  message

  def sexp
    "(error #{message})"
  end
end

struct HashNode
  kind
  pairs

  include Sexp

  def sexp
    headed_sexp("hash", pairs)
  end
end

struct IdentifierNode
  kind
  name

  def sexp
    name
  end
end

# Exhibit B, resolved: an absent else is nil, distinct from a present,
# empty else (ADR 0012).
struct IfNode
  kind
  condition
  then_body
  else_body

  include Sexp

  def sexp
    mutable result = "(if #{condition.sexp} #{branch_sexp("then", then_body)}"
    result << " #{headed_sexp("else", else_body)}" if else_body.some?
    result + ")"
  end
end

# One `in` branch: guard is nil or an expression, evaluated after the
# pattern binds (ADR 0013 §4).
struct InBranchNode
  kind
  pattern
  guard
  body

  include Sexp

  def sexp
    mutable head = "in #{pattern.sexp}"
    head << " if #{guard.sexp}" if guard.some?
    headed_sexp(head, body)
  end
end

struct IndexNode
  kind
  receiver
  index

  def sexp
    "([] #{receiver.sexp} #{index.sexp})"
  end
end

struct FloatNode
  kind
  value

  def sexp
    value
  end
end

struct IntegerNode
  kind
  value

  def sexp
    value
  end
end

# `1..5` / `1...5`; start or end is nil for the beginless and endless
# forms (ADR 0019).
struct RangeNode
  kind
  start
  finish
  exclusive

  def sexp
    mutable result = "(range"
    result << " #{start.sexp}" if start.some?
    result << " #{finish.sexp}" if finish.some?
    result << " exclusive" if exclusive
    result + ")"
  end
end

struct KeywordArgumentNode
  kind
  label
  value

  def sexp
    "(: #{label} #{value.sexp})"
  end
end

# `label:` (required) or `label: default`; default is nil or a node —
# an honest maybe.
struct KeywordParameterNode
  kind
  name
  default

  def sexp
    return "(: #{name})" if default.nil?
    "(: #{name} #{default.sexp})"
  end
end

struct LogicalNode
  kind
  operator
  left
  right

  def sexp
    "(#{operator} #{left.sexp} #{right.sexp})"
  end
end

# `name << value` — rebinding append (ADR 0015).
struct AppendNode
  kind
  name
  value

  def sexp
    "(<< #{name} #{value.sexp})"
  end
end

# `name[index] = value` — a functional update rebound on the name.
struct IndexUpdateNode
  kind
  name
  index
  value

  def sexp
    "([]= #{name} #{index.sexp} #{value.sexp})"
  end
end

# `expr => pattern` — match or panic (rightward destructuring).
struct MatchAssertNode
  kind
  subject
  pattern

  def sexp
    "(=> #{subject.sexp} #{pattern.sexp})"
  end
end

# `expr in pattern` — a boolean test, binding captures on a hit.
struct MatchTestNode
  kind
  subject
  pattern

  def sexp
    "(in #{subject.sexp} #{pattern.sexp})"
  end
end

# Exhibit C, resolved: block is nil or a BlockNode — an honest maybe, no
# longer the empty-array absence pattern.
struct MethodCallNode
  kind
  receiver
  name
  arguments
  block

  include Sexp

  def sexp
    method_call_sexp(self, ".")
  end
end

struct NextNode
  kind

  def sexp
    "(next)"
  end
end

# Absence (ADR 0006): the literal has no payload, only its kind.
struct NilNode
  kind

  def sexp
    "nil"
  end
end

struct PairNode
  kind
  key
  value

  def sexp
    "(=> #{key.sexp} #{value.sexp})"
  end
end

# `self` — the receiver, inside a struct method.

struct SelfNode
  kind

  def sexp
    "self"
  end
end

# Exhibit A, resolved: bare `return` is a ReturnNode whose value is nil.
# This struct once had a ReturnBareNode twin because absence couldn't be
# said — the first real pull toward optionals, now speakable (ADR 0006).
# `in ^name` — compare against the variable's value instead of capturing.
struct PinNode
  kind
  name

  def sexp
    "(^ #{name})"
  end
end

struct ReturnNode
  kind
  value

  def sexp
    return "(return)" if value.nil?
    "(return #{value.sexp})"
  end
end

# `&.` — same shape as MethodCallNode; an absent receiver short-circuits.
struct SafeMethodCallNode
  kind
  receiver
  name
  arguments
  block

  include Sexp

  def sexp
    method_call_sexp(self, "&.")
  end
end

struct StringNode
  kind
  value

  def sexp
    encode_string(value)
  end
end

# `:name` — a symbol literal (ADR 0023). `value` holds the name without
# its colon, matching the seed.
struct SymbolNode
  kind
  value

  def sexp
    "(symbol " + value + ")"
  end
end

# `:paid(on: expr)` — an enum case carrying a keyword payload (ADR 0022).
struct EnumCaseNode
  kind
  name
  payload

  include Sexp

  def sexp
    "(enum_case " + name + " " + sexp_list(payload) + ")"
  end
end

# `enum Name ... end` — a closed vocabulary. Cases are `EnumCaseDeclNode`s.
struct EnumDefNode
  cases
  kind
  name

  include Sexp

  def sexp
    "(enum " + name + " " + sexp_list(cases) + ")"
  end
end

struct EnumCaseDeclNode
  kind
  labels
  name

  def sexp
    "(case " + name + " " + labels.join(" ") + ")"
  end
end

struct StructDefNode
  kind
  name
  fields
  includes
  methods
  nested
  type_functions

  include Sexp

  def sexp
    mutable result = "(struct #{name} #{fields.join(" ")}"
    result << " (include #{includes.join(" ")})" unless includes.empty?
    result << " #{sexp_list(methods)}" unless methods.empty?
    result << " #{sexp_list(type_functions)}" unless type_functions.empty?
    result << " #{sexp_list(nested)}" unless nested.empty?
    result + ")"
  end
end

# `together do ... end` — structured fork-join (ADR 0029). Lines are task
# nodes or ordinary statements, in written order.
struct TogetherNode
  kind
  lines

  include Sexp

  def sexp
    headed_sexp("together", lines)
  end
end

# One `~ name = expr` / `meanwhile name = expr` line.
struct TaskLineNode
  kind
  name
  value

  def sexp
    "(task #{name} #{value.sexp})"
  end
end

# `trait Name ... end` — a bundle of methods with no state (ADR 0028).
struct TraitDefNode
  kind
  name
  methods

  include Sexp

  def sexp
    "(trait #{name} #{sexp_list(methods)})"
  end
end

# `module Foo ... end` and `module Foo::Bar ... end` (ADR 0021) — both
# spellings build the same path, so they mean the same thing.
struct ModuleDefNode
  kind
  path
  body

  include Sexp

  def sexp
    mutable result = "(module #{path.join("::")}"
    result << " #{sexp_list(body)}" unless body.empty?
    result + ")"
  end
end

# `Foo::Bar` — naming a name inside a namespace. Naming only; invoking is
# a `.`, and `Foo::bar()` is a never-guess error.
struct PathNode
  kind
  parts

  def sexp
    "(:: #{parts.join(" ")})"
  end
end

# `in ReturnNode(value: nil)` — keyword-only; fields are [label, pattern]
# pairs (the `field:` bind-shorthand desugars to a capture at parse time).
# `in :paid(on:)` — an enum case pattern (ADR 0022).
struct EnumCasePatternNode
  kind
  name
  payload

  def sexp
    parts = payload.map do |entry|
      "(: #{entry[0]} #{entry[1].sexp})"
    end
    return "(enum_pattern #{name})" if parts.empty?
    "(enum_pattern #{name} #{parts.join(" ")})"
  end
end

struct StructPatternNode
  kind
  name
  fields

  def sexp
    parts = fields.map do |field|
      "(: #{field[0]} #{field[1].sexp})"
    end
    return "(pattern #{name})" if parts.empty?
    "(pattern #{name} #{parts.join(" ")})"
  end
end

struct UnaryNode
  kind
  operator
  operand

  def sexp
    "(#{operator} #{operand.sexp})"
  end
end

struct WhenNode
  kind
  values
  body
end

struct WhileNode
  kind
  condition
  body

  include Sexp

  def sexp
    headed_sexp("while #{condition.sexp}", body)
  end
end

struct WordArrayNode
  kind
  text

  def sexp
    text
  end
end

# Node builders, alphabetical.

def alternative_pattern_node(options)
  AlternativePatternNode.new(kind: "alternative_pattern", options: options)
end

def append_node(name, value)
  AppendNode.new(kind: "append", name: name, value: value)
end

def array_node(elements)
  ArrayNode.new(kind: "array", elements: elements)
end

def array_pattern_node(elements, splat, rest_name)
  ArrayPatternNode.new(kind: "array_pattern", elements: elements, splat: splat, rest_name: rest_name)
end

def assignment_node(name, value)
  AssignmentNode.new(kind: "assignment", name: name, value: value, rebindable: false)
end

# `mutable name = expr`, and a `mutable name` parameter (value nil there).
def mutable_assignment_node(name, value)
  AssignmentNode.new(kind: "assignment", name: name, value: value, rebindable: true)
end

def binary_node(operator, left, right)
  BinaryNode.new(kind: "binary", operator: operator, left: left, right: right)
end

def block_node(parameters, body)
  BlockNode.new(kind: "block", parameters: parameters, body: body)
end

def boolean_node(value)
  BooleanNode.new(kind: "boolean", value: value)
end

def break_node
  BreakNode.new(kind: "break")
end

def call_node(name, arguments)
  CallNode.new(kind: "call", name: name, arguments: arguments, block: nil)
end

def call_with_block_node(name, arguments, block)
  CallNode.new(kind: "call", name: name, arguments: arguments, block: block)
end

def yield_node
  YieldNode.new(kind: "yield")
end

def case_in_node(subject, branches, else_body)
  CaseInNode.new(kind: "case_in", subject: subject, branches: branches, else_body: else_body)
end

def case_node(subject, branches, else_body)
  CaseNode.new(kind: "case", subject: subject, branches: branches, else_body: else_body)
end

def def_node(name, parameters, body, type_function)
  DefNode.new(kind: "def", name: name, parameters: parameters, body: body, type_function: type_function)
end

def error_node(message)
  ErrorNode.new(kind: "error", message: message)
end

def hash_node(pairs)
  HashNode.new(kind: "hash", pairs: pairs)
end

def identifier_node(name)
  IdentifierNode.new(kind: "identifier", name: name)
end

def if_node(condition, then_body, else_body)
  IfNode.new(kind: "if", condition: condition, then_body: then_body, else_body: else_body)
end

def index_update_node(name, index, value)
  IndexUpdateNode.new(kind: "index_update", name: name, index: index, value: value)
end

def in_branch_node(pattern, guard, body)
  InBranchNode.new(kind: "in_branch", pattern: pattern, guard: guard, body: body)
end

def index_node(receiver, index)
  IndexNode.new(kind: "index", receiver: receiver, index: index)
end

# Both shed the underscores their token may carry (#71) — the lexer has
# already refused any underscore not sitting between digits — so the stored
# value and the S-expression dump hold bare digits, the seed's shape.
def float_node(value)
  FloatNode.new(kind: "float", value: value.split("_").join(""))
end

def integer_node(value)
  IntegerNode.new(kind: "integer", value: value.split("_").join(""))
end

def range_node(start, finish, exclusive)
  RangeNode.new(kind: "range", start: start, finish: finish, exclusive: exclusive)
end

def keyword_argument_node(label, value)
  KeywordArgumentNode.new(kind: "keyword_argument", label: label, value: value)
end

def keyword_parameter_node(name, default)
  KeywordParameterNode.new(kind: "keyword_parameter", name: name, default: default)
end

def logical_node(operator, left, right)
  LogicalNode.new(kind: "logical", operator: operator, left: left, right: right)
end

def match_assert_node(subject, pattern)
  MatchAssertNode.new(kind: "match_assert", subject: subject, pattern: pattern)
end

def match_test_node(subject, pattern)
  MatchTestNode.new(kind: "match_test", subject: subject, pattern: pattern)
end

def method_call_node(receiver, name, arguments, block)
  MethodCallNode.new(kind: "method_call", receiver: receiver, name: name, arguments: arguments, block: block)
end

def next_node
  NextNode.new(kind: "next")
end

def nil_node
  NilNode.new(kind: "nil")
end

def pair_node(key, value)
  PairNode.new(kind: "pair", key: key, value: value)
end

def pin_node(name)
  PinNode.new(kind: "pin", name: name)
end

def return_bare_node
  return_node(nil)
end

def return_node(value)
  ReturnNode.new(kind: "return", value: value)
end

def safe_method_call_node(receiver, name, arguments, block)
  SafeMethodCallNode.new(kind: "safe_method_call", receiver: receiver, name: name, arguments: arguments, block: block)
end

def string_node(value)
  StringNode.new(kind: "string", value: value)
end

def symbol_node(value)
  SymbolNode.new(kind: "symbol", value: value)
end

def enum_case_node(name, payload)
  EnumCaseNode.new(kind: "enum_case", name: name, payload: payload)
end

def enum_def_node(name, cases)
  EnumDefNode.new(cases: cases, kind: "enum_def", name: name)
end

def enum_case_decl_node(name, labels)
  EnumCaseDeclNode.new(kind: "enum_case_decl", labels: labels, name: name)
end

# The name inside a symbol token: `:paid` -> `paid`, `:"odd key"` -> `odd key`.
def symbol_name(text)
  inner = text.slice(1, text.length - 1)
  return inner.slice(1, inner.length - 2) if inner.start_with?("\"")

  inner
end

def self_node
  SelfNode.new(kind: "self")
end

def struct_def_node(name, fields, includes, methods, nested, type_functions)
  StructDefNode.new(kind: "struct_def", name: name, fields: fields, includes: includes, methods: methods, nested: nested, type_functions: type_functions)
end

def trait_def_node(name, methods)
  TraitDefNode.new(kind: "trait_def", name: name, methods: methods)
end

def together_node(lines)
  TogetherNode.new(kind: "together", lines: lines)
end

def task_line_node(name, value)
  TaskLineNode.new(kind: "task_line", name: name, value: value)
end

def module_def_node(path, body)
  ModuleDefNode.new(kind: "module_def", path: path, body: body)
end

def path_node(parts)
  PathNode.new(kind: "path", parts: parts)
end

def struct_pattern_node(name, fields)
  StructPatternNode.new(kind: "struct_pattern", name: name, fields: fields)
end

def enum_case_pattern_node(name, payload)
  EnumCasePatternNode.new(kind: "enum_case_pattern", name: name, payload: payload)
end

def unary_node(operator, operand)
  UnaryNode.new(kind: "unary", operator: operator, operand: operand)
end

def when_node(values, body)
  WhenNode.new(kind: "when", values: values, body: body)
end

def while_node(condition, body)
  WhileNode.new(kind: "while", condition: condition, body: body)
end

def word_array_node(text)
  WordArrayNode.new(kind: "word_array", text: text)
end

# — parsing —

# True when the token at position is an operator with one of these texts.
def operator_at?(tokens, position, texts)
  return false if position >= tokens.length
  token = tokens[position]
  token.operator? && texts.include?(token.text)
end

def keyword_at?(tokens, position, texts)
  return false if position >= tokens.length
  token = tokens[position]
  token.keyword? && texts.include?(token.text)
end

def statement_boundary?(tokens, position)
  position >= tokens.length || tokens[position].newline?
end

def parse_expression(tokens, position)
  step = parse_range(tokens, position)
  # One-line pattern test (ADR 0013 §4): `expr in pattern` is a boolean,
  # binding its captures on a hit. Binds loosest of all.
  return step unless keyword_at?(tokens, step.position, %w[in])
  pattern = parse_pattern(tokens, step.position + 1)
  Step.new(node: match_test_node(step.node, pattern.node), position: pattern.position)
end

# `1..5` / `1...5`, plus endless and beginless (ADR 0019). Binds looser
# than everything but `in`.
def parse_range(tokens, position)
  # Beginless: the operator leads, so there is nothing to parse first.
  if operator_at?(tokens, position, %w[.. ...])
    exclusive = tokens[position].text == "..."
    finish = parse_logical_or(tokens, position + 1)
    return Step.new(node: range_node(nil, finish.node, exclusive), position: finish.position)
  end
  step = parse_logical_or(tokens, position)
  return step unless operator_at?(tokens, step.position, %w[.. ...])
  exclusive = tokens[step.position].text == "..."
  after = step.position + 1
  return Step.new(node: range_node(step.node, nil, exclusive), position: after) if range_closes?(tokens, after)
  finish = parse_logical_or(tokens, after)
  Step.new(node: range_node(step.node, finish.node, exclusive), position: finish.position)
end

# A range closes when the next meaningful token cannot continue an
# expression (ADR 0019 §3). The compiler is the syntax half; the seed is the
# oracle for the never-guess error, so an ambiguous line just closes here.
def range_closes?(tokens, position)
  return true if position >= tokens.length
  token = tokens[position]
  return true if token.newline?
  return true if token.operator? && %w[\] ) } ,].include?(token.text)
  return true if token.keyword? && %w[then end else elsif in when if unless].include?(token.text)
  false
end

# `or` is dead-identical to `||` (ADR 0007): word forms normalize to the
# sigil in the tree itself, so the two spellings cannot drift apart.
def parse_logical_or(tokens, position)
  mutable step = parse_logical_and(tokens, position)
  while operator_at?(tokens, step.position, %w[||]) || keyword_at?(tokens, step.position, %w[or])
    right = parse_or_right(tokens, step.position + 1)
    step = Step.new(node: logical_node("||", step.node, right.node), position: right.position)
  end
  step
end

# The diverging right side of an or-guard (ADR 0007/0008): return/break/next
# unwind past the binding, and command-form `panic "why"` is the one
# paren-less command allowed off statement position — the blessed assertion.
def parse_or_right(tokens, position)
  return Step.new(node: break_node, position: position + 1) if keyword_at?(tokens, position, %w[break])
  return Step.new(node: next_node, position: position + 1) if keyword_at?(tokens, position, %w[next])
  if keyword_at?(tokens, position, %w[return])
    after = position + 1
    if statement_boundary?(tokens, after) || keyword_at?(tokens, after, %w[if unless])
      return Step.new(node: return_bare_node, position: after)
    end
    value = parse_expression(tokens, after)
    return Step.new(node: return_node(value.node), position: value.position)
  end
  if or_panic_command?(tokens, position)
    message = parse_expression(tokens, position + 1)
    return Step.new(node: call_node("panic", [message.node]), position: message.position)
  end
  parse_logical_and(tokens, position)
end

def or_panic_command?(tokens, position)
  return false if position + 1 >= tokens.length
  token = tokens[position]
  message = tokens[position + 1]
  token.identifier? && token.text == "panic" && message.string?
end

def parse_logical_and(tokens, position)
  mutable step = parse_comparison(tokens, position)
  while operator_at?(tokens, step.position, %w[&&]) || keyword_at?(tokens, step.position, %w[and])
    right = parse_comparison(tokens, step.position + 1)
    step = Step.new(node: logical_node("&&", step.node, right.node), position: right.position)
  end
  step
end

def parse_comparison(tokens, position)
  mutable step = parse_addition(tokens, position)
  while operator_at?(tokens, step.position, %w[== != < <= > >=])
    operator = tokens[step.position].text
    right = parse_addition(tokens, step.position + 1)
    step = Step.new(node: binary_node(operator, step.node, right.node), position: right.position)
  end
  step
end

def parse_addition(tokens, position)
  mutable step = parse_multiplication(tokens, position)
  while operator_at?(tokens, step.position, %w[+ -])
    operator = tokens[step.position].text
    right = parse_multiplication(tokens, step.position + 1)
    step = Step.new(node: binary_node(operator, step.node, right.node), position: right.position)
  end
  step
end

def parse_multiplication(tokens, position)
  mutable step = parse_unary(tokens, position)
  while operator_at?(tokens, step.position, %w[* / %])
    operator = tokens[step.position].text
    right = parse_unary(tokens, step.position + 1)
    step = Step.new(node: binary_node(operator, step.node, right.node), position: right.position)
  end
  step
end

# `**` (ADR 0033): right-associative — `2 ** 3 ** 2` is the tower reading,
# mathematics' own — binding above `*` and below a leading minus, so
# `-2 ** 2` is `-4` here as it is in Ruby, Python, and Fortran. The right
# side parses through parse_unary, which is what makes `2 ** -x` legal and
# the tower right-associative at once.
def parse_exponent_operand(tokens, position)
  step = parse_postfix(tokens, position)
  if operator_at?(tokens, step.position, %w[**])
    right = parse_unary(tokens, step.position + 1)
    return Step.new(node: binary_node("**", step.node, right.node), position: right.position)
  end
  step
end

# The one corner where Ruby's literal fusion and its precedence contradict
# each other — `-5.abs ** 2` is 25 there while `-5 ** 2` is -25 — refuses
# instead of picking a side (ADR 0033). The seed's wording.
def chained_negative_error
  error_node("a chained negative literal under ** is ambiguous — write ((-2).abs) ** 2 or -(2.abs ** 2)")
end

def parse_unary(tokens, position)
  # Ruby-style: -5 is a negative literal, so -5.abs is (. -5 abs) — and the
  # fusion yields to `**`: a minus before `**` applies last (ADR 0033), so
  # `-2 ** 2` is `-(2 ** 2)`, one recitable rule shared with Ruby.
  if operator_at?(tokens, position, %w[-]) && position + 1 < tokens.length && tokens[position + 1].integer?
    if operator_at?(tokens, position + 2, %w[**])
      right = parse_unary(tokens, position + 3)
      power = binary_node("**", integer_node(tokens[position + 1].text), right.node)
      return Step.new(node: unary_node("-", power), position: right.position)
    end
    literal = Step.new(node: integer_node("-" + tokens[position + 1].text), position: position + 2)
    chained = postfix_from(tokens, literal)
    return Step.new(node: chained_negative_error, position: chained.position + 1) if operator_at?(tokens, chained.position, %w[**])
    return chained
  end
  # The float twin of the branch above — the seed fuses `-2.5` the same way,
  # and the compiler silently did not until the `**` work made the gap loud.
  if operator_at?(tokens, position, %w[-]) && position + 1 < tokens.length && tokens[position + 1].float?
    if operator_at?(tokens, position + 2, %w[**])
      right = parse_unary(tokens, position + 3)
      power = binary_node("**", float_node(tokens[position + 1].text), right.node)
      return Step.new(node: unary_node("-", power), position: right.position)
    end
    literal = Step.new(node: float_node("-" + tokens[position + 1].text), position: position + 2)
    chained = postfix_from(tokens, literal)
    return Step.new(node: chained_negative_error, position: chained.position + 1) if operator_at?(tokens, chained.position, %w[**])
    return chained
  end
  if operator_at?(tokens, position, %w[! -])
    operator = tokens[position].text
    # A minus on anything else applies last too: `-x ** 2` is `-(x ** 2)`,
    # exactly Ruby's answer — the recursion reaches the exponent level for
    # plain operands and keeps stacked signs legal.
    operand = parse_unary(tokens, position + 1)
    return Step.new(node: unary_node(operator, operand.node), position: operand.position)
  end
  # `not` is dead-identical to `!` (ADR 0007).
  if keyword_at?(tokens, position, %w[not])
    operand = parse_unary(tokens, position + 1)
    return Step.new(node: unary_node("!", operand.node), position: operand.position)
  end
  parse_exponent_operand(tokens, position)
end

def parse_postfix(tokens, position)
  postfix_from(tokens, parse_primary(tokens, position))
end

# Chained `.method` calls and `[index]`, binding tighter than any operator.
# A chain may continue on the next line when that line leads with a dot.
def postfix_from(tokens, mutable step)
  while true
    position = step.position
    if operator_at?(tokens, position, %w[.])
      step = parse_dot(tokens, step.node, position + 1, false)
      next
    end
    if operator_at?(tokens, position, %w[&.])
      step = parse_dot(tokens, step.node, position + 1, true)
      next
    end
    if operator_at?(tokens, position, ["["])
      step = parse_index(tokens, step.node, position + 1)
      next
    end
    if newline_then_dot?(tokens, position)
      step = Step.new(node: step.node, position: skip_newlines_at(tokens, position))
      next
    end
    break
  end
  step
end

def parse_dot(tokens, receiver, mutable position, safe)
  if position >= tokens.length
    return Step.new(node: error_node("expected method name after dot"), position: position)
  end
  token = tokens[position]
  # `next` is loop control as a statement but never a receiver's message, so
  # after a dot it can only be a method name — admitted narrowly (#79), not
  # keywords wholesale.
  keyword_method = token.keyword? && token.text == "next"
  unless token.identifier? || keyword_method
    return Step.new(node: error_node("expected method name after dot, got #{token.text}"), position: position + 1)
  end
  position += 1
  # A `!` in the name is just the name (ADR 0044): Ruby's suffix
  # convention, back whole — propagation is the explicit toolkit.
  name = token.text
  mutable arguments = []
  if operator_at?(tokens, position, %w[(]) && !tokens[position].leading_space
    argument_step = parse_arguments(tokens, position + 1)
    arguments = argument_step.node
    position = argument_step.position
  elsif dotted_ambiguous?(tokens, position)
    return Step.new(node: error_node(dotted_ambiguity_message(name, tokens, position)), position: skip_line_at(tokens, position))
  elsif command_start?(tokens, position)
    # Paren-less arguments on a dot call (#68) — `expect(x).to eq(y)`, the
    # mirror of parse_command one dot deeper: the same start test, the same
    # refusals, the same truncation so an opener past the arguments belongs
    # to the outermost call and never to an argument.
    opener = command_opener_at(tokens, position)
    argument_tokens = if opener < 0
      tokens
    else
      tokens[0..opener - 1]
    end
    mutable step = parse_argument(argument_tokens, position)
    arguments << step.node
    position = step.position
    while operator_at?(argument_tokens, position, %w[,])
      step = parse_argument(argument_tokens, position + 1)
      arguments << step.node
      position = step.position
    end
    unless opener < 0
      if keyword_at?(tokens, opener, %w[do])
        handed_block = parse_block(tokens, opener + 1, false)
        handed = if safe
          safe_method_call_node(receiver, name, arguments, handed_block.node)
        else
          method_call_node(receiver, name, arguments, handed_block.node)
        end
        return Step.new(node: handed, position: handed_block.position)
      end
      # ADR 0016: a bare `{` after an argument has two or three genuine
      # readings. Name them all and let the author pick with a paren.
      message = brace_ambiguity_message(name, arguments.last, tokens, opener)
      return Step.new(node: error_node(message), position: skip_line_at(tokens, opener))
    end
    node = if safe
      safe_method_call_node(receiver, name, arguments, nil)
    else
      method_call_node(receiver, name, arguments, nil)
    end
    return Step.new(node: node, position: position)
  end
  # Exhibit C, resolved: an absent block is nil, not an empty array.
  mutable block = nil
  # `do ... end` and `{ ... }` are dead-identical (ADR 0016).
  if keyword_at?(tokens, position, %w[do]) || operator_at?(tokens, position, %w[{])
    braced = operator_at?(tokens, position, %w[{])
    block_step = parse_block(tokens, position + 1, braced)
    block = block_step.node
    position = block_step.position
  end
  node = if safe
    safe_method_call_node(receiver, name, arguments, block)
  else
    method_call_node(receiver, name, arguments, block)
  end
  Step.new(node: node, position: position)
end

# The never-guess shapes after a dot call's name, refused with the bare
# command's wordings — the rewrites spell the bare method name, since a
# receiver is an expression neither oracle can faithfully re-print.
def dotted_ambiguous?(tokens, position)
  return false if position >= tokens.length
  token = tokens[position]
  return false unless token.operator? && token.leading_space
  if token.text == "-"
    after = position + 1
    return false if after >= tokens.length
    return !tokens[after].leading_space
  end
  token.text == "[" || token.text == "("
end

def dotted_ambiguity_message(name, tokens, position)
  following = tokens[position].text
  if following == "-"
    argument = tokens[position + 1].text
    return "ambiguous without parens — write #{name}(-#{argument}) or #{name} - #{argument}"
  end
  if following == "["
    return "ambiguous without parens — write #{name}([...]) to pass an array or #{name}[...] to index"
  end
  "ambiguous without parens — write #{name}(...) with no space to call"
end

# `do |params| ... end`, position already past the `do`.
def parse_block(tokens, mutable position, braced)
  mutable parameters = []
  mutable refused = nil
  if operator_at?(tokens, position, %w[|])
    position += 1
    while position < tokens.length && tokens[position].identifier?
      # A `!` parameter would be unreachable (ADR 0027); the refusal rides
      # in the body, so the block's shape survives for the caller.
      refused = bang_binding_error(tokens[position].text) if bang_name?(tokens[position].text)
      parameters << tokens[position].text
      position += 1
      position += 1 if operator_at?(tokens, position, %w[,])
    end
    if operator_at?(tokens, position, %w[|])
      position += 1
    else
      return Step.new(node: error_node("expected | to close block parameters"), position: position)
    end
  end
  body_start = position
  if braced
    body = parse_braced_body(tokens, position)
    # A diagnostic replaces the body rather than the block, so the outer
    # parse stays in sync and the error surfaces when the block runs.
    statements = if refused.nil?
      diagnosed_body(body.node, parameters, tokens, body_start, body.position)
    else
      [refused]
    end
    parameters = implicit_parameters(parameters, tokens, body_start, body.position)
    if operator_at?(tokens, body.position, ["}"])
      return Step.new(node: block_node(parameters, statements), position: body.position + 1)
    end
    return Step.new(node: error_node("expected } to close {"), position: body.position)
  end
  body = parse_body(tokens, position, %w[end])
  statements = if refused.nil?
    diagnosed_body(body.node, parameters, tokens, body_start, body.position)
  else
    [refused]
  end
  parameters = implicit_parameters(parameters, tokens, body_start, body.position)
  if keyword_at?(tokens, body.position, %w[end])
    return Step.new(node: block_node(parameters, statements), position: body.position + 1)
  end
  Step.new(node: error_node("expected end to close do"), position: body.position)
end

# The block's body, or a single diagnostic if the block breaks an `it`
# rule the compiler can check.
def diagnosed_body(statements, parameters, tokens, start, finish)
  mixed = mixed_it_error(parameters, tokens, start, finish)
  return [mixed] if mixed.some?
  statements
end

# Does this token range name `it` at all? Interpolations count (#47): the
# `it` of `{ "x #{it}" }` sits inside a string token, so the scan lexes each
# interpolation and asks the same question of what comes out.
def names_it?(tokens, start, finish)
  mutable index = start
  while index < finish
    token = tokens[index]
    return true if token.identifier? && token.text == "it"
    return true if token.string? && interpolation_names_it?(token.text)
    index += 1
  end
  false
end

# The interpolations of a double-quoted lexeme, each lexed and scanned as a
# token range of its own — which recurses through a string inside a string.
def interpolation_names_it?(lexeme)
  return false if lexeme.slice(0, 1) == "'"
  characters = lexeme.slice(1, lexeme.length - 2).chars
  mutable index = 0
  while index < characters.length
    character = characters[index]
    if character == "\\"
      index += 2
      next
    end
    if character == "#" && index + 1 < characters.length && characters[index + 1] == "{"
      inner = read_inner_source(characters, index + 2)
      inner_tokens = lex(inner.node)
      return true if names_it?(inner_tokens, 0, inner_tokens.length)
      index = inner.position
      next
    end
    index += 1
  end
  false
end

# Does this token range open a block of its own?
def opens_a_block?(tokens, start, finish)
  mutable index = start
  while index < finish
    token = tokens[index]
    return true if token.keyword? && token.text == "do"
    return true if token.operator? && token.text == "{"
    index += 1
  end
  false
end

# ADR 0017: `it` alongside declared `|parameters|` is a shadow, and
# shadows error. The compiler catches this one — but only when the body opens
# no block of its own, since a flat token scan cannot tell an `it` of
# *this* block from one belonging to a nested block. Where it can't tell,
# it declines to guess and leaves the seed as the oracle.
def mixed_it_error(parameters, tokens, start, finish)
  return nil if parameters.empty?
  return nil if opens_a_block?(tokens, start, finish)
  return nil unless names_it?(tokens, start, finish)
  error_node("`it` in a block that declares |#{parameters.join(", ")}| — use one or the other")
end

# ADR 0017: naming `it` declares the block's implicit parameter. Crude
# divergence: the compiler scans the body's tokens rather than tracking
# frames, so it catches the mixing rule (above) but not the two that need
# frames — a nested `it`, or a local of that name. The seed is the
# enforcement oracle for those, and they cannot appear in a program the
# seed accepts.
def implicit_parameters(parameters, tokens, start, finish)
  return parameters unless parameters.empty?
  return ["it"] if names_it?(tokens, start, finish)
  parameters
end

# Statements inside `{ ... }`, up to the closing brace. A one-liner needs
# no statement boundary — the brace itself ends the last statement.
def parse_braced_body(tokens, mutable position)
  mutable nodes = []
  position = skip_newlines_at(tokens, position)
  while true
    if position >= tokens.length || operator_at?(tokens, position, ["}"])
      return Step.new(node: nodes, position: position)
    end
    step = parse_statement_with_guard(tokens, position)
    nodes << step.node
    position = step.position
    return Step.new(node: nodes, position: position) if operator_at?(tokens, position, ["}"])
    unless statement_boundary?(tokens, position)
      nodes << error_node("expected newline after statement, got #{tokens[position].text}")
      while position < tokens.length && !tokens[position].newline?
        position += 1
      end
    end
    position = skip_newlines_at(tokens, position)
  end
end

def parse_index(tokens, receiver, position)
  inner = parse_expression(tokens, position)
  if operator_at?(tokens, inner.position, ["]"])
    return Step.new(node: index_node(receiver, inner.node), position: inner.position + 1)
  end
  Step.new(node: error_node("expected closing bracket"), position: inner.position)
end

# Parse a comma-separated argument list, consuming the closing paren.
# The Step's node is the array of argument nodes.
def parse_arguments(tokens, mutable position)
  mutable arguments = []
  if operator_at?(tokens, position, %w[)])
    return Step.new(node: arguments, position: position + 1)
  end
  mutable step = parse_argument(tokens, position)
  arguments << step.node
  position = step.position
  while operator_at?(tokens, position, %w[,])
    step = parse_argument(tokens, position + 1)
    arguments << step.node
    position = step.position
  end
  if operator_at?(tokens, position, %w[)])
    return Step.new(node: arguments, position: position + 1)
  end
  Step.new(node: [error_node("expected closing paren after arguments")], position: position)
end

# `[a, b, c]` — position already past the opening bracket.
def parse_array(tokens, mutable position)
  mutable elements = []
  if operator_at?(tokens, position, ["]"])
    return Step.new(node: array_node(elements), position: position + 1)
  end
  mutable step = parse_expression(tokens, position)
  elements << step.node
  position = step.position
  while operator_at?(tokens, position, %w[,])
    step = parse_expression(tokens, position + 1)
    elements << step.node
    position = step.position
  end
  if operator_at?(tokens, position, ["]"])
    return Step.new(node: array_node(elements), position: position + 1)
  end
  Step.new(node: error_node("expected closing bracket in array"), position: position)
end

# `{key => value, ...}` — position already past the opening brace.
# `:paid(on: expr)` — keyword-only payload arguments (ADR 0022 §1).
def parse_enum_case(tokens, name, mutable position)
  mutable payload = []
  while true
    label = tokens[position]
    unless label.identifier? && operator_at?(tokens, position + 1, %w[:])
      return Step.new(node: error_node("enum payloads are keyword-only"), position: position)
    end
    value = parse_expression(tokens, position + 2)
    payload << keyword_argument_node(label.text, value.node)
    position = value.position
    if operator_at?(tokens, position, %w[,])
      position += 1
      next
    end
    if operator_at?(tokens, position, [")"])
      return Step.new(node: enum_case_node(name, payload), position: position + 1)
    end
    return Step.new(node: error_node("expected ) to close an enum payload"), position: position)
  end
end

def parse_hash(tokens, mutable position)
  mutable pairs = []
  if operator_at?(tokens, position, ["}"])
    return Step.new(node: hash_node(pairs), position: position + 1)
  end
  while true
    # `{name: "pdx"}` — shorthand, and the only symbol-key spelling
    # (ADR 0023 §1). The lexer hands back `name` then `:`.
    if tokens[position].identifier? && operator_at?(tokens, position + 1, %w[:])
      shorthand = parse_expression(tokens, position + 2)
      pairs << pair_node(symbol_node(tokens[position].text), shorthand.node)
      position = shorthand.position
      if operator_at?(tokens, position, %w[,])
        position += 1
        next
      end
      if operator_at?(tokens, position, ["}"])
        return Step.new(node: hash_node(pairs), position: position + 1)
      end
      return Step.new(node: error_node("expected closing brace in hash"), position: position)
    end
    key = parse_expression(tokens, position)
    unless operator_at?(tokens, key.position, %w[=>])
      return Step.new(node: error_node("expected => in hash literal"), position: key.position)
    end
    value = parse_expression(tokens, key.position + 1)
    pairs << pair_node(key.node, value.node)
    position = value.position
    if operator_at?(tokens, position, %w[,])
      position += 1
      next
    end
    if operator_at?(tokens, position, ["}"])
      return Step.new(node: hash_node(pairs), position: position + 1)
    end
    return Step.new(node: error_node("expected closing brace in hash"), position: position)
  end
end

# One argument: `label: value` makes a keyword argument, else an expression.
def parse_argument(tokens, position)
  token = tokens[position]
  if token.identifier? && operator_at?(tokens, position + 1, %w[:])
    value = parse_expression(tokens, position + 2)
    return Step.new(node: keyword_argument_node(token.text, value.node), position: value.position)
  end
  parse_expression(tokens, position)
end

def newline_then_dot?(tokens, position)
  offset = skip_newlines_at(tokens, position)
  return false if offset == position
  operator_at?(tokens, offset, %w[.])
end

def skip_newlines_at(tokens, mutable position)
  while position < tokens.length && tokens[position].newline?
    position += 1
  end
  position
end

# Does this name carry the `!` suffix (ADR 0027)?
def bang_name?(name)
  name.end_with?("!")
end

def bang_base(name)
  name.slice(0, name.length - 1)
end

# A binding site cannot take the `!` suffix (ADR 0027): a reference ending
# in `!` belongs to a method's name, so the binding could never be
# reached again. The seed's wording.
def bang_binding_error(name)
  error_node("`!` belongs to a method's name — a binding cannot take it; name it #{bang_base(name)}")
end

# An identifier in expression position, by whatever it turns out to lead:
# a `::` path, a paren call, a block-handed call, or a bare name.
def parse_identifier_primary(tokens, position, name)
  after = position + 1
  if operator_at?(tokens, after, ["::"])
    parse_path(tokens, name, after)
  elsif operator_at?(tokens, after, %w[(])
    arguments = parse_arguments(tokens, after + 1)
    # ADR 0024: parens closed the argument list, so a block opening here has
    # one owner and `{` is as good as `do`.
    if keyword_at?(tokens, arguments.position, %w[do])
      block = parse_block(tokens, arguments.position + 1, false)
      Step.new(node: call_with_block_node(name, arguments.node, block.node), position: block.position)
    elsif operator_at?(tokens, arguments.position, %w[{])
      block = parse_block(tokens, arguments.position + 1, true)
      Step.new(node: call_with_block_node(name, arguments.node, block.node), position: block.position)
    else
      Step.new(node: call_node(name, arguments.node), position: arguments.position)
    end
  elsif keyword_at?(tokens, after, %w[do])
    # A bare name followed by `do` is a call handed a block, which
    # `yield` reaches from inside the method.
    block = parse_block(tokens, after + 1, false)
    Step.new(node: call_with_block_node(name, [], block.node), position: block.position)
  elsif operator_at?(tokens, after, %w[{]) && !braces_could_be_a_hash?(tokens, after)
    # ADR 0024, in expression position: a `{` the peek has ruled out as a
    # hash is this call's block. Where it could be a hash the never-guess
    # menu still owns it, so this branch declines and the caller reports.
    block = parse_block(tokens, after + 1, true)
    Step.new(node: call_with_block_node(name, [], block.node), position: block.position)
  else
    Step.new(node: identifier_node(name), position: after)
  end
end

def parse_primary(tokens, position)
  return Step.new(node: error_node("unexpected end of input"), position: position) if position >= tokens.length
  token = tokens[position]
  after = position + 1
  case token.kind
  when "integer" then Step.new(node: integer_node(token.text), position: after)
  when "float" then Step.new(node: float_node(token.text), position: after)
  when "symbol"
    # `:paid` alone is a symbol; `:paid(on: expr)` carries a payload
    # (ADR 0022). The paren must be attached, or it is a separate thing.
    if operator_at?(tokens, after, %w[(]) && !tokens[after].leading_space
      parse_enum_case(tokens, symbol_name(token.text), after + 1)
    else
      Step.new(node: symbol_node(symbol_name(token.text)), position: after)
    end
  when "identifier"
    # A `!` in the name is just the name (ADR 0044).
    parse_identifier_primary(tokens, position, token.text)
  when "string" then Step.new(node: string_expression(token.text), position: after)
  when "word_array" then Step.new(node: word_array_node(token.text), position: after)
  when "keyword"
    case token.text
    when "true", "false" then Step.new(node: boolean_node(token.text), position: after)
    when "nil" then Step.new(node: nil_node, position: after)
    when "self" then Step.new(node: self_node, position: after)
    when "yield" then Step.new(node: yield_node, position: after)
    when "if" then parse_if(tokens, after)
    when "unless" then parse_unless(tokens, after)
    when "case" then parse_case(tokens, after)
    else
      Step.new(node: error_node("unexpected keyword #{token.text}"), position: after)
    end
  when "operator"
    if token.text == "("
      inner = parse_expression(tokens, after)
      if operator_at?(tokens, inner.position, %w[)])
        Step.new(node: inner.node, position: inner.position + 1)
      else
        Step.new(node: error_node("expected closing paren"), position: inner.position)
      end
    elsif token.text == "["
      parse_array(tokens, after)
    elsif token.text == "{"
      parse_hash(tokens, after)
    else
      Step.new(node: error_node("unexpected #{token.kind} #{token.text}"), position: after)
    end
  else
    Step.new(node: error_node("unexpected #{token.kind} #{token.text}"), position: after)
  end
end

# — strings —
# Decoded at parse time, like the seed: a plain lexeme becomes a string node
# holding its decoded value; interpolation desugars to a + chain with each
# inner expression wrapped in .to_s.

# The escapes are a closed set, and an unknown one refuses the way the seed
# refuses it — Ruby would pass `\q` through as `q`, and that divergence is
# ledgered (docs/ruby/string-escapes.md). Until 2026-08-12 this arm passed
# the character through, so the compiler accepted strings the seed refused:
# the harness never caught it because no fixture could contain one.
def decode_escape(character)
  case character
  when "n" then "\n"
  when "r" then "\r"
  when "t" then "\t"
  when "\"" then "\""
  when "\\" then "\\"
  when "#" then "#"
  else
    panic "unknown escape sequence \\#{character}"
  end
end

# Collect the source inside #{...}: Step.node is the inner source text.
def read_inner_source(characters, start)
  mutable inner = ""
  mutable index = start
  mutable depth = 1
  while index < characters.length
    character = characters[index]
    if character == "{"
      depth += 1
    elsif character == "}"
      depth -= 1
      return Step.new(node: inner, position: index + 1) if depth == 0
    elsif character == "\""
      nested = read_simple_string(characters, index, "\"")
      inner << nested
      index += nested.length
      next
    end
    inner << character
    index += 1
  end
  Step.new(node: inner, position: index)
end

def string_expression(lexeme)
  content = lexeme.slice(1, lexeme.length - 2)
  characters = content.chars
  if lexeme.slice(0, 1) == "'"
    mutable result = ""
    mutable index = 0
    while index < characters.length
      character = characters[index]
      mutable following = ""
      following = characters[index + 1] if index + 1 < characters.length
      # Single-quoted: only \' and \\ mean anything; other backslashes stay.
      if character == "\\" && (following == "'" || following == "\\")
        result << following
        index += 2
        next
      end
      result << character
      index += 1
    end
    return string_node(result)
  end
  mutable parts = []
  mutable literal = ""
  mutable index = 0
  while index < characters.length
    character = characters[index]
    if character == "\\"
      panic "a string ends with a lone backslash" if index + 1 >= characters.length
      literal << decode_escape(characters[index + 1])
      index += 2
      next
    end
    if character == "#" && index + 1 < characters.length && characters[index + 1] == "{"
      parts << string_node(literal) unless literal.empty?
      literal = ""
      inner = read_inner_source(characters, index + 2)
      inner_step = parse_expression(lex(inner.node), 0)
      parts << method_call_node(inner_step.node, "to_s", [], nil)
      index = inner.position
      next
    end
    literal << character
    index += 1
  end
  return string_node(literal) if parts.empty?
  parts << string_node(literal) unless literal.empty?
  mutable chain = parts.first
  index = 1
  while index < parts.length
    chain = binary_node("+", chain, parts[index])
    index += 1
  end
  chain
end

# Re-encode a decoded string for sexp display.
def encode_string(text)
  mutable result = "\""
  text.chars.each do |character|
    encoded = case character
    when "\\" then "\\\\"
    when "\"" then "\\\""
    when "\n" then "\\n"
    when "\t" then "\\t"
    else
      character
    end
    result << encoded
  end
  result + "\""
end

# — statements —

def parse_statement(tokens, position)
  token = tokens[position]
  if token.keyword?
    case token.text
    when "return" then return parse_return(tokens, position + 1)
    when "break" then return Step.new(node: break_node, position: position + 1)
    when "next" then return Step.new(node: next_node, position: position + 1)
    when "while" then return parse_while(tokens, position + 1, false)
    when "until" then return parse_while(tokens, position + 1, true)
    when "loop" then return parse_loop(tokens, position + 1)
    when "alias" then return parse_alias(tokens, position + 1)
    when "def" then return parse_def(tokens, position + 1)
    when "mutable" then return parse_mutable(tokens, position + 1)
    when "struct" then return parse_struct(tokens, position + 1)
    when "together" then return parse_together(tokens, position + 1)
    when "meanwhile" then return Step.new(node: error_node("a task line belongs inside `together` — every task lives in the block that joins it (ADR 0029)"), position: skip_line_at(tokens, position))
    when "trait" then return parse_trait(tokens, position + 1)
    when "include" then return Step.new(node: error_node("`include` belongs inside a struct body — a trait is carried by a struct (ADR 0028)"), position: skip_line_at(tokens, position))
    when "enum" then return parse_enum(tokens, position + 1)
    when "module" then return parse_module(tokens, position + 1)
    end
  end
  if token.operator? && token.text == "~"
    return Step.new(node: error_node("a task line belongs inside `together` — every task lives in the block that joins it (ADR 0029)"), position: skip_line_at(tokens, position))
  end
  if token.identifier? && command_start?(tokens, position + 1)
    return parse_command(tokens, position)
  end
  if token.identifier? && ambiguous_command?(tokens, position + 1)
    return Step.new(node: error_node(ambiguity_message(tokens, position)), position: skip_line_at(tokens, position))
  end
  # ADR 0016 one position earlier than the usual spot: a bare `{` directly
  # after a call's name, where there is no argument for the block to belong to
  # instead. Two readings — or one, and then ADR 0024 says it is this call's
  # block, since one reading was never an ambiguity to refuse.
  if token.identifier? && operator_at?(tokens, position + 1, %w[{])
    unless braces_could_be_a_hash?(tokens, position + 1)
      block = parse_block(tokens, position + 2, true)
      return Step.new(node: call_with_block_node(token.text, [], block.node), position: block.position)
    end
    return Step.new(node: error_node(brace_after_name_message(token.text, tokens, position + 1)), position: skip_line_at(tokens, position))
  end
  if token.identifier? && operator_at?(tokens, position + 1, %w[=])
    return Step.new(node: bang_binding_error(token.text), position: skip_line_at(tokens, position)) if bang_name?(token.text)
    value = parse_expression(tokens, position + 2)
    return Step.new(node: assignment_node(token.text, value.node), position: value.position)
  end
  if token.identifier? && operator_at?(tokens, position + 1, %w[<<])
    return Step.new(node: bang_binding_error(token.text), position: skip_line_at(tokens, position)) if bang_name?(token.text)
    value = parse_expression(tokens, position + 2)
    return Step.new(node: assignment_node(token.text, append_node(token.text, value.node)), position: value.position)
  end
  if token.identifier? && operator_at?(tokens, position + 1, %w[+= -= *= /= %=])
    return Step.new(node: bang_binding_error(token.text), position: skip_line_at(tokens, position)) if bang_name?(token.text)
    # `x += e` desugars to `x = x + e`, as in the seed.
    operator = tokens[position + 1].text.slice(0, 1)
    value = parse_expression(tokens, position + 2)
    desugared = binary_node(operator, identifier_node(token.text), value.node)
    return Step.new(node: assignment_node(token.text, desugared), position: value.position)
  end
  # `x ||= e` desugars to `x = x || e` (ADR 0043): the or-guard's question
  # as a rebind — absent takes the fallback, a Boolean left refuses
  # (ADR 0007), and `mutable` is required like every compound.
  if token.identifier? && operator_at?(tokens, position + 1, %w[||=])
    value = parse_expression(tokens, position + 2)
    desugared = logical_node("||", identifier_node(token.text), value.node)
    return Step.new(node: assignment_node(token.text, desugared), position: value.position)
  end
  step = parse_expression(tokens, position)
  # `name[index] = value` — a functional update rebound on the name.
  if operator_at?(tokens, step.position, %w[=]) && (step.node in IndexNode) && (step.node.receiver in IdentifierNode)
    name = step.node.receiver.name
    value = parse_expression(tokens, step.position + 1)
    return Step.new(node: assignment_node(name, index_update_node(name, step.node.index, value.node)), position: value.position)
  end
  # Rightward destructuring (ADR 0013 §4): `expr => pattern` matches or
  # panics — the pattern-grammar answer to multiple assignment.
  if operator_at?(tokens, step.position, %w[=>])
    pattern = parse_pattern(tokens, step.position + 1)
    return Step.new(node: match_assert_node(step.node, pattern.node), position: pattern.position)
  end
  step
end

def parse_return(tokens, position)
  if statement_boundary?(tokens, position) || keyword_at?(tokens, position, %w[if unless])
    return Step.new(node: return_bare_node, position: position)
  end
  value = parse_expression(tokens, position)
  Step.new(node: return_node(value.node), position: value.position)
end

# `mutable name = expr` (ADR 0001). The flag rides the node now (#45): the
# evaluator enforces rebinding rules with the seed's wordings, and this used
# to be the recorded syntax-only divergence.
def parse_mutable(tokens, position)
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("expected a name after mutable"), position: position)
  end
  name = tokens[position].text
  return Step.new(node: bang_binding_error(name), position: skip_line_at(tokens, position)) if bang_name?(name)
  unless operator_at?(tokens, position + 1, %w[=])
    return Step.new(node: error_node("mutable is fused to the first assignment — write `mutable #{name} = ...`"), position: position + 1)
  end
  value = parse_expression(tokens, position + 2)
  Step.new(node: mutable_assignment_node(name, value.node), position: value.position)
end

# Paren-less command calls, statement position only: `puts "hello"`.
# Forms Ruby resolves by whitespace guessing are errors here instead.
def command_start?(tokens, position)
  return false if position >= tokens.length
  token = tokens[position]
  case token.kind
  # "float" earned its place the hard way: its absence meant `p 2.5` never
  # became a command call at all, and the statement boundary reported the
  # leftover token instead (#46).
  when "float", "integer", "string", "symbol", "word_array", "identifier" then true
  when "keyword" then token.text == "true" || token.text == "false" || token.text == "nil"
  when "operator" then token.text == "!"
  else
    false
  end
end

def ambiguous_command?(tokens, position)
  return false if position >= tokens.length
  token = tokens[position]
  return false unless token.operator? && token.leading_space
  if token.text == "-"
    after = position + 1
    return false if after >= tokens.length
    return !tokens[after].leading_space
  end
  token.text == "[" || token.text == "("
end

def ambiguity_message(tokens, position)
  name = tokens[position].text
  following = tokens[position + 1].text
  if following == "-"
    argument = tokens[position + 2].text
    return "ambiguous without parens — write #{name}(-#{argument}) or #{name} - #{argument}"
  end
  if following == "["
    return "ambiguous without parens — write #{name}([...]) to pass an array or #{name}[...] to index"
  end
  "ambiguous without parens — write #{name}(...) with no space to call"
end

def skip_line_at(tokens, mutable position)
  while position < tokens.length && !tokens[position].newline?
    position += 1
  end
  position
end

# The index where this command call's arguments stop being arguments, or -1.
#
# Two openers qualify. A `do` always does: it cannot be part of an argument
# expression, so one at this level opens this call's block. A `{` qualifies only
# when it directly follows an identifier or a `)` — that is the never-guess
# position, where the braces might be the inner call's block. A `{` after a
# comma is a hash literal argument and stays one, which is why `render one,
# {name: 1}` still parses while `render one, two { |x| x }` reports the menu.
#
# The seed says this with a `command_arguments` flag on its parser. This parser
# is functional and holds no state, so it finds the spot up front and parses the
# arguments against a token list that stops there.
#
# Depth guards both: an opener inside parentheses or brackets belongs to
# whatever is in there. The scan stops at the newline ending the statement,
# which is safe because an argument list cannot span lines.
def command_opener_at(tokens, start)
  mutable depth = 0
  mutable index = start
  while index < tokens.length && !tokens[index].newline?
    token = tokens[index]
    if depth == 0
      return index if token.keyword? && token.text == "do"
      return index if token.operator? && token.text == "{" && closes_a_callable?(tokens, index - 1)
    end
    depth += 1 if token.operator? && %w[( \[ {].include?(token.text)
    depth -= 1 if token.operator? && %w[) \] }].include?(token.text)
    index += 1
  end
  0 - 1
end

# Could a block belong to whatever ends here? Only a call can take one, and a
# call ends in its name or its closing paren — but a *dot* call is excluded,
# because its braces were never ambiguous. `puts counting.reject { it.even? }`
# has one reading and always has; the seed attaches dot-call blocks without
# consulting its `command_arguments` flag at all.
def closes_a_callable?(tokens, position)
  return false if position < 0
  return false if dot_call_ends_at?(tokens, position)
  token = tokens[position]
  return true if token.identifier?
  token.operator? && token.text == ")"
end

def dot_call_ends_at?(tokens, position)
  token = tokens[position]
  name = if token.operator? && token.text == ")"
    opening = matching_paren_before(tokens, position)
    opening - 1
  else
    position
  end
  return false if name < 1
  return false unless tokens[name].identifier?
  operator_at?(tokens, name - 1, %w[.])
end

# The `(` matching the `)` at `position`, or -1. Walks back, so nested parens
# inside the arguments do not fool it.
def matching_paren_before(tokens, position)
  mutable depth = 0
  mutable index = position
  while index >= 0
    token = tokens[index]
    if token.operator? && token.text == ")"
      depth += 1
    elsif token.operator? && token.text == "("
      depth -= 1
      return index if depth == 0
    end
    index -= 1
  end
  0 - 1
end

def parse_command(tokens, mutable position)
  # A `!` in the name is just the name (ADR 0044).
  name = tokens[position].text
  # An opener past these arguments belongs to this call, never to an argument.
  # For `do` that is Ruby's rule; for `{` it is the position ADR 0016 refuses,
  # and either way the arguments must not see it — so they are parsed against a
  # token list that stops there. Truncated only when an opener is really
  # present, since the copy is not free.
  opener = command_opener_at(tokens, position + 1)
  argument_tokens = if opener < 0
    tokens
  else
    tokens[0..opener - 1]
  end
  mutable step = parse_argument(argument_tokens, position + 1)
  mutable arguments = [step.node]
  position = step.position
  while operator_at?(argument_tokens, position, %w[,])
    step = parse_argument(argument_tokens, position + 1)
    arguments << step.node
    position = step.position
  end
  unless opener < 0
    if keyword_at?(tokens, opener, %w[do])
      block = parse_block(tokens, opener + 1, false)
      handed = call_with_block_node(name, arguments, block.node)
      return Step.new(node: handed, position: block.position)
    end
    # ADR 0016: a bare `{` here has two or three genuine readings. Name them
    # all and let the author pick with a paren — never guess.
    message = brace_ambiguity_message(name, arguments.last, tokens, opener)
    return Step.new(node: error_node(message), position: skip_line_at(tokens, opener))
  end
  Step.new(node: call_node(name, arguments), position: position)
end

# The name of the inner call the braces might belong to.
def inner_receiver_name(argument)
  return argument.name if argument in CallNode
  return argument.name if argument in IdentifierNode
  "the last argument"
end

# Could the braces starting here be a hash literal? A `|` right after
# opens block parameters, and a hash needs a `=>` at its own depth — so
# this trims the menu without ever picking a winner (ADR 0016).
# What the `{` at `position` could be, judged from the first pair position only
# (ADR 0024): "block", "hash", or "either".
#
# Three answers, not two, because "could be a hash" hides a distinction that
# matters: `{name: 1}` can *only* be a hash, since a label cannot start a
# statement and so cannot be a block body. Collapsing that into "ambiguous"
# invents a reading, and then offers a `foo() { ... }` rewrite that does not
# parse.
def brace_reading(tokens, position)
  # Block parameters cannot open a hash.
  return "block" if operator_at?(tokens, position + 1, %w[|])
  # `{}` — an empty hash or an empty block.
  return "either" if operator_at?(tokens, position + 1, ["}"])
  # A shorthand key (ADR 0023), first position only. A label is not a
  # statement, so there is no block reading to weigh against the hash.
  return "hash" if identifier_at?(tokens, position + 1) && operator_at?(tokens, position + 2, %w[:])

  # Otherwise a hash's first element has to be `value => ...`, so look for a
  # `=>` at the braces' own level before that element could have ended. A
  # newline ends it, since a hash literal cannot span lines; a comma means a
  # second pair, and a pair list is not a statement either.
  mutable rocket = false
  mutable depth = 0
  mutable index = position + 1
  while index < tokens.length
    token = tokens[index]
    if token.operator? && %w[{ \[ (].include?(token.text)
      depth += 1
    elsif token.operator? && %w[\] )].include?(token.text)
      depth -= 1
    elsif token.operator? && token.text == "}"
      break if depth == 0
      depth -= 1
    elsif token.newline? && depth == 0
      break
    elsif token.operator? && token.text == "=>" && depth == 0
      rocket = true
    elsif token.operator? && token.text == "," && depth == 0
      return "hash" if rocket
      return "block"
    end
    index += 1
  end
  # A lone `key => value` is both a pair and a match assertion (ADR 0013).
  return "either" if rocket
  "block"
end

def braces_could_be_a_hash?(tokens, position)
  brace_reading(tokens, position) != "block"
end

def identifier_at?(tokens, position)
  return false if position >= tokens.length
  tokens[position].identifier?
end

# The seed's wording for a `{` sitting directly after a call's name. Two
# readings get the menu; one reading that is a hash gets told, not asked.
# (A single block reading never reaches here — ADR 0024 accepts it.)
def brace_after_name_message(name, tokens, position)
  if brace_reading(tokens, position) == "hash"
    return "`{` after a paren-less call is a hash, not a block — a block body cannot start with a label. Write #{name}({ ... })"
  end

  head = "`{` after a paren-less call could be two things — parenthesize the one you mean:"
  block_line = "  a block for #{name}:         #{name}() { ... }"
  hash_line = "  a hash argument to #{name}:  #{name}({ ... })"
  "#{head}\n#{block_line}\n#{hash_line}"
end

def brace_ambiguity_message(name, argument, tokens, position)
  inner = inner_receiver_name(argument)
  if braces_could_be_a_hash?(tokens, position)
    return "`{` after a command call could be three things — parenthesize the one you mean:\n  a hash argument to #{inner}:  #{name} #{inner}({ ... })\n  a block for #{inner}:         #{name}(#{inner} { ... })\n  a block for #{name}:         #{name}(#{inner}) { ... }"
  end
  "`{` after a command call is a block — but whose? parenthesize the one you mean:\n  a block for #{inner}:  #{name}(#{inner} { ... })\n  a block for #{name}:  #{name}(#{inner}) { ... }"
end

# Ruby's postfix guards: `puts(x) if ready`, `return unless valid` — and the
# loop modifiers (ADR 0037), where the statement becomes the whole body of a
# plain pre-checked loop.
def parse_statement_with_guard(tokens, position)
  step = parse_statement(tokens, position)
  if keyword_at?(tokens, step.position, %w[if])
    condition = parse_expression(tokens, step.position + 1)
    return Step.new(node: if_node(condition.node, [step.node], nil), position: condition.position)
  end
  if keyword_at?(tokens, step.position, %w[unless])
    condition = parse_expression(tokens, step.position + 1)
    return Step.new(node: if_node(condition.node, nil, [step.node]), position: condition.position)
  end
  if keyword_at?(tokens, step.position, %w[while])
    condition = parse_expression(tokens, step.position + 1)
    return Step.new(node: while_node(condition.node, [step.node]), position: condition.position)
  end
  if keyword_at?(tokens, step.position, %w[until])
    condition = parse_expression(tokens, step.position + 1)
    return Step.new(node: while_node(unary_node("!", condition.node), [step.node]), position: condition.position)
  end
  step
end

# Parse statements up to (not consuming) one of the terminator keywords.
# The Step's node is the array of statement nodes.
def parse_body(tokens, mutable position, terminators)
  mutable nodes = []
  position = skip_newlines_at(tokens, position)
  while true
    if position >= tokens.length || keyword_at?(tokens, position, terminators)
      return Step.new(node: nodes, position: position)
    end
    step = parse_statement_with_guard(tokens, position)
    nodes << step.node
    position = step.position
    unless statement_boundary?(tokens, position) || keyword_at?(tokens, position, terminators)
      nodes << error_node("expected newline after statement, got #{tokens[position].text}")
      while position < tokens.length && !tokens[position].newline?
        position += 1
      end
    end
    position = skip_newlines_at(tokens, position)
  end
end

# — definitions —

def parse_def(tokens, mutable position)
  # `def self.name` — a type function (ADR 0031). The flag rides the node;
  # each context decides what it means: a struct body registers it on the
  # type, a module body accepts it as a plain def, the rest refuse.
  mutable type_function = false
  if keyword_at?(tokens, position, %w[self]) && operator_at?(tokens, position + 1, %w[.])
    type_function = true
    position += 2
  end
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("expected method name after def"), position: position)
  end
  name = tokens[position].text
  # `!` belongs to call sites, never to methods (ADR 0027).
  position += 1
  mutable parameters = []
  if operator_at?(tokens, position, %w[(])
    parameter_step = parse_parameters(tokens, position + 1)
    # A refusal in the parameter list stands in for the whole def.
    return parameter_step if parameter_step.node in ErrorNode
    parameters = parameter_step.node
    position = parameter_step.position
  end
  body = parse_body(tokens, position, %w[end])
  if keyword_at?(tokens, body.position, %w[end])
    return Step.new(node: def_node(name, parameters, body.node, type_function), position: body.position + 1)
  end
  Step.new(node: error_node("expected end to close def #{name}"), position: body.position)
end

# Parameter names: `name`, `name = default`, and Ruby-3-style keyword
# parameters `label:` / `label: default`; consumes the closing paren.
def parse_parameters(tokens, mutable position)
  mutable parameters = []
  while position < tokens.length && (tokens[position].identifier? || keyword_at?(tokens, position, %w[mutable]))
    # A parameter is a binding site (ADR 0001), so `mutable` marks it
    # rebindable — carried on the node since #45. A `mutable` before a
    # keyword parameter is still dropped, a recorded gap.
    rebindable = keyword_at?(tokens, position, %w[mutable])
    position += 1 if rebindable
    name = tokens[position].text
    return Step.new(node: bang_binding_error(name), position: skip_line_at(tokens, position)) if bang_name?(name)
    position += 1
    if operator_at?(tokens, position, %w[:])
      position += 1
      if operator_at?(tokens, position, %w[,]) || operator_at?(tokens, position, %w[)])
        parameters << keyword_parameter_node(name, nil)
      else
        default = parse_expression(tokens, position)
        parameters << keyword_parameter_node(name, default.node)
        position = default.position
      end
    elsif operator_at?(tokens, position, %w[=])
      default = parse_expression(tokens, position + 1)
      parameters << if rebindable
        mutable_assignment_node(name, default.node)
      else
        assignment_node(name, default.node)
      end
      position = default.position
    elsif rebindable
      parameters << mutable_assignment_node(name, nil)
    else
      parameters << identifier_node(name)
    end
    position += 1 if operator_at?(tokens, position, %w[,])
  end
  if operator_at?(tokens, position, %w[)])
    return Step.new(node: parameters, position: position + 1)
  end
  Step.new(node: [error_node("expected closing paren after parameters")], position: position)
end

# — patterns (ADR 0013) —

def parse_case_in(tokens, subject, mutable position)
  mutable branches = []
  while keyword_at?(tokens, position, %w[in])
    branch = parse_in_branch(tokens, position + 1)
    branches << branch.node
    position = skip_newlines_at(tokens, branch.position)
  end
  if keyword_at?(tokens, position, %w[else])
    else_body = parse_else_body(tokens, position + 1, %w[end])
    position = else_body.position
    if keyword_at?(tokens, position, %w[end])
      return Step.new(node: case_in_node(subject, branches, else_body.node), position: position + 1)
    end
    return Step.new(node: error_node("expected end to close case"), position: position)
  end
  if keyword_at?(tokens, position, %w[end])
    return Step.new(node: case_in_node(subject, branches, nil), position: position + 1)
  end
  Step.new(node: error_node("expected end to close case"), position: position)
end

def parse_in_branch(tokens, mutable position)
  pattern = parse_pattern(tokens, position)
  position = pattern.position
  mutable guard = nil
  if keyword_at?(tokens, position, %w[if])
    guard_step = parse_expression(tokens, position + 1)
    guard = guard_step.node
    position = guard_step.position
  end
  body = parse_branch_body(tokens, position, %w[in else end])
  Step.new(node: in_branch_node(pattern.node, guard, body.node), position: body.position)
end

def parse_pattern(tokens, mutable position)
  first = parse_pattern_primary(tokens, position)
  position = first.position
  return first unless operator_at?(tokens, position, %w[|])
  mutable options = [first.node]
  while operator_at?(tokens, position, %w[|])
    option = parse_pattern_primary(tokens, position + 1)
    options << option.node
    position = option.position
  end
  Step.new(node: alternative_pattern_node(options), position: position)
end

# Literal patterns reuse the literal expression nodes; a bare lowercase
# identifier is a capture; capitalized names start struct patterns.
def parse_pattern_primary(tokens, position)
  if position >= tokens.length
    return Step.new(node: error_node("expected a pattern"), position: position)
  end
  token = tokens[position]
  # `in ..0` — a beginless range pattern (ADR 0019): the operator leads, and
  # membership rather than equality is the meaning (#40).
  if token.operator? && (token.text == ".." || token.text == "...")
    finish = parse_pattern_range_bound(tokens, position + 1)
    return finish if finish.node in ErrorNode
    return Step.new(node: range_node(nil, finish.node, token.text == "..."), position: finish.position)
  end
  if token.integer?
    # `in 1..9`, endless when nothing integer-shaped follows the dots.
    if operator_at?(tokens, position + 1, %w[.. ...])
      exclusive = tokens[position + 1].text == "..."
      after = position + 2
      unless pattern_range_end_at?(tokens, after)
        return Step.new(node: range_node(integer_node(token.text), nil, exclusive), position: after)
      end
      finish = parse_pattern_range_bound(tokens, after)
      return finish if finish.node in ErrorNode
      return Step.new(node: range_node(integer_node(token.text), finish.node, exclusive), position: finish.position)
    end
    return Step.new(node: integer_node(token.text), position: position + 1)
  end
  if token.operator? && token.text == "-" && position + 1 < tokens.length && tokens[position + 1].integer?
    return Step.new(node: integer_node("-" + tokens[position + 1].text), position: position + 2)
  end
  if token.string?
    return Step.new(node: string_expression(token.text), position: position + 1)
  end
  # `in :paid(on:)` destructures a payload; `in :paid` matches a bare case.
  if token.symbol?
    name = symbol_name(token.text)
    unless operator_at?(tokens, position + 1, %w[(])
      return Step.new(node: symbol_node(name), position: position + 1)
    end
    return parse_enum_case_pattern(tokens, name, position + 2)
  end
  if token.keyword?
    if token.text == "true" || token.text == "false"
      return Step.new(node: boolean_node(token.text), position: position + 1)
    end
    return Step.new(node: nil_node, position: position + 1) if token.text == "nil"
    return Step.new(node: error_node("unexpected keyword #{token.text} in a pattern"), position: position + 1)
  end
  if token.operator? && token.text == "^"
    if position + 1 < tokens.length && tokens[position + 1].identifier?
      return Step.new(node: pin_node(tokens[position + 1].text), position: position + 2)
    end
    return Step.new(node: error_node("expected a variable name after ^"), position: position + 1)
  end
  if token.operator? && token.text == "["
    return parse_array_pattern(tokens, position + 1)
  end
  if token.identifier?
    name = token.text
    if "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(name.slice(0, 1))
      return parse_struct_pattern(tokens, name, position + 1)
    end
    return Step.new(node: identifier_node(name), position: position + 1)
  end
  Step.new(node: error_node("unsupported pattern starting with #{token.text}"), position: position + 1)
end

# One integer bound of a range pattern, negative allowed — the seed's rule:
# range patterns take integer bounds and nothing else.
def parse_pattern_range_bound(tokens, mutable position)
  negative = operator_at?(tokens, position, %w[-])
  position += 1 if negative
  unless position < tokens.length && tokens[position].integer?
    return Step.new(node: error_node("range patterns take integer bounds"), position: position)
  end
  text = tokens[position].text
  return Step.new(node: integer_node("-" + text), position: position + 1) if negative
  Step.new(node: integer_node(text), position: position + 1)
end

# The end of a range pattern, absent for `in 10..` — an end exists only when
# an integer (negative allowed) sits at the cursor, which is the seed's rule:
# patterns always sit before a token that cannot continue them.
def pattern_range_end_at?(tokens, position)
  return true if position < tokens.length && tokens[position].integer?
  operator_at?(tokens, position, %w[-]) && position + 1 < tokens.length && tokens[position + 1].integer?
end

# `[p, p]` exact, or `[p, *rest]` — a splat may only end the pattern.
def parse_array_pattern(tokens, mutable position)
  mutable elements = []
  mutable splat = false
  mutable rest_name = nil
  unless operator_at?(tokens, position, ["]"])
    while true
      if operator_at?(tokens, position, %w[*])
        splat = true
        position += 1
        if position < tokens.length && tokens[position].identifier?
          rest_name = tokens[position].text
          position += 1
        end
        break
      end
      element = parse_pattern(tokens, position)
      elements << element.node
      position = element.position
      break unless operator_at?(tokens, position, %w[,])
      position += 1
    end
  end
  unless operator_at?(tokens, position, ["]"])
    return Step.new(node: error_node("expected closing bracket in array pattern"), position: position)
  end
  Step.new(node: array_pattern_node(elements, splat, rest_name), position: position + 1)
end

# `Name(field: pattern, other:)` — keyword-only; bare `Name` matches by type.
# `in :paid(on:)` — the same keyword-only shape as a struct pattern, so
# `on:` alone binds a name of the same name (ADR 0022 §1).
def parse_enum_case_pattern(tokens, name, mutable position)
  mutable payload = []
  while true
    token = tokens[position]
    unless token.identifier? && operator_at?(tokens, position + 1, %w[:])
      return Step.new(node: error_node("enum payload patterns are keyword-only"), position: position + 1)
    end
    label = token.text
    position += 2
    if operator_at?(tokens, position, %w[,]) || operator_at?(tokens, position, %w[)])
      payload << [label, identifier_node(label)]
    else
      inner = parse_pattern(tokens, position)
      payload << [label, inner.node]
      position = inner.position
    end
    break unless operator_at?(tokens, position, %w[,])
    position += 1
  end
  unless operator_at?(tokens, position, %w[)])
    return Step.new(node: error_node("expected ) to close an enum payload pattern"), position: position)
  end
  Step.new(node: enum_case_pattern_node(name, payload), position: position + 1)
end

def parse_struct_pattern(tokens, name, mutable position)
  unless operator_at?(tokens, position, %w[(])
    return Step.new(node: struct_pattern_node(name, []), position: position)
  end
  position += 1
  mutable fields = []
  unless operator_at?(tokens, position, %w[)])
    while true
      token = tokens[position]
      unless token.identifier? && operator_at?(tokens, position + 1, %w[:])
        return Step.new(node: error_node("struct patterns are keyword-only — write #{name}(field: pattern)"), position: position + 1)
      end
      label = token.text
      position += 2
      if operator_at?(tokens, position, %w[,]) || operator_at?(tokens, position, %w[)])
        # `field:` shorthand desugars to a capture named after the field.
        fields << [label, identifier_node(label)]
      else
        sub_pattern = parse_pattern(tokens, position)
        fields << [label, sub_pattern.node]
        position = sub_pattern.position
      end
      break unless operator_at?(tokens, position, %w[,])
      position += 1
    end
  end
  unless operator_at?(tokens, position, %w[)])
    return Step.new(node: error_node("expected closing paren in struct pattern #{name}"), position: position)
  end
  Step.new(node: struct_pattern_node(name, fields), position: position + 1)
end

# `enum Name ... end` — a closed vocabulary (ADR 0022). Each line is one
# case: a symbol, optionally with keyword-only payload labels.
def parse_enum(tokens, mutable position)
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("expected enum name after enum"), position: position)
  end
  name = tokens[position].text
  unless "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(name.slice(0, 1))
    return Step.new(node: error_node("enum names start with a capital letter, got #{name}"), position: position + 1)
  end
  position = skip_newlines_at(tokens, position + 1)
  mutable cases = []
  while position < tokens.length && tokens[position].symbol?
    case_name = symbol_name(tokens[position].text)
    position += 1
    mutable labels = []
    if operator_at?(tokens, position, %w[(])
      position += 1
      while true
        label = tokens[position]
        unless label.identifier? && operator_at?(tokens, position + 1, %w[:])
          return Step.new(node: error_node("enum payloads are keyword-only"), position: position)
        end
        labels << label.text
        position += 2
        break unless operator_at?(tokens, position, %w[,])
        position += 1
      end
      unless operator_at?(tokens, position, [")"])
        return Step.new(node: error_node("expected ) to close the payload of :#{case_name}"), position: position)
      end
      position += 1
    end
    cases << enum_case_decl_node(case_name, labels)
    position = skip_newlines_at(tokens, position)
  end
  unless keyword_at?(tokens, position, %w[end])
    return Step.new(node: error_node("expected end to close enum #{name}"), position: position)
  end
  return Step.new(node: error_node("enum #{name} has no cases — a vocabulary needs words"), position: position + 1) if cases.empty?

  Step.new(node: enum_def_node(name, cases), position: position + 1)
end

def parse_struct(tokens, mutable position)
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("expected struct name after struct"), position: position)
  end
  name = tokens[position].text
  unless "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(name.slice(0, 1))
    return Step.new(node: error_node("struct names start with a capital letter, got #{name}"), position: position + 1)
  end
  position = skip_newlines_at(tokens, position + 1)
  mutable fields = []
  while position < tokens.length && tokens[position].identifier?
    fields << tokens[position].text
    position = skip_newlines_at(tokens, position + 1)
  end
  # Methods after the fields (#27), includes (ADR 0028), and nested types —
  # a type may nest in a type; a module may not (ADR 0021 §5). One loop
  # dispatching per keyword, matching the seed: two loops in sequence meant
  # an enum between two defs ended method parsing for good, and the struct
  # never found its end (#44).
  mutable includes = []
  mutable methods = []
  mutable nested = []
  mutable type_functions = []
  while keyword_at?(tokens, position, %w[alias def enum include struct])
    if keyword_at?(tokens, position, %w[alias])
      # `alias footprint area` (ADR 0039) — desugared right here: the body
      # is self-contained, so the alias clones the def it points at, and
      # every def-collision rule fires on the new name too.
      aliased = parse_struct_alias(tokens, position + 1, name, fields, methods, type_functions)
      return Step.new(node: aliased.node, position: aliased.position) if aliased.node in ErrorNode
      methods << aliased.node
      position = skip_newlines_at(tokens, aliased.position)
    elsif keyword_at?(tokens, position, %w[include])
      unless position + 1 < tokens.length && tokens[position + 1].identifier? && "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(tokens[position + 1].text.slice(0, 1))
        return Step.new(node: error_node("expected a trait name after include"), position: position + 1)
      end
      includes << tokens[position + 1].text
      position = skip_newlines_at(tokens, position + 2)
    elsif keyword_at?(tokens, position, %w[def])
      method = parse_def(tokens, position + 1)
      # One namespace serves instances and the type (ADR 0031): the same
      # name on both sides is a collision, not overloading. The wordings
      # are the seed's.
      if (method.node in DefNode) && method.node.type_function
        checked = check_type_function(name, fields, methods, type_functions, method.node)
        return Step.new(node: checked, position: method.position) if checked in ErrorNode
        type_functions << method.node
      else
        if (method.node in DefNode) && !type_functions.select { it.name == method.node.name }.empty?
          return Step.new(node: error_node("#{method.node.name} is defined on #{name} instances and on the type — rename one"), position: method.position)
        end
        methods << method.node
      end
      position = skip_newlines_at(tokens, method.position)
    else
      inner = if keyword_at?(tokens, position, %w[enum])
        parse_enum(tokens, position + 1)
      else
        parse_struct(tokens, position + 1)
      end
      nested << inner.node
      position = skip_newlines_at(tokens, inner.position)
    end
  end
  if keyword_at?(tokens, position, %w[module])
    return Step.new(node: error_node("modules don't nest inside structs — a module groups things, a struct is a thing"), position: position + 1)
  end
  if keyword_at?(tokens, position, %w[end])
    return Step.new(node: struct_def_node(name, fields, includes, methods, nested, type_functions), position: position + 1)
  end
  Step.new(node: error_node("expected end to close struct #{name}"), position: position)
end

# One trait-body alias: same desugar, the trait's own wordings.
def parse_trait_alias(tokens, position, trait_name, methods)
  first = parse_alias_name(tokens, position)
  return first unless first.node in String
  second = parse_alias_name(tokens, first.position)
  return second unless second.node in String
  new_name = first.node
  old_name = second.node
  after = second.position
  return Step.new(node: error_node("#{new_name} is reserved on structs, so a trait cannot carry it"), position: after) if %w[new nil? some? with].include?(new_name)
  taken = methods.select { it.name == new_name }
  return Step.new(node: error_node("duplicate method #{new_name} in trait #{trait_name}"), position: after) unless taken.empty?
  target = methods.find { it.name == old_name }
  if target.nil?
    return Step.new(node: error_node("alias points at nothing — no method #{old_name} defined yet"), position: after)
  end
  twin = DefNode.new(kind: "def", name: new_name, parameters: target.parameters, body: target.body, type_function: false)
  Step.new(node: twin, position: after)
end

# One struct-body alias: Step.node is the cloned DefNode under the new
# name, or an ErrorNode. Wordings are the seed's.
def parse_struct_alias(tokens, position, struct_name, fields, methods, type_functions)
  first = parse_alias_name(tokens, position)
  return first unless first.node in String
  second = parse_alias_name(tokens, first.position)
  return second unless second.node in String
  new_name = first.node
  old_name = second.node
  after = second.position
  return Step.new(node: error_node("#{new_name} is reserved on structs"), position: after) if %w[new nil? some? with].include?(new_name)
  return Step.new(node: error_node("#{new_name} is a field of #{struct_name} — a name is a field or a method, never both"), position: after) if fields.include?(new_name)
  taken = methods.select { it.name == new_name } + type_functions.select { it.name == new_name }
  return Step.new(node: error_node("duplicate method #{new_name} in struct #{struct_name}"), position: after) unless taken.empty?
  target = methods.find { it.name == old_name }
  if target.nil?
    return Step.new(node: error_node("alias points at nothing — no method #{old_name} defined yet"), position: after)
  end
  twin = DefNode.new(kind: "def", name: new_name, parameters: target.parameters, body: target.body, type_function: false)
  Step.new(node: twin, position: after)
end

# The struct-body rules for one `def self.` (ADR 0031), each wording the
# seed's: the node back when it passes, an ErrorNode when it refuses.
def check_type_function(struct_name, fields, methods, type_functions, node)
  return error_node("#{node.name} is a field of #{struct_name} — a name is a field or a method, never both") if fields.include?(node.name)
  return error_node("#{node.name} is reserved on structs") if %w[nil? some? with].include?(node.name)
  return error_node("#{node.name} is defined on #{struct_name} instances and on the type — rename one") unless methods.select { (it in DefNode) && it.name == node.name }.empty?
  return error_node("duplicate method #{node.name} in struct #{struct_name}") unless type_functions.select { it.name == node.name }.empty?
  node
end

# `together do ... end` (ADR 0029): task lines (`~` / `meanwhile`) bind
# their names at the `end`; unmarked lines are ordinary statements.
def parse_together(tokens, mutable position)
  unless keyword_at?(tokens, position, %w[do])
    return Step.new(node: error_node("together takes a do block — write together do ... end"), position: position)
  end
  position = skip_newlines_at(tokens, position + 1)
  mutable lines = []
  mutable task_names = []
  while position < tokens.length && !keyword_at?(tokens, position, %w[end])
    if keyword_at?(tokens, position, %w[meanwhile]) || operator_at?(tokens, position, %w[~])
      marker_after = position + 1
      unless marker_after < tokens.length && tokens[marker_after].identifier? && operator_at?(tokens, marker_after + 1, %w[=])
        return Step.new(node: error_node("a task line binds a name — write ~ name = ..."), position: skip_line_at(tokens, position))
      end
      name = tokens[marker_after].text
      return Step.new(node: bang_binding_error(name), position: skip_line_at(tokens, position)) if bang_name?(name)
      if task_names.include?(name)
        return Step.new(node: error_node("two tasks bind #{name} — every task line binds its own name"), position: skip_line_at(tokens, position))
      end
      value = parse_expression(tokens, marker_after + 2)
      task_names << name
      lines << task_line_node(name, value.node)
      position = skip_newlines_at(tokens, value.position)
    else
      statement = parse_statement_with_guard(tokens, position)
      lines << statement.node
      position = skip_newlines_at(tokens, statement.position)
    end
  end
  unless keyword_at?(tokens, position, %w[end])
    return Step.new(node: error_node("expected end to close together"), position: position)
  end
  Step.new(node: together_node(lines), position: position + 1)
end

# `trait Name ... end` — methods only (ADR 0028): no fields, no state, no
# nesting; a bundle of behavior for structs to include.
def parse_trait(tokens, mutable position)
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("expected trait name after trait"), position: position)
  end
  name = tokens[position].text
  unless "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(name.slice(0, 1))
    return Step.new(node: error_node("trait names start with a capital letter, got #{name}"), position: position + 1)
  end
  position = skip_newlines_at(tokens, position + 1)
  mutable methods = []
  while keyword_at?(tokens, position, %w[alias def])
    if keyword_at?(tokens, position, %w[alias])
      aliased = parse_trait_alias(tokens, position + 1, name, methods)
      return Step.new(node: aliased.node, position: aliased.position) if aliased.node in ErrorNode
      methods << aliased.node
      position = skip_newlines_at(tokens, aliased.position)
      next
    end
    method = parse_def(tokens, position + 1)
    # A trait is instance behavior with no state (ADR 0028); a type
    # function has no instance, so it cannot ride one (ADR 0031).
    if (method.node in DefNode) && method.node.type_function
      return Step.new(node: error_node("a trait cannot define def self.#{method.node.name} — a type function lives on the struct that includes it"), position: method.position)
    end
    methods << method.node
    position = skip_newlines_at(tokens, method.position)
  end
  if position < tokens.length && tokens[position].identifier?
    return Step.new(node: error_node("a trait has methods only — #{tokens[position].text} looks like state, and state belongs to the struct that includes #{name}"), position: position + 1)
  end
  unless keyword_at?(tokens, position, %w[end])
    return Step.new(node: error_node("expected end to close trait #{name}"), position: position)
  end
  return Step.new(node: error_node("trait #{name} has no methods — a bundle needs behavior"), position: position + 1) if methods.empty?
  Step.new(node: trait_def_node(name, methods), position: position + 1)
end

# `Foo::Bar` in expression position (ADR 0021). `::` names, `.` invokes —
# so a paren right after a path segment is a never-guess error.
def parse_path(tokens, first, mutable position)
  mutable parts = [first]
  while operator_at?(tokens, position, ["::"])
    position += 1
    if position >= tokens.length || !tokens[position].identifier?
      return Step.new(node: error_node("expected a name after ::"), position: position)
    end
    name = tokens[position].text
    position += 1
    if operator_at?(tokens, position, %w[(])
      return Step.new(node: error_node("`::` names, `.` invokes — write #{parts.join("::")}.#{name}(...) to call it"), position: position)
    end
    parts << name
  end
  Step.new(node: path_node(parts), position: position)
end

# `module Foo ... end` / `module Foo::Bar ... end` (ADR 0021).
def parse_module(tokens, mutable position)
  path = parse_namespace_path(tokens, position)
  return Step.new(node: path.node, position: path.position) if path.node in ErrorNode
  body = parse_body(tokens, path.position, %w[end])
  if keyword_at?(tokens, body.position, %w[end])
    return Step.new(node: module_def_node(path.node, body.node), position: body.position + 1)
  end
  Step.new(node: error_node("expected end to close module"), position: body.position)
end

# A `::`-separated run of capitalized names. Answers an array of names,
# or an ErrorNode.
def parse_namespace_path(tokens, mutable position)
  mutable parts = []
  while true
    if position >= tokens.length || !tokens[position].identifier?
      return Step.new(node: error_node("expected a name after module"), position: position)
    end
    name = tokens[position].text
    unless "ABCDEFGHIJKLMNOPQRSTUVWXYZ".include?(name.slice(0, 1))
      return Step.new(node: error_node("module names start with a capital letter, got #{name}"), position: position + 1)
    end
    parts << name
    position += 1
    break unless operator_at?(tokens, position, ["::"])
    position += 1
  end
  Step.new(node: parts, position: skip_newlines_at(tokens, position))
end

# — control flow —

# A branch body (ADR 0042): a `then` row holding one statement on the same
# line, `then` as a bare separator before an indented body, or the indented
# body alone. `then` against a terminator is an empty branch — ADR 0012's
# nil wearing a `then`. Step.node is the statement array (an error node
# rides inside it, so evaluation says the words).
def parse_branch_body(tokens, mutable position, terminators)
  if keyword_at?(tokens, position, %w[then])
    after = position + 1
    return Step.new(node: [], position: after) if keyword_at?(tokens, after, terminators)
    unless statement_boundary?(tokens, after)
      row = parse_statement(tokens, after)
      boundary = parse_branch_boundary(tokens, row.position, terminators)
      return Step.new(node: [boundary.node], position: boundary.position) if boundary.node in ErrorNode
      return Step.new(node: [row.node], position: boundary.position)
    end
    position = after
  end
  parse_body(tokens, position, terminators)
end

# An `else` body: a same-line row (`else 0`), an empty `else end`, or an
# indented body.
def parse_else_body(tokens, position, terminators)
  return Step.new(node: [], position: position) if keyword_at?(tokens, position, terminators)
  unless statement_boundary?(tokens, position)
    row = parse_statement(tokens, position)
    boundary = parse_branch_boundary(tokens, row.position, terminators)
    return Step.new(node: [boundary.node], position: boundary.position) if boundary.node in ErrorNode
    return Step.new(node: [row.node], position: boundary.position)
  end
  parse_body(tokens, position, terminators)
end

# After a same-line row: a newline, or one of the branch keywords directly.
# Anything else is one statement trying to be two.
def parse_branch_boundary(tokens, position, terminators)
  if statement_boundary?(tokens, position)
    return Step.new(node: nil, position: skip_newlines_at(tokens, position))
  end
  return Step.new(node: nil, position: position) if keyword_at?(tokens, position, terminators)
  Step.new(node: error_node("a then row takes one statement — expected a newline or #{terminators.join("/")} next, got #{tokens[position].text}"), position: position)
end

def parse_if(tokens, mutable position)
  condition = parse_expression(tokens, position)
  then_body = parse_branch_body(tokens, condition.position, %w[else elsif end])
  position = then_body.position
  if keyword_at?(tokens, position, %w[elsif])
    # Sugar for else + nested if; the chain shares one end, which the
    # recursive call consumes.
    nested = parse_if(tokens, position + 1)
    return Step.new(node: if_node(condition.node, then_body.node, [nested.node]), position: nested.position)
  end
  if keyword_at?(tokens, position, %w[else])
    else_body = parse_else_body(tokens, position + 1, %w[end])
    if keyword_at?(tokens, else_body.position, %w[end])
      return Step.new(node: if_node(condition.node, then_body.node, else_body.node), position: else_body.position + 1)
    end
    return Step.new(node: error_node("expected end to close if"), position: else_body.position)
  end
  if keyword_at?(tokens, position, %w[end])
    # Exhibit B, resolved: an absent else is nil — no longer conflated
    # with a present, empty else.
    return Step.new(node: if_node(condition.node, then_body.node, nil), position: position + 1)
  end
  Step.new(node: error_node("expected end to close if"), position: position)
end

# `unless c ... else ... end`, desugared to an if with swapped branches.
def parse_unless(tokens, mutable position)
  condition = parse_expression(tokens, position)
  body = parse_branch_body(tokens, condition.position, %w[else end])
  position = body.position
  if keyword_at?(tokens, position, %w[else])
    else_body = parse_else_body(tokens, position + 1, %w[end])
    position = else_body.position
    if keyword_at?(tokens, position, %w[end])
      return Step.new(node: if_node(condition.node, else_body.node, body.node), position: position + 1)
    end
    return Step.new(node: error_node("expected end to close unless"), position: position)
  end
  if keyword_at?(tokens, position, %w[end])
    return Step.new(node: if_node(condition.node, nil, body.node), position: position + 1)
  end
  Step.new(node: error_node("expected end to close unless"), position: position)
end

# `alias fu foo` (ADR 0039) — Ruby's order, new name first, bare words only:
# the symbol-taking form was `alias_method`, and that went out with the
# metaprogramming.
def parse_alias(tokens, position)
  first = parse_alias_name(tokens, position)
  return first unless first.node in String
  second = parse_alias_name(tokens, first.position)
  return second unless second.node in String
  Step.new(node: AliasNode.new(kind: "alias", new_name: first.node, old_name: second.node), position: second.position)
end

# One of alias's two names: Step.node is the name string, or an error node.
def parse_alias_name(tokens, position)
  if position >= tokens.length || !tokens[position].identifier?
    return Step.new(node: error_node("alias takes two method names — alias new_name old_name"), position: position)
  end
  name = tokens[position].text
  Step.new(node: name, position: position + 1)
end

# `loop do ... end` is `while true` in Ruby's favorite clothes (ADR 0037,
# revised same-day): a keyword form, not a method, so the desugar makes the
# sameness structural.
def parse_loop(tokens, position)
  unless keyword_at?(tokens, position, %w[do])
    return Step.new(node: error_node("`loop` takes a `do` block — write loop do ... end"), position: position)
  end
  body = parse_body(tokens, position + 1, %w[end])
  if keyword_at?(tokens, body.position, %w[end])
    return Step.new(node: while_node(boolean_node("true"), body.node), position: body.position + 1)
  end
  Step.new(node: error_node("expected end to close loop"), position: body.position)
end

# `until` is `while`'s negated twin (ADR 0037), the way `unless` is `if`'s —
# same loop node, condition wrapped in `not`.
def parse_while(tokens, position, negated)
  condition = parse_expression(tokens, position)
  mutable test = condition.node
  test = unary_node("!", test) if negated
  body = parse_body(tokens, condition.position, %w[end])
  if keyword_at?(tokens, body.position, %w[end])
    return Step.new(node: while_node(test, body.node), position: body.position + 1)
  end
  Step.new(node: error_node("expected end to close while"), position: body.position)
end

# Subjectless case is declined for now (#84): without a subject, `when`
# flips from ===-matching to truth-testing — one arm shape, two readings.
# The refusal names the rewrite, the seed's words.
def parse_case(tokens, mutable position)
  if position < tokens.length && tokens[position].kind == "newline"
    return Step.new(node: error_node("case takes a subject — a subjectless case is an if/elsif chain here"), position: position)
  end
  # The subject parses one notch below parse_expression, which would
  # greedily take a following `in` as the one-line match test — after a
  # case subject, `in` is the first arm (Ruby's own carve-out). A genuinely
  # match-test subject can still be written with parens.
  subject = parse_range(tokens, position)
  position = skip_newlines_at(tokens, subject.position)
  return parse_case_in(tokens, subject.node, position) if keyword_at?(tokens, position, %w[in])
  mutable branches = []
  while keyword_at?(tokens, position, %w[when])
    mutable step = parse_expression(tokens, position + 1)
    mutable values = [step.node]
    position = step.position
    while operator_at?(tokens, position, %w[,])
      step = parse_expression(tokens, position + 1)
      values << step.node
      position = step.position
    end
    body = parse_branch_body(tokens, position, %w[when else end])
    branches << when_node(values, body.node)
    position = body.position
  end
  if branches.empty?
    return Step.new(node: error_node("case needs at least one when"), position: position)
  end
  if keyword_at?(tokens, position, %w[else])
    else_body = parse_else_body(tokens, position + 1, %w[end])
    position = else_body.position
    if keyword_at?(tokens, position, %w[end])
      return Step.new(node: case_node(subject.node, branches, else_body.node), position: position + 1)
    end
    return Step.new(node: error_node("expected end to close case"), position: position)
  end
  if keyword_at?(tokens, position, %w[end])
    return Step.new(node: case_node(subject.node, branches, nil), position: position + 1)
  end
  Step.new(node: error_node("expected end to close case"), position: position)
end

# Parse a whole file of newline-separated statements. A statement that ends
# somewhere other than a newline becomes an error node, then parsing skips
# to the next line and carries on.
def parse_program(tokens)
  mutable nodes = []
  mutable position = 0
  while position < tokens.length
    if tokens[position].newline?
      position += 1
      next
    end
    step = parse_statement_with_guard(tokens, position)
    # `def self.` needs a struct body to mean anything (ADR 0031); a module
    # body accepts it as a plain def, and those never reach this loop. A
    # def nested in another def's body is not checked — a flat statement
    # walk cannot see it, the decline-to-check rule — and the seed refuses
    # it first. The wording is the seed's.
    if (step.node in DefNode) && step.node.type_function
      nodes << error_node("`def self.` belongs inside a struct body — write def #{step.node.name}")
      position = step.position
      next
    end
    nodes << step.node
    position = step.position
    next if statement_boundary?(tokens, position)
    nodes << error_node("expected newline after statement, got #{tokens[position].text}")
    while position < tokens.length && !tokens[position].newline?
      position += 1
    end
  end
  nodes
end

# — printing —
# The shared rendering helpers live in `trait Sexp` at the top of the file
# (ADR 0028): the structs that render carry them, and nothing else can.
