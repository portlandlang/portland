# Print the parse tree of a Portland file, one S-expression per statement.
#
# Usage: pdx compiler/parse.pdx <file.pdx>

require_relative "parser"

path = System.arguments.first or panic "parse.pdx: needs a file to parse"
source = System.read_file(path) or panic "parse.pdx: cannot read #{path}"
parse_program(lex(source)).each do |node|
  puts node.sexp
end
