# The linter's rules (#510): how a `.pdx` file is written, read off the
# compiler's own lexer and parser, so a file is read as the language reads
# it and never by pattern.
#
# It reports and changes nothing. A formatter needs a tree that keeps every
# comment and column, which the parser's does not.
#
# A rule is a def that takes a file's path, its text, and its top-level
# nodes, and answers its findings. `lint_source` runs each in turn.
#
# This file is held to its own rules, the order of its defs among them.

require_relative "inference"

# What each kind of top-level statement is called, in the order a file
# holds them (#509). A statement that is none of the first five is the
# last: what a driver runs.
KIND_NAMES = ["a require", "a constant", "a trait", "a struct", "a def", "a statement"]

# What may stand at the left margin inside a statement that runs over
# several lines: the words and brackets that close one or divide it.
MARGIN_WORDS = ["end", "else", "elsif", "when", "in", "]", "}", ")"]

# One thing to fix: the file, the line, and what is wrong with it.
struct LintFinding
  path
  line
  message
end

# Where a top-level statement falls in the order of a file (#509): its
# place in KIND_NAMES.
def kind_place(node)
  return 0 if node.kind == "call" && node.name == "require_relative"
  return 1 if node.kind == "assignment" && constant_name?(node.name)
  return 2 if node.kind == "trait_def"
  return 3 if node.kind == "struct_def"
  return 4 if node.kind == "def"
  5
end

# A line of code at the left margin inside a definition or a list: every
# line between where one top-level statement opens and the next one does is
# part of the first, and is indented under it.
def lint_margins(path, source, nodes)
  lines = source.split("\n")
  opened = nodes.map { it.line }.reject { it.nil? }
  mutable findings = []
  mutable index = 0
  while index < opened.length
    first = opened[index] or 0
    following = opened[index + 1] or lines.length + 1
    mutable number = first + 1
    while number < following
      text = lines[number - 1] or ""
      indented = text.start_with?(" ") || text.start_with?("\t")
      unless indented || margin_allowed?(text)
        findings << LintFinding.new(path: path, line: number, message: "this line is inside the statement that opens on line #{first}, and is not indented under it")
      end
      number += 1
    end
    index += 1
  end
  findings
end

# The order inside a struct or a trait (#509): its methods alphabetical.
def lint_method_order(path, nodes)
  mutable findings = []
  nodes.each do |node|
    next unless node.kind == "struct_def" || node.kind == "trait_def"
    mutable previous = nil
    node.methods.each do |method|
      if previous.some? && method.name < previous.name
        findings << LintFinding.new(path: path, line: (method.line or node.line), message: "#{method.name} is written after #{previous.name} — the methods of #{node.name} are alphabetical")
      end
      previous = method
    end
  end
  findings
end

# The order of a file (#509): its requires, its constants, its traits,
# its structs, its defs, and then what it runs, with each kind but the
# first and the last alphabetical. A constant built from another is
# written after it, whatever their names.
def lint_order(path, nodes)
  mutable findings = []
  mutable previous = nil
  nodes.each do |node|
    next if node.line.nil?
    place = kind_place(node)
    if previous.some?
      before = kind_place(previous)
      if place < before
        findings << LintFinding.new(path: path, line: node.line, message: "#{KIND_NAMES[place]} is written after #{KIND_NAMES[before]} — a file holds its requires, constants, traits, structs, and defs in that order, and then what it runs")
      elsif place == before && place >= 1 && place <= 4 && node.name < previous.name && !(place == 1 && mentions?(node.value, previous.name))
        findings << LintFinding.new(path: path, line: node.line, message: "#{node.name} is written after #{previous.name} — #{KIND_NAMES[place].slice(2, 20)}s are alphabetical")
      end
    end
    previous = node
  end
  findings
end

# A file that does not parse cannot be read for anything else. The
# trouble may be anywhere in it (#551): the parser leaves an error where
# it met one, inside a def or a block as much as at the top, so every
# node is looked at, and each is named in the parser's own words.
def lint_parse(path, nodes)
  walked(nodes).select { it in ErrorNode }.map { LintFinding.new(path: path, line: (it.line or 1), message: "this does not parse — #{it.message}") }
end

# Every finding in one file's text.
def lint_source(path, source)
  nodes = parse_program(lex(source))
  unparsed = lint_parse(path, nodes)
  return unparsed unless unparsed.empty?
  lint_margins(path, source, nodes) + lint_order(path, nodes) + lint_method_order(path, nodes)
end

# Whether a line at the margin is one that belongs there: empty, a comment,
# or a word or bracket that closes or divides the statement around it.
def margin_allowed?(text)
  return true if text.empty? || text.start_with?("#")
  MARGIN_WORDS.any? { |word| text == word || text.start_with?(word + " ") || text.start_with?(word + ")") || text.start_with?(word + ",") }
end

# Whether a name is read anywhere inside a node.
def mentions?(node, name)
  return false if node.nil?
  return true if (node in IdentifierNode) && node.name == name
  children_of(node).any? { mentions?(it, name) }
end
