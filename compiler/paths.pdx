# Paths, as both the evaluator and the checker need them: where a file's
# `require_relative` points. Shared so the two resolve a require the same
# way — the checker's whole-program door (#94) walks the same closure the
# runtime loads.

# The directory a path sits in, `.` for a bare name.
def directory_of(path)
  parts = path.split("/")
  return "." if parts.length < 2
  parts[0..-2].join("/")
end

# Resolve `.` and `..` segments textually, so every spelling of one file
# shares a load-once key: `spec/string/../spec_helper.pdx` and
# `spec/spec_helper.pdx` name the same file and now compare equal.
#
# The seed asks the filesystem to canonicalise; the compiler has no call that can,
# but a `..` following a named segment cancels it without one. The only case a
# text walk answers differently is a `..` that crosses a symlink, which the
# filesystem would resolve and this does not.
def canonical_path(path)
  absolute = path.start_with?("/")
  mutable parts = []
  path.split("/").each do |part|
    next if part.empty? || part == "."
    if part == ".." && !parts.empty? && parts.last != ".."
      parts = parts.slice(0, parts.length - 1)
    else
      parts << part
    end
  end
  joined = parts.join("/")
  return "/#{joined}" if absolute
  joined
end

# `-I dir` flags at the front of a command line (ADR 0077), as `ruby -I`
# takes them, the flag repeatable and the directory attached or not.
# Answers [directories, the arguments that follow].
def load_path_flags(arguments)
  mutable directories = []
  mutable rest = arguments
  while !rest.empty? && (rest.first == "-I" || (rest.first.start_with?("-I") && rest.first.length > 2))
    flag = rest.first or ""
    if flag == "-I"
      directory = rest[1]
      panic("pdx: -I needs a directory") if directory.nil?
      directories << directory
      rest = rest.slice(2, rest.length - 2)
    else
      directories << flag.slice(2, flag.length - 2)
      rest = rest.slice(1, rest.length - 1)
    end
  end
  [directories, rest]
end

# The load path (ADR 0077 §1): the `-I` directories in order, then the
# program's own `lib/` — beside the entry file, and under the directory
# `pdx` runs from — each once.
def default_load_path(entry, directories)
  mutable path = []
  (directories + ["#{directory_of(entry)}/lib", "lib"]).each do |directory|
    cleaned = canonical_path(directory)
    path << cleaned unless path.include?(cleaned)
  end
  path
end

# The files `require name` may mean under one directory (ADR 0077 §2): the
# name as written when it brought its extension, else `name.pdx` and
# `name.rb` — both present refuses, never picks.
def require_candidates(name, directory)
  joined = "#{directory}/#{name}"
  last_part = name.split("/").last or name
  return [joined] if last_part.include?(".")
  ["#{joined}.pdx", "#{joined}.rb"]
end

# The names `require` reads as core (ADR 0077 §4): a quiet no-op answering
# false, as Ruby 4's `require "set"` is for a library already loaded.
def core_require_name?(name) = %w[json set].include?(name)

# Where `require_relative name` from `from` points: relative to the
# requiring file's directory, `.pdx` assumed unless the last segment brought
# its own extension — a dot in an earlier segment does not count, so
# `a.b/c` still becomes `a.b/c.pdx`. The seed's rule, and the evaluator's.
def required_path_from(from, name)
  target = canonical_path("#{directory_of(from)}/#{name}")
  parts = target.split("/")
  # `last` is a maybe (ADR 0010) even though a split always yields a part —
  # the or-guard says so where the checker can see it (ADR 0047 shape 3).
  last_part = parts.last or return "#{target}.pdx"
  return target if last_part.include?(".")
  "#{target}.pdx"
end
