# The native build's types (#445): every def's parameters and answer pinned
# to concrete types, read off how the program calls it.
#
# Inference (inference.pdx) withholds an opinion wherever it cannot be sure,
# which is right for a checker that refuses only what it can disprove: a
# parameter is unknown, a def that calls itself answers unknown, and a name
# rebound inside a loop is unknown after it. A code generator needs a type
# for every value, so this pass asks a narrower question of a whole
# program: called the way it is called, what is each def's type?
#
#   - A def is pinned once for each combination of types it is called
#     with (ADR 0097): what its parameters are, and where it is handed a
#     block, what the block answers. Each is compiled as a function of its
#     own, so no two calls have to agree.
#   - A def that calls itself, or one that calls it back, is answered from
#     the ways out of its body that are known, and that answer is then
#     held to the whole body.
#   - A local keeps the type of its first binding; a rebinding to another
#     type unpins it. An empty array is the one exception: it takes its
#     element type from what is first appended to it (#497).
#   - A def that yields is pinned with its block (#493): the block's
#     parameters take the types of what the def yields, and a `yield` is
#     read as what the block answers.
#
# The checker reads none of this: knowing more, it would disprove more, and
# that is its own proposal. Expressions are still read by inference's
# `synthesize`; only the bindings around them are kept differently.

require_relative "core"
require_relative "inference"

# How many combinations of types one def may have. A def that calls
# itself with a larger type each time has no end of them, and the build
# stops here and says so.
COMBINATION_LIMIT = 48

# A name bound to a type: new names are added, a rebinding to the same type
# changes nothing, and a rebinding to another type leaves the name unknown.
# An array whose elements are not known yet is the same array once they
# are: an empty literal, named by its first append.
EMPTY_ARRAY = ArrayType.new(element: UnknownType.new)

# The name a struct being made is gathered under (#532), with the struct
# and the type of each field it was handed.
MAKING = "new"

# The name a `return` is gathered under where it is written straight in
# a def's body, which nothing reads: what it answers is read with the
# body, by what the conditions around it prove. One inside a block is
# gathered under `RETURN` by the walk of the block.
PLAIN_RETURN = "return here"

# The name a `return` inside a block is gathered under: a keyword, so no
# def has it.
RETURN = "return"

# How many rounds pinning takes before it is not going to settle. A
# round reaches one call deeper, so a program needs as many as its calls
# nest; past this, two rounds are answering each other back and forth.
ROUND_LIMIT = 200

# The methods of the core's types and of a program's structs as the
# native build compiles them (#525, #532): each a def that takes `self`
# first, and the shapes of call each answers, as bindings.
# One pinned combination beside the calls its body made when it was last
# walked (#537).
struct BodyRead
  found
  calls
  # The combinations those calls ask for, each once: what the body's
  # reading rests on.
  keys
end

# What differs between one round's answers and the next's (#537), as what
# a body may have read. A combination's answer is read only by a body
# that calls that combination, so those are kept by their keys, with the
# defs they are of. Every other entry, a field's type or what a def
# yields or is handed, is read by name, and gives the names in its key.
struct Changed
  names
  keys
  owners
end

struct CoreMethods
  definitions
  shapes
end

# What a walk over statements has gathered: the bindings in scope, and the
# calls seen, each as [def name, argument types, what the block it was
# handed answers or nil, whether that block can leave]. A `yield` is
# gathered the same way, under the name `yield`, with what it hands over,
# and a `return` under the name `return`, with what it answers.
# One round's gathering (#537): the walk with every call in it, each
# combination's own calls, and how many bodies were walked to get them.
struct GatheredRound
  walk
  read
  again
end

# The calls a round gathered, sorted by the name each calls (#537): the
# names in the order first met, and beside each, its calls in the order
# first met, each way of calling it once.
struct NamedCalls
  names
  calls
end

struct PinWalk
  bindings
  calls
end

# A yielding def's block: the types of what it is yielded, in order, the
# type it answers, and whether it can leave the def before the def is
# done (#523), or the reason these could not be pinned.
struct PinnedBlock
  parameters
  answer
  reason
  leaves
end

# One combination of a def's types (ADR 0097): its parameters as [name,
# type] pairs and its answer, or the reason it could not be pinned. A def
# nothing calls has one of these too, with no key.
struct PinnedDef
  name
  # The name this combination goes by, which the compiled function takes.
  key
  # What the calls of this combination hand the def, by place and by
  # name, and the def as that way of calling it has it (#536): its
  # parameters the ones handed over, the rest bound to their defaults
  # ahead of its body.
  arguments
  definition
  parameters
  answer
  reason
  # What a def that yields hands its block and reads back, as a
  # PinnedBlock, or nil for a def that does not yield.
  block

  def pinned? = reason.nil?
end

# A whole program's pinned types: each def's combinations, the defs in
# written order, and its top-level bindings as [name, type] pairs in
# first-appearance order. With them, every def a combination may be of,
# the core's among them, and the shapes of call the core's methods
# answer.
struct PinnedProgram
  defs
  bindings
  definitions
  shapes
  # The program's structs, and for each field made with more than one
  # type, a sentence saying so (#532).
  structs
  conflicts
end

# What rounds of pinning settle: the combinations of each def's types,
# and the type of each struct's fields, as bindings.
struct Settled
  pinned
  fields
end

# Every way out of a body, each with the type it answers: the early
# returns, and the last statement — an `if` there counting once per arm.
def answer_candidates(body, parameters, answers, names)
  mutable walk = PinWalk.new(bindings: parameters, calls: [])
  mutable found = []
  mutable last = [NilType.new]
  body.each do |statement|
    after = pin_statement(statement, walk, answers, names)
    scope = loop_scope(statement, walk, after) + answers
    found += return_types_in(statement, scope)
    last = value_candidates(statement, scope)
    walk = after
  end
  # A loop at the end answers nil where it can end, and nothing where it
  # cannot (#572).
  ending = body.last
  last = endless_loop?(ending) ? [] : [NilType.new] if ending in WhileNode
  found + returns_gathered(walk) + last
end

# Whether an entry's key is one a call reads (#537): a combination's
# answer, keyed by the def's name and what it is called with, in
# parentheses, or what that combination yields, keyed the same with `&`
# after. A body reads either only by making that call.
def answer_key?(key) = key.include?("(")

# The array a def's pinned combinations answer, as what they make
# together, or nil where none answers an array (#572).
def answered_array(name, answers)
  opening = "#{name}("
  arrays = answers.select { it[0].start_with?(opening) && (type_at(it, 1) in ArrayType) && concrete?(type_at(it, 1)) }.map { type_at(it, 1) }
  arrays.empty? ? nil : joined_types(arrays)
end

# Whether a body ends in what produces no value, read with the bindings
# its statements above the last one leave.
def answers_nothing?(body, parameters, answers, names)
  return false if body.empty?
  # A `return` with a value is an answer, whatever the body ends in.
  return false if returns_value?(body)
  # Only a call, a loop, an `if`, or a `yield` can end a body in nothing,
  # and nothing else is worth walking the body to ask (#537).
  ending = body.last
  closing = (case_as_if(ending) or ending)
  return false unless (closing in CallNode) || (closing in WhileNode) || (closing in IfNode) || (closing in YieldNode)
  above = pin_statements(body.slice(0, body.length - 1), PinWalk.new(bindings: parameters, calls: []), answers, names)
  native_nothing?(body, above.bindings + answers)
end

# The calls a walk of a block's body gathered, with each `return` written
# in the body gathered as one that leaves from inside a block (#523).
# `before` is how many calls were gathered ahead of the body.
def block_returns(calls, before)
  inside = calls.slice(before, calls.length - before).map { it[0] == PLAIN_RETURN ? [RETURN] + it.slice(1, it.length - 1) : it }
  calls.slice(0, before) + inside
end

# What a body answers: its last statement and its early returns, as
# inference's synthesize_body rules, but with bindings that keep their type.
def body_answer(body, parameters, answers, names)
  mutable walk = PinWalk.new(bindings: parameters, calls: [])
  mutable early = []
  mutable last = NilType.new
  body.each do |statement|
    after = pin_statement(statement, walk, answers, names)
    scope = loop_scope(statement, walk, after) + answers
    early += return_types_in(statement, scope)
    last = statement_answer(statement, scope)
    walk = after
  end
  # A body that ends in `panic` hands nothing back that way, so its
  # answer is what its returns say (#505).
  # A `return` inside a block leaves the def too (#523), so what it
  # answers is one of the def's answers.
  leaving = early + returns_gathered(walk)
  ending = body.last
  return merge_answers(leaving) if (ending in CallNode) && ending.name == "panic" && !leaving.empty?
  # A body that ends in a loop with a `return` inside answers what its
  # returns do (#572): a `while true` is left no other way, and a loop
  # that can end answers nil where it does.
  if (ending in WhileNode) && !leaving.empty?
    return merge_answers(endless_loop?(ending) ? leaving : leaving + [NilType.new])
  end
  merge_answers(leaving + [last])
end

# The calls one pinned combination's body makes, read with its
# parameters bound. A body's calls are its own: nothing in the walk reads
# the calls gathered before it, so each body is walked from none and the
# lists are joined, which keeps a call from being copied once for every
# call after it (#537).
def body_calls(found, names, answers)
  return [] if found.parameters.length != found.definition.parameters.length
  reading = yielding_answers(answers, found.block)
  twice_read_calls(found.definition.body, found.parameters, reading, names)
end

# One line of what the build is doing (#543), on standard error, with
# the time since the build began. `started` is the clock's reading then.
def build_note(started, message)
  System.write_standard_error("[#{seconds_between(started, System.monotonic_time).rjust(8)}] #{message}\n")
end

# The name of the combination a gathered call asks for.
def call_key(call) = combination_key(call[0], type_at(call, 1), type_at(call, 2), type_at(call, 3) == true)

# A def as one way of calling it has it (#536): `placed` handed by place
# and `named` by name. Its parameters are the ones handed over, by place
# and then by name in the order written, and each parameter left out is
# bound to its default ahead of the body, in the order written, so a
# default may read a parameter before it. Nil where the def cannot be
# called that way: too few or too many by place, a name it does not
# take, or a parameter left out that has no default.
def called_definition(definition, placed, named)
  by_place = definition.parameters.reject { it in KeywordParameterNode }
  by_name = definition.parameters.select { it in KeywordParameterNode }
  return nil if placed > by_place.length
  return nil unless named.all? { |label| by_name.any? { it.name == label } }
  mutable handed = []
  mutable defaulted = []
  mutable place = 0
  definition.parameters.each do |parameter|
    if parameter in KeywordParameterNode
      if named.include?(parameter.name)
        handed << parameter
      else
        defaulted << [parameter, parameter.default]
      end
    else
      if place < placed
        handed << parameter
      else
        defaulted << [parameter, (parameter in AssignmentNode) ? parameter.value : nil]
      end
      place += 1
    end
  end
  return nil if defaulted.any? { type_at(it, 1).nil? }
  # By place first, then by name: the order a call's arguments arrive in.
  ordered = handed.reject { it in KeywordParameterNode } + handed.select { it in KeywordParameterNode }
  parameters = ordered.map { IdentifierNode.new(kind: "identifier", name: it.name, line: definition.line) }
  prelude = defaulted.map { AssignmentNode.new(kind: "assignment", name: it[0].name, value: type_at(it, 1), rebindable: true, line: definition.line) }
  definition.with(parameters: parameters, body: prelude + definition.body)
end

# Gathered calls sorted by the name each calls (#537), each way of
# calling a name kept once. A lookup by name is then one search of the
# names, where it was a walk of every call.
def calls_by_name(calls)
  mutable names = []
  mutable sorted = []
  calls.each do |call|
    place = names.index(call[0])
    if place.nil?
      names << call[0]
      sorted << [call]
    else
      held = sorted[place] or []
      sorted[place] = held + [call] unless held.include?(call)
    end
  end
  NamedCalls.new(names: names, calls: sorted)
end

# The calls of one name among calls sorted by name.
def calls_of(sorted, name)
  place = sorted.names.index(name)
  place.nil? ? [] : (sorted.calls[place] or [])
end

# What differs between one round's answers and the next's (#537): each
# entry added, dropped, or changed, sorted by how a body would have read
# it.
def changed_between(before, after)
  differing = (after.reject { before.include?(it) } + before.reject { after.include?(it) }).map { it[0] }.uniq
  answers = differing.select { answer_key?(it) }
  fields = differing.select { field_entry?(it) }
  others = differing.reject { answer_key?(it) || field_entry?(it) }
  # A field's entry is read two ways. By a body that names its struct,
  # which is given the struct's name. And through a value that is one of
  # several structs, as the one type every struct with a field of that
  # name holds there: the field's name counts only where that type is no
  # longer what it was, which a struct made for the first time, with a
  # `kind` and a `line` like every other, does not make it.
  owners = fields.map { (it.split(".").first or it) }
  shifted = fields.map { (it.split(".").last or it) }.uniq.select { shared_field(it, before) != shared_field(it, after) }
  names = (others.flat_map { key_names(it) } + owners + shifted).uniq
  Changed.new(names: names, keys: answers, owners: answers.map { (it.split("(").first or it) }.uniq)
end

# Whether a type says everything a code generator needs: no unknown in it.
def concrete?(type) = type == NOTHING || !render_native_type(type).include?("Unknown")

# A program with each constant bound at its top level as a def of that
# name, with no parameters, answering its value (#562): a read of the
# constant is then a call. Done twice, it is done once.
def constants_as_defs(nodes)
  nodes.map do |node|
    constant = (node in AssignmentNode) && node.value.some? && constant_name?(node.name)
    constant ? def_node(node.name, [], [node.value], false, line: node.line) : node
  end
end

# Every def beside the names its body mentions (#537). A def reads an
# answer, a field, or what a block is handed only by a name it writes,
# save for the two a value is written out by, which every def is taken to
# mention. Its own name is not among them unless it calls itself: what a
# combination was pinned as is held beside it, and compared.
def definition_mentions(definitions)
  definitions.map { [it.name, (mentioned_names(it.body) + %w[inspect to_s]).uniq] }
end

# A body that may not be there, each statement read by `on_self`.
def each_on_self(body, own)
  return nil if body.nil?
  body.map { on_self(it, own) }
end

# For each field of a struct made with types that do not join, a sentence
# saying so (#532). The native build gives a field one type, as it gives
# an array's elements one; a value in one place and nil or a maybe of it
# in another join as a maybe (#553).
def field_conflicts(calls)
  mutable sentences = []
  made_fields(calls).each do |made|
    types = unique_types(type_at(made, 1).select { concrete?(it) })
    next unless types.length > 1 && joined_field(types).nil?
    other = types.find { joined_field([types[0], it]).nil? } or types[1]
    sentences << "#{made[0]} is #{with_article(types[0])} where one is made and #{with_article(other)} where another is"
  end
  sentences
end

# Whether an entry's key is a struct's field (#537): the struct's name,
# a dot, and the field's. A struct the program makes is keyed with a dot
# too and ends in `&`, and is read by the struct's name.
def field_entry?(key) = key.include?(".") && !key.include?("(") && !key.include?("#") && !key.include?("[") && !key.end_with?("&")

# A struct's fields that a method reads by their bare names, each bound
# ahead of the method's body from `self` (#532). In a method a field is
# in scope as a name; as a def handed `self`, it is a local read out of
# it.
def field_prelude(fields, method)
  read = fields.select { |field| reads_name?(method.body, field) }
  read.map do |field|
    receiver = SelfNode.new(kind: "self", line: method.line)
    value = MethodCallNode.new(kind: "method_call", receiver: receiver, name: field, arguments: [], block: nil, line: method.line)
    AssignmentNode.new(kind: "assignment", name: field, value: value, rebindable: false, line: method.line)
  end
end

# Bindings with each array that holds nothing bound to the array a walk
# left it as, and every other binding as it was.
def filled_arrays(before, after)
  return before unless before.any? { type_at(it, 1) == EMPTY_ARRAY }
  before.map do |binding|
    left = type_at(binding, 1) == EMPTY_ARRAY ? after.assoc(binding[0]) : nil
    left.nil? || !concrete?(type_at(left, 1)) ? binding : left
  end
end

# The calls every body reached names: the top level's, and those of each
# combination pinned so far, read with its own parameters.
def gathered_calls(definitions, statements, names, answers, pinned)
  gathered_round(statements, names, answers, pinned, nil, [], []).walk
end

# One round's gathering, keeping each body's calls beside the combination
# they were read from. A body is walked again only where it must be
# (#537): with `changed` the names whose entries differ from the round
# before, a combination pinned as it was then, in a def that names none
# of them, makes the calls it made then. With `changed` nil every body is
# walked.
def gathered_round(statements, names, answers, pinned, changed, mentions, read_before)
  walk = pin_statements(statements, PinWalk.new(bindings: [], calls: []), answers, names)
  mutable calls = twice_read_calls(statements, [], answers, names)
  mutable read = []
  mutable again = 0
  pinned.each do |found|
    before = changed.nil? ? nil : read_before.find { it.found.key == found.key }
    kept = before.some? && read_alike?(before.found, found) && unaffected?(found.definition.name, before.keys, changed, mentions)
    again += 1 unless kept
    made = kept ? before.calls : body_calls(found, names, answers)
    read << BodyRead.new(found: found, calls: made, keys: (kept ? before.keys : keys_read(made, names)))
    calls += made
  end
  GatheredRound.new(walk: walk.with(calls: calls), read: read, again: again)
end

# The array each def is handed in each place, by the combinations pinned
# (#572), as bindings: what an empty array handed there is read as. Where
# the combinations hand different arrays there, what those make together.
def handed_arrays(pinned)
  mutable found = []
  pinned.each do |combination|
    mutable place = 0
    combination.arguments.each do |argument|
      named = argument in KeywordType
      label = named ? argument.label : place.to_s
      type = named ? argument.type : argument
      place += 1 unless named
      next unless (type in ArrayType) && concrete?(type)
      key = handed_array_key(combination.name, label)
      held = found.assoc(key)
      if held.nil?
        found << [key, type]
      else
        joined = joined_plain(type_at(held, 1), type)
        found = found.map { it[0] == key ? [key, joined] : it } if joined.some?
      end
    end
  end
  found
end

# Whether what a call hands is nothing, by place or by name (#591).
def handed_nothing?(type) = type == NOTHING || ((type in KeywordType) && type.type == NOTHING)

# The one type a field made with these holds (#553), or nil where they do
# not join: the same type throughout; a value and nil or a maybe of it,
# which is a maybe of it, as a local bound both ways is (#505); or one
# struct and another, which is one of several structs (#572).
def joined_field(types) = joined_types(types)

# The names in an answer's key (#537): `Array#map([Token]) { Integer }`
# gives `Array` and `map`, and `Token.text` gives `Token` and `text`.
def key_names(key)
  head = ((key.split("(").first or key).split("[").first or key)
  head.split("#").flat_map { it.split(".") }
end

# The entries a body's calls read (#537), each once: the combination each
# call asks for, and for a call that hands a block, what that def yields,
# which the block's parameters are read from.
def keys_read(calls, names)
  mutable keys = []
  calls.select { names.include?(it[0]) }.each do |call|
    keys << call_key(call)
    keys << yields_key(call[0], type_at(call, 1)) if type_at(call, 2).some?
  end
  keys.uniq
end

# The bindings a statement is read with: the ones above it, and for a
# loop, each of those as the loop leaves it (#572). A local has one type,
# so an array that goes into a loop empty is, inside it, the array the
# loop's appends make it.
def loop_scope(statement, walk, after)
  return walk.bindings unless statement in WhileNode
  filled_arrays(walk.bindings, after.bindings)
end

# Every field the gathered calls made, as [its key, the types it was
# handed], one entry for each field.
def made_fields(calls)
  # Each way a struct is made is read once, and a field's types are kept
  # at the field's place, found by one search of the keys (#537).
  mutable keys = []
  mutable types = []
  calls_of(calls_by_name(calls), MAKING).each do |call|
    made = type_at(call, 1)
    type_at(made, 1).each do |handed|
      key = field_key(made[0], handed[0])
      place = keys.index(key)
      if place.nil?
        keys << key
        types << [type_at(handed, 1)]
      else
        types[place] = (types[place] or []) + [type_at(handed, 1)]
      end
    end
  end
  mutable fields = []
  keys.each_with_index do |key, place|
    fields << [key, (types[place] or [])]
  end
  fields
end

# Every name written anywhere in a body (#537): a name read, a call, a
# method, and a keyword's label.
def mentioned_names(nodes)
  nodes.reject { it.nil? }.flat_map do |node|
    own = case node
    in CallNode(name:)             then [name]
    in IdentifierNode(name:)       then [name]
    in KeywordArgumentNode(label:) then [label]
    in MethodCallNode(name:)       then [name]
    else []
    end
    own + mentioned_names(children_of(node))
  end
end

# The one type a body's ways out answer together. Where they are one
# value's type, with nil or a maybe of it among them, that is a maybe of
# the value (#505): `return "none"` beside a last expression that is a
# String or nil. Where they are one struct and another, that is one of
# several structs (#572). Otherwise inference's own rule stands.
def merge_answers(candidates)
  (joined_types(candidates) or merge_candidates(candidates))
end

# For each method name, the program's structs that write a method of
# that name (#572), as bindings: what a method asked of one of several
# structs is looked up in. `shapes` is every method's shape of call,
# keyed by its struct and its name.
def method_owners(shapes, structs)
  mutable names = []
  mutable owners = []
  shapes.each do |shape|
    parts = shape[0].slice(0, shape[0].length - 1).split("#")
    owner = parts.first or ""
    name = parts.last or ""
    next unless parts.length == 2 && structs.include?(owner)
    place = names.index(name)
    if place.nil?
      names << name
      owners << [owner]
    else
      owners[place] = (owners[place] or []) + [owner]
    end
  end
  mutable bound = []
  names.each_with_index do |name, place|
    bound << [any_method_key(name), (owners[place] or [])]
  end
  bound
end

# A statement of a struct's method with each of the struct's own methods
# that it calls by a bare name asked of `self` (#572): `headed(items)`
# written in a method is `self.headed(items)`, as the interpreters read
# it. As a def handed `self`, the method has no other way to say whose
# method it means. `own` is the names of the struct's methods; a name
# cannot be both a method and a local, so a bare one is the method.
def on_self(node, own)
  return nil if node.nil?
  case node
  in CallNode(name:, arguments:, block:)
    handed = arguments.map { on_self(it, own) }
    given = on_self(block, own)
    return node.with(arguments: handed, block: given) unless own.include?(name)
    MethodCallNode.new(kind: "method_call", receiver: SelfNode.new(kind: "self", line: node.line), name: name, arguments: handed, block: given, line: node.line)
  in IdentifierNode(name:)
    return node unless own.include?(name)
    MethodCallNode.new(kind: "method_call", receiver: SelfNode.new(kind: "self", line: node.line), name: name, arguments: [], block: nil, line: node.line)
  in BlockNode(body:) then node.with(body: body.map { on_self(it, own) })
  in AssignmentNode(value:) then node.with(value: on_self(value, own))
  in AppendNode(value:) then node.with(value: on_self(value, own))
  in WhileNode(condition:, body:) then node.with(condition: on_self(condition, own), body: body.map { on_self(it, own) })
  in IfNode(condition:, then_body:, else_body:)
    node.with(condition: on_self(condition, own), then_body: each_on_self(then_body, own), else_body: each_on_self(else_body, own))
  in CaseNode(subject:, branches:, else_body:)
    arms = branches.map { |branch| branch.with(values: branch.values.map { on_self(it, own) }, body: branch.body.map { on_self(it, own) }) }
    node.with(subject: on_self(subject, own), branches: arms, else_body: each_on_self(else_body, own))
  in CaseInNode(subject:, branches:, else_body:)
    arms = branches.map { |branch| branch.with(guard: on_self(branch.guard, own), body: branch.body.map { on_self(it, own) }) }
    node.with(subject: on_self(subject, own), branches: arms, else_body: each_on_self(else_body, own))
  in ReturnNode(value:) then node.with(value: on_self(value, own))
  in MethodCallNode(receiver:, arguments:, block:)
    node.with(receiver: on_self(receiver, own), arguments: arguments.map { on_self(it, own) }, block: on_self(block, own))
  in SafeMethodCallNode(receiver:, arguments:, block:)
    node.with(receiver: on_self(receiver, own), arguments: arguments.map { on_self(it, own) }, block: on_self(block, own))
  in ArrayNode(elements:) then node.with(elements: elements.map { on_self(it, own) })
  in HashNode(pairs:) then node.with(pairs: pairs.map { |pair| pair.with(key: on_self(pair.key, own), value: on_self(pair.value, own)) })
  in BinaryNode(left:, right:) then node.with(left: on_self(left, own), right: on_self(right, own))
  in LogicalNode(left:, right:) then node.with(left: on_self(left, own), right: on_self(right, own))
  in UnaryNode(operand:) then node.with(operand: on_self(operand, own))
  in IndexNode(receiver:, index:) then node.with(receiver: on_self(receiver, own), index: on_self(index, own))
  in RangeNode(start:, finish:) then node.with(start: on_self(start, own), finish: on_self(finish, own))
  in MatchAssertNode(subject:) then node.with(subject: on_self(subject, own))
  in MatchTestNode(subject: tested) then node.with(subject: on_self(tested, own))
  in KeywordArgumentNode(value:) then node.with(value: on_self(value, own))
  in YieldNode(values:) then node.with(values: values.map { on_self(it, own) })
  else
    node
  end
end

# Each name once, at the type it holds: where a guard's proof is bound
# ahead of a name's own binding, the binding beneath it.
def own_bindings(bindings)
  mutable own = []
  mutable seen = []
  bindings.reverse.each do |binding|
    next if seen.include?(binding[0]) || proved_key?(binding[0])
    seen << binding[0]
    own = [binding] + own
  end
  own
end

# A method's shape, for a call to be held to (ADR 0093, #536): the
# fewest parameters it takes by place and the most, whether it yields,
# and the names it takes.
def parameters_shape(parameters, yielding)
  by_place = parameters.reject { it in KeywordParameterNode }
  required = by_place.reject { (it in AssignmentNode) && it.value.some? }
  [required.length, by_place.length, yielding, parameters.select { it in KeywordParameterNode }.map { it.name }]
end

# A call that hands one of the program's defs a block (#493). The block's
# parameters are bound to what that combination of the def yields, as far
# as that is pinned; its body is walked for the calls inside it; and what
# it answers is gathered with the call, since it is part of which
# combination the call names. A name the block binds first is the block's
# own, so the bindings after are the ones before, with whatever the block
# rebound.
def pin_block_call(node, walk, answers, names)
  mutable current = walk
  node.arguments.each do |argument|
    current = pin_statement(argument, current, answers, names)
  end
  scope = current.bindings + answers
  arguments = filled_arguments(node.name, native_argument_types(node.arguments, scope), scope)
  answer = native_block_answer(node, arguments, scope)
  leaves = native_block_leaves?(node.block, scope)
  yielded = answers.assoc(yields_key(node.name, arguments))
  mutable inner = current.bindings
  mutable index = 0
  node.block.parameters.each do |parameter|
    type = yielded.nil? ? nil : type_at(type_at(yielded, 1), index)
    inner = [[parameter, (type or UnknownType.new)]] + inner
    index += 1
  end
  walked = walked_block(node.block.body, current.with(bindings: inner), answers, names)
  outer = current.bindings.length
  kept = unnarrowed(current.bindings, walked.bindings.slice(walked.bindings.length - outer, outer))
  PinWalk.new(bindings: kept, calls: block_returns(walked.calls, current.calls.length) + [[node.name, arguments, answer, leaves]])
end

# One combination of a def's types: its parameters from the arguments,
# what it yields from its body, and then its answer.
def pin_combination(definition, arguments, handed, leaves, answers, names, strict)
  key = combination_key(definition.name, arguments, handed, leaves)
  unpinned = PinnedDef.new(name: definition.name, key: key, arguments: arguments, definition: definition, parameters: [], answer: UnknownType.new, reason: nil, block: nil)
  placed = arguments.reject { it in KeywordType }
  named = arguments.select { it in KeywordType }
  called = called_definition(definition, placed.length, named.map { it.label })
  return unpinned.with(reason: "its parameters do not take what one call hands it") if called.nil?
  mutable parameters = []
  mutable index = 0
  called.parameters.each do |parameter|
    handed_by_name = named.find { it.label == parameter.name }
    type = index < placed.length ? type_at(placed, index) : (handed_by_name.nil? ? nil : handed_by_name.type)
    parameters << [parameter.name, (type or UnknownType.new)]
    index += 1
  end
  block = pinned_block(called, parameters, handed, leaves, answers, names, strict)
  # A combination refused for its block keeps what it yields, which a
  # call site reads its block with.
  return unpinned.with(definition: called, parameters: parameters, reason: block.reason, block: block) if block.some? && block.reason.some?
  starting = settled_start(called.body, parameters, yielding_answers(answers, block), names)
  solved = solved_answer(called, key, starting, yielding_answers(answers, block), names, strict)
  # A def whose every way out answers nil answers nothing (#561).
  # One whose every way out is an empty array answers the array its
  # other combinations do (#572): an empty literal says nothing of what
  # it holds, and the def's other answers do.
  borrowed = solved == EMPTY_ARRAY ? answered_array(definition.name, answers) : nil
  answer = solved == NilType.new ? NOTHING : (borrowed or solved)
  reason = concrete?(answer) ? nil : "its answer is #{render_type(answer)}"
  PinnedDef.new(name: definition.name, key: key, arguments: arguments, definition: called, parameters: parameters, answer: answer, reason: reason, block: block)
end

# Every combination the calls gathered name, the defs in written order
# and each def's combinations in the order they were first met. A call
# with an argument whose type is not known names none, and is read again
# once more is pinned. With `changed` the names whose entries differ from
# the round before, a combination of a def that names none of them is
# kept as `before` pinned it (#537); with `changed` nil each is pinned
# afresh.
def pin_combinations(definitions, calls, answers, names, strict, changed, mentions, before, read)
  mutable pinned = []
  before_keys = before.map { it.key }
  read_keys = read.map { it.found.key }
  # The calls are sorted by the name called once, and not searched whole
  # for each def (#537): that search was most of a round.
  sorted = calls_by_name(calls)
  definitions.each do |definition|
    sites = calls_of(sorted, definition.name)
    met = unique_types(sites.map { [type_at(it, 1), type_at(it, 2), type_at(it, 3) == true] })
    met.each do |combination|
      arguments = type_at(combination, 0)
      handed = type_at(combination, 1)
      # An empty array handed over is pinned as it is (#591): a def that
      # answers what it was handed, grown, says through its answer what
      # the array holds, and the call that hands it back is then pinned
      # with that. Only what the program reaches is built.
      next unless arguments.all? { concrete?(it) || pinned_empty?(it) } && (handed.nil? || concrete?(handed))
      leaves = type_at(combination, 2)
      key = combination_key(definition.name, arguments, handed, leaves)
      # Kept as the round before pinned it where nothing its body read
      # has changed: its body's calls say which answers that was.
      held = changed.nil? ? nil : before_keys.index(key)
      body = held.nil? ? nil : read_keys.index(key)
      steady = body.some? && unaffected?(definition.name, (read[body] or panic("a body read is missing")).keys, changed, mentions)
      kept = steady ? before[held] : nil
      pinned << (kept or pin_combination(definition, arguments, handed, leaves, answers, names, strict))
    end
  end
  pinned
end

# The calls to the program's defs anywhere inside an expression, each with
# its arguments' types as the bindings in scope give them.
def pin_expression(node, walk, answers, names)
  # `value&.name` is walked as the `if` it means (#572).
  guarded = safe_as_if(node)
  return pin_statement(guarded, walk, answers, names) if guarded.some?
  # An `if` read for its value is walked as one run for what it does,
  # each arm with what the condition proved (#572).
  return pin_statement(node, walk, answers, names) if node in IfNode
  # The right of an `&&` or an `||` is walked with what the left proved
  # (#572), so a call there is gathered with the types it is read with.
  if (node in LogicalNode) && %w[&& ||].include?(node.operator)
    after_left = pin_statement(node.left, walk, answers, names)
    proof = shape_narrowings(node.left, after_left.bindings + answers)
    proved = node.operator == "&&" ? when_true(proof) : when_false(proof)
    after_right = pin_statement(node.right, after_left.with(bindings: narrowed_bindings(after_left.bindings, proved)), answers, names)
    return after_right.with(bindings: unnarrowed(after_left.bindings, after_right.bindings))
  end
  return pin_block_call(node, walk, answers, names) if (node in CallNode) && node.block.some? && names.include?(node.name)
  # A method the core writes for the receiver's type is a def (#525), and
  # the call is gathered as a call of it.
  if node in MethodCallNode
    scope = walk.bindings + answers
    called = native_method_call(node, synthesize(node.receiver, scope), scope)
    return pin_expression(called, walk, answers, names) if called.some?
    # Asked of one of several structs, it is a call of each struct's own
    # method (#572), and each is gathered.
    several = dispatched_calls(node, synthesize(node.receiver, scope), scope)
    unless several.empty?
      mutable gathering = walk
      several.each do |one|
        gathering = pin_expression(one, gathering, answers, names)
      end
      return gathering
    end
  end
  return pin_walk(node, walk, answers, names) if (node in MethodCallNode) && node.block.some?
  mutable current = walk
  # A struct being made is gathered with what each field is handed
  # (#532): a field has one type, read off every place the struct is made.
  # Nothing is handed to a field or a def, since what produces no value
  # cannot be used as one (#591); a call read as handing one is read
  # before what it hands settled, and is not gathered, or the stale
  # reading feeds itself from round to round.
  if (node in MethodCallNode) && node.name == "new"
    reading = current.bindings + answers
    made = synthesize(node.receiver, reading)
    if made in ClassType
      handed = node.arguments.select { it in KeywordArgumentNode }.map { [it.label, synthesize(it.value, reading)] }
      current = current.with(calls: current.calls + [[MAKING, [made.name, handed], nil, false]]) unless handed.any? { type_at(it, 1) == NOTHING }
    end
  end
  # `with` hands a field its value as `new` does (#576), so what it hands
  # counts toward the field's one type.
  if (node in MethodCallNode) && node.name == "with"
    reading = current.bindings + answers
    asked = synthesize(node.receiver, reading)
    if asked in StructType
      handed = node.arguments.select { it in KeywordArgumentNode }.map { [it.label, synthesize(it.value, reading)] }
      current = current.with(calls: current.calls + [[MAKING, [asked.name, handed], nil, false]]) unless handed.any? { type_at(it, 1) == NOTHING }
    end
  end
  if (node in CallNode) && names.include?(node.name)
    scope = current.bindings + answers
    handed = native_argument_types(node.arguments, scope)
    current = current.with(calls: current.calls + [[node.name, filled_arguments(node.name, handed, scope), nil, false]]) unless handed.any? { handed_nothing?(it) }
  end
  if node in YieldNode
    scope = current.bindings + answers
    current = current.with(calls: current.calls + [[YIELD, node.values.map { synthesize(it, scope) }, nil, false]])
  end
  # A def with no parameters is called by its bare name, which parses as a
  # name and not as a call; a local of that name would be the local.
  if (node in IdentifierNode) && names.include?(node.name) && current.bindings.none? { it[0] == node.name }
    current = current.with(calls: current.calls + [[node.name, [], nil, false]])
  end
  children_of(node).each do |child|
    current = pin_statement(child, current, answers, names)
  end
  current
end

def pin_program(written, core: nil, progress: nil)
  nodes = constants_as_defs(written)
  own = nodes.select { it in DefNode }
  structs = nodes.select { it in StructDefNode }
  methods = type_methods(nodes, core)
  # The core's functions and methods are defs like the program's own, and
  # are compiled where the program calls them.
  definitions = own + (core or []).select { it in DefNode } + methods.definitions
  statements = nodes.reject { it in DefNode }
  names = definitions.map { it.name }
  # What every scope reads beside the answers: the shapes of call the
  # methods answer, and each struct's name as the type it is.
  fixed = methods.shapes + method_owners(methods.shapes, structs.map { it.name }) + structs.map { [it.name, ClassType.new(name: it.name)] }
  # Two passes. The first pins from the arguments whose types are known,
  # since `double(double(3))` cannot say its outer argument until `double`
  # itself is pinned, and takes a def that calls itself at the answer its
  # known ways out give. The second holds each such answer to the def's
  # whole body.
  reached = settle_pins(definitions, statements, names, fixed, Settled.new(pinned: [], fields: []), false, progress)
  settled = settle_pins(definitions, statements, names, fixed, reached, true, progress)
  pinned = settled.pinned
  answers = fixed + settled.fields + pinned_answers(pinned)
  walk = gathered_calls(definitions, statements, names, answers, pinned)
  top = own_bindings(pin_statements(statements, PinWalk.new(bindings: [], calls: []), answers, names).bindings)
  # A def with no combination is one nothing calls, or one called only
  # with a value whose type is not known. Of those, the program's own are
  # listed; the core's are most of the core.
  mutable listed = []
  definitions.each do |definition|
    combinations = pinned.select { it.name == definition.name }
    if combinations.empty? && own.include?(definition)
      reason = walk.calls.any? { it[0] == definition.name } ? "it is called with a value whose type is not known" : "nothing calls it"
      listed << PinnedDef.new(name: definition.name, key: nil, arguments: [], definition: definition, parameters: [], answer: UnknownType.new, reason: reason, block: nil)
    else
      listed += combinations
    end
  end
  PinnedProgram.new(defs: listed, bindings: top.reverse, definitions: definitions, shapes: fixed + settled.fields, structs: structs, conflicts: field_conflicts(walk.calls))
end

# One statement: the calls inside it are recorded with the bindings above
# it, and what it binds is in scope below. A loop's and a branch's bodies
# are walked in place, so a name bound above them keeps its type inside
# and after.
def pin_statement(statement, walk, answers, names)
  # A `case` over literals is walked as the `if`s it means (#558).
  plain = case_as_if(statement)
  return pin_statement(plain, walk, answers, names) if plain.some?
  case statement
  in AssignmentNode(name:, value:)
    return walk if value.nil?
    seen = pin_expression(value, walk, answers, names)
    seen.with(bindings: rebound(seen.bindings, name, synthesize(value, seen.bindings + answers)))
  # A `return` is gathered with what it answers, wherever it is written:
  # one inside a block leaves the def as one outside it does (#523).
  in ReturnNode(value:)
    return walk.with(calls: walk.calls + [[PLAIN_RETURN, [NilType.new], nil, false]]) if value.nil?
    seen = pin_expression(value, walk, answers, names)
    seen.with(calls: seen.calls + [[PLAIN_RETURN, [synthesize(value, seen.bindings + answers)], nil, false]])
  # What a guard in a loop's body proved of a name holds no further than
  # the body (#572).
  # An array that goes in empty and is appended to in the body is that
  # array wherever the body reads it, so the body is walked again with
  # what it left, and the calls of that walk are the ones kept.
  in WhileNode(condition:, body:)
    entering = pin_expression(condition, walk, answers, names)
    first = pin_statements(body, entering, answers, names)
    left = unnarrowed(walk.bindings, first.bindings)
    kept = filled_arrays(entering.bindings, left)
    return first.with(bindings: left) if kept == entering.bindings
    turned = pin_statements(body, entering.with(bindings: kept), answers, names)
    turned.with(bindings: unnarrowed(walk.bindings, turned.bindings))
  # A name that holds one of several structs is the one the condition
  # proved it to be, in the arm where that holds, and below the `if`
  # where the other arm always leaves (#572).
  in IfNode(condition:, then_body:, else_body:)
    after_condition = pin_expression(condition, walk, answers, names)
    entering = after_condition.bindings
    # Only the arm that runs is walked (#572).
    settled = settled_arm(statement, entering + answers)
    return pin_statements(settled, after_condition, answers, names) if settled.some?
    proof = shape_narrowings(condition, entering + answers)
    taken = pin_statements((then_body or []), after_condition.with(bindings: narrowed_bindings(entering, when_true(proof))), answers, names)
    after_then = taken.with(bindings: unnarrowed(entering, taken.bindings))
    other = pin_statements((else_body or []), after_then.with(bindings: narrowed_bindings(after_then.bindings, when_false(proof))), answers, names)
    after_else = other.with(bindings: unnarrowed(entering, other.bindings))
    # What a guard proved is bound ahead of the name's own binding, which
    # stays beneath it as the type the name holds.
    after_else.with(bindings: shape_guard(statement, entering + answers) + after_else.bindings)
  else
    pin_expression(statement, walk, answers, names)
  end
end

def pin_statements(statements, walk, answers, names)
  mutable current = walk
  statements.each do |statement|
    current = pin_statement(statement, current, answers, names)
  end
  current
end

# A block handed to a method of a value (#497), as `each` on an array.
# Its parameters are bound by the receiver's type, the way inference
# binds them; its body is walked for the calls inside it and for what it
# rebinds; and a name it binds first is its own.
def pin_walk(node, walk, answers, names)
  mutable current = pin_statement(node.receiver, walk, answers, names)
  node.arguments.each do |argument|
    current = pin_statement(argument, current, answers, names)
  end
  scope = current.bindings + answers
  # A maybe is opened for the walk (#591), so the block is handed what
  # the array holds.
  receiver = opened_natively(synthesize(node.receiver, scope), scope)
  arguments = node.arguments.map { synthesize(it, scope) }
  mutable inner = current.bindings
  mutable index = 0
  node.block.parameters.each do |parameter|
    inner = [[parameter, block_parameter_type(receiver, index, node.name, arguments, parameter_count: node.block.parameters.length)]] + inner
    index += 1
  end
  walked = walked_block(node.block.body, current.with(bindings: inner), answers, names)
  outer = current.bindings.length
  walked.with(bindings: unnarrowed(current.bindings, walked.bindings.slice(walked.bindings.length - outer, outer)), calls: block_returns(walked.calls, current.calls.length))
end

# The pinned combinations' answers as bindings, each under the name its
# combination goes by. Beside them, what each yielding combination hands
# its block, under a key of its own: a call site needs that to read its
# block before the answer is settled, since the answer may wait on the
# block's.
def pinned_answers(pinned)
  answers = pinned.select { it.pinned? }.map { [it.key, it.answer] }
  yielding = pinned.reject { it.block.nil? }
  yielded = yielding.map { |found| [yields_key(found.name, found.arguments), found.block.parameters] }
  # Everything pinning reads, it reads the way the native build runs it
  # (#503): the name that says so rides with the answers into every scope,
  # and is kept last, which is where inference looks for it.
  answers + yielded + handed_arrays(pinned) + [[NATIVE_READING, BooleanType.new]]
end

# A yielding combination's block, or nil for a def that does not yield.
# What the block answers is the combination's own. What it is handed is
# read off the def's yields, which must agree, as a def's ways out must.
# Unless strict, a type not known is passed over, to be read again once
# more is pinned.
def pinned_block(definition, parameters, handed, leaves, answers, names, strict)
  return nil unless yields?(definition.body)
  mutable reason = nil
  reason = "it yields, and one call hands it no block" if handed.nil?
  answer = handed or UnknownType.new
  walked = pin_statements(definition.body, PinWalk.new(bindings: parameters, calls: []), yield_bindings(answer, leaves) + answers, names)
  yields = walked.calls.select { it[0] == YIELD }.map { type_at(it, 1) }
  counts = unique_types(yields.map { it.length })
  reason = (reason or "it yields #{counts[0]} at one place and #{counts[1]} at another") if counts.length > 1
  mutable types = []
  mutable index = 0
  while index < (counts.first or 0)
    given = unique_types(yields.map { |yielded| (type_at(yielded, index) or UnknownType.new) })
    seen = strict ? given : given.select { concrete?(it) }
    reason = (reason or "it yields a value whose type is not known") if strict && !given.all? { concrete?(it) }
    reason = (reason or "it yields #{with_article(seen[0])} at one place and #{with_article(seen[1])} at another") if seen.length > 1
    types << (seen.length == 1 ? seen[0] : UnknownType.new)
    index += 1
  end
  PinnedBlock.new(parameters: types, answer: answer, reason: reason, leaves: leaves)
end

# Whether an argument is an empty array, or one handed by name (#591).
def pinned_empty?(argument) = argument == EMPTY_ARRAY || ((argument in KeywordType) && argument.type == EMPTY_ARRAY)

# The combinations a program can reach (#572): the ones its top level
# calls, read with each local at the one type it holds, and the ones
# those call in turn. The rest were named only by a first reading of
# some body, and are left unbuilt.
def reached_combinations(pinned, statements, answers, names)
  mutable waiting = settled_calls(statements, [], answers, names).map { call_key(it) }.uniq
  mutable reached = []
  while !waiting.empty?
    key = waiting.first or ""
    waiting = waiting.slice(1, waiting.length - 1)
    next if reached.include?(key)
    found = pinned.find { it.key == key }
    next if found.nil?
    reached << key
    inside = settled_calls(found.definition.body, found.parameters, yielding_answers(answers, found.block), names)
    waiting += inside.map { call_key(it) }.reject { reached.include?(it) }
  end
  pinned.select { reached.include?(it.key) }
end

# Whether a combination's body would be read as it was (#537): the same
# parameters and the same block, which are all of a combination that a
# walk of its body binds. Its def is the same by its key.
def read_alike?(before, after) = before.parameters == after.parameters && before.block == after.block

# Whether a name is read anywhere inside a body.
def reads_name?(body, name)
  body.any? { ((it in IdentifierNode) && it.name == name) || reads_name?(children_of(it), name) }
end

def rebound(bindings, name, type)
  found = bindings.assoc(name)
  return [[name, type]] + bindings if found.nil?
  # What was proved of the name was proved of what it held (#572), and
  # goes when the name is bound again.
  if (type_at(found, 1) in MaybeType(inner: StructType)) && bindings.assoc(proved_key(name)).some?
    return rebound(bindings.reject { it[0] == proved_key(name) }, name, type)
  end
  return bindings if type_at(found, 1) == type
  return bindings if type == EMPTY_ARRAY && (type_at(found, 1) in ArrayType)
  return bindings.map { it[0] == name ? [name, type] : it } if type_at(found, 1) == EMPTY_ARRAY && (type in ArrayType)
  # A name that holds nil at one binding and a value at another holds a
  # maybe of that value (#505), whichever came first, and one that holds
  # one struct and then another holds one of several (#572).
  held = type_at(found, 1)
  # A value whose type is not known is not another type: the name keeps
  # the one it has, and a later round reads the value once it is known
  # (#572). Unpinned here, the name would starve the call that makes it
  # known.
  return bindings if concrete?(held) && !concrete?(type)
  widened = joined_pair(held, type)
  return bindings if widened == held
  return bindings.map { it[0] == name ? [name, widened] : it } if widened.some?
  bindings.map { it[0] == name ? [name, UnknownType.new] : it }
end

# The dump's lines, one per def and then one per top-level binding.
def render_pinned(program)
  mutable lines = []
  program.defs.each do |pinned|
    rendered = pinned.parameters.map { "#{it[0]}: #{render_type(type_at(it, 1))}" }.join(", ")
    plain = pinned.parameters.empty? ? "def #{pinned.name}" : "def #{pinned.name}(#{rendered})"
    signature = pinned.block.nil? || !pinned.pinned? ? plain : "#{plain} #{render_pinned_block(pinned.block)}"
    if pinned.pinned?
      lines << "#{signature} # -> #{render_pinned_type(pinned.answer)}"
    else
      lines << "#{signature}: not pinned — #{pinned.reason}"
    end
  end
  program.bindings.each do |binding|
    lines << "#{binding[0]}: #{render_type(type_at(binding, 1))}"
  end
  lines
end

# A yielding def's block as the dump writes it: what it is handed between
# bars, and what it answers.
def render_pinned_block(block)
  answer = "-> #{render_pinned_type(block.answer)}#{block.leaves ? ", leaving" : ""}"
  return "{ #{answer} }" if block.parameters.empty?
  "{ |#{block.parameters.map { render_type(it) }.join(", ")}| #{answer} }"
end

# A pinned type as the dump and the refusals write it.
def render_pinned_type(type) = type == NOTHING ? "nothing" : render_type(type)

# What every `return` a walk passed answers, the ones inside blocks among
# them.
def returns_gathered(walk)
  walk.calls.select { it[0] == RETURN }.map { type_at(type_at(it, 1), 0) }
end

# What a round of pinning knows, as one line for each thing: every
# combination with what it answers, what it hands its block, or why it
# could not be pinned, and every field with its type. Two rounds that
# know the same are the same round, and these are what a refusal names
# where rounds do not agree (#545).
def round_entries(pinned, fields)
  combinations = pinned.map do |found|
    handed = found.block.nil? ? "" : " #{render_pinned_block(found.block)}"
    outcome = found.reason.nil? ? "-> #{render_pinned_type(found.answer)}" : "not pinned, #{found.reason}"
    "#{found.key}#{handed} #{outcome}"
  end
  combinations + fields.map { "#{it[0]}: #{render_pinned_type(type_at(it, 1))}" }
end

# The time between two readings of the clock, which counts in
# billionths of a second, as seconds to one place.
def seconds_between(earlier, later)
  tenths = (later - earlier) / 100000000
  "#{tenths / 10}.#{tenths % 10}s"
end

# Rounds of pinning until one changes nothing. Each round walks the top
# level and the body of every combination pinned so far, gathers the
# combinations those calls name, and pins them; a combination's body may
# name another, which the next round reaches.
def settle_pins(definitions, statements, names, fixed, starting, strict, progress)
  mutable pinned = starting.pinned
  mutable fields = starting.fields
  mutable known = round_entries(pinned, fields)
  # Every round so far, as what it knew: a round that knows what an
  # earlier one did, and is not the one before it, is a circle (#545).
  mutable seen = [known]
  mutable round = 0
  # What the round before read and knew, which a round reuses where the
  # names a def mentions have entries that did not change (#537). Reuse is
  # a shortcut and is never the last word: a round that reused anything
  # and found nothing new is followed by one that walks everything, and
  # only that one ends the pass. Should the two disagree, the shortcut is
  # dropped for the rest of the pass.
  mentions = definition_mentions(definitions)
  mutable moving_before = nil
  mutable read_before = []
  mutable reusing = true
  mutable checking = false
  while round <= ROUND_LIMIT
    began = progress.nil? ? 0 : System.monotonic_time
    moving = fields + pinned_answers(pinned)
    answers = fixed + moving
    changed = (reusing && !checking && moving_before.some?) ? changed_between(moving_before, moving) : nil
    gathered = gathered_round(statements, names, answers, pinned, changed, mentions, read_before)
    walk = gathered.walk
    settled = pin_combinations(definitions, walk.calls, answers, names, strict, changed, mentions, pinned, gathered.read)
    made = settled_fields(walk.calls)
    found = round_entries(settled, made)
    # Said while it works, where the build was asked to (#543): a round
    # that finds fewer new combinations each time is settling.
    if progress.some?
      fresh = settled.count { |combination| pinned.none? { it.key == combination.key } }
      most = definitions.max_by { |definition| settled.count { it.name == definition.name } }
      crowded = most.nil? ? "" : "; most: #{most.name} with #{settled.count { it.name == most.name }}"
      pass = strict ? "second pass" : "first pass"
      walked = changed.nil? ? "every body walked" : "#{gathered.again} bodies walked again"
      build_note(progress, "pinning, #{pass}, round #{round + 1}: #{settled.length} combinations, #{fresh} new, #{made.length} fields, #{walk.calls.length} calls read, #{walked}, in #{seconds_between(began, System.monotonic_time)}#{crowded}")
    end
    moving_before = moving
    read_before = gathered.read
    if found == known
      break if changed.nil?
      checking = true
      round += 1
      next
    end
    if checking
      # A round that walked everything found what the shortcut had not.
      reusing = false
      checking = false
      seen = []
    end
    if seen.include?(found)
      turning = (found.reject { known.include?(it) } + known.reject { found.include?(it) })
      shown = turning.slice(0, 6).join("; ")
      more = turning.length > 6 ? "; and #{turning.length - 6} more" : ""
      panic("the native build's types go round in a circle and do not settle (#545) — pinned one way in one round and another in the next: #{shown}#{more}")
    end
    busiest = definitions.find { |definition| settled.count { it.name == definition.name } > COMBINATION_LIMIT }
    if busiest.some?
      panic("the native build compiles a def once for each combination of types it is called with, and stopped at #{COMBINATION_LIMIT} — def #{busiest.name} on line #{busiest.line} is called with a new one each time it is called")
    end
    pinned = settled
    fields = made
    known = found
    seen << found
    round += 1
  end
  panic("the native build's types did not settle in #{ROUND_LIMIT} rounds") if round > ROUND_LIMIT
  Settled.new(pinned: pinned, fields: fields)
end

# A body's parameters, and each local a walk of the body bound, once, at
# the type beneath any proof a guard bound ahead of it.
def settled_bindings(parameters, bindings)
  mutable start = parameters
  mutable seen = parameters.map { it[0] }
  bindings.reverse.each do |binding|
    # A proof bound beside a name is no local, and holds only where it
    # was proved.
    next if seen.include?(binding[0]) || proved_key?(binding[0])
    seen << binding[0]
    start = [binding] + start if concrete?(type_at(binding, 1))
  end
  start
end

# The calls a body makes, read with each local at the one type it holds.
def settled_calls(body, parameters, answers, names)
  starting = settled_start(body, parameters, answers, names)
  pin_statements(body, PinWalk.new(bindings: starting, calls: []), answers, names).calls.select { names.include?(it[0]) }
end

# Each struct's fields as bindings (#532): a field is bound to the type
# its makings hand it, joined (#553). One handed types that do not join
# keeps the first, and is named by `field_conflicts`. It is not dropped: a field left out is
# forgotten by the next round, which may then find it made with one type
# again, and so round in a circle (#545). A round only adds to what the
# last one knew.
def settled_fields(calls)
  mutable bindings = []
  made_fields(calls).each do |made|
    types = unique_types(type_at(made, 1).select { concrete?(it) })
    bindings << [made[0], (joined_field(types) or types[0])] unless types.empty?
  end
  # And each struct the program makes, by a name of its own (#572): an
  # `in` test for one it never makes is never true.
  calls_of(calls_by_name(calls), MAKING).map { made_key(type_at(type_at(it, 1), 0)) }.uniq.each do |key|
    bindings << [key, BooleanType.new]
  end
  bindings
end

# The bindings a body is read with from its first statement (#572): its
# parameters, and each local at the one type it holds, which is what the
# whole body leaves it as. Lowering gives a local one type throughout, so
# a call written above the binding that widens a local is gathered with
# the type lowering hands it. A local whose type is not known is left to
# be bound where it is written, and one a guard proved more of is taken
# at the type beneath the proof.
def settled_start(body, parameters, answers, names)
  walked = pin_statements(body, PinWalk.new(bindings: parameters, calls: []), answers, names)
  settled_bindings(parameters, walked.bindings)
end

# A combination's answer with its parameters pinned. Read plainly first.
# Where that is unknown — the def calls itself, or one that calls it
# back — the answer is read from the ways out of its body that are known:
# for `fib`, the arm that answers `n`. The other combinations' answers so
# far are in `answers`, this one's own among them, so a pair that call
# each other settle over a few rounds. Strict, an answer found that way
# is held to the whole body, which must then answer it.
def solved_answer(definition, key, parameters, answers, names, strict)
  return NOTHING if answers_nothing?(definition.body, parameters, answers, names)
  others = answers.reject { it[0] == key }
  plain = body_answer(definition.body, parameters, others, names)
  return plain if concrete?(plain)
  # Every way out an empty array: said as it is, for the combination to
  # take the array the def's others answer (#572).
  return plain if plain == EMPTY_ARRAY
  known = unique_types(answer_candidates(definition.body, parameters, answers, names).select { concrete?(it) })
  # The ways out that are known answer one type, or types that join.
  found = joined_types(known) or return UnknownType.new
  return found unless strict
  whole = body_answer(definition.body, parameters, [[key, found]] + others, names)
  whole == found ? found : UnknownType.new
end

# The calls a body makes, read twice (#572): once with each local as it
# is bound going down the body, and once with each at the one type the
# body leaves it. The second is what lowering asks for. The first is
# kept beside it: a local bound to what a call answers, and handed back
# to that call, is read from the call the first walk names, and dropped,
# that call would be pinned in one round and gone in the next.
def twice_read_calls(body, parameters, answers, names)
  first = pin_statements(body, PinWalk.new(bindings: parameters, calls: []), answers, names)
  starting = settled_bindings(parameters, first.bindings)
  return first.calls if starting == parameters
  first.calls + pin_statements(body, PinWalk.new(bindings: starting, calls: []), answers, names).calls
end

# The methods of the core's types and of a program's structs as defs
# (#525, #532). In the core, `class Array` gives the builtin array its
# methods (ADR 0093); a program's struct has its own. Each method, and
# each of the traits the type includes, becomes a def named for the type
# and the method, taking `self` first, and is then pinned and compiled
# as any def is. A struct's method has the fields it reads bound ahead
# of its body.
def type_methods(nodes, core)
  library = core or []
  traits = (library + nodes).select { it in TraitDefNode }
  owners = library.select { (it in StructDefNode) && core_type_name?(it.name) } + nodes.select { it in StructDefNode }
  mutable definitions = []
  mutable shapes = []
  owners.each do |node|
    mutable methods = node.methods
    node.includes.each do |included|
      found = traits.find { it.name == included }
      next if found.nil?
      found.methods.each do |method|
        methods = methods + [method] unless methods.any? { it.name == method.name }
      end
    end
    methods.each do |method|
      receiver = IdentifierNode.new(kind: "identifier", name: "self", line: method.line)
      # A method of the struct called by its bare name, inside another, is
      # asked of `self` (#572).
      # A name the method binds itself, or takes, is that local: the
      # core's `find_index` counts with an `index` of its own beside the
      # method `index`.
      bound = assigned_names_in_body(method.body) + method.parameters.map { it.name }
      own = methods.map { it.name }.reject { bound.include?(it) }
      body = method.body.map { on_self(it, own) }
      definitions << method.with(name: method_def_name(node.name, method.name), parameters: [receiver] + method.parameters, body: field_prelude(node.fields, method) + body)
      shapes << [method_shape_key(node.name, method.name), parameters_shape(method.parameters, yields?(method.body))]
    end
  end
  CoreMethods.new(definitions: definitions, shapes: shapes)
end

# Whether nothing a combination's body read has changed (#537): it calls
# none of the combinations whose answers changed, is of no def one of
# them is of, since a def's answers are read together, and mentions none
# of the names every other changed entry goes by. `keys` is the
# combinations its body calls.
def unaffected?(name, keys, changed, mentions)
  found = mentions.assoc(name)
  return false if found.nil?
  return false if changed.owners.include?(name)
  return false unless keys.intersection(changed.keys).empty?
  mentioned = type_at(found, 1)
  mentioned.intersection(changed.names).empty?
end

def unique_types(types)
  mutable unique = []
  types.each do |type|
    unique << type unless unique.include?(type)
  end
  unique
end

def value_candidates(node, scope)
  plain = case_as_if(node)
  return value_candidates(plain, scope) if plain.some?
  # A `panic` is no way out with an answer (#572).
  return [] if (node in CallNode) && node.name == "panic"
  return [statement_answer(node, scope)] unless node in IfNode
  # Only the arm that runs answers (#572).
  settled = settled_arm(node, scope)
  if settled.some?
    ending = settled.last
    return ending.nil? ? [NilType.new] : value_candidates(ending, scope)
  end
  taken = node.then_body or []
  other = node.else_body or []
  first = taken.last
  second = other.last
  (first.nil? ? [NilType.new] : value_candidates(first, scope)) + (second.nil? ? [NilType.new] : value_candidates(second, scope))
end

# A block's body walked (#572), with each local the block binds at the
# one type the body leaves it: read once going down the body, and where
# that widened a local, again with what it left. The calls of both
# readings are kept, as a def's are.
def walked_block(body, start, answers, names)
  first = pin_statements(body, start, answers, names)
  settled = settled_bindings(start.bindings, first.bindings)
  return first if settled == start.bindings
  second = pin_statements(body, start.with(bindings: settled), answers, names)
  second.with(calls: first.calls + second.calls.slice(start.calls.length, second.calls.length - start.calls.length))
end

def with_article(type)
  rendered = render_type(type)
  determiner = %w[A E I O U].include?(rendered.slice(0, 1)) ? "an" : "a"
  "#{determiner} #{rendered}"
end

# What a def's body reads a `yield` by: what its block answers, and
# whether that block can leave.
def yield_bindings(answer, leaves)
  leaves ? [[YIELD, answer], [YIELD_LEAVES, BooleanType.new]] : [[YIELD, answer]]
end

# The answers a def's own body is read with: the program's, and what its
# block answers where it yields.
def yielding_answers(answers, block)
  return answers if block.nil?
  yield_bindings(block.answer, block.leaves) + answers
end
