# Run a Portland file on the Portland evaluator.
#
# Usage: pdx compiler/run.pdx [-I dir ...] <file.pdx> [arguments]
#
# The checker goes first (#9, ADR 0034): a program with a refusable line
# refuses before any line runs, whether or not that line would have — the
# whole program, every file its requires pull in (#94), each with the
# declarations of its requires in view. `-I dir` puts a directory at the
# front of the load path (ADR 0077).

require_relative "checker"
require_relative "evaluator"

flags = load_path_flags(System.arguments)
directories = flags[0]
rest = flags[1]
# `System.read_file` answers a failure (ADR 0027); a tool that cannot read
# its input has nothing to do but say so.
path = rest.first or panic "run.pdx: needs a file to run"
source = System.read_file(path) or panic "run.pdx: cannot read #{path}"
program = parse_program(lex(source))
load_path = default_load_path(path, directories)
# Run mode: a program about to run is a closed world, so the entry's own
# defs are read with what every caller passes (ADR 0049 §4).
check_program_closure(path, [], load_path)
# What follows the path is the guest's own: its `System.arguments`.
evaluate_program(program, path, rest.slice(1, rest.length - 1), load_path)
