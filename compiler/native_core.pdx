# The walks an array answers that the native build compiles from Portland
# source of its own (#567). The core writes a few of an array's methods
# in Portland (ADR 0093), and the native build compiles those as defs
# (#525); every other is the seed's own, in Rust, with nothing for a
# native build to compile. These are the ones the front end calls.
#
# Only a native build reads this. The seed and the hosted compiler go on
# answering these from the floor, so nothing they run is slower for it.
# Moving more of Array into the core is held (#491); when that ends,
# these belong there.

require_relative "parser"

NATIVE_CORE_SOURCE = <<~PORTLAND
  class Array
    def all?
      self.each do |element|
        return false unless yield(element)
      end
      true
    end

    def any?
      self.each do |element|
        return true if yield(element)
      end
      false
    end

    def count
      mutable counted = 0
      self.each do |element|
        counted += 1 if yield(element)
      end
      counted
    end

    def each_with_index
      mutable index = 0
      self.each do |element|
        yield(element, index)
        index += 1
      end
      self
    end

    def find_index
      mutable index = 0
      self.each do |element|
        return index if yield(element)
        index += 1
      end
      nil
    end

    def flat_map
      mutable gathered = []
      self.each do |element|
        gathered += yield(element)
      end
      gathered
    end

    def index(wanted)
      mutable place = 0
      self.each do |element|
        return place if element == wanted
        place += 1
      end
      nil
    end

    def intersection(others)
      mutable shared = []
      self.each do |element|
        shared << element if others.include?(element) && !shared.include?(element)
      end
      shared
    end

    def max_by
      mutable best = nil
      mutable best_key = nil
      self.each do |element|
        key = yield(element)
        if best_key.nil? || key > best_key
          best = element
          best_key = key
        end
      end
      best
    end

    def none?
      self.each do |element|
        return false if yield(element)
      end
      true
    end

    def reverse
      mutable turned = []
      mutable place = self.length - 1
      while place >= 0
        turned << self[place]
        place -= 1
      end
      turned
    end

    def sort_by
      mutable sorted = []
      mutable keys = []
      self.each do |element|
        key = yield(element)
        mutable place = sorted.length
        while place > 0 && keys[place - 1] > key
          place -= 1
        end
        sorted = sorted.slice(0, place) + [element] + sorted.drop(place)
        keys = keys.slice(0, place) + [key] + keys.drop(place)
      end
      sorted
    end

    def sum
      mutable total = 0
      self.each do |element|
        total += element
      end
      total
    end

    def uniq
      mutable kept = []
      self.each do |element|
        kept << element unless kept.include?(element)
      end
      kept
    end
  end
  PORTLAND

# The source above as the nodes a native build reads beside the core's.
def native_core_nodes = parse_program(lex(NATIVE_CORE_SOURCE))
