# Stage 1, act two: Portland running Portland.
#
# A library: require_relative "evaluator", then
# evaluate_program(parse_program(lex(source))).
#
# No mutable collections exist, so evaluation threads state the way the
# parser threads Step: every function returns an Outcome. The value field
# is a slot — [] for no value, [v] for a value — because statements may
# produce nothing and there is no nil. Bindings are an assoc array of
# [name, value] pairs. Guest values are host values, so arithmetic,
# equality, and puts formatting match the seed for free.
#
# To run a file, see run.pdx.

require_relative "parser"

# signal is "none", or an unwinding "break" / "next" / "return"
# (a return's value rides in the value slot). A return also carries the
# frame depth it unwinds to — the method its block was written in (ADR
# 0025) — in target; the other signals leave it nil.
struct Outcome
  value
  bindings
  signal
  target
end

def outcome(value, bindings)
  Outcome.new(value: value, bindings: bindings, signal: "none", target: nil)
end

def signal_outcome(signal, value, bindings)
  Outcome.new(value: value, bindings: bindings, signal: signal, target: nil)
end

# A `return` in flight: aimed at the frame it was written in.
def return_outcome(value, bindings, target)
  Outcome.new(value: value, bindings: bindings, signal: "return", target: target)
end

# The call depth of the frame these bindings belong to. Rides the bindings
# as `__frame__` — the `__block__` trick — so a block evaluating a `return`
# reads its *writer's* depth, because a block closes over its writer's
# bindings (ADR 0025 gets write-site returns from that for free).
def frame_of(bindings)
  slot = lookup(bindings, "__frame__")
  return 0 if slot.empty?
  value_at(slot.first, 2)
end

# Pull a slot's value raw. Host `first`/`[index]` lift a stored nil to
# some(nil) (ADR 0005), but the slot pattern wants the value as-is —
# `each` is the unwrapped path. An empty slot comes back nil (crude: the
# evaluator conflates "no value" with nil where the seed panics).
def slot_value(values)
  mutable result = nil
  values.each do |value|
    result = value
  end
  result
end

# Raw positional read for the same reason — used where a triple or pair
# may hold nil in a value position.
def value_at(list, target_index)
  mutable result = nil
  list.each_with_index do |element, index|
    result = element if index == target_index
  end
  result
end

# — evaluation —

def evaluate_program(nodes)
  # `require_relative` resolves against the file doing the requiring, so that
  # path has to be in scope from the first statement. `argv.first` is it: the
  # trio was handed the guest program's path, and run.pdx read the same value.
  run_body(nodes, [["__file__", "file", argv.first or "."]])
end

# Run statements until done or a signal starts unwinding.
def run_body(nodes, bindings)
  mutable result = outcome([], bindings)
  nodes.each do |node|
    result = evaluate_statement(node, result.bindings)
    break unless result.signal == "none"
  end
  result
end

# The payoff of #26: the evaluator dispatches on its own AST with the
# struct patterns it just learned to run — Portland matching on Portland.
def evaluate_statement(node, bindings)
  case node
  in BreakNode then signal_outcome("break", [], bindings)
  in NextNode then signal_outcome("next", [], bindings)
  in WhileNode then evaluate_while(node, bindings)
  in TogetherNode then evaluate_together(node, bindings)
  in AssignmentNode(name:, value:)
    step = evaluate_expression(value, bindings)
    # An or-guard diverted (`x = f() or return`): skip the binding, unwind.
    return step unless step.signal == "none"
    bound = slot_value(step.value)
    outcome([bound], assigned(name, bound, node.rebindable, step.bindings))
  in DefNode(name:, parameters:, body:)
    outcome([], [[name, "method", [parameters, body]]] + bindings)
  in ReturnNode(value:)
    return return_outcome([], bindings, frame_of(bindings)) if value.nil?
    step = evaluate_expression(value, bindings)
    return_outcome(step.value, step.bindings, frame_of(bindings))
  in StructDefNode then outcome([], register_in_namespace(node, home_of(bindings), bindings))
  in TraitDefNode then outcome([], register_in_namespace(node, home_of(bindings), bindings))
  # Membership and exhaustiveness are static (#9) and a payload-free case is
  # just a symbol — but the declared labels register, because the one check
  # a runtime can make needs them (ADR 0022, #45).
  in EnumDefNode then outcome([], register_enum(node, bindings))
  in ModuleDefNode then evaluate_module(node, bindings)
  else
    evaluate_expression(node, bindings)
  end
end

# `together do ... end` (ADR 0029): serial today, and the oracle the
# parallel build must match on everything promised. Task expressions run in
# line order; names bind at the join; nothing unwinds across it; no outer
# mutable moves inside a task.
def evaluate_together(node, mutable bindings)
  entry = bindings
  mutable joined = []
  node.lines.each do |line|
    if line in TaskLineNode
      before = bindings
      step = evaluate_expression(line.value, bindings)
      panic("a task cannot unwind across the join — bind a name and handle it after end") unless step.signal == "none"
      panic("task #{line.name} produced no value") if step.value.empty?
      refuse_task_rebinds(before, step.bindings)
      bindings = step.bindings
      joined << [line.name, slot_value(step.value)]
    else
      step = evaluate_statement(line, bindings)
      panic("nothing unwinds out of together — the join comes first") unless step.signal == "none"
      bindings = step.bindings
    end
  end
  # Plain-line locals die at the end, like any block's.
  bindings = flow_back(entry, entry, bindings)
  joined.each do |pair|
    bindings = assigned(pair[0], value_at(pair, 1), false, bindings)
  end
  outcome([], bindings)
end

# A task rebinding an outer mutable is refused (ADR 0029): walk the entries
# its evaluation added; a preexisting mutable among them is one that moved.
def refuse_task_rebinds(before, after)
  mutable index = after.length - before.length - 1
  while index >= 0
    triple = after[index]
    panic("a task cannot rebind an outer mutable — bind a name and combine after the join") if triple[1] == "mutable" && !lookup(before, triple[0]).empty?
    index -= 1
  end
end

def evaluate_while(node, mutable bindings)
  entry = bindings
  while true
    condition = evaluate_expression(node.condition, bindings)
    bindings = condition.bindings
    break unless condition.value.first
    body = run_body(node.body, bindings)
    # Loop iterations are fresh scopes for their own locals — the block rule
    # applied to `while` (ADR 0001). Names first bound in the body die here,
    # so the next iteration binds them fresh; rebindings of names that
    # existed before the body flow through, which is what flow_back keeps.
    # What it keeps is a fresh shadow per iteration, so the shadowed dead
    # triples are compacted away before the next pass (#62).
    bindings = flow_back(bindings, bindings, body.bindings)
    bindings = compacted_since(entry, bindings)
    break if body.signal == "break"
    return return_outcome(body.value, bindings, body.target) if body.signal == "return"
  end
  # A finished while is nil, always (ADR 0012).
  outcome([nil], bindings)
end

def evaluate_if(node, bindings)
  condition = evaluate_expression(node.condition, bindings)
  body = if slot_value(condition.value)
    node.then_body
  else
    node.else_body
  end
  # A branch that doesn't happen produces nil (ADR 0012).
  return outcome([nil], condition.bindings) if body.nil?
  run_body(body, condition.bindings)
end

def evaluate_case(node, mutable bindings)
  subject = evaluate_expression(node.subject, bindings)
  bindings = subject.bindings
  mutable branch_index = 0
  while branch_index < node.branches.length
    branch = node.branches[branch_index]
    mutable value_index = 0
    while value_index < branch.values.length
      candidate = evaluate_expression(branch.values[value_index], bindings)
      bindings = candidate.bindings
      return run_body(branch.body, bindings) if candidate.value.first == subject.value.first
      value_index += 1
    end
    branch_index += 1
  end
  return outcome([], bindings) if node.else_body.nil?
  run_body(node.else_body, bindings)
end

def evaluate_case_in(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  mutable branch_index = 0
  while branch_index < node.branches.length
    branch = node.branches[branch_index]
    captures = match_pattern(branch.pattern, subject, bindings)
    unless captures.nil?
      # Captures bind before the guard runs, and persist (Ruby's rule) —
      # but into a trial scope, so a failed guard discards them: the branch
      # never happened, and the next branch may bind the same names fresh.
      # The bind itself enforces no-shadow (#45), the seed's rule.
      mutable trial = bindings
      captures.each do |capture|
        trial = assigned(capture[0], value_at(capture, 1), false, trial)
      end
      mutable guard_ok = true
      unless branch.guard.nil?
        guard_step = evaluate_expression(branch.guard, trial)
        trial = guard_step.bindings
        guard_ok = slot_value(guard_step.value)
      end
      return run_body(branch.body, trial) if guard_ok
    end
    branch_index += 1
  end
  if node.else_body.nil?
    panic("no pattern matched — add an in branch or an else")
  end
  run_body(node.else_body, bindings)
end

def evaluate_match_assert(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  captures = match_pattern(node.pattern, subject, bindings)
  panic("pattern mismatch — the => form panics when it can't destructure") if captures.nil?
  captures.each do |capture|
    bindings = assigned(capture[0], value_at(capture, 1), false, bindings)
  end
  outcome([nil], bindings)
end

def evaluate_match_test(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  captures = match_pattern(node.pattern, subject, bindings)
  return outcome([false], bindings) if captures.nil?
  captures.each do |capture|
    bindings = assigned(capture[0], value_at(capture, 1), false, bindings)
  end
  outcome([true], bindings)
end

# Bind or rebind a name, enforcing ADR 0001 (#45): `mutable` declares a new
# rebindable name exactly once; a bare assignment creates an immutable
# binding or rebinds an existing mutable one. Captures take the same rules.
# Every wording is the seed's.
def assigned(name, value, rebindable, bindings)
  slot = lookup(bindings, name)
  kind = if slot.empty?
    "unbound"
  else
    slot.first[1]
  end
  panic("local #{name} shadows method #{name} — rename one") if kind == "method" || builtin_method?(name)
  if rebindable
    panic("#{name} is already declared — mutable declares a new name once") if kind == "local" || kind == "mutable"
    return [[name, "mutable", value]] + bindings
  end
  panic("#{name} is immutable — declare it `mutable #{name} = ...` if it needs to change") if kind == "local"
  return [[name, "mutable", value]] + bindings if kind == "mutable"
  [[name, "local", value]] + bindings
end

# The seed's builtin_name: names a local may never take.
def builtin_method?(name)
  %w[argv failure inspect p panic puts read_file require_relative some write_file].include?(name)
end

# Try a pattern against a value: an array of [name, value] captures on a
# match (empty for literals), nil on a miss.
def match_pattern(pattern, mutable subject, bindings)
  # A failure is transparent to patterns (ADR 0027): its whole use is
  # carrying the reason to a handler whose tool is the pattern.
  while subject.failure?
    subject = failure_payload(subject)
  end
  case pattern
  in AlternativePatternNode then match_alternative(pattern, subject, bindings)
  in ArrayPatternNode then match_array(pattern, subject, bindings)
  in IdentifierNode(name:) then [[name, subject]]
  in PinNode then match_pin(pattern, subject, bindings)
  in RangeNode then match_range(pattern, subject, bindings)
  in StructPatternNode then match_struct(pattern, subject, bindings)
  in EnumCasePatternNode then match_enum_case(pattern, subject, bindings)
  else
    match_literal(pattern, subject, bindings)
  end
end

# `in :paid(on:)` — the case name must match, then each label binds or
# matches deeper (ADR 0022 §1).
def match_enum_case(pattern, subject, bindings)
  return nil unless subject in ["__enum_case__", *]
  return nil unless value_at(subject, 1) == pattern.name

  payload = value_at(subject, 2)
  mutable captures = []
  mutable index = 0
  while index < pattern.payload.length
    entry = pattern.payload[index]
    value = enum_payload_value(payload, entry[0])
    return nil if value.nil?

    sub_captures = match_pattern(entry[1], value, bindings)
    return nil if sub_captures.nil?

    sub_captures.each do |capture|
      captures << capture
    end
    index += 1
  end
  captures
end

def enum_payload_value(payload, label)
  mutable found = nil
  payload.each do |entry|
    found = entry[1] if entry[0] == label
  end
  found
end

def match_literal(pattern, subject, bindings)
  value_step = evaluate_expression(pattern, bindings)
  return [] if slot_value(value_step.value) == subject
  nil
end

# A range pattern tests membership, not equality (ADR 0019 §1). Integer
# subjects only — anything else misses, the seed's rule (#40). Guest ranges
# are host ranges, so `include?` answers without walking.
def match_range(pattern, subject, bindings)
  return nil unless subject in Integer
  range_step = evaluate_expression(pattern, bindings)
  return [] if slot_value(range_step.value).include?(subject)
  nil
end

def match_pin(pattern, subject, bindings)
  slot = lookup(bindings, pattern.name)
  panic("undefined variable #{pattern.name} in a ^ pin") if slot.empty?
  return [] if value_at(slot.first, 2) == subject
  nil
end

def match_alternative(pattern, subject, bindings)
  mutable index = 0
  while index < pattern.options.length
    captures = match_pattern(pattern.options[index], subject, bindings)
    return captures unless captures.nil?
    index += 1
  end
  nil
end

def match_array(pattern, subject, bindings)
  # A wrong-shaped subject misses rather than crashing — the seed's rule.
  # This used to be a recorded crude gap, from before the tagged-shape
  # predicates existed.
  return nil unless plain_array?(subject)
  return nil if pattern.splat == false && subject.length != pattern.elements.length
  return nil if subject.length < pattern.elements.length
  mutable captures = []
  mutable index = 0
  while index < pattern.elements.length
    element_captures = match_pattern(pattern.elements[index], value_at(subject, index), bindings)
    return nil if element_captures.nil?
    captures += element_captures
    index += 1
  end
  if pattern.splat && pattern.rest_name.some?
    rest = subject.slice(pattern.elements.length, subject.length - pattern.elements.length)
    captures << [pattern.rest_name, rest]
  end
  captures
end

# Builtin type patterns bootstrap on the seed's own (#27): the trio asks
# the host `subject in Integer` to answer the guest's `in Integer`.
def match_builtin_type(pattern, subject)
  matched = case pattern.name
  when "Boolean" then subject in Boolean
  when "Hash" then subject in Hash
  when "Integer" then subject in Integer
  when "String" then subject in String
  when "Array"
    # Guest struct instances are tagged host arrays — exclude them.
    (subject in Array) && !(subject in ["__struct__", *])
  else
    false
  end
  return [] if matched
  nil
end

def match_struct(pattern, subject, bindings)
  if %w[Array Boolean Hash Integer String].include?(pattern.name)
    return match_builtin_type(pattern, subject)
  end
  # A wrong-shaped subject misses rather than crashing — the seed's rule.
  return nil unless subject in ["__struct__", *]
  return nil unless value_at(subject, 1) == pattern.name
  mutable captures = []
  mutable index = 0
  while index < pattern.fields.length
    field = pattern.fields[index]
    value = struct_field(subject, field[0])
    sub_captures = match_pattern(field[1], value, bindings)
    return nil if sub_captures.nil?
    captures += sub_captures
    index += 1
  end
  captures
end

# Every rebinding is a prepend (the shadow-stack rule), so a loop that
# rebinds a name leaves the previous iteration's triple behind it, dead: the
# newer one in front is all lookup can ever reach. Dropping those dead
# triples at each iteration boundary caps the ledger at the loop's steady
# state instead of growing it by every iteration, which is what made hosted
# loops quadratic (#62).
#
# Only the region added since `entry` is deduplicated — first (newest) triple
# per name kept, in place. Everything at or below the entry is untouched
# shared suffix, which is what keeps the added-entries arithmetic elsewhere
# exact: flow_back and refuse_task_rebinds mark scopes that always sit at or
# below the loop's entry, so the entries they walk are dropped by no one.
def compacted_since(entry, bindings)
  added_count = bindings.length - entry.length
  return bindings if added_count < 2
  mutable kept = []
  mutable index = 0
  while index < added_count
    triple = bindings[index]
    kept << triple if lookup(kept, triple[0]).empty?
    index += 1
  end
  return bindings if kept.length == added_count
  kept + bindings.slice(added_count, bindings.length - added_count)
end

# Bindings are [name, kind, payload] triples — kind is "local" or "method".
# The no-shadow rule means one namespace serves both. First match wins,
# so prepending a triple is both set and shadow.
def lookup(bindings, name)
  mutable index = 0
  while index < bindings.length
    triple = bindings[index]
    return [triple] if triple[0] == name
    index += 1
  end
  []
end

# — namespaces (ADR 0021) —
#
# Namespaces are flattened to qualified names at definition time, exactly
# as the seed does; `__home__` carries the namespace a method was written
# in so its bare names resolve outward.

def home_of(bindings)
  slot = lookup(bindings, "__home__")
  return "" if slot.empty?
  value_at(slot.first, 2)
end

def qualify(home, name)
  return name if home.empty?
  "#{home}::#{name}"
end

# Drop the last `::` segment of a path.
def enclosing(home)
  parts = home.split("::")
  return "" if parts.length <= 1
  kept = parts.slice(0, parts.length - 1)
  kept.join("::")
end

# Resolve a name outward: own namespace first, then each enclosing level,
# then the top. Lexical scope always includes every enclosing level,
# however the namespace was declared.
def resolve(bindings, name)
  mutable home = home_of(bindings)
  while true
    slot = lookup(bindings, qualify(home, name))
    return slot unless slot.empty?
    break if home.empty?
    home = enclosing(home)
  end
  []
end

# Does any binding live under this name? Tells `Statistics.mean(x)` from
# an ordinary receiver.
def namespace?(bindings, name)
  prefix = "#{name}::"
  mutable index = 0
  while index < bindings.length
    return true if bindings[index][0].start_with?(prefix)
    index += 1
  end
  false
end

# The namespace a receiver names, resolved outward, or nil.
def namespace_for(bindings, name)
  mutable home = home_of(bindings)
  while true
    candidate = qualify(home, name)
    return candidate if namespace?(bindings, candidate)
    break if home.empty?
    home = enclosing(home)
  end
  nil
end

def evaluate_module(node, mutable bindings)
  outer = home_of(bindings)
  home = qualify(outer, node.path.join("::"))
  node.body.each do |statement|
    bindings = register_in_namespace(statement, home, bindings)
  end
  outcome([], bindings)
end

# Register one declaration under a namespace, recursing for nesting.
def register_in_namespace(statement, home, mutable bindings)
  case statement
  in DefNode(name:, parameters:, body:)
    [[qualify(home, name), "method", [parameters, body, home]]] + bindings
  in StructDefNode(name:, fields:, includes:, methods:, nested:, type_functions:)
    inner_home = qualify(home, name)
    # Included traits merge here, at registration (ADR 0028), so dispatch
    # needs no new rungs and every collision refuses naming both owners.
    merged = merged_methods(name, fields, includes, methods, home, bindings)
    mutable result = [[inner_home, "struct", [fields, merged]]] + bindings
    # Type functions (ADR 0031) register as ordinary methods under the
    # struct's namespace — `Token::of` — so the namespace rung dispatches
    # them with no new machinery. Their home is the struct itself: bare
    # names inside resolve outward from it, sibling type functions included.
    type_functions.each do |function|
      result = [["#{inner_home}::#{function.name}", "method", [function.parameters, function.body, inner_home]]] + result
    end
    nested.each do |inner|
      result = register_in_namespace(inner, inner_home, result)
    end
    result
  # A trait waits under its qualified name to be included (ADR 0028).
  in TraitDefNode(name:, methods:)
    [[qualify(home, name), "trait", methods]] + bindings
  in ModuleDefNode(path:, body:)
    inner_home = qualify(home, path.join("::"))
    mutable result = bindings
    body.each do |inner|
      result = register_in_namespace(inner, inner_home, result)
    end
    result
  in AssignmentNode(name:, value:)
    step = evaluate_expression(value, bindings)
    # "constant" rather than "local" so it survives a fresh method scope.
    [[qualify(home, name), "constant", slot_value(step.value)]] + step.bindings
  # Nested or module-housed enums register their cases unqualified — the
  # seed looks a case up across every declaration, since a bare `:paid`
  # says nothing about which vocabulary it came from.
  in EnumDefNode then register_enum(statement, bindings)
  else
    bindings
  end
end

# Included traits merge at struct registration (ADR 0028): the seed's rule
# and the seed's wordings — every collision a refusal naming both owners,
# never Ruby's silent last-include-wins.
def merged_methods(struct_name, fields, includes, methods, home, bindings)
  mutable merged = methods
  mutable origins = []
  includes.each do |written|
    slot = resolve_from(bindings, home, written)
    trait_methods = trait_methods_of(written, slot, bindings)
    trait_methods.each do |method|
      panic("#{method.name} is a field of #{struct_name} and a method of #{written} — a name is a field or a method, never both") if fields.include?(method.name)
      origins.each do |origin|
        panic("#{method.name} is declared by both #{origin[0]} and #{written} — #{struct_name} must not include both, or one renames") if value_at(origin, 1) == method.name
      end
      methods.each do |own|
        panic("#{struct_name} defines #{method.name} and includes it from #{written} — one of them renames") if own.name == method.name
      end
      origins << [written, method.name]
      merged += [method]
    end
  end
  merged
end

# The trait's method list, or the seed's refusal for whatever `written`
# turned out to be instead.
def trait_methods_of(written, slot, bindings)
  unless slot.empty?
    kind = slot.first[1]
    return value_at(slot.first, 2) if kind == "trait"
    panic("#{written} is a struct, not a trait — a struct is a value; hold one in a field") if kind == "struct"
  end
  panic("#{written} is a namespace, not a trait — namespaces are never injected; write #{written}.method(...)") if namespace?(bindings, written)
  panic("undefined trait #{written}")
end

# Resolve outward from an explicit home — registration runs before any
# `__home__` binding reflects the namespace being defined.
def resolve_from(bindings, mutable home, name)
  while true
    slot = lookup(bindings, qualify(home, name))
    return slot unless slot.empty?
    break if home.empty?
    home = enclosing(home)
  end
  []
end

# ADR 0022's one runtime check needs the declarations at hand, so every enum
# adds its cases to the `__enums__` registry riding in the bindings — the
# `__loaded__` trick again. Every declaration is kept, not just the first,
# because two enums may declare one case name and must then agree (#45).
def register_enum(node, bindings)
  slot = lookup(bindings, "__enums__")
  known = if slot.empty?
    []
  else
    value_at(slot.first, 2)
  end
  mutable cases = known
  node.cases.each do |declared|
    cases += [[declared.name, declared.labels]]
  end
  [["__enums__", "enums", cases]] + bindings
end

# The one enum check a *runtime* can make (ADR 0022): a payload names the
# labels its case declared, in declaration order. Membership and
# exhaustiveness stay static (#9) — this one is answerable because the value
# carries its own case name.
def check_payload_labels(node, bindings)
  slot = lookup(bindings, "__enums__")
  known = if slot.empty?
    []
  else
    value_at(slot.first, 2)
  end
  declarations = known.select { it[0] == node.name }
  panic("no enum declares a case :#{node.name}") if declarations.empty?
  labels = value_at(declarations.first, 1)
  declarations.each do |declaration|
    panic("two enums declare :#{node.name} with different payloads — the seed cannot tell them apart") unless value_at(declaration, 1) == labels
  end
  given = node.payload.map { it.label }
  return if given == labels
  wanted = labels.map { it + ":" }.join(", ")
  panic("`:#{node.name}` takes (#{wanted})")
end

def evaluate_expression(node, bindings)
  case node
  in AppendNode then evaluate_append(node, bindings)
  in ArrayNode then evaluate_array(node, bindings)
  in BinaryNode then evaluate_binary(node, bindings)
  in BooleanNode(value:) then outcome([value == "true"], bindings)
  in CallNode then evaluate_call(node, bindings)
  in YieldNode then evaluate_yield(bindings)
  in CaseInNode then evaluate_case_in(node, bindings)
  in CaseNode then evaluate_case(node, bindings)
  in HashNode then evaluate_hash(node, bindings)
  in IfNode then evaluate_if(node, bindings)
  in IndexNode then evaluate_index(node, bindings)
  in IndexUpdateNode then evaluate_index_update(node, bindings)
  in IntegerNode(value:) then outcome([value.to_i], bindings)
  in FloatNode(value:) then outcome([value.to_f], bindings)
  in RangeNode then evaluate_range(node, bindings)
  in LogicalNode then evaluate_logical(node, bindings)
  in MatchAssertNode then evaluate_match_assert(node, bindings)
  in MatchTestNode then evaluate_match_test(node, bindings)
  in MethodCallNode | SafeMethodCallNode then evaluate_method_call(node, bindings)
  in NilNode then outcome([nil], bindings)
  in PropagateNode then evaluate_propagate(node, bindings)
  in SelfNode then evaluate_self(bindings)
  in StringNode(value:) then outcome([value], bindings)
  # Guest symbols are tagged arrays, like guest structs — the trio cannot
  # manufacture a host symbol, because ADR 0023 removed `to_sym` and there
  # is deliberately no way to build one from a name at runtime. That is the
  # decision working as intended, felt by its own compiler.
  in SymbolNode(value:) then outcome([["__symbol__", value]], bindings)
  in EnumCaseNode then evaluate_enum_case(node, bindings)
  in UnaryNode then evaluate_unary(node, bindings)
  in WordArrayNode(text:) then outcome([word_array_elements(text)], bindings)
  in IdentifierNode(name:)
    mutable slot = lookup(bindings, name)
    slot = resolve(bindings, name) if slot.empty?
    if slot.empty? || slot.first[1] == "method"
      evaluate_call(call_node(name, []), bindings)
    else
      outcome([value_at(slot.first, 2)], bindings)
    end
  # A parse error reaches the evaluator as a node carrying its message.
  # Surfacing it here — where nested errors land too, since an ErrorNode
  # can be an argument — means every parser diagnostic, present and
  # future, stops the program instead of evaluating around the hole.
  in ErrorNode(message:) then panic(message)
  in PathNode(parts:)
    joined = parts.join("::")
    slot = lookup(bindings, joined)
    if slot.empty?
      puts "evaluator: undefined name #{joined}"
      outcome([], bindings)
    else
      outcome([value_at(slot.first, 2)], bindings)
    end
  else
    puts "evaluator: cannot evaluate #{node.kind} yet"
    outcome([], bindings)
  end
end

# Guest operands are host values, so host operators do the arithmetic and
# host strictness (type panics, divide by zero) is the guest error story.
def evaluate_binary(node, bindings)
  left_step = evaluate_expression(node.left, bindings)
  right_step = evaluate_expression(node.right, left_step.bindings)
  left = slot_value(left_step.value)
  right = slot_value(right_step.value)
  result = case node.operator
  when "+" then left + right
  when "-" then left - right
  when "*" then left * right
  when "/" then left / right
  when "%" then left % right
  when "==" then left == right
  when "!=" then left != right
  when "<" then left < right
  when "<=" then left <= right
  when ">" then left > right
  when ">=" then left >= right
  else
    puts "evaluator: unknown operator #{node.operator}"
    0
  end
  outcome([result], right_step.bindings)
end

# Typed or, mirrored from the seed (ADR 0007): nil unwraps-or-else and the
# right side may be an or-guard diverger (a statement node); booleans stay
# logical; a present wrapped value unwraps one layer via host `or`.
def evaluate_logical(node, bindings)
  left_step = evaluate_expression(node.left, bindings)
  left = slot_value(left_step.value)
  if node.operator == "&&"
    return outcome([false], left_step.bindings) unless left
    return evaluate_expression(node.right, left_step.bindings)
  end
  # A failure takes the fallback exactly as nil does (ADR 0027): failure is
  # absence with a reason, and `or` is its unwrap-or-else.
  return evaluate_statement(node.right, left_step.bindings) if left.nil? || left.failure?
  return outcome([true], left_step.bindings) if left == true
  return evaluate_expression(node.right, left_step.bindings) if left == false
  outcome([left or nil], left_step.bindings)
end

def evaluate_unary(node, bindings)
  step = evaluate_expression(node.operand, bindings)
  operand = slot_value(step.value)
  result = if node.operator == "!"
    !operand
  else
    0 - operand
  end
  outcome([result], step.bindings)
end

def evaluate_array(node, mutable bindings)
  mutable elements = []
  node.elements.each do |element|
    step = evaluate_expression(element, bindings)
    bindings = step.bindings
    elements += step.value
  end
  outcome([elements], bindings)
end

# Guest hashes are host hashes now: `[]=` (ADR 0015) is exactly the
# incremental construction Portland used to lack — the pair-list era ends.
def evaluate_hash(node, mutable bindings)
  mutable built = {}
  node.pairs.each do |pair|
    key_step = evaluate_expression(pair.key, bindings)
    bindings = key_step.bindings
    value_step = evaluate_expression(pair.value, bindings)
    bindings = value_step.bindings
    built[slot_value(key_step.value)] = slot_value(value_step.value)
  end
  outcome([built], bindings)
end

def evaluate_append(node, mutable bindings)
  slot = lookup(bindings, node.name)
  panic("undefined variable #{node.name}") if slot.empty?
  current = value_at(slot.first, 2)
  value_step = evaluate_expression(node.value, bindings)
  bindings = value_step.bindings
  value = slot_value(value_step.value)
  # Crude string-vs-array probe (no type predicates yet): an empty slice
  # of a string is "", of an array is [].
  appended = if current.slice(0, 0) == ""
    current + value
  else
    current + [value]
  end
  outcome([appended], bindings)
end

# Guest ranges are host ranges (ADR 0019): the evaluator builds them with
# the range syntax itself, so the seed's clamping and iteration come along
# for free. Either bound may be nil for the endless and beginless forms.
def build_range(start_value, finish_value, exclusive)
  if start_value.nil?
    return (...finish_value) if exclusive
    return (..finish_value)
  end
  if finish_value.nil?
    return (start_value...) if exclusive
    return (start_value..)
  end
  return start_value...finish_value if exclusive
  start_value..finish_value
end

def evaluate_range(node, mutable bindings)
  mutable start_value = nil
  if node.start.some?
    start_step = evaluate_expression(node.start, bindings)
    bindings = start_step.bindings
    start_value = slot_value(start_step.value)
  end
  mutable finish_value = nil
  if node.finish.some?
    finish_step = evaluate_expression(node.finish, bindings)
    bindings = finish_step.bindings
    finish_value = slot_value(finish_step.value)
  end
  outcome([build_range(start_value, finish_value, node.exclusive)], bindings)
end

# `name[index] = value` — a functional update rebound onto the name
# (ADR 0015): arrays replace in range or append at the end, hashes replace
# or add the pair. The array half used to fall into the hash rebuild and
# crash on the two-parameter block (#43).
def evaluate_index_update(node, mutable bindings)
  slot = lookup(bindings, node.name)
  panic("undefined variable #{node.name}") if slot.empty?
  current = value_at(slot.first, 2)
  index_step = evaluate_expression(node.index, bindings)
  bindings = index_step.bindings
  key = slot_value(index_step.value)
  value_step = evaluate_expression(node.value, bindings)
  bindings = value_step.bindings
  value = slot_value(value_step.value)
  if plain_array?(current)
    return outcome([updated_array(current, key, value, node.name)], bindings)
  end
  mutable rebuilt = {}
  current.each do |existing_key, existing_value|
    rebuilt[existing_key] = existing_value
  end
  rebuilt[key] = value
  outcome([rebuilt], bindings)
end

# A host array that is a guest array — not one of the tagged shapes standing
# in for values the trio cannot spell.
def plain_array?(value)
  return false unless value in Array
  return false if value in ["__struct__", *] | ["__symbol__", *] | ["__enum_case__", *]
  true
end

# — rendering (#39) —
#
# The seed prints tagged guest shapes raw — `{[__symbol__, name] => 1}` for
# any hash with symbol keys — because the host's Display cannot know what the
# tags stand for. These two walkers are the seed's Display and inspect,
# rewritten in Portland, so `puts`, `p`, `to_s`, `join`, and interpolation
# say exactly what the seed says. Anything untagged leans on the host, which
# is the seed itself.

# The shorthand-eligible names: identifier characters throughout, with ? or !
# allowed last. The seed asks Unicode's is_alphanumeric here and this asks an
# ASCII table, a divergence no literally-written symbol has met yet. The
# table sits inside the method because a method scope sees no top-level
# locals, and a top-level constant is one.
def identifier_shaped?(name)
  return false if name.empty?
  table = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
  characters = name.chars
  mutable index = 0
  while index < characters.length
    character = characters[index]
    suffix = index + 1 == characters.length && (character == "?" || character == "!")
    return false unless table.include?(character) || suffix
    index += 1
  end
  true
end

# How a symbol is written back out: `:paid`, or `:"odd key"` when the name
# is not identifier-shaped (ADR 0023).
def symbol_source(name)
  return ":" + name if identifier_shaped?(name)
  ":" + encode_string(name)
end

# The payload of a failure, pulled through the host's own pattern
# transparency (ADR 0027): a capture matches a failure as its payload, so
# the one-line `in` is the unwrapper — the same bootstrap trick as type
# patterns, with no privileged builtin.
def failure_payload(value)
  value in unwrapped
  unwrapped
end

# `!` — unwrap-or-propagate (ADR 0027): a failure returns from the
# enclosing method, aimed like a `return` at the frame the `!` was written
# in; anything else passes through untouched.
def evaluate_propagate(node, bindings)
  step = evaluate_expression(node.value, bindings)
  return step unless step.signal == "none"
  value = slot_value(step.value)
  return return_outcome([value], step.bindings, frame_of(step.bindings)) if value.failure?
  step
end

# The seed's Display: what `puts`, `to_s`, `join`, and interpolation show.
# Symbols shed the colon; structs, enum cases, maybes, and failures keep
# their inspect form, which is the seed's rule too.
def render(value)
  return "nil" if value.nil?
  return render_inspect(value) if value.failure?
  return value_at(value, 1) if value in ["__symbol__", *]
  return render_inspect(value) if value in ["__struct__", *] | ["__enum_case__", *]
  if plain_array?(value)
    rendered = value.map { render(it) }
    return "[" + rendered.join(", ") + "]"
  end
  if value in Hash
    mutable pairs = []
    value.each do |key, entry|
      pairs << "#{render(key)} => #{render(entry)}"
    end
    return "{" + pairs.join(", ") + "}"
  end
  "#{value}"
end

# The seed's inspect: what `p` shows — strings with their quotes, symbols
# with their colons, and hash pairs written the way they would be typed,
# shorthand for identifier-shaped symbol keys and the rocket for the rest.
def render_inspect(value)
  return "nil" if value.nil?
  return "failure(#{render_inspect(failure_payload(value))})" if value.failure?
  return symbol_source(value_at(value, 1)) if value in ["__symbol__", *]
  if value in ["__enum_case__", *]
    labels = value_at(value, 2).map { "#{it[0]}: #{render_inspect(value_at(it, 1))}" }
    return "#{symbol_source(value_at(value, 1))}(#{labels.join(", ")})"
  end
  if value in ["__struct__", *]
    fields = value_at(value, 2).map { "#{it[0]}: #{render_inspect(value_at(it, 1))}" }
    return "#{value_at(value, 1)}(#{fields.join(", ")})"
  end
  if plain_array?(value)
    rendered = value.map { render_inspect(it) }
    return "[" + rendered.join(", ") + "]"
  end
  if value in Hash
    mutable pairs = []
    value.each do |key, entry|
      pairs << rendered_pair(key, entry)
    end
    return "{" + pairs.join(", ") + "}"
  end
  return encode_string(value) if value in String
  "#{value}"
end

# `to_s`, rendering: nil keeps the host's refusal — absence has no methods,
# `to_s` included (ADR 0006) — and everything else takes the seed's Display.
def rendered_to_s(receiver)
  return receiver.to_s if receiver.nil?
  render(receiver)
end

# One hash pair, written the way it would be typed (ADR 0023 §1).
def rendered_pair(key, entry)
  if key in ["__symbol__", *]
    name = value_at(key, 1)
    return "#{name}: #{render_inspect(entry)}" if identifier_shaped?(name)
  end
  "#{render_inspect(key)} => #{render_inspect(entry)}"
end

# The seed's array rule: a negative index counts from the end, the position
# one past the end appends, and anything further out refuses — the original
# index in the message, not the normalized one.
def updated_array(current, index, value, name)
  position = if index < 0
    current.length + index
  else
    index
  end
  return current + [value] if position == current.length
  panic("index #{index} out of range for assignment to #{name}") if position < 0 || position > current.length
  mutable rebuilt = []
  mutable cursor = 0
  current.each do |element|
    rebuilt << if cursor == position
      value
    else
      element
    end
    cursor += 1
  end
  rebuilt
end

# The words of a `%w[...]` body — Ruby's rules (ADR 0030), matching the
# seed's `word_array_words`. A backslash before a bracket, a backslash, or
# whitespace drops away (escaped whitespace joins a word instead of
# splitting); before anything else it stays. Whitespace runs split once and
# never produce empties. The seed asks Unicode what whitespace is where this
# asks the three separators a Portland string can spell — carriage return
# has no escape here, on purpose — the recorded divergence class no
# literally-written program has met.
def word_array_elements(lexeme)
  content = lexeme.slice(3, lexeme.length - 4)
  characters = content.chars
  mutable words = []
  mutable current = ""
  mutable started = false
  mutable index = 0
  while index < characters.length
    character = characters[index]
    index += 1
    if character == "\\" && index < characters.length
      escaped = characters[index]
      index += 1
      unless escaped == "[" || escaped == "]" || escaped == "\\" || word_separator?(escaped)
        current << "\\"
      end
      current << escaped
      started = true
    elsif word_separator?(character)
      if started
        words << current
        current = ""
        started = false
      end
    else
      current << character
      started = true
    end
  end
  words << current if started
  words
end

def word_separator?(character)
  character == " " || character == "\t" || character == "\n"
end

def evaluate_index(node, bindings)
  receiver_step = evaluate_expression(node.receiver, bindings)
  index_step = evaluate_expression(node.index, receiver_step.bindings)
  receiver = slot_value(receiver_step.value)
  outcome([receiver[slot_value(index_step.value)]], index_step.bindings)
end

# Guest struct instances are tagged arrays: ["__struct__", name, pairs].
def evaluate_new(node, mutable bindings)
  # A struct name is bare (resolved outward) or a `::` path (absolute).
  written = if node.receiver in PathNode
    node.receiver.parts.join("::")
  else
    node.receiver.name
  end
  slot = if node.receiver in PathNode
    lookup(bindings, written)
  else
    resolve(bindings, written)
  end
  if slot.empty?
    puts "evaluator: undefined struct #{written}"
    return outcome([], bindings)
  end
  # A defined `new` replaces the raw constructor everywhere (ADR 0031):
  # while it runs, `fields(...)` is the raw layer, and only there — the
  # marker dies at every other call boundary.
  new_slot = lookup(bindings, "#{slot.first[0]}::new")
  if !new_slot.empty? && new_slot.first[1] == "method"
    mutable arguments = []
    mutable keyword_values = []
    node.arguments.each do |argument|
      if argument in KeywordArgumentNode
        step = evaluate_expression(argument.value, bindings)
        bindings = step.bindings
        keyword_values << [argument.label, slot_value(step.value)]
      else
        step = evaluate_expression(argument, bindings)
        bindings = step.bindings
        arguments += step.value
      end
    end
    return invoke_with_block(new_slot.first[2], arguments, keyword_values, nil, slot.first[0], bindings)
  end
  fields = value_at(slot.first[2], 0)
  mutable provided = []
  node.arguments.each do |argument|
    step = evaluate_expression(argument.value, bindings)
    bindings = step.bindings
    provided << [argument.label, slot_value(step.value)]
  end
  mutable ordered = []
  fields.each do |field|
    mutable index = 0
    while index < provided.length
      ordered << [field, value_at(provided[index], 1)] if provided[index][0] == field
      index += 1
    end
  end
  outcome([["__struct__", slot.first[0], ordered]], bindings)
end

# `:paid(on: "tuesday")` — a guest enum case, tagged like a guest struct.
def evaluate_enum_case(node, mutable bindings)
  check_payload_labels(node, bindings)
  mutable payload = []
  node.payload.each do |argument|
    step = evaluate_expression(argument.value, bindings)
    bindings = step.bindings
    payload << [argument.label, slot_value(step.value)]
  end
  outcome([["__enum_case__", node.name, payload]], bindings)
end

# `with` builds an updated copy of a guest struct (#27): the fields keep
# their order, replaced labels take the new value.
def struct_with(instance, keyword_values)
  mutable updated = []
  pairs = instance[2]
  mutable index = 0
  while index < pairs.length
    field = pairs[index][0]
    mutable value = value_at(pairs[index], 1)
    mutable replacement_index = 0
    while replacement_index < keyword_values.length
      value = value_at(keyword_values[replacement_index], 1) if keyword_values[replacement_index][0] == field
      replacement_index += 1
    end
    updated << [field, value]
    index += 1
  end
  ["__struct__", value_at(instance, 1), updated]
end

def struct_field(instance, field)
  pairs = instance[2]
  mutable index = 0
  while index < pairs.length
    return value_at(pairs[index], 1) if pairs[index][0] == field
    index += 1
  end
  puts "evaluator: no field #{field}"
  ""
end

def evaluate_self(bindings)
  slot = lookup(bindings, "__self__")
  panic("self only exists inside a struct method") if slot.empty?
  outcome([value_at(slot.first, 2)], bindings)
end

# The struct method `method_name` for a tagged-array instance, if any.
# The struct-shape test is a pattern — the trio's first type predicate.
def struct_method_for(receiver, method_name, bindings)
  return nil unless receiver in ["__struct__", *]
  slot = lookup(bindings, value_at(receiver, 1))
  return nil if slot.empty?
  methods = value_at(slot.first[2], 1)
  return nil if methods.nil?
  mutable found = nil
  methods.each do |method|
    found = method if method.name == method_name
  end
  found
end

# Run one struct method: globals + self + the receiver's fields, then
# parameters (#27).
def invoke_struct_method(receiver, method, arguments, keyword_values, bindings)
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  scope = [["__self__", "local", receiver]] + scope
  mutable pair_index = 0
  pairs = value_at(receiver, 2)
  while pair_index < pairs.length
    pair = pairs[pair_index]
    scope = [[pair[0], "local", value_at(pair, 1)]] + scope
    pair_index += 1
  end
  # This frame's depth, for `return` to aim at (ADR 0025).
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  scope = bind_parameters(method.parameters, arguments, keyword_values, scope)
  result = run_body(method.body, scope)
  panic("break outside of a loop") if result.signal == "break"
  panic("next outside of a loop") if result.signal == "next"
  if result.signal == "return" && result.target.some? && result.target < depth
    return return_outcome(result.value, bindings, result.target)
  end
  outcome(result.value, bindings)
end

# Guest receivers are host values, so host method dispatch does the work.
def evaluate_method_call(node, mutable bindings)
  if node.name == "new" && ((node.receiver in IdentifierNode) || (node.receiver in PathNode))
    return evaluate_new(node, bindings)
  end
  # `Token.of(...)` — a type function (ADR 0031): the receiver names a
  # struct, and the function lives under its namespace. A local wearing the
  # name wins first, as everywhere.
  if (node.receiver in IdentifierNode) || (node.receiver in PathNode)
    receiver_name = if node.receiver in PathNode
      node.receiver.parts.join("::")
    else
      node.receiver.name
    end
    struct_slot = if node.receiver in PathNode
      lookup(bindings, receiver_name)
    else
      resolve(bindings, receiver_name)
    end
    if !struct_slot.empty? && struct_slot.first[1] == "struct"
      function_slot = lookup(bindings, "#{struct_slot.first[0]}::#{node.name}")
      if !function_slot.empty? && function_slot.first[1] == "method"
        mutable arguments = []
        mutable keyword_values = []
        node.arguments.each do |argument|
          if argument in KeywordArgumentNode
            step = evaluate_expression(argument.value, bindings)
            bindings = step.bindings
            keyword_values << [argument.label, slot_value(step.value)]
          else
            step = evaluate_expression(argument, bindings)
            bindings = step.bindings
            arguments += step.value
          end
        end
        return invoke_with_block(function_slot.first[2], arguments, keyword_values, nil, nil, bindings)
      end
    end
  end
  # `Statistics.mean(x)` — the receiver names a namespace, so this invokes
  # a function inside it rather than dispatching on a value (ADR 0021).
  if (node.receiver in IdentifierNode) && lookup(bindings, node.receiver.name).empty?
    found = namespace_for(bindings, node.receiver.name)
    unless found.nil?
      return evaluate_call(call_node("#{found}::#{node.name}", node.arguments), bindings)
    end
  end
  if node.receiver in PathNode
    written = node.receiver.parts.join("::")
    if namespace?(bindings, written)
      return evaluate_call(call_node("#{written}::#{node.name}", node.arguments), bindings)
    end
  end
  step = evaluate_expression(node.receiver, bindings)
  receiver = slot_value(step.value)
  bindings = step.bindings
  # `&.`: an absent receiver short-circuits; arguments never run.
  if (node in SafeMethodCallNode) && receiver.nil?
    return outcome([nil], bindings)
  end
  mutable arguments = []
  mutable keyword_values = []
  node.arguments.each do |argument|
    if argument in KeywordArgumentNode
      argument_step = evaluate_expression(argument.value, bindings)
      bindings = argument_step.bindings
      keyword_values << [argument.label, slot_value(argument_step.value)]
    else
      argument_step = evaluate_expression(argument, bindings)
      bindings = argument_step.bindings
      arguments += argument_step.value
    end
  end
  return evaluate_block_call(node, receiver, arguments, bindings) if node.block.some?
  # `with` copies-and-updates before any dispatch, like the seed (#27).
  if node.name == "with" && (receiver in ["__struct__", *])
    return outcome([struct_with(receiver, keyword_values)], bindings)
  end
  # Struct methods dispatch before builtins and field access (#27).
  own = struct_method_for(receiver, node.name, bindings)
  return invoke_struct_method(receiver, own, arguments, keyword_values, bindings) unless own.nil?
  result = case node.name
  when "nil?" then receiver.nil?
  when "some?" then receiver.some?
  when "failure?" then receiver.failure?
  # `to_s` renders (#39); the nil refusal stays the host's, reached below
  # when a tagless receiver has no `to_s` of its own.
  when "to_s" then rendered_to_s(receiver)
  when "to_i" then receiver.to_i
  when "length" then receiver.length
  when "empty?" then receiver.empty?
  when "upcase" then receiver.upcase
  when "downcase" then receiver.downcase
  when "reverse" then receiver.reverse
  when "chars" then receiver.chars
  when "abs" then receiver.abs
  when "even?" then receiver.even?
  when "odd?" then receiver.odd?
  when "zero?" then receiver.zero?
  when "positive?" then receiver.positive?
  when "negative?" then receiver.negative?
  when "keys" then receiver.keys
  when "values" then receiver.values
  when "key?" then receiver.key?(arguments.first)
  when "first" then receiver.first
  when "last" then receiver.last
  when "sum" then receiver.sum
  when "sort" then receiver.sort
  when "min" then receiver.min
  when "max" then receiver.max
  when "to_a" then receiver.to_a
  when "to_f" then receiver.to_f
  # `join` shows each element the way `to_s` would (#39), the seed's rule.
  when "join"
    rendered = receiver.map { render(it) }
    rendered.join(arguments.first)
  when "include?" then receiver.include?(arguments.first)
  when "split" then receiver.split(arguments.first)
  when "start_with?" then receiver.start_with?(arguments.first)
  when "end_with?" then receiver.end_with?(arguments.first)
  when "slice" then receiver.slice(arguments[0], arguments[1])
  else
    # Anything else is a struct field read. On a non-struct that used to
    # index and fail with an unrelated message — `7.positive?` reported
    # "cannot index Integer(7) with Integer(2)" — which is how nine missing
    # methods stayed hidden. Say what actually happened instead.
    unless receiver in ["__struct__", *]
      panic("no method #{node.name} on this value — the trio may be missing a builtin the seed has")
    end
    struct_field(receiver, node.name)
  end
  outcome([result], bindings)
end

# What a block rebound flows back to the caller; what it named itself does
# not. ADR 0001 licenses the accumulator pattern, so `count += 1` inside a
# block has to outlive the block, while the block's parameters and its fresh
# locals have to die at end.
#
# The bindings list is prepend-only, so everything the block added sits in
# front of the scope it was handed — and the added entries worth keeping are
# exactly those whose name the caller already had. A new name is the block's
# own; a name already out there is a rebinding of it.
def flow_back(bindings, scope, block_bindings)
  mutable result = bindings
  # Newest first, so walk the added entries back to front: the last one
  # prepended ends up in front, where lookup finds it.
  mutable index = block_bindings.length - scope.length - 1
  while index >= 0
    triple = block_bindings[index]
    result = [triple] + result unless lookup(bindings, triple[0]).empty?
    index -= 1
  end
  result
end

# Blocks see the enclosing scope; parameters are prepended for the call.
#
# The bindings handed back are at the *caller's* level, already flowed back —
# so every call site can thread `result.bindings` on without knowing which of
# the names inside belonged to the block.
def run_guest_block(block, arguments, bindings)
  mutable scope = bindings
  mutable index = 0
  block.parameters.each do |parameter|
    if index < arguments.length
      # Named parameters shadow-and-restore, which is legal; a method's name
      # is not shadowable, and `it` colliding with a local is confusing
      # rather than merely shadowing (ADR 0017). The seed's wordings (#45).
      slot = lookup(scope, parameter)
      taken_by_method = (!slot.empty? && slot.first[1] == "method") || builtin_method?(parameter)
      panic("block parameter #{parameter} shadows method #{parameter} — rename one") if taken_by_method
      if parameter == "it" && !slot.empty? && (slot.first[1] == "local" || slot.first[1] == "mutable")
        panic("`it` is a local here and a block parameter there — rename one")
      end
      scope = [[parameter, "local", value_at(arguments, index)]] + scope
    end
    index += 1
  end
  result = run_body(block.body, scope)
  # `next` ends just this invocation of the block; `break` and `return` stay
  # for the iterating caller to handle — the seed's rule (#41, #42).
  signal = if result.signal == "next"
    "none"
  else
    result.signal
  end
  Outcome.new(value: result.value, bindings: flow_back(bindings, scope, result.bindings), signal: signal, target: result.target)
end

# After a block interrupted its iteration: a `break` is consumed here and the
# call produces nil (ADR 0012); a `return` keeps unwinding to the enclosing
# method (#41, #42). The seed's block_interrupt, in outcome clothing.
def block_interrupted(step, scope)
  return outcome([nil], scope) if step.signal == "break"
  return_outcome(step.value, scope, step.target)
end

# Every arm threads `scope` across its iterations, so what one pass of the
# block rebound is visible to the next and to the caller afterward — the
# accumulator pattern, which is why `scope` is rebound rather than `bindings`
# read repeatedly. The host block doing the rebinding is itself relying on
# the same rule one level down, in the seed.
# Every arm watches for a signal after each pass (#41, #42): a `break` or a
# `return` stops the host iteration right there — the host `break` below is
# doing for the trio what `block_interrupt` does for the seed — and
# `block_interrupted` decides what the interrupted call answers. The arm
# repetition is deliberate; the host `break` has to live inside each host
# block to stop it.
def evaluate_block_call(node, receiver, arguments, mutable scope)
  # Each pass's rebindings flow back as fresh shadows, so the pass boundary
  # compacts them the way a while iteration does (#62) — dead triples from
  # earlier passes drop, everything at or below this call's entry stays.
  entry = scope
  block = node.block
  mutable interrupt = nil
  case node.name
  when "each"
    if block.parameters.length == 2
      receiver.each do |first, second|
        step = run_guest_block(block, [first, second], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    else
      receiver.each do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "map"
    results = receiver.map do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      # A valueless pass — a bare `next`, a trailing `puts` — has nothing to
      # collect, and the seed refuses rather than inventing a nil.
      panic("map block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "select"
    results = receiver.select do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "reject"
    results = receiver.reject do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "times"
    receiver.times do |index|
      step = run_guest_block(block, [index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_with_index"
    receiver.each_with_index do |element, index|
      step = run_guest_block(block, [element, index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "reduce"
    results = receiver.reduce(arguments.first) do |running, element|
      step = run_guest_block(block, [running, element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("reduce block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "upto"
    receiver.upto(arguments.first) do |number|
      step = run_guest_block(block, [number], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "downto"
    receiver.downto(arguments.first) do |number|
      step = run_guest_block(block, [number], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  else
    puts "evaluator: cannot evaluate block method #{node.name} yet"
    outcome([], scope)
  end
end

# Find a label among the supplied keyword arguments, else evaluate the
# parameter's default in the method scope. Missing required labels are the
# crude error story.
def keyword_value_for(keyword_values, parameter, scope)
  mutable index = 0
  while index < keyword_values.length
    pair = keyword_values[index]
    return value_at(pair, 1) if pair[0] == parameter.name
    index += 1
  end
  if parameter.default.nil?
    puts "evaluator: missing keyword argument #{parameter.name}"
    return nil
  end
  default = evaluate_expression(parameter.default, scope)
  slot_value(default.value)
end

# Bind parameters onto a scope, left to right so defaults can reference
# earlier ones.
def bind_parameters(parameters, arguments, keyword_values, mutable scope)
  mutable index = 0
  parameters.each do |parameter|
    if parameter in KeywordParameterNode
      value = keyword_value_for(keyword_values, parameter, scope)
      scope = [[parameter.name, "local", value]] + scope
    else
      value = if index < arguments.length
        value_at(arguments, index)
      else
        default = evaluate_expression(parameter.value, scope)
        slot_value(default.value)
      end
      # A parameter is a binding site (ADR 0001): `def f(mutable position)`
      # binds a rebindable name, everything else an immutable one (#45).
      kind = if (parameter in AssignmentNode) && parameter.rebindable
        "mutable"
      else
        "local"
      end
      scope = [[parameter.name, kind, value]] + scope
      index += 1
    end
  end
  scope
end

# Run a user method: fresh scope of methods only (no outer locals). The
# caller's bindings come back untouched — callee scope is discarded.
def invoke(payload, arguments, keyword_values, bindings)
  invoke_with_block(payload, arguments, keyword_values, nil, nil, bindings)
end

def invoke_with_block(payload, arguments, keyword_values, block, fields_target, bindings)
  parameters = payload[0]
  body = payload[1]
  # Everything global survives into the fresh scope; only locals drop —
  # the rebindable kind included, since a mutable is a local that moves,
  # and the `__fields__` marker, since `fields` is legal only inside
  # `def self.new` itself (ADR 0031), never in anything it calls.
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  # Bare names in the body resolve from where the method was written, not
  # from where it was called (ADR 0021).
  home = value_at(payload, 2)
  scope = [["__home__", "home", home]] + scope unless home.nil?
  # A `yield` inside the body reaches this. The caller's bindings travel with
  # it, because a block closes over where it was *written*: the method's own
  # scope has dropped every local, so yielding into it would hide them.
  scope = [["__block__", "block", [block, bindings]]] + scope unless block.nil?
  # This frame's depth, for `return` to aim at (ADR 0025). The caller's
  # `__frame__` survives the local-reject above; prepending shadows it.
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  # While a defined `new` runs, `fields(...)` is its raw constructor
  # (ADR 0031); the marker rides the scope and dies at the next boundary.
  scope = [["__fields__", "fields", fields_target]] + scope unless fields_target.nil?
  scope = bind_parameters(parameters, arguments, keyword_values, scope)
  result = run_body(body, scope)
  # A `break` or `next` reaching a boundary escaped every loop that could
  # have owned it, and the seed refuses; so does this (#41, #42).
  panic("break outside of a loop") if result.signal == "break"
  panic("next outside of a loop") if result.signal == "next"
  # Callee locals are discarded, but a block the body yielded to may have
  # rebound names belonging to the caller, and those are the caller's.
  settled = if block.nil?
    bindings
  else
    scope_after_yield(result.bindings, bindings)
  end
  # A `return` is consumed here only when this frame is its write site (ADR
  # 0025); aimed further out, it keeps unwinding — through this method,
  # whose own result never happened.
  if result.signal == "return" && result.target.some? && result.target < depth
    return return_outcome(result.value, settled, result.target)
  end
  outcome(result.value, settled)
end

# `yield` — run the block the enclosing method was handed.
def evaluate_yield(bindings)
  slot = lookup(bindings, "__block__")
  panic("yield without a block — this method was called without one") if slot.empty?

  handed = slot.first[2]
  block = value_at(handed, 0)
  written_in = value_at(handed, 1)
  result = run_guest_block(block, [], written_in)
  # What the block rebound belongs to the caller, and a method body has no
  # channel to its caller — so the updated caller scope rides home inside
  # `__block__`, which `invoke_with_block` unpacks on the way out. Rebinding
  # it here also keeps it present, so a second `yield` still finds a block.
  #
  # The signal rides along too (#41), target included: a `return` in the
  # block stops the yielding method's body at this statement and keeps its
  # aim on the block's writer (ADR 0025).
  Outcome.new(value: result.value, bindings: [["__block__", "block", [block, result.bindings]]] + bindings, signal: result.signal, target: result.target)
end

# The caller's scope as it stands after the body ran, which is whatever the
# last `yield` parked in `__block__` — or the untouched original, when the
# body never yielded at all.
def scope_after_yield(body_bindings, bindings)
  slot = lookup(body_bindings, "__block__")
  return bindings if slot.empty?
  value_at(slot.first[2], 1)
end

# — require_relative (ADR-free; matching the seed's rule) —
#
# The path resolves against the directory of the file doing the requiring,
# `.pdx` is implied when the name carries no extension of its own, and a file
# loads only once: a second require answers false and runs nothing. The loaded
# set and the current file both ride in the bindings, the same trick already
# used for `__self__`, `__home__` and `__block__`.
#
# Two recorded divergences (principle 4 — a gap is written down, never silent):
# the seed canonicalises the resolved path before comparing, and the trio has
# no filesystem call that can, so the load-once key is the joined string. Two
# spellings of one file — `"helper"` and `"./helper"` — therefore load twice
# here and once there. And a missing file reports the host's read error rather
# than the seed's `require_relative "x": No such file or directory`.

def file_of(bindings)
  slot = lookup(bindings, "__file__")
  return "." if slot.empty?
  value_at(slot.first, 2)
end

# The directory holding a path, or "." when the path names none.
def directory_of(path)
  parts = path.split("/")
  return "." if parts.length < 2
  parts[0..-2].join("/")
end

# A dot in the last segment means the name brought its own extension, which is
# what the seed's `Path::extension` is asking too — a dot in an earlier segment
# does not count, so `a.b/c` still becomes `a.b/c.pdx`.
def required_path(bindings, name)
  target = "#{directory_of(file_of(bindings))}/#{name}"
  parts = target.split("/")
  return target if parts.last.include?(".")
  "#{target}.pdx"
end

def loaded_paths(bindings)
  slot = lookup(bindings, "__loaded__")
  return [] if slot.empty?
  value_at(slot.first, 2)
end

def evaluate_require(name, bindings)
  target = required_path(bindings, name)
  return outcome([false], bindings) if loaded_paths(bindings).include?(target)

  # Marked loaded before the file runs, not after, so a file that requires
  # itself answers false the second time instead of recursing until the stack
  # gives out. The seed inserts before running for the same reason.
  loaded = [["__loaded__", "loaded", loaded_paths(bindings) + [target]]]
  scope = [["__file__", "file", target]] + loaded + bindings
  # `read_file` answers a failure now (ADR 0027), which lets this refusal
  # finally wear the seed's wording — one recorded divergence retired. The
  # message names the *requested* path, as the seed's does.
  source = read_file(target) or panic "require_relative #{inspect(name)}: No such file or directory (os error 2)"
  result = run_body(parse_program(lex(source)), scope)
  # Everything the file defined stays in scope — that is the point of a require,
  # and the opposite of a method call. Only `__file__` is put back, so the rest
  # of the requiring file resolves its own relative paths, not the required
  # file's.
  outcome([true], [["__file__", "file", file_of(bindings)]] + result.bindings)
end

def evaluate_call(node, mutable bindings)
  mutable arguments = []
  mutable keyword_values = []
  node.arguments.each do |argument|
    if argument in KeywordArgumentNode
      step = evaluate_expression(argument.value, bindings)
      bindings = step.bindings
      keyword_values << [argument.label, slot_value(step.value)]
    else
      step = evaluate_expression(argument, bindings)
      bindings = step.bindings
      arguments += step.value
    end
  end
  # Inside a struct method, bare calls reach own methods first (#27).
  self_slot = lookup(bindings, "__self__")
  unless self_slot.empty?
    receiver = value_at(self_slot.first, 2)
    own = struct_method_for(receiver, node.name, bindings)
    return invoke_struct_method(receiver, own, arguments, keyword_values, bindings) unless own.nil?
  end
  # `fields(...)` — the raw constructor, and only inside `def self.new`
  # (ADR 0031). The name is unclaimable there: a program's own `fields`
  # function is refused rather than guessed at. The wordings are the seed's.
  if node.name == "fields"
    fields_slot = lookup(bindings, "__fields__")
    mutable function_slot = lookup(bindings, "fields")
    function_slot = resolve(bindings, "fields") if function_slot.empty?
    taken = !function_slot.empty? && function_slot.first[1] == "method"
    unless fields_slot.empty?
      panic("fields is the raw constructor inside def self.new — rename the fields function") if taken
      panic("fields takes keyword arguments, not positional ones") unless arguments.empty?
      target = value_at(fields_slot.first, 2)
      struct_slot = lookup(bindings, target)
      declared = value_at(struct_slot.first[2], 0)
      mutable ordered = []
      declared.each do |field|
        mutable index = 0
        while index < keyword_values.length
          ordered << [field, value_at(keyword_values[index], 1)] if keyword_values[index][0] == field
          index += 1
        end
      end
      return outcome([["__struct__", target, ordered]], bindings)
    end
    panic("`fields` is the raw constructor — it only exists inside def self.new") unless taken
  end
  mutable slot = lookup(bindings, node.name)
  slot = resolve(bindings, node.name) if slot.empty?
  if !slot.empty? && slot.first[1] == "method"
    return invoke_with_block(slot.first[2], arguments, keyword_values, node.block, nil, bindings)
  end
  case node.name
  when "puts"
    puts "" if arguments.empty?
    arguments.each do |argument|
      # The refusals come before the rendering, with the seed's wording.
      panic("puts got nil — handle the nil case first (p renders nil for debugging)") if argument.nil?
      panic("puts got a failure — handle the failure case first (p renders it for debugging)") if argument.failure?
      puts render(argument)
    end
    outcome([], bindings)
  when "p"
    arguments.each do |argument|
      puts render_inspect(argument)
    end
    outcome(arguments, bindings)
  when "some"
    outcome([some(slot_value(arguments))], bindings)
  when "failure"
    # Absence with a reason (ADR 0027); the host box carries the guest value.
    outcome([failure(slot_value(arguments))], bindings)
  when "read_file"
    # Delegated whole: the host answers content or a failure (ADR 0027),
    # and both are plain values the guest can hold.
    outcome([read_file(slot_value(arguments))], bindings)
  when "inspect"
    # `p` without the printing (ADR 0026); the host builtin answers the
    # untagged shapes, and render_inspect already speaks for the tagged ones.
    outcome([render_inspect(slot_value(arguments))], bindings)
  when "require_relative"
    evaluate_require(slot_value(arguments), bindings)
  when "panic"
    panic(slot_value(arguments))
  else
    puts "evaluator: undefined method #{node.name}"
    outcome([], bindings)
  end
end
