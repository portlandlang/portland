# Stage 1, act two: Portland running Portland.
#
# A library: require_relative "evaluator", then
# evaluate_program(parse_program(lex(source))).
#
# No mutable collections exist, so evaluation threads state the way the
# parser threads Step: every function returns an Outcome. The value field
# is a slot — [] for no value, [v] for a value — because statements may
# produce nothing and there is no nil. Bindings are an assoc array of
# [name, value] pairs. Guest values are host values, so arithmetic,
# equality, and puts formatting match the seed for free.
#
# To run a file, see run.pdx.

require_relative "parser"
require_relative "paths"
# The renderer's helpers (ADR 0047) — the runtime rows of its sentences
# are spelled with the same quoting, article, and truncation as the build's.
require_relative "refusals"

# signal is "none", or an unwinding "break" / "next" / "return"
# (a return's value rides in the value slot). A return also carries the
# frame depth it unwinds to — the method its block was written in (ADR
# 0025) — in target; the other signals leave it nil.
struct Outcome
  value
  bindings
  signal
  target
end

def outcome(value, bindings)
  Outcome.new(value: value, bindings: bindings, signal: "none", target: nil)
end

def signal_outcome(signal, value, bindings)
  Outcome.new(value: value, bindings: bindings, signal: signal, target: nil)
end

# A `return` in flight: aimed at the frame it was written in.
def return_outcome(value, bindings, target)
  Outcome.new(value: value, bindings: bindings, signal: "return", target: target)
end

# The call depth of the frame these bindings belong to. Rides the bindings
# as `__frame__` — the `__block__` trick — so a block evaluating a `return`
# reads its *writer's* depth, because a block closes over its writer's
# bindings (ADR 0025 gets write-site returns from that for free).
def frame_of(bindings)
  slot = lookup(bindings, "__frame__")
  return 0 if slot.empty?
  value_at(slot.first, 2)
end

# Pull a slot's value raw. Host `first`/`[index]` lift a stored nil to
# some(nil) (ADR 0005), but the slot pattern wants the value as-is —
# `each` is the unwrapped path. An empty slot comes back nil (crude: the
# evaluator conflates "no value" with nil where the seed panics).
def slot_value(values)
  mutable result = nil
  values.each do |value|
    result = value
  end
  result
end

# Raw positional read for the same reason — used where a triple or pair
# may hold nil in a value position, and for every argument a builtin is
# handed: `first` on a list holding nil answers the present nil ADR 0005
# keeps apart from absence, so the builtin would see some(nil) where the
# program wrote nil.
def value_at(list, target_index)
  mutable result = nil
  list.each_with_index do |element, index|
    result = element if index == target_index
  end
  result
end

# — evaluation —

def evaluate_program(nodes)
  # `require_relative` resolves against the file doing the requiring, so that
  # path has to be in scope from the first statement. The first argument is
  # it: the compiler was handed the guest program's path, and run.pdx read
  # the same value. What follows the path is the guest's own: its
  # `System.arguments` (ADR 0068) answers that, where the host's answers the
  # whole command line.
  host_arguments = System.arguments
  guest_arguments = if host_arguments.empty? then [] else host_arguments.slice(1, host_arguments.length - 1) end
  run_body(nodes, [["__file__", "file", host_arguments.first or "."], ["__arguments__", "arguments", guest_arguments]] + builtin_constants)
end

# The constants every program starts with (#152): `Float`'s, the seed's
# `builtin_constants`, bound under qualified names as a module's are.
def builtin_constants
  [
    ["Float::DIG", "constant", 15],
    ["Float::EPSILON", "constant", 2.220446049250313e-16],
    ["Float::INFINITY", "constant", 1.0 / 0.0],
    ["Float::MANT_DIG", "constant", 53],
    ["Float::MAX", "constant", 1.7976931348623157e308],
    ["Float::MAX_10_EXP", "constant", 308],
    ["Float::MAX_EXP", "constant", 1024],
    ["Float::MIN", "constant", 2.2250738585072014e-308],
    ["Float::MIN_10_EXP", "constant", -307],
    ["Float::MIN_EXP", "constant", -1021],
    ["Float::NAN", "constant", 0.0 / 0.0],
    ["Float::RADIX", "constant", 2]
  ]
end

# Run statements until done or a signal starts unwinding.
def run_body(nodes, bindings)
  mutable result = outcome([], bindings)
  nodes.each do |node|
    result = evaluate_statement(node, result.bindings)
    break unless result.signal == "none"
  end
  result
end

# The payoff of #26: the evaluator dispatches on its own AST with the
# struct patterns it just learned to run — Portland matching on Portland.
def evaluate_statement(node, bindings)
  case node
  in BreakNode then signal_outcome("break", [], bindings)
  in NextNode then signal_outcome("next", [], bindings)
  in WhileNode then evaluate_while(node, bindings)
  in TogetherNode then evaluate_together(node, bindings)
  in AssignmentNode(name:, value:)
    step = evaluate_expression(value, bindings)
    # An or-guard diverted (`x = f() or return`): skip the binding, unwind.
    return step unless step.signal == "none"
    bound = slot_value(step.value)
    outcome([bound], assigned(name, bound, node.rebindable, step.bindings))
  in DefNode(name:, parameters:, body:)
    outcome([], [[name, "method", [parameters, body]]] + declare(name, bindings))
  # A second name for an existing method (ADR 0039): the same slot value
  # bound twice, so the two names cannot drift. The target must already
  # exist — top to bottom, the seed's rule.
  in AliasNode(new_name:, old_name:)
    found = lookup(bindings, old_name)
    panic("alias points at nothing — no method #{old_name} defined yet") if found.empty? || found.first[1] != "method"
    outcome([], [[new_name, "method", found.first[2]]] + declare(new_name, bindings))
  in ReturnNode(value:)
    return return_outcome([], bindings, frame_of(bindings)) if value.nil?
    step = evaluate_expression(value, bindings)
    return_outcome(step.value, step.bindings, frame_of(bindings))
  in StructDefNode then outcome([], register_in_namespace(node, home_of(bindings), bindings))
  in TraitDefNode then outcome([], register_in_namespace(node, home_of(bindings), bindings))
  # Membership and exhaustiveness are static (#9) and a payload-free case is
  # just a symbol — but the declared labels register, because the one check
  # a runtime can make needs them (ADR 0022, #45).
  in EnumDefNode then outcome([], register_enum(node, declare(qualify(home_of(bindings), node.name), bindings)))
  in ModuleDefNode then evaluate_module(node, bindings)
  else
    evaluate_expression(node, bindings)
  end
end

# `together do ... end` (ADR 0029): serial today, and the oracle the
# parallel build must match on everything promised. Task expressions run in
# line order; names bind at the join; nothing unwinds across it; no outer
# mutable moves inside a task.
def evaluate_together(node, mutable bindings)
  entry = bindings
  mutable joined = []
  node.lines.each do |line|
    if line in TaskLineNode
      before = bindings
      step = evaluate_expression(line.value, bindings)
      panic("a task cannot unwind across the join — bind a name and handle it after end") unless step.signal == "none"
      panic("task #{line.name} produced no value") if step.value.empty?
      refuse_task_rebinds(before, step.bindings)
      bindings = step.bindings
      joined << [line.name, slot_value(step.value)]
    else
      step = evaluate_statement(line, bindings)
      panic("nothing unwinds out of together — the join comes first") unless step.signal == "none"
      bindings = step.bindings
    end
  end
  # Plain-line locals die at the end, like any block's.
  bindings = flow_back(entry, entry, bindings)
  joined.each do |pair|
    bindings = assigned(pair[0], value_at(pair, 1), false, bindings)
  end
  outcome([], bindings)
end

# A task rebinding an outer mutable is refused (ADR 0029): walk the entries
# its evaluation added; a preexisting mutable among them is one that moved.
def refuse_task_rebinds(before, after)
  mutable index = after.length - before.length - 1
  while index >= 0
    triple = after[index]
    panic("a task cannot rebind an outer mutable — bind a name and combine after the join") if triple[1] == "mutable" && !lookup(before, triple[0]).empty?
    index -= 1
  end
end

def evaluate_while(node, mutable bindings)
  entry = bindings
  while true
    condition = evaluate_expression(node.condition, bindings)
    bindings = condition.bindings
    break unless condition.value.first
    body = run_body(node.body, bindings)
    # Loop iterations are fresh scopes for their own locals — the block rule
    # applied to `while` (ADR 0001). Names first bound in the body die here,
    # so the next iteration binds them fresh; rebindings of names that
    # existed before the body flow through, which is what flow_back keeps.
    # What it keeps is a fresh shadow per iteration, so the shadowed dead
    # triples are compacted away before the next pass (#62).
    bindings = flow_back(bindings, bindings, body.bindings)
    bindings = compacted_since(entry, bindings)
    break if body.signal == "break"
    return return_outcome(body.value, bindings, body.target) if body.signal == "return"
  end
  # A finished while is nil, always (ADR 0012).
  outcome([nil], bindings)
end

def evaluate_if(node, bindings)
  condition = evaluate_expression(node.condition, bindings)
  body = if slot_value(condition.value)
    node.then_body
  else
    node.else_body
  end
  # A branch that doesn't happen produces nil (ADR 0012).
  return outcome([nil], condition.bindings) if body.nil?
  run_body(body, condition.bindings)
end

def evaluate_case(node, mutable bindings)
  subject = evaluate_expression(node.subject, bindings)
  bindings = subject.bindings
  mutable branch_index = 0
  while branch_index < node.branches.length
    branch = node.branches[branch_index]
    mutable value_index = 0
    while value_index < branch.values.length
      # Case equality, the seed's `case_matches` (#151).
      matched = guest_case_matches(branch.values[value_index], slot_value(subject.value), bindings)
      bindings = matched.bindings
      return run_body(branch.body, bindings) if matched.value.first
      value_index += 1
    end
    branch_index += 1
  end
  return outcome([], bindings) if node.else_body.nil?
  run_body(node.else_body, bindings)
end

# Ruby's case equality (#150, #151), the seed's `case_matches`: a type name
# matches a value of that type, a struct defining `===` answers for itself,
# and the rest — a range covering a number, equality — is the host's own
# `===`. An outcome whose value is the verdict.
def guest_case_matches(pattern_node, subject, bindings)
  if pattern_node in IdentifierNode
    typed = guest_type_matches(pattern_node.name, subject, bindings)
    return outcome([typed], bindings) unless typed.nil?
  end
  step = evaluate_expression(pattern_node, bindings)
  pattern = slot_value(step.value)
  if pattern in ["__struct__", *]
    method = struct_method_for(pattern, "===", step.bindings)
    unless method.nil?
      result = invoke_struct_method(pattern, method, [subject], [], step.bindings)
      answer = slot_value(result.value)
      panic("'===' answers true or false, got #{shorten(render_inspect(answer))}") unless answer == true || answer == false
      return outcome([answer], result.bindings)
    end
  end
  outcome([pattern === subject], step.bindings)
end

# Whether `subject` is of the type `name` names, or nil when `name` names no
# type — a builtin's, the host answering, or a struct's. Guest symbols and
# arrays wear the host's array shape, so those two are told apart here.
def guest_type_matches(name, subject, bindings)
  case name
  when "Array" then return guest_array?(subject)
  when "Symbol" then return subject in ["__symbol__", *]
  when "Boolean" then return Boolean === subject
  when "Float" then return Float === subject
  when "Hash" then return Hash === subject
  when "Integer" then return Integer === subject
  when "Range" then return Range === subject
  when "Random" then return Random === subject
  when "String" then return String === subject
  end
  slot = resolve(bindings, name)
  return nil if slot.empty? || slot.first[1] != "struct"

  (subject in ["__struct__", *]) && value_at(subject, 1) == slot.first[0]
end

def evaluate_case_in(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  mutable branch_index = 0
  while branch_index < node.branches.length
    branch = node.branches[branch_index]
    captures = match_pattern(branch.pattern, subject, bindings)
    unless captures.nil?
      # Captures bind before the guard runs, and persist (Ruby's rule) —
      # but into a trial scope, so a failed guard discards them: the branch
      # never happened, and the next branch may bind the same names fresh.
      # The bind itself enforces no-shadow (#45), the seed's rule.
      mutable trial = bindings
      captures.each do |capture|
        trial = assigned(capture[0], value_at(capture, 1), false, trial)
      end
      mutable guard_ok = true
      unless branch.guard.nil?
        guard_step = evaluate_expression(branch.guard, trial)
        trial = guard_step.bindings
        guard_ok = slot_value(guard_step.value)
      end
      return run_body(branch.body, trial) if guard_ok
    end
    branch_index += 1
  end
  if node.else_body.nil?
    panic("no pattern matched — add an in branch or an else")
  end
  run_body(node.else_body, bindings)
end

def evaluate_match_assert(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  captures = match_pattern(node.pattern, subject, bindings)
  panic("pattern mismatch — the => form panics when it can't destructure") if captures.nil?
  captures.each do |capture|
    bindings = assigned(capture[0], value_at(capture, 1), false, bindings)
  end
  outcome([nil], bindings)
end

def evaluate_match_test(node, mutable bindings)
  subject_step = evaluate_expression(node.subject, bindings)
  bindings = subject_step.bindings
  subject = slot_value(subject_step.value)
  captures = match_pattern(node.pattern, subject, bindings)
  return outcome([false], bindings) if captures.nil?
  captures.each do |capture|
    bindings = assigned(capture[0], value_at(capture, 1), false, bindings)
  end
  outcome([true], bindings)
end

# Bind or rebind a name, enforcing ADR 0001 (#45): `mutable` declares a new
# rebindable name exactly once; a bare assignment creates an immutable
# binding or rebinds an existing mutable one. Captures take the same rules.
# Every wording is the seed's.
def assigned(name, value, rebindable, bindings)
  slot = lookup(bindings, name)
  kind = if slot.empty?
    "unbound"
  else
    slot.first[1]
  end
  # A SCREAMING_CASE name at the top level is a constant (ADR 0053): bound
  # once, never mutable, with a def's reach — the "constant" tag survives a
  # method scope and crosses a require.
  if top_level?(bindings) && constant_name?(name)
    panic("'#{name}' is a constant — a constant cannot be mutable") if rebindable
    panic("'#{name}' is a constant — it is bound once") if kind == "constant"
    panic("'#{name}' is already defined — rename one") if kind == "method" || builtin_method?(name)
    return [[name, "constant", value]] + declare(name, bindings)
  end
  panic("'#{name}' is a single capital — spell a constant with two characters or more, a local in lowercase") if top_level?(bindings) && lone_capital?(name)
  panic("'#{name}' is a constant — it is bound once") if kind == "constant"
  panic("local #{name} shadows method #{name} — rename one") if kind == "method" || builtin_method?(name)
  if rebindable
    panic("#{name} is already declared — mutable declares a new name once") if kind == "local" || kind == "mutable"
    return [[name, "mutable", value]] + bindings
  end
  panic("#{name} is immutable — declare it `mutable #{name} = ...` if it needs to change") if kind == "local"
  return [[name, "mutable", value]] + bindings if kind == "mutable"
  [[name, "local", value]] + bindings
end

# The seed's builtin_name: names a local may never take.
def builtin_method?(name)
  %w[failure inspect p panic puts rand require_relative some srand].include?(name)
end

# The top of a file: no frame and no namespace around these bindings.
def top_level?(bindings) = frame_of(bindings) == 0 && home_of(bindings).empty?

# One definition per name (#70, ADR 0052): a builtin is never redefined,
# and a def, struct, enum, trait, alias, or constant is declared once. The
# names declared so far ride the bindings as `__declared__`, since an enum
# binds no name of its own; the tag is not a local's, so the list survives
# a method scope and crosses a require.
def declared_names(bindings)
  slot = lookup(bindings, "__declared__")
  return [] if slot.empty?
  value_at(slot.first, 2)
end

def declare(name, bindings)
  panic("'#{name}' is a builtin — rename yours") if builtin_method?(name) || name == "Comparable" || name == "Enumerable"
  panic("'#{name}' is already defined — rename one") if declared_names(bindings).include?(name)
  [["__declared__", "declared", declared_names(bindings) + [name]]] + bindings
end

# Try a pattern against a value: an array of [name, value] captures on a
# match (empty for literals), nil on a miss.
def match_pattern(pattern, mutable subject, bindings)
  # A failure is transparent to patterns (ADR 0027): its whole use is
  # carrying the reason to a handler whose tool is the pattern.
  while subject.failure?
    subject = failure_payload(subject)
  end
  case pattern
  in AlternativePatternNode then match_alternative(pattern, subject, bindings)
  in ArrayPatternNode then match_array(pattern, subject, bindings)
  in IdentifierNode(name:) then [[name, subject]]
  in PinNode then match_pin(pattern, subject, bindings)
  in RangeNode then match_range(pattern, subject, bindings)
  in StructPatternNode then match_struct(pattern, subject, bindings)
  in EnumCasePatternNode then match_enum_case(pattern, subject, bindings)
  else
    match_literal(pattern, subject, bindings)
  end
end

# `in :paid(on:)` — the case name must match, then each label binds or
# matches deeper (ADR 0022 §1).
def match_enum_case(pattern, subject, bindings)
  return nil unless subject in ["__enum_case__", *]
  return nil unless value_at(subject, 1) == pattern.name

  payload = value_at(subject, 2)
  mutable captures = []
  mutable index = 0
  while index < pattern.payload.length
    entry = pattern.payload[index]
    value = enum_payload_value(payload, entry[0])
    return nil if value.nil?

    sub_captures = match_pattern(entry[1], value, bindings)
    return nil if sub_captures.nil?

    sub_captures.each do |capture|
      captures << capture
    end
    index += 1
  end
  captures
end

def enum_payload_value(payload, label)
  mutable found = nil
  payload.each do |entry|
    found = entry[1] if entry[0] == label
  end
  found
end

def match_literal(pattern, subject, bindings)
  value_step = evaluate_expression(pattern, bindings)
  return [] if slot_value(value_step.value) == subject
  nil
end

# A range pattern tests membership, not equality (ADR 0019 §1). Integer
# subjects only — anything else misses, the seed's rule (#40). Guest ranges
# are host ranges, so `include?` answers without walking.
def match_range(pattern, subject, bindings)
  return nil unless subject in Integer
  range_step = evaluate_expression(pattern, bindings)
  return [] if slot_value(range_step.value).include?(subject)
  nil
end

def match_pin(pattern, subject, bindings)
  slot = lookup(bindings, pattern.name)
  panic("undefined variable #{pattern.name} in a ^ pin") if slot.empty?
  return [] if value_at(slot.first, 2) == subject
  nil
end

def match_alternative(pattern, subject, bindings)
  mutable index = 0
  while index < pattern.options.length
    captures = match_pattern(pattern.options[index], subject, bindings)
    return captures unless captures.nil?
    index += 1
  end
  nil
end

def match_array(pattern, subject, bindings)
  # A wrong-shaped subject misses rather than crashing — the seed's rule.
  # This used to be a recorded crude gap, from before the tagged-shape
  # predicates existed.
  return nil unless plain_array?(subject)
  return nil if pattern.splat == false && subject.length != pattern.elements.length
  return nil if subject.length < pattern.elements.length
  mutable captures = []
  mutable index = 0
  while index < pattern.elements.length
    element_captures = match_pattern(pattern.elements[index], value_at(subject, index), bindings)
    return nil if element_captures.nil?
    captures += element_captures
    index += 1
  end
  if pattern.splat && pattern.rest_name.some?
    rest = subject.slice(pattern.elements.length, subject.length - pattern.elements.length)
    captures << [pattern.rest_name, rest]
  end
  captures
end

# Builtin type patterns bootstrap on the seed's own (#27): the compiler asks
# the host `subject in Integer` to answer the guest's `in Integer`.
def match_builtin_type(pattern, subject)
  matched = case pattern.name
  when "Boolean" then subject in Boolean
  when "Hash" then subject in Hash
  when "Integer" then subject in Integer
  when "Random" then subject in Random
  when "String" then subject in String
  when "Array"
    # Guest struct instances are tagged host arrays — exclude them.
    (subject in Array) && !(subject in ["__struct__", *])
  else
    false
  end
  return [] if matched
  nil
end

def match_struct(pattern, subject, bindings)
  if %w[Array Boolean Hash Integer Random String].include?(pattern.name)
    return match_builtin_type(pattern, subject)
  end
  # A wrong-shaped subject misses rather than crashing — the seed's rule.
  return nil unless subject in ["__struct__", *]
  return nil unless value_at(subject, 1) == pattern.name
  mutable captures = []
  mutable index = 0
  while index < pattern.fields.length
    field = pattern.fields[index]
    value = struct_field(subject, field[0])
    sub_captures = match_pattern(field[1], value, bindings)
    return nil if sub_captures.nil?
    captures += sub_captures
    index += 1
  end
  captures
end

# Every rebinding is a prepend (the shadow-stack rule), so a loop that
# rebinds a name leaves the previous iteration's triple behind it, dead: the
# newer one in front is all lookup can ever reach. Dropping those dead
# triples at each iteration boundary caps the ledger at the loop's steady
# state instead of growing it by every iteration, which is what made hosted
# loops quadratic (#62).
#
# Only the region added since `entry` is deduplicated — first (newest) triple
# per name kept, in place. Everything at or below the entry is untouched
# shared suffix, which is what keeps the added-entries arithmetic elsewhere
# exact: flow_back and refuse_task_rebinds mark scopes that always sit at or
# below the loop's entry, so the entries they walk are dropped by no one.
def compacted_since(entry, bindings)
  added_count = bindings.length - entry.length
  return bindings if added_count < 2
  mutable kept = []
  mutable index = 0
  while index < added_count
    triple = bindings[index]
    kept << triple if lookup(kept, triple[0]).empty?
    index += 1
  end
  return bindings if kept.length == added_count
  kept + bindings.slice(added_count, bindings.length - added_count)
end

# Bindings are [name, kind, payload] triples — kind is "local" or "method".
# The no-shadow rule means one namespace serves both. First match wins,
# so prepending a triple is both set and shadow.
def lookup(bindings, name)
  mutable index = 0
  while index < bindings.length
    triple = bindings[index]
    return [triple] if triple[0] == name
    index += 1
  end
  []
end

# — namespaces (ADR 0021) —
#
# Namespaces are flattened to qualified names at definition time, exactly
# as the seed does; `__home__` carries the namespace a method was written
# in so its bare names resolve outward.

# A constant of the current receiver's type (#145), read bare from its
# instance methods — `Token::KINDS` as `KINDS` — or no slot.
def own_type_constant(bindings, name)
  self_slot = lookup(bindings, "__self__")
  return [] if self_slot.empty?

  receiver = value_at(self_slot.first, 2)
  lookup(bindings, "#{value_at(receiver, 1)}::#{name}")
end

def home_of(bindings)
  slot = lookup(bindings, "__home__")
  return "" if slot.empty?
  value_at(slot.first, 2)
end

def qualify(home, name)
  return name if home.empty?
  "#{home}::#{name}"
end

# Drop the last `::` segment of a path.
def enclosing(home)
  parts = home.split("::")
  return "" if parts.length <= 1
  kept = parts.slice(0, parts.length - 1)
  kept.join("::")
end

# Resolve a name outward: own namespace first, then each enclosing level,
# then the top. Lexical scope always includes every enclosing level,
# however the namespace was declared.
def resolve(bindings, name)
  mutable home = home_of(bindings)
  while true
    slot = lookup(bindings, qualify(home, name))
    return slot unless slot.empty?
    break if home.empty?
    home = enclosing(home)
  end
  []
end

# Does any binding live under this name? Tells `Statistics.mean(x)` from
# an ordinary receiver.
def namespace?(bindings, name)
  prefix = "#{name}::"
  mutable index = 0
  while index < bindings.length
    return true if bindings[index][0].start_with?(prefix)
    index += 1
  end
  false
end

# The namespace a receiver names, resolved outward, or nil.
def namespace_for(bindings, name)
  mutable home = home_of(bindings)
  while true
    candidate = qualify(home, name)
    return candidate if namespace?(bindings, candidate)
    break if home.empty?
    home = enclosing(home)
  end
  nil
end

def evaluate_module(node, mutable bindings)
  outer = home_of(bindings)
  home = qualify(outer, node.path.join("::"))
  node.body.each do |statement|
    bindings = register_in_namespace(statement, home, bindings)
  end
  outcome([], bindings)
end

# Register one declaration under a namespace, recursing for nesting.
def register_in_namespace(statement, home, mutable bindings)
  case statement
  in DefNode(name:, parameters:, body:)
    [[qualify(home, name), "method", [parameters, body, home]]] + declare(qualify(home, name), bindings)
  in AliasNode(new_name:, old_name:)
    found = lookup(bindings, qualify(home, old_name))
    panic("alias points at nothing — no method #{old_name} defined yet") if found.empty? || found.first[1] != "method"
    [[qualify(home, new_name), "method", found.first[2]]] + declare(qualify(home, new_name), bindings)
  in StructDefNode(name:, fields:, includes:, methods:, nested:, type_functions:, constants:)
    inner_home = qualify(home, name)
    # Included traits merge here, at registration (ADR 0028), so dispatch
    # needs no new rungs and every collision refuses naming both owners.
    merged = merged_methods(name, fields, includes, methods, home, bindings)
    # The registration's third slot says whether the struct is Comparable,
    # the fourth whether it is Enumerable (#110).
    mutable result = [[inner_home, "struct", [fields, value_at(merged, 0), value_at(merged, 1), value_at(merged, 2)]]] + declare(inner_home, bindings)
    # Type functions (ADR 0031) register as ordinary methods under the
    # struct's namespace — `Token::of` — so the namespace rung dispatches
    # them with no new machinery. Their home is the struct itself: bare
    # names inside resolve outward from it, sibling type functions included.
    type_functions.each do |function|
      result = [["#{inner_home}::#{function.name}", "method", [function.parameters, function.body, inner_home]]] + result
    end
    # The type's constants (#145) register under it as a module's do,
    # `Token::KINDS`, each computed with the ones before it in reach.
    constants.each do |constant|
      result = register_in_namespace(constant, inner_home, result)
    end
    nested.each do |inner|
      result = register_in_namespace(inner, inner_home, result)
    end
    result
  # A trait waits under its qualified name to be included (ADR 0028).
  in TraitDefNode(name:, methods:)
    [[qualify(home, name), "trait", methods]] + declare(qualify(home, name), bindings)
  in ModuleDefNode(path:, body:)
    inner_home = qualify(home, path.join("::"))
    mutable result = bindings
    body.each do |inner|
      result = register_in_namespace(inner, inner_home, result)
    end
    result
  in AssignmentNode(name:, value:)
    # A module's constant is bound once, like the top level's (ADR 0053).
    panic("'#{name}' is a constant — it is bound once") unless lookup(bindings, qualify(home, name)).empty?
    # Its value is computed from inside the namespace, so the constants
    # written before it resolve bare — `DOUBLE = LIMIT * 2`, as the seed.
    step = evaluate_expression(value, [["__home__", "home", home]] + bindings)
    # "constant" rather than "local" so it survives a fresh method scope.
    [[qualify(home, name), "constant", slot_value(step.value)]] + declare(qualify(home, name), bindings)
  # Nested or module-housed enums register their cases unqualified — the
  # seed looks a case up across every declaration, since a bare `:paid`
  # says nothing about which vocabulary it came from.
  in EnumDefNode then register_enum(statement, declare(qualify(home, statement.name), bindings))
  else
    bindings
  end
end

# Included traits merge at struct registration (ADR 0028): the seed's rule
# and the seed's wordings — every collision a refusal naming both owners,
# never Ruby's silent last-include-wins.
def merged_methods(struct_name, fields, includes, methods, home, bindings)
  mutable merged = methods
  mutable origins = []
  mutable comparable = false
  mutable enumerable = false
  includes.each do |written|
    # `Comparable` and `Enumerable` are the two builtin traits (ADR 0054,
    # #110): no methods of their own — the orderings derive from the
    # struct's `<=>` and the walks from its `each`, which must exist.
    if written == "Comparable"
      panic("#{struct_name} includes Comparable but defines no '<=>' — define it") unless methods.any? { it.name == "<=>" }
      comparable = true
      next
    end
    if written == "Enumerable"
      panic("#{struct_name} includes Enumerable but defines no 'each' — define it") unless methods.any? { it.name == "each" }
      enumerable = true
      next
    end
    slot = resolve_from(bindings, home, written)
    trait_methods = trait_methods_of(written, slot, bindings)
    trait_methods.each do |method|
      panic("#{method.name} is a field of #{struct_name} and a method of #{written} — a name is a field or a method, never both") if fields.include?(method.name)
      origins.each do |origin|
        panic("#{method.name} is declared by both #{origin[0]} and #{written} — #{struct_name} must not include both, or one renames") if value_at(origin, 1) == method.name
      end
      methods.each do |own|
        panic("#{struct_name} defines #{method.name} and includes it from #{written} — one of them renames") if own.name == method.name
      end
      origins << [written, method.name]
      merged += [method]
    end
  end
  [merged, comparable, enumerable]
end

# The trait's method list, or the seed's refusal for whatever `written`
# turned out to be instead.
def trait_methods_of(written, slot, bindings)
  unless slot.empty?
    kind = slot.first[1]
    return value_at(slot.first, 2) if kind == "trait"
    panic("#{written} is a struct, not a trait — a struct is a value; hold one in a field") if kind == "struct"
  end
  panic("#{written} is a namespace, not a trait — namespaces are never injected; write #{written}.method(...)") if namespace?(bindings, written)
  panic("undefined trait #{written}")
end

# Resolve outward from an explicit home — registration runs before any
# `__home__` binding reflects the namespace being defined.
def resolve_from(bindings, mutable home, name)
  while true
    slot = lookup(bindings, qualify(home, name))
    return slot unless slot.empty?
    break if home.empty?
    home = enclosing(home)
  end
  []
end

# ADR 0022's one runtime check needs the declarations at hand, so every enum
# adds its cases to the `__enums__` registry riding in the bindings — the
# `__loaded__` trick again. Every declaration is kept, not just the first,
# because two enums may declare one case name and must then agree (#45).
def register_enum(node, bindings)
  slot = lookup(bindings, "__enums__")
  known = if slot.empty?
    []
  else
    value_at(slot.first, 2)
  end
  mutable cases = known
  node.cases.each do |declared|
    cases += [[declared.name, declared.labels]]
  end
  [["__enums__", "enums", cases]] + bindings
end

# The one enum check a *runtime* can make (ADR 0022): a payload names the
# labels its case declared, in declaration order. Membership and
# exhaustiveness stay static (#9) — this one is answerable because the value
# carries its own case name.
def check_payload_labels(node, bindings)
  slot = lookup(bindings, "__enums__")
  known = if slot.empty?
    []
  else
    value_at(slot.first, 2)
  end
  declarations = known.select { it[0] == node.name }
  panic("no enum declares a case :#{node.name}") if declarations.empty?
  labels = value_at(declarations.first, 1)
  declarations.each do |declaration|
    panic("two enums declare :#{node.name} with different payloads — the seed cannot tell them apart") unless value_at(declaration, 1) == labels
  end
  given = node.payload.map { it.label }
  return if given == labels
  wanted = labels.map { it + ":" }.join(", ")
  panic("`:#{node.name}` takes (#{wanted})")
end

def evaluate_expression(node, bindings)
  case node
  in AppendNode then evaluate_append(node, bindings)
  in ArrayNode then evaluate_array(node, bindings)
  in BinaryNode then evaluate_binary(node, bindings)
  in BooleanNode(value:) then outcome([value == "true"], bindings)
  in CallNode then evaluate_call(node, bindings)
  in YieldNode then evaluate_yield(node, bindings)
  in CaseInNode then evaluate_case_in(node, bindings)
  in CaseNode then evaluate_case(node, bindings)
  # `pattern === subject` (#150).
  in CaseEqualNode
    subject_step = evaluate_expression(node.subject, bindings)
    guest_case_matches(node.pattern, slot_value(subject_step.value), subject_step.bindings)
  in HashNode then evaluate_hash(node, bindings)
  in IfNode then evaluate_if(node, bindings)
  in IndexNode then evaluate_index(node, bindings)
  in IndexUpdateNode then evaluate_index_update(node, bindings)
  in SlotCompoundNode then evaluate_slot_compound(node, bindings)
  in IntegerNode(value:) then outcome([value.to_i], bindings)
  in FloatNode(value:) then outcome([value.to_f], bindings)
  in RangeNode then evaluate_range(node, bindings)
  in LogicalNode then evaluate_logical(node, bindings)
  in MatchAssertNode then evaluate_match_assert(node, bindings)
  in MatchTestNode then evaluate_match_test(node, bindings)
  in MethodCallNode | SafeMethodCallNode then evaluate_method_call(node, bindings)
  in NilNode then outcome([nil], bindings)
  in SelfNode then evaluate_self(bindings)
  in StringNode(value:) then outcome([value], bindings)
  # Guest symbols are tagged arrays, like guest structs — the compiler cannot
  # manufacture a host symbol, because ADR 0023 removed `to_sym` and there
  # is deliberately no way to build one from a name at runtime. That is the
  # decision working as intended, felt by its own compiler.
  in SymbolNode(value:) then outcome([["__symbol__", value]], bindings)
  in EnumCaseNode then evaluate_enum_case(node, bindings)
  in UnaryNode then evaluate_unary(node, bindings)
  in WordArrayNode(text:) then outcome([word_array_elements(text)], bindings)
  in SymbolArrayNode(text:) then outcome([symbol_array_elements(text)], bindings)
  in IdentifierNode(name:)
    mutable slot = lookup(bindings, name)
    slot = resolve(bindings, name) if slot.empty?
    slot = own_type_constant(bindings, name) if slot.empty?
    if slot.empty? || slot.first[1] == "method"
      evaluate_call(call_node(name, []), bindings)
    else
      outcome([value_at(slot.first, 2)], bindings)
    end
  # A parse error reaches the evaluator as a node carrying its message.
  # Surfacing it here — where nested errors land too, since an ErrorNode
  # can be an argument — means every parser diagnostic, present and
  # future, stops the program instead of evaluating around the hole.
  in ErrorNode(message:) then panic(message)
  in PathNode(parts:)
    joined = parts.join("::")
    slot = lookup(bindings, joined)
    if slot.empty?
      # The seed's wording for a missing `::` name, and a failure (#98).
      panic("undefined name #{joined}")
    else
      outcome([value_at(slot.first, 2)], bindings)
    end
  else
    puts "evaluator: cannot evaluate #{node.kind} yet"
    outcome([], bindings)
  end
end

# Guest operands are host values, so host operators do the arithmetic and
# host strictness (type panics, divide by zero) is the guest error story.
def evaluate_binary(node, bindings)
  left_step = evaluate_expression(node.left, bindings)
  right_step = evaluate_expression(node.right, left_step.bindings)
  left = slot_value(left_step.value)
  right = slot_value(right_step.value)
  # A struct orders by its own `<=>` (ADR 0054), which is a call, so it
  # cannot ride the host's operators below.
  if (left in ["__struct__", *]) && %w[<=> < <= > >=].include?(node.operator)
    return compare_struct(node.operator, left, right, right_step.bindings)
  end
  # Symbols order by their names (#105), the seed's rule; a guest symbol
  # is a tagged array here, so its name is read out before the host
  # compares.
  if (left in ["__symbol__", *]) && (right in ["__symbol__", *]) && %w[<=> < <= > >=].include?(node.operator)
    left_name = value_at(left, 1)
    right_name = value_at(right, 1)
    ordered = case node.operator
              when "<=>" then left_name <=> right_name
              when "<"   then left_name < right_name
              when "<="  then left_name <= right_name
              when ">"   then left_name > right_name
              else            left_name >= right_name
              end
    return outcome([ordered], right_step.bindings)
  end
  # Arrays order element by element under `<=>` alone, and an element may
  # be a struct, so the walk is the evaluator's rather than the host's.
  if node.operator == "<=>" && guest_array?(left) && guest_array?(right)
    return outcome([compare_guest_arrays(left, right, right_step.bindings)], right_step.bindings)
  end
  result = case node.operator
  when "<=>" then left <=> right
  when "+" then left + right
  when "-" then left - right
  when "*" then left * right
  when "/" then left / right
  when "%" then left % right
  # `**` rides the host whole (ADR 0033): the rational and overflow
  # refusals below are the seed's own, wording included.
  when "**" then left ** right
  when "==" then left == right
  when "!=" then left != right
  when "<" then left < right
  when "<=" then left <= right
  when ">" then left > right
  when ">=" then left >= right
  else
    puts "evaluator: unknown operator #{node.operator}"
    0
  end
  outcome([result], right_step.bindings)
end

# `<=>` and the four orderings on a struct (ADR 0054): `<=>` calls the
# struct's own; the four need `include Comparable` and derive from it. The
# seed's sentences.
def compare_struct(operator, left, right, bindings)
  own = struct_method_for(left, "<=>", bindings)
  panic("cannot apply '#{operator}' to #{shorten(render_inspect(left))} and #{shorten(render_inspect(right))}") if own.nil?
  unless operator == "<=>" || struct_comparable?(left, bindings)
    panic("cannot apply '#{operator}' to #{shorten(render_inspect(left))} and #{shorten(render_inspect(right))} — include Comparable in #{value_at(left, 1)}")
  end
  step = invoke_struct_method(left, own, [right], [], bindings)
  ordering = slot_value(step.value)
  panic("'<=>' answers -1, 0, or 1, got #{shorten(render_inspect(ordering))}") unless ordering in Integer
  answer = case operator
           when "<" then ordering < 0
           when "<=" then ordering <= 0
           when ">" then ordering > 0
           when ">=" then ordering >= 0
           else ordering_sign(ordering)
           end
  outcome([answer], bindings)
end

def ordering_sign(ordering)
  return -1 if ordering < 0
  return 1 if ordering > 0
  0
end

# Whether the struct's declaration said `include Comparable`: the third
# slot of its registration.
def struct_comparable?(value, bindings)
  slot = lookup(bindings, value_at(value, 1))
  return false if slot.empty?
  value_at(slot.first[2], 2) == true
end

def struct_enumerable?(value, bindings)
  slot = lookup(bindings, value_at(value, 1))
  return false if slot.empty?
  value_at(slot.first[2], 3) == true
end

# The names Ruby's Enumerable gives a struct that defines `each` (#110),
# as far as the array arms carry them — the seed's list.
def enumerable_name?(name)
  %w[all? any? chunk chunk_while collect collect_concat compact count cycle detect drop drop_while each_cons each_slice each_with_index entries filter filter_map find find_all find_index first flat_map grep grep_v group_by include? inject map max max_by member? min min_by minmax minmax_by none? one? partition reduce reject reverse_each select slice_after slice_before slice_when sort sort_by sum take take_while tally to_a to_h uniq zip].include?(name)
end

# The elements an Enumerable struct's own `each` yields (#110), gathered by
# running `each` under a block that only keeps what it is given — the
# `__collector__` marker in the `__block__` slot, which evaluate_yield
# grows one yield at a time; the body's final slot holds them all.
def enumerable_elements(receiver, bindings)
  each = struct_method_for(receiver, "each", bindings)
  panic("#{value_at(receiver, 1)} includes Enumerable but defines no 'each' — define it") if each.nil?
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  scope = [["__self__", "local", receiver]] + scope
  pairs = value_at(receiver, 2)
  pairs.each do |pair|
    scope = [[pair[0], "local", value_at(pair, 1)]] + scope
  end
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  scope = [["__block__", "block", ["__collector__", []]]] + scope
  result = run_body(each.body, scope)
  slot = lookup(result.bindings, "__block__")
  return [] if slot.empty?
  value_at(slot.first[2], 1)
end

# `sort`, `min`, and `max` over structs order by their `<=>` (ADR 0054);
# host values ride the host's own ordering.
def guest_structs?(values) = guest_array?(values) && !values.empty? && values.all? { it in ["__struct__", *] }

# What a symbol's name answers for one of its text queries (#112).
def symbol_text_answer(text, name, arguments)
  case name
  when "name", "id2name" then text
  when "length", "size" then text.length
  when "empty?" then text.empty?
  when "slice" then text.slice(value_at(arguments, 0), value_at(arguments, 1))
  when "start_with?" then arguments.any? { |prefix| text.start_with?(prefix) }
  else arguments.any? { |suffix| text.end_with?(suffix) }
  end
end


def guest_ordering(left, right, bindings)
  return slot_value(compare_struct("<=>", left, right, bindings).value) if left in ["__struct__", *]
  return compare_guest_arrays(left, right, bindings) if guest_array?(left) && guest_array?(right)
  left <=> right
end

# A guest array proper — not a symbol, enum case, or struct wearing the
# host's array shape.
def guest_array?(value) = (value in Array) && !(value in ["__struct__", *] | ["__symbol__", *] | ["__enum_case__", *])

# Ruby's array ordering: the first differing pair decides, and a shorter
# array sorts first when every pair agrees.
def compare_guest_arrays(left, right, bindings)
  mutable index = 0
  while index < left.length && index < right.length
    ordering = guest_ordering(left[index], right[index], bindings)
    return ordering unless ordering == 0
    index += 1
  end
  ordering_sign(left.length - right.length)
end

def sorted_values(values, bindings)
  return values.sort unless guest_structs?(values)
  mutable sorted = []
  values.each do |element|
    mutable position = sorted.length
    while position > 0 && guest_ordering(sorted[position - 1], element, bindings) > 0
      position -= 1
    end
    sorted = sorted.slice(0, position) + [element] + sorted.slice(position, sorted.length - position)
  end
  sorted
end

def extreme_value(values, which, bindings)
  unless guest_structs?(values)
    return values.min if which == "min"
    return values.max
  end
  mutable chosen = nil
  values.each do |element|
    if chosen.nil?
      chosen = element
    elsif which == "min" && guest_ordering(element, chosen, bindings) < 0
      chosen = element
    elsif which == "max" && guest_ordering(element, chosen, bindings) > 0
      chosen = element
    end
  end
  chosen
end

# `between?` and `clamp` on a struct, by its `<=>` (ADR 0054).
def ordered_answer(name, receiver, arguments, bindings)
  low = value_at(arguments, 0)
  high = value_at(arguments, 1)
  # Bounds given backwards refuse — the seed's rule and sentence.
  if name == "clamp" && guest_ordering(low, high, bindings) > 0
    panic("'clamp' takes the low bound first, got #{shorten(render_inspect(low))} then #{shorten(render_inspect(high))}")
  end
  above_low = guest_ordering(receiver, low, bindings) >= 0
  below_high = guest_ordering(receiver, high, bindings) <= 0
  return above_low && below_high if name == "between?"
  return low unless above_low
  return high unless below_high
  receiver
end

# Typed or, mirrored from the seed (ADR 0007): nil unwraps-or-else and the
# right side may be an or-guard diverger (a statement node); booleans stay
# logical; a present wrapped value unwraps one layer via host `or`.
def evaluate_logical(node, bindings)
  left_step = evaluate_expression(node.left, bindings)
  left = slot_value(left_step.value)
  if node.operator == "&&"
    # Both sides must be booleans — the seed's rule and sentence (#87);
    # the host's own `unless` used to answer for the left with the wrong
    # words, and the right went unchecked.
    refuse_operand("&&", left) unless left == true || left == false
    return outcome([false], left_step.bindings) if left == false
    right_step = evaluate_expression(node.right, left_step.bindings)
    right = slot_value(right_step.value)
    refuse_operand("&&", right) unless right == true || right == false
    return right_step
  end
  # A failure takes the fallback exactly as nil does (ADR 0027): failure is
  # absence with a reason, and `or` is its unwrap-or-else.
  return evaluate_statement(node.right, left_step.bindings) if left.nil? || left.failure?
  return outcome([true], left_step.bindings) if left == true
  if left == false
    # A false left makes this the boolean `||`, and the right must answer
    # in kind — the check the hosted side skipped (#87).
    right_step = evaluate_expression(node.right, left_step.bindings)
    right = slot_value(right_step.value)
    refuse_operand("||", right) unless right == true || right == false
    return right_step
  end
  outcome([left or nil], left_step.bindings)
end

# The seed's sentence for a logical operand that is not a boolean, with the
# value shown as the seed shows it (ADR 0047 §5–6).
def refuse_operand(operator, value)
  panic("#{spelled(operator)} needs true or false, got #{shorten(render_inspect(value))}")
end

def evaluate_unary(node, bindings)
  step = evaluate_expression(node.operand, bindings)
  operand = slot_value(step.value)
  result = if node.operator == "!"
    !operand
  elsif node.operator == "+"
    +operand
  else
    # The host's own negation, not `0 - operand`: that loses a float
    # zero's sign and words an overflow as a subtraction.
    -operand
  end
  outcome([result], step.bindings)
end

def evaluate_array(node, mutable bindings)
  mutable elements = []
  node.elements.each do |element|
    step = evaluate_expression(element, bindings)
    bindings = step.bindings
    elements += step.value
  end
  outcome([elements], bindings)
end

# Guest hashes are host hashes now: `[]=` (ADR 0015) is exactly the
# incremental construction Portland used to lack — the pair-list era ends.
def evaluate_hash(node, mutable bindings)
  mutable built = {}
  node.pairs.each do |pair|
    key_step = evaluate_expression(pair.key, bindings)
    bindings = key_step.bindings
    value_step = evaluate_expression(pair.value, bindings)
    bindings = value_step.bindings
    built[slot_value(key_step.value)] = slot_value(value_step.value)
  end
  outcome([built], bindings)
end

def evaluate_append(node, mutable bindings)
  slot = lookup(bindings, node.name)
  panic("undefined variable #{node.name}") if slot.empty?
  current = value_at(slot.first, 2)
  value_step = evaluate_expression(node.value, bindings)
  bindings = value_step.bindings
  value = slot_value(value_step.value)
  # Crude string-vs-array probe (no type predicates yet): an empty slice
  # of a string is "", of an array is [].
  appended = if current.slice(0, 0) == ""
    current + value
  else
    current + [value]
  end
  outcome([appended], bindings)
end

# Guest ranges are host ranges (ADR 0019): the evaluator builds them with
# the range syntax itself, so the seed's clamping and iteration come along
# for free. Either bound may be nil for the endless and beginless forms.
def build_range(start_value, finish_value, exclusive)
  if start_value.nil?
    return (...finish_value) if exclusive
    return (..finish_value)
  end
  if finish_value.nil?
    return (start_value...) if exclusive
    return (start_value..)
  end
  return start_value...finish_value if exclusive
  start_value..finish_value
end

def evaluate_range(node, mutable bindings)
  mutable start_value = nil
  if node.start.some?
    start_step = evaluate_expression(node.start, bindings)
    bindings = start_step.bindings
    start_value = slot_value(start_step.value)
  end
  mutable finish_value = nil
  if node.finish.some?
    finish_step = evaluate_expression(node.finish, bindings)
    bindings = finish_step.bindings
    finish_value = slot_value(finish_step.value)
  end
  outcome([build_range(start_value, finish_value, node.exclusive)], bindings)
end

# `name[index] = value` — a functional update rebound onto the name
# (ADR 0015): arrays replace in range or append at the end, hashes replace
# or add the pair. The array half used to fall into the hash rebuild and
# crash on the two-parameter block (#43).
def evaluate_index_update(node, mutable bindings)
  slot = lookup(bindings, node.name)
  panic("undefined variable #{node.name}") if slot.empty?
  current = value_at(slot.first, 2)
  index_step = evaluate_expression(node.index, bindings)
  bindings = index_step.bindings
  key = slot_value(index_step.value)
  value_step = evaluate_expression(node.value, bindings)
  bindings = value_step.bindings
  value = slot_value(value_step.value)
  outcome([written_slot(current, key, value, node.name)], bindings)
end

# The write half of `name[index] = value` — shared by IndexUpdate and the
# slot compounds: arrays replace in range (or append at the end), hashes
# replace or add the pair.
def written_slot(collection, key, value, name)
  return updated_array(collection, key, value, name) if plain_array?(collection)
  mutable rebuilt = {}
  collection.each do |existing_key, existing_value|
    rebuilt[existing_key] = existing_value
  end
  rebuilt[key] = value
  rebuilt
end

# `name[index] += v` / `name[index] ||= v` (ADR 0043): the compound family
# on a slot. Its own node so the index runs once. The read rides the host's
# `[]`, the or-form follows evaluate_logical's rules (short-circuit
# included), the write is IndexUpdate's.
def evaluate_slot_compound(node, bindings)
  index_step = evaluate_expression(node.index, bindings)
  key = slot_value(index_step.value)
  slot = lookup(index_step.bindings, node.name)
  panic("undefined variable #{node.name}") if slot.empty?
  collection = value_at(slot.first, 2)
  combined = slot_combined(node, collection[key], index_step.bindings)
  outcome([written_slot(collection, key, slot_value(combined.value), node.name)], combined.bindings)
end

# The combine half of a slot compound: the slot's current value is already
# read, the right side only runs when it can matter.
def slot_combined(node, current, bindings)
  if node.operator.nil?
    return evaluate_expression(node.right, bindings) if current.nil? || current.failure?
    return outcome([true], bindings) if current == true
    return evaluate_expression(node.right, bindings) if current == false
    # Present-but-wrapped: unwrap one layer — a stored nil beats the
    # default, exactly fetch's rule (ADR 0010).
    return outcome([current or nil], bindings)
  end
  right_step = evaluate_expression(node.right, bindings)
  right = slot_value(right_step.value)
  result = case node.operator
  when "%" then current % right
  when "*" then current * right
  when "+" then current + right
  when "-" then current - right
  else current / right
  end
  outcome([result], right_step.bindings)
end

# A host array that is a guest array — not one of the tagged shapes standing
# in for values the compiler cannot spell.
def plain_array?(value)
  return false unless value in Array
  return false if value in ["__struct__", *] | ["__symbol__", *] | ["__enum_case__", *]
  true
end

# — rendering (#39) —
#
# The seed prints tagged guest shapes raw — `{[__symbol__, name] => 1}` for
# any hash with symbol keys — because the host's Display cannot know what the
# tags stand for. These two walkers are the seed's Display and inspect,
# rewritten in Portland, so `puts`, `p`, `to_s`, `join`, and interpolation
# say exactly what the seed says. Anything untagged leans on the host, which
# is the seed itself.

# The shorthand-eligible names: identifier characters throughout, with ? or !
# allowed last. The seed asks Unicode's is_alphanumeric here and this asks an
# ASCII table, a divergence no literally-written symbol has met yet. The
# table sits inside the method because a method scope sees no top-level
# locals, and a top-level constant is one.
def identifier_shaped?(name)
  return false if name.empty?
  table = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
  characters = name.chars
  # A name starts with a letter or an underscore, never a digit, so `:"9"`
  # keeps its quotes as Ruby's does.
  return false if "0123456789".include?(characters[0])
  # A bare name is ASCII (#139), so a symbol with any other character keeps
  # its quotes — the spelling that lexes here.
  mutable index = 0
  while index < characters.length
    character = characters[index]
    suffix = index + 1 == characters.length && (character == "?" || character == "!")
    return false unless table.include?(character) || suffix
    index += 1
  end
  true
end

# How a symbol is written back out: `:paid`, or `:"odd key"` when the name
# is not identifier-shaped (ADR 0023).
def symbol_source(name)
  return ":" + name if identifier_shaped?(name)
  ":" + encode_string(name)
end

# The payload of a failure, pulled through the host's own pattern
# transparency (ADR 0027): a capture matches a failure as its payload, so
# the one-line `in` is the unwrapper — the same bootstrap trick as type
# patterns, with no privileged builtin.
def failure_payload(value)
  value in unwrapped
  unwrapped
end

# The seed's Display: what `puts`, `to_s`, `join`, and interpolation show.
# Symbols shed the colon; structs, enum cases, maybes, and failures keep
# their inspect form, which is the seed's rule too.
# `join`, the seed's `joined` (#104): a nested guest array joins into the
# same string with the same separator, and a nil element refuses as
# interpolating one does.
def joined_guest(values, separator)
  rendered = values.map do |value|
    panic("nil has no method 'to_s' — handle the nil case first") if value.nil?
    plain_array?(value) ? joined_guest(value, separator) : render(value)
  end
  rendered.join(separator)
end

def render(value)
  return "nil" if value.nil?
  return render_inspect(value) if value.failure?
  return value_at(value, 1) if value in ["__symbol__", *]
  return render_inspect(value) if value in ["__struct__", *] | ["__enum_case__", *]
  # A collection's `to_s` is its `inspect` (ADR 0060), as Ruby's.
  return render_inspect(value) if plain_array?(value) || (value in Hash)
  "#{value}"
end

# The seed's inspect: what `p` shows — strings with their quotes, symbols
# with their colons, and hash pairs written the way they would be typed,
# shorthand for identifier-shaped symbol keys and the rocket for the rest.
def render_inspect(value)
  return "nil" if value.nil?
  return "failure(#{render_inspect(failure_payload(value))})" if value.failure?
  return symbol_source(value_at(value, 1)) if value in ["__symbol__", *]
  if value in ["__enum_case__", *]
    labels = value_at(value, 2).map { "#{it[0]}: #{render_inspect(value_at(it, 1))}" }
    return "#{symbol_source(value_at(value, 1))}(#{labels.join(", ")})"
  end
  if value in ["__struct__", *]
    fields = value_at(value, 2).map { "#{it[0]}: #{render_inspect(value_at(it, 1))}" }
    return "#{value_at(value, 1)}(#{fields.join(", ")})"
  end
  if plain_array?(value)
    rendered = value.map { render_inspect(it) }
    return "[" + rendered.join(", ") + "]"
  end
  if value in Hash
    mutable pairs = []
    value.each do |key, entry|
      pairs << rendered_pair(key, entry)
    end
    return "{" + pairs.join(", ") + "}"
  end
  return encode_string(value) if value in String
  "#{value}"
end

# `to_s`, rendering: nil keeps the host's refusal — absence has no methods,
# `to_s` included (ADR 0006) — and everything else takes the seed's Display.
def rendered_to_s(receiver)
  return receiver.to_s if receiver.nil?
  render(receiver)
end

# `to_s` at the dispatch: bare renders; with a base it rides the host,
# bounds refusal included.
def to_s_of(receiver, arguments)
  return rendered_to_s(receiver) if arguments.empty?
  receiver.to_s(value_at(arguments, 0))
end

# `dig`, one step at a time — each step is the host's own single-key dig, so
# a miss answers nil, a found nil short-circuits, and a non-hash mid-chain
# refuses with the host's wording.
def dig_into(receiver, keys)
  # Each step rides the host's own two-step dig from a one-element array,
  # so a value that cannot be dug into mid-chain refuses in the host's
  # words (`Integer does not have #dig method`), not as a missing method.
  value = [receiver].dig(0, keys.first)
  rest = keys.slice(1, keys.length - 1)
  return value if rest.empty?
  return nil if value.nil?
  dig_into(value, rest)
end

# The two-arity ends and counts: bare rides the maybe-answering builtin,
# counted rides the array-answering one, both the host's.
def first_of(receiver, arguments)
  return receiver.first if arguments.empty?
  receiver.first(value_at(arguments, 0))
end

def last_of(receiver, arguments)
  return receiver.last if arguments.empty?
  receiver.last(value_at(arguments, 0))
end

# `values_at` takes any number of positions (#104); each rides the host's
# alone, and flat_map joins their answers — one level, so an element that
# is itself an array stays whole.
# `flatten` to a depth, the seed's `flattened_to_depth`, opening only guest
# arrays: a tagged shape stays whole. A negative depth opens them all.
def flatten_guest(values, depth)
  return values if depth == 0
  values.flat_map do |value|
    plain_array?(value) ? flatten_guest(value, depth - 1) : [value]
  end
end

def values_at_of(receiver, arguments)
  arguments.flat_map { |position| receiver.values_at(position) }
end

def count_of(receiver, arguments)
  return receiver.count if arguments.empty?
  receiver.count(value_at(arguments, 0))
end

# One hash pair, written the way it would be typed (ADR 0023 §1).
def rendered_pair(key, entry)
  if key in ["__symbol__", *]
    name = value_at(key, 1)
    return "#{name}: #{render_inspect(entry)}" if identifier_shaped?(name)
  end
  "#{render_inspect(key)} => #{render_inspect(entry)}"
end

# The seed's array rule: a negative index counts from the end, the position
# one past the end appends, and anything further out refuses — the original
# index in the message, not the normalized one.
def updated_array(current, index, value, name)
  position = if index < 0
    current.length + index
  else
    index
  end
  return current + [value] if position == current.length
  panic("index #{index} out of range for assignment to #{name}") if position < 0 || position > current.length
  mutable rebuilt = []
  mutable cursor = 0
  current.each do |element|
    rebuilt << if cursor == position
      value
    else
      element
    end
    cursor += 1
  end
  rebuilt
end

# The words of a `%w[...]` or `%i[...]` body — Ruby's rules (ADR 0030),
# matching the seed's `word_array_words`. A backslash before the literal's
# own delimiter (ADR 0051: the pair it opened with), a backslash, or
# whitespace drops away (escaped whitespace joins a word instead of
# splitting); before anything else it stays. Whitespace runs split once and
# never produce empties. The seed asks Unicode what whitespace is where this
# asks the three separators a Portland string can spell — carriage return
# has no escape here, on purpose — the recorded divergence class no
# literally-written program has met.
def word_array_elements(lexeme)
  opener = lexeme.slice(2, 1)
  closer = lexeme.slice(lexeme.length - 1, 1)
  content = lexeme.slice(3, lexeme.length - 4)
  characters = content.chars
  mutable words = []
  mutable current = ""
  mutable started = false
  mutable index = 0
  while index < characters.length
    character = characters[index]
    index += 1
    if character == "\\" && index < characters.length
      escaped = characters[index]
      index += 1
      unless escaped == opener || escaped == closer || escaped == "\\" || word_separator?(escaped)
        current << "\\"
      end
      current << escaped
      started = true
    elsif word_separator?(character)
      if started
        words << current
        current = ""
        started = false
      end
    else
      current << character
      started = true
    end
  end
  words << current if started
  words
end

def word_separator?(character)
  character == " " || character == "\t" || character == "\n"
end

# `%i[...]`: the same words, each a symbol (ADR 0051).
def symbol_array_elements(lexeme) = word_array_elements(lexeme).map { ["__symbol__", it] }

def evaluate_index(node, bindings)
  receiver_step = evaluate_expression(node.receiver, bindings)
  index_step = evaluate_expression(node.index, receiver_step.bindings)
  receiver = slot_value(receiver_step.value)
  # A symbol indexes its name, answering text (#112), the seed's arm.
  return outcome([value_at(receiver, 1)[slot_value(index_step.value)]], index_step.bindings) if receiver in ["__symbol__", *]
  # A struct's fields are names only (ADR 0062) — the seed's sentences.
  if receiver in ["__struct__", *]
    key = slot_value(index_step.value)
    struct_name = value_at(receiver, 1)
    if key in ["__symbol__", *]
      panic("a #{struct_name} is read by its field names, not indexed — write '.#{value_at(key, 1)}', or 'to_h[name]' for a name decided at runtime")
    end
    if key in String
      panic("a #{struct_name} is read by its field names, not indexed — write '.#{key}', or 'to_h[name]' for a name decided at runtime")
    end
    if key in Integer
      panic("a #{struct_name} is read by its field names, not by position — write the field, or 'to_a[#{key}]'")
    end
    panic("a #{struct_name} is read by its field names, not indexed with #{render_inspect(key)}")
  end

  outcome([receiver[slot_value(index_step.value)]], index_step.bindings)
end

# Guest struct instances are tagged arrays: ["__struct__", name, pairs].
# `Array.new` and `Integer.sqrt` (ADR 0058), riding the seed's own for the
# shapes it answers: `Integer.sqrt` whole, so its wordings reach here, and
# `Array.new` by count, count and fill, or array. The block form counts on
# the host and hands each index to the guest block.
def evaluate_builtin_type_function(node, mutable bindings)
  mutable arguments = []
  node.arguments.each do |argument|
    step = evaluate_expression(argument, bindings)
    bindings = step.bindings
    arguments << slot_value(step.value)
  end
  type_name = node.receiver.name
  if type_name == "Integer" && node.name == "sqrt"
    panic("Integer.sqrt takes 1 argument, got #{arguments.length}") unless arguments.length == 1
    return outcome([Integer.sqrt(value_at(arguments, 0))], bindings)
  end
  # The floor's first member (ADR 0068): the guest's arguments, bound by the
  # driver that started it, since the host's own are the driver's.
  if type_name == "System" && node.name == "arguments"
    panic("System.arguments takes 0 arguments, got #{arguments.length}") unless arguments.empty?
    return outcome([arguments_of(bindings)], bindings)
  end
  # One whole file as a string, or a failure (ADR 0027) — the host's own
  # crossing answers both, and both are plain values the guest can hold.
  if type_name == "System" && node.name == "read_file"
    panic("System.read_file takes 1 argument, got #{arguments.length}") unless arguments.length == 1
    path = value_at(arguments, 0)
    panic("System.read_file takes a String, got #{render_inspect(path)}") unless path in String
    return outcome([System.read_file(path)], bindings)
  end
  # The whole file replaced, answering the bytes written as Ruby's
  # `File.write` does, or a failure — again the host's own crossing.
  if type_name == "System" && node.name == "write_file"
    panic("System.write_file takes 2 arguments, got #{arguments.length}") unless arguments.length == 2
    path = value_at(arguments, 0)
    content = value_at(arguments, 1)
    unless (path in String) && (content in String)
      panic("System.write_file takes two Strings, got #{render_inspect(path)} and #{render_inspect(content)}")
    end
    return outcome([System.write_file(path, content)], bindings)
  end
  # The two standard streams, text as given, answering the bytes written —
  # the host's own crossings, so a guest's stdout is the host's stdout.
  if type_name == "System" && (node.name == "write_standard_output" || node.name == "write_standard_error")
    panic("System.#{node.name} takes 1 argument, got #{arguments.length}") unless arguments.length == 1
    text = value_at(arguments, 0)
    panic("System.#{node.name} takes a String, got #{render_inspect(text)}") unless text in String
    return outcome([System.write_standard_output(text)], bindings) if node.name == "write_standard_output"
    return outcome([System.write_standard_error(text)], bindings)
  end
  # The two clocks, whole nanoseconds — the host's own reading.
  if type_name == "System" && (node.name == "wall_clock_time" || node.name == "monotonic_time")
    panic("System.#{node.name} takes 0 arguments, got #{arguments.length}") unless arguments.empty?
    return outcome([System.wall_clock_time], bindings) if node.name == "wall_clock_time"
    return outcome([System.monotonic_time], bindings)
  end
  # Bytes from the kernel's random source, as integers 0–255.
  if type_name == "System" && node.name == "entropy"
    panic("System.entropy takes 1 argument, got #{arguments.length}") unless arguments.length == 1
    count = value_at(arguments, 0)
    panic("System.entropy takes an Integer, got #{render_inspect(count)}") unless count in Integer
    panic("System.entropy takes a byte count of 0 or more, got #{count}") if count < 0
    return outcome([System.entropy(count)], bindings)
  end
  # Content added at the file's end, answering the bytes written, or a failure.
  if type_name == "System" && node.name == "append_file"
    panic("System.append_file takes 2 arguments, got #{arguments.length}") unless arguments.length == 2
    path = value_at(arguments, 0)
    content = value_at(arguments, 1)
    unless (path in String) && (content in String)
      panic("System.append_file takes two Strings, got #{render_inspect(path)} and #{render_inspect(content)}")
    end
    return outcome([System.append_file(path, content)], bindings)
  end
  panic("System has no #{node.name}") if type_name == "System"
  return evaluate_array_new(node, arguments, bindings) if type_name == "Array" && node.name == "new"
  # `Hash.new` (ADR 0063): the empty hash; a default value or block refuses
  # naming the or-guard — the seed's sentences.
  if type_name == "Hash" && node.name == "new"
    if node.block.some?
      panic("'Hash.new { }' gives a hash a default, which Portland does not have — a lookup answers a maybe; write 'hash[key] or fallback'")
    end
    return outcome([{}], bindings) if arguments.empty?
    if arguments.length == 1
      shown = render_inspect(value_at(arguments, 0))
      panic("'Hash.new(#{shown})' gives a hash a default, which Portland does not have — a lookup answers a maybe; write 'hash[key] or #{shown}'")
    end
    panic("Hash.new takes no arguments, got #{arguments.length}")
  end
  return outcome([range_new(arguments)], bindings) if type_name == "Range" && node.name == "new"
  # `Random.new(seed)` (ADR 0065): the host's generator, Ruby's MT19937.
  if type_name == "Random" && node.name == "new"
    return outcome([arguments.empty? ? Random.new : Random.new(value_at(arguments, 0))], bindings)
  end
  panic("#{type_name} has no #{node.name}")
end

# `Range.new(first, last)` and `Range.new(first, last, true)` (#111, ADR
# 0058): the literal's two spellings as a function; either end may be nil.
# Ends of any other kind wait on ranges over other orderables (#149).
def range_new(arguments)
  panic("Range.new takes 2 or 3 arguments, got #{arguments.length}") unless arguments.length == 2 || arguments.length == 3
  exclusive = arguments.length == 3 ? value_at(arguments, 2) : false
  panic("Range.new takes true or false for exclusive, got #{render_inspect(exclusive)}") unless exclusive in Boolean
  arguments.slice(0, 2).each do |end_value|
    next if end_value.nil? || (end_value in Integer)
    panic("Range.new takes integer ends here, got #{render_inspect(end_value)} — ranges over other orderables are undecided (#149)")
  end
  build_range(value_at(arguments, 0), value_at(arguments, 1), exclusive)
end

def evaluate_array_new(node, arguments, mutable bindings)
  return outcome([Array.new], bindings) if arguments.empty?
  panic("Array.new takes 0 to 2 arguments, got #{arguments.length}") if arguments.length > 2
  count = value_at(arguments, 0)
  unless (count in Integer) || plain_array?(count)
    panic("Array.new takes a count or an array, got #{render_inspect(count)}")
  end
  if node.block.some?
    panic("Array.new takes a fill or a block, not both") if arguments.length == 2
    entry = bindings
    mutable scope = bindings
    mutable interrupt = nil
    built = Array.new(count) do |index|
      step = run_guest_block(node.block, [index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    return outcome([built], scope)
  end
  built = if arguments.length == 2 then Array.new(count, value_at(arguments, 1)) else Array.new(count) end
  outcome([built], bindings)
end

def evaluate_new(node, mutable bindings)
  # A struct name is bare (resolved outward) or a `::` path (absolute).
  written = if node.receiver in PathNode
    node.receiver.parts.join("::")
  else
    node.receiver.name
  end
  slot = if node.receiver in PathNode
    lookup(bindings, written)
  else
    resolve(bindings, written)
  end
  if slot.empty?
    # `Thread.new`, `Object.new` (#135): the rewrite, not a missing struct.
    retired = retired_sentence(written)
    panic(retired) unless retired.nil?
    puts "evaluator: undefined struct #{written}"
    return outcome([], bindings)
  end
  # A defined `new` replaces the raw constructor everywhere (ADR 0031):
  # while it runs, `fields(...)` is the raw layer, and only there — the
  # marker dies at every other call boundary.
  new_slot = lookup(bindings, "#{slot.first[0]}::new")
  if !new_slot.empty? && new_slot.first[1] == "method"
    mutable arguments = []
    mutable keyword_values = []
    node.arguments.each do |argument|
      if argument in KeywordArgumentNode
        step = evaluate_expression(argument.value, bindings)
        bindings = step.bindings
        keyword_values << [argument.label, slot_value(step.value)]
      else
        step = evaluate_expression(argument, bindings)
        bindings = step.bindings
        arguments += step.value
      end
    end
    check_call_count("#{slot.first[0]}::new", value_at(new_slot.first[2], 0), arguments.length)
    return invoke_with_block(new_slot.first[2], arguments, keyword_values, nil, slot.first[0], bindings)
  end
  fields = value_at(slot.first[2], 0)
  mutable provided = []
  node.arguments.each do |argument|
    step = evaluate_expression(argument.value, bindings)
    bindings = step.bindings
    provided << [argument.label, slot_value(step.value)]
  end
  mutable ordered = []
  fields.each do |field|
    mutable index = 0
    while index < provided.length
      ordered << [field, value_at(provided[index], 1)] if provided[index][0] == field
      index += 1
    end
  end
  outcome([["__struct__", slot.first[0], ordered]], bindings)
end

# `:paid(on: "tuesday")` — a guest enum case, tagged like a guest struct.
def evaluate_enum_case(node, mutable bindings)
  check_payload_labels(node, bindings)
  mutable payload = []
  node.payload.each do |argument|
    step = evaluate_expression(argument.value, bindings)
    bindings = step.bindings
    payload << [argument.label, slot_value(step.value)]
  end
  outcome([["__enum_case__", node.name, payload]], bindings)
end

# `with` builds an updated copy of a guest struct (#27): the fields keep
# their order, replaced labels take the new value.
def struct_with(instance, keyword_values)
  mutable updated = []
  pairs = instance[2]
  mutable index = 0
  while index < pairs.length
    field = pairs[index][0]
    mutable value = value_at(pairs[index], 1)
    mutable replacement_index = 0
    while replacement_index < keyword_values.length
      value = value_at(keyword_values[replacement_index], 1) if keyword_values[replacement_index][0] == field
      replacement_index += 1
    end
    updated << [field, value]
    index += 1
  end
  ["__struct__", value_at(instance, 1), updated]
end

# `product` (#104): every way to take one element from each array in
# turn, the host's arm folded over the arguments one array at a time.
def product_of(elements, others)
  mutable combined = elements.map { [it] }
  others.each do |other|
    panic("no implicit conversion of #{type_at(builtin_type_of(other), 0).capitalize} into Array") unless plain_array?(other)
    combined = combined.flat_map { |prefix| other.map { |choice| prefix + [choice] } }
  end
  combined
end

# Ruby's binary search (#104, #111) over `count` positions, the element at
# each read from `values` — a host array, or a range's start plus the
# position: the block answering true, false, or nil finds the first
# position it accepts; answering a number finds a position it calls zero,
# a negative sending the search left. Answers [position or nil, scope,
# interrupt] so the caller can thread the block's rebindings.
def binary_search(values, count, ranged, block, entry, mutable scope)
  mutable low = 0
  mutable high = count
  mutable satisfied = false
  mutable found = nil
  mutable interrupt = nil
  while low < high && found.nil? && interrupt.nil?
    middle = low + (high - low) / 2
    element = ranged ? values.begin + middle : values[middle]
    step = run_guest_block(block, [element], scope)
    scope = compacted_since(entry, step.bindings)
    if step.signal != "none"
      interrupt = step
    else
      verdict = step.value.empty? ? nil : slot_value(step.value)
      smaller = if verdict == true
        satisfied = true
        true
      elsif verdict == false || verdict.nil?
        false
      elsif (verdict in Integer) || (builtin_type_of(verdict).nil? && !(verdict in ["__struct__", *] | ["__symbol__", *] | ["__enum_case__", *]))
        # The host's patterns cannot name a float, so a value the table
        # cannot name and no tag claims is one.
        found = middle if verdict == 0
        verdict < 0
      else
        panic("wrong argument type #{type_at(builtin_type_of(verdict), 0).capitalize} (must be numeric, true, false or nil)")
      end
      if smaller
        high = middle
      else
        low = middle + 1
      end
    end
  end
  found = low if found.nil? && satisfied && interrupt.nil?
  [found, scope, interrupt]
end

# A struct's own method called with a block (#110): the method's scope as
# invoke_struct_method builds it, plus the block in the `__block__` slot
# for its `yield` to reach; what the block rebound comes back to the
# caller the way a top-level def's does.
def invoke_struct_method_with_block(receiver, method, arguments, block, bindings)
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  scope = [["__self__", "local", receiver]] + scope
  pairs = value_at(receiver, 2)
  pairs.each do |pair|
    scope = [[pair[0], "local", value_at(pair, 1)]] + scope
  end
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  scope = [["__block__", "block", [block, bindings]]] + scope
  check_call_count("#{value_at(receiver, 1)} method", method.parameters, arguments.length)
  scope = bind_parameters(method.parameters, arguments, [], scope)
  result = run_body(method.body, scope)
  panic("break outside of a loop") if result.signal == "break"
  panic("next outside of a loop") if result.signal == "next"
  after = scope_after_yield(result.bindings, bindings)
  if result.signal == "return" && result.target.some? && result.target < depth
    return return_outcome(result.value, after, result.target)
  end
  outcome(result.value, after)
end

def struct_has_field?(instance, field)
  pairs = value_at(instance, 2)
  pairs.any? { it[0] == field }
end

# The fields in order, as Ruby's Struct views them (#114): to_h, to_a and
# values, members, size and length. Nil for any other name.
def struct_view(instance, name)
  pairs = value_at(instance, 2)
  case name
  when "to_h"
    mutable built = {}
    pairs.each { |pair| built[["__symbol__", pair[0]]] = value_at(pair, 1) }
    built
  when "to_a", "values" then pairs.map { value_at(it, 1) }
  when "members" then pairs.map { ["__symbol__", it[0]] }
  when "size", "length" then pairs.length
  else nil
  end
end

def struct_field(instance, field)
  pairs = instance[2]
  mutable index = 0
  while index < pairs.length
    return value_at(pairs[index], 1) if pairs[index][0] == field
    index += 1
  end
  # A miss is the seed's sentence (ADR 0047 shape 2's runtime row, #90):
  # the value shown, its struct with the article, the name in quotes.
  # Reached only where the checker could not see the receiver's type — a
  # known struct refuses at build first. A removed Ruby method names its
  # rewrite (#135); Ruby's Struct lookups by a runtime name name theirs
  # (ADR 0062).
  if %w[dig values_at deconstruct_keys].include?(field)
    panic("'#{field}' is not a #{value_at(instance, 1)}'s — its fields are read by their bare names; for a name decided at runtime, write 'to_h.#{field}'")
  end
  retired = retired_sentence(field)
  panic(retired) unless retired.nil?
  panic("#{shorten(render_inspect(instance))} is #{a_type(["struct", value_at(instance, 1)])}, which has no method #{spelled(field)}")
end

def evaluate_self(bindings)
  slot = lookup(bindings, "__self__")
  panic("self only exists inside a struct method") if slot.empty?
  outcome([value_at(slot.first, 2)], bindings)
end

# The struct method `method_name` for a tagged-array instance, if any.
# The struct-shape test is a pattern — the compiler's first type predicate.
# A failure is checked first because patterns are failure-transparent
# (ADR 0027): the shape test would see through the wrapper, but a failure
# has no methods beyond its predicate — the sad path stays opaque.
def struct_method_for(receiver, method_name, bindings)
  return nil if receiver.failure?
  return nil unless receiver in ["__struct__", *]
  slot = lookup(bindings, value_at(receiver, 1))
  return nil if slot.empty?
  methods = value_at(slot.first[2], 1)
  return nil if methods.nil?
  mutable found = nil
  methods.each do |method|
    found = method if method.name == method_name
  end
  found
end

# Run one struct method: globals + self + the receiver's fields, then
# parameters (#27).
def invoke_struct_method(receiver, method, arguments, keyword_values, bindings)
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  scope = [["__self__", "local", receiver]] + scope
  mutable pair_index = 0
  pairs = value_at(receiver, 2)
  while pair_index < pairs.length
    pair = pairs[pair_index]
    scope = [[pair[0], "local", value_at(pair, 1)]] + scope
    pair_index += 1
  end
  # This frame's depth, for `return` to aim at (ADR 0025).
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  check_call_count("#{value_at(receiver, 1)} method", method.parameters, arguments.length)
  scope = bind_parameters(method.parameters, arguments, keyword_values, scope)
  result = run_body(method.body, scope)
  panic("break outside of a loop") if result.signal == "break"
  panic("next outside of a loop") if result.signal == "next"
  if result.signal == "return" && result.target.some? && result.target < depth
    return return_outcome(result.value, bindings, result.target)
  end
  outcome(result.value, bindings)
end

# Guest receivers are host values, so host method dispatch does the work.
def evaluate_method_call(node, mutable bindings)
  # The builtin types carry Ruby's type functions (ADR 0058): the name is
  # not a value, and a struct or local wearing it wins, as everywhere.
  if (node.receiver in IdentifierNode) && %w[Array Hash Integer Random Range System].include?(node.receiver.name) && resolve(bindings, node.receiver.name).empty?
    return evaluate_builtin_type_function(node, bindings)
  end
  if node.name == "new" && ((node.receiver in IdentifierNode) || (node.receiver in PathNode))
    return evaluate_new(node, bindings)
  end
  # `Token.of(...)` — a type function (ADR 0031): the receiver names a
  # struct, and the function lives under its namespace. A local wearing the
  # name wins first, as everywhere.
  if (node.receiver in IdentifierNode) || (node.receiver in PathNode)
    receiver_name = if node.receiver in PathNode
      node.receiver.parts.join("::")
    else
      node.receiver.name
    end
    struct_slot = if node.receiver in PathNode
      lookup(bindings, receiver_name)
    else
      resolve(bindings, receiver_name)
    end
    if !struct_slot.empty? && struct_slot.first[1] == "struct"
      function_slot = lookup(bindings, "#{struct_slot.first[0]}::#{node.name}")
      if !function_slot.empty? && function_slot.first[1] == "method"
        mutable arguments = []
        mutable keyword_values = []
        node.arguments.each do |argument|
          if argument in KeywordArgumentNode
            step = evaluate_expression(argument.value, bindings)
            bindings = step.bindings
            keyword_values << [argument.label, slot_value(step.value)]
          else
            step = evaluate_expression(argument, bindings)
            bindings = step.bindings
            arguments += step.value
          end
        end
        check_call_count("#{struct_slot.first[0]}::#{node.name}", value_at(function_slot.first[2], 0), arguments.length)
        return invoke_with_block(function_slot.first[2], arguments, keyword_values, nil, nil, bindings)
      end
    end
  end
  # `Statistics.mean(x)` — the receiver names a namespace, so this invokes
  # a function inside it rather than dispatching on a value (ADR 0021).
  if (node.receiver in IdentifierNode) && lookup(bindings, node.receiver.name).empty?
    found = namespace_for(bindings, node.receiver.name)
    unless found.nil?
      return evaluate_call(call_node("#{found}::#{node.name}", node.arguments), bindings)
    end
  end
  if node.receiver in PathNode
    written = node.receiver.parts.join("::")
    if namespace?(bindings, written)
      return evaluate_call(call_node("#{written}::#{node.name}", node.arguments), bindings)
    end
  end
  step = evaluate_expression(node.receiver, bindings)
  mutable receiver = slot_value(step.value)
  bindings = step.bindings
  # `&.`: an absent receiver short-circuits; arguments never run.
  if (node in SafeMethodCallNode) && receiver.nil?
    return outcome([nil], bindings)
  end
  mutable arguments = []
  mutable keyword_values = []
  node.arguments.each do |argument|
    if argument in KeywordArgumentNode
      argument_step = evaluate_expression(argument.value, bindings)
      bindings = argument_step.bindings
      keyword_values << [argument.label, slot_value(argument_step.value)]
    else
      argument_step = evaluate_expression(argument, bindings)
      bindings = argument_step.bindings
      arguments += argument_step.value
    end
  end
  return evaluate_block_call(node, receiver, arguments, bindings) if node.block.some?
  # `sample(random:)` and `shuffle(random:)` (ADR 0065): the one keyword a
  # builtin takes, handed to the host's own.
  if plain_array?(receiver) && %w[sample shuffle].include?(node.name) && !keyword_values.empty?
    keyword_values.each do |pair|
      panic("'#{node.name}' takes one keyword, random:, got #{pair[0]}:") unless pair[0] == "random"
    end
    source = value_at(keyword_values.first, 1)
    panic("'random:' takes a Random, got #{render_inspect(source)}") unless source in Random
    drawn = if node.name == "shuffle"
      receiver.shuffle(random: source)
    elsif arguments.empty?
      receiver.sample(random: source)
    else
      receiver.sample(value_at(arguments, 0), random: source)
    end
    return outcome([drawn], bindings)
  end
  # `with` copies-and-updates before any dispatch, like the seed (#27).
  if node.name == "with" && (receiver in ["__struct__", *])
    return outcome([struct_with(receiver, keyword_values)], bindings)
  end
  # Struct methods dispatch before builtins and field access (#27).
  own = struct_method_for(receiver, node.name, bindings)
  return invoke_struct_method(receiver, own, arguments, keyword_values, bindings) unless own.nil?
  # A struct answers its own field before any builtin arm can — the seed's
  # order: `with`, its methods, its fields, then only the four names every
  # value answers. A guest struct is a tagged host array, so `size` on one
  # used to answer 3 (#96). A name that is neither is the miss sentence.
  # An Enumerable struct (#110) answers Ruby's Enumerable through its own
  # `each`: the elements it yields, then the array's arm below — after its
  # own methods and fields, before the Struct views.
  if (receiver in ["__struct__", *]) && enumerable_name?(node.name) && struct_enumerable?(receiver, bindings) && !struct_has_field?(receiver, node.name)
    receiver = enumerable_elements(receiver, bindings)
  end
  if (receiver in ["__struct__", *]) && arguments.empty? && node.block.nil? && !%w[failure? nil? some? to_s].include?(node.name)
    return outcome([struct_field(receiver, node.name)], bindings) if struct_has_field?(receiver, node.name)
    # Ruby's Struct views (#114), after the fields so a field named `size`
    # still wins, as Ruby's accessor does.
    view = struct_view(receiver, node.name)
    return outcome([view], bindings) unless view.nil?
    return outcome([struct_field(receiver, node.name)], bindings)
  end
  # `between?` and `clamp` on a struct order by its `<=>` (ADR 0054); host
  # values reach the host's own arms below.
  if (receiver in ["__struct__", *]) && %w[between? clamp].include?(node.name) && arguments.length == 2
    return outcome([ordered_answer(node.name, receiver, arguments, bindings)], bindings)
  end
  # A symbol answers Ruby's text queries about its name (#112), the seed's
  # arm: a guest symbol is a tagged host array, so its name answers instead.
  if (receiver in ["__symbol__", *]) && %w[empty? end_with? id2name length name size slice start_with?].include?(node.name)
    check_builtin_count(receiver, node.name, arguments.length)
    return outcome([symbol_text_answer(value_at(receiver, 1), node.name, arguments)], bindings)
  end
  # A builtin called with the wrong count says so before any host arm can
  # fail on a missing argument with the wrong words (#88).
  check_builtin_count(receiver, node.name, arguments.length)
  result = case node.name
  when "nil?" then receiver.nil?
  when "some?" then receiver.some?
  # `eql?` is universal (ADR 0059): the host's own, which on a guest's
  # tagged shapes is element by element, as the seed's is.
  when "eql?" then receiver.eql?(value_at(arguments, 0))
  # The failure predicate rides the host like its presence siblings —
  # before ADR 0044 it was reachable only through `!`, so this arm was a
  # green-but-never-covered hosted gap.
  when "failure?" then receiver.failure?
  # `to_s` renders (#39); the nil refusal stays the host's, reached below
  # when a tagless receiver has no `to_s` of its own.
  when "to_s" then to_s_of(receiver, arguments)
  when "rotate" then arguments.empty? ? receiver.rotate : receiver.rotate(value_at(arguments, 0))
  # Ruby's combinatorics (#104) ride the host's arms; `product` takes any
  # number of arrays, folded one at a time; a count-less `cycle` refuses.
  when "combination" then receiver.combination(value_at(arguments, 0))
  when "repeated_combination" then receiver.repeated_combination(value_at(arguments, 0))
  when "permutation" then arguments.empty? ? receiver.permutation : receiver.permutation(value_at(arguments, 0))
  when "repeated_permutation" then receiver.repeated_permutation(value_at(arguments, 0))
  when "product" then product_of(receiver, arguments)
  when "cycle" then receiver.cycle(value_at(arguments, 0))
  when "bsearch", "bsearch_index" then panic("#{node.name} needs a block — there are no enumerators to hand back")
  when "values_at" then values_at_of(receiver, arguments)
  when "at" then receiver.at(value_at(arguments, 0))
  when "assoc" then receiver.assoc(value_at(arguments, 0))
  when "rassoc" then receiver.rassoc(value_at(arguments, 0))
  when "transpose" then receiver.transpose
  when "to_h" then receiver.to_h
  # Set arithmetic by eql? (#104), any number of arrays folded one at a
  # time: each step is the host's, and the fold keeps its order.
  when "difference" then arguments.reduce(receiver) { |kept, other| kept.difference(other) }
  when "union" then arguments.reduce(receiver.union) { |joined, other| joined.union(other) }
  when "intersection" then arguments.reduce(receiver.intersection) { |kept, other| kept.intersection(other) }
  when "intersect?" then receiver.intersect?(value_at(arguments, 0))
  when "take" then receiver.take(value_at(arguments, 0))
  when "drop" then receiver.drop(value_at(arguments, 0))
  when "gcd" then receiver.gcd(value_at(arguments, 0))
  # Ruby's bit math as named methods (ADR 0003, #157): the host's own.
  when "bit_and" then receiver.bit_and(value_at(arguments, 0))
  when "bit_or" then receiver.bit_or(value_at(arguments, 0))
  when "bit_xor" then receiver.bit_xor(value_at(arguments, 0))
  when "bit_not" then receiver.bit_not
  when "shift_left" then receiver.shift_left(value_at(arguments, 0))
  when "shift_right" then receiver.shift_right(value_at(arguments, 0))
  when "allbits?" then receiver.allbits?(value_at(arguments, 0))
  when "anybits?" then receiver.anybits?(value_at(arguments, 0))
  when "nobits?" then receiver.nobits?(value_at(arguments, 0))
  when "bit_length" then receiver.bit_length
  when "bit_count" then receiver.bit_count
  # A generator's draws and seed, and the ambient sample and shuffle (ADR
  # 0064): the host's, so a seeded sequence is Ruby's.
  when "rand" then arguments.empty? ? receiver.rand : receiver.rand(value_at(arguments, 0))
  when "seed" then receiver.seed
  when "shuffle" then receiver.shuffle
  when "sample" then arguments.empty? ? receiver.sample : receiver.sample(value_at(arguments, 0))
  when "lcm" then receiver.lcm(value_at(arguments, 0))
  when "digits" then arguments.empty? ? receiver.digits : receiver.digits(value_at(arguments, 0))
  when "gcdlcm" then receiver.gcdlcm(value_at(arguments, 0))
  # `to_i` by Ruby's rule (ADR 0061), with a base — the host's own.
  when "to_i" then arguments.empty? ? receiver.to_i : receiver.to_i(value_at(arguments, 0))
  # Twins ride their survivor's builtin (ADR 0036); `member?` rides the
  # host twin because its survivor depends on the receiver's type.
  # `size` asks the host by its own name: an Integer answers it (its
  # machine width, #107) but has no `length`.
  when "length" then receiver.length
  when "size" then receiver.size
  when "ord" then receiver.ord
  when "empty?" then receiver.empty?
  # Ruby's string methods, first run (#106), each riding the seed's.
  when "center" then arguments.length == 2 ? receiver.center(value_at(arguments, 0), value_at(arguments, 1)) : receiver.center(value_at(arguments, 0))
  when "ljust" then arguments.length == 2 ? receiver.ljust(value_at(arguments, 0), value_at(arguments, 1)) : receiver.ljust(value_at(arguments, 0))
  when "rjust" then arguments.length == 2 ? receiver.rjust(value_at(arguments, 0), value_at(arguments, 1)) : receiver.rjust(value_at(arguments, 0))
  when "chop" then receiver.chop
  when "chr" then receiver.chr
  when "delete_prefix" then receiver.delete_prefix(value_at(arguments, 0))
  when "delete_suffix" then receiver.delete_suffix(value_at(arguments, 0))
  when "partition" then receiver.partition(value_at(arguments, 0))
  when "rpartition" then receiver.rpartition(value_at(arguments, 0))
  when "rindex" then arguments.length == 2 ? receiver.rindex(value_at(arguments, 0), value_at(arguments, 1)) : receiver.rindex(value_at(arguments, 0))
  when "casecmp" then receiver.casecmp(value_at(arguments, 0))
  when "casecmp?" then receiver.casecmp?(value_at(arguments, 0))
  when "codepoints" then receiver.codepoints
  when "bytes" then receiver.bytes
  when "bytesize" then receiver.bytesize
  when "hex" then receiver.hex
  when "oct" then receiver.oct
  when "sub" then receiver.sub(value_at(arguments, 0), value_at(arguments, 1))
  when "gsub" then receiver.gsub(value_at(arguments, 0), value_at(arguments, 1))
  when "upcase" then receiver.upcase
  when "downcase" then receiver.downcase
  # The trimmers, the case moves, and the line splitter ride the host.
  when "strip" then receiver.strip
  when "lstrip" then receiver.lstrip
  when "rstrip" then receiver.rstrip
  when "chomp" then receiver.chomp
  when "capitalize" then receiver.capitalize
  when "swapcase" then receiver.swapcase
  when "lines" then receiver.lines
  when "reverse" then receiver.reverse
  when "chars" then receiver.chars
  when "grapheme_clusters" then receiver.chars
  when "abs", "magnitude" then receiver.abs
  # The neighbors ride the host's builtins, synonyms kept on purpose (#79).
  # `next` is `succ`'s third spelling; riding `succ` keeps this source free
  # of the keyword-after-dot form its own parser only just learned.
  when "succ" then receiver.succ
  when "next" then receiver.succ
  when "pred" then receiver.pred
  # `pow` is `**`'s named twin (ADR 0033), one arity, the host's edges.
  when "pow" then receiver ** value_at(arguments, 0)
  # Ruby's named division (ADR 0018, #108) rides the host's.
  when "fdiv" then receiver.fdiv(value_at(arguments, 0))
  when "quo" then receiver.quo(value_at(arguments, 0))
  when "modulo" then receiver % value_at(arguments, 0)
  when "divmod" then receiver.divmod(value_at(arguments, 0))
  when "div" then receiver.div(value_at(arguments, 0))
  when "remainder" then receiver.remainder(value_at(arguments, 0))
  when "ceildiv" then receiver.ceildiv(value_at(arguments, 0))
  when "even?" then receiver.even?
  when "odd?" then receiver.odd?
  when "zero?" then receiver.zero?
  # The float predicates and the rounding family ride the host's builtins.
  when "nan?" then receiver.nan?
  when "finite?" then receiver.finite?
  when "infinite?" then receiver.infinite?
  # Without a block, the finished walk (ADR 0055, #107).
  when "times" then receiver.times
  when "upto" then receiver.upto(value_at(arguments, 0))
  when "downto" then receiver.downto(value_at(arguments, 0))
  when "next_float" then receiver.next_float
  when "prev_float" then receiver.prev_float
  # An Integer takes a precision too (#107).
  when "floor" then arguments.empty? ? receiver.floor : receiver.floor(value_at(arguments, 0))
  when "ceil" then arguments.empty? ? receiver.ceil : receiver.ceil(value_at(arguments, 0))
  when "round" then arguments.empty? ? receiver.round : receiver.round(value_at(arguments, 0))
  when "truncate" then arguments.empty? ? receiver.truncate : receiver.truncate(value_at(arguments, 0))
  when "positive?" then receiver.positive?
  when "negative?" then receiver.negative?
  when "keys" then receiver.keys
  when "merge" then receiver.merge(value_at(arguments, 0))
  when "dig" then dig_into(receiver, arguments)
  when "to_a", "entries" then receiver.to_a
  when "values" then receiver.values
  when "key?", "has_key?" then receiver.key?(value_at(arguments, 0))
  when "member?" then receiver.member?(value_at(arguments, 0))
  when "first" then first_of(receiver, arguments)
  when "last" then last_of(receiver, arguments)
  when "uniq" then receiver.uniq
  when "tally" then receiver.tally
  when "zip" then receiver.zip(value_at(arguments, 0))
  when "each_slice" then receiver.each_slice(value_at(arguments, 0))
  when "each_cons" then receiver.each_cons(value_at(arguments, 0))
  # Guest-aware (#105): a guest symbol, struct, or enum case is a tagged
  # array here, which the host's flatten would open. An array flattens all
  # the way bare; a hash lays its pairs out one level, deeper on request.
  when "flatten"
    depth = if arguments.empty? then (receiver in Hash) ? 1 : -1 else value_at(arguments, 0) end
    flatten_guest((receiver in Hash) ? receiver.to_a : receiver, depth)
  when "compact" then receiver.compact
  when "count" then count_of(receiver, arguments)
  when "index", "find_index" then receiver.index(value_at(arguments, 0))
  when "rindex" then receiver.rindex(value_at(arguments, 0))
  when "sum" then arguments.empty? ? receiver.sum : receiver.sum(value_at(arguments, 0))
  when "sort" then sorted_values(receiver, bindings)
  when "min" then extreme_value(receiver, "min", bindings)
  when "minmax" then [extreme_value(receiver, "min", bindings), extreme_value(receiver, "max", bindings)]
  when "max" then extreme_value(receiver, "max", bindings)
  when "between?" then receiver.between?(value_at(arguments, 0), value_at(arguments, 1))
  # One range for both bounds (#101), or the two bounds.
  when "clamp" then arguments.length == 1 ? receiver.clamp(value_at(arguments, 0)) : receiver.clamp(value_at(arguments, 0), value_at(arguments, 1))
  # A range steps by a stride; an integer steps to a limit, by one or by a
  # stride (#109) — the host answers both.
  when "step" then arguments.length == 2 ? receiver.step(value_at(arguments, 0), value_at(arguments, 1)) : receiver.step(value_at(arguments, 0))
  when "to_f" then receiver.to_f
  # `join` shows each element the way `to_s` would (#39), the seed's rule.
  # No separator, or a nil one, joins with nothing between (#142, #104).
  when "join"
    separator = value_at(arguments, 0)
    joined_guest(receiver, separator.nil? ? "" : separator)
  when "include?" then receiver.include?(value_at(arguments, 0))
  # Ruby's rules, the seed's `ruby_split` (#142): the host answers, so the
  # arguments pass through as written.
  when "split"
    case arguments.length
    when 0 then receiver.split
    when 1 then receiver.split(value_at(arguments, 0))
    else receiver.split(arguments[0], arguments[1])
    end
  # Any number of candidates, one at a time (#106).
  when "start_with?" then arguments.any? { |prefix| receiver.start_with?(prefix) }
  when "end_with?" then arguments.any? { |suffix| receiver.end_with?(suffix) }
  # A hash's slice takes any number of keys (#105), folded one at a time
  # in the order given; an array's takes a start and a length.
  when "slice"
    if receiver in Hash
      arguments.reduce({}) { |kept, key| kept.merge(receiver.slice(key)) }
    else
      receiver.slice(arguments[0], arguments[1])
    end
  when "except" then arguments.reduce(receiver) { |kept, key| kept.except(key) }
  when "invert" then receiver.invert
  # A range's own answers (#111), the seed's.
  when "exclude_end?" then receiver.exclude_end?
  when "begin" then receiver.begin
  when "end" then receiver.end
  when "cover?" then receiver.cover?(value_at(arguments, 0))
  when "overlap?" then receiver.overlap?(value_at(arguments, 0))
  # Bare `any?` on a hash asks whether it holds a pair (#105); with a
  # pattern (ADR 0065), the predicates, grep, and the slices ask the
  # host's `when` rule — a range covers, anything else asks `==`.
  when "any?" then arguments.empty? ? receiver.any? : receiver.any?(value_at(arguments, 0))
  when "all?" then receiver.all?(value_at(arguments, 0))
  when "none?" then receiver.none?(value_at(arguments, 0))
  when "one?" then receiver.one?(value_at(arguments, 0))
  when "grep" then receiver.grep(value_at(arguments, 0))
  when "grep_v" then receiver.grep_v(value_at(arguments, 0))
  when "slice_before" then receiver.slice_before(value_at(arguments, 0))
  when "slice_after" then receiver.slice_after(value_at(arguments, 0))
  when "has_value?", "value?" then receiver.has_value?(value_at(arguments, 0))
  when "key" then receiver.key(value_at(arguments, 0))
  # Ruby's implicit-conversion protocol names are false aliases (ADR 0036,
  # revised): the refusal names the real conversion, the host's words.
  when "to_ary" then panic("to_ary is spelled to_a here")
  when "to_int" then panic("to_int is spelled to_i here")
  when "to_str" then panic("to_str is spelled to_s here")
  else
    # Anything else is a struct field read. On a non-struct that used to
    # index and fail with an unrelated message — `7.positive?` reported
    # "cannot index Integer(7) with Integer(2)" — which is how nine missing
    # methods stayed hidden. Say what actually happened instead.
    unless receiver in ["__struct__", *]
      # The table (#88) says which: a name no builtin of this type answers
      # is the seed's sentence (ADR 0047 shape 2's runtime row); a name the
      # seed answers is a builtin this evaluator has not learned, said so.
      refuse_missing_builtin(receiver, node.name)
      panic("no method #{node.name} on this value — the compiler may be missing a builtin the seed has")
    end
    struct_field(receiver, node.name)
  end
  outcome([result], bindings)
end

# What a block rebound flows back to the caller; what it named itself does
# not. ADR 0001 licenses the accumulator pattern, so `count += 1` inside a
# block has to outlive the block, while the block's parameters and its fresh
# locals have to die at end.
#
# The bindings list is prepend-only, so everything the block added sits in
# front of the scope it was handed — and the added entries worth keeping are
# exactly those whose name the caller already had. A new name is the block's
# own; a name already out there is a rebinding of it.
def flow_back(bindings, scope, block_bindings)
  mutable result = bindings
  # Newest first, so walk the added entries back to front: the last one
  # prepended ends up in front, where lookup finds it.
  mutable index = block_bindings.length - scope.length - 1
  while index >= 0
    triple = block_bindings[index]
    result = [triple] + result unless lookup(bindings, triple[0]).empty?
    index -= 1
  end
  result
end

# The seed's argument count, byte for byte (#91): positional parameters up
# to the first default are required and all of them the total; keyword
# parameters stand outside it. `label` is the seed's own subject — the
# def's name, or `Token method`. Reached only where the checker could not
# see the def (a struct's method, a def from a required file); a top-level
# def's bare call refuses at build first.
def check_call_count(label, parameters, given)
  positional = parameters.reject { it in KeywordParameterNode }
  mutable required = 0
  mutable counting = true
  positional.each do |parameter|
    counting = false if (parameter in AssignmentNode) && parameter.value.some?
    required += 1 if counting
  end
  total = positional.length
  return if given >= required && given <= total
  expected = if required == total then required.to_s else "#{required} to #{total}" end
  panic("#{label} expects #{expected} #{arguments_word(expected)}, got #{given}")
end

# A block refuses only when it names more parameters than it is handed —
# the seed's rule; extra arguments are dropped. The implicit `it` is not
# counted: the parser finds it by a flat token scan that cannot tell an
# inner block's `it` from the outer's (principle 4), so an outer block can
# wear an `it` it never uses, and refusing on that would refuse the seed's
# own spec suite.
# Ruby's spread (ADR 0057): a block of two or more parameters handed
# exactly one guest array binds them from its elements, extras dropped; an
# array too short refuses where Ruby would nil-fill, in the seed's words.
def spread_for_block(parameters, arguments)
  return arguments if parameters.length < 2 || arguments.length != 1
  single = value_at(arguments, 0)
  return arguments unless plain_array?(single)
  if single.length < parameters.length
    word = single.length == 1 ? "element" : "elements"
    panic("block expects #{parameters.length} arguments — #{render_inspect(single)} has #{single.length} #{word} to spread")
  end
  single.take(parameters.length)
end

def check_block_count(parameters, given)
  return if parameters == ["it"]
  return unless parameters.length > given
  expected = parameters.length.to_s
  panic("block expects #{expected} #{arguments_word(expected)}, got #{given}")
end

def arguments_word(expected) = if expected == "1" then "argument" else "arguments" end

# The builtin table's type for a host value (#88), or nil for a value it
# does not cover — a struct, a symbol's tagged array, a range or float the
# host patterns cannot name yet — which declines both checks below.
def builtin_type_of(value)
  return ["string"] if value in String
  return ["integer"] if value in Integer
  return ["boolean"] if value in Boolean
  return ["hash", ["unknown"], ["unknown"]] if value in Hash
  return ["array", ["unknown"]] if plain_array?(value)
  return ["random"] if value in Random
  nil
end

# A real builtin called with a count outside its arity: the sentence
# ratified 2026-09-23, the seed's (#88).
def check_builtin_count(receiver, name, given)
  type = builtin_type_of(receiver)
  return if type.nil?
  arity = builtin_arity(type, name)
  return if arity.nil?
  low = value_at(arity, 0)
  high = value_at(arity, 1)
  return if given >= low && given <= high
  expected = if low == high then low.to_s else "#{low} to #{high}" end
  panic("#{spelled(name)} takes #{expected} #{arguments_word(expected)}, got #{given}")
end

# A name no builtin of the receiver's type answers: ADR 0047 shape 2's
# runtime row, the seed's sentence. A name the seed does answer falls
# through to the caller's honest "not learned yet" sentence.
def refuse_missing_builtin(receiver, name)
  type = builtin_type_of(receiver)
  return if type.nil?
  methods = builtin_methods(type)
  return if methods.include?(name)
  # A removed Ruby method names its rewrite (#135).
  retired = retired_sentence(name)
  panic(retired) unless retired.nil?
  runtime_name = type_at(type, 0).capitalize
  panic("#{shorten(render_inspect(receiver))} is #{article(runtime_name)} #{runtime_name}, which has no method #{spelled(name)}")
end

# Blocks see the enclosing scope; parameters are prepended for the call.
#
# The bindings handed back are at the *caller's* level, already flowed back —
# so every call site can thread `result.bindings` on without knowing which of
# the names inside belonged to the block.
def run_guest_block(block, handed, bindings)
  arguments = spread_for_block(block.parameters, handed)
  check_block_count(block.parameters, arguments.length)
  mutable scope = bindings
  mutable index = 0
  block.parameters.each do |parameter|
    if index < arguments.length
      # Named parameters shadow-and-restore, which is legal; a method's name
      # is not shadowable, and `it` colliding with a local is confusing
      # rather than merely shadowing (ADR 0017). The seed's wordings (#45).
      slot = lookup(scope, parameter)
      taken_by_method = (!slot.empty? && slot.first[1] == "method") || builtin_method?(parameter)
      panic("block parameter #{parameter} shadows method #{parameter} — rename one") if taken_by_method
      if parameter == "it" && !slot.empty? && (slot.first[1] == "local" || slot.first[1] == "mutable")
        panic("`it` is a local here and a block parameter there — rename one")
      end
      scope = [[parameter, "local", value_at(arguments, index)]] + scope
    end
    index += 1
  end
  result = run_body(block.body, scope)
  # `next` ends just this invocation of the block; `break` and `return` stay
  # for the iterating caller to handle — the seed's rule (#41, #42).
  signal = if result.signal == "next"
    "none"
  else
    result.signal
  end
  Outcome.new(value: result.value, bindings: flow_back(bindings, scope, result.bindings), signal: signal, target: result.target)
end

# After a block interrupted its iteration: a `break` is consumed here and the
# call produces nil (ADR 0012); a `return` keeps unwinding to the enclosing
# method (#41, #42). The seed's block_interrupt, in outcome clothing.
def block_interrupted(step, scope)
  return outcome([nil], scope) if step.signal == "break"
  return_outcome(step.value, scope, step.target)
end

# Every arm threads `scope` across its iterations, so what one pass of the
# block rebound is visible to the next and to the caller afterward — the
# accumulator pattern, which is why `scope` is rebound rather than `bindings`
# read repeatedly. The host block doing the rebinding is itself relying on
# the same rule one level down, in the seed.
# Every arm watches for a signal after each pass (#41, #42): a `break` or a
# `return` stops the host iteration right there — the host `break` below is
# doing for the compiler what `block_interrupt` does for the seed — and
# `block_interrupted` decides what the interrupted call answers. The arm
# repetition is deliberate; the host `break` has to live inside each host
# block to stop it.
def evaluate_block_call(node, receiver, arguments, mutable scope)
  # Each pass's rebindings flow back as fresh shadows, so the pass boundary
  # compacts them the way a while iteration does (#62) — dead triples from
  # earlier passes drop, everything at or below this call's entry stays.
  entry = scope
  block = node.block
  mutable interrupt = nil
  # A pattern beside a block refuses (ADR 0066) rather than letting one
  # silently win — the seed's sentence.
  if %w[all? any? none? one? slice_before slice_after].include?(node.name) && !arguments.empty? && (plain_array?(receiver) || (receiver in Hash) || (receiver in Range))
    panic("'#{node.name}' takes a pattern or a block, not both")
  end
  # A struct's own method takes the block first (#110), as the seed's
  # dispatch order has it; its `yield` reaches the block.
  own = struct_method_for(receiver, node.name, scope)
  return invoke_struct_method_with_block(receiver, own, arguments, block, scope) unless own.nil?
  # An Enumerable struct (#110) walks through its own `each`: the elements
  # it yields, then the array's arm.
  if (receiver in ["__struct__", *]) && enumerable_name?(node.name) && struct_enumerable?(receiver, scope)
    walked = evaluate_block_call(node, enumerable_elements(receiver, scope), arguments, scope)
    # The walks that answer their receiver answer the struct, as Ruby's
    # Enumerable does — not the gathered array.
    return walked unless walked.signal == "none" && %w[each_with_index reverse_each].include?(node.name)
    return outcome([receiver], walked.bindings)
  end
  # Ruby's Struct walks (#114): each over the values, each_pair over symbol
  # and value, select and filter answering an array, and to_h through a
  # block answering a pair — the refusals Ruby's words.
  if receiver in ["__struct__", *]
    pairs = value_at(receiver, 2)
    case node.name
    when "each"
      pairs.each do |pair|
        step = run_guest_block(block, [value_at(pair, 1)], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
      return block_interrupted(interrupt, scope) if interrupt.some?
      return outcome([receiver], scope)
    when "each_pair"
      pairs.each do |pair|
        step = run_guest_block(block, [["__symbol__", pair[0]], value_at(pair, 1)], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
      return block_interrupted(interrupt, scope) if interrupt.some?
      return outcome([receiver], scope)
    when "select", "filter"
      values = pairs.map { value_at(it, 1) }
      results = values.select do |value|
        step = run_guest_block(block, [value], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
      return block_interrupted(interrupt, scope) if interrupt.some?
      return outcome([results], scope)
    when "to_h"
      mutable built = {}
      pairs.each do |pair|
        step = run_guest_block(block, [["__symbol__", pair[0]], value_at(pair, 1)], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        answer = slot_value(step.value)
        unless plain_array?(answer)
          kind = builtin_type_of(answer)
          label = kind.nil? ? value_at(answer, 1) : type_at(kind, 0).capitalize
          panic("wrong element type #{label} (expected array)")
        end
        panic("element has wrong array length (expected 2, was #{answer.length})") unless answer.length == 2
        built[value_at(answer, 0)] = value_at(answer, 1)
      end
      return block_interrupted(interrupt, scope) if interrupt.some?
      return outcome([built], scope)
    end
  end
  # Ruby's combinatorics with a block (#104): the host's arrangements handed
  # over in turn, the array answered — nil for `cycle`, as Ruby's.
  # `cycle` is Enumerable's, so a hash walks it as its pairs and a range as
  # its integers; the rest are the array's own.
  combinatoric = (receiver in Array) && %w[combination repeated_combination permutation repeated_permutation product cycle].include?(node.name)
  cycling = node.name == "cycle" && !(receiver in String) && !(receiver in Integer) && !(receiver in Boolean) && !(receiver in ["__struct__", *] | ["__symbol__", *] | ["__enum_case__", *])
  if combinatoric || cycling
    # A cycle with no count never ends; the table's arity (`cycle/1&`)
    # refuses it before this arm, with the seed's sentence.
    check_builtin_count(receiver, node.name, arguments.length)
    elements = (receiver in Array) ? receiver : receiver.to_a
    arrangements = case node.name
    when "combination" then elements.combination(value_at(arguments, 0))
    when "repeated_combination" then elements.repeated_combination(value_at(arguments, 0))
    when "permutation" then arguments.empty? ? elements.permutation : elements.permutation(value_at(arguments, 0))
    when "repeated_permutation" then elements.repeated_permutation(value_at(arguments, 0))
    when "product" then product_of(elements, arguments)
    else elements.cycle(value_at(arguments, 0))
    end
    arrangements.each do |arrangement|
      step = run_guest_block(block, [arrangement], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    return outcome([nil], scope) if node.name == "cycle"
    return outcome([receiver], scope)
  end
  # Binary search (#104, #111), over an array's elements or a bounded
  # range's integers.
  # The host's patterns cannot name a range, so what is not an array is
  # one: the seed answers these two names on arrays and ranges only.
  if %w[bsearch bsearch_index].include?(node.name) && !(receiver in String) && !(receiver in Hash)
    ranged = !(receiver in Array)
    count = if ranged
      panic("a range without both ends cannot be searched — give it a start and an end") if receiver.begin.nil? || receiver.end.nil?
      last = receiver.exclude_end? ? receiver.end - 1 : receiver.end
      [last - receiver.begin + 1, 0].max
    else
      receiver.length
    end
    searched = binary_search(receiver, count, ranged, block, entry, scope)
    scope = value_at(searched, 1)
    interrupted = value_at(searched, 2)
    return block_interrupted(interrupted, scope) unless interrupted.nil?
    position = value_at(searched, 0)
    return outcome([nil], scope) if position.nil?
    return outcome([position], scope) if node.name == "bsearch_index"
    return outcome([ranged ? receiver.begin + position : receiver[position]], scope)
  end
  case node.name
  when "each", "each_pair"
    # A hash yields its key and value as two arguments. An array yields
    # one, and a two-parameter guest block over it spreads in
    # run_guest_block (ADR 0057), which knows a guest symbol's host shape
    # from an array — the host's own `|first, second|` would not.
    if block.parameters.length == 2 && (receiver in Hash)
      receiver.each do |first, second|
        step = run_guest_block(block, [first, second], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    else
      receiver.each do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "map", "collect"
    results = receiver.map do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      # A valueless pass — a bare `next`, a trailing `puts` — has nothing to
      # collect, and the seed refuses rather than inventing a nil.
      panic("map block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # The leading run, or the rest after it (#104), riding the host's.
  when "take_while"
    results = receiver.take_while do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "drop_while"
    results = receiver.drop_while do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # A hash hands the block its key and value (#105), as `each` does.
  when "select", "filter"
    results = if receiver in Hash
      receiver.select do |key, value|
        step = run_guest_block(block, [key, value], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    else
      receiver.select do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # A hash's one-value walks (#105): each rides the host's by name, its
  # rebindings threaded through like every other walk's.
  # A string's walks (#106): characters, lines, and successors, each
  # answering the string.
  when "each_char", "each_grapheme_cluster"
    receiver.each_char do |character|
      step = run_guest_block(block, [character], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_byte"
    receiver.each_byte do |byte|
      step = run_guest_block(block, [byte], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_codepoint"
    receiver.each_codepoint do |codepoint|
      step = run_guest_block(block, [codepoint], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_line"
    receiver.each_line do |line|
      step = run_guest_block(block, [line], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  # `sub` and `gsub` with a block (#106): the pieces between the matches,
  # the block's answer at each joint — the first joint only for `sub`. An
  # empty pattern matches at every character boundary, so its pieces are the
  # characters with an empty piece at either end.
  when "sub", "gsub"
    pattern = value_at(arguments, 0)
    pieces = pattern.empty? ? [""] + receiver.chars + [""] : receiver.split(pattern, -1)
    mutable result = ""
    pieces.each_with_index do |piece, position|
      if position > 0 && (node.name == "gsub" || position == 1)
        step = run_guest_block(block, [pattern], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        panic("#{node.name} block produced no value") if step.value.empty?
        result = result + joined_guest([slot_value(step.value)], "")
      elsif position > 0
        result = result + pattern
      end
      result = result + piece
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "each_key"
    receiver.each_key do |key|
      step = run_guest_block(block, [key], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_value"
    receiver.each_value do |value|
      step = run_guest_block(block, [value], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "transform_keys"
    results = receiver.transform_keys do |key|
      step = run_guest_block(block, [key], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "transform_values"
    results = receiver.transform_values do |value|
      step = run_guest_block(block, [value], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # By its own name, since a hash's `find_all` answers its pairs as an
  # array where its `select` answers a hash (#105).
  when "find_all"
    results = receiver.find_all do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "reject"
    results = if receiver in Hash
      receiver.reject do |key, value|
        step = run_guest_block(block, [key, value], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    else
      receiver.reject do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "times"
    receiver.times do |index|
      step = run_guest_block(block, [index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  # Ruby's Numeric#step with a block (#109): the host's walk handed over
  # one value at a time, the receiver answered.
  when "step"
    walked = arguments.length == 2 ? receiver.step(value_at(arguments, 0), value_at(arguments, 1)) : receiver.step(value_at(arguments, 0))
    walked.each do |value|
      step = run_guest_block(block, [value], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "each_with_index"
    receiver.each_with_index do |element, index|
      step = run_guest_block(block, [element, index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  # The block's answers, summed as `sum` sums (#104): the host collects
  # them through `map`, then sums with the init, if any.
  when "sum"
    addends = receiver.map do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("sum block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    result = arguments.empty? ? addends.sum : addends.sum(value_at(arguments, 0))
    outcome([result], scope)
  when "reverse_each"
    receiver.reverse_each do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "rfind"
    result = receiver.rfind do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "to_h"
    result = if receiver in Hash
      receiver.to_h do |key, value|
        step = run_guest_block(block, [key, value], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    else
      receiver.to_h do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "each_index"
    receiver.each_index do |index|
      step = run_guest_block(block, [index], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "reduce", "inject"
    results = receiver.reduce(value_at(arguments, 0)) do |running, element|
      step = run_guest_block(block, [running, element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("reduce block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # An integer's or a string's `upto` (#106): the host walks by its own
  # rule for the receiver's kind, a string's second argument — exclusive —
  # handed through.
  when "upto"
    if arguments.length == 2
      receiver.upto(value_at(arguments, 0), value_at(arguments, 1)) do |number|
        step = run_guest_block(block, [number], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    else
      receiver.upto(value_at(arguments, 0)) do |number|
        step = run_guest_block(block, [number], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "downto"
    receiver.downto(value_at(arguments, 0)) do |number|
      step = run_guest_block(block, [number], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([receiver], scope)
  when "any?"
    result = receiver.any? do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "all?"
    result = receiver.all? do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "none?"
    result = receiver.none? do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  # Where a true-or-false block first says true (#104), riding the host's
  # by name so a refusal quotes the method written.
  when "index", "find_index"
    result = receiver.find_index do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "rindex"
    result = receiver.rindex do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "find", "detect"
    result = receiver.find do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "sort_by"
    results = receiver.sort_by do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("sort_by block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # A comparator block (#99): the host sorts, and picks `min`/`max`, by the
  # guest block's answers, refusing a non-integer in its own words. What
  # the block rebinds carries from one comparison to the next, in the
  # order the host asks them (#104). A recorded gap (principle 4): a
  # `break` or `return` inside it stays inside the comparison here, where
  # the seed carries it out.
  when "sort"
    result = receiver.sort do |left, right|
      step = run_guest_block(block, [left, right], scope)
      scope = compacted_since(entry, step.bindings)
      slot_value(step.value)
    end
    outcome([result], scope)
  when "min"
    result = receiver.min do |left, right|
      step = run_guest_block(block, [left, right], scope)
      scope = compacted_since(entry, step.bindings)
      slot_value(step.value)
    end
    outcome([result], scope)
  when "max"
    result = receiver.max do |left, right|
      step = run_guest_block(block, [left, right], scope)
      scope = compacted_since(entry, step.bindings)
      slot_value(step.value)
    end
    outcome([result], scope)
  when "minmax"
    result = receiver.minmax do |left, right|
      step = run_guest_block(block, [left, right], scope)
      scope = compacted_since(entry, step.bindings)
      slot_value(step.value)
    end
    outcome([result], scope)
  # The kept and the rest (#104), and exactly one true (#104), riding the
  # host's by name so a refusal quotes the method written.
  when "partition"
    results = receiver.partition do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "count"
    result = receiver.count do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  when "one?"
    result = receiver.one? do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([result], scope)
  # `min_by`/`max_by` (#99): the host compares the block's keys.
  when "min_by", "max_by"
    result = if node.name == "min_by"
      receiver.min_by do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        panic("min_by block produced no value") if step.value.empty?
        slot_value(step.value)
      end
    else
      receiver.max_by do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        panic("max_by block produced no value") if step.value.empty?
        slot_value(step.value)
      end
    end
    outcome([result], scope)
  # `grep` and `grep_v` with a block (ADR 0065): the host picks the matches,
  # the guest block answers for each. A pattern beside a block on the
  # predicates refuses rather than letting one silently win.
  when "grep", "grep_v"
    matched = node.name == "grep" ? receiver.grep(value_at(arguments, 0)) : receiver.grep_v(value_at(arguments, 0))
    results = matched.map do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("#{node.name} block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  # Ruby's Enumerable over runs and groups (#110), each riding the host's
  # own arm by name so a refusal quotes the method written; a hash walks
  # as its pairs. `chunk` is written out, since a guest symbol is a tagged
  # array the host's `chunk` would not know as `:_alone`.
  when "filter_map", "group_by", "chunk_while", "slice_when", "slice_before", "slice_after", "minmax_by"
    elements = (receiver in Hash) ? receiver.to_a : receiver
    results = case node.name
    when "filter_map"
      elements.filter_map do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        panic("filter_map block produced no value") if step.value.empty?
        slot_value(step.value)
      end
    when "group_by"
      elements.group_by do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        panic("group_by block produced no value") if step.value.empty?
        slot_value(step.value)
      end
    when "minmax_by"
      elements.minmax_by do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        panic("minmax_by block produced no value") if step.value.empty?
        slot_value(step.value)
      end
    when "chunk_while"
      elements.chunk_while do |left, right|
        step = run_guest_block(block, [left, right], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    when "slice_when"
      elements.slice_when do |left, right|
        step = run_guest_block(block, [left, right], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    when "slice_before"
      elements.slice_before do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    else
      elements.slice_after do |element|
        step = run_guest_block(block, [element], scope)
        scope = compacted_since(entry, step.bindings)
        if step.signal != "none"
          interrupt = step
          break
        end
        slot_value(step.value)
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  when "chunk"
    elements = (receiver in Hash) ? receiver.to_a : receiver
    mutable runs = []
    mutable open = false
    elements.each do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("chunk block produced no value") if step.value.empty?
      key = slot_value(step.value)
      if key.nil? || key == ["__symbol__", "_separator"]
        open = false
        next
      end
      if key == ["__symbol__", "_alone"]
        runs += [[key, [element]]]
        open = false
        next
      end
      if (key in ["__symbol__", *]) && value_at(key, 1).start_with?("_")
        panic("symbols beginning with an underscore are reserved")
      end
      if open && value_at(value_at(runs, runs.length - 1), 0) == key
        last = value_at(runs, runs.length - 1)
        runs = runs.take(runs.length - 1) + [[key, value_at(last, 1) + [element]]]
      else
        runs += [[key, [element]]]
        open = true
      end
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([runs], scope)
  when "flat_map", "collect_concat"
    results = receiver.flat_map do |element|
      step = run_guest_block(block, [element], scope)
      scope = compacted_since(entry, step.bindings)
      if step.signal != "none"
        interrupt = step
        break
      end
      panic("flat_map block produced no value") if step.value.empty?
      slot_value(step.value)
    end
    return block_interrupted(interrupt, scope) if interrupt.some?
    outcome([results], scope)
  else
    puts "evaluator: cannot evaluate block method #{node.name} yet"
    outcome([], scope)
  end
end

# Find a label among the supplied keyword arguments, else evaluate the
# parameter's default in the method scope. Missing required labels are the
# crude error story.
def keyword_value_for(keyword_values, parameter, scope)
  mutable index = 0
  while index < keyword_values.length
    pair = keyword_values[index]
    return value_at(pair, 1) if pair[0] == parameter.name
    index += 1
  end
  if parameter.default.nil?
    puts "evaluator: missing keyword argument #{parameter.name}"
    return nil
  end
  default = evaluate_expression(parameter.default, scope)
  slot_value(default.value)
end

# Bind parameters onto a scope, left to right so defaults can reference
# earlier ones.
def bind_parameters(parameters, arguments, keyword_values, mutable scope)
  mutable index = 0
  parameters.each do |parameter|
    if parameter in KeywordParameterNode
      value = keyword_value_for(keyword_values, parameter, scope)
      scope = [[parameter.name, "local", value]] + scope
    else
      value = if index < arguments.length
        value_at(arguments, index)
      else
        default = evaluate_expression(parameter.value, scope)
        slot_value(default.value)
      end
      # A parameter is a binding site (ADR 0001): `def f(mutable position)`
      # binds a rebindable name, everything else an immutable one (#45).
      kind = if (parameter in AssignmentNode) && parameter.rebindable
        "mutable"
      else
        "local"
      end
      scope = [[parameter.name, kind, value]] + scope
      index += 1
    end
  end
  scope
end

# Run a user method: fresh scope of methods only (no outer locals). The
# caller's bindings come back untouched — callee scope is discarded.
def invoke(payload, arguments, keyword_values, bindings)
  invoke_with_block(payload, arguments, keyword_values, nil, nil, bindings)
end

def invoke_with_block(payload, arguments, keyword_values, block, fields_target, bindings)
  parameters = payload[0]
  body = payload[1]
  # Everything global survives into the fresh scope; only locals drop —
  # the rebindable kind included, since a mutable is a local that moves,
  # and the `__fields__` marker, since `fields` is legal only inside
  # `def self.new` itself (ADR 0031), never in anything it calls.
  mutable scope = bindings.reject do |triple|
    triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"
  end
  # Bare names in the body resolve from where the method was written, not
  # from where it was called (ADR 0021).
  home = value_at(payload, 2)
  scope = [["__home__", "home", home]] + scope unless home.nil?
  # A `yield` inside the body reaches this. The caller's bindings travel with
  # it, because a block closes over where it was *written*: the method's own
  # scope has dropped every local, so yielding into it would hide them.
  scope = [["__block__", "block", [block, bindings]]] + scope unless block.nil?
  # This frame's depth, for `return` to aim at (ADR 0025). The caller's
  # `__frame__` survives the local-reject above; prepending shadows it.
  depth = frame_of(bindings) + 1
  scope = [["__frame__", "frame", depth]] + scope
  # While a defined `new` runs, `fields(...)` is its raw constructor
  # (ADR 0031); the marker rides the scope and dies at the next boundary.
  scope = [["__fields__", "fields", fields_target]] + scope unless fields_target.nil?
  scope = bind_parameters(parameters, arguments, keyword_values, scope)
  result = run_body(body, scope)
  # A `break` or `next` reaching a boundary escaped every loop that could
  # have owned it, and the seed refuses; so does this (#41, #42).
  panic("break outside of a loop") if result.signal == "break"
  panic("next outside of a loop") if result.signal == "next"
  # Callee locals are discarded, but a block the body yielded to may have
  # rebound names belonging to the caller, and those are the caller's.
  settled = if block.nil?
    bindings
  else
    scope_after_yield(result.bindings, bindings)
  end
  # A `return` is consumed here only when this frame is its write site (ADR
  # 0025); aimed further out, it keeps unwinding — through this method,
  # whose own result never happened.
  if result.signal == "return" && result.target.some? && result.target < depth
    return return_outcome(result.value, settled, result.target)
  end
  outcome(result.value, settled)
end

# `yield` — run the block the enclosing method was handed, with the values
# the yield hands it (#144), evaluated in the method's own scope first.
def evaluate_yield(node, mutable bindings)
  slot = lookup(bindings, "__block__")
  panic("yield without a block — this method was called without one") if slot.empty?

  mutable values = []
  node.values.each do |value|
    step = evaluate_expression(value, bindings)
    bindings = step.bindings
    values += step.value
  end
  handed = slot.first[2]
  block = value_at(handed, 0)
  written_in = value_at(handed, 1)
  # A gathering block (#110) keeps what it is handed — one value as itself,
  # several as an array, as Ruby's Enumerable packs them — and answers nil.
  if block == "__collector__"
    item = values.length == 1 ? value_at(values, 0) : values
    return Outcome.new(value: [nil], bindings: [["__block__", "block", ["__collector__", written_in + [item]]]] + bindings, signal: "none", target: nil)
  end
  result = run_guest_block(block, values, written_in)
  # What the block rebound belongs to the caller, and a method body has no
  # channel to its caller — so the updated caller scope rides home inside
  # `__block__`, which `invoke_with_block` unpacks on the way out. Rebinding
  # it here also keeps it present, so a second `yield` still finds a block.
  #
  # The signal rides along too (#41), target included: a `return` in the
  # block stops the yielding method's body at this statement and keeps its
  # aim on the block's writer (ADR 0025).
  Outcome.new(value: result.value, bindings: [["__block__", "block", [block, result.bindings]]] + bindings, signal: result.signal, target: result.target)
end

# The caller's scope as it stands after the body ran, which is whatever the
# last `yield` parked in `__block__` — or the untouched original, when the
# body never yielded at all.
def scope_after_yield(body_bindings, bindings)
  slot = lookup(body_bindings, "__block__")
  return bindings if slot.empty?
  value_at(slot.first[2], 1)
end

# — require_relative (ADR-free; matching the seed's rule) —
#
# The path resolves against the directory of the file doing the requiring,
# `.pdx` is implied when the name carries no extension of its own, and a file
# loads only once: a second require answers false and runs nothing. The loaded
# set and the current file both ride in the bindings, the same trick already
# used for `__self__`, `__home__` and `__block__`.
#
# One recorded divergence remains (principle 4 — a gap is written down, never
# silent): a missing file reports the host's read error rather than the seed's
# `require_relative "x": No such file or directory`.
#
# The other one — that the seed canonicalises a resolved path and the compiler
# could not, so `"helper"` and `"./helper"` loaded twice here and once there —
# is retired: `canonical_path` resolves the segments textually.

def file_of(bindings)
  slot = lookup(bindings, "__file__")
  return "." if slot.empty?
  value_at(slot.first, 2)
end

# The guest program's arguments, bound by its driver (`__arguments__`); a
# program nobody handed any has none.
def arguments_of(bindings)
  slot = lookup(bindings, "__arguments__")
  return [] if slot.empty?
  value_at(slot.first, 2)
end


# Where a require points, by the rule paths.pdx holds for the checker too.
def required_path(bindings, name) = required_path_from(file_of(bindings), name)

def loaded_paths(bindings)
  slot = lookup(bindings, "__loaded__")
  return [] if slot.empty?
  value_at(slot.first, 2)
end

def evaluate_require(name, bindings)
  target = required_path(bindings, name)
  return outcome([false], bindings) if loaded_paths(bindings).include?(target)

  # Marked loaded before the file runs, not after, so a file that requires
  # itself answers false the second time instead of recursing until the stack
  # gives out. The seed inserts before running for the same reason.
  loaded = [["__loaded__", "loaded", loaded_paths(bindings) + [target]]]
  # A required file gets the scope a method call gets (#95): everything
  # declared crosses, bare locals do not — in either direction. A require is
  # not a paste.
  scope = [["__file__", "file", target]] + loaded + bindings.reject { local?(it) }
  # `System.read_file` answers a failure (ADR 0027), which lets this refusal
  # wear the seed's wording — one recorded divergence retired. The message
  # names the *requested* path, as the seed's does.
  source = System.read_file(target) or panic "require_relative #{inspect(name)}: No such file or directory (os error 2)"
  result = run_body(parse_program(lex(source)), scope)
  # Everything the file declared stays in scope — that is the point of a
  # require. Its locals drop, the requirer's come back, and `__file__` is put
  # back so the rest of the requiring file resolves its own relative paths, not
  # the required file's.
  declared = result.bindings.reject { local?(it) }
  outcome([true], [["__file__", "file", file_of(bindings)]] + declared + bindings.select { local?(it) })
end

# A binding that belongs to one file or one frame: a local, the rebindable
# kind included, and the `__fields__` marker (ADR 0031).
def local?(triple) = triple[1] == "local" || triple[1] == "mutable" || triple[1] == "fields"

def evaluate_call(node, mutable bindings)
  mutable arguments = []
  mutable keyword_values = []
  node.arguments.each do |argument|
    if argument in KeywordArgumentNode
      step = evaluate_expression(argument.value, bindings)
      bindings = step.bindings
      keyword_values << [argument.label, slot_value(step.value)]
    else
      step = evaluate_expression(argument, bindings)
      bindings = step.bindings
      arguments += step.value
    end
  end
  # Inside a struct method, bare calls reach own methods first (#27).
  self_slot = lookup(bindings, "__self__")
  unless self_slot.empty?
    receiver = value_at(self_slot.first, 2)
    own = struct_method_for(receiver, node.name, bindings)
    return invoke_struct_method(receiver, own, arguments, keyword_values, bindings) unless own.nil?
  end
  # `fields(...)` — the raw constructor, and only inside `def self.new`
  # (ADR 0031). The name is unclaimable there: a program's own `fields`
  # function is refused rather than guessed at. The wordings are the seed's.
  if node.name == "fields"
    fields_slot = lookup(bindings, "__fields__")
    mutable function_slot = lookup(bindings, "fields")
    function_slot = resolve(bindings, "fields") if function_slot.empty?
    taken = !function_slot.empty? && function_slot.first[1] == "method"
    unless fields_slot.empty?
      panic("fields is the raw constructor inside def self.new — rename the fields function") if taken
      panic("fields takes keyword arguments, not positional ones") unless arguments.empty?
      target = value_at(fields_slot.first, 2)
      struct_slot = lookup(bindings, target)
      declared = value_at(struct_slot.first[2], 0)
      mutable ordered = []
      declared.each do |field|
        mutable index = 0
        while index < keyword_values.length
          ordered << [field, value_at(keyword_values[index], 1)] if keyword_values[index][0] == field
          index += 1
        end
      end
      return outcome([["__struct__", target, ordered]], bindings)
    end
    panic("`fields` is the raw constructor — it only exists inside def self.new") unless taken
  end
  mutable slot = lookup(bindings, node.name)
  slot = resolve(bindings, node.name) if slot.empty?
  if !slot.empty? && slot.first[1] == "method"
    check_call_count(node.name, value_at(slot.first[2], 0), arguments.length)
    return invoke_with_block(slot.first[2], arguments, keyword_values, node.block, nil, bindings)
  end
  case node.name
  # `puts` and `p` are a rendering and a newline over the floor's one
  # crossing to standard output (ADR 0068).
  when "puts"
    System.write_standard_output("\n") if arguments.empty?
    arguments.each do |argument|
      # The refusals come before the rendering, with the seed's wording.
      panic("puts got nil — handle the nil case first (p renders nil for debugging)") if argument.nil?
      panic("puts got a failure — handle the failure case first (p renders it for debugging)") if argument.failure?
      System.write_standard_output("#{render(argument)}\n")
    end
    outcome([], bindings)
  when "p"
    arguments.each do |argument|
      System.write_standard_output("#{render_inspect(argument)}\n")
    end
    outcome(arguments, bindings)
  when "some"
    outcome([some(slot_value(arguments))], bindings)
  when "failure"
    # Absence with a reason (ADR 0027); the host box carries the guest value.
    outcome([failure(slot_value(arguments))], bindings)
  when "inspect"
    # `p` without the printing (ADR 0026); the host builtin answers the
    # untagged shapes, and render_inspect already speaks for the tagged ones.
    outcome([render_inspect(slot_value(arguments))], bindings)
  when "require_relative"
    evaluate_require(slot_value(arguments), bindings)
  # The ambient generator (ADR 0065): the host's own `rand` and `srand`.
  when "rand" then outcome([arguments.empty? ? rand : rand(value_at(arguments, 0))], bindings)
  when "srand" then outcome([arguments.empty? ? srand : srand(value_at(arguments, 0))], bindings)
  when "panic"
    panic(slot_value(arguments))
  else
    # The seed's sentence, and a failure rather than a debug line (#98) —
    # reached only where the checker could not judge the name, a struct's
    # method body or a module's. A removed Ruby spelling names its rewrite
    # (#135).
    panic(retired_sentence(node.name) or "#{spelled(node.name)} is not defined")
  end
end
