# The intermediate-representation dump (#446): a program inside the native
# slice as the code generator will read it — one line per function, local,
# and statement, each value an S-expression. A program outside the slice
# refuses, naming what it met.
#
# Usage: pdx compiler/intermediate.pdx some_file.pdx

require_relative "intermediate_representation"

path = System.arguments.first or panic "intermediate.pdx: needs a file to lower"
source = System.read_file(path) or panic "intermediate.pdx: cannot read #{path}"
render_intermediate(lower_program(parse_program(lex(source)))).each { puts it }
