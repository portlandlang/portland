# Dump the token stream of a Portland file, one token per line.
#
# Usage: pdx compiler/tokenize.pdx <file.pdx>

require_relative "lexer"

path = System.arguments.first or panic "tokenize.pdx: needs a file to tokenize"
source = System.read_file(path) or panic "tokenize.pdx: cannot read #{path}"
lex(source).each do |token|
  puts "#{token.kind} #{token.text}"
end
