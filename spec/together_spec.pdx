# `together` (ADR 0029): independence declared, failure held, nothing
# shared. Serial today, and only the promised semantics are pinned here, so
# these examples survive the parallel build unchanged.

require_relative "spec_helper"

def fetch_user(id)
  "user-#{id}"
end

def recent_orders(id)
  return failure("orders down") if id == 0
  ["order-a", "order-b"]
end

context "a together block" do
  describe "the join" do
    specify "binds every task name after end, both marker spellings" do
      together do
        ~ user = fetch_user(7)
        meanwhile orders = recent_orders(7)
      end
      expect(user).to(eq("user-7"))
      expect(orders).to(have_length(2))
    end

    specify "interleaves plain lines, whose locals die at end" do
      together do
        greeting = "hello"
        ~ note = "#{7} looked up"
      end
      expect(note).to(eq("7 looked up"))
    end
  end

  describe "a failed task" do
    specify "binds its failure like any value" do
      together do
        ~ sad_orders = recent_orders(0)
      end
      expect(sad_orders).to(be_failure)
    end

    specify "which is one or away from a fallback, after the join" do
      together do
        ~ sad_orders = recent_orders(0)
      end
      expect((sad_orders or "no orders today")).to(eq("no orders today"))
    end

    specify "while its siblings run to completion" do
      together do
        ~ sad_orders = recent_orders(0)
        ~ user = fetch_user(7)
      end
      expect(sad_orders).to(be_failure)
      expect(user).to(eq("user-7"))
    end
  end
end
