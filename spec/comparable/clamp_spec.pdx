# `Comparable#clamp` with two bounds (ADR 0054).
#
# From ruby/spec core/comparable/clamp_spec.rb, the two-argument half. Ruby's
# `should.equal?` asks identity; Portland values have none, and a struct is
# equal field by field, so these ask `==`. What stays behind: bounds given
# backwards refuse rather than raise (a spec never refuses — the seed's unit
# tests and a two-oracle test pin it); nil as either bound (no ambient nil);
# and the range-argument forms, `clamp(1..3)` with its endless and beginless
# variants, which are not built (#101).

require_relative "../spec_helper"

struct Weird
  value

  include Comparable

  def <=>(other) = value <=> other.value
end

context "Comparable" do
  describe "#clamp" do
    one = Weird.new(value: 1)
    two = Weird.new(value: 2)
    three = Weird.new(value: 3)

    specify "returns self if within the given parameters" do
      c = Weird.new(value: 2)
      expect(c.clamp(one, two)).to eq(c)
      expect(c.clamp(two, two)).to eq(c)
      expect(c.clamp(one, three)).to eq(c)
      expect(c.clamp(two, three)).to eq(c)
    end

    specify "returns the min parameter if less than it" do
      expect(Weird.new(value: 0).clamp(one, two)).to eq(one)
    end

    specify "returns the max parameter if greater than it" do
      expect(Weird.new(value: 3).clamp(one, two)).to eq(two)
    end

    specify "works on the builtin orderables too" do
      expect(5.clamp(1, 9)).to eq(5)
      expect(0.clamp(1, 9)).to eq(1)
      expect(2.5.clamp(1, 2)).to eq(2)
      expect("m".clamp("a", "f")).to eq("f")
    end
  end

  # One range for both bounds (#101). Ranges hold integers (ADR 0019), so
  # upstream's struct ranges wait; a number clamps by an integer range, as
  # Ruby 4.0.7 answers.
  describe "#clamp with a range" do
    specify "clamps a number between the range's ends" do
      expect(5.clamp(1..3)).to eq(3)
      expect(0.clamp(1..3)).to eq(1)
      expect(2.clamp(1..3)).to eq(2)
      expect(2.5.clamp(1..3)).to eq(2.5)
      expect(7.5.clamp(1..3)).to eq(3)
    end

    specify "clamps one side only for an endless or beginless range" do
      expect(5.clamp(1..)).to eq(5)
      expect(0.clamp(1..)).to eq(1)
      expect(5.clamp(..3)).to eq(3)
      expect(0.clamp(..3)).to eq(0)
      expect(5.clamp(1...)).to eq(5)
    end
  end
end
