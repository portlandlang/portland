# What a match answers (ADR 0086): Ruby's MatchData reading API —
# `[]`, `captures`, `named_captures`, `names`, `pre_match`, `post_match`,
# `begin`, `end`, `offset`, `match`, `match_length`, `to_a`, `to_s`,
# `values_at`, `size`, `length`, `string`, `regexp`, `inspect`, `==` —
# positions counted in graphemes (ADR 0038).
#
# From ruby/spec core/matchdata/*. Upstream: `[start, length]` and the
# range forms of `[]` and `values_at`, `deconstruct` and `deconstruct_keys`
# (`case/in` on a match waits for a pull), the byte-offset family, `dup`,
# `hash`, `allocate`, `integer_at` (Ruby 4.1), the mocks and `to_int`
# coercions, the encoding rows, `frozen?`, and `$~` after `gsub`.

require_relative "../spec_helper"

context "MatchData#[]" do
  specify "acts as normal array indexing [index]" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md[0]).to eq("HX1138")
    expect(md[1]).to eq("H")
    expect(md[2]).to eq("X")
    expect(md[-3]).to eq("X")
    expect(md[10000]).to be_nil
    expect(md[-10000]).to be_nil
  end

  specify "returns the corresponding named match when given a Symbol" do
    md = "haystack".match(/(?<t>t(?<a>ack))/) or panic("no match")
    expect(md[:a]).to eq("ack")
    expect(md[:t]).to eq("tack")
  end

  specify "returns the corresponding named match when given a String" do
    md = "haystack".match(/(?<t>t(?<a>ack))/) or panic("no match")
    expect(md["a"]).to eq("ack")
    expect(md["t"]).to eq("tack")
  end

  specify "answers nil for a group that took no part" do
    md = /(a)(b)?/.match("a") or panic("no match")
    expect(md[2]).to be_nil
  end
end

context "MatchData#begin" do
  specify "returns the character offset of the start of the nth element" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.begin(0)).to eq(1)
    expect(md.begin(2)).to eq(2)
  end

  specify "returns nil when the nth match isn't found" do
    md = /something is( not)? (right)/.match("something is right") or panic("no match")
    expect(md.begin(1)).to be_nil
  end

  specify "returns the character offset for multi-byte strings" do
    md = /(.)(.)(\d+)(\d)/.match("TñX1138.") or panic("no match")
    expect(md.begin(0)).to eq(1)
    expect(md.begin(2)).to eq(2)
  end

  specify "returns the character offset of the start of a named capture" do
    md = /(?<a>.)(.)(?<b>\d+)(\d)/.match("TñX1138.") or panic("no match")
    expect(md.begin("a")).to eq(1)
    expect(md.begin(:b)).to eq(3)
  end
end

context "MatchData#end" do
  specify "returns the character offset of the end of the nth element" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.end(0)).to eq(7)
    expect(md.end(2)).to eq(3)
  end

  specify "returns nil when the nth match isn't found" do
    md = /something is( not)? (right)/.match("something is right") or panic("no match")
    expect(md.end(1)).to be_nil
  end

  specify "returns the character offset for multi-byte strings and named captures" do
    md = /(?<a>.)(.)(?<b>\d+)(\d)/.match("TñX1138.") or panic("no match")
    expect(md.end(0)).to eq(7)
    expect(md.end("a")).to eq(2)
    expect(md.end("b")).to eq(6)
  end

  specify "returns the character offset for the farthest match when multiple named captures use the same name" do
    md = /(?<a>.)(.)(?<a>\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.end("a")).to eq(6)
  end
end

context "MatchData#offset" do
  specify "returns beginning and ending character offset of the whole match for 0" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.offset(0)).to eq([1, 7])
  end

  specify "returns the offsets of the nth group" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.offset(2)).to eq([2, 3])
    expect(md.offset(3)).to eq([3, 6])
    expect(md.offset(4)).to eq([6, 7])
  end

  specify "accepts a String or a Symbol as a reference to a named capture" do
    md = /(?<f>foo)(?<b>bar)/.match("foobar") or panic("no match")
    expect(md.offset("f")).to eq([0, 3])
    expect(md.offset(:b)).to eq([3, 6])
  end

  specify "returns [nil, nil] if a capturing group is optional and doesn't match" do
    md = /(?<x>q..)?/.match("foobarbaz") or panic("no match")
    expect(md.offset("x")).to eq([nil, nil])
    expect(md.offset(1)).to eq([nil, nil])
  end

  specify "returns correct offsets for multi-byte strings" do
    md = /\Aあ(.)(.)?(.)\z/.match("あいう") or panic("no match")
    expect(md.offset(1)).to eq([1, 2])
    expect(md.offset(3)).to eq([2, 3])
    expect(md.offset(2)).to eq([nil, nil])
  end
end

context "MatchData#captures" do
  specify "returns an array of the match captures" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.captures).to eq(["H", "X", "113", "8"])
  end

  specify "holds nil for a group that took no part" do
    md = /(a)(b)?(c)?/.match("ab") or panic("no match")
    expect(md.captures).to eq(["a", "b", nil])
  end
end

context "MatchData#named_captures" do
  specify "returns a Hash that has captured name and the matched string pairs" do
    md = /(?<a>.)(?<b>.)?/.match("0") or panic("no match")
    expect(md.named_captures).to eq({"a" => "0", "b" => nil})
  end

  specify "prefers later captures" do
    md = /\A(?<a>.)(?<b>.)(?<b>.)(?<a>.)\z/.match("0123") or panic("no match")
    expect(md.named_captures).to eq({"a" => "3", "b" => "2"})
  end

  specify "returns the latest matched capture, even if a later one that does not match exists" do
    md = /\A(?<a>.)(?<b>.)(?<b>.)(?<a>.)?\z/.match("012") or panic("no match")
    expect(md.named_captures).to eq({"a" => "0", "b" => "2"})
  end
end

context "MatchData#names" do
  specify "returns the names of the named capture groups" do
    md = "haystack".match(/(?<yellow>hay).(?<pin>tack)/) or panic("no match")
    expect(md.names).to eq(["yellow", "pin"])
  end

  specify "returns [] if there were no named captures" do
    md = "haystack".match(/(hay).(tack)/) or panic("no match")
    expect(md.names).to eq([])
  end

  specify "returns each name only once, and equals Regexp#names" do
    pattern = /(?<hay>hay)(?<dot>.)(?<hay>tack)/
    md = "haystack".match(pattern) or panic("no match")
    expect(md.names).to eq(["hay", "dot"])
    expect(md.names).to eq(pattern.names)
  end
end

context "MatchData#pre_match and #post_match" do
  specify "return the text before and after the match" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138: The Movie") or panic("no match")
    expect(md.pre_match).to eq("T")
    expect(md.post_match).to eq(": The Movie")
  end

  specify "are empty at the edges" do
    md = /abc/.match("abc") or panic("no match")
    expect(md.pre_match).to eq("")
    expect(md.post_match).to eq("")
  end
end

context "MatchData#match and #match_length" do
  specify "returns the corresponding match when given an Integer" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.match(0)).to eq("HX1138")
    expect(md.match(1)).to eq("H")
    expect(md.match(3)).to eq("113")
    expect(md.match_length(0)).to eq(6)
    expect(md.match_length(3)).to eq(3)
  end

  specify "returns nil on non-matching index matches" do
    md = /\d+(\w)?/.match("THX1138.") or panic("no match")
    expect(md.match(1)).to be_nil
    expect(md.match_length(1)).to be_nil
  end

  specify "returns the corresponding named match when given a Symbol" do
    md = "haystack".match(/(?<t>t(?<a>ack))/) or panic("no match")
    expect(md.match(:a)).to eq("ack")
    expect(md.match_length(:t)).to eq(4)
  end
end

context "MatchData#to_a, #to_s, #size, #length" do
  specify "to_a returns an array of matches" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.to_a).to eq(["HX1138", "H", "X", "113", "8"])
  end

  specify "to_s returns the entire matched string" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.to_s).to eq("HX1138")
    expect("#{md}").to eq("HX1138")
  end

  specify "size and length count the match and its groups" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.size).to eq(5)
    expect(md.length).to eq(5)
  end
end

context "MatchData#values_at" do
  specify "returns an array containing each value given by one of the integers" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138: The Movie") or panic("no match")
    expect(md.values_at(0, 2, -2)).to eq(["HX1138", "X", "113"])
  end

  specify "returns nil for any integer that is out of range" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138: The Movie") or panic("no match")
    expect(md.values_at(5)).to eq([nil])
    expect(md.values_at(-6)).to eq([nil])
  end

  specify "slices captures with the given names" do
    md = /(?<a>.)(?<b>.)(?<c>.)/.match("012") or panic("no match")
    expect(md.values_at(:c, :a)).to eq(["2", "0"])
    expect(md.values_at("c", "a")).to eq(["2", "0"])
  end

  specify "supports mixing of names and indices" do
    md = /\A(?<a>.)(?<b>.)\z/.match("01") or panic("no match")
    expect(md.values_at(0, 1, 2, :a, :b)).to eq(["01", "0", "1", "0", "1"])
  end

  specify "returns a new empty Array if no arguments given" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138: The Movie") or panic("no match")
    expect(md.values_at).to eq([])
  end
end

context "MatchData#string and #regexp" do
  specify "string returns the text the match ran over" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(md.string).to eq("THX1138.")
  end

  specify "regexp returns the pattern used in the match" do
    md = "haystack".match(/hay/) or panic("no match")
    expect(md.regexp).to eq(/hay/)
    expect(md.regexp.class).to eq(Regexp)
  end
end

context "MatchData#inspect" do
  specify "returns a human readable representation that contains the matched string and the captures" do
    md = /(.)(.)(\d+)(\d)/.match("THX1138.") or panic("no match")
    expect(inspect(md)).to eq('#<MatchData "HX1138" 1:"H" 2:"X" 3:"113" 4:"8">')
  end

  specify "returns a human readable representation of named captures" do
    md = "abc def ghi".match(/(?<first>\w+)\s+(?<last>\w+)\s+(\w+)/) or panic("no match")
    expect(inspect(md)).to eq('#<MatchData "abc def ghi" first:"abc" last:"def">')
  end

  specify "shows a group that took no part as nil" do
    md = "ab".match(/(a)(b)?(c)?/) or panic("no match")
    expect(inspect(md)).to eq('#<MatchData "ab" 1:"a" 2:"b" 3:nil>')
  end
end

context "MatchData#==" do
  specify "returns true if both operands have equal target strings, patterns, and match positions" do
    expect("haystack".match(/hay/) == "haystack".match(/hay/)).to be_true
  end

  specify "returns false if the operands have different target strings" do
    expect("hay".match(/hay/) == "haystack".match(/hay/)).to be_false
  end

  specify "returns false if the operands have different patterns" do
    expect("haystack".match(/h.y/) == "haystack".match(/hay/)).to be_false
  end

  specify "returns false if the argument is not a MatchData object" do
    expect("haystack".match(/hay/) == "hay").to be_false
  end
end

context "MatchData positions count graphemes" do
  specify "a combining mark is part of its character" do
    md = "éx".match(/x/) or panic("no match")
    expect(md.begin(0)).to eq(1)
    expect("éx".length).to eq(2)
  end

  specify "a flag is one character" do
    md = "🇵🇹x".match(/x/) or panic("no match")
    expect(md.begin(0)).to eq(1)
    expect(md.pre_match).to eq("🇵🇹")
  end
end

context "MatchData is a type" do
  specify "class answers MatchData" do
    md = "a".match(/a/) or panic("no match")
    expect(md.class).to eq(MatchData)
    expect(MatchData === md).to be_true
    expect(MatchData === "a").to be_false
  end
end
