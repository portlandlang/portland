# The pattern language is Onigmo's (ADR 0086): anchors, escapes,
# repetition, back-references, grouping, inline modifiers, subexpression
# calls, lookaround, possessive and atomic groups, conditionals, the absent
# operator, character class composition, and empty iterations — each row
# Ruby 4.0.9's answer. The engine is #212's; a construct the current engine
# misses stays upstream and is recorded on that issue.
#
# From ruby/spec language/regexp_spec.rb and language/regexp/{anchors,
# escapes,repetition,back-references,grouping,modifiers,subexpression_call,
# empty_checks,character_classes}_spec.rb. Upstream: the `$~` and `$1`
# rows (the match globals are gone), the `o` flag, the `n`, `u`, `e`, `s`
# encoding modifiers and `(?a)`/`(?d)`/`(?u)`, the `eval`-driven syntax
# error rows (a bad pattern refuses, which a spec cannot assert), the
# threads row, and the subject strings spelled with `\0`, `\v`, `\f`, `\a`,
# and `\e`, which Portland's strings do not escape.

require_relative "../spec_helper"

def found(pattern, text) = (pattern.match(text) or panic("no match for #{inspect(pattern)} on #{inspect(text)}")).to_a

context "anchors" do
  specify "^ is the line start anchor" do
    expect(found(/^foo/, "foo")).to eq(["foo"])
    expect(found(/^bar/, "foo\nbar")).to eq(["bar"])
    expect(/^foo/.match(" foo")).to be_nil
    expect(/foo^/.match("foo\n\n\n")).to be_nil
    expect(found(/^^^foo/, "foo")).to eq(["foo"])
    expect(/^bar/.match("foo\rbar")).to be_nil
    expect(found(/^/, "foo")).to eq([""])
    expect(found(/(^foo)/, "foo")).to eq(["foo", "foo"])
    expect(found(/(^)/, "foo")).to eq(["", ""])
    expect(found(/(foo\n^)(^bar)/, "foo\nbar")).to eq(["foo\nbar", "foo\n", "bar"])
    expect(/^(?!\A)/.match("foo\n")).to be_nil
  end

  specify "$ is the line end anchor" do
    expect(found(/foo$/, "foo")).to eq(["foo"])
    expect(found(/foo$/, "foo\nbar")).to eq(["foo"])
    expect(/foo$/.match("foo ")).to be_nil
    expect(/$foo/.match("\n\n\nfoo")).to be_nil
    expect(found(/foo$$$/, "foo")).to eq(["foo"])
    expect(/foo$/.match("foo\r\nbar")).to be_nil
    expect(found(/(foo$)/, "foo")).to eq(["foo", "foo"])
    expect(found(/(foo$)($\nbar)/, "foo\nbar")).to eq(["foo\nbar", "foo", "\nbar"])
  end

  specify "\\A is the string start anchor" do
    expect(found(/\Afoo/, "foo")).to eq(["foo"])
    expect(/\Abar/.match("foo\nbar")).to be_nil
    expect(/\Afoo/.match(" foo")).to be_nil
    expect(found(/\A\A\Afoo/, "foo")).to eq(["foo"])
    expect(found(/(\A\Z)(\A\Z)/, "")).to eq(["", "", ""])
    expect(found(/(\A)/, "foo")).to eq(["", ""])
  end

  specify "\\Z is the string end anchor, including before a trailing newline" do
    expect(found(/foo\Z/, "foo")).to eq(["foo"])
    expect(found(/foo\Z/, "foo\n")).to eq(["foo"])
    expect(/foo\Z/.match("foo\nbar")).to be_nil
    expect(/foo\Z/.match("foo ")).to be_nil
    expect(found(/foo\Z\Z\Z/, "foo\n")).to eq(["foo"])
    expect(/foo\Z/.match("foo\r\n")).to be_nil
    expect(found(/(foo\Z)/, "foo")).to eq(["foo", "foo"])
  end

  specify "\\z is the string end anchor" do
    expect(found(/foo\z/, "foo")).to eq(["foo"])
    expect(/foo\z/.match("foo\nbar")).to be_nil
    expect(/foo\z/.match("foo\n")).to be_nil
    expect(found(/foo\z\z\z/, "foo")).to eq(["foo"])
    expect(found(/($\z)($\z)/, "foo")).to eq(["", "", ""])
    expect(found(/(foo\z)/, "foo")).to eq(["foo", "foo"])
  end

  specify "\\b is the word boundary" do
    expect(found(/foo\b/, "foo")).to eq(["foo"])
    expect(found(/foo\b/, "foo\n")).to eq(["foo"])
    expect(found(/foo\b/, "foo ")).to eq(["foo"])
    expect(found(/foo\b/, "foo.")).to eq(["foo"])
    expect(/foo\b/.match("foobar")).to be_nil
    expect(/foo\b/.match("foo123")).to be_nil
    expect(/foo\b/.match("foo_")).to be_nil
  end

  specify "\\B is the non-word boundary" do
    expect(found(/foo\B/, "foobar")).to eq(["foo"])
    expect(found(/foo\B/, "foo123")).to eq(["foo"])
    expect(found(/foo\B/, "foo_")).to eq(["foo"])
    expect(/foo\B/.match("foo")).to be_nil
    expect(/foo\B/.match("foo\n")).to be_nil
    expect(/foo\B/.match("foo ")).to be_nil
  end

  specify "lookahead and lookbehind" do
    expect(found(/foo.(?=bar)/, "foo1 foo2bar")).to eq(["foo2"])
    expect(found(/foo.(?!bar)/, "foo1bar foo2")).to eq(["foo2"])
    expect(found(/(?<!foo)bar./, "foobar1 bar2")).to eq(["bar2"])
    expect(found(/(?<=foo)bar./, "bar1 foobar2")).to eq(["bar2"])
    expect(found(/(?<=\bfoo)bar./, "1foobar1 foobar2")).to eq(["bar2"])
    expect(found(/(?<!\bfoo)bar./, "foobar1 1foobar2")).to eq(["bar2"])
    expect(found(/foo.(?<=\d)/, "fooA foo1")).to eq(["foo1"])
    expect(found(/foo.(?<!\d)/, "foo1 fooA")).to eq(["fooA"])
  end
end

context "escapes" do
  specify "the whitespace escapes" do
    expect(found(/\t/, "\t")).to eq(["\t"])
    expect(found(/\n/, "\n")).to eq(["\n"])
    expect(found(/\r/, "\r")).to eq(["\r"])
  end

  specify "quoting meta-characters via escape sequence" do
    expect(found(/\(/, "(")).to eq(["("])
    expect(found(/\)/, ")")).to eq([")"])
    expect(found(/\[/, "[")).to eq(["["])
    expect(found(/\]/, "]")).to eq(["]"])
    expect(found(/\{/, "{")).to eq(["{"])
    expect(found(/\}/, "}")).to eq(["}"])
    expect(found(/\|/, "|")).to eq(["|"])
    expect(found(/\?/, "?")).to eq(["?"])
    expect(found(/\./, ".")).to eq(["."])
    expect(found(/\*/, "*")).to eq(["*"])
    expect(found(/\+/, "+")).to eq(["+"])
    expect(found(/\^/, "^")).to eq(["^"])
    expect(found(/\$/, "$")).to eq(["$"])
  end

  specify "quoting meta-characters used as a %r terminator" do
    expect(found(%r(\(), "(")).to eq(["("])
    expect(found(%r[\]], "]")).to eq(["]"])
    expect(found(%r{\}}, "}")).to eq(["}"])
  end

  specify "allows any character to be escaped" do
    expect(found(/\y/, "y")).to eq(["y"])
  end

  specify "\\x hex characters" do
    expect(found(/\xA/, "\nxyz")).to eq(["\n"])
    expect(found(/\x0A/, "\n")).to eq(["\n"])
    expect(found(/\x0AA/, "\nA")).to eq(["\nA"])
    expect(found(/\xAG/, "\nG")).to eq(["\nG"])
  end

  specify "\\c control characters" do
    expect(found(/\c)\cI\ci/, "\t\t\t")).to eq(["\t\t\t"])
    expect(found(/\c*\cJ\cj/, "\n\n\n")).to eq(["\n\n\n"])
    expect(found(/\c-\cM\cm/, "\r\r\r")).to eq(["\r\r\r"])
    expect(/\cJ/.match("\r")).to be_nil
    expect(found(/\cJ+/, "\n\n")).to eq(["\n\n"])
    expect(found(/\\cJ/, '\cJ')).to eq(['\cJ'])
    expect(found(/\C-*\C-J\C-j/, "\n\n\n")).to eq(["\n\n\n"])
  end

  specify "\\K keeps and \\R is a line break" do
    expect(found(/a\Kb/, "ab")).to eq(["b"])
    expect(found(/\R/, "\n")).to eq(["\n"])
    expect(found(/\R/, "\r\n")).to eq(["\r\n"])
  end

  specify "\\u unicode escapes" do
    expect(found(/あ/, "あ")).to eq(["あ"])
    expect(found(/\u{3042 3044}/, "あい")).to eq(["あい"])
  end
end

context "repetition" do
  specify "* and *?" do
    expect(found(/a*/, "aaa")).to eq(["aaa"])
    expect(found(/a*/, "bbb")).to eq([""])
    expect(found(/<.*>/, "<a>foo</a>")).to eq(["<a>foo</a>"])
    expect(found(/a*?/, "aaa")).to eq([""])
    expect(found(/<.*?>/, "<a>foo</a>")).to eq(["<a>"])
  end

  specify "+ and +?" do
    expect(found(/a+/, "aaa")).to eq(["aaa"])
    expect(/a+/.match("bbb")).to be_nil
    expect(found(/<.+>/, "<a>foo</a>")).to eq(["<a>foo</a>"])
    expect(found(/a+?/, "aaa")).to eq(["a"])
    expect(found(/<.+?>/, "<a>foo</a>")).to eq(["<a>"])
  end

  specify "{m,n} and {m,n}?" do
    expect(found(/a{2,4}/, "aaaaaa")).to eq(["aaaa"])
    expect(found(/<.{1,}>/, "<a>foo</a>")).to eq(["<a>foo</a>"])
    expect(found(/<.{1,}?>/, "<a>foo</a>")).to eq(["<a>"])
    expect(found(/.([0-9]){3,5}?foo/, "9876543210foo")).to eq(["543210foo", "0"])
  end

  specify "?" do
    expect(found(/a?/, "aaa")).to eq(["a"])
    expect(found(/a?/, "bbb")).to eq([""])
  end

  specify "incomplete range quantifiers are literal" do
    expect(found(/a{}/, "a{}")).to eq(["a{}"])
    expect(found(/a{,}/, "a{,}")).to eq(["a{,}"])
    expect(found(/a{1/, "a{1")).to eq(["a{1"])
    expect(found(/a{1,2/, "a{1,2")).to eq(["a{1,2"])
    expect(found(/a{,5}/, "aaa")).to eq(["aaa"])
  end

  specify "quantifiers on assertions" do
    expect(found(/a^?b/, "ab")).to eq(["ab"])
    expect(found(/a$?b/, "ab")).to eq(["ab"])
    expect(found(/a\A?b/, "ab")).to eq(["ab"])
    expect(found(/a\Z?b/, "ab")).to eq(["ab"])
    expect(found(/a\z?b/, "ab")).to eq(["ab"])
    expect(found(/a\b?b/, "ab")).to eq(["ab"])
    expect(found(/a\B?b/, "ab")).to eq(["ab"])
    expect(found(/a(?=c)?b/, "ab")).to eq(["ab"])
    expect(found(/a(?!=b)?b/, "ab")).to eq(["ab"])
    expect(found(/a(?<=c)?b/, "ab")).to eq(["ab"])
    expect(found(/a(?<!a)?b/, "ab")).to eq(["ab"])
    expect(found(/(?=(a))?/, "a")).to eq(["", "a"])
  end

  specify "nested quantifiers" do
    expect(found(/a***/, "aaa")).to eq(["aaa"])
    expect(found(/(a+?)*/, "aa")).to eq(["aa", "a"])
    expect(/(a+?)+/.match("")).to be_nil
    expect(found(/(a+)*?/, "aaa")).to eq(["", nil])
    expect(found(/b(.+)*?b/, "baaabaaab")).to eq(["baaabaaab", "aaabaaa"])
  end

  specify "? after {n} is another quantifier, not the lazy marker" do
    expect(found(/a{2}?/, "")).to eq([""])
  end

  specify "zero-width groups in optional iterations of loops" do
    expect(found(/()?/, "")).to eq(["", ""])
    expect(found(/(a*)?/, "")).to eq(["", ""])
    expect(found(/(a*)*/, "")).to eq(["", ""])
  end

  specify "possessive quantifiers and atomic groups" do
    expect(found(/fooA++bar/, "fooAAAbar")).to eq(["fooAAAbar"])
    expect(/fooA++Abar/.match("fooAAAbar")).to be_nil
    expect(/fooA?+Abar/.match("fooAAAbar")).to be_nil
    expect(/fooA*+Abar/.match("fooAAAbar")).to be_nil
    expect(found(/(?>foo)(?>bar)/, "foobar")).to eq(["foobar"])
    expect(/(?>foo*)obar/.match("foooooooobar")).to be_nil
  end
end

context "grouping" do
  specify "() captures and nests" do
    expect(found(/(a)/, "a")).to eq(["a", "a"])
    expect(found(/(hay(st)a)ck/, "haystack")).to eq(["haystack", "haysta", "st"])
  end

  specify "(?: ) does not capture" do
    expect(found(/(?:foo)(bar)/, "foobar")).to eq(["foobar", "bar"])
    expect(found(/(?:xdigit:)/, "xdigit:")).to eq(["xdigit:"])
  end

  specify "(?# ) is a comment" do
    expect(found(/foo(?#comment)bar/, "foobar")).to eq(["foobar"])
    expect(found(/foo(?#)bar/, "foobar")).to eq(["foobar"])
  end

  specify "ignores capture groups in extended-mode line comments" do
    pattern = /^
      (a) # there is a capture group on this line
      b   # there is no capture group on this line (not even here)
      $/x
    expect(found(pattern, "ab")).to eq(["ab", "a"])
  end

  specify "| alternates and . is any character but a newline" do
    expect(found(/a|b/, "a")).to eq(["a"])
    expect(found(/./, "foo")).to eq(["f"])
    expect(/./.match("")).to be_nil
    expect(/./.match("\n")).to be_nil
  end
end

context "back-references" do
  specify "\\n refers to a previous group's match" do
    expect(found(/(foo.)\1/, "foo1foo1")).to eq(["foo1foo1", "foo1"])
    expect(/(foo.)\1/.match("foo1foo2")).to be_nil
  end

  specify "resets a nested back-reference before the outer group matches again" do
    expect(found(/(a\1?){2}/, "aaaa")).to eq(["aa", "a"])
  end

  specify "does not reset enclosed capture groups" do
    md = /((a)|(b))+/.match("ab") or panic("no match")
    expect(md.captures).to eq(["b", "a", "b"])
  end

  specify "can match an optional quote around content as the whole string" do
    expect(found(/^("|)(.*)\1$/, "x")).to eq(["x", "", "x"])
    pattern = /\A(["']?)(.*?)\1\z/
    expect(found(pattern, '"content"')).to eq(['"content"', '"', "content"])
    expect(found(pattern, "content")).to eq(["content", "", "content"])
  end

  specify "allows forward references" do
    expect(found(/(?:(\2)|(.))+/, "aa")).to eq(["aa", "a", "a"])
  end

  specify "\\k<name> is a named back-reference and \\g<name> a call" do
    expect(found(/(?<three_digits>[0-9]{3})-\k<three_digits>/, "123-123")).to eq(["123-123", "123"])
    expect(/(?<three_digits>[0-9]{3})-\k<three_digits>/.match("123-456")).to be_nil
    expect(found(/(?<three_digits>[0-9]{3})-\g<three_digits>/, "123-456")).to eq(["123-456", "456"])
    expect(found(/(?<foo>foo.)bar\g<foo>/, "foo1barfoo2")).to eq(["foo1barfoo2", "foo2"])
  end
end

context "subexpression calls" do
  specify "numeric calls" do
    expect(found(/(a)\g<1>/, "aa")).to eq(["aa", "a"])
  end

  specify "recursive calls" do
    parens = /^ (?<parens>  (?: \( \g<parens> \) | [^()] )*  ) $/x
    expect(found(parens, "((a)(b))c(d)")).to eq(["((a)(b))c(d)", "((a)(b))c(d)"])
    expect(parens.match("((a)(b)c(d)")).to be_nil
  end

  specify "back-references from the current level" do
    mirror = /^ (?<mirror> (?: (?<first_char>.) \g<mirror> \k<first_char-0> )? ) $/x
    expect(found(mirror, "abccba")[0]).to eq("abccba")
    expect(mirror.match("abccbd")).to be_nil
    broken_mirror = /^ (?<mirror> (?: (?<first_char>.) \g<mirror> \k<first_char> )? ) $/x
    expect(broken_mirror.match("abccba")).to be_nil
    expect(found(broken_mirror, "abcccc")[0]).to eq("abcccc")
  end

  specify "+ and - in group names" do
    expect(found(/(?<a+>a)\g<a+>/, "aa")).to eq(["aa", "a"])
    expect(found(/(?<a-b>a)\g<a-b>/, "aa")).to eq(["aa", "a"])
    expect(found(/(?<a-1>a)\g<a-1>/, "aa")).to eq(["aa", "a"])
  end
end

context "modifiers" do
  specify "i, m, and x" do
    expect(found(/foo/i, "FOO")).to eq(["FOO"])
    expect(found(/foo.bar/m, "foo\nbar")).to eq(["foo\nbar"])
    expect(/foo.bar/.match("foo\nbar")).to be_nil
    expect(found(/\d +/x, "abc123")).to eq(["123"])
    expect(found(/./m, "\n")).to eq(["\n"])
  end

  specify "a comment in extended syntax ends at a newline" do
    expect(found(Regexp.new("(a) # comment \\\n(b)", 2), "ab")).to eq(["ab", "a", "b"])
    expect(found(Regexp.new("(x # comment \\\n)", 2), "x")).to eq(["x", "x"])
  end

  specify "modifier combinations" do
    expect(found(/foo/imx, "foo")).to eq(["foo"])
    expect(found(/foo/imximx, "foo")).to eq(["foo"])
  end

  specify "(?imx-imx) inline modifiers" do
    expect(found(/(?i)foo/, "FOO")).to eq(["FOO"])
    expect(/foo(?i)/.match("FOO")).to be_nil
    expect(/(?-i)foo/i.match("FOO")).to be_nil
    expect(found(/foo(?-i)/i, "FOO")).to eq(["FOO"])
    expect(found(/foo (?i)bar (?-i)baz/, "foo BAR baz")).to eq(["foo BAR baz"])
    expect(/foo (?i)bar (?-i)baz/.match("foo BAR BAZ")).to be_nil
    expect(found(/(?m)./, "\n")).to eq(["\n"])
    expect(/.(?m)/.match("\n")).to be_nil
    expect(/(?-m)./m.match("\n")).to be_nil
    expect(found(/.(?-m)/m, "\n")).to eq(["\n"])
    expect(found(/(?x) foo /, "foo")).to eq(["foo"])
    expect(/ foo (?x)/.match("foo")).to be_nil
    expect(found(/( foo )(?x)( bar )(?-x)( baz )/, " foo bar baz ")).to eq([" foo bar baz ", " foo ", "bar", " baz "])
    expect(/(?i-i)foo/.match("FOO")).to be_nil
    expect(found(/(?ii)foo/, "FOO")).to eq(["FOO"])
    expect(found(/(?-)foo/, "foo")).to eq(["foo"])
  end

  specify "(?imx-imx:expr) scoped inline modifiers" do
    expect(found(/foo (?i:bar) baz/, "foo BAR baz")).to eq(["foo BAR baz"])
    expect(/foo (?i:bar) baz/.match("foo BAR BAZ")).to be_nil
    expect(/foo (?-i:bar) baz/i.match("foo BAR BAZ")).to be_nil
    expect(found(/. (?m:.) ./, ". \n .")).to eq([". \n ."])
    expect(/. (?-m:.) ./m.match("\n \n \n")).to be_nil
    expect(found(/( foo )(?x: bar )( baz )/, " foo bar baz ")).to eq([" foo bar baz ", " foo ", " baz "])
    expect(found(/( foo )(?-x: bar )( baz )/x, "foo bar baz")).to eq(["foo bar baz", "foo", "baz"])
    expect(/(?i-i:foo)/.match("FOO")).to be_nil
    expect(found(/(?ii:foo)/, "FOO")).to eq(["FOO"])
    expect(found(/(?-:)foo/, "foo")).to eq(["foo"])
  end

  specify "the absent operator" do
    expect(found(Regexp.new("(?~foo)"), "hello")).to eq(["hello"])
  end
end

context "conditionals and classes" do
  specify "conditional patterns with positional capture groups" do
    pattern = /\A(foo)?(?(1)(T)|(F))\z/
    expect(pattern.match?("fooT")).to be_true
    expect(pattern.match?("F")).to be_true
    expect(pattern.match?("fooF")).to be_false
    expect(pattern.match?("T")).to be_false
  end

  specify "conditional patterns with named capture groups" do
    pattern = /\A(?<word>foo)?(?(<word>)(T)|(F))\z/
    expect(pattern.match?("fooT")).to be_true
    expect(pattern.match?("F")).to be_true
    expect(pattern.match?("fooF")).to be_false
    expect(pattern.match?("T")).to be_false
  end

  specify "character class composition" do
    expect(found(/[a-z&&[^a-c]]+/, "abcdef")).to eq(["def"])
    expect(found(/[a-z&&[^d-i&&[^d-f]]]+/, "abcdefghi")).to eq(["abcdef"])
  end

  specify "POSIX brackets reach past the basic plane" do
    expect(found(/[[:lower:]]/, "𐓘")).to eq(["𐓘"])
    expect(found(/[[:upper:]]/, "𐒰")).to eq(["𐒰"])
  end

  specify "the common classes" do
    expect(found(/\d+/, "ab12")).to eq(["12"])
    expect(found(/\w+/, "a_1 b")).to eq(["a_1"])
    expect(found(/\s+/, "a \t b")).to eq([" \t "])
    expect(found(/\h+/, "xyzcafe")).to eq(["cafe"])
    expect(found(/[^\d]+/, "12ab34")).to eq(["ab"])
    expect(found(/\p{Alpha}+/, "12ab")).to eq(["ab"])
    expect(found(/\p{Hiragana}+/, "aあいb")).to eq(["あい"])
  end
end

context "empty iterations" do
  specify "allow extra empty iterations" do
    expect(found(/()??/, "")).to eq(["", nil])
    expect(found(/(a*?)?/, "")).to eq(["", ""])
    expect(found(/(a*)??/, "")).to eq(["", nil])
    expect(found(/(a*?)*/, "")).to eq(["", ""])
    expect(found(/(a*)*?/, "")).to eq(["", nil])
  end

  specify "make the pattern proceed past the quantified expression on failure" do
    expect(found(/(?:|a)*/, "aaa")).to eq([""])
    expect(found(/(?:()|a)*/, "aaa")).to eq(["", ""])
    expect(found(/(|a)*/, "aaa")).to eq(["", ""])
    expect(found(/()\1(?:|a)*/, "aaa")).to eq(["", ""])
    expect(found(/(?:(?=a)|a)*/, "aaa")).to eq([""])
    expect(found(/(?:|a)*?/, "aaa")).to eq([""])
    expect(found(/(|a)*?/, "aaa")).to eq(["", nil])
  end

  specify "allow empty iterations in the middle of a loop" do
    expect(found(/(a|\2b|())*/, "aaabbb")).to eq(["aaabbb", "", ""])
    expect(found(/(a|\2b|()){2,4}/, "aaabbb")).to eq(["aaa", "", ""])
    expect(found(/(a|\2b|())*?/, "aaabbb")).to eq(["", nil, nil])
  end
end
