# Ruby's bit math as named methods (ADR 0003, locked by #157): the
# operators are out of the grammar, the capability is here under names —
# `bit_and`, `bit_or`, `bit_xor`, `bit_not`, `shift_left`, `shift_right` —
# beside Ruby's own `allbits?`, `anybits?`, `nobits?`, `bit_length`,
# `bit_count`, and the bit read `n[i]`. Every answer here is Ruby's.
#
# From ruby/spec core/integer/{bit_and,bit_or,bit_xor,complement,
# left_shift,right_shift,allbits,anybits,nobits,bit_length,bit_count,
# element_reference}_spec.rb, the fixnum rows. What stays behind: the
# bignum rows (integers are 64-bit, #156), coerce and to_int (ADR 0036), a
# Float operand (refuses here where Ruby raises TypeError), and the
# two-argument and range forms of `n[i]`.

require_relative "../../../spec_helper"

context "Integer#bit_and" do
  specify "returns self bitwise AND other" do
    expect(256.bit_and(16)).to eq(0)
    expect(2010.bit_and(5)).to eq(0)
    expect(65535.bit_and(1)).to eq(1)
  end

  specify "returns self bitwise AND other when one operand is negative" do
    expect(1.shift_left(33).bit_and(-1)).to eq(1.shift_left(33))
    expect(-1.bit_and(1.shift_left(33))).to eq(1.shift_left(33))
    expect((-(1.shift_left(33)) - 1).bit_and(5)).to eq(5)
  end

  specify "returns self bitwise AND other when both operands are negative" do
    expect(-5.bit_and(-1)).to eq(-5)
    expect(-3.bit_and(-4)).to eq(-4)
    expect(-12.bit_and(-13)).to eq(-16)
    expect(-13.bit_and(-12)).to eq(-16)
  end
end

context "Integer#bit_or" do
  specify "returns self bitwise OR other" do
    expect(1.bit_or(0)).to eq(1)
    expect(5.bit_or(4)).to eq(5)
    expect(5.bit_or(6)).to eq(7)
    expect(248.bit_or(4096)).to eq(4344)
  end

  specify "returns self bitwise OR other when one operand is negative" do
    expect(1.shift_left(33).bit_or(-1)).to eq(-1)
    expect(-1.bit_or(1.shift_left(33))).to eq(-1)
    expect((-(1.shift_left(33)) - 1).bit_or(5)).to eq(-8589934593)
  end

  specify "returns self bitwise OR other when both operands are negative" do
    expect(-5.bit_or(-1)).to eq(-1)
    expect(-3.bit_or(-4)).to eq(-3)
    expect(-12.bit_or(-13)).to eq(-9)
    expect(-13.bit_or(-12)).to eq(-9)
  end
end

context "Integer#bit_xor" do
  specify "returns self bitwise EXCLUSIVE OR other" do
    expect(3.bit_xor(5)).to eq(6)
    expect(-2.bit_xor(-255)).to eq(255)
  end

  specify "returns self bitwise XOR other when one operand is negative" do
    expect(1.shift_left(33).bit_xor(-1)).to eq(-8589934593)
    expect(-1.bit_xor(1.shift_left(33))).to eq(-8589934593)
    expect((-(1.shift_left(33)) - 1).bit_xor(5)).to eq(-8589934598)
  end

  specify "returns self bitwise XOR other when both operands are negative" do
    expect(-5.bit_xor(-1)).to eq(4)
    expect(-3.bit_xor(-4)).to eq(1)
    expect(-12.bit_xor(-13)).to eq(7)
    expect(-13.bit_xor(-12)).to eq(7)
  end
end

context "Integer#bit_not" do
  specify "returns self with each bit flipped" do
    expect(0.bit_not).to eq(-1)
    expect(1221.bit_not).to eq(-1222)
    expect(-2.bit_not).to eq(1)
    expect(-599.bit_not).to eq(598)
  end
end

context "Integer#shift_left (with n << m)" do
  specify "returns n shifted left m bits when n > 0, m > 0" do
    expect(1.shift_left(1)).to eq(2)
  end

  specify "returns n shifted left m bits when n < 0, m > 0" do
    expect(-1.shift_left(1)).to eq(-2)
    expect(-7.shift_left(1)).to eq(-14)
    expect(-42.shift_left(2)).to eq(-168)
  end

  specify "returns n shifted right m bits when n > 0, m < 0" do
    expect(2.shift_left(-1)).to eq(1)
  end

  specify "returns n shifted right m bits when n < 0, m < 0" do
    expect(-2.shift_left(-1)).to eq(-1)
  end

  specify "returns 0 when n == 0" do
    expect(0.shift_left(1)).to eq(0)
  end

  specify "returns n when n > 0, m == 0" do
    expect(1.shift_left(0)).to eq(1)
  end

  specify "returns n when n < 0, m == 0" do
    expect(-1.shift_left(0)).to eq(-1)
  end

  specify "returns 0 when n > 0, m < 0 and n < 2**-m" do
    expect(3.shift_left(-2)).to eq(0)
    expect(7.shift_left(-3)).to eq(0)
    expect(127.shift_left(-7)).to eq(0)
    expect(7.shift_left(-32)).to eq(0)
    expect(7.shift_left(-64)).to eq(0)
  end

  specify "returns -1 when n < 0, m < 0 and n > -(2**-m)" do
    expect(-3.shift_left(-2)).to eq(-1)
    expect(-7.shift_left(-3)).to eq(-1)
    expect(-127.shift_left(-7)).to eq(-1)
    expect(-7.shift_left(-32)).to eq(-1)
    expect(-7.shift_left(-64)).to eq(-1)
  end
end

context "Integer#shift_right (with n >> m)" do
  specify "returns n shifted right m bits when n > 0, m > 0" do
    expect(2.shift_right(1)).to eq(1)
  end

  specify "returns n shifted right m bits when n < 0, m > 0" do
    expect(-2.shift_right(1)).to eq(-1)
    expect(-7.shift_right(1)).to eq(-4)
    expect(-42.shift_right(2)).to eq(-11)
  end

  specify "returns n shifted left m bits when n > 0, m < 0" do
    expect(1.shift_right(-1)).to eq(2)
  end

  specify "returns n shifted left m bits when n < 0, m < 0" do
    expect(-1.shift_right(-1)).to eq(-2)
  end

  specify "returns 0 when n == 0" do
    expect(0.shift_right(1)).to eq(0)
  end

  specify "returns n when n > 0, m == 0" do
    expect(1.shift_right(0)).to eq(1)
  end

  specify "returns n when n < 0, m == 0" do
    expect(-1.shift_right(0)).to eq(-1)
  end

  specify "returns 0 when n > 0, m > 0 and n < 2**m" do
    expect(3.shift_right(2)).to eq(0)
    expect(7.shift_right(3)).to eq(0)
    expect(127.shift_right(7)).to eq(0)
    expect(7.shift_right(32)).to eq(0)
    expect(7.shift_right(64)).to eq(0)
  end

  specify "returns -1 when n < 0, m > 0 and n > -(2**m)" do
    expect(-3.shift_right(2)).to eq(-1)
    expect(-7.shift_right(3)).to eq(-1)
    expect(-127.shift_right(7)).to eq(-1)
    expect(-7.shift_right(32)).to eq(-1)
    expect(-7.shift_right(64)).to eq(-1)
  end
end
