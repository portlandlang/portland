# Ranges over any orderable value (ADR 0081): the ends are any two values
# `<=>` orders — numbers, strings, symbols, arrays, Comparable structs — and
# membership, the extremes, the ends, equality, clamping, `overlap?`, `when`,
# and `in` work over them by `<=>`. Iteration stays with integer ranges: a
# float start refuses as Ruby's does, and `1..2.5` walks the integers up to
# the floor, as Ruby's does.
#
# From ruby/spec core/range/{cover,include,case_compare,min,max,minmax,
# first,last,begin,end,equal_value,eql,inspect,to_s,to_a,new,overlap}_spec.rb,
# the rows with string and float ends, and core/range/shared/
# cover_and_include.rb. Upstream: `include?` on a string range walks by
# `succ` in Ruby, so `("a".."f").include?("aa")` is false there and true
# here, where every membership question is `cover?`; Ruby's TypeError on
# `include?` over an open string range (it covers here); the Time, mock,
# subrange, and Set-like rows; and `("a"..."f").max`, which Ruby finds by
# walking.

require_relative "../../spec_helper"

struct Version
  major
  minor

  include Comparable

  def <=>(other) = [major, minor] <=> [other.major, other.minor]
end

context "Range over any orderable" do

  describe "a range of Comparable structs" do
    low = Version.new(major: 1, minor: 0)
    middle = Version.new(major: 1, minor: 5)
    high = Version.new(major: 2, minor: 0)
    beyond = Version.new(major: 3, minor: 0)

    specify "covers by the struct's own <=>" do
      expect((low..high).include?(middle)).to be_true
      expect((low..high).cover?(beyond)).to be_false
      expect((low...high).include?(high)).to be_false
      expect((low..high).member?(low)).to be_true
    end

    specify "clamps, picks its extremes, and answers when" do
      expect(beyond.clamp(low..high)).to eq(high)
      expect(middle.clamp(low..high)).to eq(middle)
      expect(middle.clamp(low..)).to eq(middle)
      expect(middle.clamp(..low)).to eq(low)
      expect((low..high).min).to eq(low)
      expect((low..high).max).to eq(high)
      expect((high..low).min).to be_nil
      answer = case middle
      when low..high then "supported"
      else "not"
      end
      expect(answer).to eq("supported")
    end
  end

end
