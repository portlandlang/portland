# ADR 0014 — Ruby 3 keywords: `label:` required, `label: default` optional,
# strictly separate from positionals.

require_relative "../../spec_helper"

def tag(name:, level: 1)
  "#{name}@#{level}"
end
def box(width, height: width)
  width * height
end

context "a method" do
  describe "keyword parameters" do
    specify "fill in a declared default" do
      expect(tag(name: "pdx")).to eq("pdx@1")
    end

    specify "take arguments in any order" do
      expect(tag(level: 3, name: "swap")).to eq("swap@3")
    end

    specify "may default to an earlier parameter" do
      expect(box(3)).to eq(9)
      expect(box(3, height: 2)).to eq(6)
    end
  end

  # ADR 0078: a label with no value takes the name's own, as Ruby 3.1 reads
  # it — the spelling that forwards keywords.
  describe "keyword arguments with omitted values" do
    specify "take the local of the same name" do
      name = "pdx"
      level = 4
      expect(tag(name:, level:)).to eq("pdx@4")
      expect(tag(level: 2, name:)).to eq("pdx@2")
    end

    specify "take the next line's value inside the parens, as Ruby does" do
      name = "pdx"
      expect(tag(name:
      )).to eq("pdx@1")
      expect(tag(name:
        "other")).to eq("other@1")
    end
  end
end
