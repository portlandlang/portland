# Formatting (ADR 0067, #172), from ruby/spec core/kernel/shared/sprintf.rb
# — the rows core/string/modulo_spec.rb, core/kernel/sprintf_spec.rb, and
# core/kernel/format_spec.rb all share. Portland spells them `format(...)`
# and `sprintf(...)`; `"%d" % x` refuses naming `format`. Every answer here
# is Ruby 4.0.9's byte for byte, the near-tie float rows included (2.675 is
# "2.68" where correct rounding would say "2.67"), because the seed carries
# MRI's own digit rounding.
#
# Stays upstream: the rows that convert through to_int, to_i, to_str, and
# to_s mocks or BasicObject (no open runtime); Hash#default and KeyError's
# receiver and key (ADR 0063, no exceptions); $VERBOSE warnings; encodings
# (#119). The rows that raise — too few arguments, a malformed template,
# a value of the wrong kind — refuse in Ruby's words and are pinned in
# seed/tests/run_pdx_files.rs on both oracles. `%c` of a string answers its
# first grapheme (ADR 0038), where Ruby's answers its first codepoint.

require_relative "../../spec_helper"

context "format" do

  describe "width" do

    specify "counts graphemes, as every width here does" do
      expect(format("%3s|", "🇺🇸")).to eq("  🇺🇸|")
    end
  end

end
