# Building a set (ADR 0082): `Set.new` over any enumerable, `Set[...]`, and
# `to_set` on the collections, each dropping repeats and keeping insertion
# order; a block maps the members first. `inspect` and `to_s` are Ruby 4's
# `Set[1, 2]`, which is also the constructor.
#
# From ruby/spec core/set/{constructor,initialize,inspect,to_s,set}_spec.rb,
# core/enumerable/to_set_spec.rb (also under core/set/enumerable/), and
# core/range/to_set_spec.rb. Upstream: the mock enumerables answering
# each_entry or each, the private-method and alias checks, the cyclic set
# (no value here can hold itself), the row that shells out to ruby, the
# Set-subclass argument (no subclasses), and the beginless and endless
# ranges, which refuse to be walked in Portland's words (ADR 0055).

require_relative "../../spec_helper"

context "Set" do
  describe ".new" do
    specify "adds every element of the passed array" do
      built = Set.new([1, 2, 3])
      expect(built.size).to eq(3)
      expect(built).to contain(1)
      expect(built).to contain(2)
      expect(built).to contain(3)
    end

    specify "starts empty with no argument, an empty array, or an empty hash" do
      expect(Set.new.size).to eq(0)
      expect(Set.new([]).size).to eq(0)
      expect(Set.new({}).size).to eq(0)
    end

    specify "takes a set" do
      original = Set.new([1, 2])
      copied = Set.new(original)
      expect(copied.size).to eq(2)
      expect(copied).to eq(original)
    end

    specify "takes a range, and a hash as its pairs" do
      expect(Set.new(1..3)).to eq(Set[1, 2, 3])
      expect(Set.new({a: 1})).to eq(Set[[:a, 1]])
    end

    specify "preprocesses every element through a block" do
      squared = Set.new([1, 2, 3]) { it * it }
      expect(squared.size).to eq(3)
      expect(squared).to contain(1)
      expect(squared).to contain(4)
      expect(squared).to contain(9)
    end

    specify "stays empty with an empty array or set and a block" do
      from_array = Set.new([]) { it * it }
      from_set = Set.new(Set.new) { it * it }
      expect(from_array.size).to eq(0)
      expect(from_set.size).to eq(0)
    end
  end
  describe "#to_set" do
    specify "builds a set from an array, a hash's pairs, and a range" do
      expect([1, 2, 3].to_set).to eq(Set[1, 2, 3])
      expect({a: 1, b: 2}.to_set).to eq(Set[[:b, 2], [:a, 1]])
      expect((1..3).to_set).to eq(Set[1, 2, 3])
    end

    specify "passes a block down" do
      expect([1, 2, 3].to_set { it * it }).to eq(Set[1, 4, 9])
    end

    specify "answers a set itself" do
      expect(Set[1, 2].to_set).to eq(Set[1, 2])
    end
  end
  describe "#inspect and #to_s" do
    specify "spell the set as Ruby 4 does, which is the constructor" do
      expect(inspect(Set[1, 2, 3])).to eq("Set[1, 2, 3]")
      expect(Set["1"].to_s).to eq('Set["1"]')
      expect(Set[].to_s).to eq("Set[]")
      expect(Set["1", "2"].to_s.include?('", "')).to be_true
      expect(Set[:a, "b", Set["c"]].to_s).to eq('Set[:a, "b", Set["c"]]')
    end
  end
  describe "the type" do
    specify "answers class and name" do
      expect(Set[1].class).to eq(Set)
      expect(Set.name).to eq("Set")
    end

    specify "matches the type pattern and the when value" do
      expect((Set[1] in Set)).to be_true
      expect(([1] in Set)).to be_false
      answer = case Set[1]
      when Set then "set"
      else "other"
      end
      expect(answer).to eq("set")
    end
  end
end
