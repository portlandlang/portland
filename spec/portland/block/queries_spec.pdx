# `each_slice` without a block answers the slices as an array — there is no
# lazy enumerator here (#80) — where Ruby answers an Enumerator, so `.to_a`
# on it is the identity. The rest of the block-taking library is Ruby's, and
# its rows live in the ruby/spec mirror under spec/core/array/ and
# spec/core/enumerable/.

require_relative "../../spec_helper"

context "the block-taking library" do
  describe "the finders and shapers" do
    specify "each_slice chunks and flat_map opens one level" do
      expect([1, 2, 3, 4, 5].each_slice(2)).to eq([[1, 2], [3, 4], [5]])
    end
  end
end
