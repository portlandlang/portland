# Ruby's Struct as a walk over its fields (#114), from ruby/spec
# core/struct/{to_a,values,to_h,members,size,length,each,each_pair,select,filter}_spec.rb.
# The fixtures are struct declarations, not Struct.new, and a Portland
# struct takes every field by keyword, so Ruby's nil-filled trailing
# fields are written nil. A field named for one of these views wins, as
# Ruby's accessor does (the last context). The blockless enumerators, the
# to_ary coercion (ADR 0036), the class-side members, and the subclass
# rows stay upstream; the to_h row that interpolates a nil field is
# written with a year, since nil has no to_s (ADR 0006).

require_relative "../spec_helper"

struct Car
  make
  model
  year
end

struct Ruby
  version
  platform
end

struct Sized
  size
end

context "Struct#to_a" do
  specify "returns the values for this instance as an array" do
    expect(Car.new(make: "Geo", model: "Metro", year: 1995).to_a).to eq(["Geo", "Metro", 1995])
    expect(Car.new(make: "Ford", model: nil, year: nil).to_a).to eq(["Ford", nil, nil])
  end
end

context "Struct#values" do
  specify "is an alias of Struct#to_a" do
    car = Car.new(make: "Geo", model: "Metro", year: 1995)
    expect(car.values).to eq(car.to_a)
  end
end

context "Struct#to_h" do
  specify "returns a Hash with members as keys" do
    car = Car.new(make: "Ford", model: "Ranger", year: nil)
    expect(car.to_h).to eq({make: "Ford", model: "Ranger", year: nil})
  end

  describe "with block" do
    specify "converts [key, value] pairs returned by the block to a hash" do
      car = Car.new(make: "Ford", model: "Ranger", year: "2001")
      converted = car.to_h { |key, value| [key.to_s, "#{value}".downcase] }
      expect(converted).to eq({"make" => "ford", "model" => "ranger", "year" => "2001"})
    end

    specify "passes to a block each pair's key and value as separate arguments" do
      ruby = Ruby.new(version: "3.2.4", platform: "macos")
      mutable seen = []
      ruby.to_h do |key, value|
        seen << [key, value]
        [key, value]
      end
      expect(seen.sort).to eq([[:platform, "macos"], [:version, "3.2.4"]])
    end
  end
end

context "Struct#members" do
  specify "returns an array of attribute names" do
    expect(Car.new(make: nil, model: nil, year: nil).members).to eq([:make, :model, :year])
    expect(Car.new(make: "Cadillac", model: nil, year: nil).members).to eq([:make, :model, :year])
  end
end

context "Struct#size" do
  specify "returns the number of attributes" do
    expect(Car.new(make: "Cadillac", model: "DeVille", year: nil).length).to eq(3)
    expect(Car.new(make: nil, model: nil, year: nil).length).to eq(3)
  end
end

context "Struct#length" do
  specify "is an alias of Struct#size" do
    car = Car.new(make: "Cadillac", model: "DeVille", year: nil)
    expect(car.length).to eq(car.size)
  end
end

context "Struct#each" do
  specify "passes each value to the given block" do
    car = Car.new(make: "Ford", model: "Ranger", year: nil)
    mutable seen = []
    car.each { |value| seen << value }
    expect(seen).to eq(car.to_a)
  end

  specify "returns self if passed a block" do
    car = Car.new(make: "Ford", model: "Ranger", year: nil)
    expect(car.each { }).to eq(car)
  end
end

context "Struct#each_pair" do
  specify "passes each key value pair to the given block" do
    car = Car.new(make: "Ford", model: "Ranger", year: 2001)
    mutable seen = []
    car.each_pair { |key, value| seen << [key, value] }
    expect(seen).to eq([[:make, "Ford"], [:model, "Ranger"], [:year, 2001]])
  end

  specify "returns self if passed a block" do
    car = Car.new(make: "Ford", model: "Ranger", year: 2001)
    expect(car.each_pair { }).to eq(car)
  end
end

context "Struct#select" do
  specify "returns a new array of elements for which block is true" do
    car = Car.new(make: "Toyota", model: "Tercel", year: "2000")
    expect(car.select { |value| value == "2000" }).to eq(["2000"])
  end
end

context "Struct#filter" do
  specify "is an alias of Struct#select" do
    car = Car.new(make: "Toyota", model: "Tercel", year: "2000")
    expect(car.filter { |value| value == "2000" }).to eq(car.select { |value| value == "2000" })
  end
end

context "a field named for a view" do
  specify "does not override the instance accessor method" do
    expect(Sized.new(size: 42).size).to eq(42)
  end
end
