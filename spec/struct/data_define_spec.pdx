# `Name = Data.define(:a, :b)` at a file's or a module's top level declares
# `struct Name` (ADR 0084), the same many-names-one-behavior move as
# `class`; a `do … end` block on it is the struct body. Construction,
# `with`, equality, `to_h`, and `members` are the struct's own. From
# ruby/spec core/data: define, initialize (the keyword rows), with, to_h,
# equal_value, eql, members, and to_s — positional construction refuses
# naming the keywords (ADR 0062), string keywords are the implicit-conversion
# protocol (ADR 0036), `inspect` is the struct's rendering rather than
# `#<data …>` (ADR 0026), and the anonymous, subclassing, and
# overridden-initialize rows build classes at runtime.

require_relative "../spec_helper"

module DataSpecs
  Measure = Data.define(:amount, :unit)
  Single = Data.define(:value)
  Empty = Data.define()
end

Movie = Data.define(:title, :year) do
  def title_with_year = "#{title} (#{year})"

  def self.classic = Movie.new(title: "Metropolis", year: 1927)
end

context "Data.define" do
  specify "accepts no arguments" do
    expect(DataSpecs::Empty.new.members).to eq([])
  end

  specify "accepts symbols" do
    expect(DataSpecs::Measure.new(amount: 42, unit: "km").members).to eq([:amount, :unit])
  end

  specify "accepts a block" do
    movie = Movie.new(title: "Matrix", year: 1999)
    expect(movie.members).to eq([:title, :year])
    expect(movie.title_with_year).to eq("Matrix (1999)")
    expect(Movie.classic.year).to eq(1927)
  end
end

context "Data#initialize" do
  specify "accepts keyword arguments" do
    data = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(data.amount).to eq(42)
    expect(data.unit).to eq("km")
  end

  specify "supports Data with no fields" do
    expect(DataSpecs::Empty.new).to eq(DataSpecs::Empty.new)
  end
end

context "Data#with" do
  specify "returns self if given no arguments" do
    data = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(data.with).to eq(data)
  end

  specify "accepts keyword arguments" do
    data = DataSpecs::Measure.new(amount: 42, unit: "km").with(amount: 4, unit: "m")
    expect(data.amount).to eq(4)
    expect(data.unit).to eq("m")
  end
end

context "Data#to_h" do
  specify "transforms the data object into a hash" do
    expect(DataSpecs::Measure.new(amount: 42, unit: "km").to_h).to eq({amount: 42, unit: "km"})
  end
end

context "Data#== and Data#eql?" do
  specify "answer true for the same fields" do
    a = DataSpecs::Measure.new(amount: 42, unit: "km")
    b = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(a == b).to eq(true)
    expect(a.eql?(b)).to eq(true)
  end

  specify "answer false for different fields, and for a different type" do
    a = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(a == DataSpecs::Measure.new(amount: 42, unit: "mi")).to eq(false)
    expect(a == Movie.new(title: "42", year: 1)).to eq(false)
    expect(a.eql?(DataSpecs::Measure.new(amount: 42.0, unit: "km"))).to eq(false)
  end
end

context "Data#members" do
  specify "returns an array of attribute names" do
    expect(DataSpecs::Single.new(value: 1).members).to eq([:value])
  end
end

context "Data#to_s" do
  specify "renders as the struct's constructor reads" do
    expect(DataSpecs::Measure.new(amount: 42, unit: "km").to_s).to eq('DataSpecs::Measure(amount: 42, unit: "km")')
    expect(inspect(DataSpecs::Measure.new(amount: 42, unit: "km"))).to eq('DataSpecs::Measure(amount: 42, unit: "km")')
  end
end
