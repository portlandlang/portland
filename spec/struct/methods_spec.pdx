# Inside a method, bare names resolve locals → fields → own methods →
# top-level methods; `self` is the receiver, for the pass-myself-along case.

require_relative "../spec_helper"

def frame(text)
  "[#{text}]"
end

def handed_off(token)
  token.kind
end

struct Token
  kind
  text

  def integer?
    kind == "integer"
  end

  def framed
    frame(shown_kind)
  end

  def shown_kind
    kind.upcase
  end

  def renamed(new_text)
    self.with(text: new_text)
  end

  def handed_to(other)
    other.text
  end

  def paired
    handed_off(self)
  end
end

context "a struct" do
  describe "its methods" do
    token = Token.new(kind: "integer", text: "42")

    specify "reach fields bare" do
      expect(token.integer?).to(be_true)
    end

    specify "reach their own methods and top-level methods bare" do
      expect(token.framed).to(eq("[INTEGER]"))
    end

    specify "reach `with` through self" do
      expect(token.renamed("43").text).to(eq("43"))
    end

    specify "take other structs as arguments" do
      expect(token.handed_to(Token.new(kind: "word", text: "pdx"))).to(eq("pdx"))
    end

    specify "hand self along" do
      expect(token.paired).to(eq("integer"))
    end
  end
end
