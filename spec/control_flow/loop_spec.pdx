# `loop do ... end` — `while true` in Ruby's favorite clothes (ADR 0037,
# revised same-day: first declined, then wanted). A keyword form, not a
# method, desugared at parse to the while node — so break, next, and the
# per-iteration scope rule are `while`'s by construction, and only the
# `do` block shape exists (`loop` alone refuses naming the rewrite).

require_relative "../spec_helper"

context "control flow" do
  describe "loop" do
    specify "runs until break leaves it" do
      mutable count = 0
      loop do
        count += 1
        break if count > 2
      end
      expect(count).to eq(3)
    end

    specify "next skips to the following spin" do
      mutable evens = 0
      mutable seen = 0
      loop do
        seen += 1
        break if seen > 6
        next if seen.odd?
        evens += 1
      end
      expect(evens).to eq(3)
    end
  end
end

# From ruby/spec language/loop_spec.rb. A loop is a statement, so the rows
# that read break's value out of it stay upstream (ADR 0037), as do the redo
# rows and the scope row, whose miss is a compile-time refusal here.
context "The loop expression" do
  specify "repeats the given block until a break is called" do
    mutable outer_loop = 0
    loop do
      outer_loop += 1
      break if outer_loop == 10
    end
    expect(outer_loop).to eq(10)
  end

  specify "skips to end of body with next" do
    mutable seen = []
    mutable index = 0
    loop do
      index += 1
      break if index >= 5
      next if index == 3
      seen << index
    end
    expect(seen).to eq([1, 2, 4])
  end
end
