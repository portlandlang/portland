# `while`, its negated twin `until`, and `loop do` — `while true` in Ruby's
# favorite clothes (ADR 0037); everything else iterates with a block.

require_relative "../spec_helper"

# ADR 0012 — a loop that never produced a value answers nil, typed.
def finished_loop
  while false
  end
end

context "control flow" do
  describe "while" do
    specify "loops until its condition turns" do
      mutable count = 0
      while count < 3
        count += 1
      end
      expect(count).to eq(3)
    end

    specify "break stops it and next skips an iteration" do
      mutable sum = 0
      mutable i = 0
      while i < 10
        i += 1
        next if i.even?
        break if i > 7
        sum += i
      end
      expect(sum).to eq(16)
    end

    # ADR 0001 — the block rule applied to `while`: a name first bound in
    # the body dies each iteration, so binding it again is not a rebinding.
    specify "gives each iteration a fresh scope for its own locals" do
      mutable index = 0
      while index < 3
        fresh = index * 2
        index += 1
      end
      expect(index).to eq(3)
    end

    specify "produces nil when it finishes" do
      expect(finished_loop).to be_nil
    end
  end
end

# From ruby/spec language/while_spec.rb. A loop is a statement (ADR 0037),
# so the rows reading its value or break's stay upstream, with the
# `begin ... end while` do-while rows and the redo rows; a name first
# bound in the body dies each iteration (ADR 0001), so the containing-scope
# rows stay upstream; the optional `do` waits on #165.
context "The while expression" do
  specify "runs while the expression is true" do
    mutable index = 0
    while index < 3
      index += 1
    end
    expect(index).to eq(3)
  end

  specify "stops running body if interrupted by break" do
    mutable index = 0
    while index < 10
      index += 1
      break if index > 5
    end
    expect(index).to eq(6)
  end

  specify "skips to end of body with next" do
    mutable seen = []
    mutable index = 0
    while index < 4
      index += 1
      next if index == 3
      seen << index
    end
    expect(seen).to eq([1, 2, 4])
  end
end

context "The while modifier" do
  specify "runs preceding statement while the condition is true" do
    mutable index = 0
    index += 1 while index < 3
    expect(index).to eq(3)
  end

  specify "does not run preceding statement if the condition is false" do
    mutable index = 0
    index += 1 while false
    expect(index).to eq(0)
  end
end
