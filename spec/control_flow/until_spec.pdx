# `until` — `while`'s negated twin (ADR 0037), the way `unless` is `if`'s.
# Parses as a `while` with the condition wrapped in `not`; no new node, no
# new semantics. Ruby's `begin ... end until` do-while mode cannot import:
# there is no `begin` for it to attach to, so every until is pre-checked.
# `loop do` lives in loop_spec.pdx.

require_relative "../spec_helper"

context "control flow" do
  describe "until" do
    specify "loops while its condition stays false" do
      mutable count = 0
      until count > 2
        count += 1
      end
      expect(count).to eq(3)
    end

    specify "whose condition starts true never runs" do
      mutable touched = false
      until true
        touched = true
      end
      expect(touched).to be_false
    end
  end

  describe "the postfix loop modifiers" do
    specify "while repeats the one statement" do
      mutable index = 0
      index += 1 while index < 3
      expect(index).to eq(3)
    end

    specify "until repeats it toward the condition" do
      mutable back = 5
      back -= 1 until back < 3
      expect(back).to eq(2)
    end

    specify "are pre-checked, never do-while" do
      mutable ran = false
      ran = true while false
      ran = true until true
      expect(ran).to be_false
    end
  end
end

# From ruby/spec language/until_spec.rb, the same way while_spec.pdx takes
# its file: the value, do-while, redo, and containing-scope rows stay
# upstream, and the optional `do` waits on #165.
context "The until expression" do
  specify "runs while the expression is false" do
    mutable index = 0
    until index > 9
      index += 1
    end
    expect(index).to eq(10)
  end

  specify "stops running body if interrupted by break" do
    mutable index = 0
    until index > 9
      index += 1
      break if index > 5
    end
    expect(index).to eq(6)
  end

  specify "skips to end of body with next" do
    mutable seen = []
    mutable index = 0
    until index >= 4
      index += 1
      next if index == 3
      seen << index
    end
    expect(seen).to eq([1, 2, 4])
  end
end

context "The until modifier" do
  specify "runs preceding statement while the condition is false" do
    mutable index = 0
    index += 1 until index > 9
    expect(index).to eq(10)
  end

  specify "does not run preceding statement if the condition is true" do
    mutable index = 0
    index += 1 until true
    expect(index).to eq(0)
  end
end
