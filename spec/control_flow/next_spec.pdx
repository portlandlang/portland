# `next` ends one pass of a block; `break` and `return` are unwinding_spec's.

require_relative "../spec_helper"

context "control flow" do
  describe "next inside a block" do
    specify "skips just that iteration" do
      mutable collected = []
      [1, 2, 3, 4].each do |n|
        next if n.even?
        collected << n
      end
      expect(collected).to(eq([1, 3]))
    end
  end
end
