# From ruby/spec language/keyword_arguments_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../spec_helper"

def tag(name:, level: 1)
  "#{name}@#{level}"
end
def box(width, height: width)
  width * height
end
def pair(first:, second:)
  [first, second]
end

context "Keyword arguments" do
  specify "fill in a declared default" do
    expect(tag(name: "pdx")).to eq("pdx@1")
  end

  specify "take arguments in any order" do
    expect(tag(level: 3, name: "swap")).to eq("swap@3")
  end

  specify "may default to an earlier parameter" do
    expect(box(3)).to eq(9)
    expect(box(3, height: 2)).to eq(6)
  end

  describe "omitted values" do
    specify "accepts short notation 'key' for 'key: value' syntax" do
      first = 1
      second = 2

      expect(pair(first:, second:)).to eq([1, 2])
    end
  end
end
