# From ruby/spec language/regexp/empty_checks_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

def found(pattern, text) = (pattern.match(text) or panic("no match for #{inspect(pattern)} on #{inspect(text)}")).to_a

context "empty checks in Regexps" do
  specify "allow extra empty iterations" do
    expect(found(/()??/, "")).to eq(["", nil])
    expect(found(/(a*?)?/, "")).to eq(["", ""])
    expect(found(/(a*)??/, "")).to eq(["", nil])
    expect(found(/(a*?)*/, "")).to eq(["", ""])
    expect(found(/(a*)*?/, "")).to eq(["", nil])
  end

  specify "make the pattern proceed past the quantified expression on failure" do
    expect(found(/(?:|a)*/, "aaa")).to eq([""])
    expect(found(/(?:()|a)*/, "aaa")).to eq(["", ""])
    expect(found(/(|a)*/, "aaa")).to eq(["", ""])
    expect(found(/()\1(?:|a)*/, "aaa")).to eq(["", ""])
    expect(found(/(?:(?=a)|a)*/, "aaa")).to eq([""])
    expect(found(/(?:|a)*?/, "aaa")).to eq([""])
    expect(found(/(|a)*?/, "aaa")).to eq(["", nil])
  end

  specify "allow empty iterations in the middle of a loop" do
    expect(found(/(a|\2b|())*/, "aaabbb")).to eq(["aaabbb", "", ""])
    expect(found(/(a|\2b|()){2,4}/, "aaabbb")).to eq(["aaa", "", ""])
    expect(found(/(a|\2b|())*?/, "aaabbb")).to eq(["", nil, nil])
  end
end
