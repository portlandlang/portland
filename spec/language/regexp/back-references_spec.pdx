# From ruby/spec language/regexp/back-references_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

def found(pattern, text) = (pattern.match(text) or panic("no match for #{inspect(pattern)} on #{inspect(text)}")).to_a

context "Regexps with back-references" do
  specify "\\n refers to a previous group's match" do
    expect(found(/(foo.)\1/, "foo1foo1")).to eq(["foo1foo1", "foo1"])
    expect(/(foo.)\1/.match("foo1foo2")).to be_nil
  end

  specify "resets a nested back-reference before the outer group matches again" do
    expect(found(/(a\1?){2}/, "aaaa")).to eq(["aa", "a"])
  end

  specify "does not reset enclosed capture groups" do
    md = /((a)|(b))+/.match("ab") or panic("no match")
    expect(md.captures).to eq(["b", "a", "b"])
  end

  specify "can match an optional quote around content as the whole string" do
    expect(found(/^("|)(.*)\1$/, "x")).to eq(["x", "", "x"])
    pattern = /\A(["']?)(.*?)\1\z/
    expect(found(pattern, '"content"')).to eq(['"content"', '"', "content"])
    expect(found(pattern, "content")).to eq(["content", "", "content"])
  end

  specify "allows forward references" do
    expect(found(/(?:(\2)|(.))+/, "aa")).to eq(["aa", "a", "a"])
  end
end
