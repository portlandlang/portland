# From ruby/spec language/heredoc_spec.rb.
#
# Heredocs: another spelling of a string literal, squiggly only — which is
# what keeps `<<` the append operator everywhere else.

require_relative "../spec_helper"

# From ruby/spec language/heredoc_spec.rb, its squiggly rows, with the
# fixture module's heredocs written inline. The plain and dash openers
# refuse (ADR 0020); the backslash-continuation row and the line-number row
# stay upstream.
context "Heredoc string" do
  specify "allows HEREDOC with <<~'identifier', allowing to indent identifier and content" do
    message = <<~HEREDOC
      character density, n.:
        The number of very weird people in the office.
    HEREDOC
    expect(message).to eq("character density, n.:\n  The number of very weird people in the office.\n")
  end

  specify "trims trailing newline character for blank HEREDOC with <<~'identifier'" do
    blank = <<~HERE
    HERE
    expect(blank).to eq("")
  end

  specify "allows HEREDOC with <<~identifier, interpolated" do
    unquoted = <<~HERE
      unquoted #{"interpolated"}
    HERE
    expect(unquoted).to eq("unquoted interpolated\n")
  end

  specify 'allows HEREDOC with <<~"identifier", interpolated' do
    doublequoted = <<~"HERE"
      doublequoted #{"interpolated"}
    HERE
    expect(doublequoted).to eq("doublequoted interpolated\n")
  end

  specify "allows HEREDOC with <<~'identifier', no interpolation" do
    singlequoted = <<~'HERE'
      singlequoted #{"interpolated"}
    HERE
    expect(singlequoted).to eq("singlequoted \#{\"interpolated\"}\n")
  end

  specify "selects the least-indented line and removes its indentation from all the lines" do
    first = <<~HERE
      a
        b
          c
    HERE
    last = <<~HERE
          a
        b
      c
    HERE
    expect(first).to eq("a\n  b\n    c\n")
    expect(last).to eq("    a\n  b\nc\n")
  end

  specify "selects the least-indented line and removes its indentation from all the lines for <<~'identifier'" do
    first = <<~'HERE'
      a
        b
          c
    HERE
    last = <<~'HERE'
          a
        b
      c
    HERE
    expect(first).to eq("a\n  b\n    c\n")
    expect(last).to eq("    a\n  b\nc\n")
  end

  specify "dedents to the shallowest line" do
    sql = <<~SQL
      select *
        from roses
    SQL
    expect(sql).to eq("select *\n  from roses\n")
  end

  specify "interpolates" do
    city = "portland"
    line = <<~LINE
      hello from #{city}
    LINE
    expect(line).to eq("hello from portland\n")
  end

  specify "takes a method call on the opener" do
    city = "portland"
    shouted = <<~TEXT.upcase
      rose city
    TEXT
    expect(shouted).to eq("ROSE CITY\n")
  end

  specify "keeps the interpolation spelling as text" do
    raw = <<~'TEXT'
      no #{interpolation} here
    TEXT
    expect(raw).to contain("\#{interpolation}")
  end
end
