# `||=` — or-equals (ADR 0043, the last of #73's five spellings): sugar for
# `x = x || fallback`. On a maybe it is the or-guard's question as a rebind
# — absent takes the fallback, present is kept. On a plain Boolean it is
# boolean-or, well-typed and Ruby-identical in outcome; the guard against
# Ruby's false-clobbering trap is the *static* Boolean?-under-or check,
# deliberately deferred with the rest of the maybe refusals (ADR 0040 §3).
# `mutable` is required like every compound; an unbound name refuses.

require_relative "../spec_helper"

context "or-equals" do
  describe "on a maybe" do
    specify "fills absence with the fallback" do
      mutable name = [].first
      name ||= "friend"
      expect(name).to eq("friend")
    end

    specify "keeps a present value" do
      mutable found = [7].first
      found ||= 0
      expect(found).to eq(7)
    end

    specify "narrows — the binding is plain below" do
      mutable greeting = [].first
      greeting ||= "hi"
      expect(greeting.upcase).to eq("HI")
    end

    specify "never evaluates the right side of a hit" do
      mutable found = [7].first
      found ||= panic("unreachable")
      expect(found).to eq(7)
    end
  end

  describe "on a slot" do
    specify "fills a missing hash key and keeps a present one" do
      mutable counts = {"a" => 1}
      counts["b"] ||= 0
      counts["a"] ||= 9
      expect(counts["b"]).to eq(0)
      expect(counts["a"]).to eq(1)
    end

    specify "the arithmetic compounds work on slots too" do
      mutable scores = [10, 20]
      scores[0] += 1
      scores[1] -= 5
      expect(scores).to eq([11, 15])
    end

    specify "a stored nil beats the fallback — fetch's rule" do
      mutable stock = {"b" => nil}
      stock["b"] ||= 3
      expect(stock["b"]).to eq(some(nil))
    end

    specify "the index is any expression, evaluated once" do
      mutable counts = {}
      key = "a"
      counts[key.upcase] ||= 1
      expect(counts["A"]).to eq(1)
    end

    specify "a present slot never evaluates the right side" do
      mutable counts = {"a" => 1}
      counts["a"] ||= panic("unreachable")
      expect(counts["a"]).to eq(1)
    end
  end

  describe "on a plain Boolean" do
    specify "is boolean-or, stated as fact" do
      mutable flag = false
      flag ||= true
      expect(flag).to be_true
    end
  end
end
