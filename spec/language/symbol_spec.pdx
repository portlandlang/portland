# How a symbol may be written (ADR 0023).

require_relative "../spec_helper"

# From ruby/spec language/symbol_spec.rb. No operator symbols, no globals
# or instance variables to name, no %s or %I, and no encodings (ADR 0023);
# the interpolation rows are in from_text_spec (ADR 0071), and the is_a?
# checks become equality with themselves.
context "A Symbol literal" do
  specify "is a ':' followed by any number of valid characters" do
    name = :foo
    expect(name).to eq(:foo)
    expect(inspect(name)).to eq(":foo")
  end

  specify "is a ':' followed by any valid variable, method, or constant name" do
    [:Foo, :foo, :_, :FOO, :_Foo, :_9].each { expect(it).to eq(it) }
  end

  specify "is a ':' followed by a single- or double-quoted string that may contain otherwise invalid characters" do
    expect(inspect(:"foo bar")).to eq(':"foo bar"')
    expect(inspect(:"++")).to eq(':"++"')
    expect(inspect(:"9")).to eq(':"9"')
  end

  specify "may contain '::' in the string" do
    expect(:"Some::Class").to eq(:"Some::Class")
  end

  specify "is converted to a literal, unquoted representation if the symbol contains only valid characters" do
    expect(inspect(:"foo")).to eq(":foo")
    expect(inspect(:"Foo__9")).to eq(":Foo__9")
  end

  specify "can be an empty string" do
    expect(inspect(:"")).to eq(':""')
  end
end
