# A symbol made from text (ADR 0071, superseding ADR 0023 §3): `to_sym`
# and its twin `intern` answer a Symbol of no declared vocabulary, a
# symbol's own `to_sym` is itself, and `:"prefix_#{name}"` is the string's
# `to_sym`. From ruby/spec core/string/to_sym, core/string/intern,
# core/symbol/to_sym, core/symbol/intern, and the interpolation rows of
# language/symbol. The encoding rows describe tags a string has none of
# (ADR 0069); operator, instance-variable, and class-variable symbols are
# plain quoted names here; upstream's alias checks compare method objects,
# which a closed runtime has none of, so they ask the two answers instead.

require_relative "../spec_helper"

context "String#to_sym" do
  specify "returns the symbol corresponding to self" do
    expect("Koala".to_sym).to eq(:Koala)
    expect("cat".to_sym).to eq(:cat)
    expect("cat and dog".to_sym).to eq(:"cat and dog")
    expect("abc=".to_sym).to eq(:"abc=")
  end

  specify "does not special case operator-shaped text" do
    expect("+(binary)".to_sym).to eq(:"+(binary)")
    expect("!@".to_sym).to eq(:"!@")
  end

  specify "answers a symbol equal to the literal, usable as a hash key" do
    name = "pending"
    expect(name.to_sym == :pending).to eq(true)
    expect({pending: 1}[name.to_sym]).to eq(some(1))
    expect(inspect(name.to_sym)).to eq(":pending")
  end

  specify "keeps non-ASCII text" do
    expect("il était une fois".to_sym).to eq(:"il était une fois")
  end

  specify "answers the empty symbol for the empty string" do
    expect("".to_sym).to eq(:"")
  end
end

context "String#intern" do
  specify "is an alias of String#to_sym" do
    expect("cat".intern).to eq("cat".to_sym)
    expect("odd key".intern).to eq(:"odd key")
  end
end

context "Symbol#to_sym" do
  specify "returns self" do
    [:rubinius, :squash, :"odd key"].each { expect(it.to_sym).to eq(it) }
  end
end

context "Symbol#intern" do
  specify "is an alias of Symbol#to_sym" do
    expect(:squash.intern).to eq(:squash.to_sym)
  end
end

context "An interpolated symbol" do
  specify "is the string's to_sym" do
    name = "pending"
    expect(:"prefix_#{name}").to eq(:prefix_pending)
    expect(:"#{name}").to eq(name.to_sym)
    expect(inspect(:"foo #{1 + 1}")).to eq(':"foo 2"')
  end

  specify "takes the string's escapes" do
    expect(:"a\"b").to eq('a"b'.to_sym)
    expect(:"tab\there".length).to eq(8)
  end
end

context "A symbol made from text" do
  specify "is a case subject like any symbol" do
    answer = case "paid".to_sym
             in :paid then "receipt"
             in :pending then "wait"
             else "unknown"
             end
    expect(answer).to eq("receipt")
  end
end
