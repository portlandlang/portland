# A symbol's case changers and successor (ADR 0071): `upcase`, `downcase`,
# `capitalize`, `swapcase`, `succ`, and its twin `next` answer a symbol of
# the changed name, as Ruby's do — the string's answer, made a symbol
# again. From ruby/spec core/symbol/{upcase,downcase,capitalize,swapcase,
# succ,next}_spec.rb. Upstream's `instance_of?(Symbol)` rows ask `in
# Symbol`; its alias check compares method objects, which a closed runtime
# has none of, so it asks the two answers instead.

require_relative "../spec_helper"

context "Symbol#upcase" do
  specify "returns a Symbol" do
    expect(:glark.upcase in Symbol).to eq(true)
  end

  specify "converts lowercase ASCII characters to their uppercase equivalents" do
    expect(:lOwEr.upcase).to eq(:LOWER)
  end

  specify "capitalizes all Unicode characters" do
    expect("äöü".to_sym.upcase).to eq(:"ÄÖÜ")
    expect("aou".to_sym.upcase).to eq(:AOU)
  end

  specify "leaves non-alphabetic ASCII characters as they were" do
    expect("Glark?!?".to_sym.upcase).to eq(:"GLARK?!?")
  end
end

context "Symbol#downcase" do
  specify "returns a Symbol" do
    expect(:glark.downcase in Symbol).to eq(true)
  end

  specify "converts uppercase ASCII characters to their lowercase equivalents" do
    expect(:lOwEr.downcase).to eq(:lower)
  end

  specify "leaves lowercase Unicode characters as they were" do
    expect("àBc".to_sym.downcase).to eq(:"àbc")
  end

  specify "uncapitalizes all Unicode characters" do
    expect("ÄÖÜ".to_sym.downcase).to eq(:"äöü")
    expect("AOU".to_sym.downcase).to eq(:aou)
  end

  specify "leaves non-alphabetic ASCII characters as they were" do
    expect("Glark?!?".to_sym.downcase).to eq(:"glark?!?")
  end
end

context "Symbol#capitalize" do
  specify "returns a Symbol" do
    expect(:glark.capitalize in Symbol).to eq(true)
  end

  specify "converts the first character to uppercase if it is ASCII" do
    expect(:lower.capitalize).to eq(:Lower)
  end

  specify "leaves the first character alone if it is not an alphabetical character" do
    expect(:"£1.20".capitalize).to eq(:"£1.20")
  end

  specify "capitalizes the first character if it is Unicode" do
    expect(:"äöü".capitalize).to eq(:"Äöü")
    expect(:aou.capitalize).to eq(:Aou)
  end

  specify "converts subsequent uppercase ASCII characters to their lowercase equivalents" do
    expect(:lOWER.capitalize).to eq(:Lower)
  end

  specify "leaves ASCII characters already in the correct case as they were" do
    expect(:Title.capitalize).to eq(:Title)
  end

  specify "works with both upper- and lowercase ASCII characters in the same Symbol" do
    expect(:mIxEd.capitalize).to eq(:Mixed)
  end

  specify "leaves lowercase Unicode characters (except in first position) as they were" do
    expect("aßC".to_sym.capitalize).to eq(:"Aßc")
  end

  specify "leaves non-alphabetic ASCII characters as they were" do
    expect("Glark?!?".to_sym.capitalize).to eq(:"Glark?!?")
  end
end

context "Symbol#swapcase" do
  specify "returns a Symbol" do
    expect(:glark.swapcase in Symbol).to eq(true)
  end

  specify "converts lowercase ASCII characters to their uppercase equivalents" do
    expect(:lower.swapcase).to eq(:LOWER)
  end

  specify "converts uppercase ASCII characters to their lowercase equivalents" do
    expect(:UPPER.swapcase).to eq(:upper)
  end

  specify "works with both upper- and lowercase ASCII characters in the same Symbol" do
    expect(:mIxEd.swapcase).to eq(:MiXeD)
  end

  specify "swaps the case for Unicode characters" do
    expect("äÖü".to_sym.swapcase).to eq(:"ÄöÜ")
    expect("aOu".to_sym.swapcase).to eq(:AoU)
  end

  specify "leaves non-alphabetic ASCII characters as they were" do
    expect("Glark?!?".to_sym.swapcase).to eq(:"gLARK?!?")
  end
end

context "Symbol#succ" do
  specify "returns a successor" do
    expect(:abcd.succ).to eq(:abce)
    expect(:THX1138.succ).to eq(:THX1139)
  end

  specify "propagates a 'carry'" do
    expect(:"1999zzz".succ).to eq(:"2000aaa")
    expect(:ZZZ9999.succ).to eq(:AAAA0000)
  end

  specify "increments non-alphanumeric characters when no alphanumeric characters are present" do
    expect(:"<<koala>>".succ).to eq(:"<<koalb>>")
    expect(:"***".succ).to eq(:"**+")
  end
end

context "Symbol#next" do
  specify "is an alias of Symbol#succ" do
    expect(:abcd.next).to eq(:abcd.succ)
  end
end
