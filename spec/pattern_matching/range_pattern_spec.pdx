# A range pattern tests membership, not equality (ADR 0019 §1).
#
# Writing the first of these is what found that the trio could not match a
# range pattern at all (#40) — it lived as a comment until both oracles
# agreed.

require_relative "../spec_helper"

context "case/in" do
  describe "a range pattern" do
    specify "matches by membership, exclusive end honored" do
      expect((5 in 1..9)).to(be_true)
      expect((5 in 1...5)).to(be_false)
    end

    specify "may run beginless or endless" do
      edges = case 50
      in ..0  then "low"
      in 1..9 then "single"
      in 10.. then "high"
      end
      expect(edges).to(eq("high"))
    end
  end
end
