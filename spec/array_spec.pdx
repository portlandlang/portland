# Arrays: the literal, the word-array shorthand, and the read-only library.

require_relative "spec_helper"

context "Array" do
  describe "the literal" do
    specify "holds any mix of types, nesting included" do
      expect([1, "two", [3]]).to(have_length(3))
    end

    specify "has a %w shorthand for words" do
      expect(%w[rose city]).to(eq(["rose", "city"]))
    end

    specify "a backslash escapes a bracket into a word" do
      expect(%w[a \] b \[ c]).to(eq(["a", "]", "b", "[", "c"]))
    end

    specify "balanced brackets nest without escapes" do
      expect(%w[a [b] c]).to(eq(["a", "[b]", "c"]))
    end

    specify "an escaped space joins a word instead of splitting" do
      expect(%w[rose\ city elsewhere]).to(eq(["rose city", "elsewhere"]))
    end

    specify "any other escape keeps its backslash" do
      expect(%w[a\nb].first).to(have_length(4))
    end

    specify "whitespace runs split once, never into empty words" do
      expect(%w[rose  city]).to(eq(["rose", "city"]))
    end
  end

  describe "the operators" do
    specify "+ concatenates" do
      expect([1, 2] + [3]).to(eq([1, 2, 3]))
    end

    specify "* repeats" do
      expect([0] * 3).to(eq([0, 0, 0]))
    end
  end

  describe "the library" do
    numbers = [3, 1, 2]

    specify "measures length" do
      expect(numbers).to(have_length(3))
    end

    specify "answers empty? only for the empty array" do
      expect(numbers).not_to(be_empty)
    end

    specify "joins on a separator" do
      expect(numbers.join("-")).to(eq("3-1-2"))
    end

    specify "answers include?" do
      expect(numbers).to(contain(2))
    end

    specify "sums" do
      expect(numbers.sum).to(eq(6))
    end

    specify "sorts into a new array, leaving the original alone" do
      expect(numbers.sort).to(eq([1, 2, 3]))
    end

    specify "slices by start and length" do
      expect(numbers.slice(0, 2)).to(eq([3, 1]))
    end
  end

  # ADR 0010 — first, last, min, and max are partial, so each answers a
  # maybe. The empty-array halves live in optionals_spec; these are the
  # present halves.
  describe "the partial methods, on a present value" do
    numbers = [3, 1, 2]

    specify "first and last answer the ends" do
      expect(numbers.first).to(eq(3))
      expect(numbers.last).to(eq(2))
    end

    specify "min and max answer the extremes" do
      expect(numbers.min).to(eq(1))
      expect(numbers.max).to(eq(3))
    end
  end

  describe "#[]" do
    numbers = [3, 1, 2]

    specify "counts negative indices from the end" do
      expect(numbers[0 - 1]).to(eq(2))
    end
  end
end
