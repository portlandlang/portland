# ADR 0028 — a `trait` is a bundle of methods with no state, and a struct
# `include`s it. Ruby's verb, safe because the noun is new.

require_relative "../spec_helper"

trait Describable
  def label
    "#{kind}: #{text}"
  end
end

trait Sized
  def size_note
    "#{text.length} characters"
  end
end

struct Token
  kind
  text

  include Describable
  include Sized

  def brief
    text
  end
end

context "a trait" do
  token = Token.new(kind: "word", text: "pdx")

  describe "include" do
    specify "hands its methods to the carrier" do
      expect(token.label).to eq("word: pdx")
    end

    specify "sits beside the struct's own methods, two traits at once" do
      expect(token.brief).to eq("pdx")
      expect(token.label).to eq("word: pdx")
      expect(token.size_note).to eq("3 characters")
    end
  end
end
