# ADR 0010 — `min` and `max` are partial too, and answer maybes.

require_relative "../spec_helper"

context "Array" do
  numbers = [3, 1, 2]

  describe "#min" do
    specify "answers the smallest" do
      expect(numbers.min).to eq(1)
    end
  end

  describe "#max" do
    specify "answers the largest" do
      expect(numbers.max).to eq(3)
    end
  end

  describe "the extremes beyond whole numbers" do
    specify "compare floats numerically" do
      expect([1.5, 0.5, 2.25].min).to eq(0.5)
      expect([1.5, 0.5, 2.25].max).to eq(2.25)
    end

    specify "answer the element itself across the integer/float line" do
      expect([1, 2.5].min).to eq(1)
      expect([1, 2.5].max).to eq(2.5)
    end

    specify "compare strings alphabetically" do
      expect(["pear", "apple"].min).to eq("apple")
      expect(["pear", "apple"].max).to eq("pear")
    end

    specify "of nothing are absent" do
      expect([].min).to be_nil
      expect([].max).to be_nil
    end
  end
end

# ruby/spec core/array/max_spec.rb and min_spec.rb, title for title
# (#104), with the Enumerable examples upstream copies in. Staying
# upstream: the method-owner check (reflection), the one-parameter block
# (a comparator here takes two), the nil-holding array ordered through
# truthiness, and the refusals where Ruby raises.

context "Array#max" do
  strings = ["333", "22", "666666", "1", "55555", "1010101010"]
  integers = [333, 22, 666666, 55555, 1010101010]

  specify "returns nil with no values" do
    expect([].max).to eq(nil)
  end

  specify "returns only element in one element array" do
    expect([1].max).to eq(1)
  end

  specify "returns largest value with multiple elements" do
    expect([1, 2].max).to eq(2)
    expect([2, 1].max).to eq(2)
  end

  specify "max should return the maximum element" do
    expect([18, 42].max).to eq(42)
    expect([2, 5, 3, 6, 1, 4].max).to eq(6)
  end

  specify "returns the maximum element (basics cases)" do
    expect([55].max).to eq(55)
    expect([11, 99].max).to eq(99)
    expect([99, 11].max).to eq(99)
    expect([2, 33, 4, 11].max).to eq(33)
    expect([1, 2, 3, 4, 5].max).to eq(5)
    expect([5, 4, 3, 2, 1].max).to eq(5)
    expect([1, 4, 3, 5, 2].max).to eq(5)
    expect([5, 5, 5, 5, 5].max).to eq(5)
    expect(["aa", "tt"].max).to eq("tt")
    expect(["tt", "aa"].max).to eq("tt")
    expect(["2", "33", "4", "11"].max).to eq("4")
    expect(strings.max).to eq("666666")
    expect(integers.max).to eq(1010101010)
  end

  specify "returns nil for an empty Enumerable" do
    expect([].max).to eq(nil)
  end

  specify "returns the maximum element (with block)" do
    expect(["2", "33", "4", "11"].max { |left, right| left <=> right }).to eq("4")
    expect([2, 33, 4, 11].max { |left, right| left <=> right }).to eq(33)
    expect(["2", "33", "4", "11"].max { |left, right| right <=> left }).to eq("11")
    expect([2, 33, 4, 11].max { |left, right| right <=> left }).to eq(2)
    expect(strings.max { |left, right| left.length <=> right.length }).to eq("1010101010")
    expect(strings.max { |left, right| left <=> right }).to eq("666666")
    expect(strings.max { |left, right| left.to_i <=> right.to_i }).to eq("1010101010")
    expect(integers.max { |left, right| left <=> right }).to eq(1010101010)
    expect(integers.max { |left, right| left.to_s <=> right.to_s }).to eq(666666)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    multi = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    expect(multi.max).to eq([6, 7, 8, 9])
  end
end

context "Array#min" do
  strings = ["333", "22", "666666", "1", "55555", "1010101010"]
  integers = [333, 22, 666666, 55555, 1010101010]

  specify "returns nil with no values" do
    expect([].min).to eq(nil)
  end

  specify "returns only element in one element array" do
    expect([1].min).to eq(1)
  end

  specify "returns smallest value with multiple elements" do
    expect([1, 2].min).to eq(1)
    expect([2, 1].min).to eq(1)
  end

  specify "min should return the minimum element" do
    expect([18, 42].min).to eq(18)
    expect([2, 5, 3, 6, 1, 4].min).to eq(1)
  end

  specify "returns the minimum (basic cases)" do
    expect([55].min).to eq(55)
    expect([11, 99].min).to eq(11)
    expect([99, 11].min).to eq(11)
    expect([2, 33, 4, 11].min).to eq(2)
    expect([1, 2, 3, 4, 5].min).to eq(1)
    expect([5, 4, 3, 2, 1].min).to eq(1)
    expect([4, 1, 3, 5, 2].min).to eq(1)
    expect([5, 5, 5, 5, 5].min).to eq(5)
    expect(["aa", "tt"].min).to eq("aa")
    expect(["tt", "aa"].min).to eq("aa")
    expect(["2", "33", "4", "11"].min).to eq("11")
    expect(strings.min).to eq("1")
    expect(integers.min).to eq(22)
  end

  specify "returns nil for an empty Enumerable" do
    expect([].min).to eq(nil)
  end

  specify "returns the minimum when using a block rule" do
    expect(["2", "33", "4", "11"].min { |left, right| left <=> right }).to eq("11")
    expect([2, 33, 4, 11].min { |left, right| left <=> right }).to eq(2)
    expect(["2", "33", "4", "11"].min { |left, right| right <=> left }).to eq("4")
    expect([2, 33, 4, 11].min { |left, right| right <=> left }).to eq(33)
    expect([1, 2, 3, 4].min { |left, right| 15 }).to eq(1)
    expect([11, 12, 22, 33].min { |left, right| 2 }).to eq(11)
    mutable counter = -2
    expect([11, 12, 22, 33].min { |left, right| counter += 1 }).to eq(12)
    expect(strings.min { |left, right| left.length <=> right.length }).to eq("1")
    expect(strings.min { |left, right| left <=> right }).to eq("1")
    expect(strings.min { |left, right| left.to_i <=> right.to_i }).to eq("1")
    expect(integers.min { |left, right| left <=> right }).to eq(22)
    expect(integers.min { |left, right| left.to_s <=> right.to_s }).to eq(1010101010)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    multi = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    expect(multi.min).to eq([1, 2])
  end
end
