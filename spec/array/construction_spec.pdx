# Building an array by count (ADR 0058, #104), from ruby/spec core/array:
# Array.new in its arities. Staying upstream: instance_of? and identity
# checks (a closed runtime, values that never mutate), subclasses, to_int
# and to_ary conversion (ADR 0036), the refusals where Ruby raises, a fill
# beside a block (Ruby warns and lets the block win; Portland refuses), and
# break with a value (ADR 0012).

require_relative "../spec_helper"

context "Array.new with no arguments" do
  specify "returns an empty array" do
    expect(Array.new.empty?).to eq(true)
  end
end

context "Array.new with (array)" do
  specify "returns an array initialized to the other array" do
    other = [4, 5, 6]
    expect(Array.new(other)).to eq(other)
  end
end

context "Array.new with (size, object=nil)" do
  specify "returns an array of size filled with object" do
    fill = [3]
    expect(Array.new(2, fill)).to eq([fill, fill])
    expect(Array.new(3, 14)).to eq([14, 14, 14])
  end

  specify "returns an array of size filled with nil when object is omitted" do
    expect(Array.new(3)).to eq([nil, nil, nil])
  end

  specify "yields the index of the element and sets the element to the value of the block" do
    expect(Array.new(3) { |index| index.to_s }).to eq(["0", "1", "2"])
  end
end
