# The answers-a-new-array family — none built yet, held pending (#23).
#
# From ruby/spec core/array/{reverse,uniq,flatten,compact}_spec.rb. Their
# bang twins (`reverse!`, `uniq!`, ...) stay behind forever: values never
# mutate (ADR 0015), and the ledger owns that story.

require_relative "../spec_helper"

context "Array" do
  describe "the transforms" do
    pending "Array#reverse — no builtin yet (the string twin exists)" do
      expect([3, 1, 2].reverse).to eq([2, 1, 3])
    end

    pending "Array#uniq — no builtin yet; keeps first occurrences in order" do
      expect([1, 1, 3, 2, 3].uniq).to eq([1, 3, 2])
    end

    pending "Array#flatten — no builtin yet" do
      expect([[1], [2, 3]].flatten).to eq([1, 2, 3])
    end

    pending "Array#compact — no builtin yet; drops the nils" do
      expect([1, nil, 2].compact).to eq([1, 2])
    end
  end
end
