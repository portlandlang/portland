# `sum` adds the elements up.

require_relative "../spec_helper"

context "Array" do
  describe "#sum" do
    specify "adds the elements" do
      expect([3, 1, 2].sum).to eq(6)
    end

    specify "answers zero for the empty array" do
      expect([].sum).to eq(0)
    end

    specify "adds floats, and one float makes the total a float" do
      expect([1.5, 0.5, 2.25].sum).to eq(4.25)
      expect([1, 2.5].sum).to eq(3.5)
    end
  end
end

# ruby/spec core/array/sum_spec.rb, title for title (#104). Staying
# upstream: the TypeError rows (Portland refuses), mocks whose own + takes
# over, and the mid-walk growth rows (values never mutate).

context "Array#sum" do
  specify "returns the sum of elements" do
    expect([1, 2, 3].sum).to eq(6)
  end

  specify "applies a block to each element before adding if it's given" do
    expect([1, 2, 3].sum { |number| number * 10 }).to eq(60)
  end

  specify "doesn't apply the block init" do
    expect([1, 2, 3].sum(1) { |number| number * 10 }).to eq(61)
  end

  specify "uses Kahan's compensated summation algorithm for precise sum of float numbers" do
    floats = [2.7800000000000002, 5.0, 2.5, 4.44, 3.89, 3.89, 4.44, 7.78, 5.0, 2.7800000000000002, 5.0, 2.5]
    naive_sum = floats.reduce(0.0) { |total, element| total + element }
    expect(naive_sum).to eq(50.00000000000001)
    expect(floats.sum).to eq(50.0)
  end

  specify "handles infinite values and NaN" do
    expect([1.0, Float::INFINITY].sum).to eq(Float::INFINITY)
    expect([1.0, -Float::INFINITY].sum).to eq(-Float::INFINITY)
    expect([1.0, Float::NAN].sum.nan?).to eq(true)
    expect([Float::INFINITY, 1.0].sum).to eq(Float::INFINITY)
    expect([-Float::INFINITY, 1.0].sum).to eq(-Float::INFINITY)
    expect([Float::NAN, 1.0].sum.nan?).to eq(true)
    expect([Float::NAN, Float::INFINITY].sum.nan?).to eq(true)
    expect([Float::INFINITY, Float::NAN].sum.nan?).to eq(true)
    expect([Float::INFINITY, -Float::INFINITY].sum.nan?).to eq(true)
    expect([-Float::INFINITY, Float::INFINITY].sum.nan?).to eq(true)
    expect([Float::INFINITY, Float::INFINITY].sum).to eq(Float::INFINITY)
    expect([-Float::INFINITY, -Float::INFINITY].sum).to eq(-Float::INFINITY)
    expect([Float::NAN, Float::NAN].sum.nan?).to eq(true)
  end

  specify "returns init value if array is empty" do
    expect([].sum(-1)).to eq(-1)
  end

  specify "returns 0 if array is empty and init is omitted" do
    expect([].sum).to eq(0)
  end

  specify "adds init value to the sum of elements" do
    expect([1, 2, 3].sum(10)).to eq(16)
  end

  specify "can be used for non-numeric objects by providing init value" do
    expect(["a", "b", "c"].sum("")).to eq("abc")
  end
end
