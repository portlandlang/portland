# `slice` takes a start and a length. The range spelling lives in
# spec/range/slicing_spec.pdx, since there the range is the subject.

require_relative "../spec_helper"

context "Array" do
  describe "#slice" do
    specify "takes a start and a length" do
      expect([3, 1, 2].slice(0, 2)).to eq([3, 1])
    end

    specify "stops at the end rather than running past it" do
      expect([3, 1, 2].slice(1, 99)).to eq([1, 2])
    end
  end
end
