# `slice` takes a start and a length. The range spelling's house examples
# live in spec/range/slicing_spec.pdx, since there the range is the
# subject; its ruby/spec rows are below.
#
# From ruby/spec core/array/element_reference_spec.rb's count and range
# rows. A slice is a collection, never a maybe (ADR 0019): where Ruby
# answers nil for a start past the end, Portland answers the empty array,
# and those rows are reworded; a negative count refuses; `[index, count]`
# is spelled `slice(index, count)`. The to_int, subclass, and
# independence rows stay upstream, and slice! is a mutator (ADR 0015).

require_relative "../spec_helper"

context "Array" do
  describe "#slice" do
    specify "takes a start and a length" do
      expect([3, 1, 2].slice(0, 2)).to eq([3, 1])
    end

    specify "stops at the end rather than running past it" do
      expect([3, 1, 2].slice(1, 99)).to eq([1, 2])
    end
  end
end

context "Array#[]" do
  specify "returns count elements starting from index with [index, count]" do
    expect(["a", "b", "c", "d", "e"].slice(2, 3)).to eq(["c", "d", "e"])
    four = [1, 2, 3, 4]
    expect(four.slice(0, 0)).to eq([])
    expect(four.slice(0, 1)).to eq([1])
    expect(four.slice(0, 2)).to eq([1, 2])
    expect(four.slice(0, 4)).to eq([1, 2, 3, 4])
    expect(four.slice(0, 6)).to eq([1, 2, 3, 4])
    expect(four.slice(2, 0)).to eq([])
    expect(four.slice(2, 1)).to eq([3])
    expect(four.slice(2, 2)).to eq([3, 4])
    expect(four.slice(2, 4)).to eq([3, 4])
    expect(four.slice(4, 0)).to eq([])
    expect(four.slice(4, 2)).to eq([])
    expect(four).to eq([1, 2, 3, 4])
  end

  specify "returns count elements starting at index from the end of array with [-index, count]" do
    expect(["a", "b", "c", "d", "e"].slice(-2, 2)).to eq(["d", "e"])
    four = [1, 2, 3, 4]
    expect(four.slice(-1, 0)).to eq([])
    expect(four.slice(-1, 1)).to eq([4])
    expect(four.slice(-1, 2)).to eq([4])
    expect(four.slice(-2, 0)).to eq([])
    expect(four.slice(-2, 1)).to eq([3])
    expect(four.slice(-2, 2)).to eq([3, 4])
    expect(four.slice(-2, 4)).to eq([3, 4])
    expect(four.slice(-4, 0)).to eq([])
    expect(four.slice(-4, 1)).to eq([1])
    expect(four.slice(-4, 2)).to eq([1, 2])
    expect(four.slice(-4, 4)).to eq([1, 2, 3, 4])
    expect(four.slice(-4, 6)).to eq([1, 2, 3, 4])
    expect(four).to eq([1, 2, 3, 4])
  end

  specify "returns the first count elements with [0, count]" do
    expect(["a", "b", "c", "d", "e"].slice(0, 3)).to eq(["a", "b", "c"])
  end

  specify "returns [] if the index is valid but length is zero with [index, length]" do
    expect([1, 2, 3, 4].slice(0, 0)).to eq([])
    expect([1, 2, 3, 4].slice(2, 0)).to eq([])
  end

  specify "returns [] if index == array.size with [index, length]" do
    expect([1, 2, 3, 4].slice(4, 2)).to eq([])
  end

  specify "answers [] if index > array.size with [index, length] — never nil (ADR 0019)" do
    expect([1, 2, 3, 4].slice(5, 2)).to eq([])
    expect([1, 2, 3, 4].slice(-5, 1)).to eq([])
  end

  specify "returns the elements specified by Range indexes with [m..n]" do
    expect(["a", "b", "c", "d", "e"][1..3]).to eq(["b", "c", "d"])
    expect(["a", "b", "c", "d", "e"][4..-1]).to eq(["e"])
    expect(["a", "b", "c", "d", "e"][3..3]).to eq(["d"])
    expect(["a", "b", "c", "d", "e"][3..-2]).to eq(["d"])
    expect(["a"][0..-1]).to eq(["a"])
    four = [1, 2, 3, 4]
    expect(four[0..-10]).to eq([])
    expect(four[0..0]).to eq([1])
    expect(four[0..1]).to eq([1, 2])
    expect(four[0..2]).to eq([1, 2, 3])
    expect(four[0..3]).to eq([1, 2, 3, 4])
    expect(four[0..4]).to eq([1, 2, 3, 4])
    expect(four[0..10]).to eq([1, 2, 3, 4])
    expect(four[2..-10]).to eq([])
    expect(four[2..0]).to eq([])
    expect(four[2..2]).to eq([3])
    expect(four[2..3]).to eq([3, 4])
    expect(four[2..4]).to eq([3, 4])
    expect(four[3..0]).to eq([])
    expect(four[3..3]).to eq([4])
    expect(four[3..4]).to eq([4])
    expect(four[4..0]).to eq([])
    expect(four[4..4]).to eq([])
    expect(four[4..5]).to eq([])
    expect(four).to eq([1, 2, 3, 4])
  end

  specify "returns elements specified by Range indexes except the element at index n with [m...n]" do
    expect(["a", "b", "c", "d", "e"][1...3]).to eq(["b", "c"])
    four = [1, 2, 3, 4]
    expect(four[0...-10]).to eq([])
    expect(four[0...0]).to eq([])
    expect(four[0...1]).to eq([1])
    expect(four[0...2]).to eq([1, 2])
    expect(four[0...3]).to eq([1, 2, 3])
    expect(four[0...4]).to eq([1, 2, 3, 4])
    expect(four[0...10]).to eq([1, 2, 3, 4])
    expect(four[2...-10]).to eq([])
    expect(four[2...0]).to eq([])
    expect(four[2...2]).to eq([])
    expect(four[2...3]).to eq([3])
    expect(four[2...4]).to eq([3, 4])
    expect(four[3...0]).to eq([])
    expect(four[3...3]).to eq([])
    expect(four[3...4]).to eq([4])
    expect(four[4...0]).to eq([])
    expect(four[4...4]).to eq([])
    expect(four[4...5]).to eq([])
    expect(four).to eq([1, 2, 3, 4])
  end

  specify "answers [] if range start is not in the array with [m..n] — never nil (ADR 0019)" do
    four = [1, 2, 3, 4]
    expect(four[5..0]).to eq([])
    expect(four[5..5]).to eq([])
    expect(four[5...6]).to eq([])
  end

  specify "returns elements that exist if range start is in the array but range end is not with [m..n]" do
    expect(["a", "b", "c", "d", "e"][4..7]).to eq(["e"])
  end

  specify "accepts Range instances having a negative m and both signs for n with [m..n] and [m...n]" do
    four = [1, 2, 3, 4]
    expect(four[-1..-1]).to eq([4])
    expect(four[-1...-1]).to eq([])
    expect(four[-1..3]).to eq([4])
    expect(four[-1...3]).to eq([])
    expect(four[-1..4]).to eq([4])
    expect(four[-1...4]).to eq([4])
    expect(four[-1..10]).to eq([4])
    expect(four[-1...10]).to eq([4])
    expect(four[-1..0]).to eq([])
    expect(four[-1..-4]).to eq([])
    expect(four[-1...-4]).to eq([])
    expect(four[-1..-6]).to eq([])
    expect(four[-1...-6]).to eq([])
    expect(four[-2..-2]).to eq([3])
    expect(four[-2...-2]).to eq([])
    expect(four[-2..-1]).to eq([3, 4])
    expect(four[-2...-1]).to eq([3])
    expect(four[-2..10]).to eq([3, 4])
    expect(four[-2...10]).to eq([3, 4])
    expect(four[-4..-4]).to eq([1])
    expect(four[-4..-2]).to eq([1, 2, 3])
    expect(four[-4...-2]).to eq([1, 2])
    expect(four[-4..-1]).to eq([1, 2, 3, 4])
    expect(four[-4...-1]).to eq([1, 2, 3])
    expect(four[-4..3]).to eq([1, 2, 3, 4])
    expect(four[-4...3]).to eq([1, 2, 3])
    expect(four[-4..4]).to eq([1, 2, 3, 4])
    expect(four[-4...4]).to eq([1, 2, 3, 4])
    expect(four[-4..0]).to eq([1])
    expect(four[-4...0]).to eq([])
    expect(four[-4..1]).to eq([1, 2])
    expect(four[-4...1]).to eq([1])
  end

  specify "returns an empty array when m == n with [m...n]" do
    expect([1, 2, 3, 4, 5][1...1]).to eq([])
  end

  specify "returns an empty array with [0...0]" do
    expect([1, 2, 3, 4, 5][0...0]).to eq([])
  end

  specify "returns an array containing the first element with [0..0]" do
    expect([1, 2, 3, 4, 5][0..0]).to eq([1])
  end

  specify "returns the entire array with [0..-1]" do
    expect([1, 2, 3, 4, 5][0..-1]).to eq([1, 2, 3, 4, 5])
  end

  specify "returns all but the last element with [0...-1]" do
    expect([1, 2, 3, 4, 5][0...-1]).to eq([1, 2, 3, 4])
  end

  specify "returns [3] for [2..-1] out of [1, 2, 3]" do
    expect([1, 2, 3][2..-1]).to eq([3])
  end

  specify "returns an empty array when m > n and m, n are positive with [m..n]" do
    expect([1, 2, 3, 4, 5][3..2]).to eq([])
  end

  specify "returns an empty array when m > n and m, n are negative with [m..n]" do
    expect([1, 2, 3, 4, 5][-2..-3]).to eq([])
  end
end
