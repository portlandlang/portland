# `%w[]` — the word-array shorthand, with Ruby's content rules (ADR 0030).

require_relative "../spec_helper"

context "Array" do
  describe "%w[]" do
    specify "splits words on whitespace" do
      expect(%w[rose city]).to eq(["rose", "city"])
    end

    specify "a backslash escapes a bracket into a word" do
      expect(%w[a \] b \[ c]).to eq(["a", "]", "b", "[", "c"])
    end

    specify "balanced brackets nest without escapes" do
      expect(%w[a [b] c]).to eq(["a", "[b]", "c"])
    end

    specify "an escaped space joins a word instead of splitting" do
      expect(%w[rose\ city elsewhere]).to eq(["rose city", "elsewhere"])
    end

    specify "any other escape keeps its backslash" do
      expect(%w[a\nb].first).to have_length(4)
    end

    specify "whitespace runs split once, never into empty words" do
      expect(%w[rose  city]).to eq(["rose", "city"])
    end

    specify "opens with (), {}, or [] alike (ADR 0051)" do
      expect(%w(rose city)).to eq(["rose", "city"])
      expect(%w{rose city}).to eq(["rose", "city"])
    end

    # From ruby/spec language/array_spec.rb, "Bareword array literal". The
    # `%W` rows stay behind: ADR 0051 declines the interpolating form.
    specify "%w() transforms unquoted barewords into an array, never interpolating" do
      expect(%w(a #{3+a} 3)).to eq(["a", "\#{3+a}", "3"])
    end

    specify "treats consecutive whitespace characters the same as one" do
      expect(%w(a  b c  d)).to eq(["a", "b", "c", "d"])
    end

    specify "treats whitespace as literal characters when escaped by a backslash" do
      expect(%w(a b\ c d e)).to eq(["a", "b c", "d", "e"])
      expect(%w(a b\
c d)).to eq(["a", "b\nc", "d"])
    end

    specify "escapes and nests the pair it opened with, and only that pair" do
      expect(%w(a \) b (c) d)).to eq(["a", ")", "b", "(c)", "d"])
      expect(%w{a \] b}.last).to have_length(1)
      expect(%w{a \] b}).to eq(["a", "\\]", "b"])
    end
  end
end
