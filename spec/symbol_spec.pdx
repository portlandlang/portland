# A symbol is a name, not text (ADR 0023). Its enum kin live in enum_spec.

require_relative "spec_helper"

context "a symbol" do
  # ADR 0023 — comparison is equality only, and a symbol is not a String.
  describe "equality" do
    specify "holds against itself" do
      expect(:paid).to(eq(:paid))
    end

    specify "breaks against the string of its name" do
      expect(:paid).not_to(eq("paid"))
    end

    specify "breaks against any other symbol" do
      expect(:paid).not_to(eq(:pending))
    end
  end

  describe "the spellings" do
    specify "may end in a question mark, the suffix part of the name" do
      expect(:paid?).to(eq(:paid?))
      expect(:paid).not_to(eq(:paid?))
    end

    specify "take quotes when the name is not identifier-shaped" do
      expect(:"odd key").to(eq(:"odd key"))
    end
  end

  # ADR 0023 — the shorthand is the only spelling of a symbol key.
  describe "the hash shorthand" do
    specify "builds symbol keys" do
      expect({name: "pdx"}[:name]).to(eq("pdx"))
    end
  end
end
