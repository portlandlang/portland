# ADR 0021 — `::` names, `.` invokes: a rule, not a convention.

require_relative "../spec_helper"

module Statistics
  BASE = 10

  struct Summary
    mean
  end

  def scaled(value)
    value * BASE
  end
end

context "a namespace" do
  describe "the two operators" do
    specify ". invokes a module method" do
      expect(Statistics.scaled(3)).to(eq(30))
    end

    specify ":: names a constant" do
      expect(Statistics::BASE).to(eq(10))
    end

    specify "and both walk into a nested type in order" do
      expect(Statistics::Summary.new(mean: 2).mean).to(eq(2))
    end
  end
end
