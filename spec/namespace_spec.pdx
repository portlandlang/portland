# Namespaces: `module` is a place for names to live, and nothing else.

require_relative "spec_helper"

module Statistics
  BASE = 10

  struct Summary
    mean
  end

  def scaled(value)
    value * BASE
  end

  def doubled_scale(value)
    scaled(value) * 2
  end

  module Deep
    def reach(value)
      scaled(value) + BASE
    end
  end
end

# `module A::B` and nested blocks are semantically identical, which is what
# drops Ruby's `Module.nesting` trap.
module Statistics::Extra
  def lifted(value)
    scaled(value)
  end
end

MAX = 5

context "a namespace" do
  # ADR 0021 — `::` names, `.` invokes: a rule, not a convention.
  describe "the two operators" do
    specify ". invokes a module method" do
      expect(Statistics.scaled(3), 30)
    end

    specify ":: names a constant" do
      expect(Statistics::BASE, 10)
    end

    specify "and both walk into a nested type in order" do
      expect(Statistics::Summary.new(mean: 2).mean, 2)
    end
  end

  # Immutability already made constants unrebindable; a namespace is just
  # the place for the name to live — including the top level.
  describe "a constant" do
    specify "lives at the top level too" do
      expect(MAX, 5)
    end
  end

  # ADR 0021 — bare names resolve outward from where they were written.
  describe "lexical resolution" do
    specify "reaches a sibling method bare" do
      expect(Statistics.doubled_scale(3), 60)
    end

    specify "reaches outward from a nested module" do
      expect(Statistics::Deep.reach(3), 40)
    end

    specify "treats module A::B as the nested spelling" do
      expect(Statistics::Extra.lifted(2), 20)
    end
  end
end
