# Absence: what Portland does where Ruby would hand you a nil and hope.
#
# Several ADRs pull in one direction here, which is why they share a file — a
# missing thing must be distinguishable from a stored nothing, and neither may
# be mistaken for a crash.

require_relative "spec_helper"

# ADR 0008 — the or-guard: `or return` hands the early exit to the caller.
# The guard must sit inside a method, since `return` exits one; the def sits
# at the top level, where defs live.
def first_or_bail(values)
  found = values.first or return "bailed"
  found
end

context "absence" do
  # ADR 0019 — a slice is a collection, never a maybe.
  describe "Array#[] with a range" do
    words = %w[rose city]

    specify "returns an empty collection past the end, never nil" do
      expect(words[9..]).to(be_empty)
    end
  end

  # ADR 0010 — partial operations return maybes; the only crash is one you
  # typed. The subject is the rule rather than a method, because it spans
  # three of them.
  describe "a partial operation" do
    specify "answers nil for first on an empty array" do
      expect([].first).to(be_nil)
    end

    specify "answers nil for an out-of-range index" do
      expect([1, 2][9]).to(be_nil)
    end

    specify "answers nil for a missing hash key" do
      expect({name: "pdx"}[:nope]).to(be_nil)
    end
  end

  # ADR 0012 — a branch that doesn't happen produces nil.
  describe "if without a matching branch" do
    branchless = if false
      "taken"
    end

    specify "produces nil" do
      expect(branchless).to(be_nil)
    end
  end

  # ADR 0005 — the wrapper keeps a stored nil distinguishable from a missing
  # one. This pair is the whole point: both look like nil in Ruby, and must
  # not here.
  describe "Array#first" do
    stored = [nil]
    missing = []

    specify "comes back present when a nil was stored" do
      expect(stored.first).not_to(be_nil)
    end

    specify "comes back absent when the array was empty" do
      expect(missing.first).to(be_nil)
    end
  end

  # ADR 0006/0009 — `nil?` and `some?` are the one dispatch every value allows.
  describe "nil? and some?" do
    specify "call a plain value present" do
      expect(42).to(be_some)
    end

    specify "and not absent" do
      expect(42).not_to(be_nil)
    end
  end
end

context "the unwrap toolkit" do
  describe "the or-guard" do
    specify "returns early on an absent maybe" do
      expect(first_or_bail([])).to(eq("bailed"))
    end

    specify "passes a present value straight through" do
      expect(first_or_bail([5])).to(eq(5))
    end
  end

  # ADR 0008 — `&.` short-circuits an absent receiver instead of crashing,
  # and leaves a present one alone. The whole chain answers nil on a miss.
  describe "the safe-navigation operator" do
    words = %w[rose city]
    empty = []

    specify "forwards to a present receiver" do
      expect(words.first&.upcase).to(eq("ROSE"))
    end

    specify "answers nil for an absent one" do
      expect(empty.first&.upcase).to(be_nil)
    end
  end

  # ADR 0009 — `some` is identity on plain values and a real box only around
  # nil. The stored-nil rows are Ruby's `fetch` rule kept without `fetch`: a
  # hash holding an honest nil beats an or-guard default, because the miss
  # and the stored nothing are different answers.
  describe "some()" do
    specify "is identity on a plain value" do
      expect(some(5)).to(eq(5))
    end

    specify "boxes a nil into a present value" do
      expect(some(nil)).to(be_some)
    end

    specify "lets a stored hash nil beat an or-guard default" do
      notes = {note: nil}
      expect((notes[:note] or "default")).to(be_nil)
    end

    specify "while a genuinely missing key takes the default" do
      notes = {note: nil}
      expect((notes[:nope] or "default")).to(eq("default"))
    end
  end
end
