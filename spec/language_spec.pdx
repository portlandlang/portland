# Portland's language spec: the ADRs' promises, executable.
#
# This is the third oracle. The differential harness proves the seed and the
# trio agree with each other; nothing until now proved either agrees with
# what was decided. Every example here cites the ADR it pins.

#
# Deliberately tiny, and deliberately built only from what the language has
# today: no classes, no exceptions, and no instance variables — none of which
# exist yet.
#
# Two shapes live here at once, because the file is mid-migration. The shape
# it is reaching for is rubyspec's `describe`/`it`, which `yield` now makes
# possible; the rest of the examples are still values collected into an array
# and handed to `report`.
#
# What keeps the two shapes apart is no longer the trio: a block's rebindings
# now survive the block on both oracles, so accumulating into an outer
# `mutable` is safe here. What is left is narrower, and it lives in the
# language rather than in the trio — a tally has to be kept somewhere, and
# only a block can reach an outer `mutable`. A method body gets a fresh scope,
# and there are no instance variables, no class variables, and no globals, so
# `specify` and `expect` — being methods — cannot count anything. Hiding the
# bookkeeping the way rubyspec does needs state a method can reach.

struct Example
  description
  detail
  ok
end

# One example. Returns a value rather than raising, because `panic` is the
# only crash Portland has (ADR 0010) and a spec run wants every failure, not
# the first one.
def spec(description, actual, expected)
  return Example.new(description: description, detail: "", ok: true) if actual == expected

  # One line because the seed cannot parse a multi-line argument list yet —
  # a newline anywhere inside the parens is a parse error.
  Example.new(description: description, detail: "expected #{expected}, got #{actual}", ok: false)
end

# Prints in the same shape `specify` does, so the runner's count covers both
# harnesses and there is exactly one tally rather than one per shape. Counts
# nothing itself, and no longer panics: the runner decides the exit status.
def report(examples)
  examples.each do |example|
    puts "- #{example.description}"
    puts "  FAIL #{example.detail}" unless example.ok
  end
end

# The shape this file is migrating toward. `describe` and `specify` print their
# own name and run the block they were handed; `expect` reports a mismatch and
# keeps going. Nothing here counts, and nothing here panics — see the note above
# on why a method cannot hold a tally, and `script/spec` for who does instead.
#
# `specify` rather than rubyspec's more familiar `it`, and not by taste. `it`
# is an ordinary binding under the no-shadow rule (ADR 0017), so a file that
# defines `def it` contests the name with every implicit-`it` block in it —
# which would make ADR 0017 the one ADR this suite structurally cannot pin,
# a blind spot in the file whose whole job is to have none. `specify` is
# mspec's own alias for `it`, so this borrows prior art rather than inventing.
def describe(subject)
  puts subject
  yield
end

def specify(behavior)
  puts "- #{behavior}"
  yield
end

# One countable line per failure, indented under the example it belongs to, so
# the runner can find it and a reader can see which example it came from
# without the message having to repeat the description.
def expect(actual, expected)
  return if actual == expected

  puts "  FAIL expected #{expected}, got #{actual}"
end

# ADR 0019 — a slice is a collection, never a maybe.
words = %w[rose city]

describe("Array#[] with a range") do
  specify("returns an empty collection past the end, never nil") do
    expect(words[9..].length, 0)
  end
end

# ADR 0017 — `it` is an ordinary binding, so a one-parameter block can leave it
# undeclared. This example is the reason the DSL above says `specify`: with a
# `def it` in this file the two would contest the name and the seed would
# refuse, making 0017 the one ADR this suite could not pin.
describe("a block's implicit `it`") do
  specify("is the single parameter, never declared") do
    expect(words.map { it.upcase }, ["ROSE", "CITY"])
  end
end

mutable examples = []

# ADR 0018 — division and modulo are floored, Ruby's rule, not Rust's.
negative = 0 - 7
examples << spec("integer division floors toward negative infinity", negative / 2, 0 - 4)
examples << spec("modulo takes the sign of the divisor", negative % 2, 1)

# ADR 0010 — partial operations return maybes; the only crash is one you typed.
examples << spec("first on an empty array is nil", [].first, nil)
examples << spec("an out-of-range index is nil", [1, 2][9], nil)
examples << spec("a missing hash key is nil", {name: "pdx"}[:nope], nil)

# ADR 0012 — a branch that doesn't happen produces nil.
branchless = if false
  "taken"
end
examples << spec("a branchless if is nil", branchless, nil)

# ADR 0015 — values never mutate; names do. An alias cannot be spooked.
mutable numbers = [1]
alias_of = numbers
numbers << 2
examples << spec("appending rebinds the name, leaving aliases alone", alias_of.length, 1)
examples << spec("and the name itself sees the append", numbers.length, 2)

# ADR 0023 — a symbol is a name, not text, and they are not interchangeable.
examples << spec("a symbol equals itself", :paid == :paid, true)
examples << spec("a symbol is not the string of its name", :paid == "paid", false)
examples << spec("hash shorthand builds symbol keys", {name: "pdx"}[:name], "pdx")

# ADR 0022 — an enum case carries a keyword payload, destructured by label.
enum Status
  :pending
  :paid(on:)
end

paid = :paid(on: "tuesday")
day = case paid
in :pending   then "never"
in :paid(on:) then on
end
examples << spec("an enum payload destructures by label", day, "tuesday")

# ADR 0005 — the wrapper keeps a stored nil distinguishable from a missing one.
# This pair is the whole point: both look like nil in Ruby, and must not here.
stored = [nil]
missing = []
examples << spec("a stored nil comes back present", stored.first.nil?, false)
examples << spec("a missing one comes back absent", missing.first.nil?, true)

report(examples)
