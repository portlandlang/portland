# Portland's language spec: the ADRs' promises, executable.
#
# This is the third oracle. The differential harness proves the seed and the
# trio agree with each other; nothing until now proved either agrees with
# what was decided. Every example here cites the ADR it pins.

#
# Deliberately tiny, and deliberately built only from what the language has
# today: no classes, no exceptions, and no instance variables — none of which
# exist yet.
#
# The shape is rubyspec's, which `yield` is what made possible: `describe`
# names a subject, `specify` an example, `expect` compares. Nothing here counts
# and nothing here panics — a tally has to be kept somewhere, and only a block
# can reach an outer `mutable`, so `specify` and `expect`, being methods, can
# never count. `script/spec` counts the printed lines instead, which is also
# how mspec separates examples from formatters, and it is what lets a run
# report every failure rather than stopping at the first.

# `describe` and `specify` print their own name and run the block they were
# handed. That is the whole harness.
#
# `specify` rather than rubyspec's more familiar `it`, and not by taste. `it`
# is an ordinary binding under the no-shadow rule (ADR 0017), so a file that
# defines `def it` contests the name with every implicit-`it` block in it —
# which would make ADR 0017 the one ADR this suite structurally cannot pin,
# a blind spot in the file whose whole job is to have none. `specify` is
# mspec's own alias for `it`, so this borrows prior art rather than inventing.
#
# Fixtures belong inside the `describe` that uses them — a `specify` block
# closes over where it was written, so it sees them. There is no `before`, and
# for an immutable fixture there is nothing for one to do: the setup runs once,
# both examples share the value, and no example can corrupt it for the next,
# because values never mutate (ADR 0015).
#
# A `mutable` fixture is the exception, and it must go inside the one `specify`
# that needs it. A block rebinding an outer `mutable` is the accumulator pattern
# ADR 0001 licenses, and it now works on both oracles — which means a `mutable`
# declared at `describe` level and rebound by one example is visible to the
# next, so the examples stop being independent and their order starts to matter.
# Nothing in the language will stop you; this comment is the only guard.
def describe(subject)
  puts subject
  yield
end

def specify(behavior)
  puts "- #{behavior}"
  yield
end

# Absence has no methods, `to_s` included (ADR 0005/0006), so a value that may
# be nil cannot go straight into an interpolation. Four examples below expect
# nil, and without this a regression in any of them would panic with `nil has
# no method to_s` — a message pointing at the harness rather than the example,
# and a panic stopping the run at the first failure, which is the property this
# harness exists to keep. Found by inverting `expect` to check every example
# still fails when it should; the probe crashed instead of reporting.
def shown(value)
  return "nil" if value.nil?

  "#{value}"
end

# One countable line per failure, indented under the example it belongs to, so
# the runner can find it and a reader can see which example it came from
# without the message having to repeat the description.
def expect(actual, expected)
  return if actual == expected

  puts "  FAIL expected #{shown(expected)}, got #{shown(actual)}"
end

# ADR 0019 — a slice is a collection, never a maybe.
describe("Array#[] with a range") do
  words = %w[rose city]

  specify("returns an empty collection past the end, never nil") do
    expect(words[9..].length, 0)
  end
end

# ADR 0017 — `it` is an ordinary binding, so a one-parameter block can leave it
# undeclared. This example is the reason the DSL above says `specify`: with a
# `def it` in this file the two would contest the name and the seed would
# refuse, making 0017 the one ADR this suite could not pin.
describe("a block's implicit `it`") do
  words = %w[rose city]

  specify("is the single parameter, never declared") do
    expect(words.map { it.upcase }, ["ROSE", "CITY"])
  end
end

# ADR 0018 — division and modulo are floored, Ruby's rule, not Rust's. Both
# examples show the same divergence from Rust, which truncates toward zero.
describe("Integer#/") do
  specify("floors toward negative infinity") do
    expect((0 - 7) / 2, 0 - 4)
  end
end

describe("Integer#%") do
  specify("takes the sign of the divisor") do
    expect((0 - 7) % 2, 1)
  end
end

# ADR 0010 — partial operations return maybes; the only crash is one you typed.
# The subject is the rule rather than a method, because it spans three of them.
describe("a partial operation") do
  specify("answers nil for first on an empty array") do
    expect([].first, nil)
  end

  specify("answers nil for an out-of-range index") do
    expect([1, 2][9], nil)
  end

  specify("answers nil for a missing hash key") do
    expect({name: "pdx"}[:nope], nil)
  end
end

# ADR 0012 — a branch that doesn't happen produces nil.
describe("if without a matching branch") do
  branchless = if false
    "taken"
  end

  specify("produces nil") do
    expect(branchless, nil)
  end
end

# ADR 0015 — values never mutate; names do. An alias cannot be spooked.
#
# The `mutable` here is safe at `describe` level, against the caveat above,
# because the append happens in the setup rather than in an example: neither
# example rebinds anything, so they stay independent of each other.
describe("appending to an array") do
  mutable numbers = [1]
  alias_of = numbers
  numbers << 2

  specify("rebinds the name, leaving aliases alone") do
    expect(alias_of.length, 1)
  end

  specify("and the name itself sees the append") do
    expect(numbers.length, 2)
  end
end

# ADR 0023 — a symbol is a name, not text, and they are not interchangeable.
describe("a symbol") do
  specify("equals itself") do
    expect(:paid == :paid, true)
  end

  specify("is not the string of its name") do
    expect(:paid == "paid", false)
  end
end

describe("hash shorthand") do
  specify("builds symbol keys") do
    expect({name: "pdx"}[:name], "pdx")
  end
end

# ADR 0022 — an enum case carries a keyword payload, destructured by label.
# The declaration stays at the top level: it is compile-time information, and
# nothing about a `describe` block is the right home for it.
enum Status
  :pending
  :paid(on:)
end

describe("an enum case carrying a payload") do
  specify("destructures by label") do
    paid = :paid(on: "tuesday")
    day = case paid
    in :pending   then "never"
    in :paid(on:) then on
    end
    expect(day, "tuesday")
  end
end

# ADR 0005 — the wrapper keeps a stored nil distinguishable from a missing one.
# This pair is the whole point: both look like nil in Ruby, and must not here.
describe("Array#first") do
  stored = [nil]
  missing = []

  specify("comes back present when a nil was stored") do
    expect(stored.first.nil?, false)
  end

  specify("comes back absent when the array was empty") do
    expect(missing.first.nil?, true)
  end
end
