# ADR 0001 — a block rebinding an outer mutable is the accumulator pattern,
# the one licensed exception to examples staying independent (see the
# spec_helper's caveat), which is why this mutable sits inside its specify.

require_relative "../spec_helper"

context "rebinding under mutable" do
  describe "a block over an outer mutable" do
    specify "accumulates" do
      mutable total = 0
      [1, 2, 3].each do |number|
        total += number
      end
      expect(total).to(eq(6))
    end
  end
end
