# The first fallible operation in the language: `System.read_file` answers a
# failure rather than panicking (ADR 0027). The member itself is pinned in
# spec/system/read_file_spec.pdx; this file pins the failure toolkit around it.

require_relative "../spec_helper"

context "the first fallible operation" do
  describe "System.read_file on a missing path" do
    specify "answers a failure, not a panic" do
      expect(System.read_file("/tmp/portland-definitely-missing")).to be_failure
    end

    specify "which is one or away from a default" do
      expect((System.read_file("/tmp/portland-definitely-missing") or "default config")).to eq("default config")
    end
  end
end
