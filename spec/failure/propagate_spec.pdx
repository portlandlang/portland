# ADR 0044 — propagation is the explicit toolkit, and nothing else: a
# failure crosses a frame by being returned at a spelled-out guard, aimed
# at its write site like any return (ADR 0025). The `!` suffix this file
# once specced (ADR 0027) is retired; `!` belongs to method names again.

require_relative "../spec_helper"

def risky(flag)
  return failure("flagged") if flag
  "fine"
end

def guarded(flag)
  value = risky(flag)
  return value if value.failure?
  "got #{value}"
end

def through_a_block(flag)
  [1, 2].each do |number|
    checked = risky(flag)
    return checked if checked.failure?
  end
  "walked all #{2} elements"
end

def bang_named!
  "loud and proud"
end

struct Receipt
  total
end

def issue(flag)
  return failure("declined") if flag
  Receipt.new(total: 7)
end

def collected(flag)
  receipt = issue(flag)
  return receipt if receipt.failure?
  "charged #{receipt.total}"
end

context "failure propagation, spelled out" do
  describe "a call whose value is sound" do
    specify "passes the guard untouched" do
      expect(guarded(false)).to eq("got fine")
    end
  end

  describe "a call that failed" do
    specify "returns the failure from the enclosing method" do
      expect(guarded(true)).to be_failure
    end

    specify "unwinds through blocks to its write site" do
      expect(through_a_block(false)).to eq("walked all 2 elements")
      expect(through_a_block(true)).to be_failure
    end
  end

  describe "a struct crossing the guard" do
    # #92: the predicate answers on a struct like on any value — the
    # commonest thing a fallible def returns is exactly the value the
    # seed once refused it on.
    specify "passes as itself when sound, propagates when not" do
      expect(collected(false)).to eq("charged 7")
      expect(collected(true)).to be_failure
      expect(Receipt.new(total: 1).failure?).to eq(false)
    end
  end

  describe "the freed suffix" do
    specify "a bang is just part of a method's name now" do
      expect(bang_named!).to eq("loud and proud")
    end
  end
end
