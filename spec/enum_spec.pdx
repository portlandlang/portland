# An enum is a closed vocabulary of symbol cases; a case may carry a
# keyword-only payload (ADR 0022).

require_relative "spec_helper"

# ADR 0022 — the declarations stay at the top level: they are compile-time
# information, and nothing about a block is the right home for them.
#
# A top-level enum is owned by no type; the nested one follows the
# types-nest-in-types rule, `Purchase::Status` naming it while
# `purchase.status` reads the value. The method beside the nested enum is
# load-bearing: that combination parsed in the seed and not in the trio the
# day this file grew (#44).
enum Ordering
  :less
  :equal
  :greater
end

struct Purchase
  amount
  status

  enum Status
    :pending
    :paid(on:)
    :refunded(on:, reason:)
  end

  def paid?
    status in :paid(on:)
  end
end

context "an enum" do
  describe "a case carrying a payload" do
    specify "destructures by label" do
      paid = :paid(on: "tuesday")
      day = case paid
      in :pending   then "never"
      in :paid(on:) then on
      end
      expect(day).to(eq("tuesday"))
    end

    specify "matches on any subset of its labels" do
      refund = :refunded(on: "friday", reason: "damaged")
      why = case refund
      in :paid(on:)         then on
      in :refunded(reason:) then reason
      end
      expect(why).to(eq("damaged"))
    end

    specify "binds every label when asked" do
      refund = :refunded(on: "friday", reason: "damaged")
      both = case refund
      in :refunded(on:, reason:) then "#{reason} on #{on}"
      end
      expect(both).to(eq("damaged on friday"))
    end

    specify "hits the one-line in form too" do
      expect((:paid(on: "tuesday") in :paid(on:))).to(be_true)
    end
  end

  # ADR 0022 — a payload-free case is simply a symbol; nothing about :less
  # needs to exist at runtime.
  describe "a payload-free case" do
    specify "is the plain symbol" do
      expect(:less).to(eq(:less))
    end
  end

  describe "nesting in a struct" do
    purchase = Purchase.new(amount: 40, status: :paid(on: "tuesday"))

    specify "reads back off the field" do
      day = case purchase.status
      in :pending   then "never"
      in :paid(on:) then on
      end
      expect(day).to(eq("tuesday"))
    end

    specify "and the struct's own methods match on it" do
      expect(purchase.paid?).to(be_true)
    end
  end
end
