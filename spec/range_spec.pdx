# Ranges: two dots and three, endless and beginless, integer bounds only.

require_relative "spec_helper"

context "Range" do
  # ADR 0019 — `..` keeps its end and `...` excludes it, and both iterate.
  describe "the literal" do
    specify "two dots keep the end" do
      expect((1..5).to_a).to(eq([1, 2, 3, 4, 5]))
    end

    specify "three dots exclude it" do
      expect((1...5).to_a).to(eq([1, 2, 3, 4]))
    end

    specify "iterates through the block methods" do
      expect((1..3).map { it * 2 }).to(eq([2, 4, 6]))
    end

    specify "sums without being spelled out" do
      expect((1..5).sum).to(eq(15))
    end
  end

  # ADR 0019 — `include?` answers membership without walking, which is what
  # lets an endless or beginless range answer at all.
  describe "#include?" do
    specify "respects the exclusive end" do
      expect((1..5)).to(contain(5))
      expect((1...5)).not_to(contain(5))
    end

    specify "answers for an endless range" do
      expect((1..)).to(contain(99))
    end

    specify "answers for a beginless one" do
      expect((..4)).to(contain(0 - 5))
      expect((..4)).not_to(contain(5))
    end
  end

  # ADR 0019 — a slice is a collection, never a maybe. The past-the-end half
  # of that promise lives in optionals_spec; these are the ordinary slices.
  describe "indexing with a range" do
    words = %w[a b c d e]

    specify "slices an array, inclusive or exclusive" do
      expect(words[1..2]).to(eq(["b", "c"]))
      expect(words[1...3]).to(eq(["b", "c"]))
    end

    specify "slices from the start with a beginless range" do
      expect(words[..1]).to(eq(["a", "b"]))
    end

    specify "slices to the end with an endless one" do
      expect(words[3..]).to(eq(["d", "e"]))
    end

    specify "slices strings the same way" do
      expect("portland"[0..3]).to(eq("port"))
      expect("portland"[5..]).to(eq("and"))
    end

    specify "answers an empty string past the end, never nil" do
      expect("portland"[9..]).to(be_empty)
    end
  end
end
