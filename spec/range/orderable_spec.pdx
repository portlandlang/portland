# Ranges over any orderable value (ADR 0081): the ends are any two values
# `<=>` orders — numbers, strings, symbols, arrays, Comparable structs — and
# membership, the extremes, the ends, equality, clamping, `overlap?`, `when`,
# and `in` work over them by `<=>`. Iteration stays with integer ranges: a
# float start refuses as Ruby's does, and `1..2.5` walks the integers up to
# the floor, as Ruby's does.
#
# From ruby/spec core/range/{cover,include,case_compare,min,max,minmax,
# first,last,begin,end,equal_value,eql,inspect,to_s,to_a,new,overlap}_spec.rb,
# the rows with string and float ends, and core/range/shared/
# cover_and_include.rb. Upstream: `include?` on a string range walks by
# `succ` in Ruby, so `("a".."f").include?("aa")` is false there and true
# here, where every membership question is `cover?`; Ruby's TypeError on
# `include?` over an open string range (it covers here); the Time, mock,
# subrange, and Set-like rows; and `("a"..."f").max`, which Ruby finds by
# walking.

require_relative "../spec_helper"

struct Version
  major
  minor

  include Comparable

  def <=>(other) = [major, minor] <=> [other.major, other.minor]
end

context "Range over any orderable" do
  describe "membership" do
    specify "covers strings between the ends, by <=>" do
      expect(("C".."X").include?("M")).to be_true
      expect(("C".."X").include?("A")).to be_false
      expect(("B"..."W").include?("W")).to be_false
      expect(("B"..."W").cover?("Q")).to be_true
      expect(("f".."s").member?("f")).to be_true
      expect(("f".."s").member?("s")).to be_true
      expect(("a".."f").cover?("aa")).to be_true
      expect(("a".."f").cover?("ga")).to be_false
    end

    specify "covers floats and integers alike" do
      expect((0.5..2.4).include?(2)).to be_true
      expect((0.5..2.4).include?(2.5)).to be_false
      expect((0.5..2.4).include?(2.4)).to be_true
      expect((0.5...2.4).include?(2.4)).to be_false
      expect((-10..-2).include?(-2.5)).to be_true
      expect((-1...1).include?(10.5)).to be_false
    end

    specify "reaches everything on an open side" do
      expect((1..).include?(2.4)).to be_true
      expect((0.5...).include?(2.4)).to be_true
      expect((..10).include?(2.4)).to be_true
      expect((...10.5).include?(2.4)).to be_true
      expect((1..).include?(0.4)).to be_false
      expect((..10).include?(12.4)).to be_false
      expect(("a"..).cover?("b")).to be_true
    end

    specify "answers false for a value the ends cannot order" do
      expect((1..10).include?(nil)).to be_false
      expect((1..10).cover?("a")).to be_false
      expect(("A".."C").include?(20.9)).to be_false
      expect((30...30).include?(30)).to be_false
    end

    specify "is what when and === ask" do
      answer = case "m"
      when "a".."f" then "early"
      when "g".."z" then "late"
      else "other"
      end
      expect(answer).to eq("late")
      expect((1.5..2.5) === 2).to be_true
    end

    specify "overlap? reads the ends by <=> too" do
      expect(("a".."c").overlap?("b".."d")).to be_true
      expect(("a".."c").overlap?("d".."f")).to be_false
      expect((1.5..2.5).overlap?(2.0..3.0)).to be_true
    end
  end

  describe "the extremes" do
    specify "min and max are the ends, by <=>, walking nothing" do
      expect(("f".."l").min).to eq("f")
      expect(("f".."l").max).to eq("l")
      expect((303.20..908.1111).min).to eq(303.20)
      expect((303.20..908.1111).max).to eq(908.1111)
      expect((1.5..2.5).minmax).to eq([1.5, 2.5])
    end

    specify "are nil for an empty range" do
      expect(("z".."l").min).to be_nil
      expect(("z".."l").max).to be_nil
      expect((3003.20..908.1111).min).to be_nil
      expect((3003.20..908.1111).max).to be_nil
      expect((7...7).min).to be_nil
      expect((5...5).max).to be_nil
    end

    specify "keep an excluded integer end out and an included one in" do
      expect((1...10).max).to eq(9)
      expect((7..7).min).to eq(7)
      expect((1.5...2.5).min).to eq(1.5)
      expect((1..2.5).max).to eq(2.5)
    end

    specify "answer the one end of an open range" do
      expect((1.0...).min).to eq(1.0)
      expect((..1.0).max).to eq(1.0)
    end
  end

  describe "the ends" do
    specify "begin, end, first, and last are the ends themselves" do
      expect(("a".."f").first).to eq("a")
      expect(("a".."f").last).to eq("f")
      expect((1.5..2.5).first).to eq(1.5)
      expect((1.5..2.5).last).to eq(2.5)
      expect((1.5..2.5).begin).to eq(1.5)
      expect((..2.5).begin).to be_nil
      expect(("a"..).end).to be_nil
    end
  end

  describe "equality" do
    specify "asks == of the ends, and eql? asks eql?" do
      expect((0..1) == (0..1.0)).to be_true
      expect((0..1).eql?(0..1.0)).to be_false
      expect(("a".."c") == ("a".."c")).to be_true
      expect(("a".."c") == ("a"..."c")).to be_false
      expect((1.0..) == (1.0..)).to be_true
      expect((...10) == (...10)).to be_true
    end
  end

  describe "inspect and to_s" do
    specify "inspect each end, and to_s renders them" do
      expect(inspect("A".."Z")).to eq('"A".."Z"')
      expect(inspect("A"..."Z")).to eq('"A"..."Z"')
      expect(inspect(0.5..2.4)).to eq("0.5..2.4")
      expect(inspect(0.1...)).to eq("0.1...")
      expect(inspect(...0.1)).to eq("...0.1")
      expect(("a".."b").to_s).to eq("a..b")
    end
  end

  describe "building" do
    specify "Range.new takes any two orderable ends" do
      built = Range.new("a", "c")
      expect(built).to eq("a".."c")
      expect(built.first).to eq("a")
      expect(built.last).to eq("c")
      expect(Range.new(1.5, nil)).to eq(1.5..)
    end
  end

  describe "clamp by a range" do
    specify "clamps floats and strings by their ends" do
      expect(2.0.clamp(1.5..2.5)).to eq(2.0)
      expect(3.0.clamp(1.5..2.5)).to eq(2.5)
      expect("b".clamp("c".."f")).to eq("c")
      expect("m".clamp("c".."f")).to eq("f")
      expect("d".clamp("c"..)).to eq("d")
    end
  end

  describe "walking" do
    specify "a range from an integer to a float walks the integers up to its floor" do
      expect((1..2.5).to_a).to eq([1, 2])
      expect((1...3.0).to_a).to eq([1, 2])
      expect((1..2.5).size).to eq(2)
    end

    specify "a slice by a float range truncates the ends" do
      expect([1, 2, 3][1.0..2]).to eq([2, 3])
    end
  end

  describe "a range of Comparable structs" do
    low = Version.new(major: 1, minor: 0)
    middle = Version.new(major: 1, minor: 5)
    high = Version.new(major: 2, minor: 0)
    beyond = Version.new(major: 3, minor: 0)

    specify "covers by the struct's own <=>" do
      expect((low..high).include?(middle)).to be_true
      expect((low..high).cover?(beyond)).to be_false
      expect((low...high).include?(high)).to be_false
      expect((low..high).member?(low)).to be_true
    end

    specify "clamps, picks its extremes, and answers when" do
      expect(beyond.clamp(low..high)).to eq(high)
      expect(middle.clamp(low..high)).to eq(middle)
      expect(middle.clamp(low..)).to eq(middle)
      expect(middle.clamp(..low)).to eq(low)
      expect((low..high).min).to eq(low)
      expect((low..high).max).to eq(high)
      expect((high..low).min).to be_nil
      answer = case middle
      when low..high then "supported"
      else "not"
      end
      expect(answer).to eq("supported")
    end
  end

  describe "in patterns" do
    specify "match float and string ranges, with an else" do
      answer = case 2.5
      in 1.5..3.0 then "in range"
      else "out"
      end
      expect(answer).to eq("in range")
      third = case "b"
      in "a".."c" then "first third"
      in "d".."z" then "rest"
      else "other"
      end
      expect(third).to eq("first third")
      negative = case -0.5
      in -1.0..0.0 then "small"
      else "other"
      end
      expect(negative).to eq("small")
    end
  end
end
