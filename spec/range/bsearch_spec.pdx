# Binary search over a range (#111, ADR 0081), from ruby/spec
# core/range/bsearch_spec.rb: Ruby's two modes by what the block answers,
# over the integers of a bounded range, the doubles of a float range, and
# an open range probed outward until the answer is bracketed. Without a
# block there are no enumerators (ADR 0055); a String range refuses before
# any search, and the Object rows have no object to build.

require_relative "../spec_helper"

context "Range#bsearch" do
  describe "with Integer values" do
    describe "with a block returning true or false" do
      specify "returns nil if the block returns false for every element" do
        expect((0...3).bsearch { |x| x > 3 }).to be_nil
      end

      specify "returns nil if the block returns nil for every element" do
        expect((0..3).bsearch { |x| nil }).to be_nil
      end

      specify "returns minimum element if the block returns true for every element" do
        expect((-2..4).bsearch { |x| x < 4 }).to eq(-2)
      end

      specify "returns the smallest element for which block returns true" do
        expect((0..4).bsearch { |x| x >= 2 }).to eq(2)
        expect((-1..4).bsearch { |x| x >= 1 }).to eq(1)
      end

      specify "returns the last element if the block returns true for the last element" do
        expect((0..4).bsearch { |x| x >= 4 }).to eq(4)
        expect((0...4).bsearch { |x| x >= 3 }).to eq(3)
      end
    end

    describe "with a block returning negative, zero, positive numbers" do
      specify "returns nil if the block returns less than zero for every element" do
        expect((0..3).bsearch { |x| x <=> 5 }).to be_nil
      end

      specify "returns nil if the block returns greater than zero for every element" do
        expect((0..3).bsearch { |x| x <=> -1 }).to be_nil
      end

      specify "returns nil if the block never returns zero" do
        expect((0..3).bsearch { |x| x < 2 ? 1 : -1 }).to be_nil
      end

      specify "accepts (+/-)Float::INFINITY from the block" do
        expect((0..4).bsearch { |x| Float::INFINITY }).to be_nil
        expect((0..4).bsearch { |x| -Float::INFINITY }).to be_nil
      end

      specify "returns an element at an index for which block returns 0.0" do
        result = (0..4).bsearch { |x| x < 2 ? 1.0 : (x > 2 ? -1.0 : 0.0) }
        expect(result).to eq(2)
      end

      specify "returns an element at an index for which block returns 0" do
        result = (0..4).bsearch { |x| x < 1 ? 1 : (x > 3 ? -1 : 0) }
        expect([1, 2].include?(result)).to be_true
      end
    end

    specify "returns nil for empty ranges" do
      expect((0...0).bsearch { true }).to be_nil
      expect((0...0).bsearch { false }).to be_nil
      expect((0...0).bsearch { 1 }).to be_nil
      expect((0...0).bsearch { 0 }).to be_nil
      expect((0...0).bsearch { -1 }).to be_nil
      expect((4..2).bsearch { true }).to be_nil
      expect((4..2).bsearch { 1 }).to be_nil
      expect((4..2).bsearch { 0 }).to be_nil
      expect((4..2).bsearch { -1 }).to be_nil
    end
  end

  describe "with Float values" do
    specify "returns nil when the block refuses every element" do
      expect((0.1...2.3).bsearch { |x| x > 3 }).to be_nil
      expect((-0.0..2.3).bsearch { |x| nil }).to be_nil
    end

    specify "returns the minimum when the block accepts every element" do
      expect((-0.2..4.8).bsearch { |x| x < 5 }).to eq(-0.2)
    end

    specify "returns the smallest element the block accepts" do
      expect((0..4.2).bsearch { |x| x >= 2 }).to eq(2)
      expect((-1.2..4.3).bsearch { |x| x >= 1 }).to eq(1)
    end

    specify "returns a boundary element where that is the answer" do
      expect((1.0..3.0).bsearch { |x| x >= 3.0 }).to eq(3.0)
      expect((1.0...3.0).bsearch { |x| x >= 3.0.prev_float }).to eq(3.0.prev_float)
      expect((1.0..3.0).bsearch { |x| x >= 1.0 }).to eq(1.0)
      expect((1.0...3.0).bsearch { |x| x >= 1.0 }).to eq(1.0)
    end

    specify "works with infinity bounds" do
      inf = Float::INFINITY
      expect((0..inf).bsearch { |x| x >= 3 }).to eq(3.0)
      expect((-inf..0).bsearch { |x| x >= -3 }).to eq(-3.0)
      expect((inf..inf).bsearch { true }).to eq(inf)
      expect((inf...inf).bsearch { true }).to be_nil
      expect((inf..0).bsearch { true }).to be_nil
    end

    specify "finds an element the block calls zero" do
      expect((0.0..4.0).bsearch { |x| x < 2 ? 1 : (x > 2 ? -1 : 0) }).to eq(2.0)
      expect((0.1..2.3).bsearch { |x| -1 }).to be_nil
      expect((0.1..2.3).bsearch { |x| 1 }).to be_nil
    end
  end

  describe "with endless ranges" do
    specify "returns the smallest element the block accepts" do
      expect((-2..).bsearch { |x| true }).to eq(-2)
      expect((0..).bsearch { |x| x >= 2 }).to eq(2)
      expect((-1..).bsearch { |x| x >= 1 }).to eq(1)
      expect((-1.2..).bsearch { |x| x >= 1 }).to eq(1)
      expect((-0.2...).bsearch { |x| true }).to eq(-0.2)
    end

    specify "returns nil when the block never settles" do
      expect((0..).bsearch { |x| -1 }).to be_nil
      expect((0..).bsearch { |x| x > 5 ? -1 : 1 }).to be_nil
      expect((0.1..).bsearch { |x| x < 0.0 }).to be_nil
    end

    specify "finds an element the block calls zero" do
      expect((0..).bsearch { |x| x < 2 ? 1.0 : (x > 2 ? -1.0 : 0.0) }).to eq(2)
      found = (0..).bsearch { |x| x < 1 ? 1 : (x > 3 ? -1 : 0) }
      expect([1, 2, 3].include?(found)).to be_true
    end
  end

  describe "with beginless ranges" do
    specify "returns the smallest element the block accepts" do
      expect((..10).bsearch { |x| x >= 2 }).to eq(2)
      expect((...-1).bsearch { |x| x >= -10 }).to eq(-10)
      expect((..10.0).bsearch { |x| x >= 1 }).to eq(1)
    end

    specify "returns nil when the block never settles" do
      expect((..0).bsearch { |x| 1 }).to be_nil
      expect((..0).bsearch { |x| x > 5 ? -1 : 1 }).to be_nil
      expect((..-0.1).bsearch { |x| x > 0.0 }).to be_nil
      expect((..5.0).bsearch { |x| -1 }).to be_nil
    end

    specify "finds an element the block calls zero" do
      expect((..10).bsearch { |x| x < 2 ? 1.0 : (x > 2 ? -1.0 : 0.0) }).to eq(2)
    end
  end
end
