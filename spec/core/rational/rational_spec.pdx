# Rational (ADR 0085): `Rational(a, b)`, `3r`, `1.5r`, and `to_r` build a
# reduced fraction of two 64-bit integers; the arithmetic mixes as Ruby's
# does — an integer keeps it rational, a float makes a float — and `inspect`
# is Ruby's `(1/3)`. Every answer here is Ruby 4.0.9's.
#
# From ruby/spec core/rational/{rational,abs,magnitude,ceil,floor,round,
# truncate,comparison,denominator,numerator,div,divide,divmod,modulo,
# remainder,quo,fdiv,minus,multiply,plus,exponent,equal_value,inspect,to_s,
# to_f,to_i,to_r,rationalize,integer,zero}_spec.rb and core/kernel/
# Rational_spec.rb. Upstream: the bignum
# rows (ADR 0070), the coercion and mock rows (#155), the string and nil
# constructor rows, the digits and half-mode rows of the rounders, hash,
# and Marshal.

require_relative "../../spec_helper"

context "Rational" do
  describe "building" do
    specify "reduces and normalizes the sign" do
      expect(inspect(Rational(1, 3))).to eq("(1/3)")
      expect(inspect(Rational(6, 4))).to eq("(3/2)")
      expect(inspect(Rational(1, -3))).to eq("(-1/3)")
      expect(inspect(Rational(0, 5))).to eq("(0/1)")
      expect(inspect(Rational(3))).to eq("(3/1)")
      expect(inspect(Rational(1.5))).to eq("(3/2)")
    end

    specify "has the r suffix for literals" do
      expect(3r).to eq(Rational(3, 1))
      expect(1.5r).to eq(Rational(3, 2))
      expect(inspect(1.5r)).to eq("(3/2)")
    end

    specify "comes from to_r on the other reals" do
      expect(3.to_r).to eq(Rational(3, 1))
      expect(0.75.to_r).to eq(Rational(3, 4))
      expect(inspect(0.1.to_r)).to eq("(3602879701896397/36028797018963968)")
      expect(Rational(1, 3).to_r).to eq(Rational(1, 3))
    end

    specify "answers numerator and denominator, on every real" do
      expect(Rational(1, 3).numerator).to eq(1)
      expect(Rational(1, 3).denominator).to eq(3)
      expect(3.numerator).to eq(3)
      expect(3.denominator).to eq(1)
      expect(0.5.numerator).to eq(1)
      expect(0.5.denominator).to eq(2)
    end
  end

  describe "arithmetic" do
    specify "stays rational with an integer or a rational" do
      expect(Rational(1, 3) + 1).to eq(Rational(4, 3))
      expect(Rational(1, 3) * 3).to eq(Rational(1, 1))
      expect(Rational(1, 3) - Rational(1, 2)).to eq(Rational(-1, 6))
      expect(Rational(1, 3) / 2).to eq(Rational(1, 6))
      expect(1 / Rational(1, 3)).to eq(Rational(3, 1))
      expect(inspect(Rational(1, 3) * 3)).to eq("(1/1)")
    end

    specify "becomes a float with a float" do
      expect(Rational(1, 3) + 1.0).to eq(1.3333333333333333)
      expect(Rational(1, 3) / 0.0).to eq(Float::INFINITY)
    end

    specify "takes modulo, divmod, and remainder as Ruby's" do
      expect(Rational(7, 2) % 1).to eq(Rational(1, 2))
      expect(Rational(7, 2).divmod(1)).to eq([3, Rational(1, 2)])
      expect(Rational(-7, 2) % 2).to eq(Rational(1, 2))
      expect(Rational(7, 2).remainder(2)).to eq(Rational(3, 2))
      expect(Rational(1, 3).div(Rational(1, 6))).to eq(2)
    end

    specify "raises to integer powers exactly and to others as a float" do
      expect(Rational(1, 3) ** 2).to eq(Rational(1, 9))
      expect(Rational(1, 3) ** -1).to eq(Rational(3, 1))
      expect(Rational(4, 1) ** Rational(1, 2)).to eq(2.0)
      expect(Rational(1, 3) ** 0.5).to eq(0.5773502691896257)
      expect(2 ** Rational(1, 2)).to eq(1.4142135623730951)
    end

    specify "is what an integer's negative power and quo answer" do
      expect(2 ** -1).to eq(Rational(1, 2))
      expect(1.quo(2)).to eq(Rational(1, 2))
      expect(Rational(1, 3).quo(2)).to eq(Rational(1, 6))
      expect(Rational(1, 3).fdiv(2)).to eq(0.16666666666666666)
    end

    specify "negates and takes its magnitude" do
      expect(-Rational(1, 3)).to eq(Rational(-1, 3))
      expect(Rational(-1, 3).abs).to eq(Rational(1, 3))
      expect(Rational(-1, 3).magnitude).to eq(Rational(1, 3))
    end
  end

  describe "rounding" do
    specify "floor, ceil, round, truncate, and to_i answer integers" do
      expect(Rational(7, 2).floor).to eq(3)
      expect(Rational(7, 2).ceil).to eq(4)
      expect(Rational(7, 2).round).to eq(4)
      expect(Rational(5, 2).round).to eq(3)
      expect(Rational(-5, 2).round).to eq(-3)
      expect(Rational(7, 2).truncate).to eq(3)
      expect(Rational(7, 2).to_i).to eq(3)
      expect(Rational(7, 2).to_f).to eq(3.5)
    end
  end

  describe "comparing" do
    specify "equals by value across the reals, eql? by type too" do
      expect(Rational(1, 3) == Rational(2, 6)).to be_true
      expect(Rational(1, 2) == 0.5).to be_true
      expect(Rational(2, 1) == 2).to be_true
      expect(2 == Rational(2, 1)).to be_true
      expect(Rational(1, 2).eql?(0.5)).to be_false
      expect(Rational(2, 1).eql?(2)).to be_false
    end

    specify "orders" do
      expect(Rational(1, 2) <=> 0.5).to eq(0)
      expect(Rational(1, 3) < Rational(1, 2)).to be_true
      expect(Rational(1, 3).clamp(Rational(1, 2), 1)).to eq(Rational(1, 2))
    end
  end

  describe "the predicates" do
    specify "zero?, positive?, negative?, integer?" do
      expect(Rational(1, 3).zero?).to be_false
      expect(Rational(0, 3).zero?).to be_true
      expect(Rational(1, 3).positive?).to be_true
      expect(Rational(1, 3).negative?).to be_false
      expect(Rational(1, 3).integer?).to be_false
    end
  end

  describe "rationalize" do
    specify "answers the simplest rational within the precision" do
      expect(Rational(1, 3).rationalize).to eq(Rational(1, 3))
      expect(Rational(1, 3).rationalize(Rational(1, 10))).to eq(Rational(1, 3))
      expect(0.333.rationalize).to eq(Rational(333, 1000))
      expect(0.333.rationalize(Rational(1, 100))).to eq(Rational(1, 3))
      expect(0.1.rationalize).to eq(Rational(1, 10))
      expect(3.14159.rationalize(0.001)).to eq(Rational(201, 64))
      expect(3.rationalize).to eq(Rational(3, 1))
    end
  end

  describe "rendering" do
    specify "to_s drops the parentheses inspect keeps" do
      expect(Rational(1, 3).to_s).to eq("1/3")
      expect(Rational(3, 1).to_s).to eq("3/1")
      expect(inspect(Rational(1, 3))).to eq("(1/3)")
    end

    specify "answers its class and the type pattern" do
      expect(Rational(1, 3).class).to eq(Rational)
      answer = case Rational(1, 2)
      in Rational then "rational"
      else "other"
      end
      expect(answer).to eq("rational")
    end
  end
end
