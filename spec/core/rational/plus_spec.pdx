# From ruby/spec core/rational/plus_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Rational#+" do
  specify "an integer with a rational is a rational, with a complex a complex" do
    expect((Rational(1, 2) + 0.5).class).to eq(Float)
    expect((Rational(1, 3) + Complex(1, 2)).class).to eq(Complex)
  end
end
