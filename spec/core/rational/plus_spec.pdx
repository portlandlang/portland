# From ruby/spec core/rational/plus_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Rational#+" do
  specify "an integer with a rational is a rational, with a complex a complex" do
    expect((Rational(1, 2) + 0.5)).to be_an_instance_of(Float)
    expect((Rational(1, 3) + Complex(1, 2))).to be_an_instance_of(Complex)
  end
end

context "Rational#+ with a Rational" do
  specify "returns the result of subtracting other from self as a Rational" do
    expect(Rational(3, 4) + Rational(0, 1)).to eql(Rational(3, 4))
    expect(Rational(3, 4) + Rational(1, 4)).to eql(Rational(1, 1))

    expect(Rational(3, 4) + Rational(2, 1)).to eql(Rational(11, 4))
  end
end

context "Rational#+ with a Float" do
  specify "returns the result of subtracting other from self as a Float" do
    expect(Rational(3, 4) + 0.2).to eql(0.95)
    expect(Rational(3, 4) + 2.5).to eql(3.25)
  end
end

context "Rational#+ with an Integer" do
  specify "returns the result of subtracting other from self as a Rational" do
    expect(Rational(3, 4) + 1).to eql(Rational(7, 4))
    expect(Rational(3, 4) + 2).to eql(Rational(11, 4))
  end
end
