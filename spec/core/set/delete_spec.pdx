# What a set holds (ADR 0082): membership by `eql?` under `include?`,
# `member?`, and `===`; `size`, `length`, and `empty?`; and `add` and
# `delete`, which answer a new set and leave the receiver as it was.
#
# From ruby/spec core/set/{include,member,case_compare,size,length,empty,
# add,delete}_spec.rb. Upstream: the alias checks (method objects), the
# objects defining hash and eql? by hand, the rows where add and delete
# answer the receiver itself, and add? and delete?, which mutate (ADR 0015).

require_relative "../../spec_helper"

context "Set#delete" do
  specify "answers a set without the value" do
    before = Set["a", "b", "c"]
    after = before.delete("a")
    expect(after.include?("a")).to be_false
    expect(after).to eq(Set["b", "c"])
  end

  specify "leaves the receiver as it was, and an absent value changes nothing" do
    before = Set["a", "b", "c"]
    expect(before.delete("x")).to eq(before)
    expect(before).to eq(Set["a", "b", "c"])
  end
end
