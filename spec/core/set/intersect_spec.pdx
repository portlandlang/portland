# From ruby/spec core/set/intersect_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Set#intersect?" do
  specify "tell whether the two share a member" do
    expect(Set[1, 2].intersect?(Set[2, 3])).to be_true
    expect(Set[1, 2].intersect?(Set[3, 4])).to be_false
  end

  specify "take any enumerable" do
    expect(Set[1, 2].intersect?([2])).to be_true
  end
end
