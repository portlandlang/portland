# From ruby/spec core/set/intersect_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

struct IntersectSetLike
  items

  include Enumerable

  def each = items.each { yield it }
end

context "Set#intersect?" do
  specify "tell whether the two share a member" do
    expect(Set[1, 2].intersect?(Set[2, 3])).to be_true
    expect(Set[1, 2].intersect?(Set[3, 4])).to be_false
  end

  specify "take any enumerable" do
    expect(Set[1, 2].intersect?([2])).to be_true
  end

  describe "when comparing to a Set-like object" do
    specify "returns true when a Set has at least one element in common with a Set-like object" do
      expect(Set[1, 2].intersect?(IntersectSetLike.new(items: [2, 3]))).to be_true
    end

    specify "returns false when a Set has no element in common with a Set-like object" do
      expect(Set[1, 2].intersect?(IntersectSetLike.new(items: [3, 4]))).to be_false
    end
  end
end
