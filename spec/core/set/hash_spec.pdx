# From ruby/spec core/set/hash_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Set#hash" do
  specify "is found by an equal set" do
    labels = {Set[1, 2] => "pair"}
    expect(labels[Set[1, 2]]).to eq("pair")
  end
end
