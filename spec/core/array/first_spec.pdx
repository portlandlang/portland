# ADR 0010 — `first` and `last` are partial, so each answers a maybe. The
# empty-array halves live in spec/optionals_spec.pdx; these are the present
# halves.

require_relative "../../spec_helper"

context "Array#first" do
  numbers = [3, 1, 2]
  specify "answers the front" do
    expect(numbers.first).to eq(3)
  end
end
