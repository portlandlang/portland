# Array's set arithmetic (#104), from ruby/spec core/array: - and
# difference (through upstream's shared array_binary_difference), union
# (array_binary_union), intersection (array_intersection), and intersect?.
# Elements match by eql?, as Ruby's do. Staying upstream: the Array#| and
# Array#& groups (ADR 0003 keeps both operators out of the grammar; union
# and intersection are their spelling), mocks stubbing hash and eql?,
# to_ary conversion (ADR 0036), recursive arrays and identity checks
# (values never mutate), and subclasses. Upstream's uniq! check asks
# whether uniq changes the answer.

require_relative "../../spec_helper"

context "Array#intersection" do
  specify "creates an array with elements common to both arrays (intersection)" do
    expect([].intersection([])).to eq([])
    expect([1, 2].intersection([])).to eq([])
    expect([].intersection([1, 2])).to eq([])
    expect([1, 3, 5].intersection([1, 2, 3])).to eq([1, 3])
  end

  specify "creates an array with no duplicates" do
    common = [1, 1, 3, 5].intersection([1, 2, 3])
    expect(common.uniq).to eq(common)
  end

  specify "creates an array with elements in order they are first encountered" do
    expect([1, 2, 3, 2, 5, 6, 7, 8].intersection([5, 2, 3, 4])).to eq([2, 3, 5])
    expect([5, 2, 3, 4].intersection([1, 2, 3, 2, 5, 6, 7, 8])).to eq([5, 2, 3])
  end

  specify "does not modify the original Array" do
    numbers = [1, 1, 3, 5]
    expect(numbers.intersection([1, 2, 3])).to eq([1, 3])
    expect(numbers).to eq([1, 1, 3, 5])
  end

  specify "determines equivalence between elements in the sense of eql?" do
    expect([5.0, 4.0].intersection([5, 4])).to eq([])
    expect(["x"].intersection(["x"])).to eq(["x"])
  end

  specify "accepts multiple arguments" do
    expect([1, 2, 3, 4].intersection([1, 2, 3], [2, 3, 4])).to eq([2, 3])
  end

  specify "preserves elements order from original array" do
    expect([1, 2, 3, 4].intersection([3, 2, 1])).to eq([1, 2, 3])
  end
end
