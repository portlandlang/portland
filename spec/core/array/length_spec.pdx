# From ruby/spec core/array/length_spec.rb.
#
# How many elements an array holds.

require_relative "../../spec_helper"

# ruby/spec core/array/length_spec.rb and size_spec.rb, title for title
# (#104). The alias check compares the two answers rather than method
# objects; recursive arrays cannot exist, since values never mutate.

context "Array#length" do
  specify "counts the elements" do
    expect([3, 1, 2]).to have_length(3)
  end

  specify "counts a nested array as one" do
    expect([1, [2, 3]]).to have_length(2)
  end

  specify "size is its twin (ADR 0036)" do
    expect([3, 1, 2].size).to eq(3)
    expect([3, 1, 2].size).to eq([3, 1, 2].length)
  end

  specify "is an alias of Array#size" do
    expect([1, 2, 3].length).to eq([1, 2, 3].size)
    expect([].length).to eq([].size)
  end
end
