# Ruby's combinatorics and cycle (#104), from ruby/spec
# core/array/{combination,repeated_combination,permutation,repeated_permutation,product,cycle}_spec.rb.
# Without a block each answers its arrangements as an array — there are no
# enumerators (ADR 0055), so the enumerator-size rows stay upstream — and
# with one hands them over in turn and answers the array; `cycle` takes a
# count, since a cycle with no count never ends, so the unbounded rows stay
# upstream with the StopIteration, to_int, and to_ary rows and the
# mid-walk mutation rows (values never mutate).

require_relative "../../spec_helper"

context "Array#combination" do
  specify "returns self when a block is given" do
    numbers = [1, 2, 3, 4]
    expect(numbers.combination(2) { }).to eq(numbers)
  end

  specify "yields nothing for out of bounds length and return self" do
    expect([1, 2, 3, 4].combination(5)).to eq([])
    expect([1, 2, 3, 4].combination(-1)).to eq([])
  end

  specify "yields the expected combinations" do
    expect([1, 2, 3, 4].combination(3).sort).to eq([[1, 2, 3], [1, 2, 4], [1, 3, 4], [2, 3, 4]])
  end

  specify "yields a copy of self if the argument is the size of the receiver" do
    expect([1, 2, 3, 4].combination(4)).to eq([[1, 2, 3, 4]])
  end

  specify "yields [] when length is 0" do
    expect([1, 2, 3, 4].combination(0)).to eq([[]])
    expect([].combination(0)).to eq([[]])
  end

  specify "yields a partition consisting of only singletons" do
    expect([1, 2, 3, 4].combination(1).sort).to eq([[1], [2], [3], [4]])
  end
end
