# Ruby's combinatorics and cycle (#104), from ruby/spec
# core/array/{combination,repeated_combination,permutation,repeated_permutation,product,cycle}_spec.rb.
# Without a block each answers its arrangements as an array — there are no
# enumerators (ADR 0055), so the enumerator-size rows stay upstream — and
# with one hands them over in turn and answers the array; `cycle` takes a
# count, since a cycle with no count never ends, so the unbounded rows stay
# upstream with the StopIteration, to_int, and to_ary rows and the
# mid-walk mutation rows (values never mutate).

require_relative "../../spec_helper"

context "Array#product" do
  specify "returns the expected result" do
    expect([1, 2].product([3, 4, 5], [6, 8])).to eq([[1, 3, 6], [1, 3, 8], [1, 4, 6], [1, 4, 8], [1, 5, 6], [1, 5, 8], [2, 3, 6], [2, 3, 8], [2, 4, 6], [2, 4, 8], [2, 5, 6], [2, 5, 8]])
  end

  specify "has no required argument" do
    expect([1, 2].product).to eq([[1], [2]])
  end

  specify "returns an empty array when the argument is an empty array" do
    expect([1, 2].product([])).to eq([])
  end

  describe "when given a block" do
    specify "yields all combinations in turn" do
      mutable seen = []
      [1, 2].product([3, 4, 5], [6, 8]) { |arrangement| seen << arrangement }
      expect(seen).to eq([[1, 3, 6], [1, 3, 8], [1, 4, 6], [1, 4, 8], [1, 5, 6], [1, 5, 8], [2, 3, 6], [2, 3, 8], [2, 4, 6], [2, 4, 8], [2, 5, 6], [2, 5, 8]])

      mutable none = []
      [1, 2].product([3, 4, 5], [], [6, 8]) { |arrangement| none << arrangement }
      expect(none).to be_empty
    end

    specify "returns self" do
      numbers = [1, 2, 3]
      expect(numbers.product([1, 2]) { |pair| pair.first }).to eq(numbers)
    end
  end
end
