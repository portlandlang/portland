# From ruby/spec core/array/reverse_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Array#reverse" do
  specify "Array#reverse walks backward" do
    expect([3, 1, 2].reverse).to eq([2, 1, 3])
  end

  specify "returns a new array with the elements in reverse order" do
    expect([].reverse).to eq([])
    expect([1, 3, 5, 2].reverse).to eq([2, 5, 3, 1])
  end
end
