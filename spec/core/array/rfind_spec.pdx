# Looking into an array and reshaping it (#104), from ruby/spec core/array:
# at, dig, assoc, rassoc, transpose, to_h, rfind, and reverse_each. Each
# lookup answers a maybe (ADR 0010). Staying upstream: identity checks and
# recursive arrays (values never mutate), mocks whose own == or dig takes
# over, to_ary and to_int conversion (ADR 0036), the refusals where Ruby
# raises, rfind's ifnone proc (#77, whether a block is a value), blockless
# Enumerators, mid-walk mutation, and subclasses. Upstream's
# `s_nil.first` is written `nil`: here `[nil, nil].first` is a present
# nil, the nested maybe ADR 0005 keeps distinct from absence.

require_relative "../../spec_helper"

context "Array#rfind" do
  specify "returns the last element for which the block is not false" do
    expect([1, 2, 3, 4, 5].rfind { |number| number % 2 == 0 }).to eq(4)
  end

  specify "returns nil when the block is false and there is no ifnone proc given" do
    expect([1, 2, 3].rfind { |number| false }).to eq(nil)
  end

  specify "iterates elements in reverse order" do
    mutable visited = []
    [1, 2, 3].rfind { |number|
      visited = visited + [number]
      false
    }
    expect(visited).to eq([3, 2, 1])
  end

  specify "stops iterating as soon as a matching element is found from the end" do
    mutable visited = []
    [1, 2, 3, 4, 5].rfind { |number|
      visited = visited + [number]
      number == 3
    }
    expect(visited).to eq([5, 4, 3])
  end

  specify "does not destructure elements" do
    pairs = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    expect(pairs.rfind { |element| element == [1, 2] }).to eq([1, 2])
  end
end
