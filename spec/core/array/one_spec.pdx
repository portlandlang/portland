# From ruby/spec core/array/one_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Array#one?" do
  specify "always returns false on empty enumeration" do
    expect([].one?(1..9)).to be_false
  end

  specify "returns true if the pattern returns a truthy value only once" do
    expect([1, 2, 42, 3].one?(42)).to be_true
  end

  specify "returns false if the pattern returns a truthy value more than once" do
    expect([1, 2, 3].one?(1..3)).to be_false
  end

  specify "returns false if the pattern never returns a truthy value" do
    expect([1, 2, 3].one?(7..9)).to be_false
  end
end
