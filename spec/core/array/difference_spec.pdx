# Array's set arithmetic (#104), from ruby/spec core/array: - and
# difference (through upstream's shared array_binary_difference), union
# (array_binary_union), intersection (array_intersection), and intersect?.
# Elements match by eql?, as Ruby's do. Staying upstream: the Array#| and
# Array#& groups (ADR 0003 keeps both operators out of the grammar; union
# and intersection are their spelling), mocks stubbing hash and eql?,
# to_ary conversion (ADR 0036), recursive arrays and identity checks
# (values never mutate), and subclasses. Upstream's uniq! check asks
# whether uniq changes the answer.

require_relative "../../spec_helper"

context "Array#difference" do
  specify "creates an array minus any items from other array" do
    expect([].difference([1, 2, 4])).to eq([])
    expect([1, 2, 4].difference([])).to eq([1, 2, 4])
    expect([1, 2, 3, 4, 5].difference([1, 2, 4])).to eq([3, 5])
  end

  specify "removes multiple items on the lhs equal to one on the rhs" do
    expect([1, 1, 2, 2, 3, 3, 4, 5].difference([1, 2, 4])).to eq([3, 3, 5])
  end

  specify "is not destructive" do
    numbers = [1, 2, 3]
    numbers.difference([1])
    expect(numbers).to eq([1, 2, 3])
  end

  specify "returns a copy when called without any parameter" do
    numbers = [1, 2, 3, 2]
    expect(numbers.difference).to eq(numbers)
  end

  specify "accepts multiple arguments" do
    numbers = [1, 2, 3, 1]
    expect(numbers.difference([], [0, 1], [3, 4], [3])).to eq([2])
  end
end
