# Walking an array with a block (#104), from ruby/spec core/array: map and
# collect, select and filter, reject, each, and detect. Alias checks
# compare the two answers rather than method objects. Blocks answer true
# or false where they choose, so reject's rows where nil or 5 stands for a
# truth stay upstream; so do identity checks, recursive arrays, and
# mid-walk mutation (values never mutate), the bang forms, subclasses,
# break with a value (ADR 0012), blockless Enumerators, and each's
# multi-parameter row, which waits on #158.

require_relative "../../spec_helper"

context "Array#detect" do
  specify "is an alias of Array#find" do
    expect([1, 2, 3].detect { it > 1 }).to eq([1, 2, 3].find { it > 1 })
    expect([1, 2, 3].detect { it > 5 }).to eq([1, 2, 3].find { it > 5 })
  end
end
