# From ruby/spec core/array/uniq_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Array#uniq" do
  specify "Array#uniq keeps first occurrences in order" do
    expect([1, 1, 3, 2, 3].uniq).to eq([1, 3, 2])
  end

  specify "returns an array with no duplicates" do
    expect(["a", "a", "b", "b", "c"].uniq).to eq(["a", "b", "c"])
  end

  specify "uses eql? semantics" do
    expect([1.0, 1].uniq).to eq([1.0, 1])
  end
end
