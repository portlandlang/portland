# From ruby/spec core/array/any_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Array#any?" do
  specify "any? asks whether one hit is enough" do
    expect([1, 2, 3].any? { it > 2 }).to be_true
    expect([1, 2, 3].any? { it > 5 }).to be_false
  end

  specify "always returns false on empty enumeration" do
    expect([].any?(1..9)).to be_false
  end

  specify "returns true if the pattern ever returns a truthy value" do
    expect([1, 42, 3].any?(42)).to be_true
  end

  specify "returns false if the block never returns other than false or nil" do
    expect([1, 2, 3].any?(9)).to be_false
  end

  describe "with a block given" do
    specify "is false if the array is empty" do
      empty_array = []
      expect(empty_array.any? {|v| 1 == 1 }).to be_false
    end

    specify "is true if the block returns true for any member of the array" do
      array_with_members = [false, false, true, false]
      expect(array_with_members.any? {|v| v == true }).to be_true
    end

    specify "is false if the block returns false for all members of the array" do
      array_with_members = [false, false, true, false]
      expect(array_with_members.any? {|v| v == 42 }).to be_false
    end
  end
end
