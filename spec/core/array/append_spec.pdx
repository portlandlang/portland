# From ruby/spec core/array/append_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Array#<<" do
  specify "and the name itself sees the append" do
    mutable numbers = [1]
    alias_of = numbers
    numbers << 2
    expect(numbers).to have_length(2)
  end
end
