# From ruby/spec core/string/chomp_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#chomp" do
  specify "String#chomp takes one trailing line ending, crlf as a unit" do
    expect("rose\n".chomp).to eq("rose")
    expect("rose\r\n".chomp).to eq("rose")
    expect("rose".chomp).to eq("rose")
  end

  describe "when passed no argument" do
    specify "does not modify a String with no trailing carriage return or newline" do
      expect("abc".chomp).to eq("abc")
    end

    specify "removes one trailing newline" do
      expect("abc\n\n".chomp).to eq("abc\n")
    end

    specify "removes one trailing carriage return" do
      expect("abc\r\r".chomp).to eq("abc\r")
    end

    specify "removes one trailing carriage return, newline pair" do
      expect("abc\r\n\r\n".chomp).to eq("abc\r\n")
    end

    specify "returns an empty String when self is empty" do
      expect("".chomp).to eq("")
    end
  end
end
