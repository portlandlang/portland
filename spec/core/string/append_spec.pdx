# From ruby/spec core/string/append_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#<<" do
  specify "appends to a string with <<" do
    mutable line = "rose"
    line << " city"
    expect(line).to eq("rose city")
  end
end
