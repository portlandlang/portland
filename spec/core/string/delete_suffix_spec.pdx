# A string's ends (#106), from ruby/spec core/string/{chop,chr,delete_prefix,delete_suffix}_spec.rb.
# The bang forms (values never mutate, ADR 0015), the to_str conversion
# (ADR 0036), subclasses, encodings, the broken-byte rows, and identity
# checks stay upstream; chr's row mixing character widths spells one of
# them with a \u escape Portland does not have.

require_relative "../../spec_helper"

context "String#delete_suffix" do
  specify "returns a copy of the string, with the given suffix removed" do
    expect("hello".delete_suffix("ello")).to eq("h")
    expect("hello".delete_suffix("hello")).to eq("")
  end

  specify "returns a copy of the string, when the suffix isn't found" do
    s = "hello"
    expect(s.delete_suffix("!hello")).to eq(s)
    expect(s.delete_suffix("ell")).to eq(s)
    expect(s.delete_suffix("")).to eq(s)
  end
end
