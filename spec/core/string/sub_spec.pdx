# Finding, counting, and replacing inside a string.
#
# From ruby/spec core/string/{index,rindex,count,lines,each_line,sub,gsub}_spec.rb.
# `count` takes a single character only: Ruby's multi-character count is a
# character-set count, not a substring count, and following it quietly
# would be principle 5's exact shape — so more than one character refuses,
# naming the trap. What stays upstream, and why, is each file's entry in
# spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#sub with pattern, replacement" do
  specify "doesn't interpret regexp metacharacters if pattern is a string" do
    expect("12345".sub('\d', "a")).to eq("12345")
    expect('\d'.sub('\d', "a")).to eq("a")
  end

  specify "replace the first match or every one" do
    expect("hello world".sub(/o/, "0")).to eq("hell0 world")
  end

  specify "read the replacement's escapes" do
    expect("2026-11-07".sub(/(\d+)-(\d+)-(\d+)/, '\3/\2/\1')).to eq("07/11/2026")
    expect("hello".sub(/ll/, "[\\`|\\']")).to eq("he[he|o]o")
    expect("ab".sub(/(a)/, '\2')).to eq("b")
    expect("ab".sub(/a/, '\x')).to eq('\xb')
  end

  specify "read the escapes with a string pattern too" do
    expect("hello".sub("l", '\0\0')).to eq("helllo")
  end

  specify "replaces \\+ with the last paren that actually matched" do
    greeting = "hello!"

    expect(greeting.sub(/(.)(.)/, '\+')).to eq("ello!")
    expect(greeting.sub(/(.)(.)+/, '\+')).to eq("!")
    expect(greeting.sub(/(.)()/, '\+')).to eq("ello!")
    expect(greeting.sub(/(.)(.{20})?/, '<\+>')).to eq("<h>ello!")

    letters = "ABCDEFGHIJKL"
    twelve = /#{"(.)" * 12}/
    expect(letters.sub(twelve, '\+')).to eq("L")
  end

  specify "treats \\+ as an empty string if there was no captures" do
    expect("hello!".sub(/./, '\+')).to eq("ello!")
  end

  specify "hand the block the matched text" do
    expect("hello".sub(/l+/) { |text| text.upcase }).to eq("heLLo")
  end

  specify "take the flags" do
    expect("a\nb".sub(/a.b/m, "X")).to eq("X")
  end

  specify "returns a copy of self with all occurrences of pattern replaced with replacement" do
    expect("hello".sub(/[aeiou]/, "*")).to eq("h*llo")
    expect("hello".sub(//, ".")).to eq(".hello")
  end

  specify 'supports \G which matches at the beginning of the string' do
    expect("hello world!".sub(/\Ghello/, "hi")).to eq("hi world!")
  end

  specify "supports /i for ignoring case" do
    expect("Hello".sub(/h/i, "j")).to eq("jello")
    expect("hello".sub(/H/i, "j")).to eq("jello")
  end

  specify "replaces \\1 sequences with the regexp's corresponding capture" do
    text = "hello"

    expect(text.sub(/([aeiou])/, '<\1>')).to eq("h<e>llo")
    expect(text.sub(/(.)/, '\1\1')).to eq("hhello")

    expect(text.sub(/.(.?)/, '<\0>(\1)')).to eq("<he>(e)llo")

    expect(text.sub(/.(.)+/, '\1')).to eq("o")

    letters = "ABCDEFGHIJKL"
    pattern = /#{"(.)" * 12}/
    expect(letters.sub(pattern, '\1')).to eq("A")
    expect(letters.sub(pattern, '\9')).to eq("I")
    # Only the first 9 captures can be accessed in MRI
    expect(letters.sub(pattern, '\10')).to eq("A0")
  end

  specify 'treats \1 sequences without corresponding captures as empty strings' do
    text = "hello!"

    expect(text.sub("", '<\1>')).to eq("<>hello!")
    expect(text.sub("h", '<\1>')).to eq("<>ello!")

    expect(text.sub(//, '<\1>')).to eq("<>hello!")
    expect(text.sub(/./, '\1\2\3')).to eq("ello!")
    expect(text.sub(/.(.{20})?/, '\1')).to eq("ello!")
  end

  specify 'replaces \& and \0 with the complete match' do
    text = "hello!"

    expect(text.sub("", '<\0>')).to eq("<>hello!")
    expect(text.sub("", '<\&>')).to eq("<>hello!")
    expect(text.sub("he", '<\0>')).to eq("<he>llo!")
    expect(text.sub("he", '<\&>')).to eq("<he>llo!")
    expect(text.sub("l", '<\0>')).to eq("he<l>lo!")
    expect(text.sub("l", '<\&>')).to eq("he<l>lo!")

    expect(text.sub(//, '<\0>')).to eq("<>hello!")
    expect(text.sub(//, '<\&>')).to eq("<>hello!")
    expect(text.sub(/../, '<\0>')).to eq("<he>llo!")
    expect(text.sub(/../, '<\&>')).to eq("<he>llo!")
    expect(text.sub(/(.)./, '<\0>')).to eq("<he>llo!")
  end

  specify 'replaces \` with everything before the current match' do
    text = "hello!"

    expect(text.sub("", '<\`>')).to eq("<>hello!")
    expect(text.sub("h", '<\`>')).to eq("<>ello!")
    expect(text.sub("l", '<\`>')).to eq("he<he>lo!")
    expect(text.sub("!", '<\`>')).to eq("hello<hello>")

    expect(text.sub(//, '<\`>')).to eq("<>hello!")
    expect(text.sub(/..o/, '<\`>')).to eq("he<he>!")
  end

  specify "replaces \\' with everything after the current match" do
    text = "hello!"

    expect(text.sub("", '<\\\'>')).to eq("<hello!>hello!")
    expect(text.sub("h", '<\\\'>')).to eq("<ello!>ello!")
    expect(text.sub("ll", '<\\\'>')).to eq("he<o!>o!")
    expect(text.sub("!", '<\\\'>')).to eq("hello<>")

    expect(text.sub(//, '<\\\'>')).to eq("<hello!>hello!")
    expect(text.sub(/../, '<\\\'>')).to eq("<llo!>llo!")
  end

  specify 'replaces \\\\\\+ with \\\\+' do
    expect("x".sub(/x/, '\\\+')).to eq("\\+")
  end

  specify 'maps \\\\ in replacement to \\' do
    expect("hello".sub(/./, '\\\\')).to eq('\\ello')
  end

  specify 'leaves unknown \x escapes in replacement untouched' do
    expect("hello".sub(/./, '\\x')).to eq('\\xello')
    expect("hello".sub(/./, '\\y')).to eq('\\yello')
  end

  specify 'leaves \ at the end of replacement untouched' do
    expect("hello".sub(/./, 'hah\\')).to eq('hah\\ello')
  end

  specify 'replaces \\\\\\1 with \\1' do
    expect("ababa".sub(/(b)/, '\\\1')).to eq("a\\1aba")
  end

  specify 'replaces \\\\\\\\1 with \\1' do
    expect("ababa".sub(/(b)/, '\\\\1')).to eq("a\\1aba")
  end

  specify 'replaces \\\\\\\\\\1 with \\' do
    expect("ababa".sub(/(b)/, '\\\\\1')).to eq("a\\baba")
  end
end

context "String#sub with pattern and block" do
  # Upstream's second line gathers the block's arguments with a splat,
  # which Portland does not have (ADR 0014).
  specify "returns a copy of self with the first occurrences of pattern replaced with the block's return value" do
    expect("hi".sub(/./) { |text| text + " " }).to eq("h i")
  end

  specify 'doesn\'t interpolate special sequences like \1 for the block\'s return value' do
    replacement = '\& \0 \1 \` \\\' \+ \\\\ foo'
    expect("hello".sub(/(.+)/) { replacement }).to eq(replacement)
  end
end
