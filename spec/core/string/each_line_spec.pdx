# Finding, counting, and replacing inside a string.
#
# From ruby/spec core/string/{index,rindex,count,lines,each_line,sub,gsub}_spec.rb.
# `count` takes a single character only: Ruby's multi-character count is a
# character-set count, not a substring count, and following it quietly
# would be principle 5's exact shape — so more than one character refuses,
# naming the trap. What stays upstream, and why, is each file's entry in
# spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#each_line" do
  specify "splits using default newline separator when none is specified" do
    mutable first = []
    "one\ntwo\r\nthree".each_line { |line| first << line }
    expect(first).to eq(["one\n", "two\r\n", "three"])

    mutable second = []
    "hello\n\n\nworld".each_line { |line| second << line }
    expect(second).to eq(["hello\n", "\n", "\n", "world"])

    mutable third = []
    "\n\n\n\n\n".each_line { |line| third << line }
    expect(third).to eq(["\n", "\n", "\n", "\n", "\n"])
  end

  specify "returns self" do
    expect("hello\nworld".each_line { }).to eq("hello\nworld")
  end

  specify "splits self using the supplied record separator and passes each substring to the block" do
    mutable pieces = []
    "one\ntwo\r\nthree".each_line("\n") { |piece| pieces << piece }
    expect(pieces).to eq(["one\n", "two\r\n", "three"])
  end

  specify "splits on a separator that is not a line ending" do
    mutable pieces = []
    "hello\nworld".each_line("l") { |piece| pieces << piece }
    expect(pieces).to eq(["hel", "l", "o\nworl", "d"])
  end

  specify "accepts a string separator" do
    expect("hello world".each_line("o").to_a).to eq(["hello", " wo", "rld"])
  end

  describe "when `chomp` keyword argument is passed" do
    specify "removes new line characters when separator is not specified" do
      mutable pieces = []
      "hello \nworld\n".each_line(chomp: true) { |piece| pieces << piece }
      expect(pieces).to eq(["hello ", "world"])
    end

    specify "removes a carriage return before the line feed" do
      mutable pieces = []
      "hello \r\nworld\r\n".each_line(chomp: true) { |piece| pieces << piece }
      expect(pieces).to eq(["hello ", "world"])
    end

    specify "removes only specified separator" do
      mutable pieces = []
      "hello world".each_line(" ", chomp: true) { |piece| pieces << piece }
      expect(pieces).to eq(["hello", "world"])
    end

    specify "ignores new line characters when separator is specified" do
      mutable pieces = []
      "hello\n world\n".each_line(" ", chomp: true) { |piece| pieces << piece }
      expect(pieces).to eq(["hello\n", "world\n"])
    end
  end
end
