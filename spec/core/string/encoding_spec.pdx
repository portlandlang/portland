# From ruby/spec core/string/encoding_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#encoding" do
  specify "returns UTF-8" do
    expect("䁀".encoding).to eq(Encoding::UTF_8)
    expect("a".encoding).to eq(Encoding::UTF_8)
    expect("".encoding).to eq(Encoding::UTF_8)
  end

  specify "returns UTF-8 if self isn't US-ASCII only" do
    text = "䁶ؙ"
    expect(text.ascii_only?).to be_false
    expect(text.encoding).to eq(Encoding::UTF_8)
  end

  specify "knows a string that is US-ASCII only" do
    expect("@".ascii_only?).to be_true
    expect("".ascii_only?).to be_true
  end
end
