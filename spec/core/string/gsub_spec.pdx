# Finding, counting, and replacing inside a string.
#
# From ruby/spec core/string/{index,rindex,count,lines,each_line,sub,gsub}_spec.rb.
# `count` takes a single character only: Ruby's multi-character count is a
# character-set count, not a substring count, and following it quietly
# would be principle 5's exact shape — so more than one character refuses,
# naming the trap. What stays upstream, and why, is each file's entry in
# spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#gsub with pattern and replacement" do
  specify "doesn't interpret regexp metacharacters if pattern is a string" do
    expect("12345".gsub('\d', "a")).to eq("12345")
    expect('\d'.gsub('\d', "a")).to eq("a")
  end

  specify "replace the first match or every one" do
    expect("hello world".gsub(/o/, "0")).to eq("hell0 w0rld")
    expect("hello".gsub(/z/, "0")).to eq("hello")
  end

  specify "read the replacement's escapes" do
    expect("ab".gsub(/(?<x>a)/, '<\k<x>>')).to eq("<a>b")
    expect("ab".gsub(/b/, '\&\&')).to eq("abb")
    expect("ab".gsub(/b/, '\0\0')).to eq("abb")
    expect("ab".gsub(/b/, '\\\\')).to eq('a\\')
  end

  specify "read the escapes with a string pattern too" do
    expect("hello".gsub("l", '<\&>')).to eq("he<l><l>o")
  end

  specify "replaces \\+ with the last paren that actually matched" do
    greeting = "hello!"

    expect(greeting.gsub(/(.)(.)/, '\+')).to eq("el!")
    expect(greeting.gsub(/(.)(.)+/, '\+')).to eq("!")
    expect(greeting.gsub(/(.)()/, '\+')).to eq("")
    expect(greeting.gsub(/(.)(.{20})?/, '<\+>')).to eq("<h><e><l><l><o><!>")

    letters = "ABCDEFGHIJKLabcdefghijkl"
    twelve = /#{"(.)" * 12}/
    expect(letters.gsub(twelve, '\+')).to eq("Ll")
  end

  specify "treats \\+ as an empty string if there was no captures" do
    expect("hello!".gsub(/./, '\+')).to eq("")
  end

  specify "hand the block the matched text" do
    expect("hello world".gsub(/\w+/) { |word| word.capitalize }).to eq("Hello World")
    expect("a1b2".gsub(/\d/) { |digit| (digit.to_i * 2).to_s }).to eq("a2b4")
  end

  specify "match the empty pattern at every character boundary" do
    expect("aaa".gsub(//, "-")).to eq("-a-a-a-")
    expect("abc".gsub(/b*/, "X")).to eq("XaXXcX")
  end

  specify "take the flags" do
    expect("Hello".gsub(/l/i, "L")).to eq("HeLLo")
  end
end

context "String#gsub with pattern and block" do
  specify "returns a copy of self with all occurrences of pattern replaced with the block's return value" do
    expect("hello".gsub("l") { "x" }).to eq("hexxo")
  end
end

context "String#gsub with a string pattern" do
  specify "handles multibyte characters" do
    expect("é".gsub("é", "â")).to eq("â")
    expect("aé".gsub("é", "â")).to eq("aâ")
    expect("éa".gsub("é", "â")).to eq("âa")
  end
end

context "String#gsub with pattern and Hash" do
  specify "returns a copy of self with all occurrences of pattern replaced with the value of the corresponding hash key" do
    expect("hello".gsub(/./, {"l" => "L"})).to eq("LL")
    expect("hello!".gsub(/(.)(.)/, {"he" => "she ", "ll" => "said"})).to eq("she said")
    expect("hello".gsub("l", {"l" => "el"})).to eq("heelelo")
  end

  specify "ignores keys that don't correspond to matches" do
    expect("hello".gsub(/./, {"z" => "L", "h" => "b", "o" => "ow"})).to eq("bow")
  end

  specify "returns an empty string if the pattern matches but the hash specifies no replacements" do
    expect("hello".gsub(/./, {"z" => "L"})).to eq("")
  end

  specify "ignores non-String keys" do
    expect("tattoo".gsub(/(tt)/, {"tt" => "b", tt: "z"})).to eq("taboo")
  end

  specify "uses a key's value as many times as needed" do
    expect("food".gsub(/o/, {"o" => "0"})).to eq("f00d")
  end

  specify "coerces the hash values with #to_s" do
    expect("food!".gsub(/./, {"o" => 0, "!" => :bang, "d" => [1, 2]})).to eq("00[1, 2]bang")
  end
end
