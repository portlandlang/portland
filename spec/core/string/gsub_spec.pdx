# Finding, counting, and replacing inside a string.
#
# From ruby/spec core/string/{index,rindex,count,lines,each_line,sub,gsub}_spec.rb.
# `count` takes a single character only: Ruby's multi-character count is a
# character-set count, not a substring count, and following it quietly
# would be principle 5's exact shape — so more than one character refuses,
# naming the trap. What stays upstream, and why, is each file's entry in
# spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#gsub with pattern and replacement" do
  specify "doesn't interpret regexp metacharacters if pattern is a string" do
    expect("12345".gsub('\d', "a")).to eq("12345")
    expect('\d'.gsub('\d', "a")).to eq("a")
  end

  specify "replace the first match or every one" do
    expect("hello world".gsub(/o/, "0")).to eq("hell0 w0rld")
    expect("hello".gsub(/z/, "0")).to eq("hello")
  end

  specify "read the replacement's escapes" do
    expect("ab".gsub(/(?<x>a)/, '<\k<x>>')).to eq("<a>b")
    expect("ab".gsub(/b/, '\&\&')).to eq("abb")
    expect("ab".gsub(/b/, '\0\0')).to eq("abb")
    expect("ab".gsub(/b/, '\\\\')).to eq('a\\')
  end

  specify "read the escapes with a string pattern too" do
    expect("hello".gsub("l", '<\&>')).to eq("he<l><l>o")
  end

  specify "replaces \\+ with the last paren that actually matched" do
    greeting = "hello!"

    expect(greeting.gsub(/(.)(.)/, '\+')).to eq("el!")
    expect(greeting.gsub(/(.)(.)+/, '\+')).to eq("!")
    expect(greeting.gsub(/(.)()/, '\+')).to eq("")
    expect(greeting.gsub(/(.)(.{20})?/, '<\+>')).to eq("<h><e><l><l><o><!>")

    letters = "ABCDEFGHIJKLabcdefghijkl"
    twelve = /#{"(.)" * 12}/
    expect(letters.gsub(twelve, '\+')).to eq("Ll")
  end

  specify "treats \\+ as an empty string if there was no captures" do
    expect("hello!".gsub(/./, '\+')).to eq("")
  end

  specify "hand the block the matched text" do
    expect("hello world".gsub(/\w+/) { |word| word.capitalize }).to eq("Hello World")
    expect("a1b2".gsub(/\d/) { |digit| (digit.to_i * 2).to_s }).to eq("a2b4")
  end

  specify "match the empty pattern at every character boundary" do
    expect("aaa".gsub(//, "-")).to eq("-a-a-a-")
    expect("abc".gsub(/b*/, "X")).to eq("XaXXcX")
  end

  specify "take the flags" do
    expect("Hello".gsub(/l/i, "L")).to eq("HeLLo")
  end

  specify "inserts the replacement around every character when the pattern collapses" do
    expect("hello".gsub(//, ".")).to eq(".h.e.l.l.o.")
  end

  # Upstream spells the empty pattern `%r!!`; `%r` takes `{}` here.
  specify "respects unicode when the pattern collapses" do
    text = "こにちわ"
    pattern = %r{}

    expect(text.gsub(pattern, ".")).to eq(".こ.に.ち.わ.")
  end

  specify "doesn't freak out when replacing ^" do
    expect("Text\n".gsub(/^/, " ")).to eq(" Text\n")
    expect("Text\nFoo".gsub(/^/, " ")).to eq(" Text\n Foo")
  end

  specify "returns a copy of self with all occurrences of pattern replaced with replacement" do
    expect("hello".gsub(/[aeiou]/, "*")).to eq("h*ll*")

    text = "hello homely world. hah!"
    expect(text.gsub(/\Ah\S+\s*/, "huh? ")).to eq("huh? homely world. hah!")

    spanish = "¿por qué?"
    expect(spanish.gsub(/([a-z\d]*)/, "*")).to eq("*¿** **é*?*")
  end

  specify 'supports \G which matches at the beginning of the remaining (non-matched) string' do
    text = "hello homely world. hah!"
    expect(text.gsub(/\Gh\S+\s*/, "huh? ")).to eq("huh? huh? world. hah!")
  end

  specify "supports /i for ignoring case" do
    text = "Hello. How happy are you?"
    expect(text.gsub(/h/i, "j")).to eq("jello. jow jappy are you?")
    expect(text.gsub(/H/i, "j")).to eq("jello. jow jappy are you?")
  end

  specify "replaces \\1 sequences with the regexp's corresponding capture" do
    text = "hello"

    expect(text.gsub(/([aeiou])/, '<\1>')).to eq("h<e>ll<o>")
    expect(text.gsub(/(.)/, '\1\1')).to eq("hheelllloo")

    expect(text.gsub(/.(.?)/, '<\0>(\1)')).to eq("<he>(e)<ll>(l)<o>()")

    expect(text.gsub(/.(.)+/, '\1')).to eq("o")

    letters = "ABCDEFGHIJKLabcdefghijkl"
    pattern = /#{"(.)" * 12}/
    expect(letters.gsub(pattern, '\1')).to eq("Aa")
    expect(letters.gsub(pattern, '\9')).to eq("Ii")
    # Only the first 9 captures can be accessed in MRI
    expect(letters.gsub(pattern, '\10')).to eq("A0a0")
  end

  specify 'treats \1 sequences without corresponding captures as empty strings' do
    text = "hello!"

    expect(text.gsub("", '<\1>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub("h", '<\1>')).to eq("<>ello!")

    expect(text.gsub(//, '<\1>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub(/./, '\1\2\3')).to eq("")
    expect(text.gsub(/.(.{20})?/, '\1')).to eq("")
  end

  specify 'replaces \& and \0 with the complete match' do
    text = "hello!"

    expect(text.gsub("", '<\0>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub("", '<\&>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub("he", '<\0>')).to eq("<he>llo!")
    expect(text.gsub("he", '<\&>')).to eq("<he>llo!")
    expect(text.gsub("l", '<\0>')).to eq("he<l><l>o!")
    expect(text.gsub("l", '<\&>')).to eq("he<l><l>o!")

    expect(text.gsub(//, '<\0>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub(//, '<\&>')).to eq("<>h<>e<>l<>l<>o<>!<>")
    expect(text.gsub(/../, '<\0>')).to eq("<he><ll><o!>")
    expect(text.gsub(/../, '<\&>')).to eq("<he><ll><o!>")
    expect(text.gsub(/(.)./, '<\0>')).to eq("<he><ll><o!>")
  end

  specify 'replaces \` with everything before the current match' do
    text = "hello!"

    expect(text.gsub("", '<\`>')).to eq("<>h<h>e<he>l<hel>l<hell>o<hello>!<hello!>")
    expect(text.gsub("h", '<\`>')).to eq("<>ello!")
    expect(text.gsub("l", '<\`>')).to eq("he<he><hel>o!")
    expect(text.gsub("!", '<\`>')).to eq("hello<hello>")

    expect(text.gsub(//, '<\`>')).to eq("<>h<h>e<he>l<hel>l<hell>o<hello>!<hello!>")
    expect(text.gsub(/../, '<\`>')).to eq("<><he><hell>")
  end

  specify "replaces \\' with everything after the current match" do
    text = "hello!"

    expect(text.gsub("", '<\\\'>')).to eq("<hello!>h<ello!>e<llo!>l<lo!>l<o!>o<!>!<>")
    expect(text.gsub("h", '<\\\'>')).to eq("<ello!>ello!")
    expect(text.gsub("ll", '<\\\'>')).to eq("he<o!>o!")
    expect(text.gsub("!", '<\\\'>')).to eq("hello<>")

    expect(text.gsub(//, '<\\\'>')).to eq("<hello!>h<ello!>e<llo!>l<lo!>l<o!>o<!>!<>")
    expect(text.gsub(/../, '<\\\'>')).to eq("<llo!><o!><>")
  end

  specify 'maps \\\\ in replacement to \\' do
    expect("hello".gsub(/./, '\\\\')).to eq('\\' * 5)
  end

  specify 'leaves unknown \x escapes in replacement untouched' do
    expect("hello".gsub(/./, '\\x')).to eq('\\x' * 5)
    expect("hello".gsub(/./, '\\y')).to eq('\\y' * 5)
  end

  specify 'leaves \ at the end of replacement untouched' do
    expect("hello".gsub(/./, 'hah\\')).to eq('hah\\' * 5)
  end

  specify "replaces \\k named backreferences with the regexp's corresponding capture" do
    text = "hello"

    expect(text.gsub(/(?<foo>[aeiou])/, '<\k<foo>>')).to eq("h<e>ll<o>")
    expect(text.gsub(/(?<foo>.)/, '\k<foo>\k<foo>')).to eq("hheelllloo")
  end

  specify "handles pattern collapse" do
    text = "こにちわ"
    pattern = %r{}
    expect(text.gsub(pattern, ".")).to eq(".こ.に.ち.わ.")
  end
end

context "String#gsub with pattern and block" do
  specify "returns a copy of self with all occurrences of pattern replaced with the block's return value" do
    expect("hello".gsub("l") { "x" }).to eq("hexxo")
  end

  specify 'doesn\'t interpolate special sequences like \1 for the block\'s return value' do
    replacement = '\& \0 \1 \` \\\' \+ \\\\ foo'
    expect("hello".gsub(/(.+)/) { replacement }).to eq(replacement)
  end

  # Upstream's mocks define `to_s`; a symbol and an integer, whose `to_s`
  # is builtin, stand in. A struct's own `to_s` waits on #370.
  specify "converts the block's return value to a string using to_s" do
    expect("hello".gsub(/hello/) { :hello_replacement }).to eq("hello_replacement")

    expect("hello".gsub(/.+/) { 42 }).to eq("42")
  end
end

context "String#gsub with a string pattern" do
  specify "handles multibyte characters" do
    expect("é".gsub("é", "â")).to eq("â")
    expect("aé".gsub("é", "â")).to eq("aâ")
    expect("éa".gsub("é", "â")).to eq("âa")
  end
end
