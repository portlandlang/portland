# From ruby/spec core/string/count_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#count" do
  specify "String#count counts one character's occurrences" do
    expect("banana".count("a")).to eq(3)
  end

  specify "count sees through the encodings too" do
    expect("café".count("é")).to eq(1)
  end

  specify "counts multibyte characters" do
    star = "★"
    expect(star.count(star)).to eq(1)
    expect("asd#{star}zzz#{star}ggg".count(star)).to eq(2)
  end
end
