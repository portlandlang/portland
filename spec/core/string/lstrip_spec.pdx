# From ruby/spec core/string/lstrip_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#lstrip" do
  specify "String#lstrip and #rstrip take one end each" do
    expect("  rose".lstrip).to eq("rose")
  end
end
