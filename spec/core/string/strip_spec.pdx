# From ruby/spec core/string/strip_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#strip" do
  specify "String#strip takes whitespace off both ends" do
    expect("  rose  ".strip).to eq("rose")
  end

  specify "returns a copy of self without leading and trailing NULL bytes and whitespace" do
    null = 0.chr
    expect((" " + null + " goodbye " + null + " ").strip).to eq("goodbye")
  end
end
