# The question-shaped library: does this string contain, start, or end with?
#
# The rows below the house examples are from ruby/spec
# core/string/{include,start_with,end_with}_spec.rb and the shared
# start_with/end_with rows. `start_with?` and `end_with?` take any number of
# candidates. The regex rows wait on #74; the to_str conversion and the
# refusals (ADR 0036), subclasses, encodings, and the partial-character rows
# stay upstream.

require_relative "../../spec_helper"

context "String#start_with?" do
  city = "portland"
  specify "anchors at the front" do
    expect(city.start_with?("port")).to be_true
    expect(city.start_with?("land")).to be_false
  end
end

context "String#start_with?" do
  specify "returns true only if beginning match" do
    greeting = "hello"
    expect(greeting.start_with?("h")).to be_true
    expect(greeting.start_with?("hel")).to be_true
    expect(greeting.start_with?("el")).to be_false
  end

  specify "returns true only if any beginning match" do
    expect("hello".start_with?("x", "y", "he", "z")).to be_true
  end

  specify "returns true if the search string is empty" do
    expect("hello".start_with?("")).to be_true
    expect("".start_with?("")).to be_true
  end

  specify "works for multibyte strings" do
    expect("céréale".start_with?("cér")).to be_true
  end

  specify "answers whether the pattern matches at the start" do
    expect("hello".start_with?(/h.l/)).to be_true
    expect("hello".start_with?(/l/)).to be_false
    expect("hello".start_with?("x", /h/)).to be_true
  end
end
