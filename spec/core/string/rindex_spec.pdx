# Finding, counting, and replacing inside a string.
#
# From ruby/spec core/string/{index,rindex,count,lines,each_line,sub,gsub}_spec.rb.
# `count` takes a single character only: Ruby's multi-character count is a
# character-set count, not a substring count, and following it quietly
# would be principle 5's exact shape — so more than one character refuses,
# naming the trap. What stays upstream, and why, is each file's entry in
# spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#rindex with String" do
  specify "returns the index of the last occurrence of the given substring" do
    expect("blablabla".rindex("")).to eq(9)
    expect("blablabla".rindex("a")).to eq(8)
    expect("blablabla".rindex("la")).to eq(7)
    expect("blablabla".rindex("bla")).to eq(6)
    expect("blablabla".rindex("abla")).to eq(5)
    expect("blablabla".rindex("labla")).to eq(4)
    expect("blablabla".rindex("blabla")).to eq(3)
    expect("blablabla".rindex("ablabla")).to eq(2)
    expect("blablabla".rindex("lablabla")).to eq(1)
    expect("blablabla".rindex("blablabla")).to eq(0)

    expect("blablabla".rindex("l")).to eq(7)
    expect("blablabla".rindex("bl")).to eq(6)
    expect("blablabla".rindex("abl")).to eq(5)
    expect("blablabla".rindex("labl")).to eq(4)
    expect("blablabla".rindex("blabl")).to eq(3)
    expect("blablabla".rindex("ablabl")).to eq(2)
    expect("blablabla".rindex("lablabl")).to eq(1)
    expect("blablabla".rindex("blablabl")).to eq(0)

    expect("blablabla".rindex("b")).to eq(6)
  end

  specify "starts the search at the given offset" do
    expect("blablabla".rindex("bl", 0)).to eq(0)
    expect("blablabla".rindex("bl", 1)).to eq(0)
    expect("blablabla".rindex("bl", 2)).to eq(0)
    expect("blablabla".rindex("bl", 3)).to eq(3)

    expect("blablabla".rindex("bla", 0)).to eq(0)
    expect("blablabla".rindex("bla", 1)).to eq(0)
    expect("blablabla".rindex("bla", 2)).to eq(0)
    expect("blablabla".rindex("bla", 3)).to eq(3)

    expect("blablabla".rindex("blab", 0)).to eq(0)
    expect("blablabla".rindex("blab", 1)).to eq(0)
    expect("blablabla".rindex("blab", 2)).to eq(0)
    expect("blablabla".rindex("blab", 3)).to eq(3)
    expect("blablabla".rindex("blab", 6)).to eq(3)
    expect("blablablax".rindex("blab", 6)).to eq(3)

    expect("blablabla".rindex("la", 1)).to eq(1)
    expect("blablabla".rindex("la", 2)).to eq(1)
    expect("blablabla".rindex("la", 3)).to eq(1)
    expect("blablabla".rindex("la", 4)).to eq(4)

    expect("blablabla".rindex("lab", 1)).to eq(1)
    expect("blablabla".rindex("lab", 2)).to eq(1)
    expect("blablabla".rindex("lab", 3)).to eq(1)
    expect("blablabla".rindex("lab", 4)).to eq(4)

    expect("blablabla".rindex("ab", 2)).to eq(2)
    expect("blablabla".rindex("ab", 3)).to eq(2)
    expect("blablabla".rindex("ab", 4)).to eq(2)
    expect("blablabla".rindex("ab", 5)).to eq(5)

    expect("blablabla".rindex("", 0)).to eq(0)
    expect("blablabla".rindex("", 1)).to eq(1)
    expect("blablabla".rindex("", 2)).to eq(2)
    expect("blablabla".rindex("", 7)).to eq(7)
    expect("blablabla".rindex("", 8)).to eq(8)
    expect("blablabla".rindex("", 9)).to eq(9)
    expect("blablabla".rindex("", 10)).to eq(9)
  end

  specify "starts the search at offset + self.length if offset is negative" do
    str = "blablabla"

    ["bl", "bla", "blab", "la", "lab", "ab", ""].each do |needle|
      (-str.length..-1).each do |offset|
        expect(str.rindex(needle, offset)).to eq(str.rindex(needle, offset + str.length))
      end
    end
  end

  specify "returns nil if the substring isn't found" do
    expect("blablabla".rindex("B")).to be_nil
    expect("blablabla".rindex("z")).to be_nil
    expect("blablabla".rindex("BLA")).to be_nil
    expect("blablabla".rindex("blablablabla")).to be_nil

    expect("hello".rindex("lo", 0)).to be_nil
    expect("hello".rindex("lo", 1)).to be_nil
    expect("hello".rindex("lo", 2)).to be_nil

    expect("hello".rindex("llo", 0)).to be_nil
    expect("hello".rindex("llo", 1)).to be_nil

    expect("hello".rindex("el", 0)).to be_nil
    expect("hello".rindex("ello", 0)).to be_nil

    expect("hello".rindex("", -6)).to be_nil
    expect("hello".rindex("", -7)).to be_nil

    expect("hello".rindex("h", -6)).to be_nil
  end

  specify "behaves the same as String#rindex(char) for one-character strings" do
    "blablabla hello cruel world...!".split("").uniq.each do |text|
      character = text[0]
      expect(text.rindex(text)).to eq(text.rindex(character))

      0.upto(text.size + 1) do |start|
        expect(text.rindex(text, start)).to eq(text.rindex(character, start))
      end

      (-text.size - 1).upto(-1) do |start|
        expect(text.rindex(text, start)).to eq(text.rindex(character, start))
      end
    end
  end
end

context "String#rindex with Regexp" do
  specify "returns the index of the first match from the end of string of regexp" do
    expect("blablabla".rindex(/bla/)).to eq(6)
    expect("blablabla".rindex(/BLA/i)).to eq(6)

    expect("blablabla".rindex(/.{0}/)).to eq(9)
    expect("blablabla".rindex(/.{1}/)).to eq(8)
    expect("blablabla".rindex(/.{2}/)).to eq(7)
    expect("blablabla".rindex(/.{6}/)).to eq(3)
    expect("blablabla".rindex(/.{9}/)).to eq(0)

    expect("blablabla".rindex(/.*/)).to eq(9)
    expect("blablabla".rindex(/.+/)).to eq(8)

    expect("blablabla".rindex(/bla|a/)).to eq(8)

    expect("blablabla".rindex(/\A/)).to eq(0)
    expect("blablabla".rindex(/\Z/)).to eq(9)
    expect("blablabla".rindex(/\z/)).to eq(9)
    expect("blablabla\n".rindex(/\Z/)).to eq(10)
    expect("blablabla\n".rindex(/\z/)).to eq(10)

    expect("blablabla".rindex(/^/)).to eq(0)
    expect("\nblablabla".rindex(/^/)).to eq(1)
    expect("b\nlablabla".rindex(/^/)).to eq(2)
    expect("blablabla".rindex(/$/)).to eq(9)

    expect("blablabla".rindex(/.l./)).to eq(6)
  end

  specify "starts the search at the given offset" do
    expect("blablabla".rindex(/.{0}/, 5)).to eq(5)
    expect("blablabla".rindex(/.{1}/, 5)).to eq(5)
    expect("blablabla".rindex(/.{2}/, 5)).to eq(5)
    expect("blablabla".rindex(/.{3}/, 5)).to eq(5)
    expect("blablabla".rindex(/.{4}/, 5)).to eq(5)

    expect("blablabla".rindex(/.{0}/, 3)).to eq(3)
    expect("blablabla".rindex(/.{1}/, 3)).to eq(3)
    expect("blablabla".rindex(/.{2}/, 3)).to eq(3)
    expect("blablabla".rindex(/.{5}/, 3)).to eq(3)
    expect("blablabla".rindex(/.{6}/, 3)).to eq(3)

    expect("blablabla".rindex(/.l./, 0)).to eq(0)
    expect("blablabla".rindex(/.l./, 1)).to eq(0)
    expect("blablabla".rindex(/.l./, 2)).to eq(0)
    expect("blablabla".rindex(/.l./, 3)).to eq(3)

    expect("blablablax".rindex(/.x/, 10)).to eq(8)
    expect("blablablax".rindex(/.x/, 9)).to eq(8)
    expect("blablablax".rindex(/.x/, 8)).to eq(8)

    expect("blablablax".rindex(/..x/, 10)).to eq(7)
    expect("blablablax".rindex(/..x/, 9)).to eq(7)
    expect("blablablax".rindex(/..x/, 8)).to eq(7)
    expect("blablablax".rindex(/..x/, 7)).to eq(7)

    expect("blablabla\n".rindex(/\Z/, 9)).to eq(9)
  end

  specify "starts the search at offset + self.length if offset is negative" do
    text = "blablabla"

    ["bl", "bla", "blab", "la", "lab", "ab", ""].each do |needle|
      (-text.length..-1).each do |offset|
        expect(text.rindex(needle, offset)).to eq(text.rindex(needle, offset + text.length))
      end
    end
  end

  specify "returns nil if the substring isn't found" do
    expect("blablabla".rindex(/BLA/)).to be_nil
    expect("blablabla".rindex(/.{10}/)).to be_nil
    expect("blablablax".rindex(/.x/, 7)).to be_nil
    expect("blablablax".rindex(/..x/, 6)).to be_nil

    expect("blablabla".rindex(/\Z/, 5)).to be_nil
    expect("blablabla".rindex(/\z/, 5)).to be_nil
    expect("blablabla\n".rindex(/\z/, 9)).to be_nil
  end

  specify "returns the reverse character index of a multibyte character" do
    expect("ありがりがとう".rindex("が")).to eq(4)
    expect("ありがりがとう".rindex(/が/)).to eq(4)
  end

  specify "returns the character index before the finish" do
    expect("ありがりがとう".rindex("が", 3)).to eq(2)
    expect("ありがりがとう".rindex(/が/, 3)).to eq(2)
  end
end

context "String#rindex with object" do
  specify "answer the position of the first and last match" do
    expect("hello".rindex(/l/)).to eq(3)
  end

  specify "answer nil for no match" do
    expect("hello".rindex(/z/)).to be_nil
  end

  specify "search from a position" do
    expect("hello".rindex(/l/, 2)).to eq(2)
  end

  specify "rindex finds a match that overlaps an earlier one" do
    expect("aaa".rindex(/aa/)).to eq(1)
  end
end

context "String#rindex with Regexp" do
  specify "behaves the same as String#rindex(string) for escaped string regexps" do
    ["blablabla", "hello cruel world...!"].each do |text|
      ["", "b", "bla", "lab", "o c", "d."].each do |needle|
        pattern = Regexp.new(Regexp.escape(needle))
        expect(text.rindex(pattern)).to eq(text.rindex(needle))

        0.upto(text.size + 1) do |start|
          expect(text.rindex(pattern, start)).to eq(text.rindex(needle, start))
        end

        (-text.size - 1).upto(-1) do |start|
          expect(text.rindex(pattern, start)).to eq(text.rindex(needle, start))
        end
      end
    end
  end

  specify "supports \\G which matches at the given start offset" do
    expect("helloYOU.".rindex(/YOU\G/, 8)).to eq(5)
    expect("helloYOU.".rindex(/YOU\G/)).to be_nil

    position = "helloYOUall!".index("YOU")
    pattern = /YOU.+\G.+/
    # The # marks where \G will match.
    [
      ["helloYOU#all.", nil],
      ["helloYOUa#ll.", position],
      ["helloYOUal#l.", position],
      ["helloYOUall#.", position],
      ["helloYOUall.#", nil]
    ].each do |marked, expected|
      start = marked.index("#")
      text = marked.delete("#")
      expect(text.rindex(pattern, start)).to eq(expected)
    end
  end
end
