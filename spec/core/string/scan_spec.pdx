# `String#scan` (ADR 0086): every match of a pattern, or of a string's
# literal text; a pattern's groups come back as an array per match; a block
# is handed each and the string is the answer.
#
# From ruby/spec core/string/scan_spec.rb. Upstream: every `$~` row (the
# match globals are gone, so a block reads its match through the argument
# it is handed); the `|*w|` splat parameter (deferred, ADR 0014); `to_str`
# mocks; the String-subclass and US-ASCII encoding rows (one String type,
# UTF-8 always, ADR 0069); and `equal?`, asked here as `==`. A pattern that
# is neither a Regexp nor a String refuses in Ruby's words, `wrong argument
# type Integer (expected Regexp)`, pinned by a two-oracle test.

require_relative "../../spec_helper"

context "String#scan" do
  specify "returns an array containing all matches" do
    expect("cruel world".scan(/\w+/)).to eq(["cruel", "world"])
    expect("cruel world".scan(/.../)).to eq(["cru", "el ", "wor"])
    expect("hello".scan(//)).to eq(["", "", "", "", "", ""])
    expect("".scan(//)).to eq([""])
  end

  specify "respects unicode when the pattern collapses to nothing" do
    expect("こにちわ".scan(%r{})).to eq(["", "", "", "", ""])
  end

  specify "stores groups as arrays in the returned arrays" do
    expect("hello".scan(/()/)).to eq([[""], [""], [""], [""], [""], [""]])
    expect("hello".scan(/()()/)).to eq([["", ""], ["", ""], ["", ""], ["", ""], ["", ""], ["", ""]])
    expect("cruel world".scan(/(...)/)).to eq([["cru"], ["el "], ["wor"]])
    expect("cruel world".scan(/(..)(..)/)).to eq([["cr", "ue"], ["l ", "wo"]])
  end

  specify "scans for occurrences of the string if pattern is a string" do
    expect("one two one two".scan("one")).to eq(["one", "one"])
    expect("hello.".scan(".")).to eq(["."])
  end

  specify "supports \\G, which matches the end of the previous match or the string start" do
    expect("one two one two".scan(/\G\w+/)).to eq(["one"])
    expect("one two one two".scan(/\G\w+\s*/)).to eq(["one ", "two ", "one ", "two"])
    expect("one two one two".scan(/\G\s*\w+/)).to eq(["one", " two", " one", " two"])
  end

  specify "does not raise any errors when passed a multi-byte string" do
    expect("あああaaaあああ".scan("あああ")).to eq(["あああ", "あああ"])
  end

  specify "returns an array of each match" do
    expect("a1b22c333".scan(/\d+/)).to eq(["1", "22", "333"])
    expect("abc".scan(/x/)).to eq([])
  end

  specify "returns an array of each match's groups when the pattern has any" do
    expect("a1b22".scan(/([a-z])(\d+)/)).to eq([["a", "1"], ["b", "22"]])
    expect("ab".scan(/(a)(x)?/)).to eq([["a", nil]])
  end

  specify "hands each match to a block and answers the string" do
    mutable seen = []
    answer = "Hello World".scan(/\w+/) { |word| seen << word }
    expect(seen).to eq(["Hello", "World"])
    expect(answer).to eq("Hello World")
  end
end
context "String#scan with pattern and block" do
  specify "returns self" do
    text = "foo"
    expect(text.scan(/./) { it } == text).to be_true
    expect(text.scan(/roar/) { it } == text).to be_true
  end

  specify "passes groups to the block as one argument: an array" do
    mutable seen = []
    "cruel world".scan(/(..)(..)/) { |pair| seen << pair }
    expect(seen).to eq([["cr", "ue"], ["l ", "wo"]])
  end

  specify "passes a match without groups as its text" do
    mutable seen = []
    "cruel world".scan(/\w+/) { |word| seen << word }
    expect(seen).to eq(["cruel", "world"])
  end

  specify "passes block arguments as individual arguments when the block takes several" do
    mutable seen = []
    "a b c\na b c\na b c".scan(/(\w*) (\w*) (\w*)/) { |first, second, third| seen << [first, second, third] }
    expect(seen).to eq([["a", "b", "c"], ["a", "b", "c"], ["a", "b", "c"]])
  end
end
