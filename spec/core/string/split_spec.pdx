# `String#split` with Ruby's rules (#142): trailing empty fields drop unless
# the limit is negative, a positive limit caps the pieces, `" "` or no
# separator splits on runs of whitespace, and `""` splits into characters.
# Every expected value is Ruby 4.0.9's answer for the same call.
#
# The rows below the house examples are from ruby/spec
# core/string/split_spec.rb. What stays upstream, and why,
# is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "String#split with String" do
  specify "splits on multibyte characters" do
    expect("ありがりがとう".split("が")).to eq(["あり", "り", "とう"])
  end

  specify "returns an array of substrings based on splitting on the given string" do
    expect("mellow yellow".split("ello")).to eq(["m", "w y", "w"])
  end

  specify "suppresses trailing empty fields when limit isn't given or 0" do
    expect("1,2,,3,4,,".split(",")).to eq(["1", "2", "", "3", "4"])
    expect("1,2,,3,4,,".split(",", 0)).to eq(["1", "2", "", "3", "4"])
    expect("  a  b  c\nd  ".split("  ")).to eq(["", "a", "b", "c\nd"])
    expect("  a  あ  c\nd  ".split("  ")).to eq(["", "a", "あ", "c\nd"])
    expect("hai".split("hai")).to eq([])
    expect(",".split(",")).to eq([])
    expect(",".split(",", 0)).to eq([])
    expect("あ".split("あ")).to eq([])
    expect("あ".split("あ", 0)).to eq([])
  end

  specify "does not suppress trailing empty fields when a positive limit is given" do
    expect(" 1 2 ".split(" ", 2)).to eq(["1", "2 "])
    expect(" 1 2 ".split(" ", 3)).to eq(["1", "2", ""])
    expect(" 1 2 ".split(" ", 4)).to eq(["1", "2", ""])
    expect(" 1 あ ".split(" ", 2)).to eq(["1", "あ "])
    expect(" 1 あ ".split(" ", 3)).to eq(["1", "あ", ""])
    expect(" 1 あ ".split(" ", 4)).to eq(["1", "あ", ""])

    expect("1,2,".split(",", 2)).to eq(["1", "2,"])
    expect("1,2,".split(",", 3)).to eq(["1", "2", ""])
    expect("1,2,".split(",", 4)).to eq(["1", "2", ""])
    expect("1,あ,".split(",", 2)).to eq(["1", "あ,"])
    expect("1,あ,".split(",", 3)).to eq(["1", "あ", ""])
    expect("1,あ,".split(",", 4)).to eq(["1", "あ", ""])
  end

  specify "returns an array with one entry if limit is 1: the original string" do
    expect("hai".split("hai", 1)).to eq(["hai"])
    expect("x.y.z".split(".", 1)).to eq(["x.y.z"])
    expect("hello world ".split(" ", 1)).to eq(["hello world "])
    expect("hi!".split("", 1)).to eq(["hi!"])
  end

  specify "returns at most limit fields when limit > 1" do
    expect("hai".split("hai", 2)).to eq(["", ""])

    expect("1,2".split(",", 3)).to eq(["1", "2"])

    expect("1,2,,3,4,,".split(",", 2)).to eq(["1", "2,,3,4,,"])
    expect("1,2,,3,4,,".split(",", 3)).to eq(["1", "2", ",3,4,,"])
    expect("1,2,,3,4,,".split(",", 4)).to eq(["1", "2", "", "3,4,,"])
    expect("1,2,,3,4,,".split(",", 5)).to eq(["1", "2", "", "3", "4,,"])
    expect("1,2,,3,4,,".split(",", 6)).to eq(["1", "2", "", "3", "4", ","])

    expect("x".split("x", 2)).to eq(["", ""])
    expect("xx".split("x", 2)).to eq(["", "x"])
    expect("xx".split("x", 3)).to eq(["", "", ""])
    expect("xxx".split("x", 2)).to eq(["", "xx"])
    expect("xxx".split("x", 3)).to eq(["", "", "x"])
    expect("xxx".split("x", 4)).to eq(["", "", "", ""])
  end

  specify "doesn't suppress or limit fields when limit is negative" do
    expect("1,2,,3,4,,".split(",", -1)).to eq(["1", "2", "", "3", "4", "", ""])
    expect("1,2,,3,4,,".split(",", -5)).to eq(["1", "2", "", "3", "4", "", ""])
    expect("  a  b  c\nd  ".split("  ", -1)).to eq(["", "a", "b", "c\nd", ""])
    expect(",".split(",", -1)).to eq(["", ""])
  end

  specify "ignores leading and continuous whitespace when string is a single space" do
    expect(" now's  the time  ".split(" ")).to eq(["now's", "the", "time"])
    expect(" now's  the time  ".split(" ", -1)).to eq(["now's", "the", "time", ""])
    expect(" now's  the time  ".split(" ", 3)).to eq(["now's", "the", "time  "])
    expect("\t\n a\t\tb \n\r\r\nc d ".split(" ")).to eq(["a", "b", "c", "d"])
  end

  describe "when limit is zero" do
    specify "ignores leading and continuous whitespace when string is a single space" do
      expect(" now's  the time  ".split(" ", 0)).to eq(["now's", "the", "time"])
    end
  end

  specify "splits between characters when its argument is an empty string" do
    expect("hi!".split("")).to eq(["h", "i", "!"])
    expect("hi!".split("", -1)).to eq(["h", "i", "!", ""])
    expect("hi!".split("", 0)).to eq(["h", "i", "!"])
    expect("hi!".split("", 1)).to eq(["hi!"])
    expect("hi!".split("", 2)).to eq(["h", "i!"])
    expect("hi!".split("", 3)).to eq(["h", "i", "!"])
    expect("hi!".split("", 4)).to eq(["h", "i", "!", ""])
    expect("hi!".split("", 5)).to eq(["h", "i", "!", ""])
  end

  specify "returns the original string if no matches are found" do
    expect("foo".split("bar")).to eq(["foo"])
    expect("foo".split("bar", -1)).to eq(["foo"])
    expect("foo".split("bar", 0)).to eq(["foo"])
    expect("foo".split("bar", 1)).to eq(["foo"])
    expect("foo".split("bar", 2)).to eq(["foo"])
    expect("foo".split("bar", 3)).to eq(["foo"])
  end

  specify "returns an empty array when whitespace is split on whitespace" do
    expect(" ".split(" ")).to eq([])
    expect(" \n ".split(" ")).to eq([])
    expect("  ".split(" ")).to eq([])
    expect(" \t ".split(" ")).to eq([])
  end

  specify "doesn't split on non-ascii whitespace" do
    expect("a　b".split(" ")).to eq(["a　b"])
  end

  specify "splits on each match" do
    expect("a1b2c".split(/\d/)).to eq(["a", "b", "c"])
    expect("a b  c".split(/\s+/)).to eq(["a", "b", "c"])
  end

  specify "includes the groups between the pieces" do
    expect("a1b2c".split(/(\d)/)).to eq(["a", "1", "b", "2", "c"])
  end

  specify "splits into characters on the empty pattern" do
    expect("abc".split(//)).to eq(["a", "b", "c"])
  end

  specify "caps the pieces by a positive limit and keeps trailing empties by a negative one" do
    expect("a1b2c3".split(/\d/, 2)).to eq(["a", "b2c3"])
    expect("a1b2c3".split(/\d/, -1)).to eq(["a", "b", "c", ""])
    expect("a1b2c3".split(/\d/)).to eq(["a", "b", "c"])
  end

  specify "handles empty matches as Ruby does" do
    expect("abc".split(/b*/)).to eq(["a", "c"])
    expect("aaa".split(/a*/)).to eq([])
    expect("".split(/x/)).to eq([])
  end

  specify "drops trailing empty fields and keeps the ones between" do
    expect("a,b,,c,,".split(",")).to eq(["a", "b", "", "c"])
    expect("a\nb\n\n".split("\n")).to eq(["a", "b"])
    expect(",a".split(",")).to eq(["", "a"])
  end

  specify "keeps trailing empty fields under a negative limit" do
    expect("a,b,,c,,".split(",", -1)).to eq(["a", "b", "", "c", "", ""])
    expect("a\nb\n\n".split("\n", -1)).to eq(["a", "b", "", ""])
  end

  specify "caps the pieces under a positive limit, the last holding the rest" do
    expect("a,b,c".split(",", 2)).to eq(["a", "b,c"])
    expect("a,b,c".split(",", 1)).to eq(["a,b,c"])
    expect("a,b".split(",", 0)).to eq(["a", "b"])
  end

  specify "splits on runs of whitespace with no separator or a single space" do
    expect("a b  c ".split).to eq(["a", "b", "c"])
    expect("  a b  c ".split(" ")).to eq(["a", "b", "c"])
  end

  specify "splits into characters on an empty separator" do
    expect("abc".split("")).to eq(["a", "b", "c"])
  end

  specify "answers no fields for an empty string, and the whole for no match" do
    expect("".split(",")).to eq([])
    expect("x".split(",")).to eq(["x"])
    expect("a::b".split("::")).to eq(["a", "b"])
  end
end

context "String#split with Regexp" do
  specify "divides self on regexp matches" do
    expect(" now's  the time".split(/ /)).to eq(["", "now's", "", "the", "time"])
    expect(" x\ny ".split(/ /)).to eq(["", "x\ny"])
    expect("1, 2.34,56, 7".split(/,\s*/)).to eq(["1", "2.34", "56", "7"])
    expect("1x2X3".split(/x/i)).to eq(["1", "2", "3"])
  end

  specify "treats negative limits as no limit" do
    expect("".split(%r{/+}, -1)).to eq([])
  end

  specify "suppresses trailing empty fields when limit isn't given or 0" do
    expect("1,2,,3,4,,".split(/,/)).to eq(["1", "2", "", "3", "4"])
    expect("1,2,,3,4,,".split(/,/, 0)).to eq(["1", "2", "", "3", "4"])
    expect("  a  b  c\nd  ".split(/\s+/)).to eq(["", "a", "b", "c", "d"])
    expect("hai".split(/hai/)).to eq([])
    expect(",".split(/,/)).to eq([])
    expect(",".split(/,/, 0)).to eq([])
  end

  specify "returns an array with one entry if limit is 1: the original string" do
    expect("hai".split(/hai/, 1)).to eq(["hai"])
    expect("xAyBzC".split(/[A-Z]/, 1)).to eq(["xAyBzC"])
    expect("hello world ".split(/\s+/, 1)).to eq(["hello world "])
    expect("hi!".split(//, 1)).to eq(["hi!"])
  end

  specify "returns at most limit fields when limit > 1" do
    expect("hai".split(/hai/, 2)).to eq(["", ""])

    expect("1,2".split(/,/, 3)).to eq(["1", "2"])

    expect("1,2,,3,4,,".split(/,/, 2)).to eq(["1", "2,,3,4,,"])
    expect("1,2,,3,4,,".split(/,/, 3)).to eq(["1", "2", ",3,4,,"])
    expect("1,2,,3,4,,".split(/,/, 4)).to eq(["1", "2", "", "3,4,,"])
    expect("1,2,,3,4,,".split(/,/, 5)).to eq(["1", "2", "", "3", "4,,"])
    expect("1,2,,3,4,,".split(/,/, 6)).to eq(["1", "2", "", "3", "4", ","])

    expect("x".split(/x/, 2)).to eq(["", ""])
    expect("xx".split(/x/, 2)).to eq(["", "x"])
    expect("xx".split(/x/, 3)).to eq(["", "", ""])
    expect("xxx".split(/x/, 2)).to eq(["", "xx"])
    expect("xxx".split(/x/, 3)).to eq(["", "", "x"])
    expect("xxx".split(/x/, 4)).to eq(["", "", "", ""])
  end

  specify "doesn't suppress or limit fields when limit is negative" do
    expect("1,2,,3,4,,".split(/,/, -1)).to eq(["1", "2", "", "3", "4", "", ""])
    expect("1,2,,3,4,,".split(/,/, -5)).to eq(["1", "2", "", "3", "4", "", ""])
    expect("  a  b  c\nd  ".split(/\s+/, -1)).to eq(["", "a", "b", "c", "d", ""])
    expect(",".split(/,/, -1)).to eq(["", ""])
  end

  specify "splits between characters when regexp matches a zero-length string" do
    expect("hello".split(//)).to eq(["h", "e", "l", "l", "o"])
    expect("hello".split(//, -1)).to eq(["h", "e", "l", "l", "o", ""])
    expect("hello".split(//, 0)).to eq(["h", "e", "l", "l", "o"])
    expect("hello".split(//, 1)).to eq(["hello"])
    expect("hello".split(//, 2)).to eq(["h", "ello"])
    expect("hello".split(//, 5)).to eq(["h", "e", "l", "l", "o"])
    expect("hello".split(//, 6)).to eq(["h", "e", "l", "l", "o", ""])
    expect("hello".split(//, 7)).to eq(["h", "e", "l", "l", "o", ""])

    expect("hi mom".split(/\s*/)).to eq(["h", "i", "m", "o", "m"])

    expect("AABCCBAA".split(/(?=B)/)).to eq(["AA", "BCC", "BAA"])
    expect("AABCCBAA".split(/(?=B)/, -1)).to eq(["AA", "BCC", "BAA"])
    expect("AABCCBAA".split(/(?=B)/, 2)).to eq(["AA", "BCCBAA"])
  end

  # Upstream spells the empty pattern `%r!!`; `%r` takes `{}` here.
  specify "respects unicode when splitting between characters" do
    text = "こにちわ"
    pattern = %r{}
    pieces = text.split(pattern)
    expect(pieces.size).to eq(4)
    expect(pieces).to eq(["こ", "に", "ち", "わ"])
  end

  specify "includes all captures in the result array" do
    expect("hello".split(/(el)/)).to eq(["h", "el", "lo"])
    expect("hi!".split(/()/)).to eq(["h", "", "i", "", "!"])
    expect("hi!".split(/()/, -1)).to eq(["h", "", "i", "", "!", "", ""])
    expect("hello".split(/((el))()/)).to eq(["h", "el", "el", "", "lo"])
    expect("AabB".split(/([a-z])+/)).to eq(["A", "b", "B"])
  end

  specify "applies the limit to the number of split substrings, without counting captures" do
    expect("aBaBa".split(/(B)()()/, 2)).to eq(["a", "B", "", "", "aBa"])
  end

  specify "does not include non-matching captures in the result array" do
    expect("hello".split(/(el)|(xx)/)).to eq(["h", "el", "lo"])
  end

  specify "returns the original string if no matches are found" do
    expect("foo".split(/bar/)).to eq(["foo"])
    expect("foo".split(/bar/, -1)).to eq(["foo"])
    expect("foo".split(/bar/, 0)).to eq(["foo"])
    expect("foo".split(/bar/, 1)).to eq(["foo"])
    expect("foo".split(/bar/, 2)).to eq(["foo"])
    expect("foo".split(/bar/, 3)).to eq(["foo"])
  end

  specify "splits a string on each character for a multibyte encoding and empty split" do
    expect("That's why eﬃciency could not be helped".split("").size).to eq(39)
  end
end

context "String#split when a block is given" do
  specify "yields each split substring with default pattern" do
    mutable pieces = []
    returned = "chunky bacon".split { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky bacon")
    expect(pieces).to eq(["Chunky", "Bacon"])
  end

  specify "yields each split substring with default pattern for a non-ASCII string" do
    mutable pieces = []
    returned = "l'été arrive bientôt".split { |part| pieces << part }

    expect(returned).to eq("l'été arrive bientôt")
    expect(pieces).to eq(["l'été", "arrive", "bientôt"])
  end

  specify "yields the string when limit is 1" do
    mutable pieces = []
    returned = "chunky bacon".split("", 1) { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky bacon")
    expect(pieces).to eq(["Chunky bacon"])
  end

  specify "yields each split letter" do
    mutable pieces = []
    returned = "chunky".split("", 0) { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky")
    expect(pieces).to eq(%w[C H U N K Y])
  end

  specify "yields each split substring with a pattern" do
    mutable pieces = []
    returned = "chunky-bacon".split("-", 0) { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky-bacon")
    expect(pieces).to eq(["Chunky", "Bacon"])
  end

  specify "yields each split substring with empty regexp pattern" do
    mutable pieces = []
    returned = "chunky".split(//) { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky")
    expect(pieces).to eq(%w[C H U N K Y])
  end

  specify "yields each split substring with empty regexp pattern and limit" do
    mutable pieces = []
    returned = "chunky".split(//, 3) { |part| pieces << part.capitalize }

    expect(returned).to eq("chunky")
    expect(pieces).to eq(%w[C H Unky])
  end

  specify "returns a string as is (and doesn't call block) if it is empty" do
    mutable pieces = []
    returned = "".split { |part| pieces << part.capitalize }

    expect(returned).to eq("")
    expect(pieces).to eq([])
  end
end
