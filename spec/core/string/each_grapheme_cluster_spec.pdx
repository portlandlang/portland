# From ruby/spec core/string/each_grapheme_cluster_spec.rb.
#
# `chars` — a string as an array of one-character strings — and `each_char`,
# the walk (#106). From ruby/spec core/string/{chars,each_char}_spec.rb and
# their shared chars rows. A character is a grapheme (ADR 0038). The block
# form of chars (deprecated Ruby), the blockless each_char (an enumerator),
# subclasses, encodings, and the invalid-byte rows stay upstream.

require_relative "../../spec_helper"

context "String#each_grapheme_cluster" do
  specify "passes each grapheme cluster in self to the given block" do
    mutable seen = []
    "ab🏳️‍🌈🐾".each_grapheme_cluster { |cluster| seen << cluster }
    expect(seen).to eq(["a", "b", "🏳️‍🌈", "🐾"])
  end

  specify "returns self" do
    expect("hello".each_grapheme_cluster { }).to eq("hello")
  end
end
