# `i` on every real (ADR 0085): the complex with the number as its
# imaginary part.
#
# From ruby/spec core/numeric/i_spec.rb.

require_relative "../../spec_helper"

context "Numeric#i" do
  specify "returns a Complex object" do
    expect(34.i.class).to eq(Complex)
  end

  specify "sets the real part to 0" do
    expect(7342.i.real).to eq(0)
  end

  specify "sets the imaginary part to self" do
    expect(62.81.i.imag).to eq(62.81)
  end

  specify "has the i suffix for literals and the unit constant" do
    expect(3.i).to eq(Complex(0, 3))
  end
end
context "Numeric#i on an integer" do
  specify "is the complex with it as the imaginary part" do
    expect(3.i).to eq(Complex(0, 3))
  end
end
