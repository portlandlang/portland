# `rectangular`, and its name `rect`, on every real (ADR 0085): the
# number and 0. NaN is 0.0 / 0.0 and infinity 1.0 / 0.0.
#
# From ruby/spec core/numeric/rectangular_spec.rb; rect_spec.rb compares
# method objects, so its name is specced here. Upstream: the bignums,
# integers being 64-bit, and the rows that hand an argument to a name
# taking none, which refuse.

require_relative "../../spec_helper"

context "Numeric#rectangular" do
  numbers = [20, 398.72, Rational(3, 4), 1.0 / 0.0]

  specify "returns an Array" do
    numbers.each do |number|
      expect(number.rectangular.class).to eq(Array)
    end
  end

  specify "returns a two-element Array" do
    numbers.each do |number|
      expect(number.rectangular.size).to eq(2)
    end
    expect((0.0 / 0.0).rectangular.size).to eq(2)
  end

  specify "returns self as the first element" do
    numbers.each do |number|
      expect(number.rectangular.first).to eq(number)
    end
    expect((0.0 / 0.0).rectangular.first.nan?).to be_true
  end

  specify "returns 0 as the last element" do
    numbers.each do |number|
      expect(number.rectangular.last).to eq(0)
    end
    expect((0.0 / 0.0).rectangular.last).to eq(0)
  end
end
context "Numeric#rectangular on an integer, and its name rect" do
  specify "is the number and 0" do
    expect(3.rect).to eq([3, 0])
    expect(3.rectangular).to eq([3, 0])
  end
end
