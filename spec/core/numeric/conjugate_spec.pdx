# `conjugate`, and its name `conj`, on every real (ADR 0085): the real
# itself. NaN is 0.0 / 0.0 and infinity 1.0 / 0.0.
#
# From ruby/spec core/numeric/conjugate_spec.rb; conj_spec.rb compares
# method objects, so its name is specced here. Upstream: the bignums,
# integers being 64-bit.

require_relative "../../spec_helper"

context "Numeric#conjugate" do
  specify "returns self" do
    [20, 398.72, Rational(3, 4), 1.0 / 0.0].each do |number|
      expect(number.conjugate).to eq(number)
    end
    expect((0.0 / 0.0).conjugate.nan?).to be_true
  end
end
context "Numeric#conjugate on an integer and a float, and its name conj" do
  specify "is the number itself" do
    expect(3.conj).to eq(3)
    expect(1.5.conjugate).to eq(1.5)
  end
end
