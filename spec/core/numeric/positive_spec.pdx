# From ruby/spec core/numeric/positive_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Numeric#positive?" do
  specify "split around zero, which is neither" do
    expect(5.positive?).to be_true
    expect(0.positive?).to be_false
  end
end
