# From ruby/spec core/complex/to_f_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Complex#to_f" do
  specify "to a real when the imaginary part is an exact zero" do
    expect(Complex(1, 0).to_f).to eq(1.0)
  end
end
