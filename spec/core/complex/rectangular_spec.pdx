# From ruby/spec core/complex/rectangular_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

RECTANGULAR_NUMBERS = [Complex(1), Complex(0, 20), Complex(0, 0), Complex(0.0), Complex(-20), Complex.polar(76, 10)]

context "Complex#rectangular" do
  specify "comes from polar and rectangular coordinates" do
    expect(Complex.rectangular(1, 2)).to eq(Complex(1, 2))
  end

  specify "real, imaginary, rectangular, conjugate" do
    expect(Complex(3, 4).rectangular).to eq([3, 4])
  end

  specify "returns an Array" do
    RECTANGULAR_NUMBERS.each do |number|
      expect(number.rectangular).to be_an_instance_of(Array)
    end
  end

  specify "returns a two-element Array" do
    RECTANGULAR_NUMBERS.each do |number|
      expect(number.rectangular.size).to eq(2)
    end
  end

  specify "returns the real part of self as the first element" do
    RECTANGULAR_NUMBERS.each do |number|
      expect(number.rectangular.first).to eq(number.real)
    end
  end

  specify "returns the imaginary part of self as the last element" do
    RECTANGULAR_NUMBERS.each do |number|
      expect(number.rectangular.last).to eq(number.imaginary)
    end
  end
end

context "Complex.rectangular" do
  describe "when passed a Complex" do
    specify "ignores the imaginary part if it is zero" do
      result = Complex.rectangular(1.0 + 0i, 2 + 0.0i)
      expect(result.real).to eq(1.0)
      expect(result.imag).to eq(2)
    end
  end
end
