# From ruby/spec core/complex/integer_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#integer?" do
  specify "the predicates" do
    expect(Complex(1, 2).integer?).to be_false
  end

  specify "returns false for a Complex with no imaginary part" do
    expect(Complex(20).integer?).to be_false
  end

  specify "returns false for a Complex with an imaginary part" do
    expect(Complex(20,3).integer?).to be_false
  end
end
