# From ruby/spec core/complex/comparison_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#<=>" do
  specify "answers <=> only where both sides are real" do
    expect(Complex(1, 2) <=> Complex(1, 3)).to be_nil
    expect(Complex(1, 0) <=> 2).to eq(-1)
  end

  specify "returns nil if either self or argument has imaginary part" do
    expect(Complex(5, 1) <=> Complex(2)).to be_nil
    expect(Complex(1) <=> Complex(2, 1)).to be_nil
    expect(5 <=> Complex(2, 1)).to be_nil
  end

  specify "returns 0, 1, or -1 if self and argument do not have imaginary part" do
    expect(Complex(5) <=> Complex(2)).to eq(1)
    expect(Complex(2) <=> Complex(3)).to eq(-1)
    expect(Complex(2) <=> Complex(2)).to eq(0)

    expect(Complex(5) <=> 2).to eq(1)
    expect(Complex(2) <=> 3).to eq(-1)
    expect(Complex(2) <=> 2).to eq(0)
  end
end
