# From ruby/spec core/complex/polar_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Complex.polar" do
  specify "comes from polar and rectangular coordinates" do
    expect(inspect(Complex.polar(1, Math::PI))).to eq("(-1+0.0i)")
    expect(inspect(Complex.polar(2, 0))).to eq("(2+0.0i)")
  end

  specify "abs, abs2, arg, polar" do
    expect(Complex(3, 4).polar).to eq([5.0, 0.9272952180016122])
  end
end
