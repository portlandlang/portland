# From ruby/spec core/complex/to_i_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#to_i" do
  specify "to a real when the imaginary part is an exact zero" do
    expect(Complex(1, 0).to_i).to eq(1)
  end
end
