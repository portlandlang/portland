# From ruby/spec core/complex/to_r_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#to_r" do
  specify "to a real when the imaginary part is an exact zero" do
    expect(Complex(1, 0).to_r).to eq(Rational(1, 1))
  end

  describe "when the imaginary part is Float 0.0" do
    specify "returns a Rational" do
      expect(Complex(0, 0.0).to_r).to eq(0r)
      expect(Complex(1.5, -0.0).to_r).to eq(Rational(3, 2))
    end
  end
end
