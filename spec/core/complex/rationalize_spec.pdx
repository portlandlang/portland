# From ruby/spec core/complex/rationalize_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Complex#rationalize" do
  specify "to a real when the imaginary part is an exact zero" do
    expect(Complex(1, 0).rationalize).to eq(Rational(1, 1))
  end
end
