# From ruby/spec core/complex/rationalize_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#rationalize" do
  specify "to a real when the imaginary part is an exact zero" do
    expect(Complex(1, 0).rationalize).to eq(Rational(1, 1))
  end

  specify "returns a Rational if self has zero imaginary part" do
    expect(Complex(1,0).rationalize).to eq(Rational(1,1))
  end

  specify "ignores a single argument" do
    expect(Complex(1,0).rationalize(0.1)).to eq(Rational(1,1))
  end
end
