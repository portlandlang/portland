# From ruby/spec core/complex/denominator_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Complex#denominator" do
  specify "numerator and denominator over exact parts" do
    expect(Complex(1, 2).denominator).to eq(1)
    expect(Complex(Rational(1, 2), Rational(1, 3)).denominator).to eq(6)
  end
end
