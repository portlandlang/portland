# From ruby/spec core/complex/real_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Complex#real" do
  specify "real, imaginary, rectangular, conjugate" do
    expect(Complex(3, 4).real).to eq(3)
  end

  specify "the predicates" do
    expect(Complex(3, 4).real?).to be_false
  end

  specify "returns the real part of self" do
    expect(Complex(1, 0).real).to eq(1)
    expect(Complex(2, 1).real).to eq(2)
    expect(Complex(6.7, 8.9).real).to eq(6.7)
  end
end

context "Complex#real?" do
  specify "returns false if there is an imaginary part" do
    expect(Complex(2,3).real?).to be_false
  end

  specify "returns false if there is not an imaginary part" do
    expect(Complex(2).real?).to be_false
  end

  specify "returns false if the real part is Infinity" do
    expect(Complex(Float::INFINITY).real?).to be_false
  end

  specify "returns false if the real part is NaN" do
    expect(Complex(Float::NAN).real?).to be_false
  end
end
