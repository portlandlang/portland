# From ruby/spec core/complex/exponent_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

TOLERANCE = 0.00003

context "Complex#**" do
  specify "raises to powers as Ruby does" do
    expect(Complex(1, 2) ** 2).to eq(Complex(-3, 4))
    expect(inspect(Complex(1, 2) ** 0)).to eq("(1+0i)")
    expect(inspect(Complex(1, 2) ** -1)).to eq("((1/5)-(2/5)*i)")
    expect(inspect(Complex(1, 2) ** 0.5)).to eq("(1.272019649514069+0.7861513777574233i)")
    expect(inspect(Complex(1, 2) ** Complex(0, 1))).to eq("(0.2291401859804338+0.23817011512167555i)")
  end

  describe "with Integer 0" do
    specify "returns Complex(1)" do
      expect(Complex(3, 4) ** 0).to eql(Complex(1))
    end
  end

  describe "with Float 0.0" do
    specify "returns Complex(1.0, 0.0)" do
      expect(Complex(3, 4) ** 0.0).to eql(Complex(1.0, 0.0))
    end
  end

  describe "with Complex" do
    specify "returns self raised to the given power" do
      expect(Complex(2, 1) ** Complex(2, 1)).to be_close(Complex(-0.504824688978319, 3.10414407699553), TOLERANCE)
      expect(Complex(2, 1) ** Complex(3, 4)).to be_close(Complex(-0.179174656916581, -1.74071656397662), TOLERANCE)

      expect(Complex(2, 1) ** Complex(-2, -1)).to be_close(Complex(-0.051041070450869, -0.313849223270419), TOLERANCE)
      expect(Complex(-2, -1) ** Complex(2, 1)).to be_close(Complex(-11.6819929610857, 71.8320439736158), TOLERANCE)
    end
  end

  describe "with Integer" do
    specify "returns self raised to the given power" do
      expect(Complex(2, 1) ** 2).to eq(Complex(3, 4))
      expect(Complex(3, 4) ** 2).to eq(Complex(-7, 24))
      expect(Complex(3, 4) ** -2).to be_close(Complex(-0.0112, -0.0384), TOLERANCE)


      expect(Complex(2, 1) ** 2.5).to be_close(Complex(2.99179707178602, 6.85206901006896), TOLERANCE)
      expect(Complex(3, 4) ** 2.5).to be_close(Complex(-38.0, 41.0), TOLERANCE)
      expect(Complex(3, 4) ** -2.5).to be_close(Complex(-0.01216, -0.01312), TOLERANCE)

      expect(Complex(1) ** 1).to eq(Complex(1))
    end
  end

  describe "with Rational" do
    specify "returns self raised to the given power" do
      expect(Complex(2, 1) ** Rational(3, 4)).to be_close(Complex(1.71913265276568, 0.623124744394697), TOLERANCE)
      expect(Complex(2, 1) ** Rational(4, 3)).to be_close(Complex(2.3828547125173, 1.69466313833091), TOLERANCE)
      expect(Complex(2, 1) ** Rational(-4, 3)).to be_close(Complex(0.278700377879388, -0.198209003071003), TOLERANCE)
    end
  end
end
