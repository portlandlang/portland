# `loop do ... end` — `while true` in Ruby's favorite clothes (ADR 0037,
# revised same-day: first declined, then wanted). A keyword form, not a
# method, desugared at parse to the while node — so break, next, and the
# per-iteration scope rule are `while`'s by construction, and only the
# `do` block shape exists (`loop` alone refuses naming the rewrite).

require_relative "../../spec_helper"

# From ruby/spec core/kernel/loop_spec.rb: the one row a keyword form can
# carry. Upstream: break's value (ADR 0012), the enumerator and
# StopIteration rows, and the privacy rows.
context "Kernel#loop" do
  specify "calls block until it is terminated by a break" do
    mutable index = 0
    loop do
      index += 1
      break if index == 10
    end
    expect(index).to eq(10)
  end
end
