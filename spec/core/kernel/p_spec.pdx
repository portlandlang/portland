# Ruby's output wrappers over the two standard streams (ADR 0068, #185):
# `puts`, `p`, `pp`, `print`, `putc`, `printf` on standard output and `warn`
# on standard error. Each row captures what the call writes with
# `System.capture_standard_output` or `System.capture_standard_error`
# (#251), as upstream's `output` matcher does, and checks what it answers.
#
# From ruby/spec core/kernel/{p,pp,print,putc,printf,warn,puts}_spec.rb.
# Upstream: the privacy and reflection rows, `$stdout` and `$VERBOSE`
# reassignment, `output_to_fd`, `$_`, the separator globals, splatted
# arguments, the IO-first-argument forms of printf, the `to_int` and `to_str`
# mocks, and warn's uplevel and category keywords. A mock's own `inspect` or
# `to_s` waits on #282, held as a pending.

require_relative "../../spec_helper"

# Upstream's mock("Inspector Gadget"), its `inspect` answering the line.
struct InspectorGadget
  name

  def inspect
    "Next time, Gadget, NEXT TIME!"
  end
end

context "Kernel#p" do
  pending "prints obj.inspect followed by system record separator for each argument given (#282)" do
    gadget = InspectorGadget.new(name: "Inspector Gadget")
    expect(System.capture_standard_output { p(gadget) }).to eq("Next time, Gadget, NEXT TIME!\n")
    expect(System.capture_standard_output { p(gadget, gadget) }).to eq("Next time, Gadget, NEXT TIME!\nNext time, Gadget, NEXT TIME!\n")
    expect(System.capture_standard_output { p([gadget]) }).to eq("[Next time, Gadget, NEXT TIME!]\n")
  end

  specify "prints nothing if no argument is given" do
    mutable answered = :unset
    captured = System.capture_standard_output { answered = p }
    expect(captured).to eq("")
    expect(answered).to be_nil
  end

  specify "returns the argument if a single argument is given" do
    mutable answered = nil
    captured = System.capture_standard_output { answered = p("rose") }
    expect(captured).to eq("\"rose\"\n")
    expect(answered).to eq("rose")
  end

  specify "returns an Array of the arguments if multiple arguments are given" do
    mutable answered = nil
    captured = System.capture_standard_output { answered = p("rose", :city) }
    expect(captured).to eq("\"rose\"\n:city\n")
    expect(answered).to eq(["rose", :city])
  end
end
