# Randomness (ADR 0065): Ruby's both — the ambient `rand`, `srand`,
# `sample`, and `shuffle`, and the explicit `Random.new(seed)` — with
# Ruby's generator step for step, so every seeded number here is the one
# CRuby draws.
#
# From ruby/spec core/random/{new,rand,seed,equal_value,srand}_spec.rb,
# core/kernel/{rand,srand}_spec.rb, and core/array/{sample,shuffle}_spec.rb. What stays behind: the fairness
# measurement, mocks of `rand` and `to_int`, `random: Random` the class
# (a type is not a value), bignum bounds (#156), the
# Formatter and bytes (#119), and `Random.srand`/`Random.rand` as class
# methods, which are the bare functions here.

require_relative "../../spec_helper"

context "Kernel#rand" do
  specify "returns a float if no argument is passed" do
    expect(rand.to_s.include?(".")).to be_true
  end

  specify "returns an integer for an integer argument" do
    expect((rand(77) in Integer)).to be_true
  end

  specify "returns an integer for a float argument greater than 1" do
    expect(rand(1.3)).to eq(0)
  end

  specify "returns a float for an argument between -1 and 1" do
    expect(rand(0).to_s.include?(".")).to be_true
    expect(rand(0.5).to_s.include?(".")).to be_true
  end

  specify "ignores the sign of the argument" do
    expect([0, 1, 2, 3].include?(rand(-4))).to be_true
  end

  specify "never returns a value greater or equal to 1.0 with no arguments" do
    expect((1..100).map { rand }.all? { |drawn| (0...1.0).include?(drawn) }).to be_true
  end

  specify "never returns a value greater or equal to any passed in max argument" do
    expect((1..100).map { rand(10) }.all? { |drawn| drawn < 10 }).to be_true
  end

  describe "with a range" do
    specify "returns an Integer between the two Integers" do
      drawn = rand(1..5)
      expect(drawn).to be_between(1, 5)
    end
  end

  describe "given an exclusive range" do
    specify "returns an Integer between the two Integers" do
      expect((1..100).map { rand(4...6) }.all? { |drawn| (drawn in Integer) && (4...6).include?(drawn) }).to be_true
    end

    specify "returns a Float between the given Integer and Float" do
      expect((1..100).map { rand(4...6.5) }.all? { |drawn| (drawn in Float) && (4...6.5).include?(drawn) }).to be_true
    end

    specify "returns a Float between the given Float and Integer" do
      expect((1..100).map { rand(3.5...6) }.all? { |drawn| (drawn in Float) && (3.5...6).include?(drawn) }).to be_true
    end

    specify "returns a Float between the two given Floats" do
      expect((1..100).map { rand(3.5...6.5) }.all? { |drawn| (drawn in Float) && (3.5...6.5).include?(drawn) }).to be_true
    end
  end

  describe "given an inclusive range" do
    specify "returns an Integer between the two Integers" do
      expect((1..100).map { rand(4..6) }.all? { |drawn| (drawn in Integer) && (4..6).include?(drawn) }).to be_true
    end

    specify "returns a Float between the given Integer and Float" do
      expect((1..100).map { rand(4..6.5) }.all? { |drawn| (drawn in Float) && (4..6.5).include?(drawn) }).to be_true
    end

    specify "returns a Float between the given Float and Integer" do
      expect((1..100).map { rand(3.5..6) }.all? { |drawn| (drawn in Float) && (3.5..6).include?(drawn) }).to be_true
    end

    specify "returns a Float between the two given Floats" do
      expect((1..100).map { rand(3.5..6.5) }.all? { |drawn| (drawn in Float) && (3.5..6.5).include?(drawn) }).to be_true
    end
  end

  describe "given an inclusive range between 0 and 1" do
    specify "returns an Integer between the two Integers" do
      drawn = rand(0..1)
      expect(drawn in Integer).to be_true
      expect((0..1).include?(drawn)).to be_true
    end

    specify "returns a Float if at least one side is Float" do
      first = Random.new(42).rand(0..1.0)
      second = Random.new(42).rand(0.0..1.0)
      third = Random.new(42).rand(0.0..1)
      expect(third in Float).to be_true
      expect(first.eql?(third)).to be_true
      expect(second.eql?(third)).to be_true
      expect((0.0..1.0).include?(third)).to be_true
    end
  end

  describe "given an exclusive range between 0 and 1" do
    specify "returns zero as an Integer" do
      expect(rand(0...1).eql?(0)).to be_true
    end

    specify "returns a Float if at least one side is Float" do
      first = Random.new(42).rand(0...1.0)
      second = Random.new(42).rand(0.0...1.0)
      third = Random.new(42).rand(0.0...1)
      expect(third in Float).to be_true
      expect(first.eql?(third)).to be_true
      expect(second.eql?(third)).to be_true
      expect((0.0...1.0).include?(third)).to be_true
    end
  end

  specify "returns the range start/end when Float range is 0" do
    expect(rand(1.0..1.0).eql?(1.0)).to be_true
  end

  specify "returns the range start/end when Integer range is 0" do
    expect(rand(42..42).eql?(42)).to be_true
  end
end
