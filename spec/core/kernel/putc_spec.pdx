# Ruby's output wrappers over the two standard streams (ADR 0068, #185):
# `puts`, `p`, `pp`, `print`, `putc`, `printf` on standard output and `warn`
# on standard error. Each spec asserts what the call answers; what it writes
# is pinned by the two-oracle test, since nothing here can capture a stream.
# A line written here passes through the harness harmlessly, so every write
# ends in a newline.
#
# From ruby/spec core/kernel/{p,pp,print,putc,printf,warn,puts}_spec.rb.
# Upstream: the privacy and reflection rows, `$stdout` and `$VERBOSE`
# reassignment, the mocks, `$_`, the IO-first-argument forms of printf, and
# warn's uplevel and category keywords. `puts` answers no value (ADR 0012),
# so its one row is the two-oracle test's.

require_relative "../../spec_helper"

context "Kernel#putc" do
  describe "with an Integer argument" do
    specify "writes one character as a String" do
      expect(putc(10)).to eq(10)
    end

    specify "writes the low byte as a String" do
      expect(putc(0x240a)).to eq(0x240a)
    end
  end

  describe "with a String argument" do
    specify "writes one character" do
      expect(putc("\n")).to eq("\n")
    end

    specify "writes the first character" do
      expect(putc("\nRuby")).to eq("\nRuby")
    end
  end
end
