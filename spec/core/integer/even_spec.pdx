# From ruby/spec core/integer/even_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Integer#even?" do
  specify "partition" do
    expect(4.even?).to be_true
  end

  specify "and zero is even" do
    expect(0.even?).to be_true
  end

  specify "reach below zero the same way" do
    expect((-2).even?).to be_true
    expect((-1).even?).to be_false
  end
end
