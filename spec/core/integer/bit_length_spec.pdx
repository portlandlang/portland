# Ruby's bit math as named methods (ADR 0003, locked by #157): the
# operators are out of the grammar, the capability is here under names —
# `bit_and`, `bit_or`, `bit_xor`, `bit_not`, `shift_left`, `shift_right` —
# beside Ruby's own `allbits?`, `anybits?`, `nobits?`, `bit_length`,
# `bit_count`, and the bit read `n[i]`. Every answer here is Ruby's.
#
# From ruby/spec core/integer/{bit_and,bit_or,bit_xor,complement,
# left_shift,right_shift,allbits,anybits,nobits,bit_length,bit_count,
# element_reference}_spec.rb, the fixnum rows. What stays behind: the
# bignum rows (integers are 64-bit, #156), coerce and to_int (ADR 0036), a
# Float operand (refuses here where Ruby raises TypeError), and the
# two-argument and range forms of `n[i]`.

require_relative "../../spec_helper"

context "Integer#bit_length" do
  specify "returns the position of the leftmost bit of a positive number" do
    expect(0.bit_length).to eq(0)
    expect(1.bit_length).to eq(1)
    expect(2.bit_length).to eq(2)
    expect(3.bit_length).to eq(2)
    expect(4.bit_length).to eq(3)
    expect(0xff.bit_length).to eq(8)
    expect(0x100.bit_length).to eq(9)
    expect((2 ** 12 - 1).bit_length).to eq(12)
    expect((2 ** 12).bit_length).to eq(13)
    expect((2 ** 12 + 1).bit_length).to eq(13)
    expect(9223372036854775807.bit_length).to eq(63)
  end

  specify "returns the position of the leftmost 0 bit of a negative number" do
    expect(-1.bit_length).to eq(0)
    expect(-2.bit_length).to eq(1)
    expect(-3.bit_length).to eq(2)
    expect(-4.bit_length).to eq(2)
    expect(-5.bit_length).to eq(3)
    expect((-(2 ** 12) - 1).bit_length).to eq(13)
    expect((-(2 ** 12)).bit_length).to eq(12)
    expect((-(2 ** 12) + 1).bit_length).to eq(12)
    expect(-0x101.bit_length).to eq(9)
    expect(-0x100.bit_length).to eq(8)
    expect(-0xff.bit_length).to eq(8)
  end
end
