# Arithmetic that follows Ruby rather than the Rust floor it is built on.
#
# From ruby/spec core/integer/divide_spec.rb. What stays upstream, and why,
# is this file's entry in spec/ruby_spec.yml.

# Up two, because `require_relative` resolves against this file's own directory
# (the seed's rule, matched by the compiler) — not against `spec/`.

require_relative "../../spec_helper"

# The named division family (#107), from ruby/spec core/integer: divmod,
# div, remainder, ceildiv, and fdiv, fixnum halves. Upstream's be_close is
# close_to? at mspec's TOLERANCE, its eql? type checks ask inspect, and
# infinite?'s 1 and -1 are asked as a sign. Where Ruby raises
# (ZeroDivisionError, TypeError, ArgumentError) Portland refuses, which
# ends a run, so those examples stay upstream with the bignum and
# coercion ones.

def close_to?(actual, expected) = (actual - expected).abs <= 0.00003

# ADR 0018 — division and modulo are floored, Ruby's rule, not Rust's,
# which truncates toward zero.
context "Integer#/" do
  specify "floors toward negative infinity" do
    expect((0 - 7) / 2).to eq(-4)
  end

  specify "answers self divided by the argument" do
    expect(2 / 2).to eq(1)
    expect(3 / 2).to eq(1)
  end

  specify "floors a small negative all the way down" do
    expect((-1) / 10).to eq(-1)
  end

  specify "preserves sign across the four corners" do
    expect(8 / 2).to eq(4)
    expect(8 / (-2)).to eq(-4)
    expect((-8) / 2).to eq(-4)
    expect((-8) / (-2)).to eq(4)
  end

  specify "promotes division, where the same operands floored as integers" do
    expect(7 / 2.0).to eq(3.5)
    expect(7 / 2).to eq(3)
  end

  specify "supports dividing negative numbers" do
    expect(-1 / 10).to eq(-1)
    expect(-1 / 10 ** 10).to eq(-1)
  end

  specify "preservers sign correctly" do
    expect(4 / 3).to eq(1)
    expect(4 / -3).to eq(-2)
    expect(-4 / 3).to eq(-2)
    expect(-4 / -3).to eq(1)
    expect(0 / -3).to eq(0)
    expect(0 / 3).to eq(0)
  end

  specify "returns result the same class as the argument" do
    expect(3 / 2).to eq(1)
    expect(3 / 2.0).to eq(1.5)
    expect(3 / Rational(2, 1)).to eq(Rational(3, 2))
  end

  specify "does NOT raise ZeroDivisionError if the given argument is zero and is a Float" do
    expect((1 / 0.0).to_s).to eq("Infinity")
    expect((-1 / 0.0).to_s).to eq("-Infinity")
  end

  specify "coerces fixnum and return self divided by other" do
    expect(close_to?(-1 / 50.4, -0.01984126984126984)).to eq(true)
  end
end
