# An integer's rounding family (#107), from ruby/spec core/integer: floor,
# ceil, round, and truncate, through upstream's shared to_i,
# rounding-precision, and floor/ceil-precision groups. Upstream's eql?
# type checks ask inspect's answer. The bignum rows (10**70 and kin, and
# the Bug #20654 precisions past 64 bits) stay upstream, as do round's
# half: option, which waits for builtins to take keyword arguments, and its
# RangeError, TypeError, and to_int examples, where Portland refuses.

require_relative "../../spec_helper"

def same_integer?(actual, expected) = inspect(actual) == inspect(expected)

context "Integer#round" do
  specify "returns self" do
    expect(same_integer?(10.round, 10)).to eq(true)
    expect(same_integer?((-15).round, -15)).to eq(true)
  end

  specify "returns self if not passed a precision, or passed zero or a positive one" do
    [2, -4].each do |number|
      expect(same_integer?(number.round, number)).to eq(true)
      expect(same_integer?(number.round(0), number)).to eq(true)
      expect(same_integer?(number.round(42), number)).to eq(true)
    end
  end

  specify "returns itself rounded if passed a negative value" do
    expect(same_integer?(+249.round(-2), +200)).to eq(true)
    expect(same_integer?(-249.round(-2), -200)).to eq(true)
  end

  specify "returns itself rounded to nearest if passed a negative value" do
    expect(same_integer?(+250.round(-2), +300)).to eq(true)
    expect(same_integer?(-250.round(-2), -300)).to eq(true)
  end
end
