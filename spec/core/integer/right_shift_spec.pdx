# From ruby/spec core/integer/right_shift_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Integer#>> (with n >> m)" do
  specify "returns n shifted right m bits when n > 0, m > 0" do
    expect(2.shift_right(1)).to eq(1)
  end

  specify "returns n shifted right m bits when n < 0, m > 0" do
    expect(-2.shift_right(1)).to eq(-1)
    expect(-7.shift_right(1)).to eq(-4)
    expect(-42.shift_right(2)).to eq(-11)
  end

  specify "returns n shifted left m bits when n > 0, m < 0" do
    expect(1.shift_right(-1)).to eq(2)
  end

  specify "returns n shifted left m bits when n < 0, m < 0" do
    expect(-1.shift_right(-1)).to eq(-2)
  end

  specify "returns 0 when n == 0" do
    expect(0.shift_right(1)).to eq(0)
  end

  specify "returns n when n > 0, m == 0" do
    expect(1.shift_right(0)).to eq(1)
  end

  specify "returns n when n < 0, m == 0" do
    expect(-1.shift_right(0)).to eq(-1)
  end

  specify "returns 0 when n > 0, m > 0 and n < 2**m" do
    expect(3.shift_right(2)).to eq(0)
    expect(7.shift_right(3)).to eq(0)
    expect(127.shift_right(7)).to eq(0)
    expect(7.shift_right(32)).to eq(0)
    expect(7.shift_right(64)).to eq(0)
  end

  specify "returns -1 when n < 0, m > 0 and n > -(2**m)" do
    expect(-3.shift_right(2)).to eq(-1)
    expect(-7.shift_right(3)).to eq(-1)
    expect(-127.shift_right(7)).to eq(-1)
    expect(-7.shift_right(32)).to eq(-1)
    expect(-7.shift_right(64)).to eq(-1)
  end

  specify "returns a Bignum == fixnum_max * 2 when fixnum_max >> -1 and n > 0" do
    fixnum_max = 2**62 - 1
    result = fixnum_max.shift_right(-1)
    expect(result).to be_an_instance_of(Integer)
    expect(result).to eq(fixnum_max * 2)
  end

  specify "returns a Bignum == fixnum_min * 2 when fixnum_min >> -1 and n < 0" do
    fixnum_min = -(2**62)
    result = fixnum_min.shift_right(-1)
    expect(result).to be_an_instance_of(Integer)
    expect(result).to eq(fixnum_min * 2)
  end

  specify "returns a Fixnum == fixnum_max when (fixnum_max * 2) >> 1 and n > 0" do
    fixnum_max = 2**62 - 1
    result = (fixnum_max * 2).shift_right(1)
    expect(result).to be_an_instance_of(Integer)
    expect(result).to eq(fixnum_max)
  end

  specify "returns a Fixnum == fixnum_min when (fixnum_min * 2) >> 1 and n < 0" do
    fixnum_min = -(2**62)
    result = (fixnum_min * 2).shift_right(1)
    expect(result).to be_an_instance_of(Integer)
    expect(result).to eq(fixnum_min)
  end

  describe "when m is a bignum or larger than int" do
    specify "returns -1 when m > 0 and n < 0" do
      expect(-1.shift_right(2**40)).to eq(-1)
    end

    specify "returns 0 when m > 0 and n >= 0" do
      expect(0.shift_right(2**40)).to eq(0)
      expect(1.shift_right(2**40)).to eq(0)
    end

    specify "returns 0 when m < 0 long and n == 0" do
      expect(0.shift_right(-(2**40))).to eq(0)
    end
  end
end
