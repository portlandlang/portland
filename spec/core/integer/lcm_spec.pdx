# `gcd` — Euclid on magnitudes: the answer never carries a sign, and a zero
# yields the other side's magnitude.
#
# From ruby/spec core/integer/gcd_spec.rb.

# Up two, because `require_relative` resolves against this file's own directory
# (the seed's rule, matched by the compiler) — not against `spec/`.

require_relative "../../spec_helper"

# `lcm` and `gcdlcm` (#107), from ruby/spec core/integer/lcm_spec.rb and
# gcdlcm_spec.rb. Upstream's is_a? type checks ask inspect's answer; the
# bignum examples stay upstream, and so do the ArgumentError and TypeError
# ones, where Portland refuses.

context "Integer#lcm" do
  specify "returns self if equal to the argument" do
    expect(1.lcm(1)).to eq(1)
    expect(398.lcm(398)).to eq(398)
  end

  specify "returns an Integer" do
    expect(inspect(36.lcm(6))).to eq("36")
    expect(inspect(4.lcm(20981))).to eq("83924")
  end

  specify "returns the least common multiple of self and argument" do
    expect(200.lcm(2001)).to eq(400200)
    expect(99.lcm(90)).to eq(990)
  end

  specify "returns a positive integer even if self is negative" do
    expect(-12.lcm(6)).to eq(12)
    expect(-100.lcm(100)).to eq(100)
  end

  specify "returns a positive integer even if the argument is negative" do
    expect(12.lcm(-6)).to eq(12)
    expect(100.lcm(-100)).to eq(100)
  end

  specify "returns a positive integer even if both self and argument are negative" do
    expect(-12.lcm(-6)).to eq(12)
    expect(-100.lcm(-100)).to eq(100)
  end
end
