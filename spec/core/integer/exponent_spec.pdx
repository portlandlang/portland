# From ruby/spec core/integer/exponent_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

TOLERANCE = 0.00003

context "Integer#**" do
  specify "is what a negative base to a fractional power answers" do
    expect(inspect((-8) ** 0.5)).to eq("(0.0+2.8284271247461903i)")
  end

  specify "raises to the power" do
    expect(2 ** 8).to eq(256)
  end

  specify "while a parenthesized negative base raises whole" do
    expect((-2) ** 2).to eq(4)
    expect((-2) ** 3).to eq(-8)
  end

  specify "answers one for a zero exponent, zero included" do
    expect(2 ** 0).to eq(1)
    expect(0 ** 0).to eq(1)
  end

  specify "crosses into floats for roots" do
    expect(9 ** 0.5).to eq(3.0)
  end

  specify "returns self raised to the given power" do
    expect(2 ** 0).to eql(1)
    expect(2 ** 1).to eql(2)
    expect(2 ** 2).to eql(4)

    expect(9 ** 0.5).to eql(3.0)
    expect(9 ** Rational(1, 2)).to eql(3.0)
    expect((5 ** -1).to_f.to_s).to eq('0.2')

    expect(2 ** 40).to eql(1099511627776)
  end

  specify "overflows the answer to a bignum transparently" do
    expect(2 ** 29).to eql(536870912)
    expect(2 ** 30).to eql(1073741824)
    expect(2 ** 31).to eql(2147483648)
    expect(2 ** 32).to eql(4294967296)

    expect(2 ** 61).to eql(2305843009213693952)
    expect(2 ** 62).to eql(4611686018427387904)
  end

  specify "raises negative numbers to the given power" do
    expect((-2) ** 29).to eql(-536870912)
    expect((-2) ** 30).to eql(1073741824)
    expect((-2) ** 31).to eql(-2147483648)
    expect((-2) ** 32).to eql(4294967296)
    expect((-2) ** 33).to eql(-8589934592)

    expect((-2) ** 61).to eql(-2305843009213693952)
    expect((-2) ** 62).to eql(4611686018427387904)
  end

  specify "can raise 1 to a bignum safely" do
    expect(1 ** 4611686018427387904).to eql(1)
  end

  specify "can raise -1 to a bignum safely" do
    expect((-1) ** 4611686018427387904).to eql(1)
    expect((-1) ** 4611686018427387905).to eql(-1)
  end

  specify "returns Float::INFINITY for 0 ** -1.0" do
    expect(0 ** -1.0).to eq(Float::INFINITY)
  end

  specify "returns Float when power is Float" do
    expect(2 ** 2.0).to eq(4.0)
  end

  specify "returns a complex number when negative and raised to a fractional power" do
    expect((-8) ** (1.0 / 3)).to be_close(Complex(1, 1.73205), TOLERANCE)
    expect((-8) ** Rational(1, 3)).to be_close(Complex(1, 1.73205), TOLERANCE)
  end
end
