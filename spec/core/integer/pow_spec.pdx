# From ruby/spec core/integer/pow_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

def close_to?(actual, expected) = (actual - expected).abs <= 0.00003

context "Integer#pow" do
  specify "raises to the power" do
    expect(2.pow(8)).to eq(256)
  end

  # From core/integer/shared/exponent.rb, the Rational exponents. Its
  # eql? asks inspect here, and be_close is close_to? at mspec's TOLERANCE.
  # "returns Rational when power is Rational" waits on #290.
  specify "returns self raised to a Rational power" do
    expect(inspect(9.pow(Rational(1, 2)))).to eq("3.0")
  end

  specify "returns a complex number when negative and raised to a fractional Rational power" do
    expect(close_to?((-8).pow(Rational(1, 3)), Complex(1, 1.73205))).to eq(true)
  end
end
