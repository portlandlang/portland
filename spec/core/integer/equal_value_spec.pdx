# What an integer is to itself (#107), from ruby/spec core/integer: to_i,
# zero?, ==, and the aliases next, magnitude, inspect, and ===. Alias
# checks compare the two answers rather than method objects, which a closed
# runtime has none of; upstream's type check through eql? is asked of
# inspect's answer. The bignum rows, the mocks whose own == takes over, and
# zero?'s method-owner check stay upstream.

require_relative "../../spec_helper"

context "Integer#==" do
  specify "returns true if self has the same value as other" do
    expect(1 == 1).to eq(true)
    expect(9 == 5).to eq(false)
    expect(9 == 9.0).to eq(true)
    expect(9 == 9.01).to eq(false)
  end

  specify "calls 'other == self' if the given argument is not an Integer" do
    expect(1 == "*").to eq(false)
  end
end
