# From ruby/spec core/integer/uminus_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Integer#-@" do
  specify "negates a value, both directions" do
    bound = 5
    expect(-bound).to eq(-5)
    expect(-(-bound)).to eq(5)
  end

  specify "and zero is its own negation" do
    zero = 0
    expect(-zero).to eq(0)
  end
end
