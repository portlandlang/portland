# `+`, `-`, and `*` on integers stay integers; mixing with a float promotes,
# and the promotion rules have their own home in spec/number/promotion_spec.
#
# Grown from ruby/spec core/integer/{plus,minus,multiply,uminus,pow,
# exponent}_spec.rb (#23); the coercion protocol stays behind — there is no
# `coerce`, and a wrong operand type panics rather than negotiating.

# Up two, because `require_relative` resolves against this file's own directory
# (the seed's rule, matched by the compiler) — not against `spec/`.

require_relative "../../spec_helper"

context "Integer#*" do
  specify "multiplies" do
    expect(4923 * 2).to eq(9846)
    expect(1342177 * 800).to eq(1073741600)
  end

  specify "reaches past 32 bits without ceremony" do
    expect(65536 * 65536).to eq(4294967296)
  end
end
