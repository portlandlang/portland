# Ruby's bit math as named methods (ADR 0003, locked by #157): the
# operators are out of the grammar, the capability is here under names —
# `bit_and`, `bit_or`, `bit_xor`, `bit_not`, `shift_left`, `shift_right` —
# beside Ruby's own `allbits?`, `anybits?`, `nobits?`, `bit_length`,
# `bit_count`, and the bit read `n[i]`. Every answer here is Ruby's.
#
# From ruby/spec core/integer/{bit_and,bit_or,bit_xor,complement,
# left_shift,right_shift,allbits,anybits,nobits,bit_length,bit_count,
# element_reference}_spec.rb, the fixnum rows. What stays behind: the
# bignum rows (integers are 64-bit, #156), coerce and to_int (ADR 0036), a
# Float operand (refuses here where Ruby raises TypeError), and the
# two-argument and range forms of `n[i]`.

require_relative "../../spec_helper"

context "Integer#[]" do
  specify "behaves like (n >> b) & 1" do
    expect(0b101[1]).to eq(0)
    expect(0b101[2]).to eq(1)
  end

  specify "returns 1 if the nth bit is set" do
    expect(15[1]).to eq(1)
  end

  specify "returns 1 if the nth bit is set (in two's-complement representation)" do
    expect(-1[1]).to eq(1)
  end

  specify "returns 0 if the nth bit is not set" do
    expect(8[2]).to eq(0)
  end

  specify "returns 0 if the nth bit is not set (in two's-complement representation)" do
    expect(-2[0]).to eq(0)
  end

  specify "returns 0 if the nth bit is greater than the most significant bit" do
    expect(2[3]).to eq(0)
  end

  specify "returns 1 if self is negative and the nth bit is greater than the most significant bit" do
    expect(-1[3]).to eq(1)
  end

  specify "returns 0 when passed a negative argument" do
    expect(3[-1]).to eq(0)
    expect(-1[-1]).to eq(0)
  end
end
