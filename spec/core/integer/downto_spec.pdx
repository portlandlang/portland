# An integer's walks (#107), from ruby/spec core/integer: times, upto, and
# downto. Values never mutate (ADR 0015), so upstream's `result << x` is
# the accumulator pattern, `result = result + [x]` on a mutable, and its
# `a.shift` is `first` and then the rest by `slice`. Without a block each answers the finished walk,
# an array, where Ruby answers an Enumerator (ADR 0055), so `size` and
# `each` ask the array. A non-number endpoint refuses where Ruby raises
# ArgumentError, and `break` with a value waits on ADR 0012's real demand;
# both stay upstream.

require_relative "../../spec_helper"

context "Integer#downto [stop] when self and stop are Integers" do
  specify "does not yield when stop is greater than self" do
    mutable seen = []
    5.downto(6) { |number| seen = seen + [number] }
    expect(seen).to eq([])
  end

  specify "yields once when stop equals self" do
    mutable seen = []
    5.downto(5) { |number| seen = seen + [number] }
    expect(seen).to eq([5])
  end

  specify "yields while decreasing self until it is less than stop" do
    mutable seen = []
    5.downto(2) { |number| seen = seen + [number] }
    expect(seen).to eq([5, 4, 3, 2])
  end

  specify "yields while decreasing self until it less than ceil for a Float endpoint" do
    mutable seen = []
    9.downto(1.3) { |number| seen = seen + [number] }
    3.downto(-1.3) { |number| seen = seen + [number] }
    expect(seen).to eq([9, 8, 7, 6, 5, 4, 3, 2, 3, 2, 1, 0, -1])
  end

  describe "when no block is given" do
    specify "returns an Enumerator" do
      mutable seen = []
      walk = 5.downto(2)
      walk.each { |number| seen = seen + [number] }
      expect(seen).to eq([5, 4, 3, 2])
    end

    specify "returns self - stop + 1 as its size" do
      expect(10.downto(5).size).to eq(6)
      expect(10.downto(1).size).to eq(10)
      expect(10.downto(0).size).to eq(11)
      expect(0.downto(0).size).to eq(1)
      expect(-3.downto(-5).size).to eq(3)
    end

    specify "returns 0 as its size when stop > self" do
      expect(4.downto(5).size).to eq(0)
      expect(-5.downto(0).size).to eq(0)
      expect(-5.downto(-3).size).to eq(0)
    end
  end

  specify "downto counts down" do
    mutable counted = []
    3.downto(1) do |number|
      counted << number
    end
    expect(counted).to eq([3, 2, 1])
  end
end
