# From ruby/spec core/math/erfc_spec.rb.
#
# `Math` (ADR 0083): Ruby's module functions as builtins, spelled as Ruby
# spells them, answering what Ruby 4.0.9 answers; a domain error is a
# failure in Ruby's own sentence. From ruby/spec core/math, the whole
# directory: the `Float()` coercion rows and the private-instance-method
# rows (`include Math`) stay upstream, since a namespace is not a mixin and
# a non-number refuses at the call; the `is_a?(Float)` rows ask `in Float`.

require_relative "../../spec_helper"

MATH_TOLERANCE = 0.00003
def nan_value = 0.0 / 0.0

context "Math.erfc" do
  specify "erfc returns the complementary error function of the argument" do
    expect(Math.erfc(0)).to be_close(1.0, MATH_TOLERANCE)
    expect(Math.erfc(1)).to be_close(0.157299207050285, MATH_TOLERANCE)
    expect(Math.erfc(-1)).to be_close(1.84270079294971, MATH_TOLERANCE)
    expect(Math.erfc(0.5)).to be_close(0.479500122186953, MATH_TOLERANCE)
    expect(Math.erfc(-0.5)).to be_close(1.52049987781305, MATH_TOLERANCE)
    expect(Math.erfc(10000)).to be_close(0.0, MATH_TOLERANCE)
    expect(Math.erfc(-10000)).to be_close(2.0, MATH_TOLERANCE)
    expect(Math.erfc(0.00000000000001)).to be_close(0.999999999999989, MATH_TOLERANCE)
    expect(Math.erfc(nan_value).nan?).to eq(true)
  end
end
