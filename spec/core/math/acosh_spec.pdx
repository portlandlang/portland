# `Math` (ADR 0083): Ruby's module functions as builtins, spelled as Ruby
# spells them, answering what Ruby 4.0.9 answers; a domain error is a
# failure in Ruby's own sentence. From ruby/spec core/math, the whole
# directory: the `Float()` coercion rows and the private-instance-method
# rows (`include Math`) stay upstream, since a namespace is not a mixin and
# a non-number refuses at the call; the `is_a?(Float)` rows ask `in Float`.

require_relative "../../spec_helper"

MATH_TOLERANCE = 0.00003
def nan_value = 0.0 / 0.0

context "Math.acosh" do
  specify "acosh" do
    expect(Math.acosh(14.2)).to be_close(3.345146999647, MATH_TOLERANCE)
    expect(Math.acosh(1.0)).to be_close(0.0, MATH_TOLERANCE)
    expect(inspect(Math.acosh(1.0 - MATH_TOLERANCE))).to eq('failure("Numerical argument is out of domain - acosh")')
    expect(inspect(Math.acosh(0))).to eq('failure("Numerical argument is out of domain - acosh")')
    expect(inspect(Math.acosh(-1.0))).to eq('failure("Numerical argument is out of domain - acosh")')
    expect(Math.acosh(nan_value).nan?).to eq(true)
  end
end
