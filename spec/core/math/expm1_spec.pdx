# `Math` (ADR 0083): Ruby's module functions as builtins, spelled as Ruby
# spells them, answering what Ruby 4.0.9 answers; a domain error is a
# failure in Ruby's own sentence. From ruby/spec core/math, the whole
# directory: the `Float()` coercion rows and the private-instance-method
# rows (`include Math`) stay upstream, since a namespace is not a mixin and
# a non-number refuses at the call; the `is_a?(Float)` rows ask `in Float`.

require_relative "../../spec_helper"

MATH_TOLERANCE = 0.00003
def nan_value = 0.0 / 0.0

context "Math.expm1" do
  specify "expm1 calculates Math.exp(arg) - 1, keeping the precision" do
    expect(Math.expm1(3)).to eq(Math.exp(3) - 1)
    expect(Math.expm1(1.0e-16)).to be_close(1.0e-16, MATH_TOLERANCE)
    expect(Math.expm1(1.0e-16) != 0.0).to eq(true)
    expect(Math.expm1(nan_value).nan?).to eq(true)
  end
end
