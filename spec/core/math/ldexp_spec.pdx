# From ruby/spec core/math/ldexp_spec.rb.
#
# `Math` (ADR 0083): Ruby's module functions as builtins, spelled as Ruby
# spells them, answering what Ruby 4.0.9 answers; a domain error is a
# failure in Ruby's own sentence. From ruby/spec core/math, the whole
# directory: the `Float()` coercion rows and the private-instance-method
# rows (`include Math`) stay upstream, since a namespace is not a mixin and
# a non-number refuses at the call; the `is_a?(Float)` rows ask `in Float`.

require_relative "../../spec_helper"

MATH_TOLERANCE = 0.00003
def nan_value = 0.0 / 0.0

context "Math.ldexp" do
  specify "ldexp returns the argument multiplied by 2**n" do
    expect(Math.ldexp(0.0, 0.0)).to eq(0.0)
    expect(Math.ldexp(0.0, 1.0)).to eq(0.0)
    expect(Math.ldexp(-1.25, 2)).to be_close(-5.0, MATH_TOLERANCE)
    expect(Math.ldexp(2.1, -3)).to be_close(0.2625, MATH_TOLERANCE)
    expect(Math.ldexp(5.7, 4)).to be_close(91.2, MATH_TOLERANCE)
    expect(Math.ldexp(nan_value, 0)).to be_nan
    expect(Math.ldexp(0.5122058490966879, 1024)).to eq(9.207889385574391e+307)
    expect(Math.ldexp(0.9999999999999999, 1024)).to eq(1.7976931348623157e+308)
  end
end
