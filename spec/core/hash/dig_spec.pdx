# From ruby/spec core/hash/dig_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Hash#dig" do
  specify "Hash#dig is a maybe at every step" do
    nested = {outer: {inner: 7}}
    expect(nested.dig(:outer, :inner)).to eq(7)
    expect(nested.dig(:outer, :nope)).to be_nil
  end

  specify "Hash#dig short-circuits at the first miss" do
    nested = {outer: {inner: 7}}
    expect(nested.dig(:nope, :inner)).to be_nil
  end

  specify "returns #[] with one arg" do
    h = { 0 => false, a: 1 }
    expect(h.dig(:a)).to eq(1)
    expect(h.dig(0)).to be_false
    expect(h.dig(1)).to be_nil
  end

  specify "returns the nested value specified by the sequence of keys" do
    h = { foo: { bar: { baz: 1 } } }
    expect(h.dig(:foo, :bar, :baz)).to eq(1)
    expect(h.dig(:foo, :bar, :nope)).to be_nil
    expect(h.dig(:foo, :baz)).to be_nil
    expect(h.dig(:bar, :baz, :foo)).to be_nil
  end

  specify "returns the nested value specified if the sequence includes an index" do
    h = { foo: [1, 2, 3] }
    expect(h.dig(:foo, 2)).to eq(3)
  end

  specify "returns nil if any intermediate step is nil" do
    h = { foo: { bar: { baz: 1 } } }
    expect(h.dig(:foo, :zot, :xyz)).to be_nil
  end
end
