# Rewriting and reading a hash (#105), from ruby/spec core/hash:
# transform_values, transform_keys, to_h with a block, [], and inspect.
# Upstream's `&:succ` is a block here, and its ScratchPad a mutable. Staying
# upstream: the bang forms (values never mutate), identity and instance_of?
# checks, defaults, default_proc, compare_by_identity, subclasses, frozen
# hashes, a hash argument to transform_keys and `|*args|` (no splats, ADR
# 0014), mocks, recursive hashes, a nil key, blockless Enumerators (ADR
# 0055), and the refusals where Ruby raises.

require_relative "../../spec_helper"

context "Hash#to_h" do
  describe "with block" do
    specify "converts [key, value] pairs returned by the block to a hash" do
      expect({a: 1, b: 2}.to_h { |key, value| [key.to_s, value * value] }).to eq({"a" => 1, "b" => 4})
    end

    specify "passes to a block each pair's key and value as separate arguments" do
      mutable seen = []
      {a: 1, b: 2}.to_h do |key, value|
        seen = seen + [[key, value]]
        [key, value]
      end
      expect(seen.sort).to eq([[:a, 1], [:b, 2]])
    end
  end
end
