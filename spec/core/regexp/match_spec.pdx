# A match is a value (ADR 0086): `=~` and `match` both answer the
# MatchData or nil, `match?` and `!~` booleans, on a string, a symbol, or
# the pattern itself, from a position when one is given.
#
# From ruby/spec core/regexp/{match,match?}_spec.rb and shared/match.rb,
# and core/string/{match,match?,=~}_spec.rb's regex rows. Upstream: `=~`
# answering an index (it answers the match here, since the match globals
# are gone), `$~` being set or reset, `Regexp.last_match`, mocks,
# `Regexp.allocate`, and the encoding rows. The block form of `match`
# answers the block's result, a maybe (#215).

require_relative "../../spec_helper"

context "Regexp#=~" do
  specify "answers the MatchData when there is a match" do
    found = /(.)(.)(.)/ =~ "abc" or panic("no match")
    expect(found.to_a).to eq(["abc", "a", "b", "c"])
    expect(found.begin(0)).to eq(0)
  end

  specify "returns nil if there is no match" do
    expect(/xyz/ =~ "abxyc").to be_nil
  end

  specify "returns nil if the object is nil" do
    expect(/\w+/ =~ nil).to be_nil
  end

  specify "answers the match when the argument is a Symbol" do
    found = /(.)(.)(.)/ =~ :abc or panic("no match")
    expect(found[0]).to eq("abc")
  end
end
context "Regexp#match" do
  specify "returns a MatchData object" do
    found = /(.)(.)(.)/.match("abc") or panic("no match")
    expect(found).to be_an_instance_of(MatchData)
    expect(found.captures).to eq(["a", "b", "c"])
  end

  specify "returns a MatchData object when the argument is a Symbol" do
    found = /(.)(.)(.)/.match(:abc) or panic("no match")
    expect(found[0]).to eq("abc")
  end

  specify "returns nil if there is no match" do
    expect(/xyz/.match("abxyc")).to be_nil
  end

  specify "returns nil if the object is nil" do
    expect(/\w+/.match(nil)).to be_nil
  end

  specify "matches the input at a given position" do
    found = /(.).(.)/.match("01234", 1) or panic("no match")
    expect(found.captures).to eq(["1", "3"])
  end

  specify "uses the start as a character offset" do
    found = /(.).(.)/.match("零一二三四", 1) or panic("no match")
    expect(found.captures).to eq(["一", "三"])
  end

  specify "counts a negative position from the end" do
    found = /(.).(.)/.match("01234", -4) or panic("no match")
    expect(found.captures).to eq(["1", "3"])
    far = /(.).(.)/.match("零一二三四", -4) or panic("no match")
    expect(far.captures).to eq(["一", "三"])
  end

  specify "answers nil past the end" do
    expect(/./.match("abc", 3)).to be_nil
    expect(/./.match("abc", 9)).to be_nil
  end

  describe "when passed a block" do
    specify "yields the MatchData" do
      mutable recorded = nil
      /./.match("abc") { |found| recorded = found }
      expect(recorded).to be_a(MatchData)
    end

    specify "returns the block result" do
      expect(/./.match("abc") { :result }).to eq(:result)
    end

    specify "does not yield if there is no match" do
      mutable recorded = []
      /a/.match("b") { |found| recorded = recorded + [found] }
      expect(recorded).to eq([])
    end

    # The block's answer is a maybe (#215): nil when nothing matched.
    specify "answers nil when there is no match" do
      expect(/x/.match("a") { :never }).to be_nil
    end
  end
end
context "Regexp#match?" do
  specify "returns true when it matches the given value" do
    expect(/string/i.match?("string")).to be_true
    expect(/string/i.match?(:STRING)).to be_true
  end

  specify "returns false when it does not match the given value" do
    expect(/STRING/.match?("string")).to be_false
    expect(/x/.match?(nil)).to be_false
  end

  specify "matches from a position" do
    expect(/a/.match?("ba", 1)).to be_true
    expect(/b/.match?("ba", 1)).to be_false
  end
end
