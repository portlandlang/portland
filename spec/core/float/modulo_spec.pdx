# A float's named division and its power (#108), from ruby/spec core/float:
# divmod, % and modulo, fdiv, quo, and **. Upstream's be_close is close_to? here, at mspec's
# own TOLERANCE. Where Ruby raises — ZeroDivisionError, FloatDomainError,
# TypeError — Portland refuses, and a refusal ends a run rather than
# answering an example, so those examples stay upstream; so do the ones
# that need a bignum, a Rational, a Complex, or a coercing mock. `infinite?`
# answers true or false here, so upstream's 1 and -1 are asked as a sign.
# Alias checks compare the two answers rather than method objects.

require_relative "../../spec_helper"

def close_to?(actual, expected) = (actual - expected).abs <= 0.00003

context "Float#%" do
  specify "returns self modulo other" do
    expect(close_to?(6543.21 % 137, 104.21)).to eq(true)
    expect(close_to?(6543.21 % 137.24, 92.9299999999996)).to eq(true)
    expect(-1.0 % 1).to eq(0)
  end

  specify "returns self when modulus is +Infinity" do
    expect(4.2 % Float::INFINITY).to eq(4.2)
  end

  specify "returns -Infinity when modulus is -Infinity" do
    expect(4.2 % -Float::INFINITY).to eq(-Float::INFINITY)
  end

  specify "returns NaN when called on NaN or Infinities" do
    expect((Float::NAN % 42)).to be_nan
    expect((Float::INFINITY % 42)).to be_nan
    expect((-Float::INFINITY % 42)).to be_nan
  end

  specify "returns NaN when modulus is NaN" do
    expect((4.2 % Float::NAN)).to be_nan
  end

  specify "returns -0.0 when called on -0.0 with a non zero modulus" do
    remainder = -0.0 % 42
    expect(remainder).to eq(0)
    expect(1 / remainder).to be_less_than(0)

    infinite_remainder = -0.0 % Float::INFINITY
    expect(infinite_remainder).to eq(0)
    expect(1 / infinite_remainder).to be_less_than(0)
  end

  specify "takes the sign of the divisor" do
    expect((0 - 7.0) % 2).to eq(1.0)
  end
end

context "Float#modulo" do
  specify "is an alias of Float#%" do
    expect(6543.21.modulo(137.24)).to eq(6543.21 % 137.24)
    expect(-0.0.modulo(42)).to eq(-0.0 % 42)
  end
end
