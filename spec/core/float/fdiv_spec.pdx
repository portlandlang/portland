# A float's named division and its power (#108), from ruby/spec core/float:
# divmod, % and modulo, fdiv, quo, and **. Upstream's be_close is close_to? here, at mspec's
# own TOLERANCE. Where Ruby raises — ZeroDivisionError, FloatDomainError,
# TypeError — Portland refuses, and a refusal ends a run rather than
# answering an example, so those examples stay upstream; so do the ones
# that need a bignum, a Rational, a Complex, or a coercing mock. `infinite?`
# answers true or false here, so upstream's 1 and -1 are asked as a sign.
# Alias checks compare the two answers rather than method objects.

require_relative "../../spec_helper"

def close_to?(actual, expected) = (actual - expected).abs <= 0.00003

context "Float#fdiv" do
  specify "performs floating-point division between self and an Integer" do
    expect(8.9.fdiv(7)).to eq(1.2714285714285716)
  end

  specify "performs floating-point division between self and a Float" do
    expect(2827.22.fdiv(872.111111)).to eq(3.2418116961704433)
  end

  specify "returns NaN when the argument is NaN" do
    expect(-1819.999999.fdiv(Float::NAN).nan?).to eq(true)
    expect(11109.1981271.fdiv(Float::NAN).nan?).to eq(true)
  end

  specify "returns Infinity when the argument is 0.0" do
    expect(2827.22.fdiv(0.0).infinite?).to eq(true)
    expect(2827.22.fdiv(0.0) > 0.0).to eq(true)
  end

  specify "returns -Infinity when the argument is 0.0 and self is negative" do
    expect(-48229.282.fdiv(0.0).infinite?).to eq(true)
    expect(-48229.282.fdiv(0.0) < 0.0).to eq(true)
  end

  specify "returns Infinity when the argument is 0" do
    expect(2827.22.fdiv(0).infinite?).to eq(true)
    expect(2827.22.fdiv(0) > 0.0).to eq(true)
  end

  specify "returns -Infinity when the argument is 0 and self is negative" do
    expect(-48229.282.fdiv(0).infinite?).to eq(true)
    expect(-48229.282.fdiv(0) < 0.0).to eq(true)
  end

  specify "returns 0.0 when the argument is Infinity" do
    expect(47292.2821.fdiv(Float::INFINITY)).to eq(0.0)
  end

  specify "returns -0.0 when the argument is -Infinity" do
    expect(1.9999918.fdiv(-Float::INFINITY)).to eq(-0.0)
  end
end
