# A float's named division and its power (#108), from ruby/spec core/float:
# divmod, % and modulo, fdiv, quo, and **. Upstream's be_close is close_to? here, at mspec's
# own TOLERANCE. Where Ruby raises — ZeroDivisionError, FloatDomainError,
# TypeError — Portland refuses, and a refusal ends a run rather than
# answering an example, so those examples stay upstream; so do the ones
# that need a bignum, a Rational, a Complex, or a coercing mock. `infinite?`
# answers true or false here, so upstream's 1 and -1 are asked as a sign.
# Alias checks compare the two answers rather than method objects.

require_relative "../../spec_helper"

def close_to?(actual, expected) = (actual - expected).abs <= 0.00003

context "Float#**" do
  specify "returns self raise to the other power" do
    expect(close_to?(2.3 ** 3, 12.167)).to eq(true)
    expect(close_to?(5.2 ** -1, 0.192307692307692)).to eq(true)
    expect(close_to?(9.5 ** 0.5, 3.08220700148449)).to eq(true)
    expect((9.5 ** 0xffffffff).to_s).to eq("Infinity")
  end
end
