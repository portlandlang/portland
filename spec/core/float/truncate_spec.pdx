# From ruby/spec core/float/truncate_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Float#truncate" do
  specify "Float#truncate goes toward zero" do
    expect(1.9.truncate).to eq(1)
    expect((-1.9).truncate).to eq(-1)
  end

  specify "returns self truncated to an Integer" do
    expect(899.2.truncate).to eql(899)
    expect(-1.122256e-45.truncate).to eql(0)
    expect(5_213_451.9201.truncate).to eql(5213451)
    expect(1.233450999123389e+12.truncate).to eql(1233450999123)
  end
end
