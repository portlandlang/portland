# From ruby/spec core/float/uminus_spec.rb.
#
# A float's sign and its conversions (#108), from ruby/spec core/float:
# abs and magnitude (through upstream's shared float_abs), positive?,
# negative?, unary minus and plus, to_f, to_i (through float_to_i), inspect, ==, and
# ===. NaN is 0.0 / 0.0 and infinity 1.0 / 0.0; a positive zero is one that
# 1.0 divides into positive infinity. `infinite?` answers true or false
# here, so upstream's 1 and -1 are asked as a sign. Alias checks compare the
# two answers rather than method objects.

require_relative "../../spec_helper"

def positive_zero?(value) = value == 0.0 && (1.0 / value) > 0.0

context "Float#-@" do
  specify "negates self" do
    positive = 2.221
    expect(-positive).to eq(-2.221)
    expect(-2_455_999_221.5512).to eq(0.0 - 2455999221.5512)
    negative = -5.5
    expect(-negative).to eq(5.5)
  end

  specify "negates self at Float boundaries" do
    expect(-Float::MAX).to eq(0.0 - Float::MAX)
    expect(-Float::MIN).to eq(0.0 - Float::MIN)
  end

  specify "returns negative infinity for positive infinity" do
    infinity = 1.0 / 0.0
    expect((-infinity).infinite?).to eq(true)
    expect(-infinity).to be_less_than(0.0)
  end

  specify "returns positive infinity for negative infinity" do
    negative_infinity = -(1.0 / 0.0)
    expect((-negative_infinity).infinite?).to eq(true)
    expect(-negative_infinity).to be_greater_than(0.0)
  end

  specify "returns NaN for NaN" do
    nan = 0.0 / 0.0
    expect((-nan)).to be_nan
  end
end
