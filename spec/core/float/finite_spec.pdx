# From ruby/spec core/float/finite_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Float#finite?" do
  specify "Float#finite? and #infinite? split the line's ends off" do
    expect(1.0.finite?).to be_true
    expect((1.0 / 0.0).finite?).to be_false
  end

  specify "returns false for negative infinity" do
    expect((-Float::INFINITY).finite?).to be_false
  end

  specify "returns false for NaN" do
    expect(Float::NAN.finite?).to be_false
  end
end
