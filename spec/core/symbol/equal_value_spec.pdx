# A symbol's text (#112), from ruby/spec core/symbol: length, size, empty?,
# start_with?, end_with?, name, id2name, to_s, encoding, ==, and ===. A
# symbol answers questions about its name here, as in Ruby; making one from
# text is from_text_spec's (ADR 0071). Upstream's alias checks compare
# method objects, which a closed runtime has none of; they ask the same
# question of the two answers instead. A symbol's text is UTF-8 like every
# string's (ADR 0069), so the US-ASCII answers upstream expects of an ASCII
# name are UTF-8 here, and a non-ASCII name does not lex (#139).

require_relative "../../spec_helper"

context "Symbol#==" do
  specify "only returns true when the other is exactly the same symbol" do
    expect(:ruby == :ruby).to eq(true)
    expect(:ruby == :"ruby").to eq(true)
    expect(:foo == :bar).to eq(false)
  end

  specify "is the plain symbol" do
    expect(:less).to eq(:less)
  end

  specify "and differs from its siblings, as symbols do" do
    expect(:less).not_to eq(:greater)
  end

  specify "holds against itself" do
    expect(:paid).to eq(:paid)
  end

  specify "breaks against the string of its name" do
    expect(:paid).not_to eq("paid")
  end

  specify "breaks against any other symbol" do
    expect(:paid).not_to eq(:pending)
  end
end
