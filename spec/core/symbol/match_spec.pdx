# From ruby/spec core/symbol/match_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Symbol#=~" do
  specify "answers the string questions by its name" do
    expect(:cat.match?(/t$/)).to be_true
  end

  specify "returns nil if there is no match" do
    expect(:a =~ /b/).to be_nil
  end
end

context "Symbol#match" do
  specify "returns the MatchData" do
    result = :abc.match(/b/)
    expect(result).to be_a(MatchData)
    expect(result[0]).to eq("b")
  end

  specify "returns nil if there is no match" do
    expect(:a.match(/b/)).to be_nil
  end

  # The `$1` half goes with the match globals.
  specify "sets the last match pseudo-variables" do
    expect(:a.match(/(.)/)[0]).to eq("a")
  end
end

context "Symbol#match?" do
  context "when matches the given regex" do
    # The Regexp.last_match half goes with the match globals.
    specify "returns true but does not set Regexp.last_match" do
      expect(:string.match?(/string/i)).to eq(true)
    end
  end

  specify "returns false when does not match the given regex" do
    expect(:string.match?(/STRING/)).to eq(false)
  end
end
