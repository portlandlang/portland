# From ruby/spec core/symbol/match_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Symbol#=~" do
  specify "answers the string questions by its name" do
    expect(:cat.match?(/t$/)).to be_true
  end
end

context "Symbol#match" do
  describe "when passed a block" do
    specify "returns the block result" do
      expect(:abc.match(/./) { :result }).to eq(:result)
    end
  end
end

context "Symbol#match?" do
  specify "takes matching position as the 2nd argument" do
    expect(:string.match?(/str/i, 0)).to be_true
    expect(:string.match?(/str/i, 1)).to be_false
  end
end
