# A symbol's case changers and successor (ADR 0071): `upcase`, `downcase`,
# `capitalize`, `swapcase`, `succ`, and its twin `next` answer a symbol of
# the changed name, as Ruby's do — the string's answer, made a symbol
# again. From ruby/spec core/symbol/{upcase,downcase,capitalize,swapcase,
# succ,next}_spec.rb. Upstream's `instance_of?(Symbol)` rows ask `in
# Symbol`; its alias check compares method objects, which a closed runtime
# has none of, so it asks the two answers instead.

require_relative "../../spec_helper"

context "Symbol#capitalize" do
  specify "returns a Symbol" do
    expect(:glark.capitalize in Symbol).to eq(true)
  end

  specify "converts the first character to uppercase if it is ASCII" do
    expect(:lower.capitalize).to eq(:Lower)
  end

  specify "leaves the first character alone if it is not an alphabetical character" do
    expect(:"£1.20".capitalize).to eq(:"£1.20")
  end

  specify "capitalizes the first character if it is Unicode" do
    expect(:"äöü".capitalize).to eq(:"Äöü")
    expect(:aou.capitalize).to eq(:Aou)
  end

  specify "converts subsequent uppercase ASCII characters to their lowercase equivalents" do
    expect(:lOWER.capitalize).to eq(:Lower)
  end

  specify "leaves ASCII characters already in the correct case as they were" do
    expect(:Title.capitalize).to eq(:Title)
  end

  specify "works with both upper- and lowercase ASCII characters in the same Symbol" do
    expect(:mIxEd.capitalize).to eq(:Mixed)
  end

  specify "leaves lowercase Unicode characters (except in first position) as they were" do
    expect("aßC".to_sym.capitalize).to eq(:"Aßc")
  end

  specify "leaves non-alphabetic ASCII characters as they were" do
    expect("Glark?!?".to_sym.capitalize).to eq(:"Glark?!?")
  end
end
