# From ruby/spec core/data/equal_value_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

module DataSpecs
  Measure = Data.define(:amount, :unit)
  Single = Data.define(:value)
  Empty = Data.define()
end
Movie = Data.define(:title, :year) do
  def title_with_year = "#{title} (#{year})"

  def self.classic = Movie.new(title: "Metropolis", year: 1927)
end

context "Data#==" do
  specify "answer true for the same fields" do
    a = DataSpecs::Measure.new(amount: 42, unit: "km")
    b = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(a == b).to eq(true)
  end

  specify "answer false for different fields, and for a different type" do
    a = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(a == DataSpecs::Measure.new(amount: 42, unit: "mi")).to eq(false)
    expect(a == Movie.new(title: "42", year: 1)).to eq(false)
  end

  specify "returns true if the other is the same object" do
    measure = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(measure == measure).to be_true
  end

  specify "returns true if the other has all the same fields" do
    measure = DataSpecs::Measure.new(amount: 42, unit: "km")
    twin = DataSpecs::Measure.new(amount: 42, unit: "km")
    expect(measure == twin).to be_true
  end

  specify "returns false if the other is a different object or has different fields" do
    measure = DataSpecs::Measure.new(amount: 42, unit: "km")
    other = DataSpecs::Measure.new(amount: 42, unit: "mi")
    expect(measure == other).to be_false
  end
end
