# From ruby/spec core/range/step_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Range#step" do
  specify "Range#step walks in strides" do
    expect((1..9).step(3).to_a).to eq([1, 4, 7])
  end

  specify "steps by one when given no stride" do
    expect((-2..2).step.to_a).to eq([-2, -1, 0, 1, 2])
  end

  specify "walks downward by a negative stride" do
    expect((1..-1).step(-1).to_a).to eq([1, 0, -1])
    expect((5..1).step(-2).to_a).to eq([5, 3, 1])
    expect((1..5).step(-1).to_a).to eq([])
  end

  specify "walks a float range, and by a float stride" do
    expect((-1.0..1.0).step(0.5).to_a).to eq([-1.0, -0.5, 0.0, 0.5, 1.0])
    expect((-2..2).step(1.5).to_a).to eq([-2.0, -0.5, 1.0])
    expect((1...2.0).step(0.5).to_a).to eq([1.0, 1.5])
    expect((1..10).step(2.0).to_a).to eq([1.0, 3.0, 5.0, 7.0, 9.0])
  end

  specify "keeps the last value of an inexact stride" do
    expect((0.1..0.5).step(0.1).to_a.length).to eq(5)
    expect((1.0..2.0).step(0.1).to_a.last).to eq(2.0)
  end

  specify "hands each value to a block and answers the range" do
    mutable seen = []
    answer = (-5..5).step(2) { |value| seen << value }
    expect(seen).to eq([-5, -3, -1, 1, 3, 5])
    expect(answer).to eq(-5..5)
  end

  describe "when no block is given" do
    describe "returned Enumerator" do
      describe "size" do
        specify "returns the ceil of range size divided by the number of steps" do
          expect((1..10).step(4).size).to eq(3)
          expect((1..10).step(3).size).to eq(4)
          expect((1..10).step(2).size).to eq(5)
          expect((1..10).step(1).size).to eq(10)
          expect((-5..5).step(2).size).to eq(6)
          expect((1...10).step(4).size).to eq(3)
          expect((1...10).step(3).size).to eq(3)
          expect((1...10).step(2).size).to eq(5)
          expect((1...10).step(1).size).to eq(9)
          expect((-5...5).step(2).size).to eq(5)
        end
      end
    end
  end
end
