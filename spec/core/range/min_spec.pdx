# From ruby/spec core/range/min_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Range#min" do
  specify "min and max are the ends, by <=>, walking nothing" do
    expect(("f".."l").min).to eq("f")
    expect((303.20..908.1111).min).to eq(303.20)
  end

  specify "are nil for an empty range" do
    expect(("z".."l").min).to be_nil
    expect((3003.20..908.1111).min).to be_nil
    expect((7...7).min).to be_nil
  end

  specify "keep an excluded integer end out and an included one in" do
    expect((7..7).min).to eq(7)
    expect((1.5...2.5).min).to eq(1.5)
  end

  specify "answer the one end of an open range" do
    expect((1.0...).min).to eq(1.0)
  end

  specify "Range#min and #max honor the exclusive end" do
    expect((1..9).min).to eq(1)
  end

  specify "returns the minimum value in the range" do
    expect((1..10).min).to eq(1)
    expect(('f'..'l').min).to eq('f')
  end

  specify "returns nil when the start point is greater than the endpoint" do
    expect((100..10).min).to be_nil
    expect(('z'..'l').min).to be_nil
  end

  specify "returns the start point when the endpoint equals the start point and the range is inclusive" do
    expect((7..7).min).to eq(7)
  end

  specify "returns nil when the start point is greater than the endpoint in a Float range" do
    expect((3003.20..908.1111).min).to be_nil
  end

  specify "returns the start point for endless ranges" do
    expect((1..).min).to eq(1)
    expect((1.0...).min).to eq(1.0)
  end
end

context "Range#min given a block" do
  specify "passes each pair of values in the range to the block" do
    mutable seen = []
    (1..10).min do |left, right|
      seen << left
      seen << right
      left
    end
    (1..10).each do |value|
      expect(seen.include?(value)).to be_true
    end
  end

  specify "passes each pair of elements to the block where the first argument is the current element, and the last is the first element" do
    mutable seen = []
    (1..5).min do |left, right|
      seen << [left, right]
      left
    end
    expect(seen).to eq([[2, 1], [3, 1], [4, 1], [5, 1]])
  end

  specify "returns the element the block determines to be the minimum" do
    expect((1..3).min { |left, right| -3 }).to eq(3)
  end

  specify "returns nil when the start point is greater than the endpoint" do
    expect((100..10).min { |left, right| left <=> right }).to be_nil
    expect((7...7).min { |left, right| left <=> right }).to be_nil
  end
end

context "Range#min given an integer argument" do
  specify "returns the n minimum values in the range" do
    expect((1..10).min(2)).to eq([1, 2])
    expect((1...10).min(2)).to eq([1, 2])
  end

  specify "returns [] when the endpoint is less than the start point" do
    expect((100..10).min(2)).to eq([])
  end

  specify "returns [] when the endpoint equals the start point and the Integer range is exclusive" do
    expect((5...5).min(2)).to eq([])
  end

  specify "returns the endpoint when the endpoint equals the start point and the Integer range is inclusive" do
    expect((5..5).min(2)).to eq([5])
  end

  specify "returns all the elements in the range when given n larger that elements count" do
    expect((1..3).min(10)).to eq([1, 2, 3])
    expect((1...3).min(10)).to eq([1, 2])
  end
end
