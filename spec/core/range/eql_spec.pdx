# `eql?` on every value (ADR 0059): the equality a hash key matches by —
# same kind and same value, no promotion between numbers, element by
# element through arrays, hashes, ranges, and structs. `hash` is not
# exposed; `value.hash` refuses, pinned by a two-oracle test.
#
# From ruby/spec core/{array,hash,range,struct,integer,float,string}/
# eql_spec.rb and their shared files. What stays behind: the mocks counting
# their calls, the recursive arrays and hashes (values never mutate, so
# none can hold itself), to_ary and to_hash, subclasses, Hash.new defaults,
# bignums, rationals, encodings, and the String rows Ruby's `<=>` answers.

require_relative "../../spec_helper"

struct Car
  make
  model
  year
end

context "Range#eql?" do
  specify "returns true if other has same begin, end, and exclude_end? values" do
    expect((0..2).eql?(0..2)).to be_true
    expect((5..10).eql?(Range.new(5, 10))).to be_true
    expect((0xffff..0xfffff).eql?(0xffff..0xfffff)).to be_true
  end

  specify "returns false if one of the attributes differs" do
    expect((1482..1911).eql?(1482...1911)).to be_false
    expect((0xffff..0xfffff).eql?(0xffff...0xfffff)).to be_false
    expect((1..3).eql?(1..4)).to be_false
  end

  specify "returns false if other is not a Range" do
    expect((1..10).eql?(1)).to be_false
    expect((1..10).eql?("a")).to be_false
  end

  specify "works for endless Ranges" do
    expect((1..).eql?(1..)).to be_true
    expect((1..).eql?(1...)).to be_false
  end
end
