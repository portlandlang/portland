# From ruby/spec core/range/max_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Range#max" do
  specify "min and max are the ends, by <=>, walking nothing" do
    expect(("f".."l").max).to eq("l")
    expect((303.20..908.1111).max).to eq(908.1111)
  end

  specify "are nil for an empty range" do
    expect(("z".."l").max).to be_nil
    expect((3003.20..908.1111).max).to be_nil
    expect((5...5).max).to be_nil
  end

  specify "keep an excluded integer end out and an included one in" do
    expect((1...10).max).to eq(9)
    expect((1..2.5).max).to eq(2.5)
  end

  specify "answer the one end of an open range" do
    expect((..1.0).max).to eq(1.0)
  end

  specify "Range#min and #max honor the exclusive end" do
    expect((1..9).max).to eq(9)
    expect((1...9).max).to eq(8)
  end

  specify "the extremes of an empty range are maybes" do
    expect((5..1).max).to be_nil
    expect((1...1).max).to be_nil
  end

  specify "returns the maximum value in the range" do
    expect((1..10).max).to eq(10)
    expect((1...10).max).to eq(9)
    expect(('f'..'l').max).to eq('l')
  end

  specify "returns nil when the endpoint is less than the start point" do
    expect((100..10).max).to be_nil
    expect(('z'..'l').max).to be_nil
  end

  specify "returns the endpoint when the endpoint equals the start point and the range is inclusive" do
    expect((5..5).max).to eq(5)
  end

  specify "returns nil when the endpoint is less than the start point in a Float range" do
    expect((3003.20..908.1111).max).to be_nil
  end

  specify "returns the end point for beginless ranges" do
    expect((..1).max).to eq(1)
    expect((..1.0).max).to eq(1.0)
  end

  specify "returns the end point for exclusive beginless Integer ranges" do
    expect((...1).max).to eq(0)
  end
end

context "Range#max given a block" do
  specify "passes each pair of values in the range to the block" do
    mutable seen = []
    (1..10).max do |left, right|
      seen << left
      seen << right
      left
    end
    (1..10).each do |value|
      expect(seen.include?(value)).to be_true
    end
  end

  specify "passes each pair of elements to the block in reversed order" do
    mutable seen = []
    (1..5).max do |left, right|
      seen << [left, right]
      left
    end
    expect(seen).to eq([[2, 1], [3, 2], [4, 3], [5, 4]])
  end

  specify "returns the element the block determines to be the maximum" do
    expect((1..3).max { |left, right| -3 }).to eq(1)
  end

  specify "returns nil when the endpoint is less than the start point" do
    expect((100..10).max { |left, right| left <=> right }).to be_nil
    expect((5...5).max { |left, right| left <=> right }).to be_nil
  end
end
