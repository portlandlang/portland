# A range's ends and its printed, listed, compared, and walked forms
# (#111), from ruby/spec core/range: begin, end, first, last, exclude_end?,
# to_s, inspect, ==, to_a, entries, include?, cover?, member?, size, each,
# reverse_each, and minmax — the integer rows; the string and float rows
# are in spec/range/orderable_spec.pdx (ADR 0081). The symbol, non-ASCII,
# Time, and mock rows stay upstream, with to_int and Float counts (ADR
# 0036), the refusals where Ruby raises, Range.new, subclasses, identity
# checks, and blockless Enumerators (ADR 0055). `inspect` is a function
# here (ADR 0026), and alias checks compare the two answers. Upstream's
# `a << i` is the accumulator pattern on a mutable.

require_relative "../../spec_helper"

context "Range#include?" do
  specify "returns true if other is an element of self" do
    expect((0..5).include?(2)).to eq(true)
    expect((-5..5).include?(0)).to eq(true)
    expect((0xffff..0xfffff).include?(0xffffd)).to eq(true)
    expect((0xffff..0xfffff).include?(0xfffd)).to eq(false)
  end

  specify "returns true if argument is equal to the first value of the range" do
    expect((0..5).include?(0)).to eq(true)
  end

  specify "returns true if argument is equal to the last value of the range" do
    expect((0..5).include?(5)).to eq(true)
    expect((0...5).include?(4)).to eq(true)
  end

  specify "returns true if argument is less than the last value of the range and greater than the first value" do
    expect((20..30).include?(28)).to eq(true)
  end

  specify "returns true if argument is sole element in the range" do
    expect((30..30).include?(30)).to eq(true)
  end

  specify "returns false if range is empty" do
    expect((30...30).include?(30)).to eq(false)
  end

  specify "respects the exclusive end" do
    expect((1..5)).to contain(5)
    expect((1...5)).not_to contain(5)
  end

  specify "answers for an endless range" do
    expect((1..)).to contain(99)
  end

  specify "answers for a beginless one" do
    expect((..4)).to contain(0 - 5)
    expect((..4)).not_to contain(5)
  end

  specify "covers strings between the ends, by <=>" do
    expect(("C".."X").include?("M")).to be_true
    expect(("C".."X").include?("A")).to be_false
    expect(("B"..."W").include?("W")).to be_false
  end

  specify "covers floats and integers alike" do
    expect((0.5..2.4).include?(2)).to be_true
    expect((0.5..2.4).include?(2.5)).to be_false
    expect((0.5..2.4).include?(2.4)).to be_true
    expect((0.5...2.4).include?(2.4)).to be_false
    expect((-10..-2).include?(-2.5)).to be_true
    expect((-1...1).include?(10.5)).to be_false
  end

  specify "reaches everything on an open side" do
    expect((1..).include?(2.4)).to be_true
    expect((0.5...).include?(2.4)).to be_true
    expect((..10).include?(2.4)).to be_true
    expect((...10.5).include?(2.4)).to be_true
    expect((1..).include?(0.4)).to be_false
    expect((..10).include?(12.4)).to be_false
  end

  specify "answers false for a value the ends cannot order" do
    expect((1..10).include?(nil)).to be_false
    expect(("A".."C").include?(20.9)).to be_false
    expect((30...30).include?(30)).to be_false
  end
end
