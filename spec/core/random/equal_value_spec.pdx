# Randomness (ADR 0065): Ruby's both — the ambient `rand`, `srand`,
# `sample`, and `shuffle`, and the explicit `Random.new(seed)` — with
# Ruby's generator step for step, so every seeded number here is the one
# CRuby draws.
#
# From ruby/spec core/random/{new,rand,seed,equal_value,srand}_spec.rb,
# core/kernel/{rand,srand}_spec.rb, and core/array/{sample,shuffle}_spec.rb. What stays behind: the fairness
# measurement, mocks of `rand` and `to_int`, `random: Random` the class
# (a type is not a value), bignum bounds (#156), the
# Formatter and bytes (#119), and `Random.srand`/`Random.rand` as class
# methods, which are the bare functions here.

require_relative "../../spec_helper"

context "Random#==" do
  specify "returns true if the two objects have the same state" do
    expect(Random.new(42) == Random.new(42)).to be_true
  end

  specify "returns false if the two objects have different state" do
    drawn = Random.new(42)
    drawn.rand
    expect(drawn == Random.new(42)).to be_false
  end

  specify "returns true if the two objects have the same seed" do
    expect(Random.new(42) == Random.new(42.5)).to be_true
  end

  specify "returns false if the two objects have a different seed" do
    expect(Random.new(42) == Random.new(41)).to be_false
  end

  specify "returns false if the other object is not a Random" do
    expect(Random.new(42) == 42).to be_false
    expect(Random.new(42) == [Random.new(42)]).to be_false
  end
end
