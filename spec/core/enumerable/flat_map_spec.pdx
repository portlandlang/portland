# From ruby/spec core/enumerable/flat_map_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

struct FlatMapNumerous
  list

  include Enumerable

  def each
    list.each { |item| yield item }
  end
end

context "Enumerable#flat_map" do
  specify "each_slice chunks and flat_map opens one level" do
    expect([1, 2].flat_map { [it, it] }).to eq([1, 1, 2, 2])
  end

  specify "yields elements to the block and flattens one level" do
    numerous = FlatMapNumerous.new(list: [1, [2, 3], [4, [5, 6]], {foo: :bar}])
    expect(numerous.flat_map { |element| element }).to eq([1, 2, 3, 4, [5, 6], {foo: :bar}])
  end
end
