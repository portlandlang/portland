# From ruby/spec core/enumerable/each_slice_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Enumerable#each_slice" do
  specify "each_slice chunks and flat_map opens one level" do
    expect([1, 2, 3, 4].each_slice(2).to_a).to eq([[1, 2], [3, 4]])
  end
end
