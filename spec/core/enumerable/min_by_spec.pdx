# Ruby's Enumerable extremes and sums on an Enumerable struct (#110):
# `min`, `max`, `minmax_by`, `min_by`, `max_by`, `sort_by`, and `sum`,
# ordering by `<=>` (ADR 0054) or by the block's answers.
#
# From ruby/spec core/enumerable/{min,max,min_by,max_by,minmax_by,sort_by,
# sum}_spec.rb. Upstream's EachDefiner is a loop over an array; here it
# is the same struct as Numerous. What stays behind: `min(n)` and `max(n)`
# with a count, the blockless enumerators (ADR 0055), elements without
# `<=>` and incompatible pairs (which refuse where Ruby raises), the rows
# that order nils through truthiness or find a nil (`min_by` answers a
# maybe, so a found nil is a present nil), the comparator block answering
# something other than -1, 0, or 1, mocks of `each`, and rationals.

require_relative "../../spec_helper"

struct Numerous
  list

  include Enumerable

  def each
    list.each { |item| yield item }
  end
end
struct Empty
  include Enumerable

  def each
    self
  end
end
struct YieldsMulti
  include Enumerable

  def each
    yield 1, 2
    yield 3, 4, 5
    yield 6, 7, 8, 9
  end
end
def numerous(list) = Numerous.new(list: list)
DEFAULT = [2, 5, 3, 6, 1, 4]
STRINGS = ["333", "22", "666666", "1", "55555", "1010101010"]
INTEGERS = [333, 22, 666666, 55555, 1010101010]

context "Enumerable#min_by" do
  specify "returns nil if #each yields no objects" do
    expect(Empty.new.min_by { |item| item }).to be_nil
  end

  specify "returns the object for whom the value returned by block is the smallest" do
    expect(numerous(%w[3 2 1]).min_by { |item| item.to_i }).to eq("1")
    expect(numerous(%w[five three]).min_by { |item| item.length }).to eq("five")
  end

  specify "returns the object that appears first in #each in case of a tie" do
    expect(numerous(["2", "1", "1"]).min_by { |item| item.to_i }).to eq("1")
  end

  specify "is able to return the minimum for enums that contain nils" do
    elements = numerous([nil, nil, true])
    expect(elements.min_by { |item| item.nil? ? 1 : 0 }).to eq(true)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.min_by { |item| item.length }).to eq([1, 2])
  end
end
