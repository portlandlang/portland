# Ruby's Enumerable predicates and counts on an Enumerable struct (#110):
# `all?`, `any?`, `none?`, and `one?` take a block that answers true or
# false — the blockless forms ask an element's own truthiness, which is a
# refusal here, as is a block answering 5 or nil — and `count`, `include?`,
# and `find_index` ask `==`.
#
# From ruby/spec core/enumerable/{all,any,none,one,count,find_index}_spec.rb.
# What stays behind: the pattern argument (`all?(Integer)`, asking `===`),
# exceptions out of `each` or the block, the extra-argument arity rows
# (checked statically here), the ignored block beside an argument, the
# splat block parameter, and the row where a one-parameter block takes
# the first of several yielded values — here it sees the packed array.

require_relative "../../spec_helper"

struct Numerous
  list

  include Enumerable

  def each
    list.each { |item| yield item }
  end
end
struct Empty
  include Enumerable

  def each
    self
  end
end
struct YieldsMulti
  include Enumerable

  def each
    yield 1, 2
    yield 3, 4, 5
    yield 6, 7, 8, 9
  end
end
def numerous(list) = Numerous.new(list: list)
DEFAULT = [2, 5, 3, 6, 1, 4]

context "Enumerable#find_index" do
  elements = [2, 4, 6, 8, 10]

  specify "passes each entry in enum to block while block when block is false" do
    mutable visited = []
    numerous(elements).find_index do |element|
      visited << element
      false
    end
    expect(visited).to eq(elements)
  end

  specify "returns nil when the block is false" do
    expect(numerous(elements).find_index { |item| false }).to be_nil
  end

  specify "returns the first index for which the block is not false" do
    elements.each_with_index do |element, index|
      expect(numerous(elements).find_index { |item| item > element - 1 }).to eq(index)
    end
  end

  specify "returns the first index found" do
    repeated = [10, 11, 11, 13, 11, 13, 10, 10, 13, 11]
    repeated.each do |element|
      expect(numerous(repeated).find_index(element)).to eq(element - 10)
    end
  end

  specify "returns nil when the element not found" do
    expect(numerous(elements).find_index(-1)).to be_nil
  end

  specify "uses #== for testing equality" do
    expect([2].find_index(2.0)).to eq(0)
    expect([2.0].find_index(2)).to eq(0)
  end

  describe "without block" do
    specify "gathers whole arrays as elements when each yields multiple" do
      expect(YieldsMulti.new.find_index([3, 4, 5])).to eq(1)
    end
  end
end
