# `Enumerable` is the second builtin trait (#110, after ADR 0054's
# Comparable): a struct that defines `each` and includes it answers Ruby's
# Enumerable names through what its `each` yields — gathered once, then
# the array's own arm. A yield of several values packs into one array,
# as Ruby's Enumerable packs them, for every name alike; the twins
# (`collect`, `detect`, `entries`, `filter`, `find_all`, `member?`,
# `reduce`, `collect_concat`) answer what their survivors answer.
#
# From ruby/spec core/enumerable/{to_a,entries,collect,collect_concat,
# detect,filter,find_all,member,reduce,first,take,map,select,find,sort,
# reject,include,partition,reverse_each,minmax,compact}_spec.rb and
# shared/take.rb. Upstream's fixtures are classes; here they are structs.
# What stays behind: the blockless enumerators (ADR 0055), `each` taking
# arguments, the `ifnone` proc, mocks of `<=>` and `==`, and the rows
# where a block's one parameter takes the first of several yielded values
# — here the block sees the packed array.

require_relative "../../spec_helper"

struct Numerous
  list

  include Enumerable

  def each
    list.each { |item| yield item }
  end
end
struct Empty
  include Enumerable

  def each
    self
  end
end
struct YieldsMulti
  include Enumerable

  def each
    yield 1, 2
    yield 3, 4, 5
    yield 6, 7, 8, 9
  end
end
def numerous(list) = Numerous.new(list: list)
DEFAULT = [2, 5, 3, 6, 1, 4]

context "Enumerable#first" do
  specify "returns the first element" do
    expect(numerous(DEFAULT).first).to eq(2)
    expect(Empty.new.first).to be_nil
  end

  specify "returns nil if self is empty" do
    expect(Empty.new.first).to be_nil
  end

  specify "returns a gathered array from yield parameters" do
    expect(YieldsMulti.new.first).to eq([1, 2])
  end

  describe "when passed an argument" do
    values = [4, 3, 2, 1, 0, -1]

    specify "returns the first count elements if given a count" do
      expect(numerous(values).first(2)).to eq([4, 3])
      expect(numerous(values).first(4)).to eq([4, 3, 2, 1])
    end

    specify "returns an empty array when passed count on an empty array" do
      expect(Empty.new.first(0)).to eq([])
      expect(Empty.new.first(1)).to eq([])
      expect(Empty.new.first(2)).to eq([])
    end

    specify "returns an empty array when passed count == 0" do
      expect(numerous(values).first(0)).to eq([])
    end

    specify "returns an array containing the first element when passed count == 1" do
      expect(numerous(values).first(1)).to eq([4])
    end

    specify "returns the entire array when count > length" do
      expect(numerous(values).first(100)).to eq(values)
      expect(numerous(values).first(8)).to eq(values)
    end

    specify "gathers whole arrays as elements when each yields multiple" do
      expect(YieldsMulti.new.first(1)).to eq([[1, 2]])
    end
  end

  specify "answer as on an array" do
    expect(Set[1, 2, 3].first).to eq(1)
    expect(Set[].first).to be_nil
  end
end
