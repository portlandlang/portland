# From ruby/spec core/enumerable/tally_spec.rb.
#
# What stays upstream, and why, is this file's entry in spec/ruby_spec.yml.

require_relative "../../spec_helper"

context "Enumerable#tally" do
  specify "tally counts into a hash, keys in first-seen order" do
    expect(%w[a b a].tally).to eq({"a" => 2, "b" => 1})
  end

  specify "answer as on an array" do
    expect(Set[1, 1, 2].tally).to eq({1 => 1, 2 => 1})
  end
end
