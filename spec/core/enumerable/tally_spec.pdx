# From ruby/spec core/enumerable/tally_spec.rb.
#
# The rows Portland's spec held; the rest of the file is not yet ported.

require_relative "../../spec_helper"

context "Enumerable#tally" do
  specify "tally counts into a hash, keys in first-seen order" do
    expect(%w[a b a].tally).to eq({"a" => 2, "b" => 1})
  end
end
