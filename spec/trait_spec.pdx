# Traits carry shared behavior (ADR 0028): a bundle of methods with no
# state, included with Ruby's verb — safe because the noun is new.

require_relative "spec_helper"

trait Describable
  def label
    "#{kind}: #{text}"
  end

  def shouted
    label.upcase
  end
end

trait Sized
  def size_note
    "#{text.length} characters"
  end
end

struct Token
  kind
  text

  include Describable
  include Sized

  def brief
    text
  end
end

module Rendering
  trait Framed
    def framed
      "[#{label}]"
    end
  end

  struct Badge
    label

    include Framed
  end
end

context "a trait" do
  token = Token.new(kind: "word", text: "pdx")

  describe "carried by a struct" do
    specify "hands its methods to the carrier" do
      expect(token.label, "word: pdx")
    end

    specify "reaches the carrier's fields bare" do
      expect(token.size_note, "3 characters")
    end

    specify "reaches its own sibling methods bare" do
      expect(token.shouted, "WORD: PDX")
    end

    specify "sits beside the struct's own methods, two traits at once" do
      expect([token.brief, token.label, token.size_note], ["pdx", "word: pdx", "3 characters"])
    end
  end

  describe "nested in a module" do
    specify "resolves outward from where the struct was written" do
      expect(Rendering::Badge.new(label: "pdx").framed, "[pdx]")
    end
  end
end
