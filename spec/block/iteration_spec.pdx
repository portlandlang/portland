# The block-taking library: iteration, transformation, and the number loops.

require_relative "../spec_helper"

context "the block-taking library" do
  describe "each" do
    specify "walks an array" do
      mutable seen = []
      %w[rose city].each do |word|
        seen << word
      end
      expect(seen, ["rose", "city"])
    end

    specify "walks a hash as key and value pairs, in insertion order" do
      mutable seen = []
      {name: "pdx", port: 8080}.each do |key, value|
        seen << "#{value}"
      end
      expect(seen, ["pdx", "8080"])
    end
  end

  describe "each_with_index" do
    specify "hands the element first and the count second" do
      mutable seen = []
      %w[rose city].each_with_index do |word, index|
        seen << "#{index}:#{word}"
      end
      expect(seen, ["0:rose", "1:city"])
    end
  end

  describe "the transformers" do
    numbers = [1, 2, 3, 4]

    specify "map builds a new array from the block's answers" do
      expect(numbers.map { it * 10 }, [10, 20, 30, 40])
    end

    specify "select keeps the hits and reject drops them" do
      expect([numbers.select { it.even? }, numbers.reject { it.even? }], [[2, 4], [1, 3]])
    end

    specify "reduce folds from an initial value" do
      expect(numbers.reduce(10) { |total, number| total + number }, 20)
    end
  end

  describe "the number loops" do
    specify "times runs the block that many times" do
      mutable ticks = 0
      3.times do
        ticks += 1
      end
      expect(ticks, 3)
    end

    specify "upto counts up, ends included" do
      mutable counted = []
      1.upto(3) do |number|
        counted << number
      end
      expect(counted, [1, 2, 3])
    end

    specify "downto counts down" do
      mutable counted = []
      3.downto(1) do |number|
        counted << number
      end
      expect(counted, [3, 2, 1])
    end
  end
end

# Blocks are closures: they see the scope they were written in.
context "a block's scope" do
  factor = 10

  describe "an outer immutable" do
    specify "is reachable from the block" do
      expect([1, 2].map { it * factor }, [10, 20])
    end
  end

  # Parameters are block-local: shadowed for the call, restored at `end` —
  # the one shadowing the no-shadow rule licenses.
  describe "a named parameter" do
    specify "shadows an outer local and restores it" do
      word = "outer"
      seen = %w[inner].map { |word| word }
      expect([seen, word], [["inner"], "outer"])
    end
  end
end
