# Blocks and their parameters.

require_relative "../spec_helper"

# ADR 0017 — `it` is an ordinary binding, so a one-parameter block can leave
# it undeclared. This example is the reason the DSL says `specify`: with a
# `def it` in scope the two would contest the name and the seed would refuse,
# making 0017 the one ADR this suite could not pin.
context "a block's implicit `it`" do
  words = %w[rose city]

  describe "declaration by use" do
    specify "is the single parameter, never declared" do
      expect(words.map { it.upcase }).to eq(["ROSE", "CITY"])
    end

    # An `it` whose only appearance is inside an interpolation counts (#47)
    # — both oracles used to miss it there, each in its own way.
    specify "declares itself from inside an interpolation" do
      expect(words.map { "#{it}!" }).to eq(["rose!", "city!"])
    end
  end
end

# From ruby/spec language/it_parameter_spec.rb. A nested `it` is a shadow
# and refuses, as does an `it` beside a named parameter; there are no
# procs or lambdas to call, no arity to ask, and no eval.
context "The `it` parameter" do
  specify "provides it in a block" do
    expect(["a"].map { it }).to eq(["a"])
  end
end
