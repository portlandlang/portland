# The block-taking library beyond the original twelve arms — each of these
# is an arm in the compiler's deliberately-repetitive block-call dispatch
# riding the seed's builtin of the same name, so the two oracles cannot
# drift. `tally`, `zip`, and `each_slice` take no block and answer values
# outright; `each_slice` answers the slices as an array (no lazy enumerator
# here), so `.to_a` on it is the identity.
#
# From ruby/spec core/array/{any,all,find,zip,tally,sort_by,each_slice,
# flat_map}_spec.rb and core/enumerable kin.

require_relative "../spec_helper"

context "the block-taking library" do
  describe "the verdict trio" do
    specify "any? asks whether one hit is enough" do
      expect([1, 2, 3].any? { it > 2 }).to be_true
      expect([1, 2, 3].any? { it > 5 }).to be_false
    end

    specify "all? asks for unanimity" do
      expect([1, 2, 3].all? { it > 0 }).to be_true
      expect([1, 2, 3].all? { it > 1 }).to be_false
    end

    specify "none? asks for silence" do
      expect([1, 2, 3].none? { it > 5 }).to be_true
      expect([1, 2, 3].none? { it > 2 }).to be_false
    end
  end

  describe "the finders and shapers" do
    specify "find answers the first hit — a maybe" do
      expect([1, 2, 3].find { it > 1 }).to eq(2)
      expect([1, 2, 3].find { it > 9 }).to be_nil
    end

    specify "detect is find's twin (ADR 0036)" do
      expect([1, 2, 3].detect { it > 1 }).to eq(2)
      expect([1, 2, 3].detect { it > 9 }).to be_nil
    end

    specify "sort_by sorts by the block's answers" do
      expect(%w[bb a ccc].sort_by { it.length }).to eq(["a", "bb", "ccc"])
    end

    specify "tally counts into a hash, keys in first-seen order" do
      expect(%w[a b a].tally).to eq({"a" => 2, "b" => 1})
    end

    specify "zip pairs elements by position" do
      expect([1, 2].zip([3, 4])).to eq([[1, 3], [2, 4]])
    end

    specify "each_slice chunks and flat_map opens one level" do
      expect([1, 2, 3, 4].each_slice(2).to_a).to eq([[1, 2], [3, 4]])
      expect([1, 2, 3, 4, 5].each_slice(2)).to eq([[1, 2], [3, 4], [5]])
      expect([1, 2].flat_map { [it, it] }).to eq([1, 1, 2, 2])
    end
  end
end
