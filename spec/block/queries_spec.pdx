# The block-taking library beyond the twelve arms the compiler carries — none
# built yet, held pending (#23). These are heavier builds than value
# methods: each is a new arm in the compiler's deliberately-repetitive
# block-call dispatch, not just a seed builtin.
#
# From ruby/spec core/array/{any,all,find,zip,tally,sort_by,each_slice,
# flat_map}_spec.rb and core/enumerable kin.

require_relative "../spec_helper"

context "the block-taking library" do
  describe "the missing arms" do
    pending "any?, all?, none? — no arms yet" do
      expect([1, 2, 3].any? { it > 2 }).to be_true
      expect([1, 2, 3].all? { it > 0 }).to be_true
      expect([1, 2, 3].none? { it > 5 }).to be_true
    end

    pending "find — no arm yet; the first hit, a maybe" do
      expect([1, 2, 3].find { it > 1 }).to eq(2)
      expect([1, 2, 3].find { it > 9 }).to be_nil
    end

    pending "sort_by — no arm yet" do
      expect(%w[bb a ccc].sort_by { it.length }).to eq(["a", "bb", "ccc"])
    end

    pending "tally — no builtin yet; counts into a hash" do
      expect(%w[a b a].tally).to eq({"a" => 2, "b" => 1})
    end

    pending "zip — no builtin yet" do
      expect([1, 2].zip([3, 4])).to eq([[1, 3], [2, 4]])
    end

    pending "each_slice and flat_map — no arms yet" do
      expect([1, 2, 3, 4].each_slice(2).to_a).to eq([[1, 2], [3, 4]])
      expect([1, 2].flat_map { [it, it] }).to eq([1, 1, 2, 2])
    end
  end
end
