# Brace blocks: one meaning, shared with `do`, attached where a reader would
# attach it.

require_relative "../spec_helper"

def repeat
  first = yield
  second = yield
  "#{first} #{second}"
end

def greet(name:)
  "hello, #{name}"
end

def outer(argument)
  yield
end

def inner
  "inner's value"
end

def unwrap
  handed = yield
  handed[:name]
end

context "a brace block" do
  # ADR 0016 — `do |x| ... end` and `{ |x| ... }` are dead-identical;
  # Ruby's braces-bind-tighter rule is gone.
  describe "against do" do
    braced = repeat { "brace" }
    donned = repeat do
      "do"
    end

    specify "calls the same way" do
      expect([braced, donned], ["brace brace", "do do"])
    end
  end

  # ADR 0024 — `{` attaches wherever `do` does, paren-less calls included,
  # and the peek at the first pair position is what clears this one: a body
  # starting `greet name:` cannot be a hash, however hash-like it looks
  # further in.
  describe "on a paren-less call" do
    greeted = repeat { greet name: "pdx" }

    specify "is that call's block" do
      expect(greeted, "hello, pdx hello, pdx")
    end
  end

  # ADR 0024 — `{{name: 1}}` is a block holding a hash: the inner `{` cannot
  # start a pair, so the outer braces have one reading.
  describe "holding a hash literal" do
    unwrapped = unwrap {{name: 1}}

    specify "hands the hash through" do
      expect(unwrapped, 1)
    end
  end
end

context "a do block" do
  # `do ... end` belongs to the outermost call, always — Ruby's rule, kept
  # because it is the one reading to have. Only the block can testify: if
  # `inner` had been handed it instead, nothing would run it, and the record
  # would come back empty.
  describe "after a command call's argument" do
    mutable record = []
    outer inner do
      record << "ran under outer"
    end

    specify "belongs to the outermost call" do
      expect(record, ["ran under outer"])
    end
  end
end
