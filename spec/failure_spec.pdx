# Failure is absence with a reason (ADR 0027): a fallible operation returns
# its value or a `failure`, the unwrap toolkit already knows what to do, and
# `!` walks a failure home one marked frame at a time.

require_relative "spec_helper"

struct ParseFailed
  line
end

def risky(flag)
  return failure("flagged") if flag
  "fine"
end

def guarded(flag)
  value = risky!(flag)
  "got #{value}"
end

def through_a_block(flag)
  [1, 2].each do |number|
    risky!(flag)
  end
  "walked all #{2} elements"
end

context "a failure" do
  describe "the box" do
    specify "is marked, and marks nothing else" do
      expect(failure("why")).to(be_failure)
      expect(5).not_to(be_failure)
      expect(nil).not_to(be_failure)
    end

    specify "is present, not absent — absence with a reason is still a value" do
      expect(failure("why")).to(be_some)
      expect(failure("why")).not_to(be_nil)
    end

    specify "renders under inspect with its reason" do
      expect(inspect(failure(42))).to(eq("failure(42)"))
    end
  end

  describe "the unwrap toolkit, unchanged" do
    specify "or takes the fallback on a failure" do
      expect((failure("why") or "fallback")).to(eq("fallback"))
    end

    specify "and keeps a present value" do
      expect(("present" or "unused")).to(eq("present"))
    end

    specify "case/in reaches through the box to the reason" do
      answer = case failure("out of roses")
      in reason then "reason was #{reason}"
      end
      expect(answer).to(eq("reason was out of roses"))
    end

    specify "and destructures a struct payload by pattern" do
      shaped = case failure(ParseFailed.new(line: 7))
      in ParseFailed(line:) then "failed on line #{line}"
      in content            then "parsed #{content}"
      end
      expect(shaped).to(eq("failed on line 7"))
    end
  end
end

context "the ! suffix" do
  describe "on a call whose value is sound" do
    specify "passes the value through untouched" do
      expect(guarded(false)).to(eq("got fine"))
    end
  end

  describe "on a call that failed" do
    specify "returns the failure from the enclosing method" do
      expect(guarded(true)).to(be_failure)
    end

    specify "unwinds through blocks to its write site" do
      expect(through_a_block(false)).to(eq("walked all 2 elements"))
      expect(through_a_block(true)).to(be_failure)
    end
  end
end

context "the first fallible operation" do
  describe "read_file on a missing path" do
    specify "answers a failure, not a panic" do
      expect(read_file("/tmp/portland-definitely-missing")).to(be_failure)
    end

    specify "which is one or away from a default" do
      expect((read_file("/tmp/portland-definitely-missing") or "default config")).to(eq("default config"))
    end
  end
end
