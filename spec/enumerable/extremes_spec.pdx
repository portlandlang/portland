# Ruby's Enumerable extremes and sums on an Enumerable struct (#110):
# `min`, `max`, `minmax_by`, `min_by`, `max_by`, `sort_by`, and `sum`,
# ordering by `<=>` (ADR 0054) or by the block's answers.
#
# From ruby/spec core/enumerable/{min,max,min_by,max_by,minmax_by,sort_by,
# sum}_spec.rb. Upstream's EachDefiner is a loop over an array; here it
# is the same struct as Numerous. What stays behind: `min(n)` and `max(n)`
# with a count, the blockless enumerators (ADR 0055), elements without
# `<=>` and incompatible pairs (which refuse where Ruby raises), the rows
# that order nils through truthiness or find a nil (`min_by` answers a
# maybe, so a found nil is a present nil), the comparator block answering
# something other than -1, 0, or 1, mocks of `each`, and rationals.

require_relative "../spec_helper"

struct Numerous
  list

  include Enumerable

  def each
    list.each { |item| yield item }
  end
end

struct Empty
  include Enumerable

  def each
    self
  end
end

struct YieldsMulti
  include Enumerable

  def each
    yield 1, 2
    yield 3, 4, 5
    yield 6, 7, 8, 9
  end
end

def numerous(list) = Numerous.new(list: list)

DEFAULT = [2, 5, 3, 6, 1, 4]
STRINGS = ["333", "22", "666666", "1", "55555", "1010101010"]
INTEGERS = [333, 22, 666666, 55555, 1010101010]

context "Enumerable#min" do
  specify "min should return the minimum element" do
    expect(numerous(DEFAULT).min).to eq(1)
  end

  specify "returns the minimum (basic cases)" do
    expect(numerous([55]).min).to eq(55)

    expect(numerous([11, 99]).min).to eq(11)
    expect(numerous([99, 11]).min).to eq(11)
    expect(numerous([2, 33, 4, 11]).min).to eq(2)

    expect(numerous([1, 2, 3, 4, 5]).min).to eq(1)
    expect(numerous([5, 4, 3, 2, 1]).min).to eq(1)
    expect(numerous([4, 1, 3, 5, 2]).min).to eq(1)
    expect(numerous([5, 5, 5, 5, 5]).min).to eq(5)

    expect(numerous(["aa", "tt"]).min).to eq("aa")
    expect(numerous(["tt", "aa"]).min).to eq("aa")
    expect(numerous(["2", "33", "4", "11"]).min).to eq("11")

    expect(numerous(STRINGS).min).to eq("1")
    expect(numerous(INTEGERS).min).to eq(22)
  end

  specify "returns nil for an empty Enumerable" do
    expect(Empty.new.min).to be_nil
  end

  specify "returns the minimum when using a block rule" do
    expect(numerous(["2", "33", "4", "11"]).min { |left, right| left <=> right }).to eq("11")
    expect(numerous([2, 33, 4, 11]).min { |left, right| left <=> right }).to eq(2)

    expect(numerous(["2", "33", "4", "11"]).min { |left, right| right <=> left }).to eq("4")
    expect(numerous([2, 33, 4, 11]).min { |left, right| right <=> left }).to eq(33)

    expect(numerous(STRINGS).min { |left, right| left.length <=> right.length }).to eq("1")

    expect(numerous(STRINGS).min { |left, right| left <=> right }).to eq("1")
    expect(numerous(STRINGS).min { |left, right| left.to_i <=> right.to_i }).to eq("1")

    expect(numerous(INTEGERS).min { |left, right| left <=> right }).to eq(22)
    expect(numerous(INTEGERS).min { |left, right| left.to_s <=> right.to_s }).to eq(1010101010)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.min).to eq([1, 2])
  end
end

context "Enumerable#max" do
  specify "returns the maximum element" do
    expect(numerous(DEFAULT).max).to eq(6)
  end

  specify "returns the maximum element (basics cases)" do
    expect(numerous([55]).max).to eq(55)

    expect(numerous([11, 99]).max).to eq(99)
    expect(numerous([99, 11]).max).to eq(99)
    expect(numerous([2, 33, 4, 11]).max).to eq(33)

    expect(numerous([1, 2, 3, 4, 5]).max).to eq(5)
    expect(numerous([5, 4, 3, 2, 1]).max).to eq(5)
    expect(numerous([1, 4, 3, 5, 2]).max).to eq(5)
    expect(numerous([5, 5, 5, 5, 5]).max).to eq(5)

    expect(numerous(["aa", "tt"]).max).to eq("tt")
    expect(numerous(["tt", "aa"]).max).to eq("tt")
    expect(numerous(["2", "33", "4", "11"]).max).to eq("4")

    expect(numerous(STRINGS).max).to eq("666666")
    expect(numerous(INTEGERS).max).to eq(1010101010)
  end

  specify "returns nil for an empty Enumerable" do
    expect(Empty.new.max).to be_nil
  end

  describe "when passed a block" do
    specify "returns the maximum element" do
      expect(numerous(["2", "33", "4", "11"]).max { |left, right| left <=> right }).to eq("4")
      expect(numerous([2, 33, 4, 11]).max { |left, right| left <=> right }).to eq(33)

      expect(numerous(["2", "33", "4", "11"]).max { |left, right| right <=> left }).to eq("11")
      expect(numerous([2, 33, 4, 11]).max { |left, right| right <=> left }).to eq(2)

      expect(numerous(STRINGS).max { |left, right| left.length <=> right.length }).to eq("1010101010")

      expect(numerous(STRINGS).max { |left, right| left <=> right }).to eq("666666")
      expect(numerous(STRINGS).max { |left, right| left.to_i <=> right.to_i }).to eq("1010101010")

      expect(numerous(INTEGERS).max { |left, right| left <=> right }).to eq(1010101010)
      expect(numerous(INTEGERS).max { |left, right| left.to_s <=> right.to_s }).to eq(666666)
    end
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.max).to eq([6, 7, 8, 9])
  end
end

context "Enumerable#min_by" do
  specify "returns nil if #each yields no objects" do
    expect(Empty.new.min_by { |item| item }).to be_nil
  end

  specify "returns the object for whom the value returned by block is the smallest" do
    expect(numerous(%w[3 2 1]).min_by { |item| item.to_i }).to eq("1")
    expect(numerous(%w[five three]).min_by { |item| item.length }).to eq("five")
  end

  specify "returns the object that appears first in #each in case of a tie" do
    expect(numerous(["2", "1", "1"]).min_by { |item| item.to_i }).to eq("1")
  end

  specify "is able to return the minimum for enums that contain nils" do
    elements = numerous([nil, nil, true])
    expect(elements.min_by { |item| item.nil? ? 1 : 0 }).to eq(true)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.min_by { |item| item.length }).to eq([1, 2])
  end
end

context "Enumerable#max_by" do
  specify "returns nil if #each yields no objects" do
    expect(Empty.new.max_by { |item| item }).to be_nil
  end

  specify "returns the object for whom the value returned by block is the largest" do
    expect(numerous(%w[1 2 3]).max_by { |item| item.to_i }).to eq("3")
    expect(numerous(%w[three five]).max_by { |item| item.length }).to eq("three")
  end

  specify "returns the object that appears first in #each in case of a tie" do
    expect(numerous(["1", "2", "2"]).max_by { |item| item.to_i }).to eq("2")
  end

  specify "is able to return the maximum for enums that contain nils" do
    elements = numerous([nil, nil, true])
    expect(elements.max_by { |item| item.nil? ? 0 : 1 }).to eq(true)
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.max_by { |item| item.length }).to eq([6, 7, 8, 9])
  end
end

context "Enumerable#minmax_by" do
  specify "returns nil if #each yields no objects" do
    expect(Empty.new.minmax_by { |item| item }).to eq([nil, nil])
  end

  specify "returns the object for whom the value returned by block is the largest" do
    expect(numerous(%w[1 2 3]).minmax_by { |item| item.to_i }).to eq(["1", "3"])
    expect(numerous(%w[three five]).minmax_by { |item| item.length }).to eq(["five", "three"])
  end

  specify "returns the object that appears first in #each in case of a tie" do
    expect(numerous(["1", "1", "2", "2"]).minmax_by { |item| item.to_i }).to eq(["1", "2"])
  end

  specify "is able to return the maximum for enums that contain nils" do
    expect(numerous([nil, nil, true]).minmax_by { |item| item.nil? ? 0 : 1 }).to eq([nil, true])
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.minmax_by { |item| item.length }).to eq([[1, 2], [6, 7, 8, 9]])
  end
end

context "Enumerable#sort_by" do
  specify "returns an array of elements ordered by the result of block" do
    words = numerous(["once", "upon", "a", "time"])
    expect(words.sort_by { |word| word[0] }).to eq(["a", "once", "time", "upon"])
  end

  specify "gathers whole arrays as elements when each yields multiple" do
    expect(YieldsMulti.new.sort_by { |item| item.length }).to eq([[1, 2], [3, 4, 5], [6, 7, 8, 9]])
  end

  specify "calls #each to iterate over the elements to be sorted" do
    expect(numerous([1, 2, 3]).sort_by { |item| -item }).to eq([3, 2, 1])
  end
end

context "Enumerable#sum" do
  elements = numerous([0, -1, 2, 3])

  specify "returns amount of the elements with taking an argument as the initial value" do
    expect(elements.sum(10)).to eq(14)
  end

  specify "gives 0 as a default argument" do
    expect(elements.sum).to eq(4)
  end

  describe "with a block" do
    specify "transforms the elements" do
      expect(elements.sum { |element| element * 2 }).to eq(8)
    end

    specify "does not destructure array elements" do
      expect(numerous([[1, 2], [3]]).sum { |pair| pair.last }).to eq(5)
    end
  end

  specify "uses Kahan's compensated summation algorithm for precise sum of float numbers" do
    floats = numerous([2.7800000000000002, 5.0, 2.5, 4.44, 3.89, 3.89, 4.44, 7.78, 5.0, 2.7800000000000002, 5.0, 2.5])
    naive_sum = floats.inject(0.0) { |sum, element| sum + element }
    expect(naive_sum).to eq(50.00000000000001)
    expect(floats.sum).to eq(50.0)
  end
end
