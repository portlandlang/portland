# An enum nests the way types nest (ADR 0022 §2), `Purchase::Status` naming
# the type while `purchase.status` reads the value.
#
# The method beside the nested enum is load-bearing: that combination parsed
# in the seed and not in the trio the day this file grew (#44).

require_relative "../spec_helper"

struct Purchase
  amount
  status

  enum Status
    :pending
    :paid(on:)
    :refunded(on:, reason:)
  end

  def paid?
    status in :paid(on:)
  end
end

context "an enum" do
  describe "nesting in a struct" do
    purchase = Purchase.new(amount: 40, status: :paid(on: "tuesday"))

    specify "reads back off the field" do
      day = case purchase.status
      in :pending   then "never"
      in :paid(on:) then on
      end
      expect(day).to eq("tuesday")
    end

    specify "and the struct's own methods match on it" do
      expect(purchase.paid?).to be_true
    end
  end
end
