# Ruby's output wrappers over the two standard streams (ADR 0068, #185):
# `puts`, `p`, `pp`, `print`, `putc`, `printf` on standard output and `warn`
# on standard error. Each spec asserts what the call answers; what it writes
# is pinned by the two-oracle test, since nothing here can capture a stream.
# A line written here passes through the harness harmlessly, so every write
# ends in a newline.
#
# From ruby/spec core/kernel/{p,pp,print,putc,printf,warn,puts}_spec.rb.
# Upstream: the privacy and reflection rows, `$stdout` and `$VERBOSE`
# reassignment, the mocks, `$_`, the IO-first-argument forms of printf, and
# warn's uplevel and category keywords. `puts` answers no value (ADR 0012),
# so its one row is the two-oracle test's.

require_relative "../spec_helper"

context "Kernel#p" do
  specify "prints nothing if no argument is given" do
    expect(p).to be_nil
  end

  specify "returns the argument if a single argument is given" do
    expect(p("p printed this line itself")).to eq("p printed this line itself")
  end

  specify "returns an Array of the arguments if multiple arguments are given" do
    expect(p("p printed this line", "and this one")).to eq(["p printed this line", "and this one"])
  end
end

context "Kernel#pp" do
  specify "lazily loads the 'pp' library and delegates the call to that library" do
    expect(pp([1, 2, 3])).to eq([1, 2, 3])
  end
end

context "Kernel#print" do
  specify "delegates to $stdout" do
    expect(print("print wrote this line itself\n")).to be_nil
  end
end

context "Kernel#putc" do
  describe "with an Integer argument" do
    specify "writes one character as a String" do
      expect(putc(10)).to eq(10)
    end

    specify "writes the low byte as a String" do
      expect(putc(0x240a)).to eq(0x240a)
    end
  end

  describe "with a String argument" do
    specify "writes one character" do
      expect(putc("\n")).to eq("\n")
    end

    specify "writes the first character" do
      expect(putc("\nRuby")).to eq("\nRuby")
    end
  end
end

context "Kernel#printf" do
  specify "writes to stdout when a string is the first argument" do
    expect(printf("%s wrote this line itself\n", "printf")).to be_nil
  end
end

context "Kernel#warn" do
  specify "accepts multiple arguments" do
    expect(warn("warn wrote this line to standard error", "and this one")).to be_nil
  end

  specify "does not write strings when passed no arguments" do
    expect(warn).to be_nil
  end

  specify "writes each array element on a line when passes an array" do
    expect(warn(["warn wrote this line to standard error", "and this one"])).to be_nil
  end
end
