# `JSON.generate` and `JSON.pretty_generate` (ADR 0072): the json gem's text
# — its float writer, its escapes, its two-space pretty form — with NaN and
# Infinity as failures, and a struct or range refusing where Ruby writes
# garbage. The gem's answers, verified against Ruby 4.0.7, recorded in #182.

require_relative "../spec_helper"

context "JSON.generate" do
  specify "writes every JSON type compactly" do
    expect(JSON.generate({"a" => 1, "b" => [true, false, nil], "c" => "x", "d" => 2.5})).to eq("{\"a\":1,\"b\":[true,false,null],\"c\":\"x\",\"d\":2.5}")
  end

  specify "writes floats as the gem does, not as to_s does" do
    expect(JSON.generate([1.0, 0.1, 1e20, 1.5e-7, 1e-5, 100.0, -0.0, 1e-10, 5e-324])).to eq("[1.0,0.1,1e+20,0.00000015,0.00001,100.0,-0.0,1e-10,5e-324]")
    expect(JSON.generate(123456789012345680.0)).to eq("1.2345678901234568e+17")
  end

  specify "escapes the quote, the backslash, and the controls, and nothing else" do
    expect(JSON.generate("é\n\t\"\\/")).to eq("\"é\\n\\t\\\"\\\\/\"")
    controls = 1.chr + 127.chr + 0x2028.chr(Encoding::UTF_8)
    expect(JSON.generate(controls)).to eq("\"\\u0001" + 127.chr + 0x2028.chr(Encoding::UTF_8) + "\"")
  end

  specify "writes a symbol as a string, and a hash's keys as strings" do
    expect(JSON.generate(:sym)).to eq("\"sym\"")
    expect(JSON.generate({a: 1, 1 => 2, 1.5 => 3, nil => 4, true => 5})).to eq("{\"a\":1,\"1\":2,\"1.5\":3,\"\":4,\"true\":5}")
  end

  specify "keeps empties as [] and {}" do
    expect(JSON.generate([[], {}, [[]], {"a" => {}}])).to eq("[[],{},[[]],{\"a\":{}}]")
  end

  specify "fails on NaN and Infinity" do
    expect(inspect(JSON.generate(0.0 / 0.0))).to eq("failure(\"NaN not allowed in JSON\")")
    expect(inspect(JSON.generate([1, 1.0 / 0.0]))).to eq("failure(\"Infinity not allowed in JSON\")")
    expect(inspect(JSON.generate(-1.0 / 0.0))).to eq("failure(\"-Infinity not allowed in JSON\")")
  end

  specify "fails past 100 nested containers, empties included" do
    mutable deep = []
    99.times { deep = [deep] }
    expect(JSON.generate(deep).length).to eq(200)
    expect(inspect(JSON.generate([deep]))).to eq("failure(\"nesting of 101 is too deep. Did you try to serialize objects with circular references?\")")
  end
end

context "JSON.pretty_generate" do
  specify "indents by two spaces, with a space after each colon" do
    expected = "{\n  \"a\": [\n    1,\n    {\n      \"b\": null\n    }\n  ]\n}"
    expect(JSON.pretty_generate({"a" => [1, {"b" => nil}]})).to eq(expected)
  end

  specify "keeps empties as [] and {}, and scalars alone" do
    expect(JSON.pretty_generate({"a" => {}, "b" => []})).to eq("{\n  \"a\": {},\n  \"b\": []\n}")
    expect(JSON.pretty_generate(1)).to eq("1")
    expect(JSON.pretty_generate([])).to eq("[]")
  end

  specify "round-trips through parse" do
    document = {"name" => "pdx", "tags" => ["a", "b"], "count" => 3, "ratio" => 0.5, "none" => nil}
    expect(JSON.parse(JSON.pretty_generate(document))).to eq(document)
    expect(JSON.parse(JSON.generate(document))).to eq(document)
  end
end
