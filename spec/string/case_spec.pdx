# `upcase` and `downcase` answer new strings; the receiver is untouched.
#
# The rows below the house examples are from ruby/spec
# core/string/{upcase,downcase,capitalize,swapcase}_spec.rb. Casing is full
# Unicode, locale-independent (ADR 0038), so the :ascii, :turkic,
# :lithuanian, and :fold options are decided out (fold lives in casecmp?);
# the bang forms (ADR 0015), subclasses, encodings, and ascii_only? stay
# upstream. downcase's Kelvin-sign row spells it with a \u escape Portland
# does not have.

require_relative "../spec_helper"

context "String" do
  city = "portland"

  describe "#upcase" do
    specify "raises every letter" do
      expect(city.upcase).to eq("PORTLAND")
    end
  end

  describe "#downcase" do
    specify "lowers every letter, round-tripping the upcase" do
      expect(city.upcase.downcase).to eq("portland")
    end
  end

  describe "the other case moves" do
    specify "String#capitalize moves both ways — first up, the rest down" do
      expect("portland".capitalize).to eq("Portland")
      expect("PDX".capitalize).to eq("Pdx")
    end

    specify "String#swapcase flips every letter" do
      expect("PdX".swapcase).to eq("pDx")
    end
  end
end

context "String#upcase" do
  specify "returns a copy of self with all lowercase letters upcased" do
    expect("Hello".upcase).to eq("HELLO")
    expect("hello".upcase).to eq("HELLO")
  end

  describe "full Unicode case mapping" do
    specify "works for all of Unicode with no option" do
      expect("äöü".upcase).to eq("ÄÖÜ")
    end

    specify "updates string metadata" do
      upcased = "aßet".upcase
      expect(upcased).to eq("ASSET")
      expect(upcased.size).to eq(5)
      expect(upcased.bytesize).to eq(5)
    end
  end
end

context "String#downcase" do
  specify "returns a copy of self with all uppercase letters downcased" do
    expect("hELLO".downcase).to eq("hello")
    expect("hello".downcase).to eq("hello")
  end

  describe "full Unicode case mapping" do
    specify "works for all of Unicode with no option" do
      expect("ÄÖÜ".downcase).to eq("äöü")
    end
  end

  describe "case folding" do
    specify "case folds special characters" do
      expect("ß".downcase).to eq("ß")
    end
  end
end

context "String#capitalize" do
  specify "returns a copy of self with the first character converted to uppercase and the remainder to lowercase" do
    expect("".capitalize).to eq("")
    expect("h".capitalize).to eq("H")
    expect("H".capitalize).to eq("H")
    expect("hello".capitalize).to eq("Hello")
    expect("HELLO".capitalize).to eq("Hello")
    expect("123ABC".capitalize).to eq("123abc")
    expect("abcdef"[1...-1].capitalize).to eq("Bcde")
  end

  describe "full Unicode case mapping" do
    specify "works for all of Unicode with no option" do
      expect("äöÜ".capitalize).to eq("Äöü")
    end

    specify "only capitalizes the first resulting character when upcasing a character produces a multi-character sequence" do
      expect("ß".capitalize).to eq("Ss")
    end

    specify "updates string metadata" do
      capitalized = "ßeT".capitalize
      expect(capitalized).to eq("Sset")
      expect(capitalized.size).to eq(4)
      expect(capitalized.bytesize).to eq(4)
    end
  end
end

context "String#swapcase" do
  specify "returns a new string with all uppercase chars from self converted to lowercase and vice versa" do
    expect("Hello".swapcase).to eq("hELLO")
    expect("cYbEr_PuNk11".swapcase).to eq("CyBeR_pUnK11")
    expect("+++---111222???".swapcase).to eq("+++---111222???")
  end

  describe "full Unicode case mapping" do
    specify "works for all of Unicode with no option" do
      expect("äÖü".swapcase).to eq("ÄöÜ")
    end

    specify "updates string metadata" do
      swapcased = "Aßet".swapcase
      expect(swapcased).to eq("aSSET")
      expect(swapcased.size).to eq(5)
      expect(swapcased.bytesize).to eq(5)
    end
  end
end
