# `empty?` — the question every collection answers.

require_relative "../spec_helper"

context "String" do
  describe "#empty?" do
    specify "holds for the empty string" do
      expect("").to be_empty
    end

    specify "and for nothing else, a single space included" do
      expect(" ").not_to be_empty
      expect("pdx").not_to be_empty
    end
  end
end

# From ruby/spec core/string/empty_spec.rb; the NUL and subclass rows stay
# upstream.
context "String#empty?" do
  specify "returns true if the string has a length of zero" do
    expect("hello").not_to be_empty
    expect(" ").not_to be_empty
    expect("").to be_empty
  end
end
