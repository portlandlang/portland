# Finding and counting inside a string — held pending where owed, noted
# where blocked (#23).
#
# From ruby/spec core/string/{index,count,lines}_spec.rb. `sub` and `gsub`
# stay behind with regex, which is undecided and a real hole — even their
# plain-string arities lead straight to the pattern question.

require_relative "../spec_helper"

context "String" do
  describe "the searches" do
    pending "String#index of a substring — no builtin yet; a maybe" do
      expect("portland".index("land")).to eq(4)
      expect("portland".index("rose")).to be_nil
    end

    pending "String#count — no builtin yet" do
      expect("banana".count("a")).to eq(3)
    end

    pending "String#lines — no builtin yet; keeps the newlines" do
      expect("a\nb\n".lines).to eq(["a\n", "b\n"])
    end
  end
end
