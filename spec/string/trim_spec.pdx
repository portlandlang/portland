# The whitespace trimmers.
#
# From ruby/spec core/string/{strip,lstrip,rstrip,chomp}_spec.rb.

require_relative "../spec_helper"

context "String" do
  describe "the trimmers" do
    specify "String#strip takes whitespace off both ends" do
      expect("  rose  ".strip).to eq("rose")
    end

    specify "String#lstrip and #rstrip take one end each" do
      expect("  rose".lstrip).to eq("rose")
      expect("rose  ".rstrip).to eq("rose")
    end

    specify "String#chomp takes one trailing line ending, crlf as a unit" do
      expect("rose\n".chomp).to eq("rose")
      expect("rose\r\n".chomp).to eq("rose")
      expect("rose".chomp).to eq("rose")
    end
  end
end
