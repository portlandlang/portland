# `tr`, `tr_s`, `delete`, and `squeeze` read their arguments as lists of
# literal characters (ADR 0088): each character stands for itself, with
# Ruby's rules for everything an argument means without set syntax — the
# to-list padded with its last character, the last occurrence winning, an
# empty to-list deleting, `tr_s` squeezing what it translated, several
# lists to `delete` and `squeeze` intersecting.
#
# From ruby/spec core/string/{tr,tr_s,delete,squeeze}_spec.rb. Upstream:
# the range, negation, and escape rows, which refuse naming the `gsub` that
# says the same (pinned by a two-oracle test); the bang forms (ADR 0015);
# Ruby 4.1's hash form of `tr`; `to_str` mocks; the subclass, broken
# encoding, and US-ASCII or UTF-16 rows (one UTF-8 String type, ADR 0069).

require_relative "../spec_helper"

context "String#tr" do
  specify "returns a new string with the characters from from_string replaced by the ones in to_string" do
    expect("hello".tr("aeiou", "*")).to eq("h*ll*")
    expect("hello".tr("el", "ip")).to eq("hippo")
    expect("Lisp".tr("Lisp", "Ruby")).to eq("Ruby")
  end

  specify "pads to_str with its last char if it is shorter than from_string" do
    expect("this".tr("this", "x")).to eq("xxxx")
  end

  specify "returns self (or a copy) when from_string or to_string is empty" do
    expect("hello".tr("", "a")).to eq("hello")
    expect("hello".tr("a", "")).to eq("hello")
    expect("hello".tr("", "")).to eq("hello")
  end

  specify "supports non-injective replacements" do
    expect("hello".tr("helo", "1212")).to eq("12112")
  end

  specify "reads a lone ^ and a - at either end as themselves" do
    expect("hello ^_^".tr("^", "x")).to eq("hello x_x")
    expect("hello ^-^".tr("e-", "__")).to eq("h_llo ^_^")
    expect("hello ^-^".tr("-e", "_a")).to eq("hallo ^_^")
  end

  specify "can replace a 7-bit ASCII character with a multibyte one" do
    expect("uber".tr("u", "ü")).to eq("über")
  end

  specify "can replace a multibyte character with a single byte one" do
    expect("über".tr("ü", "u")).to eq("uber")
  end

  specify "deletes the characters in from_str if to_str is empty" do
    expect("hello".tr("el", "")).to eq("ho")
  end
end

context "String#tr_s" do
  specify "returns a string processed according to tr with newly duplicate characters removed" do
    expect("hello".tr_s("l", "r")).to eq("hero")
    expect("hello".tr_s("el", "*")).to eq("h*o")
    expect("hello".tr_s("el", "hx")).to eq("hhxo")
    expect("hello".tr_s("o", ".")).to eq("hell.")
  end

  specify "pads to_str with its last char if it is shorter than from_string" do
    expect("this".tr_s("this", "x")).to eq("x")
  end

  specify "returns self (or a copy) when from_string or to_string is empty" do
    expect("hello".tr_s("", "a")).to eq("hello")
    expect("hello".tr_s("a", "")).to eq("hello")
    expect("hello".tr_s("", "")).to eq("hello")
  end

  specify "can replace 7-bit ASCII characters with a multibyte one" do
    expect("uber".tr_s("u", "ü")).to eq("über")
    expect("uuuber".tr_s("u", "ü")).to eq("über")
  end

  specify "can replace multibyte characters with a single byte one" do
    expect("über".tr_s("ü", "u")).to eq("uber")
    expect("üüüber".tr_s("ü", "u")).to eq("uber")
  end

  specify "deletes the characters in from_str and does not squeeze the result if to_str is empty" do
    expect("hello".tr_s("el", "")).to eq("ho")
    expect("hellooo".tr_s("el", "")).to eq("hooo")
  end
end

context "String#delete" do
  specify "returns a new string with the chars from the intersection of sets removed" do
    text = "hello"
    expect(text.delete("lo")).to eq("he")
    expect(text).to eq("hello")
    expect("hello".delete("l", "lo")).to eq("heo")
    expect("hell yeah".delete("")).to eq("hell yeah")
  end

  specify "reads a lone ^ and a - at either end as themselves" do
    expect("hello".delete("^")).to eq("hello")
    expect("oa^_^o".delete("a^")).to eq("o_o")
    expect("hel-lo".delete("e-")).to eq("hllo")
    expect("hel-lo".delete("-h")).to eq("ello")
  end

  specify "deletes multibyte characters" do
    expect("四月".delete("月")).to eq("四")
    expect("哥哥我倒".delete("哥")).to eq("我倒")
  end

  specify "deletes the intersection of several lists" do
    expect("hello world".delete("lo", "o")).to eq("hell wrld")
  end
end

context "String#squeeze" do
  specify "returns new string where runs of the same character are replaced by a single character when no args are given" do
    expect("yellow moon".squeeze).to eq("yelow mon")
    expect("".squeeze).to eq("")
  end

  specify "only squeezes chars that are in the intersection of all sets given" do
    expect("woot squeeze cheese".squeeze("eost", "queo")).to eq("wot squeze chese")
    expect("  now   is  the".squeeze(" ")).to eq(" now is the")
    expect("hello".squeeze("")).to eq("hello")
    expect("hello room".squeeze("lo", "o")).to eq("hello rom")
  end

  specify "reads a lone ^ and a - at either end as themselves" do
    text = "<<subbookkeeper!!!>>"
    expect(text.squeeze("^")).to eq(text)
    expect("((^^__^^))".squeeze("_^")).to eq("((^_^))")
    expect("--subbookkeeper--".squeeze("e-")).to eq("-subbookkeper-")
    expect("--subbookkeeper--".squeeze("-e")).to eq("-subbookkeper-")
  end
end
