# `String#=~`, `#match`, and `#match?` (ADR 0086): a pattern, or a string
# read as one, matched against the text; `=~` and `match` answer the
# MatchData or nil, positions counted in characters.
#
# From ruby/spec core/string/match_spec.rb. Upstream: `=~` answering an
# index — it answers the match here, so its rows ask the match's `begin`;
# every `$~` and `Regexp.last_match` row (the match globals are gone); the
# block form of `match` (#215); `to_str`, `method_missing`, and `=~`-object
# mocks; and the Regexp-subclass row. A pattern that is neither a Regexp nor
# a String refuses in Ruby's words, `wrong argument type Integer (expected
# Regexp)`, pinned by a two-oracle test.

require_relative "../spec_helper"

context "String#=~" do
  specify "finds what index finds when given a regexp" do
    expect(("rudder" =~ /udder/).begin(0)).to eq("rudder".index(/udder/))
    expect(("boat" =~ /[^fl]oat/).begin(0)).to eq("boat".index(/[^fl]oat/))
    expect("bean" =~ /bag/).to be_nil
    expect("bean".index(/bag/)).to be_nil
  end

  specify "returns the character index of a found match" do
    expect(("こにちわ" =~ /に/).begin(0)).to eq(1)
  end
end

context "String#match" do
  specify "matches the pattern against self" do
    found = "hello".match(/(.)\1/) or panic("no match")
    expect(found[0]).to eq("ll")
  end

  specify "matches a literal Regexp that uses ASCII-only UTF-8 escape sequences" do
    found = "a b".match(/([\u{20}-\u{7e}])/) or panic("no match")
    expect(found[0]).to eq("a")
  end

  specify "matches from a positive position" do
    found = "01234".match(/(.).(.)/, 1) or panic("no match")
    expect(found.captures).to eq(["1", "3"])
  end

  specify "uses the position as a character offset" do
    found = "零一二三四".match(/(.).(.)/, 1) or panic("no match")
    expect(found.captures).to eq(["一", "三"])
  end

  specify "matches from a negative position" do
    found = "01234".match(/(.).(.)/, -4) or panic("no match")
    expect(found.captures).to eq(["1", "3"])
    far = "零一二三四".match(/(.).(.)/, -4) or panic("no match")
    expect(far.captures).to eq(["一", "三"])
  end

  specify "converts string patterns to regexps without escaping" do
    found = "hello".match("(.)\\1") or panic("no match")
    expect(found[0]).to eq("ll")
  end

  specify "returns nil if there's no match" do
    expect("hello".match("xx")).to be_nil
  end

  specify "matches \\G at the start of the string" do
    found = "hello".match(/\Gh/) or panic("no match")
    expect(found[0]).to eq("h")
    expect("hello".match(/\Go/)).to be_nil
  end
end

context "String#match?" do
  specify "returns true when it matches the given regex" do
    expect("string".match?(/string/i)).to be_true
  end

  specify "returns false when it does not match the given regex" do
    expect("string".match?(/STRING/)).to be_false
  end

  specify "takes the matching position as the second argument" do
    expect("string".match?(/str/i, 0)).to be_true
    expect("string".match?(/str/i, 1)).to be_false
  end
end
