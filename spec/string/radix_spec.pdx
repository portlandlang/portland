# Reading a string as a number in another base (#106), from ruby/spec
# core/string/{hex,oct}_spec.rb. Ruby's octal literals (077) are written
# with Portland's 0o prefix (docs/ruby/integer-literals.md); `oct` still
# reads a 0d prefix in the text, as Ruby's does.

require_relative "../spec_helper"

context "String#hex" do
  specify "treats leading characters of self as a string of hex digits" do
    expect("0a".hex).to eq(10)
    expect("0o".hex).to eq(0)
    expect("0x".hex).to eq(0)
    expect("A_BAD_BABE".hex).to eq(0xABADBABE)
    expect("0b1010".hex).to eq("b1010".hex)
    expect("0d500".hex).to eq("d500".hex)
    expect("abcdefG".hex).to eq(0xabcdef)
  end

  specify "does not accept a sequence of underscores as part of a number" do
    expect("a__b".hex).to eq(0xa)
    expect("a____b".hex).to eq(0xa)
    expect("a___f".hex).to eq(0xa)
  end

  specify "takes an optional sign" do
    expect("-1234".hex).to eq(-4660)
    expect("+1234".hex).to eq(4660)
  end

  specify "takes an optional 0x" do
    expect("0x0a".hex).to eq(10)
    expect("0a".hex).to eq(10)
  end

  specify "requires that the sign is in front of the 0x if present" do
    expect("-0x1".hex).to eq(-1)
    expect("0x-1".hex).to eq(0)
  end

  specify "returns 0 on error" do
    expect("".hex).to eq(0)
    expect("+-5".hex).to eq(0)
    expect("wombat".hex).to eq(0)
    expect("0x0x42".hex).to eq(0)
  end

  specify "returns 0 if sequence begins with underscore" do
    expect("_a".hex).to eq(0)
    expect("___b".hex).to eq(0)
    expect("___0xc".hex).to eq(0)
  end
end

context "String#oct" do
  specify "treats numeric digits as base-8 digits by default" do
    expect("0".oct).to eq(0)
    expect("77".oct).to eq(0o77)
    expect("077".oct).to eq(0o77)
  end

  specify "accepts numbers formatted as binary" do
    expect("0b1010".oct).to eq(0b1010)
  end

  specify "accepts numbers formatted as hexadecimal" do
    expect("0xFF".oct).to eq(0xFF)
  end

  specify "accepts numbers formatted as decimal" do
    expect("0d500".oct).to eq(500)
  end

  describe "with a leading minus sign" do
    specify "treats numeric digits as base-8 digits by default" do
      expect("-12348".oct).to eq(-0o1234)
    end

    specify "accepts numbers formatted as binary" do
      expect("-0b0101".oct).to eq(-0b0101)
    end

    specify "accepts numbers formatted as hexadecimal" do
      expect("-0xEE".oct).to eq(-0xEE)
    end

    specify "accepts numbers formatted as decimal" do
      expect("-0d500".oct).to eq(-500)
    end
  end

  describe "with a leading plus sign" do
    specify "treats numeric digits as base-8 digits by default" do
      expect("+12348".oct).to eq(0o1234)
    end

    specify "accepts numbers formatted as binary" do
      expect("+0b1010".oct).to eq(0b1010)
    end

    specify "accepts numbers formatted as hexadecimal" do
      expect("+0xFF".oct).to eq(0xFF)
    end

    specify "accepts numbers formatted as decimal" do
      expect("+0d500".oct).to eq(500)
    end
  end

  specify "accepts a single underscore separating digits" do
    expect("755_333".oct).to eq(0o755_333)
  end

  specify "does not accept a sequence of underscores as part of a number" do
    expect("7__3".oct).to eq(0o7)
    expect("7___3".oct).to eq(0o7)
    expect("7__5".oct).to eq(0o7)
  end

  specify "ignores characters that are incorrect for the base-8 digits" do
    expect("0o".oct).to eq(0)
    expect("5678".oct).to eq(0o567)
  end

  specify "returns 0 if no characters can be interpreted as a base-8 number" do
    expect("".oct).to eq(0)
    expect("+-5".oct).to eq(0)
    expect("wombat".oct).to eq(0)
  end

  specify "returns 0 for strings with leading underscores" do
    expect("_7".oct).to eq(0)
    expect("_07".oct).to eq(0)
    expect(" _7".oct).to eq(0)
  end
end

# `to_i` by Ruby's rule (ADR 0061), which never fails: leading whitespace,
# one sign, the base's prefix, digits with single underscores between
# them, and 0 when nothing parses. From ruby/spec core/string/to_i_spec.rb.
# What stays behind: the long strings and the base-36 round trips past
# 2**63 (integers are 64-bit, #156), the to_int base (a mock), and the
# illegal bases, which refuse in Ruby's words and are pinned by a
# two-oracle test.
context "String#to_i" do
  specify "returns 0 for strings with leading underscores" do
    expect("_123".to_i).to eq(0)
  end

  specify "ignores underscores in between the digits" do
    expect("1_2_3asdf".to_i).to eq(123)
  end

  specify "ignores multiple non-consecutive underscores when the first digit is 0" do
    (2..16).each do |base|
      expect("0_0_010".to_i(base)).to eq(base)
    end
  end

  specify "bails out at the first double underscore if the first digit is 0" do
    (2..16).each do |base|
      expect("010__1".to_i(base)).to eq(base)
    end
  end

  specify "ignores leading whitespaces" do
    [" 123", "     123", "\r\n\r\n123", "\t\t123", "\r\n\t\n123", " \t\n\r\t 123"].each do |text|
      expect(text.to_i).to eq(123)
    end
  end

  specify "ignores subsequent invalid characters" do
    expect("123asdf".to_i).to eq(123)
    expect("123#123".to_i).to eq(123)
    expect("123 456".to_i).to eq(123)
  end

  specify "returns 0 if self is no valid integer-representation" do
    ["++2", "+-2", "--2"].each do |text|
      expect(text.to_i).to eq(0)
    end
  end

  specify "accepts '+' at the beginning of a String" do
    expect("+0d56".to_i).to eq(56)
  end

  specify "interprets leading characters as a number in the given base" do
    expect("100110010010".to_i(2)).to eq(0b100110010010)
    expect("100110201001".to_i(3)).to eq(186409)
    expect("103110201001".to_i(4)).to eq(5064769)
    expect("103110241001".to_i(5)).to eq(55165126)
    expect("153110241001".to_i(6)).to eq(697341529)
    expect("153160241001".to_i(7)).to eq(3521513430)
    expect("153160241701".to_i(8)).to eq(14390739905)
    expect("853160241701".to_i(9)).to eq(269716550518)
    expect("853160241791".to_i(10)).to eq(853160241791)

    expect("F00D_BE_1337".to_i(16)).to eq(0xF00D_BE_1337)
    expect("-hello_world".to_i(32)).to eq(-18306744)
    expect("abcXYZ".to_i(36)).to eq(623741435)

    expect("5e10".to_i).to eq(5)
  end

  specify "auto-detects base 8 via leading 0 when base = 0" do
    expect("01778".to_i(0)).to eq(0o177)
    expect("-01778".to_i(0)).to eq(-0o177)
  end

  specify "auto-detects base 2 via 0b when base = 0" do
    expect("0b112".to_i(0)).to eq(0b11)
    expect("-0b112".to_i(0)).to eq(-0b11)
  end

  specify "auto-detects base 10 via 0d when base = 0" do
    expect("0d19A".to_i(0)).to eq(19)
    expect("-0d19A".to_i(0)).to eq(-19)
  end

  specify "auto-detects base 8 via 0o when base = 0" do
    expect("0o178".to_i(0)).to eq(0o17)
    expect("-0o178".to_i(0)).to eq(-0o17)
  end

  specify "auto-detects base 16 via 0x when base = 0" do
    expect("0xFAZ".to_i(0)).to eq(0xFA)
    expect("-0xFAZ".to_i(0)).to eq(-0xFA)
  end

  specify "auto-detects base 10 with no base specifier when base = 0" do
    expect("1234567890ABC".to_i(0)).to eq(1234567890)
    expect("-1234567890ABC".to_i(0)).to eq(-1234567890)
  end

  specify "doesn't handle foreign base specifiers when base is > 0" do
    [2, 3, 4, 8, 10].each do |base|
      expect("0111".to_i(base)).to eq("111".to_i(base))

      expect("0b11".to_i(base)).to eq(base == 2 ? 0b11 : 0)
      expect("0d11".to_i(base)).to eq(base == 10 ? 11 : 0)
      expect("0o11".to_i(base)).to eq(base == 8 ? 0o11 : 0)
      expect("0xFA".to_i(base)).to eq(0)
    end

    expect("0xD00D".to_i(16)).to eq(0xD00D)

    expect("0b11".to_i(16)).to eq(0xb11)
    expect("0d11".to_i(16)).to eq(0xd11)
    expect("0o11".to_i(25)).to eq(15026)
    expect("0x11".to_i(34)).to eq(38183)

    expect("0B11".to_i(16)).to eq(0xb11)
    expect("0D11".to_i(16)).to eq(0xd11)
    expect("0O11".to_i(25)).to eq(15026)
    expect("0X11".to_i(34)).to eq(38183)
  end

  specify "requires that the sign if any appears before the base specifier" do
    expect("0b-1".to_i(2)).to eq(0)
    expect("0d-1".to_i(10)).to eq(0)
    expect("0o-1".to_i(8)).to eq(0)
    expect("0x-1".to_i(16)).to eq(0)
  end

  specify "returns an Integer for long strings with trailing spaces" do
    expect("0                             ".to_i).to eq(0)
    expect("10                             ".to_i).to eq(10)
    expect("-10                            ".to_i).to eq(-10)
  end

  specify "returns an Integer for long strings with leading spaces" do
    expect("                             0".to_i).to eq(0)
    expect("                             10".to_i).to eq(10)
    expect("                            -10".to_i).to eq(-10)
  end
end

context "String#to_i with bases" do
  specify "parses a String in base 2" do
    text = "10" * 30
    expect(text.to_i(2).to_s(2)).to eq(text)
  end

  specify "parses a String in base 8" do
    text = "12345670" * 2
    expect(text.to_i(8).to_s(8)).to eq(text)
  end

  specify "parses a String in base 16" do
    text = "1234567890abcdef"
    expect(text.to_i(16).to_s(16)).to eq(text)
  end

  specify "parses a String in base 36" do
    text = "1234567890ab"
    expect(text.to_i(36).to_s(36)).to eq(text)
  end
end
