# What a set holds (ADR 0082): membership by `eql?` under `include?`,
# `member?`, and `===`; `size`, `length`, and `empty?`; and `add` and
# `delete`, which answer a new set and leave the receiver as it was.
#
# From ruby/spec core/set/{include,member,case_compare,size,length,empty,
# add,delete}_spec.rb. Upstream: the alias checks (method objects), the
# objects defining hash and eql? by hand, the rows where add and delete
# answer the receiver itself, and add? and delete?, which mutate (ADR 0015).

require_relative "../spec_helper"

context "Set" do
  describe "#include?" do
    specify "answers whether self holds the value" do
      members = Set[:a, :b, :c]
      expect(members.include?(:a)).to be_true
      expect(members.include?(:e)).to be_false
    end

    specify "matches by eql?, not ==" do
      expect(Set[1].include?(1.0)).to be_false
      expect(Set[1.0].include?(1.0)).to be_true
    end

    specify "is also member?" do
      expect(Set[:a].member?(:a)).to be_true
      expect(Set[:a].member?(:b)).to be_false
    end
  end

  describe "===" do
    specify "is membership under when" do
      held = case 2
      when Set[1, 2] then "held"
      else "missed"
      end
      expect(held).to eq("held")
      missed = case 3
      when Set[1, 2] then "held"
      else "missed"
      end
      expect(missed).to eq("missed")
    end
  end

  describe "#size" do
    specify "counts the members, as length does" do
      expect(Set[:a, :b, :c].size).to eq(3)
      expect(Set[:a, :b, :c].length).to eq(3)
      expect(Set[].size).to eq(0)
    end
  end

  describe "#empty?" do
    specify "is true only with no members" do
      expect(Set[].empty?).to be_true
      expect(Set[1].empty?).to be_false
      expect(Set[1, 2, 3].empty?).to be_false
    end
  end

  describe "#add" do
    specify "answers a set holding the value too" do
      before = Set.new
      after = before.add("dog")
      expect(after).to contain("dog")
      expect(after.size).to eq(1)
    end

    specify "leaves the receiver as it was" do
      before = Set[1]
      after = before.add(2)
      expect(before).to eq(Set[1])
      expect(after).to eq(Set[1, 2])
    end

    specify "answers an equal set when the value is already held" do
      expect(Set[1, 2].add(2)).to eq(Set[1, 2])
    end
  end

  describe "#delete" do
    specify "answers a set without the value" do
      before = Set["a", "b", "c"]
      after = before.delete("a")
      expect(after.include?("a")).to be_false
      expect(after).to eq(Set["b", "c"])
    end

    specify "leaves the receiver as it was, and an absent value changes nothing" do
      before = Set["a", "b", "c"]
      expect(before.delete("x")).to eq(before)
      expect(before).to eq(Set["a", "b", "c"])
    end
  end
end
