# The subset family (ADR 0082): `subset?`/`<=`, `superset?`/`>=`,
# `proper_subset?`/`<`, `proper_superset?`/`>`, each taking a set; `<=>` as
# 0, -1, 1, or nil by the same relations; and `disjoint?` and `intersect?`
# over any enumerable.
#
# From ruby/spec core/set/{subset,superset,proper_subset,proper_superset,
# lte,gte,lt,gt,comparison,disjoint,intersect}_spec.rb. Upstream: the alias
# checks, the Set-like objects, the rows that raise on a non-set — that
# refusal is pinned by the two-oracle test — and `<=>` against a non-set,
# which the checker refuses at build where the types are known.

require_relative "../spec_helper"

context "Set" do
  four = Set[1, 2, 3, 4]

  describe "#subset?" do
    specify "is true for an equal set and for one holding every member" do
      expect(four.subset?(four)).to be_true
      expect(Set[].subset?(Set[])).to be_true
      expect(Set[].subset?(four)).to be_true
      expect(Set[].subset?(Set["a", :b, "c"])).to be_true
      expect(Set[1, 2, 3].subset?(four)).to be_true
      expect(Set[1, 3].subset?(four)).to be_true
      expect(Set[1].subset?(four)).to be_true
      expect(Set[5].subset?(four)).to be_false
      expect(Set[1, 5].subset?(four)).to be_false
      expect(Set["test"].subset?(four)).to be_false
    end

    specify "is also <=" do
      expect(Set[1, 2] <= four).to be_true
      expect(four <= four).to be_true
      expect(Set[5] <= four).to be_false
    end
  end

  describe "#superset?" do
    specify "is true for an equal set and for one whose every member self holds" do
      expect(four.superset?(four)).to be_true
      expect(Set[].superset?(Set[])).to be_true
      expect(four.superset?(Set[])).to be_true
      expect(Set["a", :b, "c"].superset?(Set[])).to be_true
      expect(four.superset?(Set[1, 2, 3])).to be_true
      expect(four.superset?(Set[1, 3])).to be_true
      expect(four.superset?(Set[1])).to be_true
      expect(four.superset?(Set[5])).to be_false
      expect(four.superset?(Set[1, 5])).to be_false
      expect(four.superset?(Set["test"])).to be_false
    end

    specify "is also >=" do
      expect(four >= Set[1, 2]).to be_true
      expect(four >= four).to be_true
      expect(four >= Set[5]).to be_false
    end
  end

  describe "#proper_subset?" do
    specify "is true for a set holding every member and more" do
      expect(Set[].proper_subset?(four)).to be_true
      expect(Set[].proper_subset?(Set["a", :b, "c"])).to be_true
      expect(Set[1, 2, 3].proper_subset?(four)).to be_true
      expect(Set[1, 3].proper_subset?(four)).to be_true
      expect(Set[1].proper_subset?(four)).to be_true
      expect(Set[5].proper_subset?(four)).to be_false
      expect(Set[1, 5].proper_subset?(four)).to be_false
      expect(Set["test"].proper_subset?(four)).to be_false
      expect(four.proper_subset?(four)).to be_false
      expect(Set[].proper_subset?(Set[])).to be_false
    end

    specify "is also <" do
      expect(Set[1, 2] < four).to be_true
      expect(four < four).to be_false
    end
  end

  describe "#proper_superset?" do
    specify "is true for a set whose every member self holds, and more" do
      expect(four.proper_superset?(Set[])).to be_true
      expect(Set["a", :b, "c"].proper_superset?(Set[])).to be_true
      expect(four.proper_superset?(Set[1, 2, 3])).to be_true
      expect(four.proper_superset?(Set[1, 3])).to be_true
      expect(four.proper_superset?(Set[1])).to be_true
      expect(four.proper_superset?(Set[5])).to be_false
      expect(four.proper_superset?(Set[1, 5])).to be_false
      expect(four.proper_superset?(Set["test"])).to be_false
      expect(four.proper_superset?(four)).to be_false
      expect(Set[].proper_superset?(Set[])).to be_false
    end

    specify "is also >" do
      expect(four > Set[1, 2]).to be_true
      expect(four > four).to be_false
    end
  end

  describe "#<=>" do
    specify "is 0 for equal sets" do
      expect(Set[] <=> Set[]).to eq(0)
      expect(Set[:a, :b, :c] <=> Set[:a, :b, :c]).to eq(0)
    end

    specify "is -1 for a proper subset and 1 for a proper superset" do
      expect(Set[] <=> Set[1]).to eq(-1)
      expect(Set[1, 2] <=> Set[1, 2, 3]).to eq(-1)
      expect(Set[1] <=> Set[]).to eq(1)
      expect(Set[1, 2, 3] <=> Set[1, 2]).to eq(1)
    end

    specify "is nil for sets each with members of their own" do
      expect(Set[1, 2, 3] <=> Set[:a, :b, :c]).to be_nil
      expect(Set[1, 2] <=> Set[2, 3]).to be_nil
    end
  end

  describe "#disjoint? and #intersect?" do
    specify "tell whether the two share a member" do
      expect(Set[1, 2].intersect?(Set[2, 3])).to be_true
      expect(Set[1, 2].intersect?(Set[3, 4])).to be_false
      expect(Set[1, 2].disjoint?(Set[2, 3])).to be_false
      expect(Set[1, 2].disjoint?(Set[3, 4])).to be_true
    end

    specify "take any enumerable" do
      expect(Set[1, 2].intersect?([2])).to be_true
      expect(Set[1, 2].disjoint?(3..4)).to be_true
    end
  end
end
