# Values never mutate; names do. Ruby's action-at-a-distance bug class, closed.

require_relative "spec_helper"

# ADR 0015 — values never mutate; names do. An alias cannot be spooked.
#
# The `mutable` here is safe at `describe` level, against the caveat in the
# helper, because the append happens in the setup rather than in an example:
# neither example rebinds anything, so they stay independent of each other.
describe "appending to an array" do
  mutable numbers = [1]
  alias_of = numbers
  numbers << 2

  specify "rebinds the name, leaving aliases alone" do
    expect(alias_of.length, 1)
  end

  specify "and the name itself sees the append" do
    expect(numbers.length, 2)
  end
end

# ADR 0015 — index assignment is the same rebinding sugar, so the alias rule
# holds there too. The hash spelling only, for now: `list[0] = 9` runs in the
# seed and crashes the trio's evaluator, a gap recorded the day this file
# grew; the array example goes in when the trio can run it.
describe "index assignment on a hash" do
  mutable scores = {home: 1}
  frozen_view = scores
  scores[:away] = 2

  specify "rebinds the name, leaving aliases alone" do
    expect(frozen_view.length, 1)
  end

  specify "and the name itself sees the entry" do
    expect(scores[:away], 2)
  end
end

# ADR 0001 — `mutable` gates rebinding, and every compound spelling is one.
describe "compound assignment" do
  specify "rebinds through all five operators" do
    mutable count = 10
    count += 5
    count -= 3
    count *= 2
    count /= 4
    count %= 4
    expect(count, 2)
  end

  specify "appends to a string with <<" do
    mutable line = "rose"
    line << " city"
    expect(line, "rose city")
  end
end

# ADR 0001 — parameters are binding sites too, so one can be declared mutable
# without the caller's value being any less its own.
def countdown(mutable position)
  mutable steps = []
  while position > 0
    steps << position
    position -= 1
  end
  steps
end

describe "a mutable parameter" do
  start = 3

  specify "rebinds freely inside the method" do
    expect(countdown(start), [3, 2, 1])
  end

  specify "without touching the caller's binding" do
    countdown(start)
    expect(start, 3)
  end
end

# ADR 0001 — a block rebinding an outer mutable is the accumulator pattern,
# the one licensed exception to examples staying independent (see the
# spec_helper's caveat), which is why this mutable sits inside its specify.
describe "a block over an outer mutable" do
  specify "accumulates" do
    mutable total = 0
    [1, 2, 3].each do |number|
      total += number
    end
    expect(total, 6)
  end
end
