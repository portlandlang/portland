# The hash lookups beyond `[]` — built where owed, noted where decided (#23).
#
# From ruby/spec core/hash/{dig,to_a}_spec.rb. Two upstream families are
# not holes: `fetch` is dropped forever — ADR 0010 kept its stored-nil rule
# without it, and the miss-takes-a-default spelling is the or-guard — and
# the alias cluster (`size`, `has_key?`, `include?`, `member?`) waits on
# #79's scope question: which of Ruby's alias families ship. (Synonyms
# per se are welcome — principle 3.)

require_relative "../spec_helper"

context "Hash" do
  describe "the deeper lookups" do
    specify "Hash#dig is a maybe at every step" do
      nested = {outer: {inner: 7}}
      expect(nested.dig(:outer, :inner)).to eq(7)
      expect(nested.dig(:outer, :nope)).to be_nil
    end

    specify "Hash#dig short-circuits at the first miss" do
      nested = {outer: {inner: 7}}
      expect(nested.dig(:nope, :inner)).to be_nil
    end

    specify "Hash#to_a answers pairs in insertion order" do
      expect({a: 1, b: 2}.to_a).to eq([[:a, 1], [:b, 2]])
    end
  end
end
