# The hash lookups beyond `[]` — built where owed, noted where decided (#23).
#
# From ruby/spec core/hash/{dig,to_a}_spec.rb. One upstream family is not a
# hole: `fetch` is dropped forever — ADR 0010 kept its stored-nil rule
# without it, and the miss-takes-a-default spelling is the or-guard. The
# alias cluster shipped with #79's ruling (ADR 0036): `size`, `has_key?`,
# `include?`, and `member?` are twins, pinned below.

require_relative "../spec_helper"

context "Hash" do
  describe "the deeper lookups" do
    specify "Hash#dig is a maybe at every step" do
      nested = {outer: {inner: 7}}
      expect(nested.dig(:outer, :inner)).to eq(7)
      expect(nested.dig(:outer, :nope)).to be_nil
    end

    specify "Hash#dig short-circuits at the first miss" do
      nested = {outer: {inner: 7}}
      expect(nested.dig(:nope, :inner)).to be_nil
    end

    specify "Hash#to_a answers pairs in insertion order" do
      expect({a: 1, b: 2}.to_a).to eq([[:a, 1], [:b, 2]])
    end
  end

  describe "the twins (ADR 0036)" do
    counts = {a: 1, b: 2}

    specify "size is length's" do
      expect(counts.size).to eq(2)
    end

    specify "has_key?, include?, and member? are key?'s — all four ask about keys" do
      expect(counts.has_key?(:a)).to be_true
      expect(counts.include?(:a)).to be_true
      expect(counts.member?(:a)).to be_true
      expect(counts.has_key?(:zed)).to be_false
      expect(counts.include?(:zed)).to be_false
      expect(counts.member?(:zed)).to be_false
    end
  end
end
