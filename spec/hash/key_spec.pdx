# `key?` asks without reading — which matters, because a stored nil and a
# missing key are different answers (ADR 0010).

require_relative "../spec_helper"

context "Hash" do
  describe "#key?" do
    config = {name: "pdx", port: 8080}

    specify "finds a key" do
      expect(config).to(have_key(:name))
    end

    specify "and misses one that is absent" do
      expect(config).not_to(have_key(:nope))
    end

    specify "holds for a key whose value is nil" do
      expect({note: nil}).to(have_key(:note))
    end
  end
end
