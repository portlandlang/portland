# Complex (ADR 0085): `Complex(a, b)`, `2i`, `Complex.polar`, and
# `Complex.rectangular` build a value of two real parts — integers, floats,
# or rationals — and the arithmetic, the parts, the polar form, and
# `inspect` are Ruby's: `(1+2i)`, `((1/2)+1i)`, `(1-(1/2)*i)`. Every answer
# here is Ruby 4.0.9's.
#
# From ruby/spec core/complex/{abs,abs2,arg,angle,phase,conj,conjugate,
# constants,denominator,numerator,divide,eql,equal_value,exponent,fdiv,
# finite,infinite,imag,imaginary,inspect,integer,magnitude,minus,multiply,
# plus,polar,quo,rationalize,real,rect,rectangular,to_c,to_f,to_i,to_r,to_s,
# and core/kernel/Complex_spec.rb,
# uminus}_spec.rb. Upstream: the coercion rows (#155), the mocks, the
# bignum rows (ADR 0070), hash, Marshal, and the rows asserting
# NoMethodError, which the method table answers.

require_relative "../spec_helper"

context "Complex" do
  describe "building" do
    specify "holds its two parts" do
      expect(inspect(Complex(1, 2))).to eq("(1+2i)")
      expect(inspect(Complex(1.0, 2.0))).to eq("(1.0+2.0i)")
      expect(inspect(Complex(1, -2))).to eq("(1-2i)")
      expect(inspect(Complex(1))).to eq("(1+0i)")
      expect(inspect(Complex(0, 0))).to eq("(0+0i)")
    end

    specify "has the i suffix for literals and the unit constant" do
      expect(2i).to eq(Complex(0, 2))
      expect(inspect(1.5i)).to eq("(0+1.5i)")
      expect(Complex::I).to eq(Complex(0, 1))
      expect(3.i).to eq(Complex(0, 3))
    end

    specify "comes from polar and rectangular coordinates" do
      expect(inspect(Complex.polar(1, Math::PI))).to eq("(-1+0.0i)")
      expect(inspect(Complex.polar(2, 0))).to eq("(2+0.0i)")
      expect(Complex.rectangular(1, 2)).to eq(Complex(1, 2))
    end

    specify "comes from to_c on the reals" do
      expect(inspect(3.to_c)).to eq("(3+0i)")
      expect(inspect(1.5.to_c)).to eq("(1.5+0i)")
      expect(inspect(Rational(1, 3).to_c)).to eq("((1/3)+0i)")
      expect(Complex(1, 2).to_c).to eq(Complex(1, 2))
    end
  end

  describe "arithmetic" do
    specify "adds, subtracts, and multiplies part by part" do
      expect(Complex(1, 2) + 1).to eq(Complex(2, 2))
      expect(inspect(Complex(1, 2) + 1.0)).to eq("(2.0+2i)")
      expect(inspect(1.0 + Complex(1, 2))).to eq("(2.0+2i)")
      expect(Complex(1, 2) * 2).to eq(Complex(2, 4))
      expect(Complex(1, 2) * Complex(3, 4)).to eq(Complex(-5, 10))
      expect(Complex(1, 2) - Complex(3, 4)).to eq(Complex(-2, -2))
      expect(inspect(Complex(1.5, 2.5) * Complex(1, 2))).to eq("(-3.5+5.5i)")
      expect(inspect(Complex(1, 2) + Rational(1, 2))).to eq("((3/2)+2i)")
    end

    specify "divides exactly where the parts are exact" do
      expect(inspect(Complex(1, 2) / 2)).to eq("((1/2)+1i)")
      expect(inspect(Complex(1, 2) / 2.0)).to eq("(0.5+1.0i)")
      expect(inspect(Complex(1, 2) / Complex(3, 4))).to eq("((11/25)+(2/25)*i)")
      expect(inspect(Complex(1.0, 2) / Complex(3, 4))).to eq("(0.44+0.08i)")
      expect(inspect(Complex(1, 2).quo(2))).to eq("((1/2)+1i)")
      expect(inspect(Complex(1, 2).fdiv(2))).to eq("(0.5+1.0i)")
    end

    specify "raises to powers as Ruby does" do
      expect(Complex(1, 2) ** 2).to eq(Complex(-3, 4))
      expect(inspect(Complex(1, 2) ** 0)).to eq("(1+0i)")
      expect(inspect(Complex(1, 2) ** -1)).to eq("((1/5)-(2/5)*i)")
      expect(inspect(Complex(1, 2) ** 0.5)).to eq("(1.272019649514069+0.7861513777574233i)")
      expect(inspect(Complex(1, 2) ** Complex(0, 1))).to eq("(0.2291401859804338+0.23817011512167555i)")
    end

    specify "is what a negative base to a fractional power answers" do
      expect(inspect((-8.0) ** (1.0 / 3))).to eq("(1.0+1.7320508075688772i)")
      expect(inspect((-8) ** 0.5)).to eq("(0.0+2.8284271247461903i)")
    end

    specify "negates" do
      expect(-Complex(1, 2)).to eq(Complex(-1, -2))
    end
  end

  describe "the parts" do
    specify "real, imaginary, rectangular, conjugate" do
      expect(Complex(3, 4).real).to eq(3)
      expect(Complex(3, 4).imaginary).to eq(4)
      expect(Complex(3, 4).imag).to eq(4)
      expect(Complex(3, 4).rectangular).to eq([3, 4])
      expect(Complex(3, 4).rect).to eq([3, 4])
      expect(Complex(3, 4).conjugate).to eq(Complex(3, -4))
      expect(Complex(3, 4).conj).to eq(Complex(3, -4))
    end

    specify "abs, abs2, arg, polar" do
      expect(Complex(3, 4).abs).to eq(5.0)
      expect(Complex(1, 2).abs).to eq(2.23606797749979)
      expect(Complex(3, 4).magnitude).to eq(5.0)
      expect(Complex(3, 4).abs2).to eq(25)
      expect(Complex(3, 4).arg).to eq(0.9272952180016122)
      expect(Complex(3, 4).angle).to eq(0.9272952180016122)
      expect(Complex(3, 4).phase).to eq(0.9272952180016122)
      expect(Complex(3, 4).polar).to eq([5.0, 0.9272952180016122])
    end

    specify "numerator and denominator over exact parts" do
      expect(Complex(1, 2).denominator).to eq(1)
      expect(Complex(Rational(1, 2), Rational(1, 3)).denominator).to eq(6)
      expect(Complex(Rational(1, 2), Rational(1, 3)).numerator).to eq(Complex(3, 2))
    end

    specify "the predicates" do
      expect(Complex(3, 4).real?).to be_false
      expect(Complex(1, 2).integer?).to be_false
      expect(Complex(1, 2).finite?).to be_true
      expect(Complex(1, 2).infinite?).to be_nil
      expect(Complex(Float::INFINITY, 0).infinite?).to eq(1)
    end
  end

  describe "converting" do
    specify "to a real when the imaginary part is an exact zero" do
      expect(Complex(1, 0).to_r).to eq(Rational(1, 1))
      expect(Complex(1, 0).to_i).to eq(1)
      expect(Complex(1, 0).to_f).to eq(1.0)
      expect(Complex(1, 0).rationalize).to eq(Rational(1, 1))
    end
  end

  describe "comparing" do
    specify "equals by parts, and a real when the imaginary part is zero" do
      expect(Complex(1, 0) == 1).to be_true
      expect(1 == Complex(1, 0)).to be_true
      expect(Complex(1, 0).eql?(1)).to be_false
      expect(Complex(1, 2) == Complex(1.0, 2.0)).to be_true
      expect(Complex(1, 2).eql?(Complex(1.0, 2.0))).to be_false
      expect(Complex(1, 2) == 1).to be_false
    end

    specify "answers <=> only where both sides are real" do
      expect(Complex(1, 2) <=> Complex(1, 3)).to be_nil
      expect(Complex(1, 0) <=> 2).to eq(-1)
    end
  end

  describe "rendering" do
    specify "to_s drops the parentheses, and a rational part is starred" do
      expect(Complex(1, 2).to_s).to eq("1+2i")
      expect(Complex(1.0, 2).to_s).to eq("1.0+2i")
      expect(inspect(Complex(Rational(1, 2), 1))).to eq("((1/2)+1i)")
      expect(inspect(Complex(1, Rational(1, 2)))).to eq("(1+(1/2)*i)")
      expect(inspect(Complex(1, Rational(-1, 2)))).to eq("(1-(1/2)*i)")
      expect(inspect(Complex(1, -0.0))).to eq("(1-0.0i)")
      expect(inspect(Complex(Float::INFINITY, 0))).to eq("(Infinity+0i)")
      expect(inspect(Complex(1, Float::NAN))).to eq("(1+NaN*i)")
    end

    specify "answers its class and the type pattern" do
      expect(Complex(1, 2).class).to eq(Complex)
      answer = case 2i
      in Complex then "complex"
      else "other"
      end
      expect(answer).to eq("complex")
    end
  end
end

context "Kernel#Complex" do
  describe "when passed [Complex, Complex]" do
    specify "returns a new Complex number based on the two given numbers" do
      expect(Complex(Complex(3, 4), Complex(5, 6))).to eq(Complex(3 - 6, 4 + 5))
      expect(Complex(Complex(1.5, 2), Complex(-5, 6.3))).to eq(Complex(1.5 - 6.3, 2 - 5))
    end
  end

  describe "when passed [Complex]" do
    specify "returns the passed Complex number" do
      expect(Complex(Complex(1, 2))).to eq(Complex(1, 2))
    end
  end

  describe "when passed [Integer, Integer]" do
    specify "returns a new Complex number" do
      expect(Complex(1, 2).class).to eq(Complex)
      expect(Complex(1, 2).real).to eq(1)
      expect(Complex(1, 2).imag).to eq(2)
      expect(Complex(-3, -5).real).to eq(-3)
      expect(Complex(-3, -5).imag).to eq(-5)
      expect(Complex(3.5, -4.5).real).to eq(3.5)
      expect(Complex(3.5, -4.5).imag).to eq(-4.5)
    end
  end

  describe "when passed [Integer/Float]" do
    specify "returns a new Complex number with 0 as the imaginary component" do
      expect(Complex(1).class).to eq(Complex)
      expect(Complex(1).imag).to eq(0)
      expect(Complex(1).real).to eq(1)
      expect(Complex(-3).imag).to eq(0)
      expect(Complex(-3).real).to eq(-3)
      expect(Complex(-4.5).imag).to eq(0)
      expect(Complex(-4.5).real).to eq(-4.5)
    end
  end
end
