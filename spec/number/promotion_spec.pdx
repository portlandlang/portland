# Mixed arithmetic promotes to float, and numeric equality reaches across the
# integer/float line — Ruby's rules, kept. Up the tower (ADR 0085), a
# rational or a complex is contagious the same way, and a sum of rationals
# stays exact, as core/enumerable/sum_spec.rb's rational rows have it.

require_relative "../spec_helper"

context "Integer and Float, mixed" do
  describe "arithmetic" do
    specify "promotes addition" do
      expect(1 + 2.5).to eq(3.5)
    end

    specify "promotes division, where the same operands floored as integers" do
      expect(7 / 2.0).to eq(3.5)
      expect(7 / 2).to eq(3)
    end
  end

  describe "equality" do
    specify "reaches across the integer/float line" do
      expect(1).to eq(1.0)
    end
  end
end

context "Rational and Complex, mixed" do
  describe "contagion" do
    specify "an integer with a rational is a rational, with a complex a complex" do
      expect((1 + Rational(1, 2)).class).to eq(Rational)
      expect((Rational(1, 2) + 0.5).class).to eq(Float)
      expect((1 + Complex(0, 1)).class).to eq(Complex)
      expect((Rational(1, 3) + Complex(1, 2)).class).to eq(Complex)
    end

    specify "sums stay exact" do
      expect([Rational(1, 2), Rational(1, 3)].sum).to eq(Rational(5, 6))
      expect([Complex(1, 2), 3].sum).to eq(Complex(4, 2))
    end
  end
end
