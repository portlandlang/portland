# Mixed arithmetic promotes to float, and numeric equality reaches across the
# integer/float line — Ruby's rules, kept.

require_relative "../spec_helper"

context "Integer and Float, mixed" do
  describe "arithmetic" do
    specify "promotes addition" do
      expect(1 + 2.5).to(eq(3.5))
    end

    specify "promotes division, where the same operands floored as integers" do
      expect(7 / 2.0).to(eq(3.5))
      expect(7 / 2).to(eq(3))
    end
  end

  describe "equality" do
    specify "reaches across the integer/float line" do
      expect(1).to(eq(1.0))
    end
  end
end
