# A float's place in the tower (#108, ADR 0085), from ruby/spec
# core/float/{arg,denominator,numerator,rationalize,to_r}_spec.rb: arg by
# the sign, including the signed zeros and infinities; numerator and
# denominator through the float's exact rational, NaN and the infinities
# answering themselves and 1 as Ruby's do; rationalize by CRuby's simplest
# rational within the span. NaN is 0.0 / 0.0 and infinity 1.0 / 0.0.
# Upstream: the numerators past the 64-bit integers (Float::MAX,
# 999.1 ** 99.928888), and the rows that raise — a refusal ends the file,
# so to_r and rationalize of NaN or infinity, and a second argument to
# rationalize, are pinned by the two-oracle test instead.

require_relative "../../spec_helper"

context "Float#arg" do
  specify "returns NaN if NaN" do
    expect((0.0 / 0.0).arg.nan?).to be_true
  end

  specify "returns 0 if positive" do
    expect(1.0.arg).to eq(0)
  end

  specify "returns 0 if +0.0" do
    expect(0.0.arg).to eq(0)
  end

  specify "returns 0 if +Infinity" do
    expect((1.0 / 0.0).arg).to eq(0)
  end

  specify "returns Pi if negative" do
    expect((-1.0).arg).to eq(Math::PI)
  end

  specify "returns Pi if -0.0" do
    expect((-0.0).arg).to eq(Math::PI)
  end

  specify "returns Pi if -Infinity" do
    expect((-1.0 / 0.0).arg).to eq(Math::PI)
  end
end

context "Float#denominator" do
  numbers = [0.0, 29871.22736282, 7772222663.0, 1.4592].map { |number| [0 - number, number] }.flatten

  specify "returns an Integer" do
    numbers.each do |number|
      expect(number.denominator.class).to eq(Integer)
    end
  end

  specify "converts self to a Rational and returns the denominator" do
    numbers.each do |number|
      expect(number.denominator).to eq(Rational(number).denominator)
    end
  end

  specify "returns 1 for NaN and Infinity" do
    expect((0.0 / 0.0).denominator).to eq(1)
    expect((1.0 / 0.0).denominator).to eq(1)
  end
end

context "Float#numerator" do
  numbers = [29871.2722891, -72628191273.22, 29282.2827, -2927.00091, 12.0]

  specify "converts self to a Rational object then returns its numerator" do
    numbers.each do |number|
      expect(number.infinite?).to be_false
      expect(number.numerator).to eq(Rational(number).numerator)
    end
  end

  specify "returns 0 for 0.0" do
    expect(0.0.numerator).to eq(0)
  end

  specify "returns NaN for NaN" do
    expect((0.0 / 0.0).numerator.nan?).to be_true
  end

  specify "returns Infinity for Infinity" do
    expect((1.0 / 0.0).numerator).to eq(1.0 / 0.0)
  end

  specify "returns -Infinity for -Infinity" do
    expect((-1.0 / 0.0).numerator).to eq(-1.0 / 0.0)
  end
end

context "Float#rationalize" do
  specify "returns self as a simplified Rational with no argument" do
    expect(3382729202.92822.rationalize).to eq(Rational(4806858197361, 1421))
  end

  specify "simplifies self to the degree specified by a Rational argument" do
    expect(0.3.rationalize(Rational(1, 10))).to eq(Rational(1, 3))
    expect(0.3.rationalize(Rational(-1, 10))).to eq(Rational(1, 3))
    expect((-0.3).rationalize(Rational(1, 10))).to eq(Rational(-1, 3))
    expect((-0.3).rationalize(Rational(-1, 10))).to eq(Rational(-1, 3))
  end

  specify "simplifies self to the degree specified by a Float argument" do
    expect(0.3.rationalize(0.05)).to eq(Rational(1, 3))
    expect(0.3.rationalize(0.001)).to eq(Rational(3, 10))
    expect((-0.3).rationalize(0.05)).to eq(Rational(-1, 3))
    expect((-0.3).rationalize(0.001)).to eq(Rational(-3, 10))
  end
end

context "Float#to_r" do
  specify "answers the float's exact rational" do
    expect(0.5.to_r).to eq(Rational(1, 2))
    expect(1.4592.to_r).to eq(Rational(1642913144064757, 1125899906842624))
    expect(0.0.to_r).to eq(Rational(0, 1))
    expect(12.0.to_r).to eq(Rational(12, 1))
  end
end
