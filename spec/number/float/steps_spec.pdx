# One IEEE step either way (#108), from ruby/spec core/float: next_float and
# prev_float. Upstream's round-trip examples draw their number from `rand`;
# here it is a fixed 0.37, since a spec that answers the same on every run
# is the one both implementations can be held to. A zero's sign is asked of
# 1 divided by it.

require_relative "../../spec_helper"

context "Float#next_float" do
  specify "returns a float the smallest possible step greater than the receiver" do
    barely_positive = 0.0.next_float
    expect(barely_positive).to eq(0.0.next_float)

    expect(barely_positive > 0.0).to eq(true)
    expect(barely_positive < barely_positive.next_float).to eq(true)

    midpoint = barely_positive / 2
    expect([0.0, barely_positive].include?(midpoint)).to eq(true)
  end

  specify "returns Float::INFINITY for Float::INFINITY" do
    expect(Float::INFINITY.next_float).to eq(Float::INFINITY)
  end

  specify "steps directly between MAX and INFINITY" do
    expect((-Float::INFINITY).next_float).to eq(-Float::MAX)
    expect(Float::MAX.next_float).to eq(Float::INFINITY)
  end

  specify "steps directly between 1.0 and 1.0 + EPSILON" do
    expect(1.0.next_float).to eq(1.0 + Float::EPSILON)
  end

  specify "steps directly between -1.0 and -1.0 + EPSILON/2" do
    expect((-1.0).next_float).to eq(-1.0 + Float::EPSILON / 2)
  end

  specify "reverses the effect of prev_float for all Floats except INFINITY and +0.0" do
    number = -0.37
    expect(number.prev_float.next_float).to eq(number)
  end

  specify "returns negative zero when stepping upward from just below zero" do
    stepped = (-0.0).prev_float.next_float
    expect(1 / stepped).to eq(-Float::INFINITY)
  end

  specify "gives the same result for -0.0 as for +0.0" do
    expect((-0.0).next_float).to eq((0.0).next_float)
  end

  specify "returns NAN if NAN was the receiver" do
    expect(Float::NAN.next_float.nan?).to eq(true)
  end
end

context "Float#prev_float" do
  specify "returns a float the smallest possible step smaller than the receiver" do
    barely_negative = 0.0.prev_float
    expect(barely_negative).to eq(0.0.prev_float)

    expect(barely_negative < 0.0).to eq(true)
    expect(barely_negative > barely_negative.prev_float).to eq(true)

    midpoint = barely_negative / 2
    expect([0.0, barely_negative].include?(midpoint)).to eq(true)
  end

  specify "returns -Float::INFINITY for -Float::INFINITY" do
    expect((-Float::INFINITY).prev_float).to eq(-Float::INFINITY)
  end

  specify "steps directly between MAX and INFINITY" do
    expect(Float::INFINITY.prev_float).to eq(Float::MAX)
    expect((-Float::MAX).prev_float).to eq(-Float::INFINITY)
  end

  specify "steps directly between 1.0 and 1.0 - EPSILON/2" do
    expect(1.0.prev_float).to eq(1.0 - Float::EPSILON / 2)
  end

  specify "steps directly between -1.0 and -1.0 - EPSILON" do
    expect((-1.0).prev_float).to eq(-1.0 - Float::EPSILON)
  end

  specify "reverses the effect of next_float for all Floats except -INFINITY and -0.0" do
    number = 0.37
    expect(number.next_float.prev_float).to eq(number)
  end

  specify "returns positive zero when stepping downward from just above zero" do
    stepped = (0.0).next_float.prev_float
    expect(1 / stepped).to eq(Float::INFINITY)
  end

  specify "gives the same result for -0.0 as for +0.0" do
    expect((0.0).prev_float).to eq((-0.0).prev_float)
  end

  specify "returns NAN if NAN was the receiver" do
    expect(Float::NAN.prev_float.nan?).to eq(true)
  end
end
