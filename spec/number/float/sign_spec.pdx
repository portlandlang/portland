# A float's sign and its conversions (#108), from ruby/spec core/float:
# abs and magnitude (through upstream's shared float_abs), positive?,
# negative?, unary minus, to_f, to_i (through float_to_i), inspect, ==, and
# ===. NaN is 0.0 / 0.0 and infinity 1.0 / 0.0; a positive zero is one that
# 1.0 divides into positive infinity. `infinite?` answers true or false
# here, so upstream's 1 and -1 are asked as a sign. Alias checks compare the
# two answers rather than method objects.

require_relative "../../spec_helper"

def positive_zero?(value) = value == 0.0 && (1.0 / value) > 0.0

context "Float#abs" do
  specify "returns the absolute value" do
    expect(-99.1.abs).to eq(99.1)
    expect(4.5.abs).to eq(4.5)
    expect(0.0.abs).to eq(0.0)
  end

  specify "returns 0.0 if -0.0" do
    expect(positive_zero?(-0.0.abs)).to eq(true)
  end

  specify "returns Infinity if -Infinity" do
    negative_infinity = -(1.0 / 0.0)
    expect(negative_infinity.abs.infinite?).to eq(true)
    expect(negative_infinity.abs > 0.0).to eq(true)
  end

  specify "returns NaN if NaN" do
    expect((0.0 / 0.0).abs.nan?).to eq(true)
  end
end

context "Float#magnitude" do
  specify "is an alias of Float#abs" do
    expect(-99.1.magnitude).to eq(-99.1.abs)
  end
end

context "Float#positive?" do
  specify "returns true on positive numbers" do
    expect(0.1.positive?).to eq(true)
  end

  specify "returns false on zero" do
    expect(0.0.positive?).to eq(false)
  end

  specify "returns false on negative zero" do
    expect(-0.0.positive?).to eq(false)
  end

  specify "returns false on negative numbers" do
    expect(-0.1.positive?).to eq(false)
  end

  specify "returns false on NaN" do
    expect((0.0 / 0.0).positive?).to eq(false)
  end
end

context "Float#negative?" do
  specify "returns false on positive numbers" do
    expect(0.1.negative?).to eq(false)
  end

  specify "returns false on zero" do
    expect(0.0.negative?).to eq(false)
  end

  specify "returns false on negative zero" do
    expect(-0.0.negative?).to eq(false)
  end

  specify "returns true on negative numbers" do
    expect(-0.1.negative?).to eq(true)
  end

  specify "returns false on NaN" do
    expect((0.0 / 0.0).negative?).to eq(false)
  end
end

context "Float#-@" do
  specify "negates self" do
    positive = 2.221
    expect(-positive).to eq(-2.221)
    expect(-2_455_999_221.5512).to eq(0.0 - 2455999221.5512)
    negative = -5.5
    expect(-negative).to eq(5.5)
  end

  specify "returns negative infinity for positive infinity" do
    infinity = 1.0 / 0.0
    expect((-infinity).infinite?).to eq(true)
    expect(-infinity < 0.0).to eq(true)
  end

  specify "returns positive infinity for negative infinity" do
    negative_infinity = -(1.0 / 0.0)
    expect((-negative_infinity).infinite?).to eq(true)
    expect(-negative_infinity > 0.0).to eq(true)
  end

  specify "returns NaN for NaN" do
    nan = 0.0 / 0.0
    expect((-nan).nan?).to eq(true)
  end
end

context "Float#to_f" do
  specify "returns self" do
    expect(-500.3.to_f).to eq(-500.3)
    expect(267.51.to_f).to eq(267.51)
    expect(1.1412.to_f).to eq(1.1412)
  end
end

context "Float#to_i" do
  specify "returns self truncated to an Integer" do
    expect(899.2.to_i.to_s).to eq("899")
    expect(-1.122256e-45.to_i).to eq(0)
    expect(5_213_451.9201.to_i).to eq(5213451)
    expect(1.233450999123389e+12.to_i).to eq(1233450999123)
  end
end

context "Float#inspect" do
  specify "is an alias of Float#to_s" do
    expect(inspect(4.5)).to eq(4.5.to_s)
  end
end

context "Float#==" do
  specify "returns true if self has the same value as other" do
    expect(1.0 == 1).to eq(true)
    expect(2.71828 == 1.428).to eq(false)
    expect(-4.2 == 4.2).to eq(false)
  end

  specify "returns false if one side is NaN" do
    nan = 0.0 / 0.0
    [1.0, 42].each do |number|
      expect(nan == number).to eq(false)
      expect(number == nan).to eq(false)
    end
  end

  specify "handles positive infinity" do
    infinity = 1.0 / 0.0
    [1.0, 42].each do |number|
      expect(infinity == number).to eq(false)
      expect(number == infinity).to eq(false)
    end
  end
end

context "Float#===" do
  specify "is an alias of Float#==" do
    expect(1.0 === 1).to eq(1.0 == 1)
    expect(2.5 === 1.5).to eq(2.5 == 1.5)
  end
end
