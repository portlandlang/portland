# `Float#<=>` answers -1, 0, or 1; the two zeros are equal, and infinity sits
# past every finite number (ADR 0054).
#
# From ruby/spec core/float/comparison_spec.rb. What stays behind: the bignum
# rows (a literal past i64 is a parse refusal), `#coerce` and the
# `infinite?`-duck rows (no coercion protocol), and the two nil answers — NaN
# on either side, and a non-number argument, both refuse here, since Portland
# has no nil to answer with; the seed's unit tests and a two-oracle test pin
# those refusals.

# Up two, because `require_relative` resolves against this file's own directory
# (the seed's rule, matched by the compiler) — not against `spec/`.
require_relative "../../spec_helper"

context "Float" do
  describe "#<=>" do
    infinity = 1.0 / 0.0

    specify "returns -1, 0, 1 when self is less than, equal, or greater than other" do
      expect(1.5 <=> 5).to eq(-1)
      expect(2.45 <=> 2.45).to eq(0)
      expect(5.5 <=> 5).to eq(1)
    end

    specify "handles positive infinity" do
      [1.0, 42].each do |number|
        expect(infinity <=> number).to eq(1)
        expect(number <=> infinity).to eq(-1)
      end
    end

    specify "handles negative infinity" do
      [1.0, 42].each do |number|
        expect(-infinity <=> number).to eq(-1)
        expect(number <=> -infinity).to eq(1)
      end
    end

    specify "returns 0 for -0.0 and 0.0" do
      expect(-0.0 <=> 0.0).to eq(0)
      expect(0.0 <=> -0.0).to eq(0)
    end

    specify "returns 0 for -0.0 and 0" do
      expect(-0.0 <=> 0).to eq(0)
      expect(0 <=> -0.0).to eq(0)
    end

    specify "returns 0 for 0.0 and 0" do
      expect(0.0 <=> 0).to eq(0)
      expect(0 <=> 0.0).to eq(0)
    end
  end
end
