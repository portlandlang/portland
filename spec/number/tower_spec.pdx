# The tower's names every real answers (ADR 0085), and the contagion
# across its floors: `numerator`, `denominator`, `to_r`, `to_c`, `real`,
# `imaginary`, `arg`, `polar`, `rectangular`, `conjugate`, `abs2`, `i` on
# integers and floats; sums that stay exact.
#
# From ruby/spec core/numeric/{angle,arg,phase,conj,conjugate,imag,imaginary,
# real,rect,rectangular,polar,abs2,i,quo,denominator,numerator,to_c}_spec.rb
# where a row runs on a builtin, and core/enumerable/sum_spec.rb's rational
# rows. Upstream: the rows that drive a mock Numeric subclass — there is no
# Numeric to subclass — the bignums, integers being 64-bit, and the rows
# that hand an argument to a name taking none, which refuse. NaN is
# 0.0 / 0.0 and infinity 1.0 / 0.0.

require_relative "../spec_helper"

context "The numeric tower" do
  describe "the real-valued names on an integer and a float" do
    specify "real, imaginary, real?, conjugate" do
      expect(3.real).to eq(3)
      expect(3.imag).to eq(0)
      expect(3.imaginary).to eq(0)
      expect(3.real?).to be_true
      expect(3.conj).to eq(3)
      expect(1.5.conjugate).to eq(1.5)
    end

    specify "arg is 0 or pi by the sign" do
      expect(3.arg).to eq(0)
      expect(-3.arg).to eq(3.141592653589793)
      expect(3.0.angle).to eq(0)
      expect(-3.0.phase).to eq(3.141592653589793)
    end

    specify "rectangular and polar" do
      expect(3.rect).to eq([3, 0])
      expect(3.rectangular).to eq([3, 0])
      expect(3.polar).to eq([3, 0])
      expect(-3.polar).to eq([3, 3.141592653589793])
    end

    specify "abs2 and i" do
      expect(3.abs2).to eq(9)
      expect(1.5.abs2).to eq(2.25)
      expect(3.i).to eq(Complex(0, 3))
    end
  end

  describe "contagion" do
    specify "an integer with a rational is a rational, with a complex a complex" do
      expect((1 + Rational(1, 2)).class).to eq(Rational)
      expect((Rational(1, 2) + 0.5).class).to eq(Float)
      expect((1 + Complex(0, 1)).class).to eq(Complex)
      expect((Rational(1, 3) + Complex(1, 2)).class).to eq(Complex)
    end

    specify "sums stay exact" do
      expect([Rational(1, 2), Rational(1, 3)].sum).to eq(Rational(5, 6))
      expect([Complex(1, 2), 3].sum).to eq(Complex(4, 2))
    end
  end
end

context "Numeric#abs2" do
  numbers = [0, 0.0, 1, 20, 278202.292871, 72829, 3.333333333333, 0.1, 1.0 / 0.0].map { |number| [-number, number] }.flatten

  specify "returns the square of the absolute value of self" do
    numbers.each do |number|
      expect(number.abs2.eql?(number.abs ** 2)).to be_true
    end
  end

  specify "returns NaN when self is NaN" do
    expect((0.0 / 0.0).abs2.nan?).to be_true
  end
end

context "Numeric#arg" do
  numbers = [20, Rational(3, 4), 1.0 / 0.0]

  specify "returns 0 if positive" do
    numbers.each do |number|
      expect(number.arg).to eq(0)
    end
  end

  specify "returns Pi if negative" do
    numbers.each do |number|
      expect((0 - number).arg).to eq(Math::PI)
    end
  end
end

context "Numeric#conjugate" do
  specify "returns self" do
    [20, 398.72, Rational(3, 4), 1.0 / 0.0].each do |number|
      expect(number.conjugate).to eq(number)
    end
    expect((0.0 / 0.0).conjugate.nan?).to be_true
  end
end

context "Numeric#denominator" do
  specify "returns 1" do
    expect(20.denominator).to eq(1)
  end
end

context "Numeric#i" do
  specify "returns a Complex object" do
    expect(34.i.class).to eq(Complex)
  end

  specify "sets the real part to 0" do
    expect(7342.i.real).to eq(0)
  end

  specify "sets the imaginary part to self" do
    expect(62.81.i.imag).to eq(62.81)
  end
end

context "Numeric#imaginary" do
  numbers = [20, 398.72, Rational(3, 4), 1.0 / 0.0, 0.0 / 0.0].map { |number| [number, -number] }.flatten

  specify "returns 0" do
    numbers.each do |number|
      expect(number.imaginary).to eq(0)
    end
  end
end

context "Numeric#numerator" do
  numbers = [0, 29871, -72628191273, 29282.2827, -2927.00091, 0.0, 12.0]

  specify "converts self to a Rational object then returns its numerator" do
    numbers.each do |number|
      expect(number.numerator).to eq(Rational(number).numerator)
    end
  end
end

context "Numeric#polar" do
  positive_numbers = [1, 987.18273, Float::MAX, Rational(13, 7), 1.0 / 0.0]
  negative_numbers = positive_numbers.map { |number| -number }
  numbers = positive_numbers + negative_numbers + [0, 0.0]

  specify "returns a two-element Array" do
    numbers.each do |number|
      expect(number.polar.class).to eq(Array)
      expect(number.polar.size).to eq(2)
    end
  end

  specify "sets the first value to the absolute value of self" do
    numbers.each do |number|
      expect(number.polar.first).to eq(number.abs)
    end
  end

  specify "sets the last value to 0 if self is positive" do
    (positive_numbers + [0, 0.0]).each do |number|
      expect(number >= 0).to be_true
      expect(number.polar.last).to eq(0)
    end
  end

  specify "sets the last value to Pi if self is negative" do
    negative_numbers.each do |number|
      expect(number < 0).to be_true
      expect(number.polar.last).to eq(Math::PI)
    end
  end

  specify "returns [NaN, NaN] if self is NaN" do
    expect((0.0 / 0.0).polar.size).to eq(2)
    expect((0.0 / 0.0).polar.first.nan?).to be_true
    expect((0.0 / 0.0).polar.last.nan?).to be_true
  end
end

context "Numeric#real" do
  numbers = [20, 398.72, Rational(3, 4), 1.0 / 0.0].map { |number| [number, -number] }.flatten

  specify "returns self" do
    numbers.each do |number|
      expect(number.real).to eq(number)
    end
    expect((0.0 / 0.0).real.nan?).to be_true
  end
end

context "Numeric#real?" do
  specify "returns true" do
    expect(20.real?).to be_true
    expect(398.72.real?).to be_true
    expect(Rational(3, 4).real?).to be_true
  end
end

context "Numeric#rectangular" do
  numbers = [20, 398.72, Rational(3, 4), 1.0 / 0.0]

  specify "returns an Array" do
    numbers.each do |number|
      expect(number.rectangular.class).to eq(Array)
    end
  end

  specify "returns a two-element Array" do
    numbers.each do |number|
      expect(number.rectangular.size).to eq(2)
    end
    expect((0.0 / 0.0).rectangular.size).to eq(2)
  end

  specify "returns self as the first element" do
    numbers.each do |number|
      expect(number.rectangular.first).to eq(number)
    end
    expect((0.0 / 0.0).rectangular.first.nan?).to be_true
  end

  specify "returns 0 as the last element" do
    numbers.each do |number|
      expect(number.rectangular.last).to eq(0)
    end
    expect((0.0 / 0.0).rectangular.last).to eq(0)
  end
end

context "Numeric#to_c" do
  numbers = [0, 29871, -72628191273, Rational(2, 3), Rational(1.898), Rational(-238), 29282.2827, -2927.00091, 0.0, 12.0, Float::MAX, 1.0 / 0.0]

  specify "returns a Complex object" do
    numbers.each do |number|
      expect(number.to_c.class).to eq(Complex)
    end
    expect((0.0 / 0.0).to_c.class).to eq(Complex)
  end

  specify "uses self as the real component" do
    numbers.each do |number|
      expect(number.to_c.real).to eq(number)
    end
    expect((0.0 / 0.0).to_c.real.nan?).to be_true
  end

  specify "uses 0 as the imaginary component" do
    numbers.each do |number|
      expect(number.to_c.imag).to eq(0)
    end
    expect((0.0 / 0.0).to_c.imag).to eq(0)
  end
end
