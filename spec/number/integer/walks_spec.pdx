# An integer's walks (#107), from ruby/spec core/integer: times, upto, and
# downto. Values never mutate (ADR 0015), so upstream's `result << x` is
# the accumulator pattern, `result = result + [x]` on a mutable, and its
# `a.shift` is `first` and then the rest by `slice`. Without a block each answers the finished walk,
# an array, where Ruby answers an Enumerator (ADR 0055), so `size` and
# `each` ask the array. A non-number endpoint refuses where Ruby raises
# ArgumentError, and `break` with a value waits on ADR 0012's real demand;
# both stay upstream.

require_relative "../../spec_helper"

context "Integer#times" do
  specify "returns self" do
    expect(5.times { }).to eq(5)
    expect(9.times { }).to eq(9)
    expect(9.times { |number| number - 2 }).to eq(9)
  end

  specify "yields each value from 0 to self - 1" do
    mutable seen = []
    9.times { |index| seen = seen + [index] }
    -2.times { |index| seen = seen + [index] }
    expect(seen).to eq([0, 1, 2, 3, 4, 5, 6, 7, 8])
  end

  specify "skips the current iteration when encountering 'next'" do
    mutable seen = []
    3.times do |index|
      next if index == 1
      seen = seen + [index]
    end
    expect(seen).to eq([0, 2])
  end

  specify "skips all iterations when encountering 'break'" do
    mutable seen = []
    5.times do |index|
      break if index == 3
      seen = seen + [index]
    end
    expect(seen).to eq([0, 1, 2])
  end

  specify "executes a nested while loop containing a break expression" do
    mutable queue = [false]
    finished = 1.times do |index|
      while true
        head = queue.first
        queue = queue.slice(1, queue.length)
        break unless head
      end
    end
    expect(queue).to eq([])
    expect(finished).to eq(1)
  end

  specify "executes a nested #times" do
    mutable count = 0
    finished = 3.times do |index|
      2.times { count += 1 }
    end
    expect(count).to eq(6)
    expect(finished).to eq(3)
  end

  specify "returns an Enumerator" do
    mutable seen = []
    walk = 3.times
    walk.each { |index| seen = seen + [index] }
    expect(seen).to eq([0, 1, 2])
  end

  describe "when no block is given" do
    specify "returns self as its size" do
      expect(5.times.size).to eq(5)
      expect(10.times.size).to eq(10)
      expect(0.times.size).to eq(0)
    end
  end
end

context "Integer#upto [stop] when self and stop are Integers" do
  specify "does not yield when stop is less than self" do
    mutable seen = []
    5.upto(4) { |number| seen = seen + [number] }
    expect(seen).to eq([])
  end

  specify "yields once when stop equals self" do
    mutable seen = []
    5.upto(5) { |number| seen = seen + [number] }
    expect(seen).to eq([5])
  end

  specify "yields while increasing self until it is less than stop" do
    mutable seen = []
    2.upto(5) { |number| seen = seen + [number] }
    expect(seen).to eq([2, 3, 4, 5])
  end

  specify "yields while increasing self until it is greater than floor of a Float endpoint" do
    mutable seen = []
    9.upto(13.3) { |number| seen = seen + [number] }
    -5.upto(-1.3) { |number| seen = seen + [number] }
    expect(seen).to eq([9, 10, 11, 12, 13, -5, -4, -3, -2])
  end

  describe "when no block is given" do
    specify "returns an Enumerator" do
      mutable seen = []
      walk = 2.upto(5)
      walk.each { |number| seen = seen + [number] }
      expect(seen).to eq([2, 3, 4, 5])
    end

    specify "returns stop - self + 1 as its size" do
      expect(5.upto(10).size).to eq(6)
      expect(1.upto(10).size).to eq(10)
      expect(0.upto(10).size).to eq(11)
      expect(0.upto(0).size).to eq(1)
      expect(-5.upto(-3).size).to eq(3)
    end

    specify "returns 0 as its size when stop < self" do
      expect(5.upto(4).size).to eq(0)
      expect(0.upto(-5).size).to eq(0)
      expect(-3.upto(-5).size).to eq(0)
    end
  end
end

context "Integer#downto [stop] when self and stop are Integers" do
  specify "does not yield when stop is greater than self" do
    mutable seen = []
    5.downto(6) { |number| seen = seen + [number] }
    expect(seen).to eq([])
  end

  specify "yields once when stop equals self" do
    mutable seen = []
    5.downto(5) { |number| seen = seen + [number] }
    expect(seen).to eq([5])
  end

  specify "yields while decreasing self until it is less than stop" do
    mutable seen = []
    5.downto(2) { |number| seen = seen + [number] }
    expect(seen).to eq([5, 4, 3, 2])
  end

  specify "yields while decreasing self until it less than ceil for a Float endpoint" do
    mutable seen = []
    9.downto(1.3) { |number| seen = seen + [number] }
    3.downto(-1.3) { |number| seen = seen + [number] }
    expect(seen).to eq([9, 8, 7, 6, 5, 4, 3, 2, 3, 2, 1, 0, -1])
  end

  describe "when no block is given" do
    specify "returns an Enumerator" do
      mutable seen = []
      walk = 5.downto(2)
      walk.each { |number| seen = seen + [number] }
      expect(seen).to eq([5, 4, 3, 2])
    end

    specify "returns self - stop + 1 as its size" do
      expect(10.downto(5).size).to eq(6)
      expect(10.downto(1).size).to eq(10)
      expect(10.downto(0).size).to eq(11)
      expect(0.downto(0).size).to eq(1)
      expect(-3.downto(-5).size).to eq(3)
    end

    specify "returns 0 as its size when stop > self" do
      expect(4.downto(5).size).to eq(0)
      expect(-5.downto(0).size).to eq(0)
      expect(-5.downto(-3).size).to eq(0)
    end
  end
end
