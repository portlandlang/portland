# `Integer#<=>` answers -1, 0, or 1, across the integer and float line alike
# (ADR 0054).
#
# From ruby/spec core/integer/comparison_spec.rb, the fixnum half. What stays
# behind: the bignum half (a literal past i64 is a parse refusal), `#coerce`
# (there is no coercion protocol), and "returns nil when the given argument is
# not an Integer" — `3 <=> "test"` refuses here, since Portland has no nil to
# answer with; the seed's unit tests pin that refusal.

# Up two, because `require_relative` resolves against this file's own directory
# (the seed's rule, matched by the compiler) — not against `spec/`.
require_relative "../../spec_helper"

context "Integer" do
  describe "#<=>" do
    specify "returns -1 when self is less than the given argument" do
      expect(-3 <=> -1).to eq(-1)
      expect(-5 <=> 10).to eq(-1)
      expect(-5 <=> -4.5).to eq(-1)
    end

    specify "returns 0 when self is equal to the given argument" do
      expect(0 <=> 0).to eq(0)
      expect(954 <=> 954).to eq(0)
      expect(954 <=> 954.0).to eq(0)
    end

    specify "returns 1 when self is greater than the given argument" do
      expect(496 <=> 5).to eq(1)
      expect(200 <=> 100).to eq(1)
      expect(51 <=> 50.5).to eq(1)
    end

    specify "places infinity past every integer" do
      infinity = 1.0 / 0.0
      expect(-9_000_000_000_000_000_000 <=> infinity).to eq(-1)
      expect(-9_000_000_000_000_000_000 <=> -infinity).to eq(1)
    end
  end
end
