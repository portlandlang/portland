# Pattern matching: load-bearing, not a corner feature — the trio dispatches
# on its own AST with it.

require_relative "spec_helper"

struct Node
  kind
  text
end

context "case/in" do
  # ADR 0013 — struct patterns are keyword-only, and a bare `text:` binds a
  # name of the same name.
  describe "a struct pattern" do
    node = Node.new(kind: "integer", text: "42")

    specify "matches on fields and binds the shorthand" do
      answer = case node
      in Node(kind: "word", text:)    then "the word #{text}"
      in Node(kind: "integer", text:) then "the number #{text}"
      end
      expect(answer).to(eq("the number 42"))
    end
  end

  describe "an array pattern" do
    specify "splits head from rest" do
      answer = case [9, 8, 7]
      in []              then "empty"
      in [first, *rest]  then [first, rest.length]
      end
      expect(answer).to(eq([9, 2]))
    end
  end

  describe "the smaller patterns" do
    specify "alternation takes any branch" do
      expect((2 in 1 | 2 | 3)).to(be_true)
    end

    # Writing this example is what found that the trio could not match a
    # range pattern at all (#40) — it lived as a comment until both oracles
    # agreed.
    specify "a range matches by membership, exclusive end honored" do
      expect((5 in 1..9)).to(be_true)
      expect((5 in 1...5)).to(be_false)
    end

    specify "a range pattern may run beginless or endless" do
      edges = case 50
      in ..0  then "low"
      in 1..9 then "single"
      in 10.. then "high"
      end
      expect(edges).to(eq("high"))
    end

    specify "a pin matches the named value instead of binding it" do
      expected = 5
      expect((5 in ^expected)).to(be_true)
    end

    specify "a guard vetoes a structural hit" do
      answer = case 15
      in count if count > 10 then "many"
      else
        "few"
      end
      expect(answer).to(eq("many"))
    end

    # A vetoed branch never happened, so its captures die with it — the next
    # branch binds the same name fresh instead of tripping no-shadow.
    specify "a failed guard discards its captures" do
      answer = case 5
      in count if count > 10 then "many"
      in count               then "few — #{count}"
      end
      expect(answer).to(eq("few — 5"))
    end

    specify "nil matches only absence" do
      expect((nil in nil)).to(be_true)
      expect((5 in nil)).to(be_false)
    end
  end

  # ADR 0013 — the type predicate is a pattern, not a reflection API: these
  # five are what exists where `is_a?` and `.class` do not.
  describe "a builtin type pattern" do
    specify "answers for all five types" do
      hits = [(1 in Integer), ("x" in String), ([1] in Array), ({a: 1} in Hash), (true in Boolean)]
      expect(hits).to(eq([true, true, true, true, true]))
    end

    specify "and a miss is just false" do
      expect(("x" in Integer)).to(be_false)
    end
  end

  describe "overlapping branches" do
    specify "give it to the first match" do
      answer = case 5
      in 1..9 then "the range, written first"
      in 5    then "the literal, written second"
      end
      expect(answer).to(eq("the range, written first"))
    end
  end

  # ADR 0013 — captures persist past the match, as in Ruby, fenced by
  # no-shadow.
  describe "a capture" do
    case [1, 2]
    in [head, tail] then head
    end

    specify "outlives its case" do
      expect(head).to(eq(1))
      expect(tail).to(eq(2))
    end
  end
end

context "the one-line forms" do
  describe "in" do
    specify "is a boolean that binds on a hit" do
      scores = [70, 80]
      hit = scores in [low, high]
      expect(hit).to(be_true)
      expect(low + high).to(eq(150))
    end
  end

  describe "=>" do
    specify "destructures rightward" do
      [1, 2, 3] => [first, *rest]
      expect(first).to(eq(1))
      expect(rest).to(eq([2, 3]))
    end
  end
end
