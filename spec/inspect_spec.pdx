# `inspect` — the source-shaped rendering as a value, `p` without the
# printing (ADR 0026).

require_relative "spec_helper"

struct Badge
  label
end

context "inspect" do
  describe "on the value kinds" do
    specify "quotes a string, where to_s would not" do
      expect(inspect("rose"), "\"rose\"")
    end

    specify "keeps a symbol's colon, where to_s drops it" do
      expect(inspect(:paid), ":paid")
    end

    specify "renders nil — a function takes absence without ceremony" do
      expect(inspect(nil), "nil")
    end

    specify "writes a hash back the way it would be typed" do
      expect(inspect({name: "pdx"}), "{name: \"pdx\"}")
    end

    specify "and a struct as its constructor would read" do
      expect(inspect(Badge.new(label: "pdx")), "Badge(label: \"pdx\")")
    end
  end

  describe "composed into a message" do
    specify "is what a failure line wants" do
      expect("got #{inspect(nil)}, not #{inspect("nil")}", "got nil, not \"nil\"")
    end
  end
end
