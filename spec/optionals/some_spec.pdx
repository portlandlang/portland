# ADR 0009 — `some` is identity on plain values and a real box only around
# nil. The stored-nil examples are Ruby's `fetch` rule kept without `fetch`:
# a hash holding an honest nil beats an or-guard default, because the miss
# and the stored nothing are different answers.

require_relative "../spec_helper"

context "the unwrap toolkit" do
  describe "some()" do
    specify "is identity on a plain value" do
      expect(some(5)).to eq(5)
    end

    specify "boxes a nil into a present value" do
      expect(some(nil)).to be_some
    end

    specify "lets a stored hash nil beat an or-guard default" do
      notes = {note: nil}
      expect((notes[:note] or "default")).to be_nil
    end

    specify "while a genuinely missing key takes the default" do
      notes = {note: nil}
      expect((notes[:nope] or "default")).to eq("default")
    end
  end
end
