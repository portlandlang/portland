# ADR 0005 — the wrapper keeps a stored nil distinguishable from a missing
# one. This pair is the whole point: both look like nil in Ruby, and must
# not here.

require_relative "../spec_helper"

context "absence" do
  describe "Array#first" do
    stored = [nil]
    missing = []

    specify "comes back present when a nil was stored" do
      expect(stored.first).not_to be_nil
    end

    specify "comes back absent when the array was empty" do
      expect(missing.first).to be_nil
    end
  end
end
