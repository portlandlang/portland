# ADR 0010 — partial operations return maybes; the only crash is one you
# typed. The subject is the rule rather than a method, because it spans
# three of them.

require_relative "../spec_helper"

context "absence" do
  describe "a partial operation" do
    specify "answers nil for first on an empty array" do
      expect([].first).to be_nil
    end

    specify "answers nil for an out-of-range index" do
      expect([1, 2][9]).to be_nil
    end

    specify "answers nil for a missing hash key" do
      expect({name: "pdx"}[:nope]).to be_nil
    end
  end

  # ADR 0019 — a slice is a collection, never a maybe.
  describe "a slice, which is not partial" do
    specify "returns an empty collection past the end, never nil" do
      words = %w[rose city]
      expect(words[9..]).to be_empty
    end
  end
end
