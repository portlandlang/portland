# The block-taking walks an array answers — map, select, reject, find —
# which are written in Portland, in core/enumerable.pdx (ADR 0093). This
# row is what that costs beside the Rust arms they replaced for an array
# (#438).

mutable numbers = []
mutable index = 0
while index < 500
  numbers << index
  index += 1
end

mutable round = 0
mutable total = 0
while round < 10
  doubled = numbers.map { |number| number * 2 }
  evens = doubled.select { |number| number % 4 == 0 }
  odds = numbers.reject { |number| number % 2 == 0 }
  found = numbers.find { |number| number > 400 } or 0
  total += evens.length + odds.length + found
  round += 1
end
puts total
